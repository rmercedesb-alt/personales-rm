    // ── Panel Frecuencia (vista interactiva) ──────────────────────────────
    void ToggleFreqPanel()
    {
        _showFreqPanel = !_showFreqPanel;
        if (_showFreqPanel) RecalcularFrecuencia();
    }

    void RecalcularFrecuencia()
    {
        _excesoPorDia.Clear();
        _clientesPorDia.Clear();
        if (_clientes.Count == 0) return;

        foreach (var g in _clientes.Where(c => c.DiaVisita is not null).GroupBy(c => c.DiaVisita!))
        {
            string dia      = g.Key;
            var    ordenados = (_secuenciaOptimizada
                ? g.OrderBy(c => c.NuevaPosicion)
                : g.OrderBy(c => c.RutPosicion)).ToList();

            _clientesPorDia[dia] = ordenados.Count;

            if (ordenados.Count > _maxPorDia)
            {
                _excesoPorDia[dia] = ordenados
                    .Skip(_maxPorDia)
                    .OrderBy(c => c.CliPromedioCompra)
                    .ThenBy(c => c.CliVentasAnioActual)
                    .Select(c => new ClienteFrecuencia { Cliente = c, Seleccionado = true })
                    .ToList();
            }
        }
    }

    void SeleccionarTodosExceso()
    { foreach (var l in _excesoPorDia.Values) l.ForEach(x => x.Seleccionado = true); }

    void DesmarcarTodosExceso()
    { foreach (var l in _excesoPorDia.Values) l.ForEach(x => x.Seleccionado = false); }

    // ── Análisis clasificación → propuesta de frecuencia ──────────────────
    void AnalizarFrecuencias()
    {
        // Reset a "semanal"
        foreach (var c in _todosClientes)
        {
            c.FrecuenciaProposed = "semanal";
            c.Frecuencia         = "semanal";
        }

        foreach (var g in _todosClientes
            .Where(c => c.DiaVisita is not null)
            .GroupBy(c => c.DiaVisita!))
        {
            var siempreSemanal = g.Where(c => EsClasifAlta(c.ClaDescripcion)).ToList();
            var candidatos = g.Where(c => !EsClasifAlta(c.ClaDescripcion))
                              .OrderBy(c => ClaOrden(c.ClaDescripcion))
                              .ThenBy(c => c.CliPromedioCompra)
                              .ThenBy(c => c.CliVentasAnioActual)
                              .ToList();

            int slotsUsados     = siempreSemanal.Count;
            int slotsParaCandid = Math.Max(0, _maxPorDia - slotsUsados);

            // Contar quincenales existentes para equilibrar al asignar nuevos
            int countQ13 = 0, countQ24 = 0;

            for (int i = 0; i < candidatos.Count; i++)
            {
                if (i < slotsParaCandid)
                {
                    candidatos[i].FrecuenciaProposed = "semanal";
                }
                else
                {
                    // Mantener asignación existente si ya es quincenal
                    if (candidatos[i].FrecuenciaActual == "quincenal_1_3")
                    {
                        candidatos[i].FrecuenciaProposed = "quincenal_1_3";
                        countQ13++;
                    }
                    else if (candidatos[i].FrecuenciaActual == "quincenal_2_4")
                    {
                        candidatos[i].FrecuenciaProposed = "quincenal_2_4";
                        countQ24++;
                    }
                    else
                    {
                        // Nuevo quincenal — balancear entre 1_3 y 2_4
                        if (countQ13 <= countQ24)
                        { candidatos[i].FrecuenciaProposed = "quincenal_1_3"; countQ13++; }
                        else
                        { candidatos[i].FrecuenciaProposed = "quincenal_2_4"; countQ24++; }
                    }
                }
            }
        }

        // Calcular Frecuencia (para colores de mapa propuesto)
        foreach (var c in _todosClientes)
        {
            bool actEsQuin  = c.FrecuenciaActual  != "semanal";
            bool propEsQuin = c.FrecuenciaProposed != "semanal";

            c.Frecuencia = (actEsQuin, propEsQuin) switch
            {
                (false, false) => "semanal",
                (true,  true)  => "stays_quin",
                (false, true)  => c.FrecuenciaProposed,    // nuevo quincenal (naranja)
                (true,  false) => "promoted"               // promovido a semanal (verde)
            };
        }
    }

    // ── Animación ─────────────────────────────────────────────────────────
    async Task PlayRuta()
    {
        if (_animando || !_mapInicializado) return;
        _animando = true; _mensaje = null; StateHasChanged();
        await JS.InvokeVoidAsync("MapInterop.startAnimation", _animVelocidad, _dotNetRef);
    }

    async Task StopAnim()
    {
        await JS.InvokeVoidAsync("MapInterop.stopAnimation");
        _animando = false; StateHasChanged();
    }

    [JSInvokable]
    public void OnAnimacionTerminada()
    {
        _animando = false; _mensaje = "▶ Animación completada."; _mensajeOk = true;
        InvokeAsync(StateHasChanged);
    }

    // ── Renderizar mapa ───────────────────────────────────────────────────
    async Task RenderizarMapa(List<double[]>? orsPolyline = null)
    {
        if (!_mapInicializado) return;

        if (_mapVista == "actual")
        {
            var puntos = _todosClientes
                .Where(c => c.TieneCoordenadas)
                .Select(c => new {
                    lat=c.Latitud, lng=c.Longitud,
                    nombre=c.CliNombre, codigo=c.CliCodigo, cla=c.ClaDescripcion,
                    dia=c.DiaVisita??"", pos=c.RutPosicion, cliId=c.CliID,
                    frecuencia=c.FrecuenciaActual,
                    frecuenciaActual=c.FrecuenciaActual
                }).ToList();
            await JS.InvokeVoidAsync("MapInterop.renderMapaGeneral", puntos, "actual");
        }
        else if (_mapVista == "propuesto")
        {
            var puntos = _todosClientes
                .Where(c => c.TieneCoordenadas)
                .Select(c => new {
                    lat=c.Latitud, lng=c.Longitud,
                    nombre=c.CliNombre, codigo=c.CliCodigo, cla=c.ClaDescripcion,
                    dia=c.DiaVisita??"",
                    pos=_todosOptimizados ? c.NuevaPosicion : c.RutPosicion,
                    cliId=c.CliID,
                    frecuencia=c.Frecuencia,
                    frecuenciaActual=c.FrecuenciaActual
                }).ToList();
            await JS.InvokeVoidAsync("MapInterop.renderMapaGeneral", puntos, "propuesto");
        }
        else // interactivo
        {
            var puntos = _clientes
                .Where(c => c.TieneCoordenadas)
                .Select(c => new {
                    lat=c.Latitud, lng=c.Longitud,
                    nombre=c.CliNombre, codigo=c.CliCodigo, cla=c.ClaDescripcion,
                    dia=c.DiaVisita??"",
                    pos=_secuenciaOptimizada ? c.NuevaPosicion : c.RutPosicion,
                    cliId=c.CliID
                })
                .OrderBy(p => p.pos).ToList();

            await JS.InvokeVoidAsync("MapInterop.renderClientes", puntos, orsPolyline);
            await JS.InvokeVoidAsync("MapInterop.initPins", _primerCliId, _ultimoCliId, _dotNetRef);
        }

        await JS.InvokeVoidAsync("MapInterop.invalidateSize");
    }

    // ── Helpers de detección de día ───────────────────────────────────────

    // Detecta el día desde cualquier semana (para _todosClientes)
    string? DetectarDiaGlobal(ClienteRuta c)
    {
        foreach (var bits in new[] { c.RutSemana1, c.RutSemana2, c.RutSemana3, c.RutSemana4 })
        {
            var d = BitsToDia(bits);
            if (d is not null) return d;
        }
        return null;
    }

    // Detecta el día para una semana específica
    string? DetectarDiaSemana(ClienteRuta c, int semana)
    {
        string bits = semana switch
        {
            1 => c.RutSemana1, 2 => c.RutSemana2,
            3 => c.RutSemana3, 4 => c.RutSemana4,
            _ => "0000000"
        };
        return BitsToDia(bits);
    }

    // Detecta si el cliente es semanal o quincenal según sus bits
    string DetectarFrecuenciaActual(ClienteRuta c)
    {
        if (c.DiaVisita is null) return "semanal";
        int idx = Array.IndexOf(_todosDias, c.DiaVisita);
        if (idx < 0) return "semanal";

        Func<string,bool> bit = s => s.Length > idx && s[idx] == '1';
        bool en1 = bit(c.RutSemana1);
        bool en2 = bit(c.RutSemana2);
        bool en3 = bit(c.RutSemana3);
        bool en4 = bit(c.RutSemana4);

        if (en1 && en3 && !en2 && !en4) return "quincenal_1_3";
        if (en2 && en4 && !en1 && !en3) return "quincenal_2_4";
        return "semanal";
    }

    static string? BitsToDia(string bits)
    {
        if (string.IsNullOrEmpty(bits) || bits.Length < 7) return null;
        string[] dias = ["Lunes","Martes","Miercoles","Jueves","Viernes","Sabado","Domingo"];
        for (int i = 0; i < 7; i++) if (bits[i] == '1') return dias[i];
        return null;
    }
}
