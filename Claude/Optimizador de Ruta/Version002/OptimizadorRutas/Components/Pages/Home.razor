@page "/"
@rendermode InteractiveServer
@using OptimizadorRutas.Models
@using OptimizadorRutas.Services
@inject RutaService RutaSvc
@inject IJSRuntime JS

<PageTitle>Optimizador de Rutas — AM COMERCIAL</PageTitle>

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
    .layout       { display:flex; height:calc(100vh - 56px); overflow:hidden; }
    .sidebar      { width:280px; min-width:280px; background:#1e1e2e; color:#cdd6f4;
                    overflow-y:auto; padding:16px; font-size:13px; }
    .sidebar h5   { color:#cba6f7; font-size:14px; margin:12px 0 6px; }
    .sidebar label{ display:block; margin:4px 0; cursor:pointer; }
    .sidebar select{ width:100%; background:#313244; color:#cdd6f4; border:1px solid #45475a;
                     border-radius:4px; padding:5px 8px; font-size:13px; }
    .content      { flex:1; display:flex; flex-direction:column; overflow:hidden; }
    .map-wrap     { flex:1; position:relative; min-height:200px; }
    #routeMap     { width:100%; height:100%; }
    .table-wrap   { height:220px; overflow-y:auto; background:#f8f9fa; border-top:1px solid #dee2e6; }
    .table-wrap table { font-size:12px; margin:0; }
    .table-wrap th { position:sticky; top:0; background:#343a40; color:#fff; padding:5px 8px; }
    .table-wrap td { padding:4px 8px; }
    .metrics      { display:flex; gap:10px; padding:8px 12px; background:#fff;
                    border-bottom:1px solid #dee2e6; flex-wrap:wrap; }
    .metric       { background:#f1f3f5; border-radius:6px; padding:5px 12px; text-align:center; }
    .metric span  { display:block; font-size:18px; font-weight:700; color:#2c3e50; }
    .metric.ok span { color:#2f9e44; }
    .metric small { font-size:11px; color:#868e96; }
    .btn-primary  { background:#4c6ef5; color:#fff; border:none; border-radius:5px;
                    padding:8px 16px; cursor:pointer; width:100%; margin-top:8px; font-size:13px; }
    .btn-primary:hover  { background:#364fc7; }
    .btn-primary:disabled { background:#748ffc; cursor:default; }
    .btn-success  { background:#2f9e44; color:#fff; border:none; border-radius:5px;
                    padding:8px 16px; cursor:pointer; width:100%; margin-top:6px; font-size:13px; }
    .btn-success:hover  { background:#237032; }
    .btn-success:disabled { background:#69db7c; cursor:default; }
    .btn-warning  { background:#f59f00; color:#fff; border:none; border-radius:5px;
                    padding:8px 16px; cursor:pointer; width:100%; margin-top:6px; font-size:13px; }
    .btn-warning:hover  { background:#e67700; }
    .badge-dia    { display:inline-block; padding:2px 7px; border-radius:10px;
                    color:#fff; font-size:11px; }
    .alert-info   { background:#d0ebff; border:1px solid #74c0fc; border-radius:5px;
                    padding:8px 12px; margin-top:8px; font-size:12px; color:#1864ab; }
    .alert-danger { background:#ffe0e0; border:1px solid #ffa8a8; border-radius:5px;
                    padding:8px 12px; margin-top:8px; font-size:12px; color:#c92a2a; }
    .semanas-grid, .dias-grid { display:grid; grid-template-columns:1fr 1fr; gap:2px; }
    .spinner-wrap { display:flex; align-items:center; justify-content:center;
                    height:160px; color:#888; font-size:14px; }
    .changed-row  { background:#fff3cd !important; }
    .welcome      { padding:20px; color:#495057; }
    .welcome h4   { color:#2c3e50; }
    .welcome ul   { line-height:2; }
</style>

<div class="layout">

    <!-- ══════════════ SIDEBAR ══════════════════════════════════════════════ -->
    <div class="sidebar">
        <div style="font-size:16px;font-weight:700;color:#cba6f7;margin-bottom:12px;">
            📍 Optimizador de Rutas
        </div>

        <!-- Representantes -->
        <h5>Representante(s)</h5>
        @if (_loadingReps)
        {
            <div style="color:#888;font-size:12px;">⏳ Conectando a BD...</div>
        }
        else if (_errorReps is not null)
        {
            <div style="color:#f38ba8;font-size:12px;line-height:1.4;">
                ❌ Sin conexión a BD<br/>
                <span style="font-size:10px;">@_errorReps[..Math.Min(100, _errorReps.Length)]</span>
            </div>
        }
        else
        {
            <select id="repSelect" multiple size="5" style="height:110px;"
                    @onchange="OnRepChange">
                @foreach (var r in _representantes)
                {
                    <option value="@r.RepCodigo"
                            selected="@(_repSeleccionados.Contains(r.RepCodigo))">
                        @r.Display
                    </option>
                }
            </select>
            <div style="color:#6c7086;font-size:11px;margin-top:2px;">
                Ctrl+clic para seleccionar varios
            </div>
        }

        <!-- Semanas -->
        <h5>Semanas a analizar</h5>
        <div class="semanas-grid">
            @for (int s = 1; s <= 4; s++)
            {
                var sem = s;
                <label>
                    <input type="checkbox"
                           checked="@_semanas.Contains(sem)"
                           @onchange="e => OnSemanaChange(sem, (bool)e.Value!)" />
                    Sem @sem
                </label>
            }
        </div>

        <!-- Días -->
        <h5>Días a analizar</h5>
        <div class="dias-grid">
            @foreach (var dia in _todosDias)
            {
                var d = dia;
                <label>
                    <input type="checkbox"
                           checked="@_diasSel.Contains(d)"
                           @onchange="e => OnDiaChange(d, (bool)e.Value!)" />
                    @d
                </label>
            }
        </div>

        <hr style="border-color:#45475a;margin:12px 0;" />

        <!-- Botón Cargar -->
        <button class="btn-primary"
                @onclick="CargarRuta"
                disabled="@(_cargando || _repSeleccionados.Count == 0)">
            @(_cargando ? "⏳ Cargando..." : "🔍 Cargar Ruta")
        </button>

        <!-- Botón Recalcular — solo cuando hay datos cargados -->
        @if (_clientes.Count > 0)
        {
            <button class="btn-success"
                    @onclick="RecalcularSecuencia"
                    disabled="@_optimizando">
                @(_optimizando ? "⏳ Calculando..." : "🔄 Recalcular Secuencia")
            </button>

            @if (_secuenciaOptimizada)
            {
                <button class="btn-warning"
                        @onclick="GuardarPosiciones"
                        disabled="@_guardando">
                    @(_guardando ? "⏳ Guardando..." : "💾 Guardar en BD")
                </button>
            }
        }

        <!-- Mensaje de estado -->
        @if (_mensaje is not null)
        {
            <div class="@(_mensajeOk ? "alert-info" : "alert-danger")">
                @_mensaje
            </div>
        }

        <hr style="border-color:#45475a;margin:12px 0;" />
        <div style="color:#6c7086;font-size:11px;line-height:1.6;">
            ⚡ La secuencia <b>no se recalcula</b> automáticamente.<br/>
            Presiona <b>Recalcular Secuencia</b> cuando quieras optimizar el orden de visita.
        </div>
    </div>

    <!-- ══════════════ CONTENIDO ═════════════════════════════════════════════ -->
    <div class="content">

        @if (_cargando)
        {
            <div class="spinner-wrap">⏳ Consultando base de datos...</div>
        }
        else if (_clientes.Count == 0)
        {
            <div class="welcome">
                <h4>📍 Optimizador de Rutas de Visita</h4>
                <p>Selecciona un representante y presiona <b>Cargar Ruta</b>.</p>
                <ul>
                    <li>Muestra los clientes asignados con su ruta actual</li>
                    <li>Visualiza la secuencia en el mapa interactivo</li>
                    <li>Presiona <b>Recalcular Secuencia</b> para optimizar el orden geográfico</li>
                    <li>Guarda las nuevas posiciones directamente en la base de datos</li>
                </ul>
                <p style="font-size:13px;color:#868e96;">
                    Versión 002 · .NET 8 Blazor Server · Algoritmo: Vecino Más Cercano (Haversine)
                </p>
            </div>
        }
        else
        {
            <!-- Métricas -->
            <div class="metrics">
                <div class="metric">
                    <span>@_clientes.Count</span>
                    <small>Clientes</small>
                </div>
                <div class="metric">
                    <span>@_clientes.Count(c => c.TieneCoordenadas)</span>
                    <small>Con coordenadas</small>
                </div>
                <div class="metric">
                    <span>@_distanciaActualKm km</span>
                    <small>Distancia actual</small>
                </div>
                @if (_secuenciaOptimizada)
                {
                    <div class="metric ok">
                        <span>@_distanciaOptKm km</span>
                        <small>Dist. optimizada</small>
                    </div>
                    <div class="metric ok">
                        <span>@_ahorroKm km</span>
                        <small>Ahorro estimado</small>
                    </div>
                }
            </div>

            <!-- Mapa Leaflet -->
            <div class="map-wrap">
                <div id="routeMap"></div>
            </div>

            <!-- Tabla de clientes -->
            <div class="table-wrap">
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Pos. BD</th>
                            @if (_secuenciaOptimizada) { <th>Pos. Rec.</th> }
                            <th>Cliente</th>
                            <th>Código</th>
                            <th>Clasificación</th>
                            <th>Día</th>
                            <th>Rep.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in _clientes.OrderBy(x => _secuenciaOptimizada ? x.NuevaPosicion : x.RutPosicion))
                        {
                            bool cambio = _secuenciaOptimizada && c.NuevaPosicion != c.RutPosicion;
                            <tr class="@(cambio ? "changed-row" : "")">
                                <td>@c.RutPosicion</td>
                                @if (_secuenciaOptimizada) { <td><b>@c.NuevaPosicion</b></td> }
                                <td>@c.CliNombre</td>
                                <td>@c.CliCodigo</td>
                                <td>@c.ClaDescripcion</td>
                                <td>
                                    @if (c.DiaVisita is not null)
                                    {
                                        <span class="badge-dia" style="background:@DiaColor(c.DiaVisita)">
                                            @c.DiaVisita
                                        </span>
                                    }
                                </td>
                                <td style="font-size:11px;">@c.RepCodigo</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Leaflet + interop JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/js/mapInterop.js"></script>

@code {
    // ── Constantes ────────────────────────────────────────────────────────
    static readonly string[] _todosDias =
        ["Lunes","Martes","Miercoles","Jueves","Viernes","Sabado","Domingo"];

    static readonly Dictionary<string, string> _diaColores = new()
    {
        ["Lunes"]     = "#3498db", ["Martes"]    = "#e74c3c",
        ["Miercoles"] = "#2ecc71", ["Jueves"]    = "#f39c12",
        ["Viernes"]   = "#9b59b6", ["Sabado"]    = "#1abc9c",
        ["Domingo"]   = "#95a5a6",
    };
    string DiaColor(string dia) =>
        _diaColores.TryGetValue(dia, out var c) ? c : "#7f8c8d";

    // ── Estado UI ─────────────────────────────────────────────────────────
    List<RepresentanteInfo> _representantes   = [];
    List<string>            _repSeleccionados = [];
    HashSet<int>            _semanas  = [1, 2, 3, 4];
    HashSet<string>         _diasSel  = ["Lunes","Martes","Miercoles","Jueves","Viernes"];
    List<ClienteRuta>       _clientes = [];

    bool   _loadingReps         = true;
    bool   _cargando            = false;
    bool   _optimizando         = false;
    bool   _guardando           = false;
    bool   _secuenciaOptimizada = false;
    bool   _mapInicializado     = false;
    bool   _mensajeOk           = true;
    string? _errorReps          = null;
    string? _mensaje            = null;
    double _distanciaActualKm   = 0;
    double _distanciaOptKm      = 0;
    double _ahorroKm            = 0;

    // ── Inicialización ────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _representantes = await RutaSvc.GetRepresentantesAsync();
            if (_representantes.Count > 0)
                _repSeleccionados = [_representantes[0].RepCodigo];
        }
        catch (Exception ex)
        {
            _errorReps = ex.Message;
        }
        finally { _loadingReps = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_mapInicializado && _clientes.Count > 0)
        {
            await Task.Delay(80);
            await JS.InvokeVoidAsync("MapInterop.init", "routeMap");
            _mapInicializado = true;
            await RenderizarMapa();
        }
    }

    // ── Eventos de controles ──────────────────────────────────────────────
    async Task OnRepChange(ChangeEventArgs _)
    {
        // En Blazor, <select multiple> @onchange solo entrega el ultimo valor clickeado.
        // Usamos JS interop para leer todos los valores seleccionados correctamente.
        try
        {
            var selected = await JS.InvokeAsync<string[]>("getSelectedValues", "repSelect");
            _repSeleccionados = selected?.ToList() ?? [];
        }
        catch
        {
            // fallback: leer del argumento del evento
            if (_.Value is string s && !string.IsNullOrEmpty(s))
                _repSeleccionados = [s];
        }
    }

    void OnSemanaChange(int sem, bool activo)
    {
        if (activo) _semanas.Add(sem); else _semanas.Remove(sem);
        if (_semanas.Count == 0) _semanas.Add(sem);
    }

    void OnDiaChange(string dia, bool activo)
    {
        if (activo) _diasSel.Add(dia); else _diasSel.Remove(dia);
    }

    // ── Cargar ruta (solo consulta BD, NO optimiza) ───────────────────────
    async Task CargarRuta()
    {
        if (_repSeleccionados.Count == 0) return;

        _cargando            = true;
        _secuenciaOptimizada = false;
        _mapInicializado     = false;
        _mensaje             = null;
        _clientes            = [];
        StateHasChanged();

        try
        {
            var raw = await RutaSvc.GetRutaAsync(_repSeleccionados);

            foreach (var c in raw)
                c.DiaVisita = DetectarDia(c);

            _clientes = raw
                .Where(c => c.DiaVisita is not null)
                .OrderBy(c => c.RutPosicion)
                .ToList();

            // NuevaPosicion = posicion BD (sin optimizar)
            foreach (var c in _clientes)
                c.NuevaPosicion = c.RutPosicion;

            _distanciaActualKm = RouteOptimizer.DistanciaTotalKm(_clientes);

            if (_clientes.Count == 0)
            {
                _mensaje   = "Sin clientes para los filtros seleccionados.";
                _mensajeOk = false;
            }
            else
            {
                _mensaje   = $"{_clientes.Count} clientes cargados — presiona Recalcular Secuencia para optimizar.";
                _mensajeOk = true;
            }
        }
        catch (Exception ex)
        {
            _mensaje   = $"Error: {ex.Message}";
            _mensajeOk = false;
        }
        finally
        {
            _cargando = false;
            StateHasChanged();
        }
    }

    // ── Recalcular secuencia (SOLO al presionar el botón) ─────────────────
    async Task RecalcularSecuencia()
    {
        if (_clientes.Count < 2) return;

        _optimizando = true;
        _mensaje     = null;
        StateHasChanged();

        await Task.Run(() =>
        {
            var copia = _clientes.ToList();
            RouteOptimizer.OptimizarSecuencia(copia);
            _clientes.Clear();
            _clientes.AddRange(copia);
        });

        _distanciaOptKm      = RouteOptimizer.DistanciaTotalKm(_clientes);
        _ahorroKm            = Math.Round(_distanciaActualKm - _distanciaOptKm, 1);
        _secuenciaOptimizada = true;
        _optimizando         = false;

        int conCoord = _clientes.Count(c => c.TieneCoordenadas);
        _mensaje   = $"✅ Secuencia optimizada — {conCoord} puntos · ahorro estimado {_ahorroKm} km";
        _mensajeOk = true;

        await RenderizarMapa();
        StateHasChanged();
    }

    // ── Guardar posiciones en BD ──────────────────────────────────────────
    async Task GuardarPosiciones()
    {
        _guardando = true;
        StateHasChanged();
        try
        {
            var cambios = _clientes.Select(c => (c.CliID, c.RepCodigo, c.NuevaPosicion));
            int n = await RutaSvc.GuardarPosicionesAsync(cambios);
            _mensaje   = $"✅ {n} posiciones guardadas en la base de datos.";
            _mensajeOk = true;
            // Actualizar RutPosicion para reflejar el estado guardado
            foreach (var c in _clientes)
                c.RutPosicion = c.NuevaPosicion;
        }
        catch (Exception ex)
        {
            _mensaje   = $"Error al guardar: {ex.Message}";
            _mensajeOk = false;
        }
        finally { _guardando = false; StateHasChanged(); }
    }

    // ── Renderizar mapa ───────────────────────────────────────────────────
    async Task RenderizarMapa()
    {
        if (!_mapInicializado) return;

        var puntos = _clientes
            .Where(c => c.TieneCoordenadas)
            .Select(c => new
            {
                lat    = c.Latitud,
                lng    = c.Longitud,
                nombre = c.CliNombre,
                codigo = c.CliCodigo,
                cla    = c.ClaDescripcion,
                dia    = c.DiaVisita ?? "",
                pos    = _secuenciaOptimizada ? c.NuevaPosicion : c.RutPosicion,
            })
            .OrderBy(p => p.pos)
            .ToList();

        await JS.InvokeVoidAsync("MapInterop.renderClientes", puntos);
    }

    // ── Detectar día de visita ────────────────────────────────────────────
    string? DetectarDia(ClienteRuta c)
    {
        foreach (int s in _semanas.OrderBy(x => x))
        {
            string bits = s switch
            {
                1 => c.RutSemana1, 2 => c.RutSemana2,
                3 => c.RutSemana3, 4 => c.RutSemana4,
                _ => "0000000"
            };
            string? dia = BitsToDia(bits);
            if (dia is not null && _diasSel.Contains(dia)) return dia;
        }
        return null;
    }

    static string? BitsToDia(string bits)
    {
        if (string.IsNullOrEmpty(bits) || bits.Length < 7) return null;
        string[] dias = ["Lunes","Martes","Miercoles","Jueves","Viernes","Sabado","Domingo"];
        for (int i = 0; i < 7; i++)
            if (bits[i] == '1') return dias[i];
        return null;
    }
}
