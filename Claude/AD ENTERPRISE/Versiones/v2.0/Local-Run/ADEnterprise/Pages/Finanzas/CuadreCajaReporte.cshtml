@page
@model ADEnterprise.Pages.Finanzas.CuadreCajaReporteModel
@{ ViewData["Title"] = "Reporte Cuadre de Caja"; }

@* ══════════════════════════════════════════════════════
   ESTILOS DE IMPRESIÓN — ocultan nav, filtros y botones
═══════════════════════════════════════════════════════ *@
<style>
    @@media print {
        .no-print, .app-header, .app-navbar, footer { display: none !important; }
        .print-header { display: block !important; }
        .cuadre-card  { break-inside: avoid; page-break-inside: avoid; margin-bottom: 1.5rem; }
        body { font-size: 11pt; }
        .badge { border: 1px solid #ccc; color: #000 !important; background: #f8f8f8 !important; }
        .table { font-size: 10pt; }
        .balance-final { font-size: 14pt; }
    }
    .print-header { display: none; }
    .cuadre-card  { margin-bottom: 2rem; }
    .seccion-header {
        background: var(--azul-marino);
        color: white;
        padding: 0.6rem 1rem;
        font-weight: 700;
        font-size: 1.05rem;
        display: flex;
        align-items: center;
        gap: .5rem;
    }
    .info-row { display: flex; flex-wrap: wrap; gap: 2rem; padding: .75rem 1rem;
                background: #f8fafc; border-bottom: 1px solid #dee2e6; }
    .info-item { display: flex; flex-direction: column; }
    .info-label { font-size: .72rem; text-transform: uppercase; color: #6c757d; font-weight: 600; }
    .info-val   { font-weight: 700; font-size: .95rem; }
    .balance-final { font-size: 1.5rem; font-weight: 800; }
    .cat-row-cred  { background: #f0fdf4; }
    .cat-row-deb   { background: #fff5f5; }
    .totales-row   { background: #eef2ff; font-weight: 700; }
</style>

@* ── Encabezado de impresión (oculto en pantalla) ─────────────────────────── *@
<div class="print-header mb-3">
    <table width="100%"><tr>
        <td><strong style="font-size:16pt">Fanny Mercedes &amp; Asoc.</strong><br/>
            <span style="font-size:9pt;color:#555">AD ALL DIGITAL ENTERPRISE</span></td>
        <td style="text-align:right;font-size:10pt">
            <strong>REPORTE CUADRE DE CAJA</strong><br/>
            Generado: @DateTime.Now.ToString("dd/MM/yyyy hh:mm tt")<br/>
            Usuario: @(User.FindFirst("NombreCompleto")?.Value ?? User.Identity?.Name)
        </td>
    </tr></table>
    <hr style="border-top:2px solid #1a3a5c;margin:.4rem 0"/>
</div>

@* ── Título de pantalla ──────────────────────────────────────────────────── *@
<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <div>
        <div class="page-title"><i class="bi bi-safe2"></i> Reporte Cuadre de Caja</div>
        <div class="page-subtitle">Estado detallado por cuadre: usuarios, transacciones y balance al cierre</div>
    </div>
    @if (Model.Cuadres.Any())
    {
        <button onclick="window.print()" class="btn btn-outline-secondary">
            <i class="bi bi-printer"></i> Imprimir / PDF
        </button>
    }
</div>

@* ── Filtros ──────────────────────────────────────────────────────────────── *@
<div class="card shadow-sm mb-4 no-print">
    <div class="card-header fw-bold" style="background:var(--azul-marino);color:white">
        <i class="bi bi-funnel"></i> Filtros
    </div>
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold">Desde</label>
                <input type="date" name="Desde" value="@Model.Desde?.ToString("yyyy-MM-dd")"
                       class="form-control"/>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Hasta</label>
                <input type="date" name="Hasta" value="@Model.Hasta?.ToString("yyyy-MM-dd")"
                       class="form-control"/>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">N° Cuadre (opcional)</label>
                <input type="text" name="SeqFiltro" value="@Model.SeqFiltro"
                       class="form-control" placeholder="CUADRE-20260609-0001"/>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary-app w-100">
                    <i class="bi bi-search"></i> Buscar
                </button>
            </div>
        </form>
    </div>
</div>

@* ── Sin resultados ──────────────────────────────────────────────────────── *@
@if (Model.Buscado && !Model.Cuadres.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i>
        No se encontraron cuadres para los filtros seleccionados.
    </div>
}

@* ══════════════════════════════════════════════════════════════════════════
   CUADRES
══════════════════════════════════════════════════════════════════════════ *@
@foreach (var item in Model.Cuadres)
{
    var c = item.Cuadre;
    <div class="card shadow-sm cuadre-card">

        @* ── Encabezado del cuadre ─────────────────────────────────────── *@
        <div class="seccion-header">
            <i class="bi bi-safe2"></i>
            @c.SeqCuadre
            <span class="@CuadreCajaReporteModel.BadgeEstado(c.Estado) ms-2">
                @c.Estado
            </span>
            <span class="ms-auto small fw-normal opacity-75">
                @c.FechaApertura.ToString("dddd, dd \\de MMMM \\de yyyy", new System.Globalization.CultureInfo("es-DO"))
            </span>
        </div>

        @* ── Datos del cuadre ─────────────────────────────────────────── *@
        <div class="info-row">
            <div class="info-item">
                <span class="info-label">Apertura</span>
                <span class="info-val">@c.FechaApertura.ToString("dd/MM/yyyy hh:mm tt")</span>
            </div>
            <div class="info-item">
                <span class="info-label">Cierre</span>
                <span class="info-val">
                    @(c.FechaCierre.HasValue
                        ? c.FechaCierre.Value.ToString("dd/MM/yyyy hh:mm tt")
                        : "— Caja aún abierta —")
                </span>
            </div>
            <div class="info-item">
                <span class="info-label">Abrió</span>
                <span class="info-val">@(string.IsNullOrEmpty(c.UsuarioApertura) ? "—" : c.UsuarioApertura)</span>
            </div>
            <div class="info-item">
                <span class="info-label">Cerró</span>
                <span class="info-val">@(string.IsNullOrEmpty(c.UsuarioCierre) ? "—" : c.UsuarioCierre)</span>
            </div>
            <div class="info-item">
                <span class="info-label">Balance inicial</span>
                <span class="info-val text-secondary">RD$ @c.BalanceInicial.ToString("N2")</span>
            </div>
            <div class="info-item">
                <span class="info-label">Movimientos</span>
                <span class="info-val">@item.Movimientos.Count</span>
            </div>
        </div>

        @* ── Tabla de transacciones por categoría ─────────────────────── *@
        <div class="card-body p-0">
            @if (!item.PorCategoria.Any())
            {
                <div class="text-center text-muted py-3">
                    <i class="bi bi-inbox"></i> Sin movimientos en este cuadre
                </div>
            }
            else
            {
                <table class="table table-sm mb-0">
                    <thead style="background:#f1f5f9">
                        <tr>
                            <th class="ps-3">Categoría / Tipo de Transacción</th>
                            <th class="text-center">Cantidad</th>
                            <th class="text-end">Ingresos (CRÉDITO)</th>
                            <th class="text-end">Egresos (DÉBITO)</th>
                            <th class="text-end pe-3">Neto</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var linea in item.PorCategoria)
                        {
                            var esCred = linea.Creditos > linea.Debitos;
                            <tr class="@(esCred ? "cat-row-cred" : "cat-row-deb")">
                                <td class="ps-3">
                                    @if (linea.Creditos > 0)
                                    {
                                        <i class="bi bi-arrow-down-circle-fill text-success me-1"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-arrow-up-circle-fill text-danger me-1"></i>
                                    }
                                    @CuadreCajaReporteModel.LabelCategoria(linea.Categoria)
                                </td>
                                <td class="text-center">@linea.Cantidad</td>
                                <td class="text-end @(linea.Creditos > 0 ? "text-success fw-semibold" : "text-muted")">
                                    @(linea.Creditos > 0 ? "RD$ " + linea.Creditos.ToString("N2") : "—")
                                </td>
                                <td class="text-end @(linea.Debitos > 0 ? "text-danger fw-semibold" : "text-muted")">
                                    @(linea.Debitos > 0 ? "RD$ " + linea.Debitos.ToString("N2") : "—")
                                </td>
                                <td class="text-end pe-3 fw-bold @(linea.Neto >= 0 ? "text-success" : "text-danger")">
                                    RD$ @linea.Neto.ToString("N2")
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="totales-row">
                            <td class="ps-3 fw-bold">TOTALES DEL CUADRE</td>
                            <td class="text-center fw-bold">@item.Movimientos.Count</td>
                            <td class="text-end text-success fw-bold">RD$ @item.TotalCreditos.ToString("N2")</td>
                            <td class="text-end text-danger fw-bold">RD$ @item.TotalDebitos.ToString("N2")</td>
                            <td class="text-end pe-3 fw-bold @(item.TotalCreditos - item.TotalDebitos >= 0 ? "text-success" : "text-danger")">
                                RD$ @((item.TotalCreditos - item.TotalDebitos).ToString("N2"))
                            </td>
                        </tr>
                    </tfoot>
                </table>
            }
        </div>

        @* ── Estado de Cuenta cronológico con balance corriente ─────────── *@
        @{
            var collapseId = $"detalle-{c.SeqCuadre.Replace("-","_")}";
        }
        <div class="border-top">
            <div class="px-3 py-2 d-flex align-items-center justify-content-between"
                 style="background:#f8fafc;cursor:pointer"
                 data-bs-toggle="collapse"
                 data-bs-target="#@collapseId"
                 aria-expanded="false">
                <span class="fw-semibold text-secondary small">
                    <i class="bi bi-list-ul me-1"></i>
                    ESTADO DE CUENTA CRONOLÓGICO
                    <span class="badge bg-secondary ms-1">@item.MovimientosConSaldo.Count movs.</span>
                </span>
                <i class="bi bi-chevron-down text-secondary small"></i>
            </div>
            <div class="collapse" id="@collapseId">
                @if (!item.MovimientosConSaldo.Any())
                {
                    <div class="text-center text-muted py-3 small">Sin movimientos</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0" style="font-size:.82rem">
                            <thead style="background:#eef2ff">
                                <tr>
                                    <th class="ps-3" style="width:150px">Secuencia</th>
                                    <th style="width:130px">Fecha / Hora</th>
                                    <th>Categoría</th>
                                    <th>Concepto</th>
                                    <th class="text-end" style="width:115px">Ingreso</th>
                                    <th class="text-end" style="width:115px">Egreso</th>
                                    <th class="text-end" style="width:125px">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                            @* Fila de apertura *@
                            <tr style="background:#e8f4fd">
                                <td class="ps-3 text-muted" colspan="2">
                                    <i class="bi bi-lock-fill me-1 text-secondary"></i>
                                    @c.FechaApertura.ToString("dd/MM/yy HH:mm")
                                </td>
                                <td colspan="2">
                                    <span class="badge bg-secondary me-1">APERTURA</span>
                                    <span class="text-secondary">Balance inicial</span>
                                </td>
                                <td class="text-end"></td>
                                <td class="text-end"></td>
                                <td class="text-end fw-bold @(c.BalanceInicial >= 0 ? "text-dark" : "text-danger")">
                                    RD$ @c.BalanceInicial.ToString("N2")
                                </td>
                            </tr>
                            @foreach (var mov in item.MovimientosConSaldo)
                            {
                                var m = mov.Mov;
                                var esC = m.TipoMov == "CREDITO";
                                <tr class="@(esC ? "cat-row-cred" : "cat-row-deb")">
                                    <td class="ps-3"><code class="small">@m.SeqMovCaja</code></td>
                                    <td class="small text-muted">@m.FechaCreacion.ToString("dd/MM/yy HH:mm")</td>
                                    <td>
                                        @if (esC)
                                        {
                                            <i class="bi bi-arrow-down-circle-fill text-success me-1"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-arrow-up-circle-fill text-danger me-1"></i>
                                        }
                                        @CuadreCajaReporteModel.LabelCategoria(m.Categoria)
                                    </td>
                                    <td class="small">
                                        @m.Concepto
                                        @if (!string.IsNullOrEmpty(m.RefDocumento))
                                        {
                                            <br/><span class="text-muted">Ref: <code>@m.RefDocumento</code></span>
                                        }
                                    </td>
                                    <td class="text-end text-success fw-semibold">
                                        @(esC ? $"RD$ {m.Monto:N2}" : "")
                                    </td>
                                    <td class="text-end text-danger fw-semibold">
                                        @(!esC ? $"RD$ {m.Monto:N2}" : "")
                                    </td>
                                    <td class="text-end fw-bold @(mov.SaldoAcumulado >= 0 ? "text-dark" : "text-danger")">
                                        RD$ @mov.SaldoAcumulado.ToString("N2")
                                    </td>
                                </tr>
                            }
                            </tbody>
                            <tfoot class="totales-row">
                                <tr>
                                    <td colspan="4" class="ps-3 text-end fw-bold">BALANCE FINAL</td>
                                    <td class="text-end text-success fw-bold">RD$ @item.TotalCreditos.ToString("N2")</td>
                                    <td class="text-end text-danger fw-bold">RD$ @item.TotalDebitos.ToString("N2")</td>
                                    <td class="text-end fw-bold @(item.BalanceDisponible >= 0 ? "text-success" : "text-danger")">
                                        RD$ @item.BalanceDisponible.ToString("N2")
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>
        </div>

        @* ── Balance final disponible ──────────────────────────────────── *@
        <div class="card-footer d-flex justify-content-between align-items-center"
             style="background:#f0fdf4;border-top:2px solid #16a34a">
            <div>
                <span class="text-muted small">Balance inicial</span>
                <span class="fw-bold ms-2">RD$ @c.BalanceInicial.ToString("N2")</span>
                <span class="text-muted small ms-3">+&nbsp;Ingresos</span>
                <span class="fw-bold text-success ms-1">RD$ @item.TotalCreditos.ToString("N2")</span>
                <span class="text-muted small ms-3">−&nbsp;Egresos</span>
                <span class="fw-bold text-danger ms-1">RD$ @item.TotalDebitos.ToString("N2")</span>
            </div>
            <div class="text-end">
                <div class="text-muted small">DISPONIBLE AL @(c.Estado == "CERRADA" ? "CIERRE" : "MOMENTO")</div>
                <div class="balance-final @(item.BalanceDisponible >= 0 ? "text-success" : "text-danger")">
                    RD$ @item.BalanceDisponible.ToString("N2")
                </div>
            </div>
        </div>

    </div>  @* fin cuadre-card *@
}

@* ── Resumen general si hay más de un cuadre ────────────────────────────── *@
@if (Model.Cuadres.Count > 1)
{
    decimal totalCred  = Model.Cuadres.Sum(x => x.TotalCreditos);
    decimal totalDeb   = Model.Cuadres.Sum(x => x.TotalDebitos);
    decimal balInicial = Model.Cuadres.Sum(x => x.Cuadre.BalanceInicial);
    <div class="card shadow border-primary mb-4">
        <div class="card-header fw-bold text-white" style="background:#1a3a5c">
            <i class="bi bi-calculator"></i>
            Resumen del Período — @Model.Cuadres.Count cuadres
        </div>
        <div class="card-body">
            <div class="row text-center g-3">
                <div class="col-md-3">
                    <div class="text-muted small">Cuadres en el período</div>
                    <div class="fs-3 fw-bold">@Model.Cuadres.Count</div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Total Ingresos</div>
                    <div class="fs-3 fw-bold text-success">RD$ @totalCred.ToString("N2")</div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Total Egresos</div>
                    <div class="fs-3 fw-bold text-danger">RD$ @totalDeb.ToString("N2")</div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Balance Neto del Período</div>
                    <div class="fs-3 fw-bold @((totalCred - totalDeb) >= 0 ? "text-success" : "text-danger")">
                        RD$ @((totalCred - totalDeb).ToString("N2"))
                    </div>
                </div>
            </div>
        </div>
    </div>
}
