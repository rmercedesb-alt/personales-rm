@page
@model ADEnterprise.Pages.Finanzas.IngresosCapitalModel
@{ ViewData["Title"] = "Registro de Ingreso de Capital"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <div class="page-title"><i class="bi bi-cash-stack"></i> Registro de Ingreso de Capital</div>
        <div class="page-subtitle">Registra aportes de capital — genera automáticamente un crédito a caja</div>
    </div>
    @if (Model.CajaAbierta != null)
    {
        <span class="badge bg-success fs-6"><i class="bi bi-unlock"></i> Caja: @Model.CajaAbierta.SeqCuadre</span>
    }
</div>

<div class="row g-3">

    @* ── Formulario de captura ─────────────────────────────────────────────── *@
    <div class="col-md-4">
        <div class="card shadow-sm" style="border-left:4px solid var(--verde)">
            <div class="card-header fw-bold" style="background:var(--verde);color:white">
                <i class="bi bi-plus-circle"></i> Nuevo Ingreso
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="Registrar" id="frmIngreso">
                    <input type="hidden" name="FormToken" value="@Model.FormToken" />
                    <input type="hidden" name="ConfirmDuplicate" id="hConfirmDuplicate" value="false" />

                    @* Alerta de posible duplicado *@
                    @if (Model.DuplicateWarning != null)
                    {
                        <div class="alert alert-warning py-2 mb-3">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            @Html.Raw(Model.DuplicateWarning)
                            <div class="d-flex gap-2 mt-2">
                                <button type="button" class="btn btn-warning btn-sm fw-bold"
                                        onclick="confirmarDupIngreso()">
                                    <i class="bi bi-check-circle"></i> Sí, registrar de todas formas
                                </button>
                                <a href="/Finanzas/IngresosCapital" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-x-circle"></i> Cancelar
                                </a>
                            </div>
                        </div>
                    }

                    @* Fecha — el usuario elige *@
                    <div class="mb-3">
                        <label class="form-label fw-bold">Fecha <span class="text-danger">*</span></label>
                        <input type="date" asp-for="Nuevo.Fecha" class="form-control" required/>
                        <div class="form-text text-muted">La fecha de creación se asigna automáticamente al guardar.</div>
                    </div>

                    @* Nombre / fuente del capital *@
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre / Fuente <span class="text-danger">*</span></label>
                        <input type="text" asp-for="Nuevo.Nombre" class="form-control"
                               placeholder="Ej: Rosa Mercedes, Reinversión utilidades..." required maxlength="200"/>
                    </div>

                    @* Monto *@
                    <div class="mb-3">
                        <label class="form-label fw-bold">Monto (RD$) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">RD$</span>
                            <input type="number" step="0.01" min="0.01" asp-for="Nuevo.Monto"
                                   class="form-control" placeholder="0.00" required/>
                        </div>
                    </div>

                    @* Observaciones *@
                    <div class="mb-3">
                        <label class="form-label fw-bold">Observaciones</label>
                        <textarea asp-for="Nuevo.Observaciones" class="form-control" rows="3"
                                  placeholder="Detalles adicionales del ingreso..."></textarea>
                    </div>

                    @* Usuario — auto, solo lectura *@
                    <div class="mb-3">
                        <label class="form-label text-muted">Usuario (automático)</label>
                        <input type="text" class="form-control bg-light" value="@ViewData["UsuarioNombre"]" disabled/>
                    </div>

                    <hr>
                    <div class="alert alert-info py-2 small">
                        <i class="bi bi-info-circle"></i>
                        Al guardar, se genera automáticamente un <strong>CRÉDITO</strong> en caja por el monto indicado.
                    </div>
                    <button type="submit" class="btn btn-success w-100 btn-lg">
                        <i class="bi bi-save"></i> Registrar Ingreso
                    </button>
                </form>
                <script>
                function confirmarDupIngreso() {
                    document.getElementById('hConfirmDuplicate').value = 'true';
                    document.getElementById('frmIngreso').submit();
                }
                </script>
            </div>
        </div>
    </div>

    @* ── Lista de ingresos ─────────────────────────────────────────────────── *@
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center"
                 style="background:var(--azul-marino);color:white">
                <span class="fw-bold"><i class="bi bi-list-ul"></i> Ingresos Registrados</span>
                <form method="get" class="d-flex gap-2">
                    <input type="date" name="Desde" value="@Model.Desde?.ToString("yyyy-MM-dd")" class="form-control form-control-sm"/>
                    <input type="date" name="Hasta" value="@Model.Hasta?.ToString("yyyy-MM-dd")" class="form-control form-control-sm"/>
                    <button type="submit" class="btn btn-light btn-sm">Filtrar</button>
                </form>
            </div>
            <div class="card-body p-0">
                @if (!Model.Ingresos.Any())
                {
                    <p class="text-center text-muted py-4">No hay ingresos registrados.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-app table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Secuencia</th>
                                    <th>Fecha</th>
                                    <th>Nombre / Fuente</th>
                                    <th class="text-end">Monto</th>
                                    <th>Observaciones</th>
                                    <th>Usuario</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var ing in Model.Ingresos)
                            {
                                <tr>
                                    <td><code>@ing.Secuencia</code></td>
                                    <td>@ing.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@ing.Nombre</td>
                                    <td class="text-end fw-bold text-success">RD$ @ing.Monto.ToString("N2")</td>
                                    <td class="text-muted small">@ing.Observaciones</td>
                                    <td>@ing.UsuarioRegistro</td>
                                </tr>
                            }
                            </tbody>
                            <tfoot>
                                <tr class="table-success fw-bold">
                                    <td colspan="3">Total</td>
                                    <td class="text-end">RD$ @Model.Ingresos.Sum(i => i.Monto).ToString("N2")</td>
                                    <td colspan="2"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
