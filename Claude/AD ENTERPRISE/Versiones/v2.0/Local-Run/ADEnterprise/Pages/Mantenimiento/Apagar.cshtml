@page
@model ADEnterprise.Pages.Mantenimiento.ApagarModel
@{ ViewData["Title"] = "Apagar Servidor"; }

<div class="row justify-content-center mt-4">
<div class="col-md-6">

@if (Request.Method == "POST")
{
    <!-- ── CONFIRMACIÓN DE APAGADO ─────────────────────── -->
    <div class="card border-danger shadow text-center">
        <div class="card-body py-5">
            <i class="bi bi-power fs-1 text-danger mb-3 d-block"></i>
            <h4 class="fw-bold text-danger">Servidor deteniendo...</h4>
            <p class="text-muted mt-2">
                El servidor se está apagando. En unos segundos dejará de responder.<br/>
                Puede cerrar el navegador y la ventana de la terminal.
            </p>
            <div class="spinner-border text-danger mt-3" role="status">
                <span class="visually-hidden">Apagando...</span>
            </div>
            <div class="mt-4">
                <p class="small text-muted">
                    Para volver a iniciarlo, ejecute nuevamente el archivo<br/>
                    <strong>Iniciar AD Enterprise.bat</strong>
                </p>
            </div>
        </div>
    </div>
}
else
{
    <!-- ── PANTALLA DE CONFIRMACIÓN ───────────────────── -->
    <div class="card border-warning shadow">
        <div class="card-header fw-bold text-center bg-warning text-dark">
            <i class="bi bi-exclamation-triangle-fill"></i> Apagar Servidor Local
        </div>
        <div class="card-body text-center py-4">
            <i class="bi bi-power fs-1 text-secondary mb-3 d-block"></i>
            <h5 class="fw-bold">¿Desea detener el servidor?</h5>
            <p class="text-muted mt-2">
                Esta acción detendrá el servidor web local.<br/>
                El sistema dejará de funcionar hasta que vuelva a iniciarlo.
            </p>

            <div class="alert alert-info text-start mt-3">
                <strong><i class="bi bi-info-circle"></i> Para reiniciar el servidor:</strong>
                <ol class="mb-0 mt-1">
                    <li>Abra la carpeta del sistema</li>
                    <li>Haga doble clic en <strong>Iniciar AD Enterprise.bat</strong></li>
                    <li>O ejecute <code>dotnet run</code> en la terminal</li>
                </ol>
            </div>

            <div class="d-flex gap-3 justify-content-center mt-4">
                <a href="/Mantenimiento/Backup" class="btn btn-outline-secondary btn-lg">
                    <i class="bi bi-arrow-left"></i> Cancelar
                </a>
                <form method="post">
                    <button type="submit" class="btn btn-danger btn-lg"
                            onclick="return confirm('¿Confirma que desea apagar el servidor?')">
                        <i class="bi bi-power"></i> Sí, Apagar Servidor
                    </button>
                </form>
            </div>
        </div>
    </div>
}

</div>
</div>
