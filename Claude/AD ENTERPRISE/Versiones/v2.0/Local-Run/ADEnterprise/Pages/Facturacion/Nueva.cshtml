@page
@model ADEnterprise.Pages.Facturacion.NuevaModel
@{ ViewData["Title"] = "Nuevo Pago Factoring"; }

<div class="d-flex justify-content-between align-items-start mb-1">
    <div>
        <div class="page-title"><i class="bi bi-file-earmark-arrow-up"></i> Nuevo Pago Factoring</div>
        <div class="page-subtitle">Registre un nuevo pago de factoring — el adelanto sale de caja y la comisión ingresa</div>
    </div>
    <div class="text-end">
        <div class="text-muted small">Balance disponible en caja</div>
        <div class="fs-4 fw-bold @(Model.BalanceDisponible > 0 ? "text-success" : "text-danger")"
             id="lblBalanceCaja">
            RD$ @Model.BalanceDisponible.ToString("N2")
        </div>
        <small class="text-muted">Máximo que puede pagar hoy</small>
    </div>
</div>

<div class="row justify-content-center">
<div class="col-md-8">
<div class="card shadow-sm">
<div class="card-header" style="background:var(--azul-marino);color:white;font-weight:600;">
    Datos de la Factura
</div>
<div class="card-body">
<form method="post">
    <input type="hidden" name="FormToken" value="@Model.FormToken" />
    <div class="row g-3">

        <div class="col-md-4">
            <label class="form-label fw-semibold">N° Transacción</label>
            <input type="text" class="form-control bg-light" value="(Auto-generado)" readonly/>
            <small class="text-muted">Se asigna automáticamente</small>
        </div>

        <div class="col-md-4">
            <label class="form-label fw-semibold">N° Ticket <span class="text-danger">*</span></label>
            <input asp-for="Input.NumTicket" class="form-control" type="number"/>
            <span asp-validation-for="Input.NumTicket" class="text-danger small"></span>
        </div>

        <div class="col-md-4">
            <label class="form-label fw-semibold">Fecha de Factura <span class="text-danger">*</span></label>
            <input asp-for="Input.FechaFactura" type="date" class="form-control"/>
            <span asp-validation-for="Input.FechaFactura" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label fw-semibold">Compañía <span class="text-danger">*</span></label>
            <select asp-for="Input.IdCompania" class="form-select" id="selCompania">
                <option value="">-- Seleccione una compañía --</option>
                @foreach (var c in Model.Companias)
                {
                    <option value="@c.Id" data-nombre="@c.Nombre">@c.Nombre</option>
                }
            </select>
            <span asp-validation-for="Input.IdCompania" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label fw-semibold">Cliente <span class="text-danger">*</span></label>
            <select asp-for="Input.IdCliente" class="form-select" id="selCliente">
                <option value="">-- Seleccione un cliente --</option>
                @foreach (var c in Model.Clientes)
                {
                    <option value="@c.Id" data-nombre="@c.NombreCompleto">@c.NombreCompleto</option>
                }
            </select>
            <span asp-validation-for="Input.IdCliente" class="text-danger small"></span>
        </div>

        <div class="col-md-4">
            <label class="form-label fw-semibold">Monto Factura (RD$) <span class="text-danger">*</span></label>
            <div class="input-group">
                <span class="input-group-text">RD$</span>
                <input asp-for="Input.Monto" type="number" step="0.01" class="form-control" placeholder="0.00"
                       id="inpMonto" oninput="calcComision()"/>
            </div>
            <span asp-validation-for="Input.Monto" class="text-danger small"></span>
        </div>

        <div class="col-md-4">
            <label class="form-label fw-semibold">
                Monto Pagado por Factor (RD$)
                <span class="badge bg-info text-dark ms-1" style="font-size:.7em">Factoring</span>
            </label>
            <div class="input-group">
                <span class="input-group-text">RD$</span>
                <input asp-for="Input.MontoPagado" type="number" step="0.01" min="0" class="form-control"
                       placeholder="0.00 (dejar en 0 si no aplica)" id="inpMontoPagado" oninput="calcComision()"/>
            </div>
            <span asp-validation-for="Input.MontoPagado" class="text-danger small"></span>
            <div id="alertaFondos" class="alert alert-danger py-1 small mt-1 mb-0 d-none">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <strong>Fondos insuficientes.</strong> El monto excede el balance disponible en caja.
            </div>
            <small class="text-muted">Neto que el factor deposita al despacho.</small>
        </div>

        <div class="col-md-4">
            <label class="form-label fw-semibold">Comisión Factoring (auto)</label>
            <div class="input-group">
                <span class="input-group-text">RD$</span>
                <input type="text" class="form-control bg-light" id="lblComision" value="0.00" readonly/>
            </div>
            <small class="text-muted">= Monto − Monto Pagado</small>
        </div>

        <div class="col-md-6">
            <label class="form-label fw-semibold">Estado</label>
            <input type="text" class="form-control bg-light" value="PENDIENTE" readonly/>
            <small class="text-muted">Se asigna automáticamente al crear</small>
        </div>

        <div class="col-md-6">
            <div class="alert alert-info py-2 small mb-0">
                <i class="bi bi-info-circle"></i>
                Si se indica <strong>Monto Pagado</strong>, se registrarán en caja:<br>
                <span class="text-danger fw-semibold">DÉBITO</span> = Monto Pagado (sale de caja) &nbsp;|&nbsp;
                <span class="text-success fw-semibold">CRÉDITO</span> = Comisión (entra a caja).<br>
                <strong>El Monto Pagado no puede exceder el balance disponible.</strong>
            </div>
        </div>

        <div class="col-12">
            <label class="form-label fw-semibold">Notas</label>
            <textarea asp-for="Input.Notas" class="form-control" rows="2" placeholder="Observaciones opcionales..."></textarea>
        </div>

        <!-- Campos bloqueados informativos -->
        <div class="col-md-4">
            <label class="form-label fw-semibold text-muted">Fecha de Pago</label>
            <input type="text" class="form-control bg-light text-muted" value="(Se llena al pagar)" readonly/>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold text-muted">Forma de Pago</label>
            <input type="text" class="form-control bg-light text-muted" value="(Se llena al pagar)" readonly/>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold text-muted">N° Cheque / Ref.</label>
            <input type="text" class="form-control bg-light text-muted" value="(Se llena al pagar)" readonly/>
        </div>

    </div>

    <hr class="my-4"/>
    <div class="d-flex gap-2 justify-content-end">
        <a href="/Facturacion/Consulta" class="btn btn-outline-secondary">
            <i class="bi bi-x-circle"></i> Cancelar
        </a>
        <button type="submit" class="btn btn-primary-app" id="btnGuardar">
            <i class="bi bi-save"></i> Guardar Factura
        </button>
    </div>
</form>
</div>
</div>
</div>
</div>

<script>
var balanceCaja = @Model.BalanceDisponible.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

function calcComision() {
    var monto   = parseFloat(document.getElementById('inpMonto').value) || 0;
    var pagado  = parseFloat(document.getElementById('inpMontoPagado').value) || 0;
    var comision = Math.max(0, monto - pagado);
    document.getElementById('lblComision').value = comision.toFixed(2);

    // Validación de fondos en tiempo real
    var inp      = document.getElementById('inpMontoPagado');
    var alerta   = document.getElementById('alertaFondos');
    var btnGuardar = document.getElementById('btnGuardar');
    if (pagado > 0 && pagado > balanceCaja) {
        inp.classList.add('is-invalid');
        alerta.classList.remove('d-none');
        if (btnGuardar) btnGuardar.disabled = true;
    } else {
        inp.classList.remove('is-invalid');
        alerta.classList.add('d-none');
        if (btnGuardar) btnGuardar.disabled = false;
    }
}
</script>
