@page
@model ADEnterprise.Pages.Reportes.HistorialPagosModel
@{ ViewData["Title"] = "Historial de Pagos"; }

<div class="d-flex justify-content-between align-items-center mb-2 no-print">
    <div>
        <div class="page-title mb-0"><i class="bi bi-cash-stack"></i> Historial de Pagos por Período</div>
        <div class="page-subtitle mb-0">Pagos recibidos en el rango de fecha — agrupados por cliente con totales</div>
    </div>
    <div class="d-flex gap-2">
        <form method="post" asp-page-handler="ExportarExcel">
            <input type="hidden" name="desde"   value="@Model.FechaDesde.ToString("yyyy-MM-dd")"/>
            <input type="hidden" name="hasta"   value="@Model.FechaHasta.ToString("yyyy-MM-dd")"/>
            <input type="hidden" name="empresa" value="@Model.FiltroEmpresa"/>
            <input type="hidden" name="cliente" value="@Model.FiltroCliente"/>
            <button class="btn btn-success btn-sm"><i class="bi bi-file-earmark-excel"></i> Excel</button>
        </form>
        <button onclick="window.print()" class="btn btn-secondary btn-sm"><i class="bi bi-printer"></i> Imprimir / PDF</button>
    </div>
</div>

<!-- Filtros -->
<div class="card shadow-sm mb-3 no-print"><div class="card-body py-2">
<form method="get" class="row g-2 align-items-end">
    <div class="col-6 col-md-2"><label class="form-label fw-semibold small mb-1">Desde</label>
        <input type="date" name="FechaDesde" class="form-control form-control-sm" value="@Model.FechaDesde.ToString("yyyy-MM-dd")"/></div>
    <div class="col-6 col-md-2"><label class="form-label fw-semibold small mb-1">Hasta</label>
        <input type="date" name="FechaHasta" class="form-control form-control-sm" value="@Model.FechaHasta.ToString("yyyy-MM-dd")"/></div>
    <div class="col-6 col-md-2"><label class="form-label fw-semibold small mb-1">Compañía</label>
        <select name="FiltroEmpresa" class="form-select form-select-sm">
            <option value="">— Todas —</option>
            @foreach (var e in Model.Empresas)
            { if (e == Model.FiltroEmpresa) { <option value="@e" selected>@e</option> } else { <option value="@e">@e</option> } }
        </select></div>
    <div class="col-6 col-md-2"><label class="form-label fw-semibold small mb-1">Cliente</label>
        <select name="FiltroCliente" class="form-select form-select-sm">
            <option value="">— Todos —</option>
            @foreach (var c in Model.Clientes)
            { if (c == Model.FiltroCliente) { <option value="@c" selected>@c</option> } else { <option value="@c">@c</option> } }
        </select></div>
    <div class="col-auto d-flex gap-2">
        <button type="submit" class="btn btn-sm btn-primary-app"><i class="bi bi-funnel"></i> Filtrar</button>
        <a href="/Reportes/HistorialPagos" class="btn btn-sm btn-outline-secondary"><i class="bi bi-x-circle"></i></a>
    </div>
</form>
</div></div>

<!-- Encabezado impresión -->
<div class="print-only mb-3">
    <h4 class="fw-bold">AD ALL DIGITAL ENTERPRISE — Historial de Pagos</h4>
    <p class="text-muted small">Período: @Model.FechaDesde.ToString("dd/MM/yyyy") al @Model.FechaHasta.ToString("dd/MM/yyyy")
        @if (!string.IsNullOrEmpty(Model.FiltroEmpresa)) { <text>| Compañía: @Model.FiltroEmpresa</text> }
        @if (!string.IsNullOrEmpty(Model.FiltroCliente)) { <text>| Cliente: @Model.FiltroCliente</text> }
        | Generado: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
    </p>
</div>

@if (!Model.TodosPagos.Any())
{
    <div class="text-center text-muted py-5"><i class="bi bi-inbox fs-1 d-block mb-2"></i> Sin pagos en el período seleccionado.</div>
}
else
{
<!-- Tarjeta resumen total -->
<div class="card mb-3 shadow-sm" style="border-left:4px solid #198754">
    <div class="card-body d-flex gap-4 align-items-center">
        <i class="bi bi-cash-stack fs-1 text-success"></i>
        <div>
            <div class="text-muted small">Total Cobrado en el período</div>
            <div class="fs-2 fw-bold text-success">RD$ @Model.TotalCobrado.ToString("N2")</div>
        </div>
        <div class="ms-4">
            <div class="text-muted small">N° de pagos</div>
            <div class="fs-3 fw-bold">@Model.TodosPagos.Count</div>
        </div>
        <div class="ms-4">
            <div class="text-muted small">Clientes que pagaron</div>
            <div class="fs-3 fw-bold">@Model.ResumenPorCliente.Count</div>
        </div>
    </div>
</div>

<!-- ── RESUMEN POR CLIENTE (tabla principal según punto 4) ── -->
<div class="card shadow-sm mb-3">
    <div class="card-header fw-bold" style="background:var(--azul-marino);color:white">
        <i class="bi bi-people"></i> Pagos por Cliente —
        @Model.FechaDesde.ToString("dd/MM/yyyy") al @Model.FechaHasta.ToString("dd/MM/yyyy")
    </div>
    <div class="card-body p-0">
    <div class="table-responsive">
    <table class="table table-sm table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Cliente</th>
                <th class="text-center">N° Facturas</th>
                <th class="text-center">N° Pagos</th>
                <th class="text-end">Total Pagado (RD$)</th>
            </tr>
        </thead>
        <tbody>
        @{ int rk = 1; }
        @foreach (var r in Model.ResumenPorCliente)
        {
            <tr>
                <td class="text-center"><span class="badge" style="background:var(--azul-medio)">@rk</span></td>
                <td><strong>@r.Cliente</strong></td>
                <td class="text-center">@r.NumFacturas</td>
                <td class="text-center">@r.Pagos.Count</td>
                <td class="text-end text-success fw-bold fs-6">@r.TotalPagado.ToString("N2")</td>
            </tr>
            rk++;
        }
        </tbody>
        <tfoot style="background:var(--azul-marino);color:white;font-weight:bold">
            <tr>
                <td colspan="4" class="text-end">TOTAL DEL PERÍODO:</td>
                <td class="text-end fs-5">RD$ @Model.TotalCobrado.ToString("N2")</td>
            </tr>
        </tfoot>
    </table>
    </div>
    </div>
</div>

<!-- ── DETALLE DE TODOS LOS PAGOS ── -->
<div class="card shadow-sm">
    <div class="card-header fw-bold d-flex justify-content-between" style="background:#198754;color:white">
        <span><i class="bi bi-list-ul"></i> Detalle de Transacciones</span>
        <span class="small">@Model.TodosPagos.Count pagos</span>
    </div>
    <div class="card-body p-0">
    <div class="table-responsive">
    <table class="table table-sm table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>N° Transacción</th><th>Ticket</th><th>Fecha</th>
                <th>Forma de Pago</th><th>Referencia</th>
                <th class="text-end">Monto (RD$)</th><th>Usuario</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in Model.TodosPagos)
        {
            <tr>
                <td><small class="text-muted">@p.NumTransaccionPago</small></td>
                <td><strong>#@p.NumTicket</strong></td>
                <td>@p.FechaPago.ToString("dd/MM/yyyy")</td>
                <td>@p.FormaPago</td>
                <td>@p.NumChequeReferencia</td>
                <td class="text-end text-success fw-bold">@p.MontoPagado.ToString("N2")</td>
                <td><small>@p.UsuarioRegistro</small></td>
            </tr>
        }
        </tbody>
        <tfoot style="background:#198754;color:white;font-weight:bold">
            <tr>
                <td colspan="5" class="text-end">TOTAL COBRADO EN EL PERÍODO:</td>
                <td class="text-end fs-5">RD$ @Model.TotalCobrado.ToString("N2")</td>
                <td></td>
            </tr>
        </tfoot>
    </table>
    </div>
    </div>
</div>
}

@section Scripts {
<style>
@@media print {
    .no-print { display: none !important; } .print-only { display: block !important; }
    .app-header, .app-navbar, .app-footer { display: none !important; }
    .main-content { padding: 0 !important; }
    .card { box-shadow: none !important; page-break-inside: avoid; }
}
.print-only { display: none; }
</style>
}
