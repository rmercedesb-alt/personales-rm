@page
@model ADEnterprise.Pages.LoginModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Iniciar Sesión — AD ALL DIGITAL ENTERPRISE</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css"/>
</head>
<body>
<div class="login-wrapper">
    <div class="card login-card">
        <div class="login-header">
            <img src="~/images/logo-fm.png" alt="Logo" class="login-logo mb-2"/>
            <div class="text-white fw-bold mt-1">Fanny Mercedes &amp; Asoc.</div>
            <div style="color:#a8c4ff;font-size:0.72rem;letter-spacing:2px;">AD ALL DIGITAL ENTERPRISE</div>
        </div>
        <div class="card-body p-4">
            <h5 class="text-center mb-4" style="color:var(--azul-marino);">Iniciar Sesión</h5>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage</div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Usuario</label>
                    <input asp-for="Input.Usuario" class="form-control" placeholder="Nombre de usuario" autofocus/>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold">Contraseña</label>
                    <input asp-for="Input.Password" type="password" class="form-control" placeholder="Contraseña"/>
                </div>
                <button type="submit" class="btn btn-primary-app w-100 py-2 fw-bold">
                    Entrar al Sistema
                </button>
            </form>
        </div>
        <div class="card-footer text-center text-muted py-2" style="font-size:0.75rem;">
            AD ALL DIGITAL ENTERPRISE v1.0
        </div>
    </div>
</div>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
</body>
</html>
