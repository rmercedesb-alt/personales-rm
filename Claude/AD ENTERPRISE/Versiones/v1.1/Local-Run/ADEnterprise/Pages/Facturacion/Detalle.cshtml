@page
@model ADEnterprise.Pages.Facturacion.DetalleModel
@{
    ViewData["Title"] = "Detalle de Factura";
    var f = Model.Factura!;
    var badgeColor = f.Estado switch {
        ADEnterprise.Models.EstadoFactura.Pendiente     => "bg-secondary",
        ADEnterprise.Models.EstadoFactura.PagadoParcial => "bg-warning text-dark",
        ADEnterprise.Models.EstadoFactura.Pagada        => "bg-success",
        _                                               => "bg-danger"
    };
}

<!-- ── ENCABEZADO ─────────────────────────────────────────────────────── -->
<div class="d-flex align-items-center gap-3 mb-3">
    <a href="/Facturacion/Consulta" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Volver
    </a>
    <div>
        <div class="page-title mb-0">
            <i class="bi bi-receipt"></i> Factura #@f.NumTicket
            <span class="badge @badgeColor ms-2">@f.Estado</span>
        </div>
        <div class="page-subtitle mb-0 font-monospace" style="font-size:.75rem">@f.NumTransaccion</div>
    </div>
    @if (!Model.EsAdmin)
    {
    <span class="badge bg-secondary ms-auto">Solo lectura</span>
    }
</div>

<div class="row g-3">

<!-- ══════════════════════════════════════════
     COLUMNA IZQUIERDA — Datos + Edición
══════════════════════════════════════════════ -->
<div class="col-md-7">

    @if (Model.EsAdmin)
    {
    <!-- ── FORMULARIO DE EDICIÓN (solo admins) ── -->
    <div class="card shadow-sm">
        <div class="card-header fw-bold" style="background:var(--azul-marino);color:white">
            <i class="bi bi-pencil-square"></i> Editar Factura
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="Guardar">
                <input type="hidden" asp-for="Input.NumTransaccion" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Empresa / Compañía</label>
                        <select asp-for="Input.IdCompania" class="form-select form-select-sm">
                            <option value="">-- Seleccione --</option>
                            @foreach (var c in Model.Companias)
                            { <option value="@c.Id">@c.Nombre</option> }
                        </select>
                        <span asp-validation-for="Input.IdCompania" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Cliente</label>
                        <select asp-for="Input.IdCliente" class="form-select form-select-sm">
                            <option value="">-- Seleccione --</option>
                            @foreach (var c in Model.Clientes)
                            { <option value="@c.Id">@c.NombreCompleto</option> }
                        </select>
                        <span asp-validation-for="Input.IdCliente" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Fecha de Factura</label>
                        <input asp-for="Input.FechaFactura" type="date" class="form-control form-control-sm" />
                        <span asp-validation-for="Input.FechaFactura" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Monto (RD$)</label>
                        <input asp-for="Input.Monto" type="number" step="0.01" min="0.01"
                               class="form-control form-control-sm" />
                        <span asp-validation-for="Input.Monto" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold small">Notas</label>
                        <textarea asp-for="Input.Notas" class="form-control form-control-sm"
                                  rows="2" placeholder="Notas opcionales..."></textarea>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary-app btn-sm">
                        <i class="bi bi-floppy"></i> Guardar Cambios
                    </button>
                    <a href="/Facturacion/Detalle?id=@f.NumTransaccion"
                       class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </a>
                    @if (f.Estado != ADEnterprise.Models.EstadoFactura.Pagada)
                    {
                    <a href="/Pagos/Registrar?ticket=@f.NumTicket"
                       class="btn btn-outline-success btn-sm ms-auto">
                        <i class="bi bi-cash-coin"></i> Registrar Pago
                    </a>
                    }
                </div>
            </form>
        </div>
    </div>
    }
    else
    {
    <!-- ── VISTA DE SOLO LECTURA ── -->
    <div class="card shadow-sm">
        <div class="card-header fw-bold" style="background:var(--azul-marino);color:white">
            <i class="bi bi-file-earmark-text"></i> Datos de la Factura
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted small">N° Ticket</dt>
                <dd class="col-sm-8 fw-bold">#@f.NumTicket</dd>
                <dt class="col-sm-4 text-muted small">Transacción</dt>
                <dd class="col-sm-8 font-monospace small">@f.NumTransaccion</dd>
                <dt class="col-sm-4 text-muted small">Empresa</dt>
                <dd class="col-sm-8">@f.EmpresaNombre</dd>
                <dt class="col-sm-4 text-muted small">Cliente</dt>
                <dd class="col-sm-8">@f.ClienteNombre</dd>
                <dt class="col-sm-4 text-muted small">Fecha</dt>
                <dd class="col-sm-8">@f.FechaFactura.ToString("dd/MM/yyyy")</dd>
                <dt class="col-sm-4 text-muted small">Monto</dt>
                <dd class="col-sm-8 fw-bold" style="color:var(--azul-marino)">RD$ @f.Monto.ToString("N2")</dd>
                <dt class="col-sm-4 text-muted small">Notas</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(f.Notas) ? "—" : f.Notas)</dd>
            </dl>
            @if (f.Estado != ADEnterprise.Models.EstadoFactura.Pagada)
            {
            <div class="mt-3">
                <a href="/Pagos/Registrar?ticket=@f.NumTicket"
                   class="btn btn-outline-success btn-sm">
                    <i class="bi bi-cash-coin"></i> Registrar Pago
                </a>
            </div>
            }
        </div>
    </div>
    }

    <!-- ── AUDITORÍA ── -->
    @if (f.FechaModificacion.HasValue || f.FechaMigracion.HasValue)
    {
    <div class="card shadow-sm mt-3">
        <div class="card-header fw-semibold" style="font-size:.82rem">
            <i class="bi bi-clock-history"></i> Auditoría
        </div>
        <div class="card-body py-2">
            <dl class="row mb-0 small">
                @if (f.FechaMigracion.HasValue)
                {
                <dt class="col-sm-4 text-muted">Ingresada</dt>
                <dd class="col-sm-8">
                    @f.FechaMigracion.Value.ToString("dd/MM/yyyy HH:mm")
                    @if (!string.IsNullOrEmpty(f.UsuarioMigracion))
                    { <span class="text-muted ms-1">por <strong>@f.UsuarioMigracion</strong></span> }
                </dd>
                }
                @if (f.FechaModificacion.HasValue)
                {
                <dt class="col-sm-4 text-muted">Modificada</dt>
                <dd class="col-sm-8">
                    @f.FechaModificacion.Value.ToString("dd/MM/yyyy HH:mm")
                    <span class="text-muted ms-1">por <strong>@f.UsuarioModificacion</strong></span>
                </dd>
                }
            </dl>
        </div>
    </div>
    }

</div>

<!-- ══════════════════════════════════════════
     COLUMNA DERECHA — Resumen + Pagos
══════════════════════════════════════════════ -->
<div class="col-md-5">

    <!-- Resumen financiero -->
    <div class="card shadow-sm mb-3">
        <div class="card-header fw-bold" style="background:var(--azul-marino);color:white">
            <i class="bi bi-pie-chart"></i> Resumen Financiero
        </div>
        <div class="card-body">
            <div class="d-flex justify-content-between py-1 border-bottom">
                <span class="text-muted small">Monto Total</span>
                <strong style="color:var(--azul-marino)">RD$ @f.Monto.ToString("N2")</strong>
            </div>
            <div class="d-flex justify-content-between py-1 border-bottom">
                <span class="text-muted small">Total Pagado</span>
                <strong class="text-success">RD$ @f.PagadoALaFecha.ToString("N2")</strong>
            </div>
            <div class="d-flex justify-content-between py-1 border-bottom">
                <span class="text-muted small">Saldo Pendiente</span>
                <strong class="@(f.SaldoPendiente > 0 ? "text-danger" : "text-success")">
                    RD$ @f.SaldoPendiente.ToString("N2")
                </strong>
            </div>
            <div class="mt-2">
                <div class="d-flex justify-content-between small text-muted mb-1">
                    <span>Progreso de pago</span>
                    <span>@(f.Monto > 0 ? Math.Round(f.PagadoALaFecha/f.Monto*100,1) : 0)%</span>
                </div>
                <div class="progress" style="height:8px">
                    @{ var pct = f.Monto > 0 ? (double)f.PagadoALaFecha/(double)f.Monto*100 : 0; }
                    <div class="progress-bar @(pct>=100?"bg-success":pct>=50?"bg-warning":"bg-danger")"
                         style="width:@pct%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Historial de pagos -->
    <div class="card shadow-sm">
        <div class="card-header fw-bold" style="background:var(--azul-marino);color:white">
            <i class="bi bi-cash-stack"></i> Pagos registrados
            <span class="badge bg-light text-dark ms-2">@Model.Pagos.Count</span>
        </div>
        <div class="card-body p-0">
            @if (!Model.Pagos.Any())
            {
                <div class="text-center text-muted py-3 small">Sin pagos registrados</div>
            }
            else
            {
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light" style="font-size:.78rem">
                    <tr>
                        <th>Fecha</th>
                        <th>Forma</th>
                        <th>Referencia</th>
                        <th class="text-end">Monto</th>
                        <th class="text-center">Acción</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in Model.Pagos.OrderByDescending(x => x.FechaPago))
                {
                    <tr>
                        <td style="font-size:.8rem">@p.FechaPago.ToString("dd/MM/yy")</td>
                        <td style="font-size:.8rem">@p.FormaPago</td>
                        <td style="font-size:.8rem">@(p.NumChequeReferencia == "" ? "—" : p.NumChequeReferencia)</td>
                        <td class="text-end fw-semibold text-success" style="font-size:.8rem">
                            @p.MontoPagado.ToString("N2")
                        </td>
                        <td class="text-center">
                            <a href="/Pagos/Detalle?id=@p.NumTransaccionPago"
                               class="btn btn-xs btn-outline-primary py-0 px-1" style="font-size:.72rem"
                               title="Ver / editar pago">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
                <tfoot class="table-light fw-bold" style="font-size:.8rem">
                    <tr>
                        <td colspan="3" class="text-end">Total pagado:</td>
                        <td class="text-end text-success">
                            @Model.Pagos.Sum(p => p.MontoPagado).ToString("N2")
                        </td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
            }
        </div>
    </div>

</div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
}
