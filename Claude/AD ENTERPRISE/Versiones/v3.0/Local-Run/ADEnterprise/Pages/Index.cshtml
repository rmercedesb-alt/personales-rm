@page
@model ADEnterprise.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var esCliente = Model.Vista == "Cliente";
    // Null-safe: el model binder puede devolver null aunque el prop tenga default ""
    string Q(string v = "General") =>
        $"?Vista={v}&FechaDesde={Model.FechaDesde:yyyy-MM-dd}&FechaHasta={Model.FechaHasta:yyyy-MM-dd}" +
        $"&FiltroEmpresa={Uri.EscapeDataString(Model.FiltroEmpresa ?? "")}" +
        $"&FiltroCliente={Uri.EscapeDataString(Model.FiltroCliente ?? "")}";
}

@if (Model.ErrorConexion != null)
{
    <div class="alert alert-warning alert-dismissible d-flex align-items-center gap-2 shadow-sm">
        <i class="bi bi-wifi-off fs-4"></i>
        <div>
            <strong>Problema de conexión</strong> — @Model.ErrorConexion
            <br/><small>Recargue la página cuando se restaure la conexión.</small>
        </div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ── FILTROS ──────────────────────────────────────────────────────── -->
<div class="card shadow-sm mb-3" style="border-left:4px solid var(--azul-marino)">
    <div class="card-body py-2">
        <form method="get">
            <input type="hidden" name="Vista" value="@Model.Vista"/>
            <div class="row g-2 align-items-end">

                <div class="col-12 col-md-auto">
                    <div class="page-title mb-0"><i class="bi bi-speedometer2"></i> Dashboard</div>
                    <div class="page-subtitle mb-0" style="font-size:.75rem">
                        @DateTime.Now.ToString("dddd, dd MMM yyyy", new System.Globalization.CultureInfo("es-DO"))
                    </div>
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label fw-semibold small mb-1">Desde</label>
                    <input type="date" name="FechaDesde" class="form-control form-control-sm"
                           value="@Model.FechaDesde.ToString("yyyy-MM-dd")"/>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label fw-semibold small mb-1">Hasta</label>
                    <input type="date" name="FechaHasta" class="form-control form-control-sm"
                           value="@Model.FechaHasta.ToString("yyyy-MM-dd")"/>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label fw-semibold small mb-1">Compañía</label>
                    <select name="FiltroEmpresa" class="form-select form-select-sm">
                        <option value="">— Todas —</option>
                        @foreach (var emp in Model.Empresas)
                        {
                            if (Model.FiltroEmpresa == emp)
                            { <option value="@emp" selected>@emp</option> }
                            else
                            { <option value="@emp">@emp</option> }
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label fw-semibold small mb-1">Cliente</label>
                    <select name="FiltroCliente" class="form-select form-select-sm">
                        <option value="">— Todos —</option>
                        @foreach (var cli in Model.Clientes)
                        {
                            if (Model.FiltroCliente == cli)
                            { <option value="@cli" selected>@cli</option> }
                            else
                            { <option value="@cli">@cli</option> }
                        }
                    </select>
                </div>
                <div class="col-12 col-md-auto d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary-app">
                        <i class="bi bi-funnel"></i> Filtrar
                    </button>
                    <a href="/?Vista=@Model.Vista" class="btn btn-sm btn-outline-secondary" title="Limpiar filtros">
                        <i class="bi bi-x-circle"></i>
                    </a>
                </div>

            </div>
        </form>
    </div>
</div>

<!-- ── BOTONES DE VISTA ──────────────────────────────────────────────── -->
<div class="d-flex align-items-center gap-2 mb-3">
    <a href="@Q("General")"
       class="btn btn-sm @(!esCliente ? "btn-primary-app" : "btn-outline-secondary")">
        <i class="bi bi-speedometer2"></i> General
    </a>
    <a href="@Q("Cliente")"
       class="btn btn-sm @(esCliente ? "btn-primary-app" : "btn-outline-secondary")">
        <i class="bi bi-people"></i> Por Cliente
    </a>
    <span class="text-muted small ms-2">
        <i class="bi bi-calendar-range"></i>
        @Model.FechaDesde.ToString("dd/MM/yyyy") — @Model.FechaHasta.ToString("dd/MM/yyyy")
        @if (!string.IsNullOrEmpty(Model.FiltroEmpresa))
        { <span class="badge ms-1" style="background:var(--azul-marino)"><i class="bi bi-building"></i> @Model.FiltroEmpresa</span> }
        @if (!string.IsNullOrEmpty(Model.FiltroCliente))
        { <span class="badge bg-secondary ms-1"><i class="bi bi-person"></i> @Model.FiltroCliente</span> }
    </span>
</div>

<!-- ── TARJETAS (comunes a ambas vistas) ────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-2">
        <div class="card card-stat card-total h-100">
            <div class="card-body text-center py-3">
                <div class="card-icon text-primary"><i class="bi bi-collection"></i></div>
                <div class="fs-3 fw-bold text-primary">@Model.Stats.TotalFacturas</div>
                <div class="small text-muted">Total Facturas</div>
                <div class="small fw-bold">RD$ @Model.Stats.MontoTotal.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card card-stat card-pendiente h-100">
            <div class="card-body text-center py-3">
                <div class="card-icon text-warning"><i class="bi bi-clock"></i></div>
                <div class="fs-3 fw-bold text-warning">@Model.Stats.TotalPendientes</div>
                <div class="small text-muted">Pendientes</div>
                <div class="small fw-bold text-warning">RD$ @Model.Stats.MontoPendiente.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card card-stat card-pagada h-100">
            <div class="card-body text-center py-3">
                <div class="card-icon text-success"><i class="bi bi-check-circle"></i></div>
                <div class="fs-3 fw-bold text-success">@Model.Stats.TotalPagadas</div>
                <div class="small text-muted">Pagadas</div>
                <div class="small fw-bold text-success">RD$ @Model.Stats.MontoPagado.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card card-stat card-parcial h-100">
            <div class="card-body text-center py-3">
                <div class="card-icon"><i class="bi bi-pie-chart"></i></div>
                <div class="fs-3 fw-bold">@Model.Stats.TotalParciales</div>
                <div class="small text-muted">Pago Parcial</div>
                <div class="small fw-bold">RD$ @Model.Stats.MontoParcial.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card card-stat card-vencida h-100">
            <div class="card-body text-center py-3">
                <div class="card-icon text-danger"><i class="bi bi-exclamation-triangle"></i></div>
                <div class="fs-3 fw-bold text-danger">@Model.Stats.TotalVencidas</div>
                <div class="small text-muted">Vencidas</div>
                <div class="small fw-bold text-danger">RD$ @Model.Stats.MontoVencido.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card h-100" style="border-left:4px solid #198754">
            <div class="card-body text-center py-3">
                <div class="card-icon text-success"><i class="bi bi-graph-up-arrow"></i></div>
                <div class="fs-5 fw-bold text-success">RD$ @Model.PromedioMensualCobrado.ToString("N0")</div>
                <div class="small text-muted">Cobro prom. mensual</div>
                <hr class="my-1"/>
                <div class="d-flex justify-content-around small">
                    <div><strong>@Model.Stats.TotalFacturas</strong><br/><span class="text-muted" style="font-size:.7rem">Facturas</span></div>
                    <div class="border-start border-end px-2"><strong>@Model.RankingClientes.Count</strong><br/><span class="text-muted" style="font-size:.7rem">Clientes</span></div>
                    <div><strong class="text-success">RD$ @((Model.Stats.TotalCobrado/1000).ToString("N0"))K</strong><br/><span class="text-muted" style="font-size:.7rem">Cobrado</span></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ════════════════════════════════════════════════════════════════════ -->
@if (!esCliente)
{
<!-- ── VISTA GENERAL ──────────────────────────────────────────────────── -->
<div class="row g-3">

    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header fw-bold" style="background:var(--azul-marino);color:white;">
                <i class="bi bi-building"></i> Balance Activo por Compañía
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>Compañía</th><th class="text-end">Saldo (RD$)</th><th class="text-center">Fact.</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var c in Model.BalancePorCompania)
                    {
                        <tr>
                            <td><a href="@Q("General")&FiltroEmpresa=@Uri.EscapeDataString(c.Nombre ?? "")" class="text-decoration-none">@c.Nombre</a></td>
                            <td class="text-end fw-semibold text-warning">@c.Monto.ToString("N2")</td>
                            <td class="text-center">@c.Cantidad</td>
                        </tr>
                    }
                    @if (!Model.BalancePorCompania.Any())
                    {
                        <tr><td colspan="3" class="text-center text-muted py-3">
                            <i class="bi bi-check-circle-fill text-success"></i> Sin saldo pendiente
                        </td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header fw-bold" style="background:var(--azul-marino);color:white;">
                <i class="bi bi-person-exclamation"></i> Top Clientes con Mayor Deuda
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>#</th><th>Cliente</th><th class="text-end">Deuda (RD$)</th><th class="text-center">Fact.</th></tr>
                    </thead>
                    <tbody>
                    @{ int rank = 1; }
                    @foreach (var c in Model.TopDeudores)
                    {
                        <tr>
                            <td><span class="badge" style="background:var(--azul-medio)">@rank</span></td>
                            <td><a href="@Q("Cliente")&FiltroCliente=@Uri.EscapeDataString(c.Nombre ?? "")" class="text-decoration-none">@c.Nombre</a></td>
                            <td class="text-end fw-semibold text-danger">@c.Monto.ToString("N2")</td>
                            <td class="text-center">@c.Cantidad</td>
                        </tr>
                        rank++;
                    }
                    @if (!Model.TopDeudores.Any())
                    {
                        <tr><td colspan="4" class="text-center text-muted py-3">
                            <i class="bi bi-emoji-smile text-success"></i> Sin deudas
                        </td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header fw-bold" style="background:var(--azul-marino);color:white;">
                <i class="bi bi-cash-stack"></i> Pagos en el período
                <span class="badge bg-light text-dark ms-2">@Model.UltimosPagos.Count</span>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>Transacción</th><th>Ticket</th><th>Fecha</th><th>Forma</th><th>Referencia</th><th class="text-end">Monto (RD$)</th><th>Usuario</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var p in Model.UltimosPagos)
                    {
                        <tr>
                            <td><small class="text-muted">@p.NumTransaccionPago</small></td>
                            <td><strong>#@p.NumTicket</strong></td>
                            <td>@p.FechaPago.ToString("dd/MM/yyyy")</td>
                            <td>@p.FormaPago</td>
                            <td>@p.NumChequeReferencia</td>
                            <td class="text-end text-success fw-bold">@p.MontoPagado.ToString("N2")</td>
                            <td><small>@p.UsuarioRegistro</small></td>
                        </tr>
                    }
                    @if (!Model.UltimosPagos.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-3">Sin pagos en este período</td></tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (Model.UltimosPagos.Any())
            {
                <div class="px-3 py-2 border-top bg-light text-end small">
                    <strong>Total cobrado:</strong>
                    <span class="text-success fw-bold fs-6 ms-2">RD$ @Model.Stats.TotalCobrado.ToString("N2")</span>
                </div>
            }
        </div>
    </div>

</div>
}
else
{
<!-- ── VISTA POR CLIENTE ───────────────────────────────────────────────── -->

<!-- Fila 1: 4 tarjetas resumen (col-md-3 cada una) -->
<div class="row g-3 mb-3">

    <!-- Tarjeta: Total Facturado + Cobrado + Clientes + Facturas -->
    <div class="col-md-3">
        <div class="card shadow-sm h-100" style="border-left:4px solid var(--azul-marino)">
            <div class="card-body py-3 px-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-receipt fs-3" style="color:var(--azul-marino)"></i>
                    <div>
                        <div class="text-muted" style="font-size:.72rem">Total Facturado en período</div>
                        <div class="fw-bold fs-5" style="color:var(--azul-marino)">
                            RD$ @Model.TotalFacturadoGlobal.ToString("N2")
                        </div>
                    </div>
                </div>
                <hr class="my-2"/>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="bi bi-cash-coin text-success"></i>
                    <div>
                        <div class="text-muted" style="font-size:.7rem">Total Cobrado en período</div>
                        <div class="fw-bold text-success">RD$ @Model.TotalCobradoGlobal.ToString("N2")</div>
                    </div>
                </div>
                <hr class="my-2"/>
                <div class="d-flex justify-content-between small">
                    <div class="text-center">
                        <div class="fw-bold fs-6">@Model.RankingClientes.Count</div>
                        <div class="text-muted" style="font-size:.7rem">Clientes</div>
                    </div>
                    <div class="border-start border-end px-3 text-center">
                        <div class="fw-bold fs-6">@Model.Stats.TotalFacturas</div>
                        <div class="text-muted" style="font-size:.7rem">Facturas</div>
                    </div>
                    <div class="text-center">
                        <div class="fw-bold fs-6 text-success">@Model.Stats.TotalPagadas</div>
                        <div class="text-muted" style="font-size:.7rem">Pagadas</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Top 2 clientes con mayor deuda (col-md-3 c/u) -->
    @{ string[] colores = { "#dc3545","#fd7e14","#ffc107" };
       string[] iconos  = { "bi-trophy-fill","bi-2-circle-fill","bi-3-circle-fill" };
    }
    @for (int i = 0; i < Math.Min(3, Model.Top3Deuda.Count); i++)
    {
        var t   = Model.Top3Deuda[i];
        var col = colores[i];
        var ico = iconos[i];
        <div class="col-md-3">
            <div class="card shadow-sm h-100" style="border-left:4px solid @col">
                <div class="card-body py-3 px-3">
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <span class="badge" style="background:@col;font-size:.7rem;color:@(i==2?"#555":"white")">
                            <i class="bi @ico"></i> #@(i+1) Deuda
                        </span>
                        <small class="text-muted">@t.NumFacturas fact.</small>
                    </div>
                    <div class="fw-bold small">@t.Cliente</div>
                    <div class="fw-bold mt-1" style="color:@col;font-size:1.1rem">
                        RD$ @t.TotalPendiente.ToString("N2")
                    </div>
                    <div class="row g-1 mt-2" style="font-size:.72rem;color:#666">
                        <div class="col-6">Fact:<br/><strong class="text-dark">@t.TotalFacturado.ToString("N0")</strong></div>
                        <div class="col-6">Pago:<br/><strong class="text-success">@t.TotalPagado.ToString("N0")</strong></div>
                    </div>
                    <div class="progress mt-2" style="height:4px">
                        <div class="progress-bar bg-success" style="width:@t.PorcentajePago%"></div>
                    </div>
                    <div class="text-muted mt-1" style="font-size:.7rem">@t.PorcentajePago% cobrado</div>
                </div>
            </div>
        </div>
    }

    @if (!Model.Top3Deuda.Any())
    {
        <div class="col-md-9">
            <div class="card shadow-sm h-100 border-success">
                <div class="card-body d-flex align-items-center justify-content-center gap-3 text-success">
                    <i class="bi bi-emoji-smile-fill fs-2"></i>
                    <div><strong>¡Sin deudas pendientes!</strong><br/><small>Todos los clientes están al día en este período.</small></div>
                </div>
            </div>
        </div>
    }

</div>

<!-- Fila 2: Gráfico de líneas mensual (pantalla completa) -->
<div class="card shadow-sm mb-4">
    <div class="card-header fw-bold" style="background:var(--azul-marino);color:white;padding:.5rem 1rem">
        <i class="bi bi-graph-up-arrow"></i> Facturado vs Cobrado por Mes
        <span class="float-end small fw-normal">
            @Model.FechaDesde.ToString("dd/MM/yyyy") — @Model.FechaHasta.ToString("dd/MM/yyyy")
        </span>
    </div>
    <div class="card-body" style="padding:.75rem 1rem">
        <canvas id="graficoMensual" style="max-height:260px"></canvas>
    </div>
</div>

<!-- Ranking completo de clientes -->
<div class="card shadow-sm">
    <div class="card-header fw-bold" style="background:var(--azul-marino);color:white;">
        <i class="bi bi-people"></i> Ranking de Clientes — @Model.RankingClientes.Count en el período
    </div>
    <div class="card-body p-0">
        @if (!Model.RankingClientes.Any())
        {
            <div class="text-center text-muted py-4">Sin datos en el período seleccionado.</div>
        }
        else
        {
        <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="text-center">#</th>
                    <th>Cliente</th>
                    <th class="text-center">Facturas</th>
                    <th class="text-end">Total Facturado</th>
                    <th class="text-end">Total Pagado</th>
                    <th class="text-end">Pendiente</th>
                    <th class="text-end">Vencido</th>
                    <th class="text-center">% Cobrado</th>
                </tr>
            </thead>
            <tbody>
            @{ int rk = 1; }
            @foreach (var c in Model.RankingClientes)
            {
                <tr class="@(c.TotalVencido > 0 ? "table-danger" : c.TotalPendiente > 0 ? "" : "table-success")">
                    <td class="text-center">
                        @if (rk <= 3)
                        {
                            <span class="badge" style="background:@(rk==1?"#ffd700":rk==2?"#c0c0c0":"#cd7f32")">@rk</span>
                        }
                        else
                        { <span class="text-muted">@rk</span> }
                    </td>
                    <td>
                        <a href="@Q("Cliente")&FiltroCliente=@Uri.EscapeDataString(c.Cliente ?? "")"
                           class="text-decoration-none fw-semibold">@c.Cliente</a>
                    </td>
                    <td class="text-center">@c.NumFacturas</td>
                    <td class="text-end fw-bold" style="color:var(--azul-marino)">RD$ @c.TotalFacturado.ToString("N2")</td>
                    <td class="text-end text-success">RD$ @c.TotalPagado.ToString("N2")</td>
                    <td class="text-end @(c.TotalPendiente > 0 ? "text-warning fw-bold" : "text-muted")">
                        RD$ @c.TotalPendiente.ToString("N2")
                    </td>
                    <td class="text-end @(c.TotalVencido > 0 ? "text-danger fw-bold" : "text-muted")">
                        RD$ @c.TotalVencido.ToString("N2")
                    </td>
                    <td class="text-center">
                        <div class="d-flex align-items-center gap-1">
                            <div class="progress flex-grow-1" style="height:8px">
                                <div class="progress-bar @(c.PorcentajePago>=100?"bg-success":c.PorcentajePago>=50?"bg-warning":"bg-danger")"
                                     style="width:@c.PorcentajePago%"></div>
                            </div>
                            <small class="@(c.PorcentajePago>=100?"text-success":"text-muted")">@c.PorcentajePago%</small>
                        </div>
                    </td>
                </tr>
                rk++;
            }
            </tbody>
            <tfoot class="table-dark fw-bold">
                <tr>
                    <td colspan="3" class="text-end">TOTALES:</td>
                    <td class="text-end">RD$ @Model.RankingClientes.Sum(c => c.TotalFacturado).ToString("N2")</td>
                    <td class="text-end text-success">RD$ @Model.RankingClientes.Sum(c => c.TotalPagado).ToString("N2")</td>
                    <td class="text-end text-warning">RD$ @Model.RankingClientes.Sum(c => c.TotalPendiente).ToString("N2")</td>
                    <td class="text-end text-danger">RD$ @Model.RankingClientes.Sum(c => c.TotalVencido).ToString("N2")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
        </div>
        }
    </div>
</div>
}

@section Scripts {
@if (Model.Vista == "Cliente")
{
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
(function () {
    var raw = @Html.Raw(Model.DatosMensualesJson);
    var labels     = raw.map(d => d.label);
    var facturado  = raw.map(d => d.facturado);
    var cobrado    = raw.map(d => d.cobrado);

    var commonOpts = {
        tension: 0.35,
        pointRadius: 4,
        pointHoverRadius: 6,
        fill: false,
        borderWidth: 2
    };

    // ── Gráfico grande (pantalla completa)
    var ctx = document.getElementById('graficoMensual');
    if (ctx) {
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    Object.assign({}, commonOpts, {
                        label: 'Facturado',
                        data: facturado,
                        borderColor: '#ffc107',
                        backgroundColor: 'rgba(255,193,7,0.12)',
                        fill: true,
                        pointBackgroundColor: '#ffc107'
                    }),
                    Object.assign({}, commonOpts, {
                        label: 'Cobrado',
                        data: cobrado,
                        borderColor: '#198754',
                        backgroundColor: 'rgba(25,135,84,0.12)',
                        fill: true,
                        pointBackgroundColor: '#198754'
                    })
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { position: 'top', labels: { font: { size: 12 } } },
                    tooltip: {
                        callbacks: {
                            label: ctx => 'RD$ ' + ctx.parsed.y.toLocaleString('es-DO', { minimumFractionDigits: 2 })
                        }
                    }
                },
                scales: {
                    y: {
                        ticks: {
                            callback: v => 'RD$ ' + (v/1000).toFixed(0) + 'K',
                            font: { size: 11 }
                        },
                        grid: { color: 'rgba(0,0,0,0.06)' }
                    },
                    x: { ticks: { font: { size: 11 } } }
                }
            }
        });
    }


})();
</script>
}
