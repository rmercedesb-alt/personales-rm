<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — AD ALL DIGITAL ENTERPRISE</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

@{
    // Leer directamente de los claims del usuario — no depende de ViewData que cada
    // página deba setear. Esto garantiza que el menú siempre sea correcto.
    var usuario     = User.FindFirst("NombreCompleto")?.Value
                   ?? ViewData["UsuarioNombre"]?.ToString()
                   ?? User.Identity?.Name ?? "";
    var perfil      = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                   ?? ViewData["UsuarioPerfil"]?.ToString() ?? "";
    var esAdmin     = perfil == "Administrador";
    var esOperativo = perfil == "Operativo" || esAdmin;
}

<!-- ═══════════════════════════════════════════════════════════
     HEADER
════════════════════════════════════════════════════════════════ -->
<header class="app-header">
    <div class="header-logo-area">
        <img src="~/images/logo-fm.png" alt="Fanny Mercedes & Asoc." class="header-logo" />
        <div class="header-titles">
            <span class="header-empresa">Fanny Mercedes &amp; Asoc.</span>
            <span class="header-sistema">AD ALL DIGITAL ENTERPRISE</span>
        </div>
    </div>
    <div class="header-user-area">
        <i class="bi bi-person-circle"></i>
        <span class="usuario-nombre">@usuario</span>
        <span class="badge bg-secondary ms-1">@perfil</span>
        <div class="dropdown ms-3">
            <button class="btn btn-sm btn-outline-light dropdown-toggle" data-bs-toggle="dropdown">
                <i class="bi bi-box-arrow-right"></i> Salir
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="/Admin/CambiarPassword">
                    <i class="bi bi-key text-primary"></i> Cambiar mi contraseña
                </a></li>
                <li><hr class="dropdown-divider"/></li>
                <li><a class="dropdown-item" href="/Logout">
                    <i class="bi bi-person-x text-secondary"></i> Cerrar sesión
                    <div class="small text-muted">El servidor sigue activo</div>
                </a></li>
                @if (esAdmin)
                {
                <li><hr class="dropdown-divider"/></li>
                <li><a class="dropdown-item text-danger" href="/Mantenimiento/Apagar">
                    <i class="bi bi-power"></i> Cerrar sesión + Apagar servidor
                    <div class="small text-muted">Detiene el sistema completamente</div>
                </a></li>
                }
            </ul>
        </div>
    </div>
</header>

