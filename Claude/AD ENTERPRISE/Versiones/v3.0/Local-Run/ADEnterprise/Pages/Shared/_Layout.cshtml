    <span class="ms-3 text-muted" style="font-size:0.75rem;">v@appVer</span>
    <!-- AD ALL DIGITAL ENTERPRISE — Derechos reservados y exclusivos. Contacto: r.mercedesb@gmail.com -->
    <span style="font-size:0.6rem;opacity:0.28;margin-left:auto;letter-spacing:.03em">
        &nbsp;Powered by AD ALL DIGITAL ENTERPRISE · r.mercedesb@gmail.com
