<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js"></script>
@await RenderSectionAsync("Scripts", required: false)

<script>
// ── Protección anti-doble-envío (aplica a TODOS los formularios POST) ─────────
// Al hacer el primer clic en "Guardar / Registrar", los botones submit quedan
// desactivados y muestran un spinner.  Si el servidor devuelve la página con
// errores de validación (reload completo) los botones se reactivan solos.
// Como respaldo se reactivan después de 30 s por si la red no responde.
(function () {
    document.addEventListener('submit', function (e) {
        var form = e.target;
        if (!form || form.method.toLowerCase() !== 'post') return;

        var btns = form.querySelectorAll('[type="submit"]:not([data-no-disable])');
        var yaEnviando = false;
        btns.forEach(function (btn) { if (btn.disabled) yaEnviando = true; });

        if (yaEnviando) {
            e.preventDefault();   // bloquear el segundo envío
            return;
        }

        btns.forEach(function (btn) {
            btn.dataset.originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Procesando...';
            setTimeout(function () {
                if (btn.disabled) {
                    btn.disabled = false;
                    btn.innerHTML = btn.dataset.originalHtml || btn.innerHTML;
                }
            }, 30000);
        });
    }, true);
})();
</script>
</body>
</html>
