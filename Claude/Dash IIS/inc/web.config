<?xml version="1.0" encoding="UTF-8"?>
<!-- Bloquea acceso HTTP directo a la carpeta inc/ -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <denyUrlSequences>
          <add sequence=".asp" />
        </denyUrlSequences>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
