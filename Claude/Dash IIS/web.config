<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- Pagina de inicio -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.asp" />
      </files>
    </defaultDocument>

    <!-- Bloquear acceso a archivos de configuracion y ambiente -->
    <security>
      <requestFiltering>
        <denyUrlSequences>
          <add sequence=".env" />
        </denyUrlSequences>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".env" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
