<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- Todo pasa por Flask (login, dashboard, API) -->
    <rewrite>
      <rules>
        <rule name="DashboardProxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:5000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Bloquear acceso directo a credenciales -->
    <security>
      <requestFiltering>
        <denyUrlSequences>
          <add sequence=".env" />
          <add sequence=".py"  />
        </denyUrlSequences>
      </requestFiltering>
    </security>

    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
