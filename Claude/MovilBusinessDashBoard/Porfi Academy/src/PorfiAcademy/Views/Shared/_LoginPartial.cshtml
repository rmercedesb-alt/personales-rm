@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <a asp-area="Identity" asp-page="/Account/Manage/Index" title="Mi cuenta">@User.Identity?.Name</a>
    <form class="inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
        <button type="submit" class="linkbtn">Salir</button>
    </form>
}
else
{
    <a asp-area="Identity" asp-page="/Account/Login">Entrar</a>
    <a class="pill" asp-area="Identity" asp-page="/Account/Register">Crear cuenta</a>
}
