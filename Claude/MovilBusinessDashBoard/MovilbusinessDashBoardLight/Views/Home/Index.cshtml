  const secsUltima=secsSinVisita(r);
  const cEl=clsDesdeUltimaVisita(isFinite(secsUltima)?secsUltima:9999,isHoy?r.UltimoPedidoHora:null);
  const prom=r.PromDurSeg!=null?hms(parseInt(r.PromDurSeg)):'';
