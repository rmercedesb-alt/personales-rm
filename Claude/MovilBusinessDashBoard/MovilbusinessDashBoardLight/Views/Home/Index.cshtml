  }
  const urg=[...visible].sort((a,b)=>secsSinVisita(b)-secsSinVisita(a)).slice(0,3);const noVL=isSelectedToday()?'Sin visita hoy':'Sin visita ese dia';const empty='<div class="urgente-empty">Todo al dia</div>';
  document.getElementById('c5-lbl').textContent=isSelectedToday()?'Llamar Urgente - Top 3':'Mayor Tiempo Sin Visita';
  document.getElementById('c-urgent').innerHTML=urg.map(r=>{const s=secsSinVisita(r),t=isFinite(s)?hms(s):noVL;return`<div class="urgente-item"><strong>${r.RepCodigo}</strong> &middot; ${r.RepNombre||'&mdash;'} <span class="urgente-time">(${t})</span></div>`;}).join('')||empty;
  // Tiempo entre Visitas: promedio global de PromDurSeg
  const promList=visible.filter(r=>r.PromDurSeg!=null).map(r=>r.PromDurSeg);
