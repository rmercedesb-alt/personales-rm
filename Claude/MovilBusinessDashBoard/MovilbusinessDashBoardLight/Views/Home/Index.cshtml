}

function fmtHrRng(h){return h!=null?`${h}:00-${h+1}:00`:'';}
function buildDetallado(visible){const isHoy=isSelectedToday();const headers=[{label:'Supervisor',key:'SupervisorNombre'},{label:'Nombre',key:'RepNombre'},{label:'Primera Visita',key:'PrimeraEntrada'},{label:'Primer Pedido',key:'PrimerPedidoHora'},{label:'Ultimo Pedido',key:'UltimoPedidoHora'},{label:'Max Hrs Entre Ped',key:'HrEntrePed'},{label:'Desde Ultima Visita',key:'UltimaSalida'},{label:'Tpo Prom Visita',key:'PromDurSeg'},{label:'Menor Prod.',key:'HoraMenorProd'},{label:'Mayor Prod.',key:'HoraMayorProd'}];
const thHtml=headers.map(h=>{const a=sortCol===h.key?'active-col':'';const ar=sortCol===h.key?(sortDir==='asc'?'&#9650;':'&#9660;'):'&#8693;';return`<th class="${a}" onclick="setSort('${h.key}')">${h.label}<span class="arr">${ar}</span></th>`;}).join('');
let rows='';sortedReps(visible).forEach(r=>{
