    const late=visible.filter(r=>{if(!r.PrimeraEntrada)return false;const d=new Date(r.PrimeraEntrada);return d.getHours()*60+d.getMinutes()>=8*60+20;}).length;
    setCardNum('c-late',late);
    document.getElementById('c2-lbl').textContent='Primera Visita Tardia';
