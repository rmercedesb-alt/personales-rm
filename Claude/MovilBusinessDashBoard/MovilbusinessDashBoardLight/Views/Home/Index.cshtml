  if(promGlobal!=null){elTprom.textContent=hms(promGlobal);elTprom.style.fontSize='22px';}else{elTprom.textContent='--';elTprom.style.fontSize='42px';}
  // Avg Primer Pedido y Avg Ultimo Pedido
