document.getElementById('tbl-cont').innerHTML=`<table><thead><tr>${thHtml}</tr></thead><tbody>${rows}</tbody></table>`;}

function buildResumido(visible){const HALF=30*60,supMap={};visible.forEach(r=>{const k=r.RepSupervisor||'__none__';if(!supMap[k])supMap[k]={nombre:r.SupervisorNombre||r.RepSupervisor||'(Sin supervisor)',reps:[]};supMap[k].reps.push(r);});
function buildResRow(list,nombre,isTotal){if(!list.length)return'';const n=list.length,avgPV=avgSecsOfDay(list,'PrimeraEntrada'),conE=list.filter(r=>r.PrimeraEntrada&&r.PrimeraEntrada.startsWith(selectedDate)),aT=conE.filter(r=>{const d=new Date(r.PrimeraEntrada);return d.getHours()*60+d.getMinutes()<8*60+20;}).length,pctAt=conE.length>0?Math.round(aT/conE.length*100):null,avgPP=avgSecsOfDay(list,'PrimerPedidoHora'),durV=list.filter(r=>r.DuracionSeg!=null).map(r=>parseInt(r.DuracionSeg)),avgDur=durV.length?durV.reduce((a,b)=>a+b,0)/durV.length:null,sinV=list.filter(r=>isFinite(secsSinVisita(r))).map(r=>secsSinVisita(r)),avgSin=sinV.length?sinV.reduce((a,b)=>a+b,0)/sinV.length:null;
const pvB=avgPV!=null?`<span class="badge ${clsBySecs(avgPV)}">${secsToTimeStr(avgPV)}</span>`:'<span style="color:#555">&#8212;</span>',ppB=avgPP!=null?`<span class="badge ${clsBySecs(avgPP)}">${secsToTimeStr(avgPP)}</span>`:'<span style="color:#555">&#8212;</span>',durC=avgDur!=null?`<span class="badge bneutral">${hms(avgDur)}</span>`:'<span style="color:#555">&#8212;</span>',sinC=avgSin!=null?`<span class="badge ${avgSin>HALF?'vdr':'vg'}">${hms(avgSin)}</span>`:'<span style="color:#555">&#8212;</span>';
let pc='#8b949e';if(pctAt!=null)pc=pctAt>=80?'#7ee07e':pctAt>=50?'#ffd54f':'#ef9a9a';const pctC=pctAt!=null?`<span style="font-weight:700;color:${pc}">${pctAt}%</span>`:'<span style="color:#555">&#8212;</span>';
return`<tr class="${isTotal?'row-total':''}"><td class="c-sup">${nombre}</td><td class="c-cod" style="text-align:center">${n}</td><td>${pvB}</td><td style="text-align:center">${pctC}</td><td>${ppB}</td><td>${durC}</td><td>${sinC}</td></tr>`;}
const thHtml=['Supervisor','# Reps','Avg 1a Visita','% A Tiempo','Avg 1er Pedido','Avg Duracion','Avg Ult. Visita'].map(h=>`<th class="no-sort">${h}</th>`).join('');
const sorted=Object.values(supMap).sort((a,b)=>a.nombre.localeCompare(b.nombre)),rows=sorted.map(s=>buildResRow(s.reps,s.nombre,false)).join(''),totalRow=buildResRow(visible,'COMPANIA',true);
document.getElementById('tbl-cont').innerHTML=`<table><thead><tr>${thHtml}</tr></thead><tbody>${rows}${totalRow}</tbody></table>`;}

function buildTable(){const visible=filteredReps(),total=reps.length;document.getElementById('f-count').textContent=visible.length<total?`Mostrando ${visible.length} de ${total} representantes`:`${total} representantes`;const ml=viewMode==='resumido'?'Resumen por Supervisor':'Detalle por Representante';document.getElementById('tbl-title').innerHTML=`${ml} &mdash; <span id="lbl-fecha">${fmtFechaLabel(selectedDate)}</span>`;if(!visible.length){document.getElementById('tbl-cont').innerHTML='<div class="loading">Sin resultados para los filtros aplicados.</div>';updateCards();return;}viewMode==='resumido'?buildResumido(visible):buildDetallado(visible);updateCards();}

function updateLive(){const now=Date.now(),isHoy=isSelectedToday(),n=new Date();document.getElementById('clock').textContent=`${pad(n.getHours())}:${pad(n.getMinutes())}:${pad(n.getSeconds())}`;if(!isHoy)return;if(viewMode==='detallado')reps.forEach(r=>{const cell=document.getElementById(safeId(r.RepCodigo));if(!cell)return;const span=cell.querySelector('.badge');if(!span||!r.UltimaSalida||!isToday(r.UltimaSalida))return;const secs=(now-new Date(r.UltimaSalida).getTime())/1000;span.textContent=hms(secs);const nc=clsDesdeUltimaVisita(secs,r.UltimoPedidoHora);span.className='badge '+nc;});updateCards();countdown--;const cdEl=document.getElementById('cd');if(cdEl)cdEl.textContent=Math.max(0,countdown);if(countdown<=0){countdown=REFRESH;fetchData();}}

async function fetchData(){
  try{
    const resp=await fetch(BASE+'/api/data?fecha='+selectedDate);
    if(resp.status===401){location.href=BASE+'/account/login';return;}
    if(!resp.ok){let msg='HTTP '+resp.status;try{const e=await resp.json();if(e.error)msg=e.error;}catch{}throw new Error(msg);}
    const json=await resp.json();
    if(!json.ok)throw new Error(json.error||'Error del servidor');
    horaStats=json.horaStats||[];
    // Mapear HrEntrePed = MaxGapSeg para que la columna sea ordenable
    reps=json.reps.map(r=>({...r,HrEntrePed:r.MaxGapSeg??null}));selectedDate=json.fecha;
    populateSupervisores();populateCentros();buildTable();
    const cdB=document.getElementById('cd-badge');
    if(isSelectedToday()){cdB.className='cd-badge';cdB.innerHTML=`Actualizacion en <span id="cd">${countdown}</span>s`;}else{cdB.className='hist-badge';cdB.textContent='Vista historica';}
    document.getElementById('err-bar').style.display='none';
    document.getElementById('live-txt').textContent='Actualizado a las '+new Date().toLocaleTimeString('es-DO');
    if(isSelectedToday())countdown=REFRESH;
  }catch(e){const bar=document.getElementById('err-bar');bar.textContent='Error de conexion: '+e.message;bar.style.display='block';document.getElementById('live-txt').textContent='Sin conexion';}}

function init(){const dp=document.getElementById('f-date'),hoy=todayStr(),min=new Date(Date.now()-30*24*60*60*1000).toISOString().split('T')[0];dp.value=hoy;dp.max=hoy;dp.min=min;selectedDate=hoy;
dp.addEventListener('change',()=>{selectedDate=dp.value||hoy;countdown=REFRESH;fetchData();});
document.getElementById('f-name').addEventListener('input',buildTable);
document.addEventListener('click',e=>{const w=document.getElementById('ms-wrap');if(w&&!w.contains(e.target)){document.getElementById('ms-drop').classList.remove('ms-open');document.getElementById('ms-trigger').classList.remove('ms-open');}const wc=document.getElementById('ct-wrap');if(wc&&!wc.contains(e.target)){document.getElementById('ct-drop').classList.remove('ms-open');document.getElementById('ct-trigger').classList.remove('ms-open');}});
fetch(BASE+'/api/me').then(r=>{if(r.status===401){location.href=BASE+'/account/login';return null;}return r.json();}).then(j=>{if(j&&j.ok)document.getElementById('user-nombre').textContent=j.nombre||j.login;}).catch(()=>{});
fetchData();setInterval(updateLive,1000);}

function printReport() {
  const visible = filteredReps();
  const total = reps.length;
  // Fecha
  document.getElementById('ph-fecha-print').innerHTML =
    '<strong>Fecha:</strong> ' + (fmtFechaLabel(selectedDate) || selectedDate);
  // Vista
  const vistaTxt = viewMode === 'resumido' ? 'Resumido (por Supervisor)' : 'Detallado (por Representante)';
  document.getElementById('ph-vista-print').innerHTML =
    '<strong>Vista:</strong> ' + vistaTxt;
  // Filtros activos
  const partes = [];
  const nameVal = document.getElementById('f-name').value.trim();
  if (nameVal) partes.push('<strong>Buscar:</strong> ' + nameVal);
  if (selectedSups.size > 0) {
    const supMap = buildSupMap();
    const noms = [...selectedSups].map(c => supMap[c] || c);
    partes.push('<strong>Supervisor:</strong> ' + noms.join(', '));
  }
  if (selectedCentros.size > 0) {
    const ctMap = buildCtMap();
    const noms = [...selectedCentros].map(c => ctMap[c] || c);
    partes.push('<strong>Centro:</strong> ' + noms.join(', '));
  }
  if (filterLate)  partes.push('<strong>Filtro:</strong> 1a Visita Tardía');
  if (filterInact) partes.push('<strong>Filtro:</strong> +30 Min Sin Visita');
  document.getElementById('ph-filtros-print').innerHTML =
    partes.length ? partes.join(' &nbsp;|&nbsp; ') : '';
  // KPIs resumen
  const HALF = 30 * 60;
  const late = visible.filter(r => {
    if (!r.PrimeraEntrada) return false;
    const d = new Date(r.PrimeraEntrada);
    return d.getHours() * 60 + d.getMinutes() >= 8 * 60 + 20;
  }).length;
  const inact = visible.filter(r => secsSinVisita(r) > HALF).length;
  let kpis = '<strong>Mostrando:</strong> ' + visible.length + ' de ' + total + ' representantes';
  if (viewMode === 'detallado') {
    kpis += ' &nbsp;|&nbsp; <strong>Tardíos:</strong> ' + late;
    kpis += ' &nbsp;|&nbsp; <strong>+30 min sin visita:</strong> ' + inact;
  }
  document.getElementById('ph-kpis-print').innerHTML = kpis;
  window.print();
}

init();
</script>
</body>
</html>
