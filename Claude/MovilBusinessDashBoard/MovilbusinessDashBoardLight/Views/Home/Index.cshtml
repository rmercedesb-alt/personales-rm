@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Dashboard Visitas &mdash; AM COMERCIAL</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{background:#0d1117;color:#e6edf3;font-family:'Segoe UI',Tahoma,sans-serif;padding:14px 20px;height:100vh;overflow:hidden;display:flex;flex-direction:column}
.co-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid #21262d;flex-shrink:0}
.co-left{display:flex;align-items:center;gap:14px}
.co-name{font-size:19px;font-weight:800;color:#e6edf3;letter-spacing:.4px}
.co-subtitle{font-size:12px;color:#58a6ff;font-weight:500;margin-top:3px}
.co-right{display:flex;flex-direction:column;align-items:flex-end;gap:3px}
.co-clock{font-family:monospace;font-size:21px;color:#58a6ff;font-weight:700}
.live{display:flex;align-items:center;gap:7px;font-size:11px;color:#8b949e}
.dot{width:8px;height:8px;background:#3fb950;border-radius:50%;animation:pulse 2s infinite;flex-shrink:0}
@@keyframes pulse{0%,100%{opacity:1}50%{opacity:.25}}
.cards{display:grid;grid-template-columns:repeat(7,1fr);gap:11px;margin-bottom:12px;flex-shrink:0}
.card{background:#161b22;border:1px solid #30363d;border-radius:10px;padding:12px 14px;position:relative;overflow:hidden}
.card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;border-radius:10px 10px 0 0}
.c-blue::before{background:#58a6ff}.c-yellow::before{background:#e3b341}.c-green::before{background:#3fb950}.c-orange::before{background:#f0883e}.c-red::before{background:#b71c1c}
.card-lbl{font-size:10px;color:#8b949e;text-transform:uppercase;letter-spacing:.7px;margin-bottom:6px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.card-val{font-size:42px;font-weight:700;line-height:1;margin-bottom:4px;transition:font-size .15s}
.c-blue .card-val{color:#58a6ff}.c-yellow .card-val{color:#e3b341}.c-green .card-val{color:#3fb950}.c-orange .card-val{color:#f0883e}.c-red .card-val{color:#ff7b7b}
.card-hint{font-size:10px;color:#8b949e;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.urgente-list{margin-top:6px}.urgente-item{font-size:11px;padding:4px 0;border-bottom:1px solid #21262d;color:#ffaaaa;line-height:1.35}.urgente-item:last-child{border-bottom:none}
.urgente-time{color:#8b949e;font-family:monospace;font-size:10px}.urgente-empty{font-size:12px;color:#3fb950;margin-top:6px}
.top3-list{margin-top:6px}.top3-item{font-size:11px;padding:4px 0;border-bottom:1px solid #21262d;color:#e6edf3;line-height:1.35}.top3-item:last-child{border-bottom:none}
.top3-num{color:#ff7b7b;font-weight:800;font-size:12px;margin-right:5px}
.tbl-wrap{background:#161b22;border:1px solid #30363d;border-radius:10px;overflow:hidden;flex:1;display:flex;flex-direction:column;min-height:0}
.tbl-bar{display:flex;justify-content:space-between;align-items:center;padding:10px 16px;border-bottom:1px solid #30363d;flex-shrink:0}
.tbl-bar h2{font-size:13px;font-weight:600}
.cd-badge{background:#21262d;border-radius:20px;padding:3px 12px;font-size:11px;color:#8b949e;white-space:nowrap}
.hist-badge{background:#2d2000;color:#e3b341;border-radius:20px;padding:3px 12px;font-size:11px;white-space:nowrap}
.filter-bar{display:flex;gap:8px;align-items:center;padding:9px 16px;border-bottom:1px solid #30363d;flex-wrap:wrap;background:#0d1117;flex-shrink:0}
.f-lbl{font-size:11px;color:#8b949e;white-space:nowrap}
.filter-bar input[type=date],.filter-bar input[type=text]{background:#21262d;border:1px solid #30363d;color:#e6edf3;border-radius:6px;padding:4px 8px;font-size:12px;outline:none;transition:border .15s;height:29px}
.filter-bar input[type=date]:focus,.filter-bar input[type=text]:focus{border-color:#58a6ff}
.filter-bar input[type=text]{width:185px}.filter-bar input[type=date]{width:138px;color-scheme:dark}
.f-count{font-size:11px;color:#8b949e;margin-left:auto;white-space:nowrap}
.f-sep{width:1px;height:18px;background:#30363d;flex-shrink:0}
.btn-clear{background:none;border:1px solid #30363d;color:#8b949e;border-radius:6px;padding:4px 10px;font-size:11px;cursor:pointer;height:29px;transition:all .15s}
.btn-clear:hover{border-color:#58a6ff;color:#58a6ff}
.btn-filter{background:none;border:1px solid #30363d;color:#8b949e;border-radius:6px;padding:4px 11px;font-size:11px;cursor:pointer;height:29px;transition:all .15s;white-space:nowrap;font-weight:500}
.btn-filter:hover{border-color:#8b949e;color:#e6edf3}
.btn-filter.fa-yellow{background:#2d2200;border-color:#e3b341;color:#e3b341;font-weight:700}
.btn-filter.fa-orange{background:#2d1400;border-color:#f0883e;color:#f0883e;font-weight:700}
.ms-wrap{position:relative;flex-shrink:0}
.ms-trigger{background:#21262d;border:1px solid #30363d;color:#e6edf3;border-radius:6px;padding:0 10px;font-size:12px;cursor:pointer;height:29px;display:flex;align-items:center;gap:6px;min-width:195px;transition:border .15s;text-align:left}
.ms-trigger:hover,.ms-trigger.ms-open{border-color:#58a6ff}.ms-trigger.ms-active{color:#58a6ff;border-color:#388bfd}
#ms-label{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ms-arrow{color:#8b949e;font-size:10px;flex-shrink:0;transition:transform .15s}.ms-trigger.ms-open .ms-arrow{transform:rotate(180deg)}
.ms-drop{position:absolute;top:calc(100% + 4px);left:0;background:#1c2128;border:1px solid #30363d;border-radius:8px;min-width:220px;max-height:230px;overflow-y:auto;z-index:200;display:none;box-shadow:0 8px 24px rgba(0,0,0,.6)}
.ms-drop.ms-open{display:block}.ms-opt{display:flex;align-items:center;gap:9px;padding:6px 12px;font-size:12px;cursor:pointer;user-select:none;transition:background .1s}
.ms-opt:hover{background:#21262d}.ms-opt input[type=checkbox]{accent-color:#58a6ff;cursor:pointer;flex-shrink:0;width:13px;height:13px}
.ms-divider{border:none;border-top:1px solid #30363d;margin:2px 0}
.view-toggle{display:flex;border:1px solid #30363d;border-radius:6px;overflow:hidden;flex-shrink:0}
.view-btn{background:transparent;border:none;color:#8b949e;padding:0 14px;font-size:11px;cursor:pointer;font-weight:500;transition:all .15s;height:29px;white-space:nowrap}
.view-btn.active{background:#1f3b5c;color:#58a6ff;font-weight:700}.view-btn:not(.active):hover{background:#21262d;color:#e6edf3}
table{width:100%;border-collapse:collapse}
thead th{padding:8px 13px;text-align:left;font-size:10px;color:#8b949e;text-transform:uppercase;letter-spacing:.4px;background:#1c2128;border-bottom:1px solid #30363d;font-weight:600;white-space:nowrap;cursor:pointer;user-select:none;transition:background .15s,color .15s;position:sticky;top:0;z-index:10}
thead th:hover{background:#24292f;color:#c9d1d9}
thead th .arr{margin-left:4px;opacity:.3;font-style:normal}
thead th.active-col{color:#58a6ff}thead th.active-col .arr{opacity:1;color:#58a6ff}
thead th.no-sort{cursor:default}thead th.no-sort:hover{background:#1c2128;color:#8b949e}
tbody td{padding:7px 13px;border-bottom:1px solid #1c2128;font-size:14px;vertical-align:middle}
tbody tr:last-child td{border-bottom:none}tbody tr:hover td{background:rgba(255,255,255,.018)}
.c-cod{font-weight:700;color:#8b949e;white-space:nowrap}.c-nom{font-weight:500}.c-sup{font-size:11px;color:#8b949e}
.row-total td{background:#1c2128;border-top:2px solid #30363d}.row-total .c-sup{color:#58a6ff;font-weight:800;font-size:12px;letter-spacing:.5px}
.badge{display:inline-block;padding:3px 9px;border-radius:4px;font-weight:700;font-size:11px;font-family:monospace;min-width:78px;text-align:center;letter-spacing:.3px}
.vg{background:#1a5c1a;color:#7ee07e}.vy{background:#5a4200;color:#ffd54f}.vly{background:#4a3800;color:#ffe082}
.vlr{background:#5a2020;color:#ef9a9a}.vdr{background:#8b1515;color:#fff}.bneutral{background:#21262d;color:#8b949e}
.vbl{background:#0d2a4a;color:#58a6ff}.vpu{background:#2d1b4e;color:#c792ea}
.badge.empty{color:transparent!important;min-width:78px}
#tbl-cont{flex:1;overflow-y:auto;min-height:0}
#tbl-cont::-webkit-scrollbar{width:6px}#tbl-cont::-webkit-scrollbar-track{background:transparent}
#tbl-cont::-webkit-scrollbar-thumb{background:#30363d;border-radius:3px}#tbl-cont::-webkit-scrollbar-thumb:hover{background:#58a6ff}
.err{background:#3a1515;border:1px solid #7a1010;border-radius:8px;padding:8px 14px;margin-bottom:10px;font-size:12px;display:none;flex-shrink:0}
.loading{text-align:center;padding:36px;color:#8b949e;font-size:13px}
.btn-print{background:#21262d;border:1px solid #30363d;color:#8b949e;border-radius:6px;padding:0 11px;font-size:11px;cursor:pointer;transition:all .15s;white-space:nowrap;height:28px;font-family:inherit;font-weight:500}
.btn-print:hover{border-color:#3fb950;color:#3fb950}
#print-hdr{display:none;margin-bottom:10px;padding-bottom:8px;border-bottom:2px solid #000}
#print-hdr h2{font-size:15px;font-weight:800;margin-bottom:3px}
#print-hdr .ph-meta{font-size:11px;margin-top:2px;color:#333}
@@media print{
  body{overflow:visible!important;height:auto!important;background:#fff!important;color:#000!important;padding:8px 12px!important}
  .co-right a,.btn-print,.cd-badge,.hist-badge,.filter-bar,.err,#err-bar,.cards{display:none!important}
  .tbl-wrap{border:none!important;overflow:visible!important;flex:none!important}
  .tbl-bar{border-bottom:1px solid #ccc!important}
  .tbl-bar h2{color:#000!important}
  #tbl-cont{overflow:visible!important;height:auto!important}
  #print-hdr{display:block!important}
  table{width:100%}
  thead{display:table-header-group!important}
  thead th{background:#f0f0f0!important;color:#000!important;border-bottom:1px solid #bbb!important;position:static!important}
  tbody td{color:#000!important;border-bottom:1px solid #e8e8e8!important}
  .badge{color:#000!important;background:#ececec!important;border:1px solid #ccc!important}
  .c-sup,.c-nom,.c-cod{color:#000!important}
  .row-total td{background:#d6e4ff!important;border-top:2px solid #336!important;color:#000!important}
  tr{page-break-inside:avoid}
  @@page{size:landscape;margin:1.2cm 1.5cm}
}
</style>
</head>
<body>

<header class="co-header">
  <div class="co-left">
    <img id="logo-img" src="@(Context.Request.PathBase)/api/logo" alt="Logo"
         style="height:52px;width:auto;max-width:160px;border-radius:6px;object-fit:contain"
         onerror="this.style.display='none';document.getElementById('logo-svg').style.display='block'">
    <svg id="logo-svg" style="display:none" width="70" height="46" viewBox="0 0 70 46" xmlns="http://www.w3.org/2000/svg">
      <defs><clipPath id="lc"><rect width="70" height="46" rx="6"/></clipPath></defs>
      <rect width="70" height="46" rx="6" fill="#0f1922"/>
      <g clip-path="url(#lc)">
        <polygon points="1,0 15,0 25,46 11,46" fill="#2196F3"/>
        <polygon points="19,0 28,0 38,46 29,46" fill="#43A047"/>
        <polygon points="32,0 41,0 51,46 42,46" fill="#43A047"/>
        <polygon points="45,0 54,0 64,46 55,46" fill="#43A047"/>
        <polygon points="58,0 67,0 77,46 68,46" fill="#43A047"/>
      </g>
    </svg>
    <div>
      <div class="co-name">@(string.IsNullOrEmpty(ViewBag.EmpNombre as string) ? "AM COMERCIAL" : ViewBag.EmpNombre)</div>
      <div class="co-subtitle">Dashboard Visitas en Vivo</div>
    </div>
  </div>
  <div class="co-right">
    <div style="display:flex;align-items:center;gap:12px">
      <div style="text-align:right">
        <div class="live"><div class="dot"></div><span id="live-txt">Conectando...</span></div>
        <div style="font-size:11px;color:#8b949e;margin-top:2px"><span id="user-nombre"></span></div>
      </div>
      <button class="btn-print" onclick="printReport()" title="Imprimir / Exportar PDF">&#128424; Imprimir</button>
      <a href="@(Context.Request.PathBase)/" title="Inicio"
         style="background:#21262d;border:1px solid #30363d;color:#8b949e;border-radius:6px;padding:5px 10px;font-size:11px;text-decoration:none;transition:all .15s;white-space:nowrap;display:inline-block;margin-right:6px"
         onmouseover="this.style.borderColor='#58a6ff';this.style.color='#58a6ff'"
         onmouseout="this.style.borderColor='#30363d';this.style.color='#8b949e'">
        &#x2302; Inicio
      </a>
      <a href="@(Context.Request.PathBase)/account/logout" title="Cerrar sesion"
         style="background:#21262d;border:1px solid #30363d;color:#8b949e;border-radius:6px;padding:5px 10px;font-size:11px;text-decoration:none;transition:all .15s;white-space:nowrap;display:inline-block"
         onmouseover="this.style.borderColor='#f85149';this.style.color='#f85149'"
         onmouseout="this.style.borderColor='#30363d';this.style.color='#8b949e'">
        &#x2192; Salir
      </a>
    </div>
    <div class="co-clock" id="clock">--:--:--</div>
  </div>
</header>

<div class="err" id="err-bar"></div>

<div id="print-hdr">
  <h2>@(string.IsNullOrEmpty(ViewBag.EmpNombre as string) ? "AM COMERCIAL" : ViewBag.EmpNombre) &mdash; Dashboard Visitas en Vivo</h2>
  <div class="ph-meta" id="ph-fecha-print"></div>
  <div class="ph-meta" id="ph-vista-print"></div>
  <div class="ph-meta" id="ph-filtros-print"></div>
  <div class="ph-meta" id="ph-kpis-print"></div>
</div>

<div class="cards">
  <!-- 1: Total -->
  <div class="card c-blue">
    <div class="card-lbl" id="c1-lbl">Total Representantes</div>
    <div class="card-val" id="c-total">--</div>
    <div class="card-hint" id="c1-hint">Activos en los ultimos 30 dias</div>
  </div>
  <!-- 2: Primera Visita Tardia -->
  <div class="card c-yellow">
    <div class="card-lbl" id="c2-lbl">Primera Visita Tardia</div>
    <div class="card-val" id="c-late">--</div>
    <div class="card-hint" id="c2-hint">Entrada despues de las 8:20 AM</div>
  </div>
  <!-- 3: +30 Min Sin Visitas (movida al 3er lugar) -->
  <div class="card c-orange">
    <div class="card-lbl" id="c4-lbl">+30 Min Sin Visitas</div>
    <div class="card-val" id="c-inact">--</div>
    <div class="card-hint" id="c4-hint">Sin nueva visita en 30 minutos</div>
  </div>
  <!-- 4: Avg Primer Pedido + Avg Ultimo Pedido (combinada) -->
  <div class="card c-green">
    <div class="card-lbl">Avg Pedidos</div>
    <div style="display:flex;gap:6px;margin-top:6px">
      <div style="flex:1;text-align:center">
        <div style="font-size:9px;color:#8b949e;text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px">1er Pedido</div>
        <div id="c-ped" style="font-size:17px;font-weight:700;color:#3fb950;font-family:monospace">--</div>
      </div>
      <div style="width:1px;background:#30363d;flex-shrink:0"></div>
      <div style="flex:1;text-align:center">
        <div style="font-size:9px;color:#8b949e;text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px">Ult. Pedido</div>
        <div id="c-avgup" style="font-size:17px;font-weight:700;color:#3fb950;font-family:monospace">--</div>
      </div>
    </div>
  </div>
  <!-- 5: Mayor / Menor Productividad (combinada) -->
  <div class="card c-blue">
    <div class="card-lbl">Productividad por Hora</div>
    <div style="display:flex;gap:6px;margin-top:6px">
      <div style="flex:1;text-align:center">
        <div style="font-size:9px;color:#8b949e;text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px">Mayor</div>
        <div id="c-mayor-prod" style="font-size:14px;font-weight:700;color:#58a6ff;font-family:monospace">--</div>
        <div id="c-mayor-prod-cnt" style="font-size:11px;color:#8b949e;margin-top:3px"></div>
      </div>
      <div style="width:1px;background:#30363d;flex-shrink:0"></div>
      <div style="flex:1;text-align:center">
        <div style="font-size:9px;color:#8b949e;text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px">Menor</div>
        <div id="c-menor-prod" style="font-size:14px;font-weight:700;color:#f0883e;font-family:monospace">--</div>
        <div id="c-menor-prod-cnt" style="font-size:11px;color:#8b949e;margin-top:3px"></div>
      </div>
    </div>
  </div>
  <!-- 6: Tiempo entre Visitas -->
  <div class="card c-blue">
    <div class="card-lbl">Tiempo entre Visitas</div>
    <div class="card-val" id="c-tprom" style="font-size:22px">--</div>
    <div class="card-hint">Prom. duracion visita 9AM-3PM</div>
  </div>
  <!-- 7: Llamar Urgente (al final) -->
  <div class="card c-red">
    <div class="card-lbl" id="c5-lbl">Llamar Urgente - Top 3</div>
    <div class="urgente-list" id="c-urgent"><span style="color:#8b949e;font-size:11px">Cargando...</span></div>
  </div>
</div>

<div class="tbl-wrap">
  <div class="tbl-bar">
    <h2 id="tbl-title">Detalle por Representante &mdash; <span id="lbl-fecha">Hoy</span></h2>
    <div class="cd-badge" id="cd-badge">Actualizacion en <span id="cd">60</span>s</div>
  </div>
  <div class="filter-bar">
    <span class="f-lbl">Fecha:</span>
    <input type="date" id="f-date">
    <div class="f-sep"></div>
    <span class="f-lbl">Buscar:</span>
    <input type="text" id="f-name" placeholder="Nombre del representante...">
    <div class="f-sep"></div>
    <span class="f-lbl">Centro:</span>
    <div class="ms-wrap" id="ct-wrap">
      <button class="ms-trigger" id="ct-trigger" onclick="toggleCtDrop(event)">
        <span id="ct-label">Todos los centros</span>
        <span class="ms-arrow">&#9660;</span>
      </button>
      <div class="ms-drop" id="ct-drop">
        <div class="ms-opt" id="ct-opt-all" onclick="toggleAllCentros()">
          <input type="checkbox" id="ct-chk-all" checked onclick="event.stopPropagation()">
          <span>Todos los centros</span>
        </div>
        <hr class="ms-divider">
        <div id="ct-options"></div>
      </div>
    </div>
    <div class="f-sep"></div>
    <span class="f-lbl">Supervisor:</span>
    <div class="ms-wrap" id="ms-wrap">
      <button class="ms-trigger" id="ms-trigger" onclick="toggleMsDrop(event)">
        <span id="ms-label">Todos los supervisores</span>
        <span class="ms-arrow">&#9660;</span>
      </button>
      <div class="ms-drop" id="ms-drop">
        <div class="ms-opt" id="ms-opt-all" onclick="toggleAllSups()">
          <input type="checkbox" id="ms-chk-all" checked onclick="event.stopPropagation()">
          <span>Todos los supervisores</span>
        </div>
        <hr class="ms-divider">
        <div id="ms-options"></div>
      </div>
    </div>
    <div class="f-sep"></div>
    <div class="view-toggle">
      <button class="view-btn active" id="btn-det" onclick="setView('detallado')">Detallado</button>
      <button class="view-btn"        id="btn-res" onclick="setView('resumido')">Resumido</button>
    </div>
    <div class="f-sep"></div>
    <button class="btn-filter" id="btn-flate"  onclick="toggleFilterLate()">&#9679; 1a Visita Tardia</button>
    <button class="btn-filter" id="btn-finact" onclick="toggleFilterInact()">&#9679; +30 Min Sin Visita</button>
    <button class="btn-clear" onclick="clearFilters()">Limpiar filtros</button>
    <span class="f-count" id="f-count"></span>
  </div>
  <div id="tbl-cont"><div class="loading">Cargando datos...</div></div>
</div>

<script>
const BASE = '@Context.Request.PathBase.Value';
const REFRESH = 60;
let reps = [], horaStats = [], countdown = REFRESH, selectedDate = '';
let sortCol = 'SupervisorNombre', sortDir = 'asc', viewMode = 'detallado';
let selectedSups = new Set(), selectedCentros = new Set(), filterLate = false, filterInact = false;

function todayStr() { return new Date().toISOString().split('T')[0]; }
function isSelectedToday() { return selectedDate === todayStr(); }
function pad(n) { return String(n).padStart(2, '0'); }
function referenceTime() { return isSelectedToday() ? Date.now() : new Date(selectedDate + 'T23:59:59').getTime(); }
function hadVisitOnDate(r) { return r.UltimaEntrada != null && r.UltimaEntrada.startsWith(selectedDate); }
function secsSinVisita(r) { if (!hadVisitOnDate(r)) return Infinity; return (referenceTime() - new Date(r.UltimaEntrada).getTime()) / 1000; }

function clsBySecs(s) { const m = s/60; if(m<8*60+20)return'vg'; if(m<8*60+45)return'vy'; if(m<9*60)return'vly'; if(m<=9*60+15)return'vlr'; return'vdr'; }
function cls(iso) { if(!iso)return'vdr'; const d=new Date(iso); return clsBySecs(d.getHours()*3600+d.getMinutes()*60+d.getSeconds()); }

// Color para "Desde Ultima Visita" segun minutos transcurridos y ultimo pedido
function clsDesdeUltimaVisita(secsElapsed, ultimoPedidoIso) {
  const now = new Date();
  const nowMins = now.getHours()*60 + now.getMinutes();
  // Si ya pasan de las 3:30 PM y el ultimo pedido fue despues de las 3:20 PM -> verde siempre
  if(nowMins >= 15*60+30 && ultimoPedidoIso) {
    const up = new Date(ultimoPedidoIso);
    const upMins = up.getHours()*60 + up.getMinutes();
    if(upMins >= 15*60+20) return 'vg';
  }
  const m = secsElapsed / 60;
  if(m <= 15) return 'vg';
  if(m <= 30) return 'vy';
  return 'vdr';
}

// Color para "Ultimo Pedido"
// isHoy=true  -> regla por tiempo transcurrido si aun no son las 3 PM
// isHoy=false -> historico: siempre evaluar por la hora del pedido
function clsUltimoPedido(ultimoPedidoIso, isHoy) {
  if(!ultimoPedidoIso) return 'vdr';
  const up     = new Date(ultimoPedidoIso);
  const upMins = up.getHours()*60 + up.getMinutes();
  if(!isHoy) {
    // Historico: regla por hora absoluta del pedido
    if(upMins >= 15*60) return 'vg';    // >= 15:00 -> Verde
    if(upMins >= 14*60) return 'vy';    // >= 14:00 -> Amarillo
    return 'vdr';                        //  < 14:00 -> Rojo
  }
  const now     = new Date();
  const nowMins = now.getHours()*60 + now.getMinutes();
  if(nowMins >= 15*60) {
    // Hoy y ya son >= 15:00 PM: regla por hora absoluta del pedido
    if(upMins >= 15*60) return 'vg';
    if(upMins >= 14*60) return 'vy';
    return 'vdr';
  } else {
    // Hoy y aun no son las 15:00: regla por tiempo transcurrido
    const minsDiff = (now - up) / 60000;
    if(minsDiff < 30) return 'vg';      // < 30 min  -> Verde
    if(minsDiff < 60) return 'vy';      // 30-59 min -> Amarillo
    return 'vdr';                        // 60+ min   -> Rojo
  }
}

// Color para "Tiempo Prom. en Visitas" (en segundos)
function clsPromVisita(seg) {
  if(seg == null) return 'bneutral';
  const m = seg / 60;
  if(m < 2)  return 'vdr';
  if(m <= 4) return 'vy';
  if(m <= 8) return 'vg';
  if(m <= 15) return 'vbl';
  return 'vpu';
}

function hms(sec) { if(sec==null||isNaN(sec)||sec<0)return'--:--:--'; sec=Math.floor(sec); return `${pad(Math.floor(sec/3600))}:${pad(Math.floor((sec%3600)/60))}:${pad(sec%60)}`; }
function fmtHora(iso) { if(!iso)return''; const d=new Date(iso); return `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`; }
function isToday(iso) { if(!iso)return false; return new Date(iso).toDateString()===new Date().toDateString(); }
function safeId(code) { return 'el_'+String(code).replace(/\W/g,'_'); }
function fmtFechaLabel(str) { if(!str||str===todayStr())return'Hoy'; const[y,m,d]=str.split('-'); return `${parseInt(d)} ${['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'][parseInt(m)-1]} ${y}`; }

function avgSecsOfDay(list,field) { const v=list.filter(r=>r[field]&&r[field].startsWith(selectedDate)).map(r=>{const d=new Date(r[field]);return d.getHours()*3600+d.getMinutes()*60+d.getSeconds()}); return v.length?v.reduce((a,b)=>a+b,0)/v.length:null; }
function secsToTimeStr(s) { return s==null||isNaN(s)?'--:--:--':hms(Math.round(s)); }

function setCardNum(id,v) { const el=document.getElementById(id); el.textContent=v; el.style.fontSize='42px'; }
function setCardTime(id,s) { const el=document.getElementById(id); if(s!=null){el.textContent=secsToTimeStr(s);el.style.fontSize='22px';}else{el.textContent='--';el.style.fontSize='42px';} }

const COLS=[{key:'SupervisorNombre',type:'str'},{key:'RepNombre',type:'str'},{key:'CentroNombre',type:'str'},{key:'PrimeraEntrada',type:'date'},{key:'PrimerPedidoHora',type:'date'},{key:'UltimoPedidoHora',type:'date'},{key:'HrEntrePed',type:'num'},{key:'UltimaSalida',type:'date'},{key:'PromDurSeg',type:'num'},{key:'HoraMenorProd',type:'num'},{key:'HoraMayorProd',type:'num'}];

function cmpVal(av,bv,type,dir){if(av==null&&bv==null)return 0;if(av==null)return dir==='desc'?-1:1;if(bv==null)return dir==='desc'?1:-1;if(type==='date'){av=new Date(av).getTime();bv=new Date(bv).getTime();}else if(type==='num'){av=parseFloat(av);bv=parseFloat(bv);}else{av=String(av).toLowerCase();bv=String(bv).toLowerCase();}if(av<bv)return dir==='asc'?-1:1;if(av>bv)return dir==='asc'?1:-1;return 0;}
function sortedReps(list){const col=COLS.find(c=>c.key===sortCol)||COLS[0];return[...list].sort((a,b)=>{const r1=cmpVal(a[sortCol],b[sortCol],col.type,sortDir);if(r1!==0)return r1;if(sortCol!=='SupervisorNombre'){const rs=cmpVal(a.SupervisorNombre,b.SupervisorNombre,'str','asc');if(rs!==0)return rs;}return cmpVal(a.RepCodigo,b.RepCodigo,'str','asc');});}
function setSort(key){if(sortCol===key){sortDir=sortDir==='asc'?'desc':'asc';}else{sortCol=key;sortDir=(COLS.find(c=>c.key===key)||{}).type==='str'?'asc':'desc';}buildTable();}

function filteredReps(){const name=document.getElementById('f-name').value.toLowerCase().trim(),HALF=30*60;return reps.filter(r=>{if(name&&!(r.RepNombre||'').toLowerCase().includes(name))return false;if(selectedSups.size>0&&!selectedSups.has(r.RepSupervisor))return false;if(selectedCentros.size>0&&!selectedCentros.has(r.CedCodigo))return false;if(filterLate){if(!r.PrimeraEntrada)return false;const d=new Date(r.PrimeraEntrada);if(d.getHours()*60+d.getMinutes()<8*60+20)return false;}if(filterInact&&secsSinVisita(r)<=HALF)return false;return true;});}
