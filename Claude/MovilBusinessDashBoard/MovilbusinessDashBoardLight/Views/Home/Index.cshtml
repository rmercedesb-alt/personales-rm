    <td>${prom?`<span class="badge ${cProm}">${prom}</span>`:''}</td>
    <td>${hmStr?`<span class="badge vdr">${hmStr}</span>`:''}</td>
    <td>${hMayStr?`<span class="badge vg">${hMayStr}</span>`:''}</td>
