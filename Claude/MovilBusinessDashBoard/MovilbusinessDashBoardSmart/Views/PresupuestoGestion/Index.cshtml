// Canales/Suplidor/Categoría/Supervisor para los filtros de "1. Generar", "5. Editar"
// y "6. Eliminar" — reusa /apipresupuestos/filtros (misma sesión, cacheado 1h en el
// servidor), no hace falta duplicar el catálogo. Default de Canales: todos marcados
// MENOS Institucional (7000), mismo criterio ya usado en Presupuestos/Historicos.
function renderCheckList(hostId, items, valorFn, textoFn, defaultCheckedFn) {
  const host = document.getElementById(hostId);
  if (!host) return;
  if (!items || !items.length) { host.innerHTML = '<span class="hint" style="padding:0">(Sin catálogo disponible.)</span>'; return; }
  host.innerHTML = items.map(it => `<label><input type="checkbox" value="${valorFn(it)}" ${defaultCheckedFn(it) ? 'checked' : ''}> ${textoFn(it)}</label>`).join('');
}
fetch(BASE+'/apipresupuestos/filtros').then(r=>r.json()).then(j=>{
  if (!j.ok) throw new Error('respuesta no ok');
  catalogoSuplidores = j.suplidores || [];
  catalogoCategorias = j.categorias || [];
  renderCheckList('canalesCheck', j.canales, c=>c.v, c=>c.t, c=>c.v!=='7000');
  renderCheckList('edCanalesCheck', j.canales, c=>c.v, c=>c.t, ()=>false);
  renderCheckList('elCanalesCheck', j.canales, c=>c.v, c=>c.t, ()=>false);
  renderCheckList('edSuplidoresCheck', j.suplidores, s=>s.v, s=>s.t, ()=>false);
  renderCheckList('elSuplidoresCheck', j.suplidores, s=>s.v, s=>s.t, ()=>false);
  renderCheckList('edCategoriasCheck', j.categorias, c=>c.v, c=>c.t, ()=>false);
  renderCheckList('elCategoriasCheck', j.categorias, c=>c.v, c=>c.t, ()=>false);
  // Supervisores: derivados de 'representantes' (dedup por SupervisorCod) — no hay
  // catálogo aparte, la lista de reps ya trae SupervisorCod/SupervisorNombre.
  const supervisoresMap = new Map();
  for (const r of (j.representantes || [])) {
    if (r.supervisorCod ?? r.SupervisorCod) {
      const cod = r.supervisorCod ?? r.SupervisorCod, nom = r.supervisorNombre ?? r.SupervisorNombre;
      if (cod && !supervisoresMap.has(cod)) supervisoresMap.set(cod, nom || cod);
    }
  }
  const supervisores = Array.from(supervisoresMap.entries()).map(([v,t]) => ({ v, t })).sort((a,b)=>a.t.localeCompare(b.t));
  renderCheckList('edSupervisoresCheck', supervisores, s=>s.v, s=>s.t, ()=>false);
  renderCheckList('elSupervisoresCheck', supervisores, s=>s.v, s=>s.t, ()=>false);
}).catch(()=>{
  for (const id of ['canalesCheck','edCanalesCheck','elCanalesCheck','edSuplidoresCheck','elSuplidoresCheck','edCategoriasCheck','elCategoriasCheck','edSupervisoresCheck','elSupervisoresCheck']) {
    const h = document.getElementById(id); if (h) h.innerHTML = '<span class="hint" style="padding:0">(No se pudo cargar el catálogo.)</span>';
  }
});

// Objetivo POR MES (2026-09-06, pedido explícito del usuario: "Objetivo por Mes
// y General... es como una combinación entre" fijar cada mes a mano Y repartir
// un Total entre el resto) — un input numérico por cada mes del rango Destino
// elegido; el que se llene fija ESE mes exacto, el resto lo reparte el
// Objetivo TOTAL de arriba (NOMBRES_MES_ES se declara más abajo en este mismo
// script — ya está disponible quando esta función corre por un evento).
function mesesDestinoElegidos() {
  const [da, dm] = document.getElementById('destinoDesde').value.split('-').map(Number);
  const [ha, hm] = document.getElementById('destinoHasta').value.split('-').map(Number);
  const meses = [];
  if (da && dm && ha && hm) {
    let a = da, m = dm, guard = 0;
    while ((a < ha || (a === ha && m <= hm)) && guard < 240) {
      meses.push({ anio: a, mes: m });
      m++; if (m > 12) { m = 1; a++; }
      guard++;
    }
  }
  return meses;
}
const MESES_ABREV_OBJ = ['','Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
function renderObjetivosPorMes() {
  const host = document.getElementById('objetivosPorMesHost');
  const meses = mesesDestinoElegidos();
  if (!meses.length) { host.innerHTML = '<span class="hint" style="padding:0">Elige un rango de Destino arriba para ver un campo por mes.</span>'; return; }
  host.innerHTML = meses.map(d => `
    <div class="pd" style="min-width:150px">
      <label>${MESES_ABREV_OBJ[d.mes]}-${d.anio}</label>
      <input type="number" class="objetivo-mes-input" data-anio="${d.anio}" data-mes="${d.mes}" placeholder="(reparte el Total)">
    </div>`).join('');
}
document.getElementById('destinoDesde').addEventListener('change', renderObjetivosPorMes);
document.getElementById('destinoHasta').addEventListener('change', renderObjetivosPorMes);
renderObjetivosPorMes();

document.getElementById('btnGenerar').addEventListener('click', async () => {
  const msg = document.getElementById('msgGenerar');
  msg.textContent = 'Generando...'; msg.className='msg';
  // TODO el handler en un solo try/catch (antes solo cubría el fetch) — si algo
  // revienta silenciosamente ANTES de llamar al servidor (parseo de fechas,
  // un elemento que no se encuentra, etc.) ahora se ve en pantalla en vez de
  // quedarse pegado en "Generando..." para siempre sin pista alguna.
  try {
    console.log('[Generar] click recibido, armando request...');
    const [da, dm] = document.getElementById('destinoDesde').value.split('-').map(Number);
    const [ha, hm] = document.getElementById('destinoHasta').value.split('-').map(Number);
    const destino = [];
    if (da && dm && ha && hm) {
      let a = da, m = dm;
      let guard = 0;
      while ((a < ha || (a === ha && m <= hm)) && guard < 240) {
        destino.push({ anio: a, mes: m });
        m++; if (m > 12) { m = 1; a++; }
        guard++;
      }
    }
    const reps = document.getElementById('reps').value.split(',').map(s=>s.trim()).filter(Boolean);
    const compVal = document.getElementById('compararAnioMes').value; // "2026-08" o vacío
    const [compAnio, compMes] = compVal ? compVal.split('-').map(Number) : [null, null];
    const objetivoRaw = document.getElementById('objetivoMonto').value;
    const objetivoModo = document.getElementById('objetivoModo').value; // 'valor' | 'unidades'
    const objetivoNum = objetivoRaw ? parseFloat(objetivoRaw) : null;
    const canalesMarcados = Array.from(document.querySelectorAll('#canalesCheck input:checked')).map(c => parseInt(c.value));
    const objetivosPorMes = Array.from(document.querySelectorAll('.objetivo-mes-input'))
      .filter(el => el.value !== '')
      .map(el => ({ anio: parseInt(el.dataset.anio), mes: parseInt(el.dataset.mes), valor: parseFloat(el.value), modo: objetivoModo }));
    const body = {
      baseFechaInicio: document.getElementById('baseIni').value,
      baseFechaFin: document.getElementById('baseFin').value,
      destino, preTipo: 'Unddprod',
      reps: reps.length ? reps : null,
      descripcion: document.getElementById('descripcion').value || null,
      compAnio, compMes,
      montoValorSugerido: (objetivoNum && objetivoModo==='valor') ? objetivoNum : null,
      montoTotalSugerido: (objetivoNum && objetivoModo==='unidades') ? objetivoNum : null,
      objetivosPorMes: objetivosPorMes.length ? objetivosPorMes : null,
      canales: canalesMarcados.length ? canalesMarcados : null,
    };
    console.log('[Generar] body armado:', body, 'URL:', BASE+'/apipresupuestogestion/generar');
    const r = await fetch(BASE+'/apipresupuestogestion/generar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
    console.log('[Generar] respuesta recibida, status:', r.status);
    const j = await r.json();
    if (!j.ok) { msg.textContent = j.error || 'Error'; msg.className='msg err'; return; }
    msg.textContent = `Lote generado: ${j.filasInsertadas} filas, ${j.anomalias} anomalías.`; msg.className='msg ok';
    await cargarLote(CTX_GEN, j.loteId);
  } catch(e) { console.error('[Generar] excepcion:', e); msg.textContent = 'Error: '+e; msg.className='msg err'; }
});

