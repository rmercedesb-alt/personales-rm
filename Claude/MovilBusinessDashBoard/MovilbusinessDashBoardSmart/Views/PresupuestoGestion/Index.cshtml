// Nombre de Suplidor/Categoría junto al código (2026-09-06, pedido explícito del usuario para
// "Metas Rapel" y demás variables por Ámbito) — el código crudo se conserva en el atributo
// data-raw de la celda (ver guardarValorFila) para no romper el guardado.
function textoAmbitoValor(ambitoTipo, ambitoValor) {
  if (!ambitoValor) return '—';
  if (ambitoTipo === 'Suplidor') {
    const s = catalogoSuplidores.find(x => x.v === ambitoValor);
    return s ? `${ambitoValor} - ${s.t}` : ambitoValor;
  }
  if (ambitoTipo === 'Categoria') {
    const c = catalogoCategorias.find(x => x.v === ambitoValor);
    return c ? `${ambitoValor} - ${c.t}` : ambitoValor;
  }
  if (ambitoTipo === 'RutaSuplidor' && ambitoValor.includes('|')) {
    const [rep, cat3] = ambitoValor.split('|');
    const s = catalogoSuplidores.find(x => x.v === cat3);
    return s ? `${ambitoValor} (${rep} → ${s.t})` : ambitoValor;
  }
  return ambitoValor;
}

