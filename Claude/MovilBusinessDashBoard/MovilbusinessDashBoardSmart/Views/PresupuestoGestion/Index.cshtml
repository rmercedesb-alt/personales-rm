    const v = document.getElementById('compAnioMes').value;
    if (v) { const [a, m] = v.split('-'); params.set('compAnio', a); params.set('compMes', parseInt(m)); }
  }
  const { anio: fAnio, mes: fMes } = obtenerFiltroMesActual();
  if (fAnio) { params.set('filtroAnio', fAnio); params.set('filtroMes', fMes); }
  const qs = params.toString();
  window.location.href = BASE+'/apipresupuestogestion/lote/'+CTX_GEN.lote+'/revision.xlsx'+(qs?'?'+qs:'');
});

async function cargarComparativo(){
  const msg = document.getElementById('msgComparativo');
  msg.textContent = 'Cargando...'; msg.className = 'msg';
  const params = new URLSearchParams();
  compEtiquetaMes = 'Mismo período (ya publicado)';
  if (document.getElementById('compModoMes').checked) {
    const v = document.getElementById('compAnioMes').value; // "2025-09"
    if (!v) { msg.textContent = 'Elige un Año-Mes para comparar.'; msg.className = 'msg err'; return; }
    const [a, m] = v.split('-');
    params.set('compAnio', a); params.set('compMes', parseInt(m));
    compEtiquetaMes = `Presupuesto ${v}`;
  }
  const { anio: fAnio, mes: fMes } = obtenerFiltroMesActual();
  if (fAnio) { params.set('filtroAnio', fAnio); params.set('filtroMes', fMes); }
  const url = BASE+'/apipresupuestogestion/lote/'+CTX_GEN.lote+'/comparativo?'+params.toString();
  const r = await fetch(url);
  const j = await r.json();
  if (!j.ok) { msg.textContent = j.error || 'Error'; msg.className = 'msg err'; return; }
  msg.textContent = '';
  compFilas = j.filas;
  compEsPromedioMensual = j.esPromedioMensual;
  CADENA_NAV.centro = []; CADENA_NAV.canal = []; CADENA_NAV.suplidor = [];
  renderTodasLasCadenas();
}

function sumaGrupo(filas){
  const campos = ['UnidadesPropuesto','UnidadesComparacion','UnidadesVentaPromedio','CajasPropuesto','CajasComparacion','CajasVentaPromedio','MontoPropuesto','MontoComparacion','MontoVentaPromedio'];
  const init = {}; campos.forEach(c => init[c] = 0);
  return filas.reduce((s,f) => { const r = {...s}; campos.forEach(c => r[c] = s[c] + f[c]); return r; }, init);
}

function pctCrecimiento(nuevo, base){
  if (base === 0) return nuevo > 0 ? { txt: 'Nuevo', cls: 'good' } : { txt: '—', cls: 'na' };
  const pct = (nuevo - base) / base * 100;
  return { txt: (pct>=0?'+':'')+pct.toFixed(1)+'%', cls: pct >= 0 ? 'good' : 'bad' };
}

function registrarAmbito(a){ const id = 'a'+(ambitoSeq++); AMBITO_REGISTRY[id] = a; return id; }

window.cadenaAjustar = async function(ambitoId, etiqueta){
  if (!CTX_GEN.lote) return;
  const ambito = AMBITO_REGISTRY[ambitoId] || {};
  const txt = prompt(`Ajustar "${etiqueta}"\n\nEscribe el VALOR al que debe llegar el total propuesto de este nodo (ej. 850000), o un % (ej. 110% = crecer a 110% de lo que tiene hoy). Se reparte proporcional entre todas sus filas.`);
  if (!txt) return;
  const t = txt.trim();
  const modo = t.endsWith('%') ? 'pct' : 'valor';
  const monto = parseFloat(t.replace('%','').replace(/,/g,''));
  if (isNaN(monto)) { alert('Número inválido.'); return; }
  const { anio, mes } = obtenerFiltroMesActual();
  const r = await fetch(BASE+'/apipresupuestogestion/lote/'+CTX_GEN.lote+'/ajustar-nodo', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ ambito, modo, monto, anio, mes }) });
  const j = await r.json();
  if (!j.ok) { alert(j.error||'Error'); return; }
  alert(`Ajustado${anio?` (solo ${mes}/${anio})`:''}: ${j.filasActualizadas} fila(s), escala=${j.escala.toFixed(4)}${j.anomalias?`, ${j.anomalias} anomalía(s)`:''}.`);
  await cargarComparativo();
  await cargarLote(CTX_GEN, CTX_GEN.lote); // "2. Revisar" también cambió (PrePresupuestoPropuesto)
};

window.cadenaDrill = function(cadenaKey, nivelIdx, valor, nombre){
  CADENA_NAV[cadenaKey] = CADENA_NAV[cadenaKey].slice(0, nivelIdx).concat([{ valor, nombre }]);
  renderNivelCadena(cadenaKey);
};

window.cadenaVolver = function(cadenaKey, hastaIdx){
  CADENA_NAV[cadenaKey] = CADENA_NAV[cadenaKey].slice(0, hastaIdx);
  renderNivelCadena(cadenaKey);
};

// Columnas de ajuste por fila (pedido explícito del usuario 2026-09-01):
// %  y  Monto (RD$), precargadas con 100% / el monto sugerido actual — si no
// se tocan, "Recalcular" no cambiaría nada. Al escribir un nuevo valor y
// presionar Recalcular, se convierte a UNIDADES con el precio promedio
// PONDERADO de ESE nodo específico (montoActual÷unidadesActual — el mismo
// precio de Lista que ya arma "Sugerido", nunca un precio inventado) y se
// llama a /ajustar-nodo con ese ámbito EXACTO (solo esta fila, ninguna otra)
// — por eso el ajuste SIEMPRE suma hacia arriba: las demás filas/nodos no se
// tocan, así que el total de la compañía sube o baja exactamente el delta
// (ej. Canal Minorista 50MM→60MM: el resto de canales queda igual, compañía
// pasa de 100MM a 110MM), nunca se re-escala todo para "mantener" el total.
function filaNivelHtml(cadenaKey, nivelIdx, nombre, s, clickable, valorClave, ambitoBase, nivel){
  const m = METRICAS[compMetrica];
  const sugerido = s[m.sugerido], comparar = s[m.comparar], promedio = s[m.promedio];
  const cMes = pctCrecimiento(sugerido, comparar);
  const cProm = pctCrecimiento(sugerido, promedio);
  const onclick = clickable ? `onclick="cadenaDrill('${cadenaKey}',${nivelIdx},'${String(valorClave).replace(/'/g,"\\'")}','${nombre.replace(/'/g,"\\'")}')" style="cursor:pointer"` : '';
  const ambitoFila = { ...ambitoBase, ...nivel.ambito(valorClave) };
  const ambitoId = registrarAmbito(ambitoFila);
  const montoBase = s.MontoPropuesto, unidBase = s.UnidadesPropuesto;
  const sinPrecio = !(montoBase > 0 && unidBase > 0);
  return `<tr class="${clickable?'clickable':''}">
    <td ${onclick}>${nombre}${clickable?' →':''}</td>
    <td>${fmt(comparar)}</td><td>${fmt(promedio)}</td><td>${fmt(sugerido)}</td>
    <td><span class="pct2 ${cMes.cls}">${cMes.txt}</span></td>
    <td><span class="pct2 ${cProm.cls}">${cProm.txt}</span></td>
    <td>${sinPrecio ? '—' : `<input type="number" step="0.01" value="100" data-amb="${ambitoId}" data-tipo="pct" style="width:65px" onchange="sincronizarAjusteFila(this)">`}</td>
    <td>${sinPrecio ? '—' : `<input type="number" step="0.01" value="${montoBase.toFixed(2)}" data-amb="${ambitoId}" data-tipo="monto" data-base="${montoBase}" data-unidbase="${unidBase}" style="width:100px" onchange="sincronizarAjusteFila(this)">`}</td>
    <td>${sinPrecio ? '' : `<button class="btn-sm" onclick="recalcularFila('${ambitoId}')">Recalcular</button>`}</td>
  </tr>`;
}

window.sincronizarAjusteFila = function(input){
  const tr = input.closest('tr');
  const pctInput = tr.querySelector('[data-tipo=pct]');
  const montoInput = tr.querySelector('[data-tipo=monto]');
  const base = parseFloat(montoInput.dataset.base);
  if (!base) return;
  if (input.dataset.tipo === 'pct') {
    const pct = parseFloat(pctInput.value);
    if (!isNaN(pct)) montoInput.value = (base * pct / 100).toFixed(2);
  } else {
    const monto = parseFloat(montoInput.value);
    if (!isNaN(monto)) pctInput.value = (monto / base * 100).toFixed(2);
  }
};

window.recalcularFila = async function(ambitoId){
  if (!CTX_GEN.lote) return;
  const montoInput = document.querySelector(`[data-amb="${ambitoId}"][data-tipo="monto"]`);
  if (!montoInput) return;
  const montoNuevo = parseFloat(montoInput.value);
  const montoBase = parseFloat(montoInput.dataset.base);
  const unidBase = parseFloat(montoInput.dataset.unidbase);
  if (isNaN(montoNuevo) || !montoBase || !unidBase) { alert('No se puede recalcular esta fila (falta precio de referencia).'); return; }
  const precioPonderado = montoBase / unidBase; // precio promedio ponderado de ESTE nodo, no un precio inventado
  const unidadesObjetivo = montoNuevo / precioPonderado; // el sistema SIEMPRE guarda en unidades
  const ambito = AMBITO_REGISTRY[ambitoId] || {};
  const { anio, mes } = obtenerFiltroMesActual();
  const r = await fetch(BASE+'/apipresupuestogestion/lote/'+CTX_GEN.lote+'/ajustar-nodo', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ ambito, modo: 'valor', monto: unidadesObjetivo, anio, mes }) });
  const j = await r.json();
  if (!j.ok) { alert(j.error||'Error'); return; }
  alert(`Recalculado${anio?` (solo ${mes}/${anio})`:''}: ${j.filasActualizadas} fila(s) de este nodo. RD$${fmt(montoBase)} → RD$${fmt(montoNuevo)} (${fmt(unidadesObjetivo)} unidades al precio promedio ponderado RD$${precioPonderado.toFixed(2)}/u). El resto de la propuesta no se tocó.`);
  await cargarComparativo();
  await cargarLote(CTX_GEN, CTX_GEN.lote);
};

async function renderNivelCadena(cadenaKey){
  const { niveles } = CADENAS[cadenaKey];
  const nav = CADENA_NAV[cadenaKey];
  const host = document.getElementById('cadena'+cadenaKey.charAt(0).toUpperCase()+cadenaKey.slice(1));
  if (vistaModo === 'activaciones') host.innerHTML = '<div class="hint">Cargando activaciones…</div>';
  let htmlTotal = '';

  for (let i = 0; i < niveles.length; i++) {
    const nivel = niveles[i];
    const filasFiltradas = compFilas.filter(f => nav.slice(0, i).every((sel, j) => String(niveles[j].dim(f)) === String(sel.valor)));
    const grupos = new Map();
    for (const f of filasFiltradas) {
      const k = String(nivel.dim(f));
      if (!grupos.has(k)) grupos.set(k, { nombre: nivel.nombre(f), filas: [] });
      grupos.get(k).filas.push(f);
    }
    const esUltimo = i === niveles.length - 1;
    const m = METRICAS[compMetrica];
    const filasOrdenadas = [...grupos.entries()].sort((a,b) => sumaGrupo(b[1].filas)[m.sugerido] - sumaGrupo(a[1].filas)[m.sugerido]);

    let ambitoBase = {};
    nav.slice(0, i).forEach((sel, j) => Object.assign(ambitoBase, niveles[j].ambito(sel.valor)));
    const ambitoId = registrarAmbito(ambitoBase);
    const titulo = i > 0 ? `${nivel.label} de ${nav[i-1].nombre}` : `Por ${nivel.label}`;
    const volverBtn = i > 0 ? `<span class="crumb2 chico" onclick="cadenaVolver('${cadenaKey}',${i-1})">‹ Ver todos</span>` : '';

    let filasHtml, cabecera, ajustarBtn;
    if (vistaModo === 'activaciones') {
      ajustarBtn = ''; // "Sugerir para todo" es de Ventas; en Activaciones cada fila tiene su propio Recalcular
      const entradas = filasOrdenadas.map(([k, g]) => ({ k, g, ambitoId: registrarAmbito({ ...ambitoBase, ...nivel.ambito(k) }) }));
      const datos = await Promise.all(entradas.map(e => fetch(BASE+'/apipresupuestogestion/lote/'+CTX_GEN.lote+'/detalle-activacion', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ambito: AMBITO_REGISTRY[e.ambitoId] })
      }).then(r => r.json()).catch(() => ({ ok: false }))));
      filasHtml = entradas.map((e, idx) => filaActivacionHtml(cadenaKey, i, e.g.nombre, datos[idx], !esUltimo, e.k, e.ambitoId)).join('');
      cabecera = `<th></th><th>Clientes Asignados</th><th>Clientes Efectivos</th><th>% Activación</th><th>Ajuste %</th><th>Ajuste Absoluto</th><th></th>`;
    } else {
      ajustarBtn = `<button class="btn-out" style="height:24px;padding:2px 9px;font-size:11px" onclick="cadenaAjustar('${ambitoId}','${titulo.replace(/'/g,"\\'")}')">🎯 Sugerir para todo</button>`;
      filasHtml = filasOrdenadas.map(([k, g]) => filaNivelHtml(cadenaKey, i, g.nombre, sumaGrupo(g.filas), !esUltimo, k, ambitoBase, nivel)).join('');
      cabecera = `<th></th><th>${compEtiquetaMes}</th><th>Ventas Promedio (mensual)</th><th>Presupuesto Sugerido</th><th>Var. % vs Mes</th><th>Var. % vs Promedio</th><th>Ajuste %</th><th>Ajuste Monto (RD$)</th><th></th>`;
    }

    htmlTotal += `<div class="cadena-nivel">
      <div class="cadena-titulo"><span>${titulo}</span>${volverBtn}${ajustarBtn}</div>
      <div style="overflow:auto;max-height:340px"><table class="res"><thead><tr>${cabecera}</tr></thead><tbody>${filasHtml}</tbody></table></div></div>`;

    if (nav[i] == null) break; // no se ha drillado más allá de este nivel -> no mostrar los siguientes
  }
  host.innerHTML = htmlTotal;
}

// ── Vista de Activaciones (Fase C, 2026-09-01) ──────────────────────────────
// Clientes Asignados/Efectivos vienen de /detalle-activacion (no están en
// 'compFilas' — a diferencia de Ventas, hay que pedirlos al servidor por cada
// fila visible). Ajuste %/Absoluto precargados con 100%/clientes efectivos
// actuales, sincronizados entre sí igual que en la vista de Ventas.
function filaActivacionHtml(cadenaKey, nivelIdx, nombre, datos, clickable, valorClave, ambitoId){
  const onclick = clickable ? `onclick="cadenaDrill('${cadenaKey}',${nivelIdx},'${String(valorClave).replace(/'/g,"\\'")}','${nombre.replace(/'/g,"\\'")}')" style="cursor:pointer"` : '';
  if (!datos || !datos.ok) {
    return `<tr><td ${onclick}>${nombre}${clickable?' →':''}</td><td colspan="5">— (no se pudo cargar)</td></tr>`;
  }
  const asignados = datos.clientesAsignados, efectivos = datos.clientesEfectivos, pct = (datos.pctActivacion*100);
  const sinBase = !(efectivos > 0);
  return `<tr class="${clickable?'clickable':''}">
    <td ${onclick}>${nombre}${clickable?' →':''}</td>
    <td>${fmt(asignados)}</td>
    <td>${fmt(efectivos)}</td>
    <td>${pct.toFixed(1)}%</td>
    <td>${sinBase ? '—' : `<input type="number" step="0.01" value="100" data-ambact="${ambitoId}" data-tipoact="pct" style="width:65px" onchange="sincronizarAjusteActivacion(this)">`}</td>
    <td>${sinBase ? '—' : `<input type="number" step="1" value="${efectivos}" data-ambact="${ambitoId}" data-tipoact="abs" data-baseact="${efectivos}" style="width:80px" onchange="sincronizarAjusteActivacion(this)">`}</td>
    <td>${sinBase ? '' : `<button class="btn-sm" onclick="recalcularActivacionFila('${ambitoId}')">Recalcular</button>`}</td>
  </tr>`;
}

window.sincronizarAjusteActivacion = function(input){
  const tr = input.closest('tr');
  const pctInput = tr.querySelector('[data-tipoact=pct]');
  const absInput = tr.querySelector('[data-tipoact=abs]');
  const base = parseFloat(absInput.dataset.baseact);
  if (!base) return;
  if (input.dataset.tipoact === 'pct') {
    const pct = parseFloat(pctInput.value);
    if (!isNaN(pct)) absInput.value = Math.round(base * pct / 100);
  } else {
    const abs = parseFloat(absInput.value);
    if (!isNaN(abs)) pctInput.value = (abs / base * 100).toFixed(2);
  }
};

window.recalcularActivacionFila = async function(ambitoId){
  if (!CTX_GEN.lote) return;
  const absInput = document.querySelector(`[data-ambact="${ambitoId}"][data-tipoact="abs"]`);
  if (!absInput) return;
  const valor = parseFloat(absInput.value);
  if (isNaN(valor)) { alert('Valor inválido.'); return; }
  const ambito = AMBITO_REGISTRY[ambitoId] || {};
  const { anio, mes } = obtenerFiltroMesActual();
  const r = await fetch(BASE+'/apipresupuestogestion/lote/'+CTX_GEN.lote+'/recalcular-activacion', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ ambito, modo:'valor', valor, anio, mes }) });
  const j = await r.json();
  if (!j.ok) { alert(j.error||'Error'); return; }
  if (j.sinCambios) { alert(j.mensaje); return; }
  const detalleTxt = (j.detalle||[]).map(d => d.aplicado
    ? `Suplidor ${d.cat3}/Categoría ${d.cat1}: producto ${d.productoId} +${d.unidadesAgregadas} u. (${d.clientesFaltantesPar} clientes)`
    : `Suplidor ${d.cat3}/Categoría ${d.cat1}: ${d.motivo}`).join('\n');
  alert(`Recalculado${anio?` (solo ${mes}/${anio})`:''}: ${j.clientesActuales} → objetivo ${Math.round(j.clientesObjetivo)} (+${j.clientesFaltantes} clientes, ${j.clientesAplicados} aplicados)\n\n${detalleTxt}`);
  await cargarComparativo();
  await cargarLote(CTX_GEN, CTX_GEN.lote);
};

function renderTodasLasCadenas(){
  if (!compFilas.length) return;
  const m = METRICAS[compMetrica];
  const tot = sumaGrupo(compFilas);
  const cMes = pctCrecimiento(tot[m.sugerido], tot[m.comparar]);
  const cProm = pctCrecimiento(tot[m.sugerido], tot[m.promedio]);
  // "Sugerido" y "Ventas Promedio" SIEMPRE son promedio mensual (se dividen
  // entre nMesesDestino/mesesBase sin importar el modo de comparación). El
  // comparativo en cambio SOLO se promedia cuando es "Mismo período" (suma
  // los N meses destino ya publicados) — si se comparó contra un "Mes
  // específico", ese número YA es el real de UN solo mes, no un promedio.
  const { anio: fAnio, mes: fMes } = obtenerFiltroMesActual();
  const etiquetaSug = fAnio ? `Sugerido (${NOMBRES_MES_ES[fMes]} ${fAnio})` : 'Sugerido (promedio mensual)';
  const etiquetaComp = compEtiquetaMes + (fAnio ? ` (${NOMBRES_MES_ES[fMes]} ${fAnio})` : (document.getElementById('compModoMes').checked ? ' (mes real)' : ' (promedio mensual)'));
  const ambitoId = registrarAmbito({});
  document.getElementById('tarjetaGeneral').innerHTML = `
    <div class="tarjeta"><div class="lbl">${etiquetaComp}</div><div class="val">${fmt(tot[m.comparar])}</div><div class="sub3">${m.lbl}</div></div>
    <div class="tarjeta"><div class="lbl">Ventas Promedio (base, promedio mensual)</div><div class="val">${fmt(tot[m.promedio])}</div><div class="sub3">${m.lbl}</div></div>
    <div class="tarjeta"><div class="lbl">${etiquetaSug}</div><div class="val">${fmt(tot[m.sugerido])}</div>
      <div class="sub3">vs mes: <span class="pct2 ${cMes.cls}">${cMes.txt}</span> · vs promedio: <span class="pct2 ${cProm.cls}">${cProm.txt}</span>
      <button class="btn-out" style="height:22px;padding:1px 8px;font-size:10.5px;margin-left:8px" onclick="cadenaAjustar('${ambitoId}','toda la Compañía')">🎯 Sugerir para toda la compañía</button></div></div>`;
  renderNivelCadena('centro'); renderNivelCadena('canal'); renderNivelCadena('suplidor');
}

// ══════════════════ 4. Rebalancear presupuesto real por Categoría ══════════
// Pedido explícito del usuario 2026-08-31: reparte el MNTDPROD/UNDDPROD YA
// PUBLICADO de un Año-Mes entre los productos que cada vendedor REALMENTE
// vende, dentro de cada Categoría — preserva el total, excluye combos.
// Escribe DIRECTO a producción (excepción deliberada, ver backend) — por eso
// exige escribir "CONFIRMAR" antes de habilitar el botón de aplicar.
let rebalGrupos = [];

document.getElementById('btnRebalPreview').addEventListener('click', async () => {
  const msg = document.getElementById('msgRebalanceo');
  msg.textContent = 'Calculando...'; msg.className = 'msg';
  document.getElementById('panelConfirmarRebal').style.display = 'none';
  document.getElementById('rebalConfirmTexto').value = '';
  document.getElementById('btnRebalAplicar').disabled = true;
  const v = document.getElementById('rebalAnioMes').value;
  if (!v) { msg.textContent = 'Elige un Año-Mes.'; msg.className = 'msg err'; return; }
  const [anio, mes] = v.split('-').map(Number);
  const reps = document.getElementById('rebalReps').value.split(',').map(s=>s.trim()).filter(Boolean);
  const r = await fetch(BASE+'/apipresupuestogestion/historicos/rebalancear-categoria/preview', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ anio, mes, canales: null, reps: reps.length ? reps : null }) });
  const j = await r.json();
  if (!j.ok) { msg.textContent = j.error||'Error'; msg.className = 'msg err'; return; }
  msg.textContent = '';
  rebalGrupos = j.grupos;
  document.getElementById('resumenRebalanceo').innerHTML =
    `<span>Grupos Rep×Categoría: <b>${j.totalGrupos}</b></span>`+
    `<span>Con reparto propuesto: <b>${j.totalGrupos - j.anomalias}</b></span>`+
    `<span>Anomalías (sin venta real, no se tocan): <b>${j.anomalias}</b></span>`;
  pintarTablaRebalanceo();
  document.getElementById('panelConfirmarRebal').style.display = (j.totalGrupos - j.anomalias) > 0 ? 'flex' : 'none';
});

function pintarTablaRebalanceo(){
  const tbody = document.getElementById('tbodyRebalanceo');
  tbody.innerHTML = rebalGrupos.map((g, idx) => {
    const nCambios = g.Cambios.filter(c => !c.EsCombo && Math.abs(c.MontoDespues - c.MontoAntes) > 0.5).length;
    return `<tr class="clickable" onclick="toggleRebalDetalle(${idx})">
      <td>${g.RepCodigo} — ${g.RepNombre}</td>
      <td>${g.Cat1Nombre}</td>
      <td>${fmt(g.MontoTotal)}</td>
      <td>${g.Anomalia ? '<span class="badge warn">Sin venta real — revisar</span>' : `${nCambios} producto(s) cambian`}</td>
      <td>ver detalle</td>
    </tr>
    <tr id="rebalDetalle${idx}" style="display:none"><td colspan="5">${detalleRebalHtml(g)}</td></tr>`;
  }).join('');
}

function detalleRebalHtml(g){
  if (g.Anomalia) return '<span class="hint" style="padding:6px 0">Ningún producto de esta categoría tuvo venta real en mayo-julio 2026 — no se toca, revisar a mano.</span>';
  return `<table class="cfg"><thead><tr><th>Producto</th><th>Combo</th><th>Monto antes</th><th>Monto después</th><th>Unidades antes</th><th>Unidades después</th></tr></thead><tbody>`+
    g.Cambios.map(c => `<tr><td>${c.ProId} — ${c.ProDescripcion}</td><td>${c.EsCombo?'Sí':''}</td><td>${fmt(c.MontoAntes)}</td><td>${fmt(c.MontoDespues)}</td><td>${fmt(c.UnidadesAntes)}</td><td>${fmt(c.UnidadesDespues)}</td></tr>`).join('')+
    `</tbody></table>`;
}

window.toggleRebalDetalle = function(idx){
  const el = document.getElementById('rebalDetalle'+idx);
  el.style.display = el.style.display === 'none' ? 'table-row' : 'none';
};

document.getElementById('rebalConfirmTexto').addEventListener('input', (e) => {
  document.getElementById('btnRebalAplicar').disabled = e.target.value.trim() !== 'CONFIRMAR';
});

document.getElementById('btnRebalAplicar').addEventListener('click', async () => {
  const msg = document.getElementById('msgRebalanceo');
  const v = document.getElementById('rebalAnioMes').value;
  const [anio, mes] = v.split('-').map(Number);
  const reps = document.getElementById('rebalReps').value.split(',').map(s=>s.trim()).filter(Boolean);
  const confirmacion = document.getElementById('rebalConfirmTexto').value.trim();
  if (!confirm(`¿Aplicar el rebalanceo a PRODUCCIÓN para ${v}? Esto modifica presupuesto real ya publicado (UNDDPROD y MNTDPROD).`)) return;
  msg.textContent = 'Aplicando...'; msg.className = 'msg';
  const r = await fetch(BASE+'/apipresupuestogestion/historicos/rebalancear-categoria/aplicar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ anio, mes, canales: null, confirmacion, reps: reps.length ? reps : null }) });
  const j = await r.json();
  if (!j.ok) { msg.textContent = j.error||'Error'; msg.className = 'msg err'; return; }
  msg.textContent = `Aplicado: ${j.gruposActualizados} grupo(s) ajustado(s), ${j.filasActualizadas} filas actualizadas, ${j.anomalias} anomalía(s) sin tocar.`; msg.className = 'msg ok';
  document.getElementById('rebalConfirmTexto').value = '';
  document.getElementById('btnRebalAplicar').disabled = true;
});
</script>
</body>
</html>
