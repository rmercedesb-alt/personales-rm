// ══════════════════ ⚙ Import/Export masivo (Excel) — genérico ══════════════
// Pedido explícito del usuario 2026-09-01: "¿cómo puedo configurar de manera
// masiva, subir un archivo o algo así?" — reusa el MISMO patrón ya usado para
// exportar/reimportar el staging de un lote (btnExportar/inputImportar más
// arriba): SheetJS 100% client-side, SIN endpoint nuevo — cada fila del
// Excel se manda al mismo endpoint 'guardar' que ya usa el alta manual de 1
// fila (upsert, así que reimportar el mismo archivo 2 veces no duplica).
function descargarPlantilla(headers, filename){
  const ws = XLSX.utils.aoa_to_sheet([headers]);
  const wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, ws, 'Plantilla');
  XLSX.writeFile(wb, filename);
}

async function importarConfigExcel(file, endpoint, construirBody, msgElId, onExito){
  const msg = document.getElementById(msgElId);
  if (!file) return;
  try {
    const buf = await file.arrayBuffer();
    const wb = XLSX.read(buf, { type:'array' });
    const ws = wb.Sheets[wb.SheetNames[0]];
    const filas = XLSX.utils.sheet_to_json(ws, { header:1 });
    if (filas.length < 2) { msg.textContent = 'El archivo no tiene filas de datos.'; msg.className='msg err'; return; }
    const headers = filas[0].map(h => String(h||'').trim());
    let ok = 0, fail = 0;
    for (let i = 1; i < filas.length; i++) {
      const fila = filas[i];
      if (!fila || fila.every(c => c === undefined || c === '')) continue; // fila vacía, se ignora
      const valores = {};
      headers.forEach((h, idx) => { valores[h] = fila[idx]; });
      const body = construirBody(valores);
      if (!body) { fail++; continue; }
      try {
        const r = await fetch(BASE+endpoint, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
        const j = await r.json();
        if (j.ok) ok++; else fail++;
      } catch { fail++; }
    }
    msg.textContent = `Importación completa: ${ok} agregadas/actualizadas, ${fail} con error (revisa que esas filas tengan los campos obligatorios).`;
    msg.className = fail > 0 ? 'msg err' : 'msg ok';
    await onExito();
  } catch (e) {
    msg.textContent = 'No se pudo leer el archivo: ' + e.message;
    msg.className = 'msg err';
  }
}

const esVerdadero = (v) => /^(1|true|si|sí|x)$/i.test(String(v||''));

window.importarValoresExcel = function(file){
  if (!varSeleccionada) { alert('Primero abre "Valores" de una variable (arriba) antes de importar.'); return; }
  importarConfigExcel(file, '/apipresupuestogestion/variables/valores/guardar', (v) => {
    const periodoAnio = parseInt(v.PeriodoAnio);
    const valor = parseFloat(v.Valor);
    if (!v.AmbitoTipo || !periodoAnio || isNaN(valor)) return null;
    return {
      id: null, varCodigo: varSeleccionada,
      ambitoTipo: String(v.AmbitoTipo).trim(),
      ambitoValor: v.AmbitoValor !== undefined && v.AmbitoValor !== '' ? String(v.AmbitoValor).trim() : null,
      periodoTipo: v.PeriodoTipo ? String(v.PeriodoTipo).trim() : 'Anio',
      periodoAnio,
      periodoTrimestre: v.PeriodoTrimestre !== undefined && v.PeriodoTrimestre !== '' ? parseInt(v.PeriodoTrimestre) : null,
      periodoMes: v.PeriodoMes !== undefined && v.PeriodoMes !== '' ? parseInt(v.PeriodoMes) : null,
      valor,
    };
  }, 'msgValores', () => window.verValores(varSeleccionada));
};

window.importarActivacionExcel = function(file){
  importarConfigExcel(file, '/apipresupuestogestion/activacion/metas/guardar', (v) => {
    const cat3Id = parseInt(v.Cat3ID), cat1Id = parseInt(v.Cat1ID), metaPct = parseFloat(v.MetaPct);
    if (!cat3Id || !cat1Id || isNaN(metaPct)) return null;
    const canId = v.CanID !== undefined && v.CanID !== '' ? parseInt(v.CanID) : null;
    const repTipe = v.RepTipe !== undefined && v.RepTipe !== '' ? String(v.RepTipe).trim() : null;
    const repCodigo = v.RepCodigo !== undefined && v.RepCodigo !== '' ? String(v.RepCodigo).trim() : null;
    if ((canId?1:0)+(repTipe?1:0)+(repCodigo?1:0) > 1) return null; // Canal/División/Vendedor son overrides alternativos, no combinados
    return {
      id: null, cat3Id, cat1Id, canId, repTipe, repCodigo, metaPct,
      modo: (v.Modo && String(v.Modo).trim()) || 'Ideal',
      bloqueaPublicar: esVerdadero(v.BloqueaPublicar),
      activo: v.Activo === undefined || v.Activo === '' ? true : esVerdadero(v.Activo),
    };
  }, 'msgActivacionMetas', cargarActivacionMetas);
};

window.importarEfectividadExcel = function(file){
  importarConfigExcel(file, '/apipresupuestogestion/efectividad/metas/guardar', (v) => {
    const metaPct = parseFloat(v.MetaPct);
    if (isNaN(metaPct)) return null;
    return {
      id: null,
      repTipe: v.RepTipe !== undefined && v.RepTipe !== '' ? String(v.RepTipe).trim() : '',
      metaPct,
      modo: (v.Modo && String(v.Modo).trim()) || 'Ideal',
      bloqueaPublicar: esVerdadero(v.BloqueaPublicar),
      activo: v.Activo === undefined || v.Activo === '' ? true : esVerdadero(v.Activo),
    };
  }, 'msgEfectividadMetas', cargarEfectividadMetas);
};

window.importarLimitesExcel = function(file){
  importarConfigExcel(file, '/apipresupuestogestion/limitesrep/guardar', (v) => {
    const repCodigo = v.RepCodigo !== undefined ? String(v.RepCodigo).trim() : '';
    const pctMinimo = v.PctMinimo !== undefined && v.PctMinimo !== '' ? parseFloat(v.PctMinimo) : null;
    const pctMaximo = v.PctMaximo !== undefined && v.PctMaximo !== '' ? parseFloat(v.PctMaximo) : null;
    if (!repCodigo || (pctMinimo == null && pctMaximo == null)) return null;
    return {
      repCodigo, pctMinimo, pctMaximo,
      activo: v.Activo === undefined || v.Activo === '' ? true : esVerdadero(v.Activo),
    };
  }, 'msgLimitesRep', cargarLimitesRep);
};

// ══════════════════ ⚙ Metas de activación mínima (Suplidor×Categoría) ══════
async function cargarActivacionMetas(){
  const r = await fetch(BASE+'/apipresupuestogestion/activacion/metas');
  const j = await r.json();
  const tbody = document.getElementById('tbodyActivacionMetas');
  if (!j.ok) { tbody.innerHTML = `<tr><td colspan="10">${j.error||'(No se pudo cargar — falta correr SQL/PresupuestoActivacionMetas_RM.sql)'}</td></tr>`; return; }
  tbody.innerHTML = j.metas.map(m => `
    <tr data-id="${m.Id}">
      <td>${m.Cat3ID} — ${m.Cat3Nombre}</td>
      <td>${m.Cat1ID} — ${m.Cat1Nombre}</td>
      <td><input type="number" value="${m.CanID ?? ''}" data-f="canId" placeholder="(todos)" style="width:80px" title="${m.CanNombre||''}"></td>
      <td><input value="${m.RepTipe ?? ''}" data-f="repTipe" placeholder="(todas)" style="width:80px"></td>
      <td><input value="${m.RepCodigo ?? ''}" data-f="repCodigo" placeholder="(todos)" style="width:90px" title="${m.RepNombre||''}"></td>
      <td><input value="${m.MetaPct}" data-f="metaPct" style="width:60px"></td>
      <td><select data-f="modo">${['Ideal','Obligatorio'].map(o=>`<option ${o===m.Modo?'selected':''}>${o}</option>`).join('')}</select></td>
      <td style="text-align:center"><input type="checkbox" data-f="bloquea" ${m.BloqueaPublicar?'checked':''}></td>
      <td style="text-align:center"><input type="checkbox" data-f="activo" ${m.Activo?'checked':''}></td>
      <td>
        <button class="btn-sm" onclick="guardarActivacionMetaFila(${m.Id},${m.Cat3ID},${m.Cat1ID},this)">Guardar</button>
        <button class="btn-sm del" onclick="eliminarActivacionMeta(${m.Id})">Borrar</button>
      </td>
    </tr>`).join('');
}

window.guardarActivacionMetaFila = async function(id, cat3Id, cat1Id, btn){
  const tr = btn.closest('tr');
  const canRaw = tr.querySelector('[data-f=canId]').value;
  const repTipeRaw = tr.querySelector('[data-f=repTipe]').value.trim();
  const repCodigoRaw = tr.querySelector('[data-f=repCodigo]').value.trim();
  const body = {
    id, cat3Id, cat1Id,
    canId: canRaw ? parseInt(canRaw) : null,
    repTipe: repTipeRaw || null,
    repCodigo: repCodigoRaw || null,
    metaPct: parseFloat(tr.querySelector('[data-f=metaPct]').value),
    modo: tr.querySelector('[data-f=modo]').value,
    bloqueaPublicar: tr.querySelector('[data-f=bloquea]').checked,
    activo: tr.querySelector('[data-f=activo]').checked,
  };
  if ((body.canId?1:0)+(body.repTipe?1:0)+(body.repCodigo?1:0) > 1) { alert('Canal, División y Vendedor son overrides alternativos — llena solo uno de los tres.'); return; }
  const r = await fetch(BASE+'/apipresupuestogestion/activacion/metas/guardar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
  const j = await r.json();
  if (j.ok) { btn.textContent='✓'; setTimeout(()=>btn.textContent='Guardar',1200); } else alert(j.error||'Error');
};

