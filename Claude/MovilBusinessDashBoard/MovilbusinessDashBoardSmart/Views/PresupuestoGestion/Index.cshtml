// ══════════════════════════════════════════════════════════════════════════
// "6. Eliminar Presupuestos" (2026-09-06) — mismo patrón de confirmación ya
// conocido de "4. Rebalancear" (vista previa + escribir CONFIRMAR). Bloquea
// meses cerrados tanto aquí (mensaje inmediato) como en el servidor (defensa
// en profundidad — ver EliminarAplicar en el controller).
// ══════════════════════════════════════════════════════════════════════════
function construirFiltroEliminar(anio, mes) {
  const reps = document.getElementById('elReps').value.split(',').map(s=>s.trim()).filter(Boolean);
  const productos = document.getElementById('elProductos').value.split(',').map(s=>s.trim()).filter(Boolean).map(Number);
  const canales = Array.from(document.querySelectorAll('#elCanalesCheck input:checked')).map(c=>parseInt(c.value));
  const supervisores = Array.from(document.querySelectorAll('#elSupervisoresCheck input:checked')).map(c=>c.value);
  const suplidores = Array.from(document.querySelectorAll('#elSuplidoresCheck input:checked')).map(c=>c.value);
  const categorias = Array.from(document.querySelectorAll('#elCategoriasCheck input:checked')).map(c=>c.value);
  return {
    anio, mes, preTipo: 'Unddprod',
    reps: reps.length ? reps : null,
    canales: canales.length ? canales : null,
    supervisores: supervisores.length ? supervisores : null,
    suplidores: suplidores.length ? suplidores : null,
    categorias: categorias.length ? categorias : null,
    productos: productos.length ? productos : null,
    confirmacion: null,
  };
}

document.getElementById('btnEliminarPreview').addEventListener('click', async () => {
  const msg = document.getElementById('msgEliminar');
  msg.textContent = 'Consultando...'; msg.className = 'msg';
  document.getElementById('resumenEliminar').innerHTML = '';
  document.getElementById('panelConfirmarEliminar').style.display = 'none';
  document.getElementById('elConfirmTexto').value = '';
  document.getElementById('btnEliminarAplicar').disabled = true;
  try {
    const [ea, em] = document.getElementById('elAnioMes').value.split('-').map(Number);
    if (!ea || !em) { msg.textContent = 'Elige un Año-Mes.'; msg.className='msg err'; return; }
    const filtro = construirFiltroEliminar(ea, em);
    const r = await fetch(BASE+'/apipresupuestogestion/historicos/eliminar/preview', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(filtro) });
    const j = await r.json();
    if (!j.ok) { msg.textContent = j.error || 'Error'; msg.className='msg err'; return; }
    document.getElementById('resumenEliminar').innerHTML =
      `<div class="tarjeta"><div class="lbl">Filas que se eliminarían</div><div class="val">${j.filas}</div></div>` +
      `<div class="tarjeta"><div class="lbl">Suma total</div><div class="val">${fmt(j.sumaTotal)}</div></div>`;
    if (j.mesCerrado) {
      msg.textContent = `${ea}-${String(em).padStart(2,'0')} es un mes CERRADO — no se puede eliminar, solo el mes actual o futuros.`;
      msg.className = 'msg err';
      return;
    }
    if (j.filas === 0) { msg.textContent = 'No hay filas que calcen con estos filtros.'; msg.className='msg'; return; }
    msg.textContent = 'Vista previa lista — escribe CONFIRMAR abajo para eliminar.'; msg.className='msg ok';
    document.getElementById('panelConfirmarEliminar').style.display = 'flex';
  } catch(e) { msg.textContent = 'Error: '+e; msg.className='msg err'; }
});

document.getElementById('elConfirmTexto').addEventListener('input', (e) => {
