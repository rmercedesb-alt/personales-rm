@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Presupuestos &mdash; Gestión</title>
<script src="@(Context.Request.PathBase)/lib/xlsx.full.min.js"></script>
<style>
:root{
  --bg:#F7F9F7;--panel:#FFFFFF;--panel2:#F0F4F0;--border:#D9E2D9;--line:#E6ECE6;
  --text:#1F2A22;--muted:#5C6B5F;
  --verde:#388848;--verde-fuerte:#207830;--azul:#283078;
  --good:#2E9E4A;--warn:#D29922;--bad:#C0392B;
  --good-bg:#EAF7EE;--warn-bg:#FBF3DA;--bad-bg:#FBEAEA;
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:'Segoe UI',Tahoma,sans-serif;font-variant-numeric:tabular-nums;line-height:1.5}
.wrap{max-width:1280px;margin:0 auto;padding:16px 16px 60px}
.title{font-size:22px;font-weight:800;letter-spacing:-.02em;color:var(--verde-fuerte);margin-bottom:2px}
.sub{font-size:12px;color:var(--muted);margin-bottom:14px}
.panel{background:var(--panel);border:1px solid var(--border);border-radius:13px;margin-bottom:16px}
.panel h2{font-size:14px;font-weight:800;color:var(--verde-fuerte);padding:14px 16px 4px}
.filtros{padding:8px 16px 16px;display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end}
.pd{display:flex;flex-direction:column;gap:3px;font-size:11px;color:var(--muted)}
.pd input,.pd select{background:var(--panel);border:1px solid var(--border);border-radius:7px;padding:7px 8px;font-size:12px;color:var(--text);height:34px;min-width:120px}
.pd input.wide{min-width:220px}
.btn-go{background:var(--verde);color:#fff;border:0;border-radius:7px;padding:8px 16px;font-size:13px;font-weight:700;cursor:pointer;height:34px}
.btn-go:hover{background:var(--verde-fuerte)}
.btn-go:disabled{opacity:.5;cursor:default}
.btn-pub{background:var(--azul);color:#fff;border:0;border-radius:7px;padding:8px 16px;font-size:13px;font-weight:700;cursor:pointer;height:34px}
.btn-desc{background:var(--panel);border:1px solid var(--bad);color:var(--bad);border-radius:7px;padding:8px 16px;font-size:13px;font-weight:700;cursor:pointer;height:34px}
.btn-out{background:var(--panel);border:1px solid var(--border);color:var(--muted);border-radius:7px;padding:8px 16px;font-size:13px;font-weight:700;cursor:pointer;height:34px}
.btn-out:hover{border-color:var(--verde);color:var(--verde)}
.btn-mini{background:var(--panel);border:1px solid var(--border);color:var(--bad);border-radius:5px;padding:3px 8px;font-size:11px;cursor:pointer}
.msg{padding:10px 16px;font-size:12.5px}
.msg.err{color:var(--bad)}
.msg.ok{color:var(--good)}
table.res{width:100%;border-collapse:collapse;font-size:12.5px}
table.res th{background:var(--panel2);color:var(--muted);text-align:right;padding:8px 10px;font-weight:700;border-bottom:1px solid var(--border)}
table.res th:first-child,table.res td:first-child,table.res th:nth-child(2),table.res td:nth-child(2){text-align:left}
table.res td{padding:7px 10px;border-bottom:1px solid var(--line);text-align:right}
table.res tr.anom td{background:var(--warn-bg)}
table.res tr.editado td{background:var(--good-bg)}
table.res td.propuesto{cursor:pointer;text-decoration:underline dotted;text-underline-offset:3px}
table.res td.propuesto:hover{color:var(--verde-fuerte)}
table.res td.propuesto input{width:90px;text-align:right;border:1px solid var(--verde);border-radius:5px;padding:3px 5px;font:inherit}
.badge{font-weight:700;border-radius:6px;padding:2px 7px;display:inline-block;font-size:11px}
.badge.warn{background:var(--warn-bg);color:var(--warn)}
.badge.editado{background:var(--good-bg);color:var(--good)}
.resumen{padding:10px 16px;font-size:12.5px;color:var(--muted);display:flex;gap:20px;flex-wrap:wrap}
.resumen b{color:var(--text)}
.acciones{padding:0 16px 16px;display:flex;gap:10px;flex-wrap:wrap}
.agregar{padding:0 16px 16px;display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end;border-top:1px solid var(--line);padding-top:12px;margin:0 16px 16px}
.agregar .pd input{min-width:90px}
.hint{font-size:11px;color:var(--muted);padding:0 16px 10px}
.btn-gear{background:var(--panel);border:1px solid var(--border);border-radius:8px;width:34px;height:34px;font-size:16px;cursor:pointer;flex-shrink:0}
.btn-gear:hover{border-color:var(--azul)}
.top-row{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.tabs-principal{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
.tab-btn{background:var(--panel);border:1px solid var(--border);color:var(--muted);border-radius:9px;padding:10px 18px;font-size:13px;font-weight:700;cursor:pointer}
.tab-btn.on{background:var(--verde);border-color:var(--verde);color:#fff}
.tab-btn:hover:not(.on){border-color:var(--verde);color:var(--verde-fuerte)}
.modal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:100;align-items:center;justify-content:center;padding:20px}
.modal-bg.open{display:flex}
.modal{background:var(--panel);border-radius:13px;max-width:1100px;width:100%;max-height:90vh;overflow:auto;padding:0}
.modal h3{font-size:15px;font-weight:800;color:var(--verde-fuerte);padding:16px 18px 6px}
.modal .sub2{font-size:11.5px;color:var(--muted);padding:0 18px 10px}
.modal-close{float:right;margin:14px 16px 0 0;background:none;border:0;font-size:18px;cursor:pointer;color:var(--muted)}
table.cfg{width:100%;border-collapse:collapse;font-size:12px}
table.cfg th{background:var(--panel2);color:var(--muted);text-align:left;padding:6px 8px;font-weight:700;border-bottom:1px solid var(--border)}
table.cfg td{padding:5px 8px;border-bottom:1px solid var(--line);vertical-align:middle}
table.cfg input,table.cfg select{width:100%;border:1px solid var(--border);border-radius:5px;padding:4px 6px;font-size:12px;background:var(--panel);color:var(--text)}
table.cfg tr.def-row{cursor:pointer}
table.cfg tr.def-row.sel{background:var(--good-bg)}
.btn-sm{background:var(--verde);color:#fff;border:0;border-radius:5px;padding:4px 10px;font-size:11px;cursor:pointer}
.btn-sm.del{background:var(--panel);border:1px solid var(--bad);color:var(--bad)}
.valores-panel{padding:12px 18px 18px;border-top:2px solid var(--border)}
.comp-filtros{padding:8px 16px 16px;display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end}
.tarjetas{display:flex;flex-wrap:wrap;gap:12px;padding:0 16px 16px}
.tarjeta{flex:1;min-width:200px;background:var(--panel2);border:1px solid var(--border);border-radius:10px;padding:12px 14px}
.tarjeta .lbl{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.03em}
.tarjeta .val{font-size:20px;font-weight:800;color:var(--verde-fuerte);margin-top:2px}
.tarjeta .sub3{font-size:11.5px;color:var(--muted);margin-top:4px}
.tarjeta .sub3 b{color:var(--text)}
.crumbs2{padding:0 16px 10px;display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.crumb2{background:var(--panel2);border:1px solid var(--border);border-radius:7px;padding:5px 11px;font-size:12px;cursor:pointer;color:var(--muted)}
.crumb2.on{background:var(--verde);border-color:var(--verde);color:#fff;font-weight:700}
.crumb2:hover:not(.on){border-color:var(--verde)}
table.res tr.clickable{cursor:pointer}
table.res tr.clickable:hover{background:var(--panel2)}
.pct2{font-weight:700;border-radius:6px;padding:2px 7px;display:inline-block;font-size:11.5px}
.pct2.good{background:var(--good-bg);color:var(--good)}
.pct2.bad{background:var(--bad-bg);color:var(--bad)}
.pct2.na{color:var(--muted)}
.crumb2.chico{padding:3px 8px;font-size:11px}
.cadena-bloque{padding:0 16px 18px}
.cadena-encabezado{font-size:13px;font-weight:800;color:var(--verde-fuerte);padding:6px 0}
.cadena-nivel{margin-bottom:10px;border:1px solid var(--border);border-radius:10px;overflow:hidden}
.cadena-titulo{background:var(--panel2);padding:7px 10px;font-size:12px;font-weight:700;color:var(--text);display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.cadena-nivel table.res{font-size:12px}
.canales-check{display:flex;flex-wrap:wrap;gap:6px 12px;max-width:520px}
.canales-check label{font-size:11.5px;color:var(--muted);display:flex;align-items:center;gap:4px;white-space:nowrap}
</style>
</head>
<body>
<div class="wrap">
  <div class="top-row">
    <div>
      <div class="title">Presupuestos &mdash; Gestión</div>
      <div class="sub">Generar, revisar y publicar presupuestos (solo Unddprod en esta primera versión). Todo corre en producción; solo el Publicar final escribe en la base de prueba, mientras dure la etapa de prueba.</div>
    </div>
    <div style="display:flex;gap:10px;align-items:center">
      <span class="badge" id="rolchip" style="background:var(--panel2);color:var(--muted)">…</span>
      <span class="who" id="who" style="font-size:12px;color:var(--muted)"></span>
      <button class="btn-gear" id="btnConfig" title="Configurar variables/metodologías">⚙️</button>
      <a class="btn-out" href="@(Context.Request.PathBase)/menu">&larr; Menú</a>
      <a class="btn-out" href="@(Context.Request.PathBase)/account/logout">Salir</a>
    </div>
  </div>

  <div class="tabs-principal" id="tabsPrincipal">
    <button class="tab-btn on" data-tab="generar">Generar Presupuesto</button>
    <button class="tab-btn" data-tab="rebalancear">Rebalancear por Categoría</button>
    <button class="tab-btn" data-tab="editar">Editar Presupuesto</button>
    <button class="tab-btn" data-tab="eliminar">Borrar Presupuesto</button>
  </div>

  <div id="tabGenerar">
  <div class="panel">
    <h2>1. Generar Nuevo Presupuesto</h2>
    <div class="filtros">
      <div class="pd"><label>Base &mdash; desde</label><input type="date" id="baseIni"></div>
      <div class="pd"><label>Base &mdash; hasta</label><input type="date" id="baseFin"></div>
      <div class="pd"><label>Destino &mdash; desde (Año-Mes)</label><input type="month" id="destinoDesde"></div>
      <div class="pd"><label>Destino &mdash; hasta (Año-Mes, incluido)</label><input type="month" id="destinoHasta"></div>
      <div class="pd"><label>Reps (RepCodigo, coma-separado; vacío = solo los que tuvieron venta o están en RutaVisitas)</label><input type="text" id="reps" class="wide" placeholder="102,11,118"></div>
      <div class="pd"><label>Comparar contra (opcional, Año-Mes)</label><input type="month" id="compararAnioMes"></div>
      <div class="pd">
        <label>Objetivo TOTAL (opcional — reparte lo que quede entre los meses SIN objetivo propio, ver abajo)</label>
        <div style="display:flex;gap:6px;align-items:center">
          <select id="objetivoModo" style="height:34px;border:1px solid var(--border);border-radius:7px;font-size:12px">
            <option value="valor" selected>RD$ (Valor)</option>
            <option value="unidades">Unidades</option>
          </select>
          <input type="number" id="objetivoMonto" style="min-width:140px" placeholder="Ej. 82000000">
        </div>
      </div>
      <div class="pd"><label>Descripción</label><input type="text" id="descripcion" class="wide" placeholder="Propuesta sep-oct 2026"></div>
      <button class="btn-go" id="btnGenerar">Generar</button>
    </div>
    <div class="pd" style="padding:0 16px 10px">
      <label>Objetivo POR MES (opcional — el mes que llenes se fija EXACTO a ese valor; el Objetivo TOTAL de arriba reparte el resto entre los meses que dejes vacíos aquí)</label>
      <div id="objetivosPorMesHost" style="display:flex;flex-wrap:wrap;gap:8px"><span class="hint" style="padding:0">Elige un rango de Destino arriba para ver un campo por mes.</span></div>
    </div>
    <div class="pd" style="padding:0 16px 10px">
      <label>Canales (vacío/todos marcados = todos MENOS Institucional)</label>
      <div class="canales-check" id="canalesCheck"><span class="hint" style="padding:0">Cargando canales…</span></div>
    </div>
    <div class="hint">"Comparar contra" hace que en "2. Revisar" el "Actual" muestre el presupuesto de ESE mes específico (no siempre el mismo período). El "Objetivo TOTAL" y el "Objetivo POR MES" no cambian las proporciones que calculan base+variables — solo reescalan para que la suma de cada mes dé exactamente el número que corresponda (en RD$ o en unidades, a elección) — cada mes queda garantizado en su propia porción, no solo el total combinado.</div>
    <div class="msg" id="msgGenerar"></div>
  </div>

  <div class="panel" id="panelLote" style="display:none">
    <h2>2. Revisar, ajustar y publicar</h2>
    <div class="resumen" id="resumenLote"></div>
    <div class="hint">Clic en un valor "Propuesto" para editarlo a mano. También puedes exportar a Excel, ajustar ahí y volver a subirlo (se actualiza por el Id de fila, no borra ni duplica nada).</div>
    <button class="btn-out" id="btnToggleDetalleLote" style="margin-bottom:8px">▸ Mostrar detalle (fila por fila)</button>
    <div id="detalleLoteWrap" style="display:none">
      <div style="overflow:auto;max-height:520px">
        <table class="res">
          <thead><tr><th>Id</th><th>Rep</th><th>Producto</th><th>Año-Mes</th><th>Propuesto</th><th>Actual</th><th>Diferencia</th><th>Anomalía</th><th></th></tr></thead>
          <tbody id="tbodyLote"></tbody>
        </table>
      </div>
    </div>

    <div class="agregar">
      <div class="pd"><label>Agregar fila manual &mdash; Rep</label><input type="text" id="addRep" placeholder="102"></div>
      <div class="pd"><label>Producto (ProID)</label><input type="text" id="addRef" placeholder="220003"></div>
      <div class="pd"><label>Año-Mes</label><input type="text" id="addAnioMes" placeholder="2026-09" style="min-width:80px"></div>
      <div class="pd"><label>Valor</label><input type="number" id="addValor" placeholder="0" style="min-width:90px"></div>
      <button class="btn-out" id="btnAgregar">+ Agregar fila</button>
    </div>

    <div class="acciones">
      <button class="btn-out" id="btnExportar">📥 Exportar a Excel</button>
      <label class="btn-out" style="display:inline-flex;align-items:center;cursor:pointer">📤 Importar Excel ajustado
        <input type="file" id="inputImportar" accept=".xlsx" style="display:none">
      </label>
      <button class="btn-pub" id="btnPublicar">Publicar</button>
      <button class="btn-desc" id="btnDescartar">Descartar</button>
    </div>
    <div class="msg" id="msgLote"></div>
  </div>

  <div class="panel" id="panelComparativo" style="display:none">
    <h2>3. Análisis comparativo</h2>
    <div class="comp-filtros">
      <div class="pd">
        <label><input type="radio" name="compModo" id="compModoActual" checked> Mismo período (ya publicado)</label><br>
        <label><input type="radio" name="compModo" id="compModoMes"> Mes específico:</label>
      </div>
      <div class="pd"><label>Año-Mes a comparar</label><input type="month" id="compAnioMes" disabled></div>
      <div class="pd"><label>Mes a ver/ajustar</label><select id="filtroMesComp"><option value="">Todos (promedio mensual)</option></select></div>
      <button class="btn-go" id="btnCargarComparativo">Cargar análisis</button>
      <button class="btn-out" id="btnDescargarRevision" title="Reporte de solo lectura — Resumen + Supervisor/Vendedor/Suplidor/Categoría">📥 Descargar Excel de revisión</button>
    </div>
    <div class="msg" id="msgComparativo"></div>
    <div class="crumbs2" id="metricasComparativo">
      <span class="crumb2" onclick="cambiarMetrica('unidades')" id="mUnidades">Unidades</span>
      <span class="crumb2" onclick="cambiarMetrica('cajas')" id="mCajas">Cajas</span>
      <span class="crumb2 on" onclick="cambiarMetrica('monto')" id="mMonto">RD$ (estimado)</span>
    </div>
    <div class="crumbs2" id="vistaComparativo">
      <span class="crumb2 on" onclick="cambiarVista('ventas')" id="vVentas">📈 Ventas</span>
      <span class="crumb2" onclick="cambiarVista('activaciones')" id="vActivaciones">📊 Activaciones</span>
    </div>
    <div class="hint">Cada tarjeta se apila debajo de la anterior — bajar de nivel NO hace que se pierdan de vista los de arriba. "‹ Ver todos" vuelve sin perder lo demás. "🎯 Sugerir para todo" reparte un valor o % nuevo entre TODAS las filas de esa tarjeta, proporcional al peso que ya tenían. Las columnas "Ajuste %"/"Ajuste Monto" son por FILA (ej. un Canal específico, un Vendedor específico): cambia el % o el monto (se sincronizan solos) y presiona "Recalcular" — se convierte a unidades con el precio promedio ponderado de ESE nodo y se aplica SOLO ahí, sin tocar el resto — por eso el total de la compañía sube o baja exactamente esa diferencia. En "📊 Activaciones": el incremento de clientes se traduce a 1 unidad por cliente, SOLO en el producto de mayor venta real de cada Suplidor×Categoría en alcance (lo más conservador) — también sube hacia arriba sin tocar el resto. <b>"Mes a ver/ajustar"</b> (2026-09-01): por defecto ves el promedio de TODOS los meses del rango Destino del lote; elige un mes específico para ver SOLO ese mes y para que "Sugerir para todo"/"Recalcular" apliquen SOLO a ese mes, dejando los demás intactos.</div>
    <div class="tarjetas" id="tarjetaGeneral"></div>

    <div class="cadena-bloque"><div class="cadena-encabezado">Por Centro</div><div id="cadenaCentro"></div></div>
    <div class="cadena-bloque"><div class="cadena-encabezado">Por Canal</div><div id="cadenaCanal"></div></div>
    <div class="cadena-bloque"><div class="cadena-encabezado">Por Suplidor</div><div id="cadenaSuplidor"></div></div>
  </div>
  </div>

  <div id="tabRebalancear" style="display:none">
  <div class="panel" id="panelRebalanceo">
    <h2>4. Herramienta: Rebalancear presupuesto real por Categoría</h2>
    <div class="hint">Reparte el presupuesto YA PUBLICADO de un Año-Mes entre los productos que cada
      vendedor REALMENTE vende (referencia fija: mayo-julio 2026) dentro de cada Categoría —
      preserva el total de la categoría, solo cambia cómo se reparte adentro. Excluye combos (no
      reciben dinero) e Institucional (por defecto). <b>Escribe directo en producción</b> — pide
      siempre la vista previa antes de aplicar.</div>
    <div class="filtros">
      <div class="pd"><label>Año-Mes a corregir</label><input type="month" id="rebalAnioMes" value="2026-08"></div>
      <div class="pd"><label>Vendedor (RepCodigo, coma-separado; vacío = todos)</label><input type="text" id="rebalReps" class="wide" placeholder="102,11,118"></div>
      <button class="btn-go" id="btnRebalPreview">Generar</button>
    </div>
    <div class="msg" id="msgRebalanceo"></div>
    <div class="resumen" id="resumenRebalanceo"></div>
    <div style="overflow:auto;max-height:420px">
      <table class="res" id="tablaRebalanceo">
        <thead><tr><th>Vendedor</th><th>Categoría</th><th>Monto Total</th><th>Estado</th><th></th></tr></thead>
        <tbody id="tbodyRebalanceo"></tbody>
      </table>
    </div>
    <div class="agregar" id="panelConfirmarRebal" style="display:none">
      <div class="pd"><label>Escribe CONFIRMAR para aplicar a producción</label><input type="text" id="rebalConfirmTexto" placeholder="CONFIRMAR"></div>
      <button class="btn-pub" id="btnRebalAplicar" disabled>Publicar a producción</button>
    </div>
  </div>
  </div>

  <div id="tabEditar" style="display:none">
  <div class="panel" id="panelEditar">
    <h2>5. Editar / Reajustar Presupuesto</h2>
    <div class="hint">Recalcula desde cero (mismo motor de "1. Generar Nuevo Presupuesto" — base histórica,
      factores, rapel, activación, efectividad, límites, umbral) pero ACOTADO a un bloque específico —
      Canal/Supervisor/Vendedor/Suplidor/Categoría/Producto. Al Publicar, solo se sobrescriben las filas de
      ESE bloque en <code>PresupuestosHistoricos</code>; el resto del presupuesto ya publicado queda intacto.</div>
    <div class="filtros">
      <div class="pd"><label>Base &mdash; desde</label><input type="date" id="edBaseIni"></div>
      <div class="pd"><label>Base &mdash; hasta</label><input type="date" id="edBaseFin"></div>
      <div class="pd"><label>Año-Mes a editar</label><input type="month" id="edAnioMes"></div>
      <div class="pd"><label>Vendedor (RepCodigo, coma-separado; vacío = todos los que calcen los demás filtros)</label><input type="text" id="edReps" class="wide" placeholder="102,11,118"></div>
      <div class="pd"><label>Producto (ProID, coma-separado; vacío = todos)</label><input type="text" id="edProductos" class="wide" placeholder="220003,220010"></div>
      <div class="pd">
        <label>Objetivo (opcional — redistribuye lo calculado de ese mes, proporcional)</label>
        <div style="display:flex;gap:6px;align-items:center">
          <select id="edObjetivoModo" style="height:34px;border:1px solid var(--border);border-radius:7px;font-size:12px">
            <option value="valor" selected>RD$ (Valor)</option>
            <option value="unidades">Unidades</option>
          </select>
          <input type="number" id="edObjetivoMonto" style="min-width:140px" placeholder="Ej. 1200000">
        </div>
      </div>
      <div class="pd"><label>Descripción</label><input type="text" id="edDescripcion" class="wide" placeholder="Ajuste Colombina Mayorista sep-2026"></div>
      <button class="btn-go" id="btnEditarGenerar">Generar propuesta de edición</button>
    </div>
    <div class="pd" style="padding:0 16px 10px"><label>Canal</label><div class="canales-check" id="edCanalesCheck"><span class="hint" style="padding:0">Cargando…</span></div></div>
    <div class="pd" style="padding:0 16px 10px"><label>Supervisor</label><div class="canales-check" id="edSupervisoresCheck"><span class="hint" style="padding:0">Cargando…</span></div></div>
