document.getElementById('btnEliminarAplicar').addEventListener('click', async () => {
  const msg = document.getElementById('msgEliminar');
  const [ea, em] = document.getElementById('elAnioMes').value.split('-').map(Number);
  const confirmacion = document.getElementById('elConfirmTexto').value.trim();
  if (!confirm(`¿ELIMINAR de producción el presupuesto de ${ea}-${String(em).padStart(2,'0')} que calce con estos filtros? Esta acción no se puede deshacer.`)) return;
  msg.textContent = 'Eliminando...'; msg.className = 'msg';
  try {
    const filtro = construirFiltroEliminar(ea, em);
    filtro.confirmacion = confirmacion;
    const r = await fetch(BASE+'/apipresupuestogestion/historicos/eliminar/aplicar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(filtro) });
    const j = await r.json();
    if (!j.ok) { msg.textContent = j.error || 'Error'; msg.className = 'msg err'; return; }
    msg.textContent = `Eliminado: ${j.filasAfectadas} filas, suma ${fmt(j.sumaTotal)}.`; msg.className = 'msg ok';
    document.getElementById('elConfirmTexto').value = '';
    document.getElementById('btnEliminarAplicar').disabled = true;
    document.getElementById('panelConfirmarEliminar').style.display = 'none';
  } catch(e) { msg.textContent = 'Error: '+e; msg.className = 'msg err'; }
});

async function cargarLote(ctx, loteId){
  ctx.lote = loteId;
  const r = await fetch(BASE+'/apipresupuestogestion/lote/'+loteId);
  const j = await r.json();
  if (!j.ok) return;
  ctx.filas = j.filas;
  document.getElementById('panelLote'+ctx.suf).style.display='block';
  pintarTabla(ctx, j.lote.Estado, j.lote.Descripcion);
  // "3. Análisis comparativo" es exclusivo del flujo de "1. Generar" (CTX_GEN) —
  // "5. Editar" no lo duplica (pedido acotado a filtros+Generar+Publicar, ver
  // PROGRESS.md 2026-09-08).
  if (ctx === CTX_GEN) {
    document.getElementById('panelComparativo').style.display='block';
    poblarFiltroMesComp(j.lote.DestinoDetalle);
  }
}

// "Mes a ver/ajustar" (2026-09-01) — opciones = los meses Destino reales del
// lote (DestinoDetalle = "2026-09,2026-10,..."), no un rango arbitrario.
const NOMBRES_MES_ES = ['','Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
function poblarFiltroMesComp(destinoDetalle){
  const sel = document.getElementById('filtroMesComp');
  const previo = sel.value;
  const meses = (destinoDetalle||'').split(',').map(s=>s.trim()).filter(Boolean);
  sel.innerHTML = '<option value="">Todos (promedio mensual)</option>' + meses.map(v => {
    const [a,m] = v.split('-').map(Number);
    return `<option value="${v}">${NOMBRES_MES_ES[m]} ${a}</option>`;
  }).join('');
  if (meses.includes(previo)) sel.value = previo;
}

// Devuelve el mes elegido en "Mes a ver/ajustar", o {anio:null,mes:null} si está en "Todos".
function obtenerFiltroMesActual(){
  const v = document.getElementById('filtroMesComp').value;
  if (!v) return { anio: null, mes: null };
  const [a, m] = v.split('-').map(Number);
  return { anio: a, mes: m };
}

function pintarTabla(ctx, estado, descripcion){
  const filas = ctx.filas;
  const totalProp = filas.reduce((s,f)=>s+f.Propuesto,0);
  const totalAct = filas.reduce((s,f)=>s+(f.Actual||0),0);
  const anomCount = filas.filter(f=>f.Anomalia).length;
  document.getElementById('resumenLote'+ctx.suf).innerHTML =
    `<span>Estado: <b>${estado}</b></span><span>Filas: <b>${filas.length}</b></span>`+
    `<span>Total propuesto: <b>${fmt(totalProp)}</b></span><span>Total actual: <b>${fmt(totalAct)}</b></span>`+
    `<span>Anomalías: <b>${anomCount}</b></span>` +
    (descripcion ? `<span>${descripcion}</span>` : '');
  const soloLectura = estado !== 'Borrador';
  const tbody = document.getElementById('tbodyLote'+ctx.suf);
  tbody.innerHTML = filas.map(f => `
    <tr class="${f.Anomalia?'anom':''}" data-id="${f.Id}">
      <td>${f.Id}</td>
      <td>${f.RepCodigo} — ${f.RepNombre||''}</td>
      <td>${f.PreReferencia} — ${f.ProductoNombre||''}</td>
      <td>${f.PreAnio}-${String(f.PreMes).padStart(2,'0')}</td>
      <td class="propuesto" ${soloLectura?'':'onclick="editarCelda(this,'+f.Id+','+ctx.nombre+')"'}>${fmt(f.Propuesto)}</td>
      <td>${fmt(f.Actual)}</td>
      <td>${fmt(f.Actual!=null ? f.Propuesto-f.Actual : null)}</td>
      <td>${f.Anomalia ? `<span class="badge warn" title="${f.AnomaliaDetalle||''}">Revisar</span>` : ''}</td>
      <td>${soloLectura?'':'<button class="btn-mini" onclick="eliminarFila('+f.Id+','+ctx.nombre+')">Quitar</button>'}</td>
    </tr>`).join('');
}

window.editarCelda = function(td, id, ctx){
  const actual = ctx.filas.find(f=>f.Id===id).Propuesto;
  td.innerHTML = `<input type="number" step="0.01" value="${actual}">`;
  const input = td.querySelector('input'); input.focus(); input.select();
  const commit = async () => {
    const nuevo = parseFloat(input.value);
    if (isNaN(nuevo)) { pintarTabla(ctx, 'Borrador'); return; }
    await guardarValores(ctx, [{id, valor: nuevo}]);
  };
  input.addEventListener('blur', commit);
  input.addEventListener('keydown', e => { if (e.key==='Enter') input.blur(); if (e.key==='Escape') pintarTabla(ctx, 'Borrador'); });
};

async function guardarValores(ctx, items){
  const msg = document.getElementById('msgLote'+ctx.suf);
  const r = await fetch(BASE+'/apipresupuestogestion/staging/actualizarvalores', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({loteId: ctx.lote, items}) });
  const j = await r.json();
  if (!j.ok) { msg.textContent = j.error||'Error'; msg.className='msg err'; return; }
  msg.textContent = `${j.actualizados} valor(es) actualizado(s).`; msg.className='msg ok';
  await cargarLote(ctx, ctx.lote);
}

window.eliminarFila = async function(id, ctx){
  if (!confirm('¿Quitar esta fila del lote?')) return;
  const msg = document.getElementById('msgLote'+ctx.suf);
  const r = await fetch(BASE+'/apipresupuestogestion/staging/eliminarfila', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({loteId: ctx.lote, id}) });
  const j = await r.json();
  if (!j.ok) { msg.textContent = j.error||'Error'; msg.className='msg err'; return; }
  await cargarLote(ctx, ctx.lote);
};

function wireLoteButtons(ctx){
  document.getElementById('btnAgregar'+ctx.suf).addEventListener('click', async () => {
    const [anio, mes] = document.getElementById('addAnioMes'+ctx.suf).value.split('-').map(s=>parseInt(s));
    const body = {
      loteId: ctx.lote,
      repCodigo: document.getElementById('addRep'+ctx.suf).value.trim(),
      preReferencia: document.getElementById('addRef'+ctx.suf).value.trim(),
      preAnio: anio, preMes: mes,
      valor: parseFloat(document.getElementById('addValor'+ctx.suf).value) || 0,
    };
    const msg = document.getElementById('msgLote'+ctx.suf);
    if (!body.repCodigo || !body.preReferencia || !anio || !mes) { msg.textContent='Completa Rep, Producto y Año-Mes.'; msg.className='msg err'; return; }
    const r = await fetch(BASE+'/apipresupuestogestion/staging/agregarfila', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
    const j = await r.json();
    if (!j.ok) { msg.textContent = j.error||'Error'; msg.className='msg err'; return; }
    msg.textContent = 'Fila agregada.'; msg.className='msg ok';
    await cargarLote(ctx, ctx.lote);
  });

  document.getElementById('btnExportar'+ctx.suf).addEventListener('click', () => {
    const head = ['Id','Rep','RepNombre','Producto','ProductoNombre','Anio','Mes','Propuesto','Actual','Anomalia','Detalle'];
    const rows = ctx.filas.map(f => [f.Id, f.RepCodigo, f.RepNombre||'', f.PreReferencia, f.ProductoNombre||'', f.PreAnio, f.PreMes, f.Propuesto, f.Actual, f.Anomalia?'SI':'', f.AnomaliaDetalle||'']);
    const ws = XLSX.utils.aoa_to_sheet([head].concat(rows));
    const wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, ws, 'Lote');
    XLSX.writeFile(wb, 'presupuesto_lote_'+ctx.lote+'.xlsx');
  });

  document.getElementById('inputImportar'+ctx.suf).addEventListener('change', async (ev) => {
    const file = ev.target.files[0]; if (!file) return;
    const msg = document.getElementById('msgLote'+ctx.suf);
    try {
      const buf = await file.arrayBuffer();
      const wb = XLSX.read(buf, { type:'array' });
      const ws = wb.Sheets[wb.SheetNames[0]];
      const rows = XLSX.utils.sheet_to_json(ws, { header:1 });
      const head = rows[0].map(h => String(h).trim());
      const idxId = head.indexOf('Id'), idxProp = head.indexOf('Propuesto');
      if (idxId < 0 || idxProp < 0) { msg.textContent = 'El Excel debe tener columnas "Id" y "Propuesto" (usa el exportado por este mismo lote).'; msg.className='msg err'; return; }
      const items = rows.slice(1).filter(r => r.length && r[idxId]!=null && r[idxId]!=='').map(r => ({ id: parseInt(r[idxId]), valor: parseFloat(r[idxProp]) })).filter(it => !isNaN(it.id) && !isNaN(it.valor));
      if (items.length === 0) { msg.textContent = 'No se encontraron filas válidas en el Excel.'; msg.className='msg err'; return; }
      await guardarValores(ctx, items);
    } catch(e) { msg.textContent = 'Error leyendo el Excel: '+e; msg.className='msg err'; }
    ev.target.value = '';
  });

  document.getElementById('btnPublicar'+ctx.suf).addEventListener('click', () => publicarLote(ctx, false));

  document.getElementById('btnDescartar'+ctx.suf).addEventListener('click', async () => {
    if (!ctx.lote || !confirm('¿Descartar este lote?')) return;
    const msg = document.getElementById('msgLote'+ctx.suf);
    const r = await fetch(BASE+'/apipresupuestogestion/descartar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({loteId: ctx.lote}) });
    const j = await r.json();
    msg.textContent = j.ok && j.actualizado ? 'Lote descartado.' : (j.error||'No se pudo descartar.');
    msg.className = j.ok && j.actualizado ? 'msg ok' : 'msg err';
    if (j.ok && j.actualizado) await cargarLote(ctx, ctx.lote);
  });
}
