<script>
const BASE = '@(Context.Request.PathBase.Value)';
// Entornos separados (pedido explícito del usuario 2026-09-08): "1. Generar" y
// "5. Editar" ya NO comparten lote/estado — antes generar un lote en la sección 1
// y luego usar "Editar" en la 5 sin publicar sobreescribía la misma variable
// global y el primer lote quedaba huérfano en pantalla. Cada contexto trae su
// propio `lote`/`filas` y un prefijo de ids de DOM (CTX_GEN usa los ids de
// siempre, sin prefijo, para no romper nada de "1. Generar"/"2. Revisar"; CTX_ED
// usa el sufijo 'Ed' del panel nuevo "5b. Revisar y publicar edición").
function crearContexto(suf, nombre){ return { lote: null, filas: [], suf, nombre }; }
const CTX_GEN = crearContexto('', 'CTX_GEN');
const CTX_ED = crearContexto('Ed', 'CTX_ED');

// Sub-menú de entornos (pedido explícito del usuario 2026-09-09: "no quiero ver
// tantos datos de entrada cuando en algunos casos no voy a trabajar con ellos")
// — solo un entorno visible a la vez; los paneles internos de cada uno (p.ej.
// "2. Revisar" dentro de "generar", "5b. Revisar" dentro de "editar") conservan
// su propio display:none/block controlado por cargarLote() — el sub-menú solo
// muestra/oculta el CONTENEDOR del entorno completo, no interfiere con eso.
const TAB_IDS_PRINCIPAL = { generar: 'tabGenerar', rebalancear: 'tabRebalancear', editar: 'tabEditar', eliminar: 'tabEliminar' };
function cambiarTabPrincipal(tab){
  Object.entries(TAB_IDS_PRINCIPAL).forEach(([k, id]) => { document.getElementById(id).style.display = (k === tab) ? 'block' : 'none'; });
  document.querySelectorAll('#tabsPrincipal .tab-btn').forEach(el => el.classList.toggle('on', el.dataset.tab === tab));
}
document.querySelectorAll('#tabsPrincipal .tab-btn').forEach(el => el.addEventListener('click', () => cambiarTabPrincipal(el.dataset.tab)));

// Catálogos de Suplidor/Categoría (2026-09-06, pedido explícito del usuario: mostrar el nombre
// del Suplidor/Categoría en "Metas Rapel" y demás variables por Ámbito) — poblados por el mismo
// fetch de /apipresupuestos/filtros que ya carga Canales/Suplidor/Categoría/Supervisor.
let catalogoSuplidores = [];
let catalogoCategorias = [];

function fmt(n){ return n==null ? '—' : Number(n).toLocaleString('es-DO',{maximumFractionDigits:2}); }

// Detalle fila-por-fila de "2. Revisar" oculto por defecto (pedido explícito
// del usuario 2026-09-01: "no quiero ver detalles a menos que sea algo
