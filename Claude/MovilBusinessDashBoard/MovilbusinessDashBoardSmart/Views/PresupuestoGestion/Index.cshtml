document.getElementById('btnCargarCrecimientoMes').addEventListener('click', async () => {
  const msg = document.getElementById('msgCrecimientoMes');
  for (let m=1;m<=12;m++) { const el = document.getElementById('cmMes'+m); el.value=''; delete el.dataset.id; }
  try {
    const r = await fetch(BASE+'/apipresupuestogestion/variables/valores?varCodigo=FACTOR_CRECIMIENTO_MES');
    const j = await r.json();
    if (!j.ok) { msg.textContent = j.error||'Error'; msg.className='msg err'; return; }
    const ambitoTipo = document.getElementById('cmAmbitoTipo').value;
    const ambitoValorRaw = document.getElementById('cmAmbitoValor').value.trim();
    const anio = parseInt(document.getElementById('cmAnio').value);
    const ambitoValor = ambitoTipo === 'Global' ? null : ambitoValorRaw;
    const filas = (j.valores||[]).filter(v => v.PeriodoTipo === 'Mes' && v.PeriodoAnio === anio && v.AmbitoTipo === ambitoTipo && (v.AmbitoValor||null) === ambitoValor);
    for (const f of filas) {
      const el = document.getElementById('cmMes'+f.PeriodoMes);
      if (el) { el.value = ((f.Valor - 1) * 100).toFixed(2); el.dataset.id = f.Id; }
    }
    msg.textContent = `Cargado: ${filas.length} mes(es) con valor.`; msg.className='msg ok';
  } catch(e) { msg.textContent = 'Error: '+e; msg.className='msg err'; }
});

document.getElementById('btnGuardarCrecimientoMes').addEventListener('click', async () => {
  const msg = document.getElementById('msgCrecimientoMes');
  const ambitoTipo = document.getElementById('cmAmbitoTipo').value;
  const ambitoValorRaw = document.getElementById('cmAmbitoValor').value.trim();
  const anio = parseInt(document.getElementById('cmAnio').value);
  if (!anio) { msg.textContent = 'Indica el Año.'; msg.className='msg err'; return; }
  if (ambitoTipo !== 'Global' && !ambitoValorRaw) { msg.textContent = 'Indica el valor de ámbito (Cat3ID/Cat1ID).'; msg.className='msg err'; return; }
  const ambitoValor = ambitoTipo === 'Global' ? null : ambitoValorRaw;
  msg.textContent = 'Guardando...'; msg.className='msg';
  try {
    let guardados = 0;
    for (let m=1;m<=12;m++) {
      const el = document.getElementById('cmMes'+m);
      const raw = el.value;
      if (raw === '') continue;
      const pct = parseFloat(raw);
      const valor = 1 + (pct/100);
      const idExistente = el.dataset.id ? parseInt(el.dataset.id) : null;
      const body = { id: idExistente, varCodigo:'FACTOR_CRECIMIENTO_MES', ambitoTipo, ambitoValor, periodoTipo:'Mes', periodoAnio:anio, periodoTrimestre:null, periodoMes:m, valor };
      const r = await fetch(BASE+'/apipresupuestogestion/variables/valores/guardar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
      const j = await r.json();
      if (!j.ok) throw new Error(j.error || `Error guardando mes ${m}`);
      if (!idExistente && j.id) el.dataset.id = j.id;
      guardados++;
    }
    msg.textContent = `Guardado: ${guardados} mes(es) actualizados.`; msg.className='msg ok';
  } catch(e) { msg.textContent = 'Error: '+e; msg.className='msg err'; }
});

