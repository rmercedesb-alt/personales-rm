async function publicarLote(ctx, forzar){
  if (!ctx.lote || !confirm(forzar ? '¿Publicar IGUAL, a pesar de la meta de activación obligatoria no alcanzada?' : '¿Publicar este lote a PresupuestosHistoricos?')) return;
  const msg = document.getElementById('msgLote'+ctx.suf);
  const r = await fetch(BASE+'/apipresupuestogestion/publicar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({loteId: ctx.lote, forzar}) });
  const j = await r.json();
  if (!j.ok) {
    if (j.requiereForzar && confirm((j.error||'')+'\n\n¿Publicar de todas formas?')) { await publicarLote(ctx, true); return; }
    msg.textContent = j.error||'Error'; msg.className='msg err'; return;
  }
  msg.textContent = `Publicado: ${j.filasAfectadas} filas, suma ${fmt(j.sumaTotal)}.`; msg.className='msg ok';
  await cargarLote(ctx, ctx.lote);
}

