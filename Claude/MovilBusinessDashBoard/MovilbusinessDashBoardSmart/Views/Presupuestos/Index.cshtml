// ── Toggle Resumen / Detalle por Recurso (hoja 1 / hoja 2) — conserva la posición del
// drill de cada hoja al cambiar entre ellas (solo se resetea cuando llegan datos nuevos,
// ver cargarGraficos()); cada hoja se reconstruye entera al activarse (más simple y
// seguro que tratar de sincronizar altas/bajas parciales de Chart.js entre las 2).
let GRAF_HOJA='resumen';
function setGrafHoja(hoja){
  GRAF_HOJA=hoja;
  document.querySelectorAll('#graf-hoja-seg button').forEach(b=>b.classList.toggle('on', b.dataset.hoja===hoja));
