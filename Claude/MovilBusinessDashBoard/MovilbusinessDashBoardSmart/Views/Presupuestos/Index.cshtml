    $('#extras-cards').innerHTML='<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px">'+
      cards.map(c=>'<div class="panel" style="padding:16px;text-align:center"><div style="font-size:24px;font-weight:800;color:'+c[2]+'">'+c[1]+'</div><div style="font-size:11px;color:var(--muted);margin-top:6px">'+c[0]+'</div></div>').join('')+
      '</div>';
  }).catch(err=>{ $('#extras-cards').innerHTML='<div class="hint">Error: '+err+'</div>'; });
}

/* ── Dashboard Gráficos: Chart.js vendored, carga perezosa (Del Año ya no usa gráfico —
   pedido 2026-08-28, se reemplazó por la tabla mes a mes de abajo) ── */
function ensureChart(cb){
  if(typeof Chart!=='undefined'){ cb(); return; }
  const s=document.createElement('script'); s.src=BASE+'/lib/chart.umd.min.js';
  s.onload=()=>cb(); s.onerror=()=>alert('No se pudo cargar el generador de gráficos.');
  document.head.appendChild(s);
}
const MESES_CORTO=['','Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];

/* ── Toggle KPI Presupuestos / Dashboard Gráficos ──
   Cambiar de modo YA NO dispara una consulta (pedido 2026-08-29: "no cargar la consulta
   hasta que no se realice el filtro") — si ya se consultó antes (GRAF_MOSAICO_DATA
   tiene datos, sin importar en qué modo se estaba), se re-usa/re-renderiza sin refetch;
   si nunca se consultó, se muestra el mismo mensaje que el resto de las vistas. */
function setModo(modo){
  const esGraficos = modo==='graficos';
  $('#btn-modo-kpi').classList.toggle('on', !esGraficos);
  $('#btn-modo-graficos').classList.toggle('on', esGraficos);
  $('#tabs').style.display = esGraficos ? 'none' : '';
  $('#graf-hoja-wrap').style.display = esGraficos ? '' : 'none';
  document.querySelectorAll('.view').forEach(v=>{ v.style.display = esGraficos ? 'none' : (v.classList.contains('on') ? '' : 'none'); });
  $('#view-graficos').style.display = esGraficos ? 'block' : 'none';
  if(esGraficos){
    if(GRAF_MOSAICO_DATA){ if(GRAF_HOJA==='detalle') renderHojaDetalle(); else renderMosaicoGraficos(); }
    else { $('#graficos-contenido').innerHTML='<div class="hint">Elige tus filtros y presiona Consultar.</div>'; $('#graficos-detalle-contenido').innerHTML=''; }
  }
}
$('#btn-modo-kpi').addEventListener('click', ()=>setModo('kpi'));
$('#btn-modo-graficos').addEventListener('click', ()=>setModo('graficos'));
/* ── Dashboard Gráficos (rediseñado 2026-08-29): tarjetas "bullet" con drill down/up
   ligado a los filtros activos — reemplaza el mosaico de rankings/donas de Chart.js
   del 2026-08-28. Pedido explícito del usuario:
   - Nombre (Centro/Canal/Supervisor/Vendedor/Suplidor/Categoría/Producto) SIEMPRE
     alineado a la izquierda — se logra de raíz usando HTML propio (grid de 3
     columnas: nombre/barra/%) en vez de las etiquetas del eje de Chart.js.
   - Barra completa = Presupuesto de la fila (su propio 100%), con 2 rellenos
     superpuestos: Proyectado (claro, de fondo) y Ejecutado al momento (oscuro,
     coloreado según Alcance% — mismo código verde/ámbar/rojo que las tablas).
   - Debajo de cada tarjeta, tabla Presupuesto/Ejecutado/Alcance%/Proyectado/Proy.%.
   - Centro/Canal/Supervisor/Suplidor: Top 10, con drill down (clic en una fila baja
     de nivel) y drill up (clic en la miga de pan) — ambos ligados a los mismos
     filtros ya elegidos arriba, porque parten de GRAF_MOSAICO_DATA (ya filtrado por
     qsFiltros()) y solo lo acotan más en el cliente.
   - Categoría/Producto/Vendedor: 2 tarjetas (Top 5 / Last 5), sin drill (son la vista
     final, no un nivel intermedio).
   Todas las tarjetas ordenan de mayor a menor por Proyectado% (logro proyectado vs.
   Presupuesto, no venta cruda) — pedido explícito 2026-08-29: "el mayor siempre estará
   arriba" — ver graftop()/porProyectadoDesc().
   El KPI (Dinero/Cajas/Facturas/Activación) y el Detalle (Organización/Producto) ya NO
   tienen su propio control aquí (pedido 2026-08-29) — se leen del panel de filtros de
   arriba (detalleKpi()/detalleVista()), el mismo que usa "Detalle" en Del Mes; Facturas
   rara vez tendrá desglose por Suplidor a nivel de producto (ver familiaParaProd), así
   que esas tarjetas pueden salir vacías con ese KPI — comportamiento esperado, no error.
   La Tendencia Mensual sigue siendo el único gráfico Chart.js (línea) — ahora a ancho
   completo (misma altura, más ancho — pedido explícito) y con Proyectado agregado como
   3ª serie, para ver cuánto se proyecta caer/superar frente al Presupuesto, no solo
   Ejecutado vs Presupuesto. ── */
let GRAF_CHARTS=[];
let GRAF_MOSAICO_DATA=null;
function limpiarGraficos(){ GRAF_CHARTS.forEach(c=>c.destroy()); GRAF_CHARTS=[]; }
function colorAlcance(pct){ return pct==null?'#A9C4E8':(pct>=90?'#2E9E4A':(pct>=75?'#D29922':'#C0392B')); }
// Por Canal: no viene directo en drill/organizacion (esas filas no traen CanID) — se
// resuelve por RepCodigo contra el catálogo REPS que ya tiene CanID. Compartidas también
// con los nivelbares Centro/Supervisor/Vendedor de Del Mes y Del Día.
function nombreCanal(id){ return CANALES_NOMBRE.get(String(id))||('Canal '+id); }
function conCanal(list){
  const canalPorRep=new Map(REPS.map(r=>[r.RepCodigo, r.CanID]));
  return list.map(v=>({...v, _canId:canalPorRep.get(v.RepCodigo)}));
}
// Nav de drill de cada tarjeta "primaria" — se resetea cada vez que se cargan datos
// nuevos (cargarGraficos, p.ej. tras Consultar o cambiar de lente KPI), no al navegar
// de nivel dentro de la misma consulta (mismo patrón que drillNav de Detalle).
let GRAF_NAV_CENTRO, GRAF_NAV_CANAL, GRAF_NAV_SUP, GRAF_NAV_SUPLIDOR;
function grafResetNav(){
  GRAF_NAV_CENTRO={nivel:'centro', ced:null, sup:null};
  GRAF_NAV_CANAL={nivel:'canal', canal:null, sup:null};
  GRAF_NAV_SUP={nivel:'supervisor', sup:null};
  GRAF_NAV_SUPLIDOR={nivel:'suplidor', cat3:null, cat1:null};
}
// Ya NO se guarda por visibilidad (view-graficos oculto) — Consultar refresca TODO
// siempre (mismo patrón que cargarResumen/cargarDrill/etc.), pedido 2026-08-29. Si el
// modo Gráficos no está visible en ese momento, se cachea en GRAF_MOSAICO_DATA y se
// renderiza recién cuando el usuario cambie a ese modo (evita construir gráficos
// Chart.js dentro de un contenedor oculto, que Chart.js dimensiona mal).
function cargarGraficos(){
  const kpi=detalleKpi();
  const visible = $('#view-graficos').style.display!=='none';
  if(visible){
    if(GRAF_HOJA==='detalle') $('#graficos-detalle-contenido').innerHTML='<div class="hint">Cargando…</div>';
    else $('#graficos-contenido').innerHTML='<div class="hint">Cargando…</div>';
  }
  // sinCurva=true: el Dashboard Gráficos no muestra Estimado/Est.% (solo Presupuesto/
  // Ejecutado/Alcance%/Proyectado/Proy.%) — se le pide al backend que se salte el cálculo
  // de la curva de estacionalidad por completo (evita, sobre todo en drill/producto sin
  // filtrar por Suplidor, decenas/cientos de consultas pesadas contra VWVentas — 1 por
  // cada Suplidor distinto del catálogo — que eran la causa real de la lentitud
  // reportada por el usuario 2026-08-29).
  const famOrg=familiaParaOrg(kpi);
  const pOrg=qsFiltros(); pOrg.set('familia',famOrg); pOrg.set('kpi',kpi); pOrg.set('sinCurva','true');
  const pProd=qsFiltros(); pProd.set('familia',familiaParaProd(kpi)); pProd.set('kpi',kpi); pProd.set('sinCurva','true');
  // La Tendencia Mensual usa la MISMA familia que las tarjetas "Top 10 Centros/Canales/
  // Supervisores" de abajo (famOrg) — antes siempre leía la familia "producto" fija, lo
  // que para Activación mostraba un total distinto al de esas tarjetas (UNDDACTPROD no
  // reconcilia con UNDDLINACT, ver familiaParaOrg) — pedido 2026-08-29: números
  // consistentes entre las tarjetas del mismo dashboard.
  const pMensual=qsFiltros(); pMensual.set('anio',anioEfectivo()); pMensual.set('mes',12); pMensual.set('detalleMensual','true'); pMensual.set('sinCurva','true');
  pMensual.set('familias',famOrg); pMensual.set('kpi',kpi);
  Promise.all([
    fetch(BASE+'/apipresupuestos/drill/organizacion?'+pOrg.toString()).then(r=>r.json()),
    fetch(BASE+'/apipresupuestos/drill/producto?'+pProd.toString()).then(r=>r.json()),
    fetch(BASE+'/apipresupuestos/resumen?'+pMensual.toString()).then(r=>r.json()),
  ]).then(([jOrg,jProd,jMensual])=>{
    GRAF_MOSAICO_DATA={
      org:(jOrg&&jOrg.ok)?(jOrg.filas||[]):[],
      prod:(jProd&&jProd.ok)?(jProd.filas||[]):[],
      mensual:(jMensual&&jMensual.ok)?(jMensual.entornos.detalle||{}):{},
    };
    grafResetNav(); grafResetNav2();
    if($('#view-graficos').style.display!=='none'){ if(GRAF_HOJA==='detalle') renderHojaDetalle(); else renderMosaicoGraficos(); }
  }).catch(err=>{
    if($('#view-graficos').style.display==='none') return;
    const host = GRAF_HOJA==='detalle' ? $('#graficos-detalle-contenido') : $('#graficos-contenido');
    host.innerHTML='<div class="hint">Error: '+err+'</div>';
  });
}
// Texto de contexto ("Agosto 2026 · Activación") repetido en la cabecera de cada
// tarjeta — pedido explícito 2026-08-29: "en cada gráfico trae más descripción, ejemplo
// el mes... lo que se mide (dinero, activación, facturas)". El período/KPI no cambian
// al hacer drill dentro de una misma consulta, así que basta con fijarlo 1 vez al crear
// la tarjeta (a diferencia del título, que sí cambia con cada nivel).
function subtituloPeriodoKpi(){
  const kpi=detalleKpi();
  return MESES_NOMBRE[mesEfectivo()]+' '+anioEfectivo()+' · '+(kpiTexto[kpi]||kpi);
}
function tarjetaCard(titulo, id, opts){
  opts=opts||{};
  const card=document.createElement('div'); card.className='graf-card'+(opts.full?' full':'');
  card.id=id+'-card';
  let inner='<div class="fam-title" style="padding:0 0 2px">'+titulo+'</div>';
  if(opts.sub) inner+='<div class="sub" style="padding:0 0 6px">'+opts.sub+'</div>';
  if(opts.crumbs) inner+='<div class="crumbs" style="margin:0 0 8px" data-role="crumbs"></div>';
  inner += opts.canvas ? '<canvas id="'+id+'" height="'+(opts.altura||220)+'"></canvas>' : '<div data-role="body"></div>';
  card.innerHTML=inner;
  $('#graficos-contenido').appendChild(card);
  return card;
}
// Suma cruda de Presupuesto/Ejecutado/Proyectado de un conjunto de filas — usada para
// la fila "TOTAL GENERAL" de renderBullet (pedido 2026-08-29: "agrega un TotalGeneral,
// para saber el cuadre del Total de ese filtro" — verificar que el mosaico cuadra
// contra el total real de ese filtro, no solo contra lo que se alcanzó a mostrar).
function sumaFilas(filas){
  let Presupuesto=0, PresupuestoAlDia=0, Ejecutado=0, VentasProyectadas=0, tieneProy=false;
  filas.forEach(f=>{
    Presupuesto+=f.Presupuesto||0; PresupuestoAlDia+=f.PresupuestoAlDia||0; Ejecutado+=f.Ejecutado||0;
    if(f.VentasProyectadas!=null){ VentasProyectadas+=f.VentasProyectadas; tieneProy=true; }
  });
  return {
    Presupuesto, PresupuestoAlDia, Ejecutado,
    AlcancePct: Presupuesto?100*Ejecutado/Presupuesto:null,
    VentasProyectadas: tieneProy?VentasProyectadas:null,
    ProyectadoPct: (tieneProy&&Presupuesto)?100*VentasProyectadas/Presupuesto:null,
  };
}
// 1 sola "fila" que resume TODO un conjunto (usada como barra "Compañía" en la 2ª hoja).
function filaTotalDe(nombre, rows){ return Object.assign({nombre, k:'__total__'}, sumaFilas(rows)); }
// ── Componente "bullet": barra completa = Presupuesto de la fila (100%), con 2
// rellenos superpuestos (Proyectado claro de fondo, Ejecutado oscuro encima) + tabla
// Presupuesto/Ejecutado/Alcance%/Proyectado/Proy.% debajo. filas: {nombre,k,Presupuesto,
// Ejecutado,AlcancePct,VentasProyectadas,ProyectadoPct}. onClick opcional (fila)=>{} —
// si se da, las filas son clic-ables (drill down); usa índice+listener (no onclick
// inline) para no depender de que nombre/k no tengan comillas. filasTotal (opcional):
// conjunto COMPLETO de ese filtro (antes de recortar a Top 10/5) para calcular el TOTAL
// GENERAL — si no se da, se usa 'filas' tal cual (ya es el total, no hubo recorte).
function renderBullet(bodyEl, filas, onClick, filasTotal){
  if(!filas.length){ bodyEl.innerHTML='<div class="hint">Sin datos.</div>'; return; }
  let h='<div class="bullet-list">';
  filas.forEach((f,i)=>{
    const pres=f.Presupuesto||0;
    const pctEj=pres?100*(f.Ejecutado||0)/pres:0;
    const pctProy=pres?100*(f.VentasProyectadas||0)/pres:0;
    h+='<div class="bullet-row'+(onClick?' clickable':'')+'"'+(onClick?' data-i="'+i+'"':'')+'>'
      +'<div class="bullet-name" title="'+f.nombre.replace(/"/g,'&quot;')+'">'+f.nombre+'</div>'
      +'<div class="bullet-track">'
        +'<div class="bullet-fill-proy" style="width:'+Math.max(0,Math.min(100,pctProy))+'%"></div>'
        +'<div class="bullet-fill-ej" style="width:'+Math.max(0,Math.min(100,pctEj))+'%;background:'+colorAlcance(f.AlcancePct)+'"></div>'
      +'</div>'
      +'<div class="bullet-pct">'+(f.AlcancePct!=null?f.AlcancePct.toFixed(1)+'%':'—')+'</div>'
    +'</div>';
  });
  h+='</div>';
  h+='<table class="mini-tabla"><thead><tr><th class="l">Nombre</th><th>Presupuesto</th><th>Ejecutado</th><th>Alcance%</th><th>Proyectado</th><th>Proy.%</th></tr></thead><tbody>';
  filas.forEach(f=>{
    h+='<tr><td class="l" title="'+f.nombre.replace(/"/g,'&quot;')+'">'+f.nombre+'</td><td>'+fmtNum(f.Presupuesto)+'</td><td>'+fmtNum(f.Ejecutado)+'</td><td>'+fmtPct(f.AlcancePct)+'</td><td>'+fmtNum(f.VentasProyectadas)+'</td><td>'+fmtPct(f.ProyectadoPct)+'</td></tr>';
  });
  const tot=sumaFilas(filasTotal||filas);
  h+='<tr style="font-weight:800;background:var(--panel2);border-top:2px solid var(--border)"><td class="l">TOTAL GENERAL</td><td>'+fmtNum(tot.Presupuesto)+'</td><td>'+fmtNum(tot.Ejecutado)+'</td><td>'+fmtPct(tot.AlcancePct)+'</td><td>'+fmtNum(tot.VentasProyectadas)+'</td><td>'+fmtPct(tot.ProyectadoPct)+'</td></tr>';
  h+='</tbody></table>';
  bodyEl.innerHTML=h;
  if(onClick) bodyEl.querySelectorAll('.bullet-row[data-i]').forEach(el=>{
    el.addEventListener('click', ()=>onClick(filas[+el.dataset.i]));
  });
}
// Filas hoja (Vendedor/Producto) no vienen con nombre/k — se homogeniza al mismo shape
// que produce drillAggOrg/drillAggProd para reusar renderBullet sin distinguir casos.
function graficoFilasOrg(list){
  return list.map(v=>({nombre:v.RepNombre+' ('+v.RepCodigo+')', k:v.RepCodigo, Presupuesto:v.Presupuesto, PresupuestoAlDia:v.PresupuestoAlDia, Ejecutado:v.Ejecutado, AlcancePct:v.AlcancePct, VentasProyectadas:v.VentasProyectadas, ProyectadoPct:v.ProyectadoPct}));
}
function graficoFilasProd(list){
  return list.map(v=>({nombre:v.Nombre, k:v.ProID, Presupuesto:v.Presupuesto, PresupuestoAlDia:v.PresupuestoAlDia, Ejecutado:v.Ejecutado, AlcancePct:v.AlcancePct, VentasProyectadas:v.VentasProyectadas, ProyectadoPct:v.ProyectadoPct}));
}
// Ordenado por Proyectado% (logro proyectado vs. Presupuesto) descendente — pedido
// explícito 2026-08-29: "el mayor siempre estará arriba". Antes ordenaba por Ejecutado
// crudo (quién vende más en $), no por qué tan bien va a quedar vs. su propia meta.
function graftop(filas,n){ return filas.slice().sort((a,b)=>(b.ProyectadoPct||0)-(a.ProyectadoPct||0)).slice(0,n||10); }
// Pedido explícito 2026-08-29: "si la cantidad es menor, no pongas Top" — el título de
// cada tarjeta ("Top 10 Centros"...) ahora se arma según lo que REALMENTE hay antes de
// recortar (totalDisponible), no queda fijo desde que se crea la tarjeta. Si no hay que
// recortar nada (totalDisponible<=limite), se muestra solo el sustantivo, sin "Top N".
function tituloConteo(base,totalDisponible,limite){
  limite=limite||10;
  return totalDisponible>limite ? ('Top '+limite+' '+base) : base;
}
function actualizarTituloCard(id,texto){
  const card=$('#'+id+'-card'); if(!card) return;
  const t=card.querySelector('.fam-title'); if(t) t.textContent=texto;
}
function porProyectadoDesc(filas){ return filas.filter(f=>(f.Presupuesto||0)>0).sort((a,b)=>(b.ProyectadoPct||0)-(a.ProyectadoPct||0)); }
// "Top 5"/"Last 5" ahora son 2 TARJETAS SEPARADAS (antes 1 tarjeta con 2 columnas
// lado a lado) — pedido explícito 2026-08-29: "si hablamos de los 5 Mejores Vendedores,
// solo listas esos 5 mejores; en otra gráfica colocas los 5 más rezagados", con los
// nombres renombrados a "Los 5 Mejores"/"Los 5 Más Rezagados" (se evita la concordancia
// de género de "rezagados/rezagadas" según el sustantivo dejando ese sustantivo como
// prefijo: "Categorías — Los 5 Mejores"). Con 5 o menos disponibles no existen un
// "Mejores" y un "Rezagados" reales (serían las MISMAS filas repetidas 2 veces) — se
// colapsa a 1 sola tarjeta ("pluralLabel" simple) y la 2ª tarjeta se oculta.
function renderTop5Last5(cardIdBase, pluralLabel, filas){
  const ordenado=porProyectadoDesc(filas);
  const idMejores=cardIdBase+'-mejores', idRezagados=cardIdBase+'-rezagados';
  const cardM=$('#'+idMejores+'-card'), cardR=$('#'+idRezagados+'-card');
  if(!cardM||!cardR) return;
  if(ordenado.length<=5){
    cardM.style.display=''; cardR.style.display='none';
    actualizarTituloCard(idMejores, pluralLabel);
    renderBullet(cardM.querySelector('[data-role="body"]'), ordenado, null, filas);
    return;
  }
  cardM.style.display=''; cardR.style.display='';
  actualizarTituloCard(idMejores, pluralLabel+' — Los 5 Mejores (por Proyectado%)');
  actualizarTituloCard(idRezagados, pluralLabel+' — Los 5 Más Rezagados (por Proyectado%)');
  const top5=ordenado.slice(0,5), last5=ordenado.slice(-5).reverse();
  renderBullet(cardM.querySelector('[data-role="body"]'), top5, null, filas);
  renderBullet(cardR.querySelector('[data-role="body"]'), last5, null, filas);
}

/* ── Tarjeta drill Centro → Supervisor → Vendedor (Top 10 en cada nivel) ── */
function scopeCentro(){
  let d=(GRAF_MOSAICO_DATA.org||[]);
  if(GRAF_NAV_CENTRO.ced) d=d.filter(v=>v.CedCodigo===GRAF_NAV_CENTRO.ced);
  if(GRAF_NAV_CENTRO.sup) d=d.filter(v=>v.SupCod===GRAF_NAV_CENTRO.sup);
  return d;
}
function renderCardCentro(){
  const card=$('#graf-centro-card'); if(!card) return;
  const nav=GRAF_NAV_CENTRO, org=GRAF_MOSAICO_DATA.org||[], list=scopeCentro();
  let cr='<span class="crumb'+(nav.ced?'':' cur')+'" data-crumb="centro">Compañía</span>';
  if(nav.ced){ const cn=(org.find(v=>v.CedCodigo===nav.ced)||{}).CentroNombre||nav.ced;
    cr+=' › <span class="crumb'+(nav.sup?'':' cur')+'" data-crumb="supervisor">'+cn+'</span>'; }
  if(nav.sup){ const sn=(org.find(v=>v.SupCod===nav.sup)||{}).SupNombre||nav.sup; cr+=' › <span class="crumb cur">'+sn+'</span>'; }
  card.querySelector('[data-role="crumbs"]').innerHTML=cr;
  card.querySelectorAll('[data-crumb]').forEach(el=>el.addEventListener('click',()=>{
    if(el.dataset.crumb==='centro'){ nav.nivel='centro'; nav.ced=null; nav.sup=null; }
    else if(el.dataset.crumb==='supervisor'){ nav.nivel='supervisor'; nav.sup=null; }
    renderCardCentro();
  }));
  let agg, onClick=null;
  if(nav.nivel==='centro'){
    agg=drillAggOrg(list,v=>v.CedCodigo,v=>v.CentroNombre);
    onClick=f=>{ nav.ced=f.k; nav.sup=null; nav.nivel='supervisor'; renderCardCentro(); };
  } else if(nav.nivel==='supervisor'){
    agg=drillAggOrg(list,v=>v.SupCod,v=>v.SupNombre);
    onClick=f=>{ nav.sup=f.k; nav.nivel='vendedor'; renderCardCentro(); };
  } else {
    agg=graficoFilasOrg(list);
  }
  const nombreNivel={centro:'Centros',supervisor:'Supervisores',vendedor:'Vendedores'}[nav.nivel];
  actualizarTituloCard('graf-centro', tituloConteo(nombreNivel, agg.length));
  renderBullet(card.querySelector('[data-role="body"]'), graftop(agg), onClick, agg);
}

/* ── Tarjeta drill Canal → Supervisor → Vendedor (Top 10 en cada nivel) ── */
function scopeCanal(){
  let d=conCanal(GRAF_MOSAICO_DATA.org||[]);
  if(GRAF_NAV_CANAL.canal!=null) d=d.filter(v=>String(v._canId)===String(GRAF_NAV_CANAL.canal));
  if(GRAF_NAV_CANAL.sup) d=d.filter(v=>v.SupCod===GRAF_NAV_CANAL.sup);
