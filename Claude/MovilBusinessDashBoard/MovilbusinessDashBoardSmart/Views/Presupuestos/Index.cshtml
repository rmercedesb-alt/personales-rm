}
function renderCardCanal(){
  const card=$('#graf-canal-card'); if(!card) return;
  const nav=GRAF_NAV_CANAL, orgCanal=conCanal(GRAF_MOSAICO_DATA.org||[]), list=scopeCanal();
  let cr='<span class="crumb'+(nav.canal!=null?'':' cur')+'" data-crumb="canal">Canales</span>';
  if(nav.canal!=null){ const cn=nombreCanal(nav.canal);
    cr+=' › <span class="crumb'+(nav.sup?'':' cur')+'" data-crumb="supervisor">'+cn+'</span>'; }
  if(nav.sup){ const sn=(orgCanal.find(v=>v.SupCod===nav.sup)||{}).SupNombre||nav.sup; cr+=' › <span class="crumb cur">'+sn+'</span>'; }
  card.querySelector('[data-role="crumbs"]').innerHTML=cr;
  card.querySelectorAll('[data-crumb]').forEach(el=>el.addEventListener('click',()=>{
    if(el.dataset.crumb==='canal'){ nav.nivel='canal'; nav.canal=null; nav.sup=null; }
    else if(el.dataset.crumb==='supervisor'){ nav.nivel='supervisor'; nav.sup=null; }
    renderCardCanal();
  }));
  let agg, onClick=null;
  if(nav.nivel==='canal'){
    agg=drillAggOrg(list,v=>v._canId,v=>nombreCanal(v._canId));
    onClick=f=>{ nav.canal=f.k; nav.sup=null; nav.nivel='supervisor'; renderCardCanal(); };
