// ── Del Año (rediseñado 2026-08-25 [sic 2026-08-28]): ya NO es un pivote Vendedor/
// Producto × mes ni un gráfico — pedido explícito del usuario: "siempre serán datos
// GENERALES de los filtros" (el listado de vendedores mes a mes, si hace falta, iría en
// otra pestaña) y "una tabla similar a la que tenemos en Por Mes pero los meses crecen
// hacia abajo". Se arma con /resumen?detalleMensual=true — 1 llamada por Año elegido (esa
// llamada ya trae los 12 meses en 1 sola query por familia/KPI, sin costo adicional).
let LAST_DELANIO=null;
function cargarDelAnio(){
  const anios=MS.anio.values().map(Number).sort((a,b)=>a-b);
  const aniosUsar = anios.length?anios:[anioEfectivo()];
  const kpi=detalleKpi();
  const host=$('#kpis-anio'); host.innerHTML='<div class="panel"><div class="hint">Cargando…</div></div>';
  Promise.all(aniosUsar.map(anio=>{
    const p=qsFiltros(); p.set('anio',anio); p.set('mes',12); p.set('detalleMensual','true');
    p.set('familias',familiaResumen(kpi)); p.set('kpi',kpi);
    return fetch(BASE+'/apipresupuestos/resumen?'+p.toString()).then(r=>r.json()).then(j=>({anio,j}));
  })).then(resultados=>{
    const malos=resultados.filter(r=>!r.j||!r.j.ok);
    if(malos.length){ host.innerHTML='<div class="panel"><div class="hint">'+(malos[0].j&&malos[0].j.error||'Error')+'</div></div>'; return; }
    LAST_DELANIO=resultados;
    renderDelAnioTabla(host, resultados);
  }).catch(err=>{ host.innerHTML='<div class="panel"><div class="hint">Error: '+err+'</div></div>'; });
}
function renderDelAnioTabla(host, resultados){
  host.innerHTML='';
  const familias=[...new Set(resultados.flatMap(r=>Object.keys(r.j.entornos.detalle||{})))];
  if(familias.length===0){ host.innerHTML='<div class="panel"><div class="hint">Sin datos para estos filtros.</div></div>'; return; }
  const multiAnio = resultados.length>1;
  familias.forEach(fam=>{
    const kpisPresentes=[...new Set(resultados.flatMap(r=>Object.keys((r.j.entornos.detalle||{})[fam]||{})))];
    if(kpisPresentes.length===0) return;
    let rows='';
    resultados.forEach(({anio,j})=>{
      const detFam=(j.entornos.detalle||{})[fam]||{};
      // Total de filas que ocupa este Año (para el rowspan de su celda) — se cuenta 1 fila
      // por mes con datos de cada KPI, o 1 fila "Sin datos" si ese KPI no trajo nada.
      const totalFilasAnio = kpisPresentes.reduce((acc,k)=>acc+Math.max(1,(detFam[k]||[]).length),0);
      let primeraFilaAnioHecha=false;
      const celdaAnio=()=>{
        if(!multiAnio || primeraFilaAnioHecha) return '';
        primeraFilaAnioHecha=true;
        return `<td rowspan="${totalFilasAnio}" class="l">${anio}</td>`;
      };
      kpisPresentes.forEach(k=>{
        const lista=detFam[k]||[];
        if(lista.length===0){
          rows+=`<tr>${celdaAnio()}<td class="l">${kpiTexto[k]||k}</td><td colspan="10" style="text-align:center;color:var(--muted)">Sin datos en ${anio}</td></tr>`;
          return;
        }
        lista.forEach(r=>{
          rows+=`<tr>
            ${celdaAnio()}
            <td class="l">${MESES_CORTO[r.Mes]}</td>
            <td class="l">${kpiTexto[k]||k}</td>
            <td>${fmtNum(r.Presupuesto)}</td>
            <td>${fmtNum(r.PresupuestoAlDia)}</td>
            <td>${fmtNum(r.Ejecutado)}</td>
            <td>${fmtPct(r.AlcancePct)}</td>
            <td>${fmtNum((r.PresupuestoAlDia||0)-(r.Ejecutado||0))}</td>
            <td>${fmtNum(r.VentasProyectadas)}</td>
            <td>${fmtPct(r.ProyectadoPct)}</td>
            <td>${fmtNum(r.VentasEstimadas)}</td>
            <td>${fmtPct(r.EstimadoPct)}</td>
            <td>${r.VentasEstimadas==null?'—':fmtNum((r.Presupuesto||0)-r.VentasEstimadas)}</td>
          </tr>`;
        });
      });
    });
    const block=document.createElement('div'); block.className='fam-block panel';
    block.innerHTML = `<div class="fam-title">${familiaTexto2[fam]||fam}</div>
      <table class="kpis">
        <thead><tr>${multiAnio?'<th class="l">Año</th>':''}<th class="l">Mes</th><th class="l">KPI</th><th>Presupuesto</th><th>Pres. al día</th><th>Ejecutado</th><th>Alcance%</th><th>Déficit al Momento</th><th>Proyectado</th><th>Proyectado%</th><th>Estimado</th><th>Estimado%</th><th>Déficit Estimado</th></tr></thead>
        <tbody>${rows}</tbody>
      </table>`;
    host.appendChild(block);
  });
}

/* ── Del Día: meta lineal vs. ajustada por déficit (solo Categoría/Suplidor) ── */
function deldiaPoblarSelectores(){
  const selFam=$('#deldia-familia'); selFam.innerHTML='';
  const conDiario=FAMILIAS.filter(f=>(f.kpisDiario||[]).length>0);
  conDiario.forEach(f=>{ const o=document.createElement('option'); o.value=f.cod; o.textContent=familiaTexto2[f.cod]||f.cod; selFam.appendChild(o); });
  deldiaPoblarKpis();
  selFam.onchange=()=>{ deldiaPoblarKpis(); cargarDelDia(); };
  $('#deldia-kpi').onchange=()=>cargarDelDia();
}
function deldiaPoblarKpis(){
  const fam=FAMILIAS.find(f=>f.cod===$('#deldia-familia').value);
  const selKpi=$('#deldia-kpi'); selKpi.innerHTML='';
  (fam?fam.kpisDiario:[]||[]).forEach(k=>{ const o=document.createElement('option'); o.value=k; o.textContent=kpiTexto[k]||k; selKpi.appendChild(o); });
}
function cargarDelDia(auto){
  const fam=$('#deldia-familia').value, kpi=$('#deldia-kpi').value;
  if(!fam||!kpi) return;
  const diasSel=diasEfectivos();
  if(diasSel){ cargarDelDiaDrill(fam,kpi,diasSel,auto); return; }
  $('#deldia-drill-wrap').style.display='none';
  const p=qsFiltros(); p.delete('familias'); p.set('familia',fam); p.set('kpi',kpi);
  // En refresco automático no se borra la tabla mientras carga — evita el parpadeo/
  // "pantalla en blanco" que el usuario reportó al estar revisando datos.
  if(!auto) $('#deldia-tabla').innerHTML='<div class="hint">Cargando…</div>';
  fetch(BASE+'/apipresupuestos/deldia?'+p.toString()).then(r=>r.json()).then(j=>{
    if(!j||!j.ok){ if(!auto) $('#deldia-tabla').innerHTML='<div class="hint">'+(j&&j.error||'Error')+'</div>'; return; }
    renderDelDia(j);
  }).catch(err=>{ if(!auto) $('#deldia-tabla').innerHTML='<div class="hint">Error: '+err+'</div>'; });
}
// Refresco automático (setInterval cada 2 min): vuelve a pedir los datos vigentes pero
// SIN resetear nada de lo que el usuario tiene en pantalla (nivel de drill Centro/
// Supervisor/Vendedor, vista Organización/Producto, breadcrumbs) — antes cada refresco
// devolvía todo a "Compañía"/"Por Organización" de golpe, perdiendo la navegación.
function refrescarDelDiaAuto(){
  const fam=$('#deldia-familia').value, kpi=$('#deldia-kpi').value;
  if(!fam||!kpi) return;
  cargarDelDia(true);
  if(diasEfectivos() && deldiaVista==='prod') cargarDelDiaDrillProducto(true);
}

/* ── Drill-down Centro→Supervisor→Vendedor para uno o varios días ── */
let DELDIA_DRILL_DATA=[]; let deldiaDrillNav={nivel:'centro',ced:null,sup:null,canal:null}; let DELDIA_DIAS_ACTUALES=[];
let deldiaVista='org'; let DELDIA_PROD_DATA=[]; let DELDIA_PROD_DIM='categoria'; let DELDIA_PROD_DIAS_ACTUALES=[];
// 'comparacion' (default, pedido por el usuario 2026-08-25) muestra una columna por
// día elegido; 'total' suma todos los días elegidos en un solo valor. Con 1 solo día
// da igual — el toggle se oculta y se usa 'total' (camino más simple, ya probado).
let deldiaModo='comparacion';
document.querySelectorAll('#deldia-vista-seg button').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    document.querySelectorAll('#deldia-vista-seg button').forEach(b=>b.classList.remove('on'));
    btn.classList.add('on');
    deldiaVista=btn.dataset.v;
    $('#deldia-vista-org').style.display = deldiaVista==='org' ? '' : 'none';
    $('#deldia-vista-prod').style.display = deldiaVista==='prod' ? '' : 'none';
    if(deldiaVista==='prod') cargarDelDiaDrillProducto();
  });
});
document.querySelectorAll('#deldia-modo-seg button').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    document.querySelectorAll('#deldia-modo-seg button').forEach(b=>b.classList.remove('on'));
    btn.classList.add('on');
    deldiaModo=btn.dataset.m;
    drillRenderDia();
    if(deldiaVista==='prod') drillRenderDiaProducto();
  });
});
function cargarDelDiaDrill(fam,kpi,diasCSV,auto){
  $('#deldia-drill-wrap').style.display='block';
  const listaDias=diasCSV.split(',');
  $('#deldia-drill-titulo').textContent = listaDias.length>1
    ? ('Detalle de '+listaDias.length+' días ('+listaDias.join(', ')+') — '+mesEfectivo()+'/'+anioEfectivo())
    : ('Detalle del día '+diasCSV+'/'+mesEfectivo()+'/'+anioEfectivo());
  $('#deldia-vista-prod-btn').textContent = fam==='suplidor' ? 'Por Suplidor' : 'Por Categoría';
  $('#deldia-modo-seg').style.display = listaDias.length>1 ? '' : 'none';
  if(!auto){
    $('#deldia-tabla').innerHTML='';
    // Reset a "Por Organización" solo cuando el usuario cambió día/familia/kpi a propósito
    // — evita mostrar datos de producto obsoletos de una consulta anterior. En refresco
    // automático (auto=true) se deja tal cual está, junto con el nivel de drill (ver abajo).
    deldiaVista='org';
    document.querySelectorAll('#deldia-vista-seg button').forEach(b=>b.classList.toggle('on', b.dataset.v==='org'));
    $('#deldia-vista-org').style.display=''; $('#deldia-vista-prod').style.display='none';
    DELDIA_PROD_DATA=[]; $('#deldia-drill-prod-tabla').innerHTML='';
    $('#deldia-drill-tabla').innerHTML='<div class="hint">Cargando…</div>'; $('#deldia-drill-nivelbar').innerHTML=''; $('#deldia-drill-crumbs').innerHTML='';
  }
  const p=qsFiltros(); p.delete('familias'); p.set('familia',fam); p.set('kpi',kpi); p.set('dias',diasCSV);
  fetch(BASE+'/apipresupuestos/deldia/drill?'+p.toString()).then(r=>r.json()).then(j=>{
    if(!j||!j.ok){ if(!auto) $('#deldia-drill-tabla').innerHTML='<div class="hint">'+(j&&j.error||'Error')+'</div>'; return; }
    DELDIA_DRILL_DATA=j.filas||[]; DELDIA_DIAS_ACTUALES=j.dias||[];
    // Solo se reinicia el nivel de navegación (Compañía/Centro/Supervisor/Vendedor) en
    // consultas manuales — el refresco automático mantiene dónde estaba el usuario parado.
    if(!auto) deldiaDrillNav={nivel:'centro',ced:null,sup:null,canal:null};
    drillRenderDia();
  }).catch(err=>{ if(!auto) $('#deldia-drill-tabla').innerHTML='<div class="hint">Error: '+err+'</div>'; });
}
let deldiaProdNav={nivel:'suplidor',padreId:null}; let DELDIA_PROD_NIVELES=1;
function cargarDelDiaDrillProducto(auto){
  const fam=$('#deldia-familia').value, kpi=$('#deldia-kpi').value, diasCSV=diasEfectivos();
  if(!fam||!kpi||!diasCSV) return;
  const p=qsFiltros(); p.delete('familias'); p.set('familia',fam); p.set('kpi',kpi); p.set('dias',diasCSV);
  if(!auto){ $('#deldia-drill-prod-tabla').innerHTML='<div class="hint">Cargando…</div>'; $('#deldia-drill-prod-crumbs').innerHTML=''; }
  fetch(BASE+'/apipresupuestos/deldia/drillproducto?'+p.toString()).then(r=>r.json()).then(j=>{
    if(!j||!j.ok){ if(!auto) $('#deldia-drill-prod-tabla').innerHTML='<div class="hint">'+(j&&j.error||'Error')+'</div>'; return; }
    DELDIA_PROD_DATA=j.filas||[]; DELDIA_PROD_DIM=j.dimension||'categoria'; DELDIA_PROD_DIAS_ACTUALES=j.dias||[];
    DELDIA_PROD_NIVELES=j.niveles||1;
    // El nivel de drill (Suplidor/Categoría elegida) solo se reinicia en consulta manual.
