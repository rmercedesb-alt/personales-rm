/* ── Columnas ordenables + pie con filtros activos, en TODAS las tablas de la
   página (encabezados congelados ya resuelto solo con CSS arriba, position:sticky).
   Pedido del usuario 2026-08-25. Se engancha con un MutationObserver en vez de
   tocar cada función de render (son ~10 distintas) — así ninguna tabla se queda
   sin la mejora, incluidas las que se agreguen más adelante. ── */
function textoFiltrosActivos(vistaId){
  const partes=[];
  // Año/Mes ahora son multiselección — se listan todos los elegidos (pedido 2026-08-28:
  // "si se seleccionan varios meses, que se muestren varios meses"). "Día" solo tiene
  // sentido real en la vista "Del Día" (en Del Mes/Del Año/Histórico/Extras no filtra
  // nada — "realmente es por mes", pedido explícito) así que se omite fuera de ahí.
  const anios=(MS.anio?MS.anio.values():[]).map(Number).sort((a,b)=>a-b);
  const meses=(MS.mes?MS.mes.values():[]).map(Number).sort((a,b)=>a-b);
  const anioTxt = anios.length? 'Año '+anios.join(', ') : '';
  const mesTxt = meses.length? 'Mes '+meses.map(m=>MESES_NOMBRE[m]).join(', ') : '';
  if(anioTxt||mesTxt) partes.push([anioTxt,mesTxt].filter(Boolean).join(' · '));
  const add=(label,vals)=>{ if(vals&&vals.length) partes.push(label+': '+vals.join(', ')); };
  if(MS.centro) add('Centro', MS.centro.values());
  if(MS.canal) add('Canal', MS.canal.values().map(v=>(CANALES_NOMBRE&&CANALES_NOMBRE.get(v))||v));
  if(MS.division) add('División', MS.division.values());
  if(MS.supervisor) add('Supervisor', MS.supervisor.values());
  if(MS.vendedor) add('Vendedor', MS.vendedor.values());
  if(MS.suplidor) add('Suplidor', MS.suplidor.values().map(v=>(SUPLIDORES_NOMBRE&&SUPLIDORES_NOMBRE.get(v))||v));
  if(MS.categoria) add('Categoría', MS.categoria.values().map(v=>(CATEGORIAS_NOMBRE&&CATEGORIAS_NOMBRE.get(v))||v));
  if(MS.producto) add('Producto', MS.producto.values().map(v=>(PRODUCTOS_NOMBRE&&PRODUCTOS_NOMBRE.get(v))||v));
  if($('#detalle-vista')) partes.push('Detalle: '+(detalleVista()==='producto'?'Producto (Suplidor, Categoría, Producto)':'Organización (Centro, Supervisor, Vendedor)'));
  if($('#detalle-kpi')) partes.push('KPI: '+(kpiTexto[detalleKpi()]||detalleKpi()));
  if(MS.semana) add('Semana', MS.semana.values());
  if(MS.dia && vistaId==='view-dia') add('Día', MS.dia.values());
  return partes.join(' · ');
}
function activarTablasInteractivas(){
  document.querySelectorAll('table.drill, table.kpis').forEach(table=>{
    const thead=table.querySelector('thead');
    if(thead) [...thead.querySelectorAll('th')].forEach((th,idx)=>{
      if(th._ordenListo) return; th._ordenListo=true;
      th.addEventListener('click', ()=>{
        const tbody=table.querySelector('tbody'); if(!tbody) return;
        const totalRow=tbody.querySelector('tr.totals');
        const filas=[...tbody.querySelectorAll('tr')].filter(tr=>tr!==totalRow);
        const asc = th.dataset.sortDir!=='asc';
        [...thead.querySelectorAll('th')].forEach(o=>{o.classList.remove('sorted-asc','sorted-desc'); if(o!==th) delete o.dataset.sortDir;});
        th.dataset.sortDir = asc?'asc':'desc';
        th.classList.add(asc?'sorted-asc':'sorted-desc');
        const val=(tr)=>{
          const td=tr.children[idx]; const txt=((td&&td.textContent)||'').trim();
          const num=parseFloat(txt.replace(/[^\d.\-]/g,''));
          return (txt==='' || isNaN(num)) ? {n:false,v:txt.toLowerCase()} : {n:true,v:num};
        };
        filas.sort((a,b)=>{
          const va=val(a), vb=val(b);
          if(va.n && vb.n) return asc? va.v-vb.v : vb.v-va.v;
          if(va.n !== vb.n) return va.n ? 1 : -1; // numeros primero en orden asc, consistente
          return asc? String(va.v).localeCompare(String(vb.v)) : String(vb.v).localeCompare(String(va.v));
        });
        filas.forEach(f=>tbody.insertBefore(f, totalRow||null));
      });
    });
    // Pie con los filtros activos — 1 por tabla, se re-crea si la tabla se re-renderiza.
    if(!(table.nextElementSibling && table.nextElementSibling.classList && table.nextElementSibling.classList.contains('pie-filtros'))){
      const vista=table.closest('.view'); const vistaId=vista?vista.id:null;
      const pie=document.createElement('div'); pie.className='pie-filtros'; pie.textContent='Filtros: '+textoFiltrosActivos(vistaId);
      table.insertAdjacentElement('afterend', pie);
    }
  });
}
new MutationObserver(()=>activarTablasInteractivas()).observe(document.body,{childList:true,subtree:true});

/* ── Exportar a PDF: "foto" de la pantalla actual (vía html2canvas + jsPDF, cargados
   perezosamente igual que Excel/Chart.js) — pedido del usuario 2026-08-25. ── */
function ensureHtml2Canvas(cb){
  if(typeof html2canvas!=='undefined'){ cb(); return; }
  const s=document.createElement('script'); s.src=BASE+'/lib/html2canvas.min.js';
  s.onload=()=>cb(); s.onerror=()=>alert('No se pudo cargar el generador de PDF.');
  document.head.appendChild(s);
}
function ensureJsPDF(cb){
  if(window.jspdf&&window.jspdf.jsPDF){ cb(); return; }
  const s=document.createElement('script'); s.src=BASE+'/lib/jspdf.umd.min.js';
  s.onload=()=>cb(); s.onerror=()=>alert('No se pudo cargar el generador de PDF.');
  document.head.appendChild(s);
}
$('#btn-pdf').addEventListener('click', ()=>{
  const btn=$('#btn-pdf'); const txtOriginal=btn.textContent;
  btn.textContent='Generando…'; btn.disabled=true;
  ensureHtml2Canvas(()=>ensureJsPDF(()=>{
    html2canvas($('.wrap'), {scale:2, backgroundColor:'#F7F9F7', useCORS:true}).then(canvas=>{
      const { jsPDF } = window.jspdf;
      const pdf = new jsPDF({orientation:'p', unit:'mm', format:'a4'});
      const pageW=pdf.internal.pageSize.getWidth(), pageH=pdf.internal.pageSize.getHeight();
      // Margen lateral de 1/2 pulgada (12.7 mm) a cada lado — pedido 2026-10-09 (se perdían datos en los bordes).
      const mX=12.7, imgW=pageW-2*mX, imgH=canvas.height*imgW/canvas.width;
      const imgData=canvas.toDataURL('image/jpeg',0.85);   // JPEG comprimido (2026-10-10): el PDF en PNG pesaba mucho
      let heightLeft=imgH, position=0;
      pdf.addImage(imgData,'JPEG',mX,position,imgW,imgH);
      heightLeft-=pageH;
      while(heightLeft>0){
        position=heightLeft-imgH;
        pdf.addPage();
        pdf.addImage(imgData,'JPEG',mX,position,imgW,imgH);
        heightLeft-=pageH;
      }
      const tab=document.querySelector('#tabs button.on')?document.querySelector('#tabs button.on').dataset.tab:'presupuestos';
      pdf.save('presupuestos_'+tab+'_'+anioEfectivo()+'-'+String(mesEfectivo()).padStart(2,'0')+'.pdf');
    }).catch(err=>alert('Error generando PDF: '+err)).finally(()=>{ btn.textContent=txtOriginal; btn.disabled=false; });
  }));
});
</script>
</body>
