      rows+=`<tr>
        <td>${kpiTexto[k]||k}</td>
        <td>${fmtNum(r.Presupuesto)}</td>
        <td>${fmtNum(r.PresupuestoAlDia)}</td>
        <td>${fmtNum(r.Ejecutado)}</td>
        <td>${fmtPct(r.AlcancePct)}</td>
        <td>${fmtNum((r.PresupuestoAlDia||0)-(r.Ejecutado||0))}</td>
        <td>${fmtNum(r.VentasProyectadas)}</td>
        <td>${fmtPct(r.ProyectadoPct)}</td>
        <td>${fmtNum(r.VentasEstimadas)}</td>
        <td>${fmtPct(r.EstimadoPct)}</td>
        <td>${r.VentasEstimadas==null?'—':fmtNum((r.Presupuesto||0)-r.VentasEstimadas)}</td>
        <td>${r.NecesidadDiaria==null?'—':fmtNum(r.NecesidadDiaria)}</td>
      </tr>`;
    });
    block.innerHTML = `<div class="fam-title">${familiaTexto2[fam]||fam}</div>
      <table class="kpis">
        <thead><tr><th>KPI</th><th>Presupuesto</th><th>Pres. al día</th><th>Ejecutado</th><th>Alcance%</th><th>Déficit al Momento</th><th>Proyectado</th><th>Proyectado%</th><th>Estimado</th><th>Estimado%</th><th>Déficit Estimado</th><th>Necesidad Diaria</th></tr></thead>
        <tbody>${rows}</tbody>
      </table>`;
    host.appendChild(block);
  });
}
let LAST_RESUMEN=null, LAST_HISTORICO=null, LAST_EXTRAS=null;
// Modo de presentación de "Del Mes" cuando hay 2+ períodos seleccionados — pedido
// explícito 2026-09-24: "debe presentar el resultado de la suma de los meses
// seleccionados, y si se pide ver el detalle entonces hacer un Drill Down por Mes".
// 'acumulado' (default) = 1 solo bloque con los KPI SUMADOS de todos los períodos;
// 'detalle' = el comportamiento de antes, 1 bloque completo por mes (drill-down). Ambos
// se renderizan desde LAST_RESUMEN ya en caché (sin volver a consultar el backend) — mismo
// patrón que CD.detallado en Supervisión/Cierre Diario (Views/Supervision/Index.cshtml).
let RESUMEN_MODO_MES='acumulado';
// Suma un mismo KPI (p.ej. Cat1=Dinero) a través de N períodos ya consultados. Los montos
// (Presupuesto/PresupuestoAlDia/Ejecutado/VentasProyectadas/VentasEstimadas/DiasTranscurridos/
// DiasDelPeriodo/DiasTranscurridosAjustado/DiasRestantes) se SUMAN directo — son cantidades
// absolutas. Los porcentajes (AlcancePct/ProyectadoPct/EstimadoPct) y NecesidadDiaria NO se
// promedian (un promedio de porcentajes mensuales desvirtúa el peso real de cada mes) — se
// RECALCULAN desde los montos ya sumados, misma fórmula que usa el backend para 1 mes
// (Services/PresupuestosCore.cs: AlcancePct=Ejecutado/Presupuesto, NecesidadDiaria=
// (Presupuesto-Ejecutado)/DiasRestantes) — solo que aplicada al acumulado de todo el rango.
function sumarKpi(porPeriodo){
  const validos=porPeriodo.filter(r=>r);
  if(!validos.length) return null;
  const sum=f=>validos.reduce((s,r)=>s+(r[f]||0),0);
  const sumOrNull=f=>validos.every(r=>r[f]==null) ? null : validos.reduce((s,r)=>s+(r[f]||0),0);
  const presupuesto=sum('Presupuesto'), presupuestoAlDia=sum('PresupuestoAlDia'), ejecutado=sum('Ejecutado');
  const ventasProyectadas=sumOrNull('VentasProyectadas'), ventasEstimadas=sumOrNull('VentasEstimadas');
  const diasRestantes=sum('DiasRestantes');
  return {
    Presupuesto: presupuesto, PresupuestoAlDia: presupuestoAlDia, Ejecutado: ejecutado,
    AlcancePct: presupuesto!==0 ? 100*ejecutado/presupuesto : null,
    VentasProyectadas: ventasProyectadas,
    ProyectadoPct: (ventasProyectadas!=null && presupuesto!==0) ? 100*ventasProyectadas/presupuesto : null,
    VentasEstimadas: ventasEstimadas,
    EstimadoPct: (ventasEstimadas!=null && presupuesto!==0) ? 100*ventasEstimadas/presupuesto : null,
    DiasTranscurridos: sum('DiasTranscurridos'), DiasDelPeriodo: sum('DiasDelPeriodo'),
    DiasTranscurridosAjustado: sum('DiasTranscurridosAjustado'), DiasRestantes: diasRestantes,
    NecesidadDiaria: diasRestantes>0 ? (presupuesto-ejecutado)/diasRestantes : null,
  };
}
// Combina entornos.mes {familia:{kpi:KpiResultado}} de N períodos en 1 solo, sumando cada
// combinación familia+kpi con sumarKpi(). Todos los períodos comparten los mismos filtros/
// familia/kpi (misma consulta, solo cambia Año/Mes), así que las claves ya calzan 1 a 1.
function sumarEntornosMes(resultados){
  const out={}, familias=new Set();
  resultados.forEach(r=>Object.keys(r.j.entornos.mes||{}).forEach(f=>familias.add(f)));
  familias.forEach(fam=>{
    out[fam]={};
    const kpiKeys=new Set();
    resultados.forEach(r=>Object.keys((r.j.entornos.mes||{})[fam]||{}).forEach(k=>kpiKeys.add(k)));
    kpiKeys.forEach(k=>{ out[fam][k]=sumarKpi(resultados.map(r=>((r.j.entornos.mes||{})[fam]||{})[k]||null)); });
  });
  return out;
}
// "Del Mes" ahora siempre muestra un caption con el detalle de la selección — igual que
// ya existía en Del Día ("Detalle del día 28/8/2026") pero antes NO existía aquí, pedido
// explícito 2026-08-28 ("no lo hace igual con el presupuesto del mes"). Con 1 sola
// combinación Año×Mes es 1 línea ("Agosto 2026"); con varias, el acumulado por defecto
// (toggle "Acumulado"/"Detalle por mes" — el drill-down por mes pedido 2026-09-24). Se
// re-renderiza desde LAST_RESUMEN, sin refetch, al cambiar el toggle.
function renderResumenMes(){
  const host=$('#kpis-mes'); host.innerHTML='';
  const resultados=LAST_RESUMEN;
  const cap=document.createElement('div'); cap.className='periodo-titulo';
  cap.textContent = resultados.length===1
    ? ('Detalle de '+MESES_NOMBRE[resultados[0].periodo.mes]+' '+resultados[0].periodo.anio)
    : ((RESUMEN_MODO_MES==='acumulado'?'Acumulado de ':'Detalle de ')+resultados.length+' períodos ('+resultados.map(r=>MESES_NOMBRE[r.periodo.mes]+' '+r.periodo.anio).join(', ')+')');
  host.appendChild(cap);
  if(resultados.length>1){
    const seg=document.createElement('div'); seg.className='seg'; seg.style.marginBottom='10px';
    seg.innerHTML='<button id="mes-modo-acum" class="'+(RESUMEN_MODO_MES==='acumulado'?'on':'')+'">Acumulado</button>'
      +'<button id="mes-modo-detalle" class="'+(RESUMEN_MODO_MES==='detalle'?'on':'')+'">Detalle por mes</button>';
    host.appendChild(seg);
    $('#mes-modo-acum').addEventListener('click', ()=>{ RESUMEN_MODO_MES='acumulado'; renderResumenMes(); });
    $('#mes-modo-detalle').addEventListener('click', ()=>{ RESUMEN_MODO_MES='detalle'; renderResumenMes(); });
  }
  if(resultados.length>1 && RESUMEN_MODO_MES==='acumulado'){
    const entornoAgg=sumarEntornosMes(resultados);
    host.insertAdjacentHTML('beforeend', cardsDiasHtml(primerKpiValido(entornoAgg)));
    renderKpisEn(host, entornoAgg);
    return;
  }
  resultados.forEach(r=>{
    if(resultados.length>1){
      const tit=document.createElement('div'); tit.className='fam-title'; tit.style.padding='16px 0 4px';
      tit.textContent=MESES_NOMBRE[r.periodo.mes]+' '+r.periodo.anio;
      host.appendChild(tit);
    }
    host.insertAdjacentHTML('beforeend', cardsDiasHtml(primerKpiValido(r.j.entornos.mes)));
    renderKpisEn(host, r.j.entornos.mes);
  });
}
// Contador de tiempo transcurrido mientras carga "Del Mes" — pedido del usuario
// 2026-09-25 tras reportar que, tras marcar "Recalcular asumiendo ayer", la pantalla se
// quedó en "Cargando…" 2 minutos sin ningún indicio de si seguía trabajando o estaba
// realmente colgada. Un "Cargando…" estático se siente igual a los 2 segundos que a los 2
// minutos — este contador al menos confirma que la petición sigue viva (el navegador
// sigue actualizando el DOM) y da un número real que reportar si hace falta seguir
// investigando (junto con los logs del servidor — carpeta .\logs, líneas "Curva ...:
// esperó ... por el candado global + ... calculando contra VWVentas").
let _cargandoMesTimer=null;
function iniciarCargandoMes(host){
  const t0=Date.now();
  const render=()=>{
    const seg=Math.floor((Date.now()-t0)/1000);
    const txt = seg<20 ? 'Cargando…' : 'Cargando… ('+seg+'s — si tarda más de lo normal, puede ser el cálculo del patrón de estacionalidad para esta combinación de filtros; revisa los logs del servidor si persiste)';
    host.innerHTML='<div class="panel"><div class="hint">'+txt+'</div></div>';
  };
  render();
  _cargandoMesTimer=setInterval(render, 1000);
}
function detenerCargandoMes(){
  if(_cargandoMesTimer){ clearInterval(_cargandoMesTimer); _cargandoMesTimer=null; }
}
function cargarResumen(){
  const periodos=periodosSeleccionados();
  const kpi=detalleKpi();
  const host=$('#kpis-mes');
  iniciarCargandoMes(host);
  Promise.all(periodos.map(pe=>{
    const p=qsFiltros(); p.set('anio',pe.anio); p.set('mes',pe.mes);
    p.set('familias',familiaResumen(kpi)); p.set('kpi',kpi);
    // OJO: el binder de query string de [FromQuery] bool en ASP.NET Core usa
    // bool.TryParse internamente, que NO acepta "1"/"0" (bool.TryParse("1")==false) —
    // solo "true"/"false". Mandar "1" aquí hacía fallar el model binding, y con
    // [ApiController] eso dispara un 400 automático con un JSON de validación que no
    // tiene "ok"/"error" (por eso el usuario veía "Error al consultar: desconocido",
    // sin mensaje útil) — bug real, encontrado 2026-09-25 tras el reporte del usuario.
    if(ASUMIR_AYER) p.set('asumirAyer','true');
    // Se lee como texto primero (no r.json() directo) — si el backend responde con un
    // shape inesperado (ej. el 400 automático de [ApiController] por un model-binding
    // fallido, que no trae "ok"/"error") antes esto colapsaba en un inútil "Error al
    // consultar: desconocido", sin pista de qué pasó realmente. Guardar httpStatus+raw
    // permite mostrar algo diagnosticable en vez de "desconocido" — pedido implícito del
    // usuario 2026-09-25 tras perder tiempo sin saber qué estaba fallando.
    return fetch(BASE+'/apipresupuestos/resumen?'+p.toString()).then(r=>r.text().then(txt=>{
      let j=null; try{ j=JSON.parse(txt); }catch(e){ /* respuesta no-JSON, j queda null */ }
      return {periodo:pe, j, httpStatus:r.status, raw:txt};
    }));
  })).then(resultados=>{
    detenerCargandoMes();
    const malos=resultados.filter(r=>!r.j||!r.j.ok);
    if(malos.length){
      const m=malos[0];
      const detalle=(m.j&&m.j.error) || ('HTTP '+m.httpStatus+' — '+(m.raw||'').slice(0,300));
      alert('Error al consultar: '+detalle);
      return;
    }
    LAST_RESUMEN=resultados;
    RESUMEN_MODO_MES='acumulado';
    renderResumenMes();
  }).catch(err=>{ detenerCargandoMes(); alert('Error al consultar: '+err); });
}
// Causa real de "Dashboard Gráficos tarda varios minutos" (reportado 2026-08-29,
// verificado en vivo con Puppeteer + Chrome real contra la BD real): Consultar
// disparaba Del Año/Histórico/Extras SIEMPRE, aunque el usuario estuviera viendo
// "Del Mes" o "Dashboard Gráficos" — Del Año en particular calcula la curva de
// estacionalidad UNA VEZ POR CADA MES con datos ese año (hasta 8 veces), y cada una
// puede tardar ~17s la primera vez que ese mes no está en caché ese día (ObtenerCurva/
// CurvaGeneral, ya identificado en la 13ª parte para Dashboard Gráficos — pero Del
// Mes/Del Año NUNCA recibieron el sinCurva=true de aquella vez, porque sí necesitan
// mostrar Estimado/Est.%, a propósito). Con hasta 9 consultas concurrentes compitiendo
// por la misma BD compartida, esas de ~17s atrasaban TODO lo demás disparado en el
// mismo clic — incluidas las de Dashboard Gráficos, que en sí mismas ya son rápidas
// (100-600ms, verificado con timing real: filtros/organización 104ms, producto 575ms,
// resumen 136ms — el cuello de botella nunca fue Chart.js ni esas consultas). Ahora
// Consultar solo refresca la pestaña oculta que esté ACTIVA en ese momento; las otras
// quedan "obsoletas" (se sacan de TABS_CARGADOS) y se recargan solas, frescas, la
// próxima vez que el usuario las visite — mismo patrón de carga perezosa que ya usa
// el clic de pestaña.
$('#btn-consultar').addEventListener('click', ()=>{
  // Del Día queda FUERA de este gate: su recarga ya la maneja su propia cascada
  // (cambios de Año/Mes/Semana/Día + el setInterval de 2 min), no el clic de pestaña
  // como Del Año/Histórico/Extras — sacarlo de TABS_CARGADOS aquí no serviría de nada
  // (nada lo vuelve a disparar al cambiar de pestaña) y dejaría una ventana de filtros
  // obsoletos (Centro/Canal/etc.) hasta el próximo refresco automático.
  cargarResumen(); cargarDrill(); cargarDelDia(); cargarGraficos();
  const tabActivo = document.querySelector('#tabs button.on')?.dataset.tab;
  const pestañasOcultas = {anio:cargarDelAnio, historico:cargarHistorico, extras:cargarExtras};
  Object.keys(pestañasOcultas).forEach(tab=>{
    if(tab===tabActivo){ pestañasOcultas[tab](); TABS_CARGADOS.add(tab); }
    else TABS_CARGADOS.delete(tab);
  });
});

/* ── Histórico: solo ejecución, sin proyección (períodos cerrados) ── */
function histPoblarSelectores(){
  const selFam=$('#hist-familia'); selFam.innerHTML='';
  FAMILIAS.forEach(f=>{ const o=document.createElement('option'); o.value=f.cod; o.textContent=familiaTexto2[f.cod]||f.cod; selFam.appendChild(o); });
  selFam.value='categoria';
  histPoblarKpis();
  selFam.onchange=()=>{ histPoblarKpis(); cargarHistorico(); };
  $('#hist-kpi').onchange=cargarHistorico;
  const anioActual=new Date().getFullYear();
  const selIni=$('#hist-anioIni'), selFin=$('#hist-anioFin');
  for(let a=anioActual-3;a<=anioActual;a++){
    selIni.appendChild(new Option(a,a)); selFin.appendChild(new Option(a,a));
  }
  selIni.value=anioActual-1; selFin.value=anioActual;
  selIni.onchange=cargarHistorico; selFin.onchange=cargarHistorico;
}
function histPoblarKpis(){
  const fam=FAMILIAS.find(f=>f.cod===$('#hist-familia').value);
  const selKpi=$('#hist-kpi'); const prev=selKpi.value; selKpi.innerHTML='';
  (fam?fam.kpis:[]).forEach(k=>{ const o=document.createElement('option'); o.value=k; o.textContent=kpiTexto[k]||k; selKpi.appendChild(o); });
  if([...selKpi.options].some(o=>o.value===prev)) selKpi.value=prev;
}
function cargarHistorico(){
  const fam=$('#hist-familia').value, kpi=$('#hist-kpi').value;
  if(!fam||!kpi) return;
  const p=qsFiltros(); p.delete('familias'); p.delete('anio'); p.delete('mes');
  p.set('familia',fam); p.set('kpi',kpi); p.set('anioIni',$('#hist-anioIni').value); p.set('anioFin',$('#hist-anioFin').value);
  $('#hist-tabla').innerHTML='<div class="hint">Cargando…</div>';
  fetch(BASE+'/apipresupuestos/historico?'+p.toString()).then(r=>r.json()).then(j=>{
    if(!j||!j.ok){ $('#hist-tabla').innerHTML='<div class="hint">'+(j&&j.error||'Error')+'</div>'; return; }
    LAST_HISTORICO=j;
    renderHistorico(j.serie||[]);
  }).catch(err=>{ $('#hist-tabla').innerHTML='<div class="hint">Error: '+err+'</div>'; });
}
function renderHistorico(serie){
  if(serie.length===0){ $('#hist-tabla').innerHTML='<div class="hint">Sin datos para este rango.</div>'; return; }
  const porAnio={};
  serie.forEach(s=>{ (porAnio[s.Anio]=porAnio[s.Anio]||{})[s.Mes]=s.Ejecutado; });
  let h='<table class="drill"><thead><tr><th class="l">Año</th>';
  for(let m=1;m<=12;m++) h+='<th>'+MESES_CORTO[m]+'</th>';
  h+='<th>Total</th></tr></thead><tbody>';
  Object.keys(porAnio).sort().forEach(a=>{
    h+='<tr><td class="l">'+a+'</td>';
    let tot=0;
    for(let m=1;m<=12;m++){ const v=porAnio[a][m]||0; tot+=v; h+='<td>'+fmtNum(v)+'</td>'; }
    h+='<td>'+fmtNum(tot)+'</td></tr>';
  });
  h+='</tbody></table>';
  $('#hist-tabla').innerHTML=h;
}

/* ── Extras: Devoluciones, Meta Gerencial, Efectividad de Visitas, Retención 2 meses ── */
function cargarExtras(){
  const p=qsFiltros(); p.delete('familias');
  $('#extras-cards').innerHTML='<div class="hint">Cargando…</div>';
  fetch(BASE+'/apipresupuestos/extras?'+p.toString()).then(r=>r.json()).then(j=>{
    if(!j||!j.ok){ $('#extras-cards').innerHTML='<div class="hint">'+(j&&j.error||'Error')+'</div>'; return; }
    LAST_EXTRAS=j;
    const cards=[
