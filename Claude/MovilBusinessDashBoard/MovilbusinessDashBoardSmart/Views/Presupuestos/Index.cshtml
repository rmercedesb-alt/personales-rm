function renderMosaicoGraficos(){
  const host=$('#graficos-contenido'); host.innerHTML='';
  const d=GRAF_MOSAICO_DATA;
  if(!d || (!d.org.length && !d.prod.length)){ host.innerHTML='<div class="hint">Sin datos para estos filtros.</div>'; return; }
  host.insertAdjacentHTML('beforeend', cardsDiasHtml(d.org[0]||d.prod[0]));
  ensureChart(()=>{
    limpiarGraficos();
    const kpi=detalleKpi();
    const detProd=(d.mensual[familiaParaOrg(kpi)]||{})[kpi]||[];
    if(detProd.length) tarjetaTendencia('Tendencia Mensual (con Proyectado) — '+(kpiTexto[kpi]||kpi), 'graf-tendencia', detProd);
    const sub=subtituloPeriodoKpi();
    if(d.org.length){
      tarjetaCard('Centros', 'graf-centro', {crumbs:true, sub});
      tarjetaCard('Canales', 'graf-canal', {crumbs:true, sub});
      tarjetaCard('Supervisores', 'graf-sup', {crumbs:true, sub});
    }
    if(d.prod.length) tarjetaCard('Suplidores', 'graf-suplidor', {crumbs:true, sub});
    if(d.org.length){ renderCardCentro(); renderCardCanal(); renderCardSup(); }
    if(d.prod.length) renderCardSuplidor();
    if(d.prod.length){
      tarjetaCard('Categorías', 'graf-categoria-mejores', {sub});
      tarjetaCard('Categorías', 'graf-categoria-rezagados', {sub});
      renderTop5Last5('graf-categoria', 'Categorías', drillAggProd(d.prod, v=>v.Cat1ID, v=>v.Cat1Nombre));
      tarjetaCard('Productos', 'graf-producto-mejores', {sub});
      tarjetaCard('Productos', 'graf-producto-rezagados', {sub});
      renderTop5Last5('graf-producto', 'Productos', graficoFilasProd(d.prod));
    }
    if(d.org.length){
      tarjetaCard('Vendedores', 'graf-vendedor-mejores', {sub});
      tarjetaCard('Vendedores', 'graf-vendedor-rezagados', {sub});
      renderTop5Last5('graf-vendedor', 'Vendedores', graficoFilasOrg(d.org));
    }
  });
}

/* ── "Detalle por Recurso" (2ª hoja de Dashboard Gráficos, pedido 2026-08-29) ──
   Combos de columnas (Presupuesto/Pres. al día/Ejecutado/Proyectado) + línea de Logro%
   (Proyectado%), UNO por cada nivel de 3 "cadenas" independientes que conviven en la
   misma hoja (mismo patrón que Centro/Canal/Suplidor en la hoja 1):
     Compañía → Centro → Supervisor → Vendedor
     Compañía → Canal  → Supervisor → Vendedor
     Compañía → Suplidor → Categoría → Producto
   A diferencia de la hoja 1 (que reemplaza 1 tarjeta al hacer drill), aquí cada nivel
   es su PROPIA tarjeta que se apila debajo — Compañía y el primer nivel (Centro/Canal/
   Suplidor) SIEMPRE visibles; los niveles más profundos aparecen recién al hacer clic
   en el nivel anterior, y cada uno reemplaza lo que hubiera más abajo de él (si cambias
   de Centro, el Supervisor/Vendedor de la selección anterior desaparece). "Ver todos"
   en cada tarjeta drilleada permite volver sin perder de vista los niveles de arriba.
   Muestra TODOS los recursos (no Top 10, pedido explícito "aquí se podrían ver todos
   los recursos") — con scroll horizontal dentro de la tarjeta para que quepan. */
let GRAF2_NAV_CENTRO={ced:null,sup:null};
let GRAF2_NAV_CANAL={canal:null,sup:null};
let GRAF2_NAV_SUPLIDOR={cat3:null,cat1:null};
function grafResetNav2(){
  GRAF2_NAV_CENTRO={ced:null,sup:null};
  GRAF2_NAV_CANAL={canal:null,sup:null};
  GRAF2_NAV_SUPLIDOR={cat3:null,cat1:null};
}
// Combo Chart.js: 4 barras (Presupuesto/Pres.alDía/Ejecutado/Proyectado, eje izq.) + 1
// línea (Logro% = Proyectado%, eje der.) — SIEMPRE ordenado de mayor a menor Logro%
// (pedido explícito: "como siempre ordenada de mayor logro a menor logro"). onClick(fila)
// opcional -> drill al siguiente nivel (clic en cualquier barra/punto de esa columna).
function renderChartCombo(containerEl, filas, onClick){
  containerEl.innerHTML='';
  if(!filas.length){ containerEl.innerHTML='<div class="hint">Sin datos.</div>'; return; }
  const t0=performance.now();
  const ordenado=filas.slice().sort((a,b)=>(b.ProyectadoPct||0)-(a.ProyectadoPct||0));
  const wrap=document.createElement('div'); wrap.className='graf-scroll-x';
  const inner=document.createElement('div');
  inner.style.cssText='height:280px;width:'+Math.max(420,ordenado.length*90)+'px';
  const canvas=document.createElement('canvas');
  inner.appendChild(canvas); wrap.appendChild(inner); containerEl.appendChild(wrap);
  const chart=new Chart(canvas.getContext('2d'),{
    type:'bar',
    data:{ labels:ordenado.map(f=>f.nombre), datasets:[
      {type:'bar',label:'Presupuesto',data:ordenado.map(f=>f.Presupuesto||0),backgroundColor:'#A9C4E8',yAxisID:'y'},
      {type:'bar',label:'Pres. al día',data:ordenado.map(f=>f.PresupuestoAlDia||0),backgroundColor:'#7FA8D9',yAxisID:'y'},
      {type:'bar',label:'Ejecutado',data:ordenado.map(f=>f.Ejecutado||0),backgroundColor:'#283078',yAxisID:'y'},
      {type:'bar',label:'Proyectado',data:ordenado.map(f=>f.VentasProyectadas||0),backgroundColor:'#D29922',yAxisID:'y'},
      {type:'line',label:'Logro% (Proyectado)',data:ordenado.map(f=>f.ProyectadoPct),borderColor:'#C0392B',backgroundColor:'#C0392B',yAxisID:'y1',tension:.25,pointRadius:3},
    ]},
    options:{
      responsive:true, maintainAspectRatio:false,
      // animation:false — con cientos de barras, animar no aporta nada y sí cuesta.
      animation:false,
      interaction:{mode:'index',intersect:false},
      plugins:{legend:{position:'bottom',labels:{boxWidth:11,font:{size:10}}}},
      scales:{
        // OJO — causa real de "dura varios minutos" (reportado 2026-08-29): con
        // autoSkip:false, Chart.js intenta calcular una rotación SIN solapamiento
        // probando ángulo por ángulo para CADA etiqueta (nombres de producto/vendedor
        // pueden ser largos) — con cientos de barras esa búsqueda se vuelve carísima
        // (caso documentado de Chart.js, no un bug nuestro). Como el ancho del canvas
        // YA se dimensiona proporcional a la cantidad (ver más abajo), autoSkip:true
        // (default) alcanza para mostrar todas las etiquetas sin necesitar ese cálculo
        // costoso — y minRotation=maxRotation fija un solo ángulo (45°) de una vez,
        // sin buscar, para las que sí requieran rotarse.
        x:{ticks:{autoSkip:true,maxRotation:45,minRotation:45}},
        y:{beginAtZero:true,position:'left',ticks:{callback:v=>fmtNum(v)}},
        y1:{beginAtZero:true,position:'right',grid:{drawOnChartArea:false},ticks:{callback:v=>(v==null?'':v.toFixed(0)+'%')}},
      },
      onClick: onClick ? (evt,elems)=>{ if(elems.length) onClick(ordenado[elems[0].index]); } : undefined,
    }
  });
  GRAF_CHARTS.push(chart);
  // Diagnóstico temporal (pedido 2026-08-29, "dura varios minutos") — deja evidencia en
  // consola de cuántas barras y cuánto tardó CADA gráfico, para confirmar si el fix de
  // arriba resuelve o si hace falta seguir investigando con datos reales del usuario.
  console.log('[graf-combo]', ordenado.length, 'recursos —', (performance.now()-t0).toFixed(0), 'ms');
}
// 1 tarjeta = 1 nivel de una cadena. onVolver (opcional) agrega un link "‹ Ver todos"
// junto al título — solo tiene sentido en niveles drilleados (no en Compañía/nivel 1).
function crearNivelChart(parentEl, titulo, sub, filas, onClick, onVolver){
  const card=document.createElement('div'); card.className='graf-card';
  card.innerHTML='<div class="fam-title" style="padding:0 0 2px">'+titulo
      +(onVolver?' <span class="crumb chico" data-role="volver">‹ Ver todos</span>':'')+'</div>'
    +(sub?'<div class="sub" style="padding:0 0 8px">'+sub+'</div>':'')
    +'<div data-role="chart"></div>';
  parentEl.appendChild(card);
  if(onVolver) card.querySelector('[data-role="volver"]').addEventListener('click', onVolver);
  renderChartCombo(card.querySelector('[data-role="chart"]'), filas, onClick);
  return card;
}
