// Nivel 2 (Suplidor→Categoría, disponible cuando DELDIA_PROD_NIVELES===2 — Suplidor+
// Dinero inferido desde Categoría). Mismo patrón de breadcrumb que deldiaDrillSetNivel.
function deldiaProdSetNivel(nivel,padreId){
  deldiaProdNav={nivel,padreId:(padreId!==undefined?padreId:deldiaProdNav.padreId)};
  if(nivel==='suplidor') deldiaProdNav.padreId=null;
  drillRenderDiaProducto();
}
window.deldiaProdDrill=(padreId)=>{ deldiaProdSetNivel('categoria',padreId); };
// Agrupa filas {Id/Nombre,Dia,Ejecutado} en {k,nombre,porDia:{dia:ejec}} — usado por el
// modo "Comparación" (pivote entidad × día) tanto para Organización como Producto.
function pivoteAgg(list,keyFn,nameFn,parentFn){
  const g={};
  list.forEach(v=>{
    const k=keyFn(v);
    if(!g[k]) g[k]={k,nombre:nameFn(v),padre:parentFn?parentFn(v):'',porDia:{}};
    g[k].porDia[v.Dia]=(g[k].porDia[v.Dia]||0)+(v.Ejecutado||0);
  });
  return Object.values(g).sort((a,b)=>{
    const ta=Object.values(a.porDia).reduce((x,y)=>x+y,0), tb=Object.values(b.porDia).reduce((x,y)=>x+y,0);
    return tb-ta;
  });
}
// Igual patrón que deldiaDrillAggHoja pero con clave/nombre genéricos — usado por
// Por Categoría/Suplidor en modo "Total sumado" (suma entre días elegidos).
function deldiaProdAgg(list,keyFn,nameFn){
  const g={};
  list.forEach(v=>{
    const k=keyFn(v);
    if(!g[k]) g[k]={k,nombre:nameFn(v),PresupuestoA:0,PresupuestoB:0,Ejecutado:0,tieneB:false};
    g[k].PresupuestoA+=v.PresupuestoA||0; g[k].Ejecutado+=v.Ejecutado||0;
    if(v.PresupuestoB!=null){ g[k].PresupuestoB+=v.PresupuestoB; g[k].tieneB=true; }
  });
  return Object.values(g).map(o=>{
    o.AlcancePct=o.PresupuestoA?100*o.Ejecutado/o.PresupuestoA:null;
    o.AlcanceLinealPct=(o.tieneB&&o.PresupuestoB)?100*o.Ejecutado/o.PresupuestoB:null;
    return o;
  }).sort((a,b)=>b.PresupuestoA-a.PresupuestoA);
}
function drillRenderDiaProducto(){
  if(!DELDIA_PROD_DATA.length){ $('#deldia-drill-prod-tabla').innerHTML='<div class="hint">Sin datos para este/estos día(s).</div>'; $('#deldia-drill-prod-crumbs').innerHTML=''; return; }
  const dosNiveles = DELDIA_PROD_NIVELES===2; // Suplidor+Dinero inferido desde Categoría
  let list=DELDIA_PROD_DATA, etiqueta=(DELDIA_PROD_DIM==='suplidor'?'Suplidor':'Categoría'), enNivel2=false;
  if(dosNiveles){
    let cr='<span class="crumb '+(deldiaProdNav.padreId==null?'cur':'')+'" onclick="deldiaProdSetNivel(\'suplidor\')">Todos los suplidores</span>';
    if(deldiaProdNav.padreId!=null){
      const fila=DELDIA_PROD_DATA.find(v=>v.PadreId===deldiaProdNav.padreId);
      cr+=' › <span class="crumb cur">'+(fila?fila.PadreNombre:deldiaProdNav.padreId)+'</span>';
      list=DELDIA_PROD_DATA.filter(v=>v.PadreId===deldiaProdNav.padreId);
      etiqueta='Categoría'; enNivel2=true;
    }
    $('#deldia-drill-prod-crumbs').innerHTML=cr;
  } else {
    $('#deldia-drill-prod-crumbs').innerHTML='';
  }
  const drillable = dosNiveles && !enNivel2; // nivel 1 (Suplidor) es clickeable -> baja a Categoría
  const keyFn = drillable ? (v=>v.PadreId) : (v=>v.Id);
  const nameFn = drillable ? (v=>v.PadreNombre) : (v=>v.Nombre);

  const dias=DELDIA_PROD_DIAS_ACTUALES.slice().sort((a,b)=>a-b);
  if(dias.length>1 && deldiaModo==='comparacion'){
    const rows=pivoteAgg(list, keyFn, nameFn);
    let h='<table class="drill"><thead><tr><th class="l">#</th><th class="l">'+etiqueta+'</th>'+
      dias.map(d=>'<th>Día '+d+'</th>').join('')+'<th>Total</th></tr></thead><tbody>';
    const totales=new Array(dias.length).fill(0); let totalGeneral=0;
    rows.forEach((r,i)=>{
      const porDia=dias.map(d=>r.porDia[d]||0);
      porDia.forEach((v,ix)=>totales[ix]+=v);
      const tot=porDia.reduce((a,b)=>a+b,0); totalGeneral+=tot;
      h+='<tr'+(drillable?' class="clickable" onclick="deldiaProdDrill('+r.k+')"':'')+'><td class="l">'+(i+1)+'</td><td class="l">'+r.nombre+'</td>'+porDia.map(v=>'<td>'+fmtNum(v)+'</td>').join('')+'<td><b>'+fmtNum(tot)+'</b></td></tr>';
    });
    h+='<tr class="totals"><td class="l" colspan="2">TOTAL</td>'+totales.map(v=>'<td>'+fmtNum(v)+'</td>').join('')+'<td><b>'+fmtNum(totalGeneral)+'</b></td></tr>';
    h+='</tbody></table>';
    $('#deldia-drill-prod-tabla').innerHTML=h;
    return;
  }
  // Modo "Total sumado" (o un solo día): agregar sumando todos los días elegidos.
  const rows=deldiaProdAgg(list, keyFn, nameFn);
  const tieneB=rows.some(r=>r.tieneB);
  let h='<table class="drill"><thead><tr><th class="l">#</th><th class="l">'+etiqueta+'</th><th>Meta ajustada</th>'+
    (tieneB?'<th>Meta lineal</th>':'')+'<th>Ejecutado</th><th>Alcance del día%</th>'+(tieneB?'<th>Alcance lineal%</th>':'')+'</tr></thead><tbody>';
  let tA=0,tB=0,tE=0;
  rows.forEach((r,i)=>{
    h+='<tr'+(drillable?' class="clickable" onclick="deldiaProdDrill('+r.k+')"':'')+'><td class="l">'+(i+1)+'</td><td class="l">'+r.nombre+'</td><td>'+fmtNum(r.PresupuestoA)+'</td>'+
      (tieneB?'<td>'+fmtNum(r.tieneB?r.PresupuestoB:null)+'</td>':'')+'<td>'+fmtNum(r.Ejecutado)+'</td><td>'+fmtPct(r.AlcancePct)+'</td>'+
      (tieneB?'<td>'+fmtPct(r.AlcanceLinealPct)+'</td>':'')+'</tr>';
    tA+=r.PresupuestoA||0; tB+=(r.tieneB?r.PresupuestoB:0)||0; tE+=r.Ejecutado||0;
  });
  h+='<tr class="totals"><td class="l" colspan="2">TOTAL ('+rows.length+')</td><td>'+fmtNum(tA)+'</td>'+
    (tieneB?'<td>'+fmtNum(tB)+'</td>':'')+'<td>'+fmtNum(tE)+'</td><td>'+fmtPct(tA?100*tE/tA:null)+'</td>'+
    (tieneB?'<td>'+fmtPct(tB?100*tE/tB:null)+'</td>':'')+'</tr>';
  h+='</tbody></table>';
  $('#deldia-drill-prod-tabla').innerHTML=h;
}
function deldiaDrillScope(){
  let d=DELDIA_DRILL_DATA;
  if(deldiaDrillNav.canal!=null) d=conCanal(d).filter(v=>String(v._canId)===String(deldiaDrillNav.canal));
  if(deldiaDrillNav.ced) d=d.filter(v=>v.CedCodigo===deldiaDrillNav.ced);
  if(deldiaDrillNav.sup) d=d.filter(v=>v.SupCod===deldiaDrillNav.sup);
  return d;
}
function deldiaDrillAgg(list,keyFn,nameFn,parentFn){
  const g={};
  list.forEach(v=>{
    const k=keyFn(v);
    if(!g[k]) g[k]={k,nombre:nameFn(v),padre:parentFn?parentFn(v):'',PresupuestoA:0,PresupuestoB:0,Ejecutado:0,tieneB:false};
    g[k].PresupuestoA+=v.PresupuestoA||0; g[k].Ejecutado+=v.Ejecutado||0;
    if(v.PresupuestoB!=null){ g[k].PresupuestoB+=v.PresupuestoB; g[k].tieneB=true; }
  });
  return Object.values(g).map(o=>{
    o.AlcancePct=o.PresupuestoA?100*o.Ejecutado/o.PresupuestoA:null;
    o.AlcanceLinealPct=(o.tieneB&&o.PresupuestoB)?100*o.Ejecutado/o.PresupuestoB:null;
    return o;
  }).sort((a,b)=>b.PresupuestoA-a.PresupuestoA);
}
// Agrega filas hoja (Vendedor) sumando entre días — antes se mostraba 'list' crudo
// (1 fila por vendedor) porque solo había 1 día; con varios días hay 1 fila por
// (vendedor,día) y hay que sumarlas para no repetir al mismo vendedor N veces.
function deldiaDrillAggHoja(list){
  const g={};
  list.forEach(v=>{
    const k=v.RepCodigo;
    if(!g[k]) g[k]={RepCodigo:v.RepCodigo,RepNombre:v.RepNombre,CentroNombre:v.CentroNombre,SupNombre:v.SupNombre,_canId:v._canId,PresupuestoA:0,PresupuestoB:0,Ejecutado:0,tieneB:false};
    g[k].PresupuestoA+=v.PresupuestoA||0; g[k].Ejecutado+=v.Ejecutado||0;
    if(v.PresupuestoB!=null){ g[k].PresupuestoB+=v.PresupuestoB; g[k].tieneB=true; }
  });
  return Object.values(g).map(o=>{
    o.AlcancePct=o.PresupuestoA?100*o.Ejecutado/o.PresupuestoA:null;
    o.AlcanceLinealPct=(o.tieneB&&o.PresupuestoB)?100*o.Ejecutado/o.PresupuestoB:null;
    return o;
  }).sort((a,b)=>b.PresupuestoA-a.PresupuestoA);
}
function drillRenderDia(){
  const list=deldiaDrillScope();
  const listTagged=conCanal(list);
  const porCanal=deldiaDrillNav.canal!=null;
  const tieneB = DELDIA_DRILL_DATA.some(v=>v.PresupuestoB!=null);
  let cr;
  if(porCanal){
    const cn=nombreCanal(deldiaDrillNav.canal);
    cr='<span class="crumb" onclick="deldiaDrillSetNivel(\'canal\',null,null,null)">Canales</span>'+
       ' › <span class="crumb '+(deldiaDrillNav.sup?'':'cur')+'" onclick="deldiaDrillSetNivel(\'supervisor\',null,null,'+JSON.stringify(deldiaDrillNav.canal)+')">'+cn+'</span>';
    if(deldiaDrillNav.sup){ const sn=(DELDIA_DRILL_DATA.find(v=>v.SupCod===deldiaDrillNav.sup)||{}).SupNombre||deldiaDrillNav.sup; cr+=' › <span class="crumb cur">'+sn+'</span>'; }
  } else {
    cr='<span class="crumb '+(deldiaDrillNav.ced?'':'cur')+'" onclick="deldiaDrillSetNivel(\'centro\',null,null,null)">Compañía</span>';
    if(deldiaDrillNav.ced){ const cn=(DELDIA_DRILL_DATA.find(v=>v.CedCodigo===deldiaDrillNav.ced)||{}).CentroNombre||deldiaDrillNav.ced;
      cr+=' › <span class="crumb '+(deldiaDrillNav.sup?'':'cur')+'" onclick="deldiaDrillSetNivel(\'supervisor\',\''+deldiaDrillNav.ced+'\',null,null)">'+cn+'</span>'; }
    if(deldiaDrillNav.sup){ const sn=(DELDIA_DRILL_DATA.find(v=>v.SupCod===deldiaDrillNav.sup)||{}).SupNombre||deldiaDrillNav.sup; cr+=' › <span class="crumb cur">'+sn+'</span>'; }
  }
  $('#deldia-drill-crumbs').innerHTML=cr;
  const nb=(id,t)=>'<button class="btn-modo'+(deldiaDrillNav.nivel===id?' on':'')+'" onclick="deldiaDrillSetNivel(\''+id+'\')">'+t+'</button>';
  $('#deldia-drill-nivelbar').innerHTML=nb('centro','Por Centro')+nb('supervisor','Por Supervisor')+nb('vendedor','Por Vendedor')+nb('canal','Por Canal');

  if(DELDIA_DIAS_ACTUALES.length>1 && deldiaModo==='comparacion'){ drillRenderDiaPivote(listTagged); return; }

  let h='<table class="drill"><thead><tr><th class="l">#</th>';
  if(deldiaDrillNav.nivel==='centro'){ h+='<th class="l">Centro</th>'; }
  else if(deldiaDrillNav.nivel==='canal'){ h+='<th class="l">Canal</th>'; }
  else if(deldiaDrillNav.nivel==='supervisor'){ h+='<th class="l">'+(porCanal?'Canal':'Centro')+'</th><th class="l">Supervisor</th>'; }
  else { h+='<th class="l">'+(porCanal?'Canal':'Centro')+'</th><th class="l">Supervisor</th><th class="l">Vendedor</th>'; }
  h+='<th>Meta ajustada</th>'+(tieneB?'<th>Meta lineal</th>':'')+'<th>Ejecutado</th><th>Alcance del día%</th>'+(tieneB?'<th>Alcance lineal%</th>':'')+'</tr></thead><tbody>';
  let rows, esHoja=false;
  if(deldiaDrillNav.nivel==='centro') rows=deldiaDrillAgg(listTagged,v=>v.CedCodigo,v=>v.CentroNombre);
  else if(deldiaDrillNav.nivel==='canal') rows=deldiaDrillAgg(conCanal(DELDIA_DRILL_DATA),v=>v._canId,v=>nombreCanal(v._canId));
  else if(deldiaDrillNav.nivel==='supervisor') rows=deldiaDrillAgg(listTagged,v=>v.SupCod,v=>v.SupNombre,porCanal?(v=>nombreCanal(v._canId)):(v=>v.CentroNombre));
  else { rows=deldiaDrillAggHoja(listTagged); esHoja=true; }
  const puedeDrill = !esHoja;
  let tA=0,tB=0,tE=0;
  rows.forEach((r,i)=>{
    let cols;
    if(esHoja) cols='<td class="l">'+(porCanal?nombreCanal(r._canId):r.CentroNombre)+'</td><td class="l">'+r.SupNombre+'</td><td class="l">'+r.RepNombre+' ('+r.RepCodigo+')</td>';
    else if(deldiaDrillNav.nivel==='supervisor') cols='<td class="l">'+r.padre+'</td><td class="l">'+r.nombre+'</td>';
    else cols='<td class="l">'+r.nombre+'</td>';
    const pA=r.PresupuestoA||0, pB=(r.tieneB?r.PresupuestoB:null), ej=r.Ejecutado||0;
    const alc=r.AlcancePct, alcLin=r.AlcanceLinealPct;
    let onclickAttr='';
    if(puedeDrill){
      if(deldiaDrillNav.nivel==='centro') onclickAttr='deldiaDrillSetNivel(\'supervisor\',\''+r.k+'\',null,null)';
      else if(deldiaDrillNav.nivel==='canal') onclickAttr='deldiaDrillSetNivel(\'supervisor\',null,null,'+JSON.stringify(r.k)+')';
      else onclickAttr='deldiaDrillDrillSup('+JSON.stringify(r.k)+')';
    }
    h+='<tr onclick="'+onclickAttr+'" class="'+(puedeDrill?'clickable':'')+'"><td class="l">'+(i+1)+'</td>'+cols+
      '<td>'+fmtNum(pA)+'</td>'+(tieneB?'<td>'+fmtNum(pB)+'</td>':'')+'<td>'+fmtNum(ej)+'</td><td>'+fmtPct(alc)+'</td>'+(tieneB?'<td>'+fmtPct(alcLin)+'</td>':'')+'</tr>';
    tA+=pA||0; tB+=pB||0; tE+=ej||0;
  });
  const colspan=esHoja?4:(deldiaDrillNav.nivel==='supervisor'?3:2);
  h+='<tr class="totals"><td class="l" colspan="'+colspan+'">TOTAL</td><td>'+fmtNum(tA)+'</td>'+(tieneB?'<td>'+fmtNum(tB)+'</td>':'')+'<td>'+fmtNum(tE)+'</td><td>'+fmtPct(tA?100*tE/tA:null)+'</td>'+(tieneB?'<td>'+fmtPct(tB?100*tE/tB:null)+'</td>':'')+'</tr>';
  h+='</tbody></table>';
  $('#deldia-drill-tabla').innerHTML=h;
}
// Modo "Comparación": pivote entidad × día (Ejecutado), con columna Total al final —
// pedido explícito del usuario 2026-08-25 (default al elegir varios días/semanas).
function drillRenderDiaPivote(list){
  const dias=DELDIA_DIAS_ACTUALES.slice().sort((a,b)=>a-b);
  const porCanal=deldiaDrillNav.canal!=null;
  let rows, cols, esHoja=false;
  if(deldiaDrillNav.nivel==='centro'){ rows=pivoteAgg(list,v=>v.CedCodigo,v=>v.CentroNombre); cols=['Centro']; }
  else if(deldiaDrillNav.nivel==='canal'){ rows=pivoteAgg(conCanal(DELDIA_DRILL_DATA),v=>v._canId,v=>nombreCanal(v._canId)); cols=['Canal']; }
  else if(deldiaDrillNav.nivel==='supervisor'){ rows=pivoteAgg(list,v=>v.SupCod,v=>v.SupNombre,porCanal?(v=>nombreCanal(v._canId)):(v=>v.CentroNombre)); cols=[porCanal?'Canal':'Centro','Supervisor']; }
  else {
    const g={};
    list.forEach(v=>{
      const k=v.RepCodigo;
      if(!g[k]) g[k]={k,CentroNombre:v.CentroNombre,SupNombre:v.SupNombre,RepNombre:v.RepNombre,RepCodigo:v.RepCodigo,_canId:v._canId,porDia:{}};
      g[k].porDia[v.Dia]=(g[k].porDia[v.Dia]||0)+(v.Ejecutado||0);
    });
    rows=Object.values(g).sort((a,b)=>{
      const ta=Object.values(a.porDia).reduce((x,y)=>x+y,0), tb=Object.values(b.porDia).reduce((x,y)=>x+y,0);
      return tb-ta;
    });
    cols=[porCanal?'Canal':'Centro','Supervisor','Vendedor']; esHoja=true;
  }
  let h='<table class="drill"><thead><tr><th class="l">#</th>'+cols.map(c=>'<th class="l">'+c+'</th>').join('')+
    dias.map(d=>'<th>Día '+d+'</th>').join('')+'<th>Total</th></tr></thead><tbody>';
  const totales=new Array(dias.length).fill(0); let totalGeneral=0;
  rows.forEach((r,i)=>{
    const etiquetas = esHoja ? [(porCanal?nombreCanal(r._canId):r.CentroNombre),r.SupNombre,r.RepNombre+' ('+r.RepCodigo+')'] : (cols.length===2?[r.padre,r.nombre]:[r.nombre]);
    const tds=etiquetas.map(e=>'<td class="l">'+e+'</td>').join('');
    const porDia=dias.map(d=>r.porDia[d]||0);
    porDia.forEach((v,ix)=>totales[ix]+=v);
    const tot=porDia.reduce((a,b)=>a+b,0); totalGeneral+=tot;
    h+='<tr><td class="l">'+(i+1)+'</td>'+tds+porDia.map(v=>'<td>'+fmtNum(v)+'</td>').join('')+'<td><b>'+fmtNum(tot)+'</b></td></tr>';
  });
  h+='<tr class="totals"><td class="l" colspan="'+(1+cols.length)+'">TOTAL</td>'+totales.map(v=>'<td>'+fmtNum(v)+'</td>').join('')+'<td><b>'+fmtNum(totalGeneral)+'</b></td></tr>';
  h+='</tbody></table>';
  $('#deldia-drill-tabla').innerHTML=h;
}
window.deldiaDrillSetNivel=(nivel,ced,sup,canal)=>{
  deldiaDrillNav={nivel:nivel,ced:(ced!==undefined?ced:deldiaDrillNav.ced),sup:(sup!==undefined?sup:deldiaDrillNav.sup),canal:(canal!==undefined?canal:deldiaDrillNav.canal)};
  if(nivel==='centro'){deldiaDrillNav.ced=null;deldiaDrillNav.sup=null;deldiaDrillNav.canal=null;}
  if(nivel==='canal'&&canal===undefined){deldiaDrillNav.canal=null;deldiaDrillNav.sup=null;deldiaDrillNav.ced=null;}
  if(nivel==='supervisor'&&sup===undefined)deldiaDrillNav.sup=null;
  drillRenderDia();
};
window.deldiaDrillDrillSup=(supCod)=>{
  const v=DELDIA_DRILL_DATA.find(x=>x.SupCod===supCod);
  if(deldiaDrillNav.canal!=null) deldiaDrillSetNivel('vendedor', null, supCod, deldiaDrillNav.canal);
  else deldiaDrillSetNivel('vendedor', v?v.CedCodigo:deldiaDrillNav.ced, supCod, null);
};
const diaSemanaCorto={Monday:'Lun',Tuesday:'Mar',Wednesday:'Mié',Thursday:'Jue',Friday:'Vie',Saturday:'Sáb',Sunday:'Dom'};
function renderDelDia(j){
  const dias=j.dias||[];
  const dosMetas = j.etiquetaB != null;
  let h='<table class="drill"><thead><tr><th class="l">Día</th><th class="l">Día sem.</th>'+
    '<th>'+j.etiquetaA+'</th>'+(dosMetas?'<th>'+j.etiquetaB+'</th>':'')+'<th>Ejecutado</th><th>Alcance del día%</th>'+(dosMetas?'<th>Alcance lineal%</th>':'')+'</tr></thead><tbody>';
  let tA=0,tB=0,tE=0;
  dias.forEach(d=>{
    const dom = d.EsDomingo;
    const alDia = d.PresupuestoA!=null && d.PresupuestoA>0 ? 100*d.Ejecutado/d.PresupuestoA : null;
    const alDiaLineal = d.PresupuestoB!=null && d.PresupuestoB>0 ? 100*d.Ejecutado/d.PresupuestoB : null;
    h+='<tr style="'+(dom?'opacity:.45':'')+'"><td class="l">'+d.Dia+'</td><td class="l">'+(diaSemanaCorto[d.DiaSemana]||d.DiaSemana)+'</td>'+
      '<td>'+fmtNum(d.PresupuestoA)+'</td>'+(dosMetas?'<td>'+fmtNum(d.PresupuestoB)+'</td>':'')+
      '<td>'+fmtNum(d.Ejecutado)+'</td><td>'+fmtPct(alDia)+'</td>'+(dosMetas?'<td>'+fmtPct(alDiaLineal)+'</td>':'')+'</tr>';
    tA+=d.PresupuestoA||0; tB+=d.PresupuestoB||0; tE+=d.Ejecutado||0;
  });
  h+='<tr class="totals"><td class="l" colspan="2">TOTAL ('+dias.length+' días)</td><td>'+fmtNum(tA)+'</td>'+(dosMetas?'<td>'+fmtNum(tB)+'</td>':'')+
     '<td>'+fmtNum(tE)+'</td><td>'+fmtPct(tA?100*tE/tA:null)+'</td>'+(dosMetas?'<td>'+fmtPct(tB?100*tE/tB:null)+'</td>':'')+'</tr>';
  h+='</tbody></table>';
  $('#deldia-tabla').innerHTML=h;
}

/* ── Drill-down: Organización (Centro→Supervisor→Vendedor) y Producto (Suplidor→Categoría→Producto) ──
   "familia" ya no la elige el usuario (era "Tipo de Presupuesto") — se infiere de
   Detalle+KPI (ver familiaParaOrg/familiaParaProd), pedido explícito 2026-08-29. */
function cargarDrill(){
  actualizarControlesDetalle();
  if(detalleVista()==='producto') cargarDrillProducto(); else cargarDrillOrganizacion();
}
// ── "Ver Detalle" (pedido 2026-08-29): desde CUALQUIER nivel de "Por Organización"
// (Centro, Supervisor, Vendedor o Canal — lo que sea que drillNav tenga en ese momento),
// saltar en 1 clic a "Por Producto" ya filtrado a esa misma selección — sin backend
// nuevo, drill/producto YA acepta esos mismos filtros de organización. Guarda el estado
// anterior para poder volver exactamente a donde se estaba.
let VOLVER_ORG_ESTADO=null;
function actualizarControlesDetalle(){
  const enProducto = detalleVista()==='producto';
  $('#drill-porcanal-wrap').style.display = enProducto ? 'flex' : 'none';
  const btn=$('#btn-ver-detalle-producto');
  if(!enProducto){
    btn.style.display='inline-block'; btn.textContent='📦 Ver Detalle'; btn.onclick=irADetalleProducto;
  } else if(VOLVER_ORG_ESTADO){
    btn.style.display='inline-block'; btn.textContent='‹ Volver a Organización'; btn.onclick=volverAOrganizacion;
  } else {
    btn.style.display='none';
  }
}
function irADetalleProducto(){
  VOLVER_ORG_ESTADO={
    centro: MS.centro.values(), canal: MS.canal.values(), supervisor: MS.supervisor.values(), vendedor: MS.vendedor.values(),
    suplidor: MS.suplidor.values(), categoria: MS.categoria.values(), producto: MS.producto.values(),
  };
  // Reproduce el "scope" actual de drillNav (Por Organización) como filtro — Canal
  // gana sobre Centro si venimos por esa rama (drillNav.canal!=null marca "por Canal").
  MS.centro.select(drillNav.canal!=null ? [] : (drillNav.ced ? [drillNav.ced] : []));
  MS.canal.select(drillNav.canal!=null ? [String(drillNav.canal)] : []);
  MS.supervisor.select(drillNav.sup ? [drillNav.sup] : []);
  MS.vendedor.select([]);
  MS.suplidor.select([]); MS.categoria.select([]); MS.producto.select([]);
  $('#detalle-vista').value='producto';
  cargarDrill();
}
function volverAOrganizacion(){
  if(!VOLVER_ORG_ESTADO) return;
  const e=VOLVER_ORG_ESTADO; VOLVER_ORG_ESTADO=null;
  MS.centro.select(e.centro); MS.canal.select(e.canal); MS.supervisor.select(e.supervisor); MS.vendedor.select(e.vendedor);
  MS.suplidor.select(e.suplidor); MS.categoria.select(e.categoria); MS.producto.select(e.producto);
  $('#detalle-vista').value='organizacion';
  cargarDrill();
}

let DRILL_ORG_DATA=[]; let drillNav={nivel:'centro',ced:null,sup:null,canal:null};
function drillFmtPct(x){ return x==null?'—':x.toFixed(1)+'%'; }
function cargarDrillOrganizacion(){
  const kpi=detalleKpi(), fam=familiaParaOrg(kpi);
  const p=qsFiltros(); p.set('familia',fam); p.set('kpi',kpi);
  $('#drill-tabla').innerHTML='<div class="hint">Cargando…</div>'; $('#drill-nivelbar').innerHTML=''; $('#drill-crumbs').innerHTML='';
  fetch(BASE+'/apipresupuestos/drill/organizacion?'+p.toString()).then(r=>r.json()).then(j=>{
    if(!j||!j.ok){ $('#drill-tabla').innerHTML='<div class="hint">'+(j&&j.error||'Error')+'</div>'; return; }
    _drillSortCol=null; _drillSortDir=-1;
    DRILL_ORG_DATA=j.filas||[]; drillNav={nivel:'centro',ced:null,sup:null,canal:null}; drillRenderOrg();
  }).catch(err=>{ $('#drill-tabla').innerHTML='<div class="hint">Error: '+err+'</div>'; });
}
// canal se compara con String() -- _canId viene de REPS.CanID (probablemente numérico)
// mientras que el valor que llega por el onclick genérico de drillRenderAgg siempre es
// texto (plantilla compartida con Centro/Supervisor, que sí son códigos de texto).
function drillScope(){
  let d=DRILL_ORG_DATA;
  if(drillNav.canal!=null) d=conCanal(d).filter(v=>String(v._canId)===String(drillNav.canal));
  if(drillNav.ced) d=d.filter(v=>v.CedCodigo===drillNav.ced);
  if(drillNav.sup) d=d.filter(v=>v.SupCod===drillNav.sup);
  return d;
}
function drillAggOrg(list,keyFn,nameFn,parentFn){
  const g={};
  list.forEach(v=>{
    const k=keyFn(v);
    if(!g[k]) g[k]={k,nombre:nameFn(v),padre:parentFn?parentFn(v):'',Presupuesto:0,PresupuestoAlDia:0,Ejecutado:0,VentasProyectadas:0,VentasEstimadas:0,_tieneEst:false,DiasRestantes:v.DiasRestantes};
    g[k].Presupuesto+=v.Presupuesto||0; g[k].PresupuestoAlDia+=v.PresupuestoAlDia||0; g[k].Ejecutado+=v.Ejecutado||0;
    g[k].VentasProyectadas+=v.VentasProyectadas||0;
    if(v.VentasEstimadas!=null){ g[k].VentasEstimadas+=v.VentasEstimadas; g[k]._tieneEst=true; }
  });
  return Object.values(g).map(o=>{
    o.AlcancePct=o.Presupuesto?100*o.Ejecutado/o.Presupuesto:null;
    o.ProyectadoPct=o.Presupuesto?100*o.VentasProyectadas/o.Presupuesto:null;
    // Backend ahora siempre manda una curva (cae a la curva general de la compañía si no
    // hay 1 solo Suplidor/Categoría/Producto elegido) — VentasEstimadas casi nunca es null,
    // pero se deja el chequeo por si el backend algún día vuelve a mandar null explícito.
    if(!o._tieneEst){ o.VentasEstimadas=null; o.EstimadoPct=null; }
    else o.EstimadoPct=o.Presupuesto?100*o.VentasEstimadas/o.Presupuesto:null;
    // Necesidad Diaria (pedido 2026-09-06): NO se puede sumar la de cada vendedor (el
    // backend la manda por RepCodigo, grano de esta lista) porque hay que recalcularla
    // sobre el Presupuesto/Ejecutado YA AGREGADOS de este nivel — DiasRestantes es el
    // MISMO para todas las filas del mismo período (Año/Mes), así que basta con tomarlo
    // de cualquiera de ellas (primera fila del grupo, capturada arriba).
    o.NecesidadDiaria = o.DiasRestantes>0 ? (o.Presupuesto-o.Ejecutado)/o.DiasRestantes : null;
    return o;
  }).sort((a,b)=>b.Presupuesto-a.Presupuesto);
}
// Canal es ahora un árbol completo, paralelo al de Centro: Canal→Supervisor→Vendedor
// (pedido explícito del usuario — antes "Por Canal" era una lista plana sin drill).
// drillNav.canal!=null marca "venimos por la rama Canal" — en ese caso el nivel
// Supervisor se agrupa/filtra por canal en vez de por Centro (ced se mantiene null).
function drillRenderOrg(){
  const list=drillScope();
  const listTagged=conCanal(list);
  const porCanal=drillNav.canal!=null;
  let cr;
  if(porCanal){
    const cn=nombreCanal(drillNav.canal);
    cr='<span class="crumb" onclick="drillSetNivelOrg(\'canal\',null,null,null)">Canales</span>'+
       ' › <span class="crumb '+(drillNav.sup?'':'cur')+'" onclick="drillSetNivelOrg(\'supervisor\',null,null,'+JSON.stringify(drillNav.canal)+')">'+cn+'</span>';
    if(drillNav.sup){ const sn=(DRILL_ORG_DATA.find(v=>v.SupCod===drillNav.sup)||{}).SupNombre||drillNav.sup; cr+=' › <span class="crumb cur">'+sn+'</span>'; }
  } else {
    cr='<span class="crumb '+(drillNav.ced?'':'cur')+'" onclick="drillSetNivelOrg(\'centro\',null,null,null)">Compañía</span>';
    if(drillNav.ced){ const cn=(DRILL_ORG_DATA.find(v=>v.CedCodigo===drillNav.ced)||{}).CentroNombre||drillNav.ced;
      cr+=' › <span class="crumb '+(drillNav.sup?'':'cur')+'" onclick="drillSetNivelOrg(\'supervisor\',\''+drillNav.ced+'\',null,null)">'+cn+'</span>'; }
    if(drillNav.sup){ const sn=(DRILL_ORG_DATA.find(v=>v.SupCod===drillNav.sup)||{}).SupNombre||drillNav.sup; cr+=' › <span class="crumb cur">'+sn+'</span>'; }
  }
  $('#drill-crumbs').innerHTML=cr;
  const nb=(id,t)=>'<button class="btn-modo'+(drillNav.nivel===id?' on':'')+'" onclick="drillSetNivelOrg(\''+id+'\')">'+t+'</button>';
  $('#drill-nivelbar').innerHTML=nb('centro','Por Centro')+nb('supervisor','Por Supervisor')+nb('vendedor','Por Vendedor')+nb('canal','Por Canal');
  if(drillNav.nivel==='centro') drillRenderAgg(drillAggOrg(listTagged,v=>v.CedCodigo,v=>v.CentroNombre),'Centro',[],'Org');
  else if(drillNav.nivel==='canal') drillRenderAgg(drillAggOrg(conCanal(DRILL_ORG_DATA),v=>v._canId,v=>nombreCanal(v._canId)),'Canal',[],'OrgCanal');
  else if(drillNav.nivel==='supervisor'){
    const parentFn=porCanal?(v=>nombreCanal(v._canId)):(v=>v.CentroNombre);
    drillRenderAgg(drillAggOrg(listTagged,v=>v.SupCod,v=>v.SupNombre,parentFn),'Supervisor',[porCanal?'Canal':'Centro'],'Org');
  }
  else drillRenderHoja(listTagged.slice().sort((a,b)=>b.Presupuesto-a.Presupuesto),
    porCanal?['Canal','Supervisor','Vendedor']:['Centro','Supervisor','Vendedor'],
    porCanal?(v=>[nombreCanal(v._canId),v.SupNombre,v.RepNombre+' ('+v.RepCodigo+')']):(v=>[v.CentroNombre,v.SupNombre,v.RepNombre+' ('+v.RepCodigo+')']));
}
window.drillSetNivelOrg=(nivel,ced,sup,canal)=>{
  drillNav={nivel:nivel,ced:(ced!==undefined?ced:drillNav.ced),sup:(sup!==undefined?sup:drillNav.sup),canal:(canal!==undefined?canal:drillNav.canal)};
  if(nivel==='centro'){drillNav.ced=null;drillNav.sup=null;drillNav.canal=null;}
  if(nivel==='canal'&&canal===undefined){drillNav.canal=null;drillNav.sup=null;drillNav.ced=null;}
  if(nivel==='supervisor'&&sup===undefined)drillNav.sup=null;
  drillRenderOrg();
};
window.__drillOrg=(k,tipo)=>{
  if(tipo==='Centro') drillSetNivelOrg('supervisor',k,null,null);
  else {
    const v=DRILL_ORG_DATA.find(x=>x.SupCod===k);
    if(drillNav.canal!=null) drillSetNivelOrg('vendedor',null,k,drillNav.canal);
    else drillSetNivelOrg('vendedor',v?v.CedCodigo:drillNav.ced,k,null);
  }
};
window.__drillOrgCanal=(k)=>{ drillSetNivelOrg('supervisor',null,null,k); };

// modo=null/clickable=false -> fila hoja, sin drill (usado por "Por Canal", nivel plano
// sin sub-niveles). Déficit al Momento = Presupuesto al día − Ejecutado (qué tan atrás
// vas HOY); Déficit Estimado = Presupuesto − Estimado (proyección con curva de
// estacionalidad) — reemplaza al viejo "Déficit Proyectado" (Presupuesto − lineal),
// pedido del usuario 2026-08-28.
/* ── Columnas Presupuesto..Déficit Estimado compartidas entre drillRenderAgg y
   drillRenderHoja, con click-para-ordenar por cualquier columna (pedido del usuario
   2026-08-28) — el header recuerda la última tabla renderizada (_drillLastRender) para
   poder re-ordenar sin re-consultar al backend. */
const DRILL_COLS = [
  {key:'Presupuesto',       label:'Presupuesto',        fmt:'num', get:r=>r.Presupuesto||0},
  // Pedido 2026-08-29: se agregó esta columna porque "Déficit al Momento" NO es
  // Presupuesto-Ejecutado (confusión reportada por el usuario, verificada en vivo
  // contra la BD — el cálculo estaba correcto, solo faltaba mostrar el dato intermedio
  // que lo explica). PresupuestoAlDia = Presupuesto prorrateado según días hábiles
  // transcurridos, con 1 día hábil de margen de rezago (DiasTranscurridosAjustado en
  // PresupuestosCore.cs) para no penalizar por el último día, cuyos datos a veces aún
  // no están completos al momento de consultar.
  {key:'PresupuestoAlDia',  label:'Pres. al día',       fmt:'num', get:r=>r.PresupuestoAlDia||0},
  {key:'Ejecutado',         label:'Ejecutado',          fmt:'num', get:r=>r.Ejecutado||0},
  {key:'AlcancePct',        label:'Alcance%',           fmt:'pct', get:r=>r.AlcancePct},
  {key:'DeficitMomento',    label:'Déficit al Momento', fmt:'num', get:r=>(r.PresupuestoAlDia||0)-(r.Ejecutado||0)},
  {key:'VentasProyectadas', label:'Proyectado',         fmt:'num', get:r=>r.VentasProyectadas||0},
  {key:'ProyectadoPct',     label:'Proy.%',             fmt:'pct', get:r=>r.ProyectadoPct},
  {key:'VentasEstimadas',   label:'Estimado',           fmt:'num', get:r=>r.VentasEstimadas},
  {key:'EstimadoPct',       label:'Est.%',              fmt:'pct', get:r=>r.EstimadoPct},
  {key:'DeficitEstimado',   label:'Déficit Estimado',   fmt:'defEst', get:r=>r.VentasEstimadas==null?null:(r.Presupuesto||0)-r.VentasEstimadas},
  // Necesidad Diaria = (Presupuesto−Ejecutado)/DiasRestantes (pedido explícito del
  // usuario 2026-09-06) — cuánto hace falta vender por CADA día hábil restante del
  // período para llegar exacto al presupuesto. DiasRestantes ya viene ajustado por el
  // mismo rezago de 1 día hábil que usa Pres. al día (ver PresupuestosCore.Calcular) —
  // es el MISMO para todas las filas del mismo período, así que sumar esta columna en
  // el TOTAL (drillColsTotales) da el resultado correcto sin caso especial.
  {key:'NecesidadDiaria',   label:'Necesidad Diaria',   fmt:'defEst', get:r=>r.NecesidadDiaria},
];
let _drillSortCol=null, _drillSortDir=-1, _drillLastRender=null;
function drillFmtCol(c,v){ return c.fmt==='pct' ? drillFmtPct(v) : c.fmt==='defEst' ? (v==null?'—':fmtNum(v)) : fmtNum(v); }
function drillColsTh(){
  return DRILL_COLS.map(c=>{
    const activo=_drillSortCol===c.key, fl=activo?(_drillSortDir===1?' ▲':' ▼'):'';
    return '<th style="cursor:pointer;user-select:none" onclick="drillClickSort(\''+c.key+'\')" title="Ordenar por '+c.label+'">'+c.label+fl+'</th>';
  }).join('');
}
function drillColsTd(r){ return DRILL_COLS.map(c=>'<td>'+drillFmtCol(c,c.get(r))+'</td>').join(''); }
function drillColsTotales(rows){
  let tot={}; DRILL_COLS.forEach(c=>tot[c.key]=0); let algunEst=false;
  rows.forEach(r=>{ DRILL_COLS.forEach(c=>{ const v=c.get(r); if(v!=null) tot[c.key]+=v; }); if(r.VentasEstimadas!=null) algunEst=true; });
  return DRILL_COLS.map(c=>{
    if(c.key==='AlcancePct') return '<td>'+drillFmtPct(tot.Presupuesto?100*tot.Ejecutado/tot.Presupuesto:null)+'</td>';
    if(c.key==='ProyectadoPct') return '<td>'+drillFmtPct(tot.Presupuesto?100*tot.VentasProyectadas/tot.Presupuesto:null)+'</td>';
    if(c.key==='EstimadoPct') return '<td>'+drillFmtPct(algunEst&&tot.Presupuesto?100*tot.VentasEstimadas/tot.Presupuesto:null)+'</td>';
    if(c.key==='VentasEstimadas') return '<td>'+fmtNum(algunEst?tot.VentasEstimadas:null)+'</td>';
    if(c.key==='DeficitEstimado') return '<td>'+(algunEst?fmtNum(tot.Presupuesto-tot.VentasEstimadas):'—')+'</td>';
    return '<td>'+fmtNum(tot[c.key])+'</td>';
  }).join('');
}
window.drillClickSort=(key)=>{
  _drillSortDir = (_drillSortCol===key) ? -_drillSortDir : -1; _drillSortCol=key;
  if(!_drillLastRender) return;
  const c=DRILL_COLS.find(x=>x.key===key);
  const sorted=_drillLastRender.rows.slice().sort((a,b)=>_drillSortDir*((c.get(a)||0)-(c.get(b)||0)));
  if(_drillLastRender.type==='agg') drillRenderAgg(sorted,_drillLastRender.tipo,_drillLastRender.parents,_drillLastRender.modo,_drillLastRender.clickable,true);
  else drillRenderHoja(sorted,_drillLastRender.etiquetas,_drillLastRender.nameFn,true);
};
// r.padre acepta un string (1 columna "padre", uso original) O un array (2+ columnas —
// pedido 2026-08-29: "Desglosar por Canal" en Detalle: Por Producto agrega Canal como
// columna extra junto a Suplidor en el nivel Categoría, por ejemplo).
function drillRenderAgg(rows,tipo,parents,modo,clickable,manteniendoOrden){
  if(clickable===undefined) clickable=true;
  if(!manteniendoOrden) _drillLastRender={type:'agg',rows,tipo,parents,modo,clickable};
  const th=parents.map(p=>'<th class="l">'+p+'</th>').join('');
  let h='<table class="drill"><thead><tr><th class="l">#</th>'+th+'<th class="l">'+tipo+'</th>'+drillColsTh()+'</tr></thead><tbody>';
  rows.forEach((r,i)=>{
    const padreArr=parents.length?(Array.isArray(r.padre)?r.padre:[r.padre]):[];
    const pc=padreArr.map(v=>'<td class="l">'+v+'</td>').join('');
    const attrs=clickable?(' class="clickable" onclick="__drill'+modo+'(\''+r.k+'\',\''+tipo+'\')"'):'';
    h+='<tr'+attrs+'><td class="l">'+(i+1)+'</td>'+pc+'<td class="l">'+r.nombre+'</td>'+drillColsTd(r)+'</tr>';
  });
  h+='<tr class="totals"><td class="l" colspan="'+(2+parents.length)+'">TOTAL</td>'+drillColsTotales(rows)+'</tr>';
  h+='</tbody></table>'; $('#drill-tabla').innerHTML=h;
}
function drillRenderHoja(rows,etiquetas,nameFn,manteniendoOrden){
  if(!manteniendoOrden) _drillLastRender={type:'hoja',rows,etiquetas,nameFn};
  const th=etiquetas.map(e=>'<th class="l">'+e+'</th>').join('');
  let h='<table class="drill"><thead><tr><th class="l">#</th>'+th+drillColsTh()+'</tr></thead><tbody>';
  rows.forEach((v,i)=>{
    const tds0=nameFn(v).map(n=>'<td class="l">'+n+'</td>').join('');
    h+='<tr><td class="l">'+(i+1)+'</td>'+tds0+drillColsTd(v)+'</tr>';
  });
  h+='<tr class="totals"><td class="l" colspan="'+(1+etiquetas.length)+'">TOTAL ('+rows.length+')</td>'+drillColsTotales(rows)+'</tr>';
  h+='</tbody></table>'; $('#drill-tabla').innerHTML=h;
}

/* ── Drill Producto: profundidad variable por familia (ver /apipresupuestos/drill/producto) ──
   "Desglosar por Canal" (checkbox #drill-porcanal, pedido 2026-08-29): la MISMA fila de
   Suplidor/Categoría/Producto aparece 1 vez por cada Canal donde tuvo actividad, cada
   una con su propia porción de Presupuesto/Ejecutado — nunca se combinan. drillNavProd
   guarda "canal" aparte de "sup"/"cat" (no se mete en la misma clave) precisamente para
   que ese comportamiento sea explícito y para no romper las comparaciones String(...)
   de sup/cat ya corregidas arriba. */
let DRILL_PROD_DATA=[]; let drillNavProd={nivel:'suplidor',sup:null,cat:null,canal:null};
function cargarDrillProducto(){
  const kpi=detalleKpi(), fam=familiaParaProd(kpi);
  const p=qsFiltros(); p.set('familia',fam); p.set('kpi',kpi);
  if($('#drill-porcanal').checked) p.set('porCanal','true');
  $('#drill-tabla').innerHTML='<div class="hint">Cargando…</div>'; $('#drill-nivelbar').innerHTML=''; $('#drill-crumbs').innerHTML='';
  fetch(BASE+'/apipresupuestos/drill/producto?'+p.toString()).then(r=>r.json()).then(j=>{
    if(!j||!j.ok){ $('#drill-tabla').innerHTML='<div class="hint">'+(j&&j.error||'Error')+'</div>'; return; }
    _drillSortCol=null; _drillSortDir=-1;
    DRILL_PROD_DATA=j.filas||[]; window.DRILL_NIVELES=j.niveles||1; drillNavProd={nivel: (j.niveles===3?'suplidor':'unico'), sup:null, cat:null, canal:null};
    drillRenderProd();
  }).catch(err=>{ $('#drill-tabla').innerHTML='<div class="hint">Error: '+err+'</div>'; });
}
// String(...) en ambos lados — Cat3ID/Cat1ID/CanID llegan como NÚMERO desde el backend
// (JSON), pero drillNavProd.sup/cat siempre llegan como TEXTO (se arman incrustando la
// clave en el atributo onclick de drillRenderAgg, ver window.__drillProd) — comparar
// 105===\"105\" da false y deja la lista vacía tras cada clic. Bug reportado 2026-08-29:
// "hace el drill pero no trae datos" — mismo patrón ya resuelto para Canal en
// drillScope() (Organización, ver arriba).
function drillScopeProd(){
  let d=DRILL_PROD_DATA;
  if(drillNavProd.sup) d=d.filter(v=>String(v.Cat3ID)===String(drillNavProd.sup));
  if(drillNavProd.cat) d=d.filter(v=>String(v.Cat1ID)===String(drillNavProd.cat));
  if(drillNavProd.canal!=null) d=d.filter(v=>String(v.CanID)===String(drillNavProd.canal));
  return d;
}
function drillRenderProd(){
  const niveles=window.DRILL_NIVELES||1;
  const list=drillScopeProd();
  const porCanal=$('#drill-porcanal').checked;
  if(niveles===1){
    $('#drill-nivelbar').innerHTML=''; $('#drill-crumbs').innerHTML='<span class="crumb cur">Total</span>';
    const etq=porCanal?['Nombre','Canal']:['Nombre'];
    const nfn=porCanal?(v=>[v.Nombre,nombreCanal(v.CanID)]):(v=>[v.Nombre]);
    drillRenderHoja(list.slice().sort((a,b)=>b.Ejecutado-a.Ejecutado),etq,nfn);
    return;
  }
  let cr='<span class="crumb '+(drillNavProd.sup?'':'cur')+'" onclick="drillSetNivelProd(\'suplidor\',null,null,null)">Todos los suplidores</span>';
  if(drillNavProd.sup){ const sn=(DRILL_PROD_DATA.find(v=>String(v.Cat3ID)===String(drillNavProd.sup))||{}).Cat3Nombre||drillNavProd.sup;
    cr+=' › <span class="crumb '+(drillNavProd.cat?'':'cur')+'" onclick="drillSetNivelProd(\'categoria\',\''+drillNavProd.sup+'\',null,'+JSON.stringify(drillNavProd.canal)+')">'+sn+'</span>'; }
  if(drillNavProd.cat){ const cn=(DRILL_PROD_DATA.find(v=>String(v.Cat1ID)===String(drillNavProd.cat))||{}).Cat1Nombre||drillNavProd.cat; cr+=' › <span class="crumb cur">'+cn+'</span>'; }
  if(drillNavProd.canal!=null) cr+=' <span class="sub">· Canal: '+nombreCanal(drillNavProd.canal)+'</span>';
  $('#drill-crumbs').innerHTML=cr;
  const nb=(id,t)=>'<button class="btn-modo'+(drillNavProd.nivel===id?' on':'')+'" onclick="drillSetNivelProd(\''+id+'\')">'+t+'</button>';
  $('#drill-nivelbar').innerHTML=nb('suplidor','Por Suplidor')+nb('categoria','Por Categoría')+nb('producto','Por Producto');
  if(drillNavProd.nivel==='suplidor'){
    if(porCanal) drillRenderAgg(drillAggProd(list,v=>v.Cat3ID+'|'+v.CanID,v=>v.Cat3Nombre,v=>nombreCanal(v.CanID)),'Suplidor',['Canal'],'Prod');
    else drillRenderAgg(drillAggProd(list,v=>v.Cat3ID,v=>v.Cat3Nombre),'Suplidor',[],'Prod');
  } else if(drillNavProd.nivel==='categoria'){
    if(porCanal) drillRenderAgg(drillAggProd(list,v=>v.Cat1ID+'|'+v.CanID,v=>v.Cat1Nombre,v=>[v.Cat3Nombre,nombreCanal(v.CanID)]),'Categoría',['Suplidor','Canal'],'Prod');
    else drillRenderAgg(drillAggProd(list,v=>v.Cat1ID,v=>v.Cat1Nombre,v=>v.Cat3Nombre),'Categoría',['Suplidor'],'Prod');
  } else {
    const etq=porCanal?['Suplidor','Categoría','Producto','Canal']:['Suplidor','Categoría','Producto'];
    const nfn=porCanal?(v=>[v.Cat3Nombre,v.Cat1Nombre,v.Nombre,nombreCanal(v.CanID)]):(v=>[v.Cat3Nombre,v.Cat1Nombre,v.Nombre]);
    drillRenderHoja(list.slice().sort((a,b)=>b.Ejecutado-a.Ejecutado),etq,nfn);
  }
}
function drillAggProd(list,keyFn,nameFn,parentFn){
  const g={};
  list.forEach(v=>{
    const k=keyFn(v);
    if(!g[k]) g[k]={k,nombre:nameFn(v),padre:parentFn?parentFn(v):'',Presupuesto:0,PresupuestoAlDia:0,Ejecutado:0,VentasProyectadas:0,VentasEstimadas:0,_tieneEst:false,DiasRestantes:v.DiasRestantes};
    g[k].Presupuesto+=v.Presupuesto||0; g[k].PresupuestoAlDia+=v.PresupuestoAlDia||0; g[k].Ejecutado+=v.Ejecutado||0;
    g[k].VentasProyectadas+=v.VentasProyectadas||0;
    if(v.VentasEstimadas!=null){ g[k].VentasEstimadas+=v.VentasEstimadas; g[k]._tieneEst=true; }
  });
  return Object.values(g).map(o=>{
    o.AlcancePct=o.Presupuesto?100*o.Ejecutado/o.Presupuesto:null;
    o.ProyectadoPct=o.Presupuesto?100*o.VentasProyectadas/o.Presupuesto:null;
    if(!o._tieneEst){ o.VentasEstimadas=null; o.EstimadoPct=null; }
    else o.EstimadoPct=o.Presupuesto?100*o.VentasEstimadas/o.Presupuesto:null;
    // Necesidad Diaria (pedido 2026-09-06) — mismo motivo que drillAggOrg: se recalcula
    // sobre el Presupuesto/Ejecutado ya agregados de este nivel, no se suma la de cada fila.
    o.NecesidadDiaria = o.DiasRestantes>0 ? (o.Presupuesto-o.Ejecutado)/o.DiasRestantes : null;
    return o;
  }).sort((a,b)=>b.Ejecutado-a.Ejecutado);
}
window.drillSetNivelProd=(nivel,sup,cat,canal)=>{
  drillNavProd={nivel:nivel,sup:(sup!==undefined?sup:drillNavProd.sup),cat:(cat!==undefined?cat:drillNavProd.cat),canal:(canal!==undefined?canal:drillNavProd.canal)};
  if(nivel==='suplidor'){drillNavProd.sup=null;drillNavProd.cat=null;drillNavProd.canal=null;} if(nivel==='categoria'&&cat===undefined)drillNavProd.cat=null;
  drillRenderProd();
};
// Con "Desglosar por Canal" activo, la clave de cada fila (r.k) viene compuesta
// "Cat3ID|CanID" o "Cat1ID|CanID" (ver drillRenderProd) — se separa aquí antes de
// navegar, para que drillNavProd.sup/cat sigan siendo el ID simple de siempre (el canal
// se guarda aparte en drillNavProd.canal) y las comparaciones String(...) de
// drillScopeProd no se rompan.
window.__drillProd=(k,tipo)=>{
  const porCanal=$('#drill-porcanal').checked;
  let idPart=k, canalPart=null;
  if(porCanal){ const partes=String(k).split('|'); idPart=partes[0]; canalPart=partes[1]; }
  if(tipo==='Suplidor') drillSetNivelProd('categoria',idPart,null,canalPart);
  else { const v=DRILL_PROD_DATA.find(x=>String(x.Cat1ID)===String(idPart)); drillSetNivelProd('producto',v?v.Cat3ID:drillNavProd.sup,idPart,canalPart); }
};

/* ── Excel: mismo patrón que el resto de la app (SheetJS, 100% client-side) ── */
function ensureXLSX(cb){
  if(typeof XLSX!=='undefined'){ cb(); return; }
  const s=document.createElement('script'); s.src=BASE+'/lib/xlsx.full.min.js';
  s.onload=()=>cb(); s.onerror=()=>alert('No se pudo cargar el generador de Excel.');
  document.head.appendChild(s);
}
function exportarKpisAoA(entorno){
  const rows=[['Familia','KPI','Presupuesto','Presupuesto al día','Ejecutado','Alcance%','Déficit al Momento','Proyectado','Proyectado%','Estimado','Estimado%','Déficit Estimado']];
  Object.keys(entorno||{}).forEach(fam=>{
    Object.keys(entorno[fam]||{}).forEach(k=>{
      const r=entorno[fam][k]; if(!r) return;
      rows.push([familiaTexto2[fam]||fam, kpiTexto[k]||k, r.Presupuesto, r.PresupuestoAlDia, r.Ejecutado, r.AlcancePct,
        (r.PresupuestoAlDia||0)-(r.Ejecutado||0), r.VentasProyectadas, r.ProyectadoPct, r.VentasEstimadas, r.EstimadoPct,
        r.VentasEstimadas==null?null:(r.Presupuesto||0)-r.VentasEstimadas]);
    });
  });
  return rows;
}
$('#btn-excel').addEventListener('click', ()=>{
  const tab=document.querySelector('#tabs button.on').dataset.tab;
  ensureXLSX(()=>{
    const wb=XLSX.utils.book_new();
    const anio=anioEfectivo(), mes=mesEfectivo();
    if(tab==='mes'||tab==='anio'){
      if(!LAST_RESUMEN){ alert('Presiona Consultar primero.'); return; }
      // "Del Mes" — 1 sheet con una columna "Período" al frente (una fila de LAST_RESUMEN
      // por cada Año×Mes elegido; con 1 sola combinación se ve igual que antes).
      const rowsMes=[['Período','Familia','KPI','Presupuesto','Presupuesto al día','Ejecutado','Alcance%','Déficit al Momento','Proyectado','Proyectado%','Estimado','Estimado%','Déficit Estimado']];
      LAST_RESUMEN.forEach(r=>{
        const periodoTxt=MESES_NOMBRE[r.periodo.mes]+' '+r.periodo.anio;
        exportarKpisAoA(r.j.entornos.mes).slice(1).forEach(fila=>rowsMes.push([periodoTxt,...fila]));
      });
      XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(rowsMes),'Del Mes');
      const drillActual = detalleVista()==='producto' ? DRILL_PROD_DATA : DRILL_ORG_DATA;
      if(drillActual.length){
        const rowsDrill=[Object.keys(drillActual[0])].concat(drillActual.map(r=>Object.values(r)));
        XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(rowsDrill),'Detalle');
      }
      // "Del Año" — tabla mes a mes (Año, Mes, Familia, KPI, mismas columnas que Del Mes),
      // 1 fila de LAST_DELANIO por cada Año elegido en el filtro.
      if(LAST_DELANIO && LAST_DELANIO.length){
        const rowsAnio=[['Año','Mes','Familia','KPI','Presupuesto','Presupuesto al día','Ejecutado','Alcance%','Déficit al Momento','Proyectado','Proyectado%','Estimado','Estimado%','Déficit Estimado']];
        LAST_DELANIO.forEach(({anio:anioFila,j})=>{
          const detalle=j.entornos.detalle||{};
          Object.keys(detalle).forEach(fam=>Object.keys(detalle[fam]||{}).forEach(k=>{
            (detalle[fam][k]||[]).forEach(r=>rowsAnio.push([anioFila, MESES_CORTO[r.Mes], familiaTexto2[fam]||fam, kpiTexto[k]||k,
              r.Presupuesto, r.PresupuestoAlDia, r.Ejecutado, r.AlcancePct, (r.PresupuestoAlDia||0)-(r.Ejecutado||0),
              r.VentasProyectadas, r.ProyectadoPct, r.VentasEstimadas, r.EstimadoPct,
              r.VentasEstimadas==null?null:(r.Presupuesto||0)-r.VentasEstimadas]));
          }));
        });
        XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(rowsAnio),'Del Año');
      }
    } else if(tab==='historico'){
      if(!LAST_HISTORICO){ alert('Presiona Consultar primero.'); return; }
      const porAnio={};
      (LAST_HISTORICO.serie||[]).forEach(s=>{ (porAnio[s.Anio]=porAnio[s.Anio]||{})[s.Mes]=s.Ejecutado; });
      const rows=[['Año'].concat(MESES_CORTO.slice(1)).concat(['Total'])];
      Object.keys(porAnio).sort().forEach(a=>{
        const fila=[a]; let tot=0;
        for(let m=1;m<=12;m++){ const v=porAnio[a][m]||0; tot+=v; fila.push(v); }
        fila.push(tot); rows.push(fila);
      });
      XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(rows),'Historico');
    } else if(tab==='extras'){
      if(!LAST_EXTRAS){ alert('Presiona Consultar primero.'); return; }
      const rows=[['Métrica','Valor'],
        ['Devoluciones (presupuesto)',LAST_EXTRAS.devolucionesPresupuesto],['Devoluciones (ejecutado)',LAST_EXTRAS.devolucionesEjecutado],
        ['Meta Gerencial',LAST_EXTRAS.metaGerencial],
        ['Efectividad de Visitas — meta',LAST_EXTRAS.efectividadPresupuesto],['Efectividad de Visitas — logro',LAST_EXTRAS.efectividadEjecutado],
        ['Retención 2 meses (clientes)',LAST_EXTRAS.retencion2Meses]];
      XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(rows),'Extras');
    } else { alert('La pestaña Del Día se exporta desde su propia tabla — usa Ctrl+C o pídeme que lo agregue si lo necesitas.'); return; }
    XLSX.writeFile(wb,'presupuestos_'+anio+'-'+String(mes).padStart(2,'0')+'.xlsx');
  });
});

