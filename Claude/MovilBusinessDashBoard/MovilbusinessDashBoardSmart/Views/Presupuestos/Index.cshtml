      ['Meta Gerencial (sin seguimiento)',fmtNum(j.metaGerencial),'var(--muted)'],
      ['Efectividad de Visitas — meta',fmtNum(j.efectividadPresupuesto),'var(--azul)'],
      ['Efectividad de Visitas — logro',fmtNum(j.efectividadEjecutado),'var(--verde)'],
      ['Retención 2 meses (clientes)',fmtNum(j.retencion2Meses),'var(--verde)'],
