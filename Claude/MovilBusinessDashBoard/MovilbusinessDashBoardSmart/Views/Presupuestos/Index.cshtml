@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Presupuestos &mdash; @ViewBag.EmpNombre</title>
<style>
:root{
  --bg:#F7F9F7;--panel:#FFFFFF;--panel2:#F0F4F0;--border:#D9E2D9;--line:#E6ECE6;
  --text:#1F2A22;--muted:#5C6B5F;
  --verde:#388848;--verde-fuerte:#207830;--azul:#283078;
  --good:#2E9E4A;--warn:#D29922;--bad:#C0392B;
  --good-bg:#EAF7EE;--warn-bg:#FBF3DA;--bad-bg:#FBEAEA;
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:'Segoe UI',Tahoma,sans-serif;font-variant-numeric:tabular-nums;line-height:1.5}
.wrap{max-width:1280px;margin:0 auto;padding:16px 16px 60px}
a{color:var(--azul)}
.top{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;margin-bottom:14px}
.brand{display:flex;gap:12px;align-items:center}
.brand img{height:40px;width:auto;border-radius:8px;object-fit:contain;background:#fff;border:1px solid var(--border)}
.title{font-size:22px;font-weight:800;letter-spacing:-.02em;color:var(--verde-fuerte)}
.sub{font-size:12px;color:var(--muted)}
.top .btn,.btn-out{background:var(--panel);border:1px solid var(--border);color:var(--muted);border-radius:7px;padding:7px 13px;font-size:12px;text-decoration:none;cursor:pointer}
.btn-out:hover{border-color:var(--verde);color:var(--verde)}
.who{font-size:12px;color:var(--muted)}
.seg{display:inline-flex;background:var(--panel2);border:1px solid var(--border);border-radius:12px;padding:4px;gap:2px;flex-wrap:wrap;margin-bottom:14px}
.seg button{border:0;background:transparent;color:var(--muted);font:inherit;font-weight:600;font-size:13px;padding:8px 13px;border-radius:9px;cursor:pointer}
.seg button.on{background:var(--panel);color:var(--verde-fuerte);box-shadow:0 1px 3px rgba(0,0,0,.08)}
.view{display:none}.view.on{display:block}
.panel{background:var(--panel);border:1px solid var(--border);border-radius:13px}
.hint{font-size:12px;color:var(--muted);padding:18px;text-align:center}
.filtros{padding:14px 16px;margin-bottom:14px;display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end}
.filtros .pd{display:flex;flex-direction:column;gap:3px;font-size:11px;color:var(--muted)}
.filtros .fl-label{font-size:11px;color:var(--muted);line-height:1.4}
.filtros select{background:var(--panel);border:1px solid var(--border);border-radius:7px;padding:7px 8px;font-size:12px;color:var(--text);height:34px}
.ms{position:relative;min-width:150px}
/* Semana/Día tienen pocas opciones (1-5 y 1-31) — no necesitan el mismo ancho que
   Vendedor/Producto/etc. Pedido del usuario 2026-08-28, para dejar sitio a las
   pestañas Del Día/Mes/Año/Histórico/Extras en la misma línea. */
.pd.mini .ms{min-width:70px}
.ms-btn{background:var(--panel);border:1px solid var(--border);border-radius:7px;padding:7px 10px;font-size:12px;cursor:pointer;display:flex;justify-content:space-between;gap:8px;align-items:center;height:34px;box-sizing:border-box}
.ms-btn .cnt{background:var(--verde);color:#fff;border-radius:10px;padding:0 7px;font-size:11px}
.ms-pop{display:none;position:absolute;top:105%;left:0;z-index:30;background:var(--panel);border:1px solid var(--border);border-radius:8px;width:240px;max-height:280px;overflow:auto;box-shadow:0 8px 24px rgba(0,0,0,.15);padding:6px}
.ms-pop.open{display:block}
.ms-search{width:100%;background:var(--panel2);border:1px solid var(--border);color:var(--text);border-radius:6px;padding:6px;font-size:12px;margin-bottom:5px}
.ms-head{display:flex;justify-content:space-between;padding:2px 4px 6px}
.ms-link{font-size:11px;color:var(--azul);cursor:pointer}
.ms-opt{display:flex;align-items:center;gap:7px;padding:5px 6px;border-radius:5px;cursor:pointer}
.ms-opt:hover{background:var(--panel2)}
.btn-go{background:var(--verde);color:#fff;border:0;border-radius:7px;padding:8px 16px;font-size:13px;font-weight:700;cursor:pointer;align-self:flex-end;height:34px;box-sizing:border-box}
.btn-go:hover{background:var(--verde-fuerte)}
/* Tarjetas "días del mes/transcurridos/restantes/incidencia" (pedido 2026-09-06) —
   mismas 4, repetidas en KPI/Gráficos/Detalle (los 3 entornos comparten un solo período
   Año/Mes, así que el mismo cálculo aplica a los 3 por igual). */
.dias-cards{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:14px;grid-column:1/-1}
.dia-card{background:var(--panel2);border:1px solid var(--border);border-radius:8px;padding:8px 16px;min-width:120px}
.dia-card-lbl{font-size:11px;color:var(--muted);white-space:nowrap}
.dia-card-val{font-size:19px;font-weight:800;color:var(--text)}
.fam-block{margin-bottom:18px}
.fam-title{font-size:14px;font-weight:800;color:var(--verde-fuerte);padding:14px 16px 4px}
table.kpis{width:100%;border-collapse:collapse;font-size:12.5px}
table.kpis th{background:var(--panel2);color:var(--muted);text-align:right;padding:8px 10px;font-weight:700;border-bottom:1px solid var(--border)}
table.kpis th:first-child,table.kpis td:first-child{text-align:left}
table.kpis td{padding:8px 10px;border-bottom:1px solid var(--line);text-align:right}
table.kpis tr:last-child td{border-bottom:0}
.pct{font-weight:700;border-radius:6px;padding:2px 7px;display:inline-block}
.pct.good{background:var(--good-bg);color:var(--good)}
.pct.warn{background:var(--warn-bg);color:var(--warn)}
.pct.bad{background:var(--bad-bg);color:var(--bad)}
.pct.na{color:var(--muted)}
.crumbs{margin:4px 0 10px;font-size:13px}
.crumb{color:var(--azul);cursor:pointer}
.crumb.cur{color:var(--text);font-weight:700;cursor:default}
.btn-modo{background:var(--panel2);border:1px solid var(--border);color:var(--muted);border-radius:7px;padding:6px 12px;font-size:12px;cursor:pointer;margin-right:4px}
.btn-modo.on{background:var(--verde);border-color:var(--verde);color:#fff}
table.drill{width:100%;border-collapse:collapse;font-size:12.5px}
table.drill th{background:var(--panel2);color:var(--muted);text-align:right;padding:8px 10px;font-weight:700;border-bottom:1px solid var(--border)}
table.drill th.l,table.drill td.l{text-align:left}
table.drill td{padding:8px 10px;border-bottom:1px solid var(--line);text-align:right}
table.drill tbody tr.clickable{cursor:pointer}
table.drill tbody tr.clickable:hover{background:var(--panel2)}
table.drill tr.totals td{border-top:2px solid var(--border);font-weight:800;background:var(--panel2)}
/* Encabezados congelados + columnas ordenables (aplica a TODAS las tablas .drill/.kpis) */
table.drill thead th,table.kpis thead th{position:sticky;top:0;z-index:2;cursor:pointer;user-select:none}
table.drill thead th:hover,table.kpis thead th:hover{color:var(--verde-fuerte)}
table.drill thead th.sorted-asc::after{content:' \25B2';font-size:9px}
table.drill thead th.sorted-desc::after{content:' \25BC';font-size:9px}
table.kpis thead th.sorted-asc::after{content:' \25B2';font-size:9px}
table.kpis thead th.sorted-desc::after{content:' \25BC';font-size:9px}
.pie-filtros{font-size:11px;color:var(--muted);padding:6px 4px 16px;text-align:right}
.drill-head{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:10px}
.drill-head b{color:var(--verde-fuerte)}
.periodo-titulo{font-weight:800;color:var(--verde-fuerte);padding:4px 0 8px;font-size:13px}
/* ── Mosaico "Dashboard Gráficos" — 1 tarjeta = 1 gráfico compacto (pedido 2026-08-28,
   rediseñado 2026-08-29 con tarjetas "bullet" left-aligned + drill + tabla) ── */
/* 2 tarjetas por fila (antes cabían 3+ con auto-fit/340px) — pedido 2026-08-29: menos
   tarjetas por fila = más ancho cada una = más espacio para el nombre/la descripción. */
.graf-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
@@media (max-width:820px){.graf-grid{grid-template-columns:1fr}}
.graf-card{background:var(--panel);border:1px solid var(--border);border-radius:13px;padding:14px 16px;overflow-x:auto}
.graf-card canvas{max-height:260px}
.graf-card.full{grid-column:1/-1}
.graf-card .sub{font-weight:400}
.graf-card+.graf-card{margin-top:14px}
/* "Detalle por Recurso" (2ª hoja) — combo de columnas + línea de Logro%, con TODOS los
   recursos (no solo Top 10, pedido explícito) -> ancho proporcional a la cantidad y
   scroll horizontal dentro de la tarjeta en vez de amontonar las barras. */
.graf-scroll-x{overflow-x:auto}
.crumb.chico{font-size:11px;font-weight:400}
/* Tarjeta "bullet": nombre SIEMPRE alineado a la izquierda (pedido explícito), barra
   completa = Presupuesto (100% de la fila), con 2 rellenos superpuestos: Proyectado
   (claro, de fondo) y Ejecutado al momento (oscuro, coloreado según Alcance%). */
.bullet-list{display:flex;flex-direction:column;gap:7px}
.bullet-row{display:grid;grid-template-columns:minmax(90px,150px) 1fr 54px;gap:8px;align-items:center;font-size:12px}
.bullet-row.clickable{cursor:pointer}
.bullet-row.clickable:hover .bullet-name{color:var(--verde-fuerte);text-decoration:underline}
.bullet-name{text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bullet-track{position:relative;height:15px;background:var(--panel2);border-radius:4px;overflow:hidden;border:1px solid var(--border)}
.bullet-fill-proy{position:absolute;top:0;left:0;bottom:0;background:#A9C4E8}
.bullet-fill-ej{position:absolute;top:0;left:0;bottom:0}
.bullet-pct{text-align:right;font-weight:700;font-size:11.5px}
table.mini-tabla{width:100%;border-collapse:collapse;font-size:11px;margin-top:10px}
table.mini-tabla th{background:var(--panel2);color:var(--muted);text-align:right;padding:4px 6px;font-weight:700;border-bottom:1px solid var(--border)}
table.mini-tabla th.l,table.mini-tabla td.l{text-align:left}
/* Nombre truncado con "…" (no desbordar la tarjeta ni partir la fila en 2 líneas) —
   mismo max-width que .bullet-name arriba, para que ambos corten en el mismo punto.
   El texto completo queda accesible vía title="" (tooltip nativo), no se pierde. */
table.mini-tabla td.l{max-width:150px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
table.mini-tabla td{padding:4px 6px;border-bottom:1px solid var(--line);text-align:right}
table.mini-tabla tr:last-child td{border-bottom:0}
</style>
</head>
<body>
<div class="wrap">

  <div class="top">
    <div class="brand">
      <img src="@(Context.Request.PathBase)/api/logo" alt="Logo" onerror="this.style.display='none'">
      <div>
        <div class="title">Presupuestos</div>
        <div class="sub" id="emp-nombre">@ViewBag.EmpNombre</div>
      </div>
    </div>
    <div class="who">
      <span id="user-nombre"></span>
      &nbsp;·&nbsp;
      <button class="btn-out" id="btn-excel" style="cursor:pointer">⬇ Excel</button>
      <button class="btn-out" id="btn-pdf" style="cursor:pointer">📄 PDF</button>
      <a href="@(Context.Request.PathBase)/menu" class="btn-out">&larr; Menú</a>
    </div>
  </div>

  <!-- Fila superior con 3 grupos (Año/Mes/Semana/Día · KPI/Gráficos · pestañas) —
       "KPI Presupuestos/Dashboard Gráficos" reubicado aquí, CENTRADO, pedido explícito
       2026-08-29 ("para que todo suba un poco") — antes vivía en su propia fila entre
       el panel de filtros detallado y el contenido, ocupando una fila completa aparte.
       flex:1 en los 2 grupos de los extremos (mismo ancho "elástico" cada uno) es lo que
       centra de verdad el grupo del medio, sin importar que Año/Mes/Semana/Día pese más
       que las pestañas de la derecha. -->
  <div class="panel filtros" style="margin-bottom:10px">
    <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;flex:1 1 0;min-width:0">
      <div class="pd mini"><span class="fl-label">Año</span><div id="ms-anio"></div></div>
      <div class="pd mini"><span class="fl-label">Mes</span><div id="ms-mes"></div></div>
      <div class="pd mini"><span class="fl-label">Semana</span><div id="ms-semana"></div></div>
      <div class="pd mini"><span class="fl-label">Día</span><div id="ms-dia"></div></div>
    </div>
    <div class="seg" id="modo-seg" style="margin-bottom:0;flex:0 0 auto">
      <button class="on" id="btn-modo-kpi">📋 KPI Presupuestos</button>
      <button id="btn-modo-graficos">📊 Dashboard Gráficos</button>
    </div>
    <div style="display:flex;justify-content:flex-end;flex:1 1 0;min-width:0">
      <div class="seg" id="tabs" style="margin-bottom:0">
        <button data-tab="dia">Del Día</button>
        <button class="on" data-tab="mes">Del Mes</button>
        <button data-tab="anio">Del Año</button>
        <button data-tab="historico">Histórico</button>
        <button data-tab="extras">Extras</button>
      </div>
    </div>
  </div>
  <!-- Panel de filtros detallado — reubicado ARRIBA del contenido (KPI o Gráficos),
       pedido explícito 2026-08-29: "los filtros deben estar arriba, no debajo". Antes
       vivía debajo del mosaico de Dashboard Gráficos; ahora es el mismo panel para
       ambos modos y siempre precede al contenido que filtra. -->
  <div style="display:flex;justify-content:flex-end;margin-bottom:4px">
    <button class="btn-modo" id="btn-toggle-filtros">▲ Ocultar filtros</button>
  </div>
  <div class="panel filtros" id="panel-filtros">
    <div class="pd"><span class="fl-label">Centro</span><div id="ms-centro"></div></div>
    <div class="pd"><span class="fl-label">Canal</span><div id="ms-canal"></div></div>
    <div class="pd"><span class="fl-label">División</span><div id="ms-division"></div></div>
    <div class="pd"><span class="fl-label">Supervisor</span><div id="ms-supervisor"></div></div>
    <div class="pd"><span class="fl-label">Vendedor</span><div id="ms-vendedor"></div></div>
    <div class="pd"><span class="fl-label">Suplidor</span><div id="ms-suplidor"></div></div>
    <div class="pd"><span class="fl-label">Categoría</span><div id="ms-categoria"></div></div>
    <div class="pd"><span class="fl-label">Producto</span><div id="ms-producto"></div></div>
    <div class="pd"><span class="fl-label">Detalle</span><select id="detalle-vista">
      <option value="organizacion" selected>Organización (Centro, Supervisor, Vendedor)</option>
      <option value="producto">Producto (Suplidor, Categoría, Producto)</option>
    </select></div>
    <div class="pd"><span class="fl-label">KPI</span><select id="detalle-kpi">
      <option value="dinero">Dinero</option>
      <option value="unidades">Cajas</option>
      <option value="facturas">Facturas</option>
      <option value="activaciones" selected>Activación</option>
    </select></div>
    <!-- Solo tiene sentido en modo "Dashboard Gráficos" (decide Resumen/Detalle por
         Recurso ahí) — oculto en modo "KPI Presupuestos", ver setModo(). Pedido
         explícito 2026-08-29: junto al resto de los filtros de "tipo de consulta"
         (Detalle/KPI arriba), en vez de vivir dentro de la vista de Gráficos. -->
    <div class="pd" id="graf-hoja-wrap" style="display:none"><span class="fl-label">Vista Gráficos</span><div class="seg" id="graf-hoja-seg" style="margin-bottom:0">
      <button class="on" data-hoja="resumen">Resumen</button>
      <button data-hoja="detalle">Detalle</button>
    </div></div>
    <div class="pd" style="position:relative;margin-left:auto">
      <span class="fl-label">&nbsp;</span>
      <button class="btn-out" id="btn-patron" type="button" title="Patrón histórico de 4 franjas del mes (últimos 6 meses cerrados) para el Suplidor/Categoría/Canal filtrado — el mismo patrón que usa &quot;Estimado&quot;">ⓘ Patrón</button>
      <div class="ms-pop" id="patron-pop" style="width:280px;padding:10px 12px;right:0;left:auto"></div>
    </div>
    <button class="btn-go" id="btn-consultar">Consultar</button>
  </div>

  <div class="panel" id="view-graficos" style="display:none;padding:14px 16px;margin-bottom:14px">
    <div class="drill-head" style="margin-bottom:14px">
      <span class="sub">Cada tarjeta: barra completa = Presupuesto (100%) · relleno oscuro = Ejecutado al momento · relleno claro = Proyectado · Detalle, KPI y Vista se eligen arriba, en el panel de filtros</span>
    </div>
    <div id="graficos-contenido" class="graf-grid"><div class="hint">Elige tus filtros y presiona Consultar.</div></div>
    <!-- El esqueleto interno (Por Centro/Canal/Suplidor + #cadena-centro/canal/suplidor)
         YA NO va aquí fijo — lo arma renderHojaDetalle() cada vez que corre (ver JS).
         Bug encontrado en vivo 2026-08-29 (con Puppeteer, tras "sigue sin cargar"): el
         mensaje "Cargando…" de cargarGraficos() reemplazaba TODO este innerHTML, borrando
         los #cadena-X de los que dependía renderCadenaCentro/Canal/Suplidor — como esos
         div ya no existían, cada función hacía "if(!cont) return" en silencio (sin
         error) y la pantalla se quedaba en "Cargando…" para siempre, aun con los datos
         ya cargados. Ahora el esqueleto se reconstruye solo, en cada render, así nunca
         depende de qué haya quedado del render anterior. -->
    <div id="graficos-detalle-contenido" style="display:none"><div class="hint">Elige tus filtros y presiona Consultar.</div></div>
  </div>

  <div class="view" id="view-dia">
    <div class="panel" style="padding:14px 16px">
      <div class="drill-head">
        <b>Del Día</b>
        <select id="deldia-familia"></select>
        <select id="deldia-kpi"></select>
      </div>
      <div id="deldia-tabla"><div class="hint">Elige familia/KPI y presiona Consultar (solo Categoría y Suplidor tienen historial diario).</div></div>
      <div id="deldia-drill-wrap" style="display:none;margin-top:14px">
        <div class="drill-head"><b id="deldia-drill-titulo">Detalle del día</b></div>
        <div class="seg" id="deldia-vista-seg" style="margin-bottom:8px">
          <button class="on" data-v="org">Por Organización</button>
          <button data-v="prod" id="deldia-vista-prod-btn">Por Categoría</button>
        </div>
        <div class="seg" id="deldia-modo-seg" style="margin-bottom:8px;display:none">
          <button class="on" data-m="comparacion">Comparación</button>
          <button data-m="total">Total sumado</button>
        </div>
        <div id="deldia-vista-org">
          <div id="deldia-drill-nivelbar" style="margin-bottom:8px"></div>
          <div class="crumbs" id="deldia-drill-crumbs"></div>
          <div id="deldia-drill-tabla"></div>
        </div>
        <div id="deldia-vista-prod" style="display:none">
          <div class="crumbs" id="deldia-drill-prod-crumbs"></div>
          <div id="deldia-drill-prod-tabla"></div>
        </div>
      </div>
    </div>
  </div>
  <div class="view on" id="view-mes">
    <div id="kpis-mes"><div class="panel"><div class="hint">Elige tus filtros y presiona Consultar.</div></div></div>
    <div class="panel" style="margin-top:14px;padding:14px 16px">
      <div class="drill-head">
        <b>Detalle</b>
        <label id="drill-porcanal-wrap" style="display:none;align-items:center;gap:5px;font-size:12px;color:var(--muted);cursor:pointer">
          <input type="checkbox" id="drill-porcanal"> Desglosar por Canal
        </label>
        <span class="sub">Se agrupa según "Detalle" y "KPI" del panel de filtros de arriba</span>
      </div>
      <div id="drill-nivelbar" style="margin-bottom:8px"></div>
      <div class="crumbs" id="drill-crumbs"></div>
      <button class="btn-modo" id="btn-ver-detalle-producto" style="display:none;margin-bottom:8px"></button>
      <div id="drill-tabla"><div class="hint">Presiona Consultar arriba para cargar el detalle.</div></div>
    </div>
  </div>
  <div class="view" id="view-anio">
    <div id="kpis-anio"><div class="panel"><div class="hint">Elige tus filtros y presiona Consultar.</div></div></div>
  </div>
  <div class="view" id="view-historico">
    <div class="panel" style="padding:14px 16px">
      <div class="drill-head">
        <b>Histórico — solo ejecución (sin proyección)</b>
        <label class="pd" style="flex-direction:row;align-items:center;gap:4px">Desde <select id="hist-anioIni"></select></label>
        <label class="pd" style="flex-direction:row;align-items:center;gap:4px">Hasta <select id="hist-anioFin"></select></label>
        <select id="hist-familia"></select>
        <select id="hist-kpi"></select>
      </div>
      <div id="hist-tabla"><div class="hint">Presiona Consultar arriba para cargar el histórico.</div></div>
    </div>
  </div>
  <div class="view" id="view-extras">
    <div class="panel" style="padding:14px 16px">
      <div class="fam-title" style="padding:0 0 10px">Extras</div>
      <div id="extras-cards"><div class="hint">Presiona Consultar arriba para cargar.</div></div>
    </div>
  </div>

</div>

<script>
const BASE = '@Context.Request.PathBase.Value';
const $ = s=>document.querySelector(s);

/* ── Multiselect (copiado de Views/Torre/Index.cshtml) ── */
// singleWhen: función opcional -> true si, en este momento, el control debe
// comportarse como selección única (marcar 1 desmarca los demás) — pedido
// 2026-08-29 para Suplidor/Categoría cuando el KPI (Activación/Facturas) exige
// acotar a UN solo Suplidor o UNA sola Categoría en la vista por Organización.
function multiselect(host,label,opts,onChange,singleWhen){
  const wrap=document.createElement('div');wrap.className='ms';const btn=document.createElement('div');btn.className='ms-btn';
  const txt=document.createElement('span');txt.textContent=label;const cnt=document.createElement('span');cnt.className='cnt';cnt.style.display='none';
  btn.append(txt,cnt);const pop=document.createElement('div');pop.className='ms-pop';
  const search=document.createElement('input');search.className='ms-search';search.placeholder='Buscar...';
  const head=document.createElement('div');head.className='ms-head';const all=document.createElement('span');all.className='ms-link';all.textContent='✓ Todos';const non=document.createElement('span');non.className='ms-link';non.textContent='✕ Ninguno';head.append(all,non);
  const list=document.createElement('div');pop.append(search,head,list);wrap.append(btn,pop);host.appendChild(wrap);
  let options=opts.slice(),selected=new Set();
  const vis=()=>{const q=(search.value||'').toLowerCase();return options.filter(o=>o.t.toLowerCase().includes(q));};
  all.onclick=e=>{e.stopPropagation();
    if(singleWhen&&singleWhen()){ const v=vis(); selected=new Set(v.length?[v[0].v]:[]); }
    else vis().forEach(o=>selected.add(o.v));
    render();sync();onChange&&onChange();};
  non.onclick=e=>{e.stopPropagation();vis().forEach(o=>selected.delete(o.v));render();sync();onChange&&onChange();};
  function render(){list.innerHTML='';vis().forEach(o=>{const row=document.createElement('label');row.className='ms-opt';const cb=document.createElement('input');cb.type='checkbox';cb.checked=selected.has(o.v);
    cb.onchange=()=>{
      if(cb.checked){ if(singleWhen&&singleWhen()){ selected=new Set([o.v]); render(); } else selected.add(o.v); }
      else selected.delete(o.v);
      sync();onChange&&onChange();
    };
    const sp=document.createElement('span');sp.textContent=o.t;row.append(cb,sp);list.appendChild(row);});}
  function sync(){const n=selected.size;cnt.style.display=n?'inline-block':'none';cnt.textContent=n;}
  btn.onclick=e=>{e.stopPropagation();document.querySelectorAll('.ms-pop.open').forEach(p=>{if(p!==pop)p.classList.remove('open');});pop.classList.toggle('open');if(pop.classList.contains('open')){search.value='';render();search.focus();}};
  search.oninput=render;pop.onclick=e=>e.stopPropagation();render();sync();
  return {
    values:()=>[...selected],
    setOptions:(n)=>{options=n.slice();selected=new Set([...selected].filter(v=>options.some(o=>o.v===v)));render();sync();},
    select:(vals)=>{selected=new Set(vals);render();sync();},
  };
}
document.addEventListener('click',()=>document.querySelectorAll('.ms-pop.open').forEach(p=>p.classList.remove('open')));

