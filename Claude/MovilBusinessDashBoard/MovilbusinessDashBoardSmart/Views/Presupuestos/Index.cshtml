/* ── Filtros ── */
const MS = {};
const MESES_NOMBRE=['','Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
let REPS = [];
let FAMILIAS = [];
let CANALES_NOMBRE = new Map();
let SUPLIDORES_NOMBRE = new Map();
let CATEGORIAS_NOMBRE = new Map();
let PRODUCTOS_NOMBRE = new Map();
function dependReps(){
  const cen=new Set(MS.centro.values());
  const rc=cen.size?REPS.filter(r=>cen.has(r.CedCodigo)):REPS;
  MS.supervisor.setOptions([...new Map(rc.filter(r=>r.SupervisorCod).map(r=>[r.SupervisorCod,r.SupervisorNombre])).entries()].map(([v,t])=>({v,t})));
  const sup=new Set(MS.supervisor.values());
  const rs=sup.size?rc.filter(r=>sup.has(r.SupervisorCod)):rc;
  MS.vendedor.setOptions(rs.map(r=>({v:r.RepCodigo,t:r.RepCodigo+' - '+r.RepNombre})));
}

/* Cascada Suplidor→Categoría→Producto, mismo patrón que dependReps() — pero anclada
   a PRODUCTOS_CASCADA (solo lo que tiene dato real) en vez del catálogo maestro completo. */
let PRODUCTOS_CASCADA=[], SUPLIDORES_FULL=[], CATEGORIAS_FULL=[], PRODUCTOS_FULL=[];
function dependProductos(){
  const sup=new Set(MS.suplidor.values());
  if(sup.size){
    const rc=PRODUCTOS_CASCADA.filter(p=>sup.has(String(p.Cat3ID)));
    MS.categoria.setOptions([...new Map(rc.filter(p=>p.Cat1ID).map(p=>[String(p.Cat1ID),p.Cat1Nombre])).entries()].map(([v,t])=>({v,t})));
  } else {
    MS.categoria.setOptions(CATEGORIAS_FULL);
  }
  const cat=new Set(MS.categoria.values());
  let rs=PRODUCTOS_CASCADA;
  if(sup.size) rs=rs.filter(p=>sup.has(String(p.Cat3ID)));
  if(cat.size) rs=rs.filter(p=>cat.has(String(p.Cat1ID)));
  MS.producto.setOptions((sup.size||cat.size) ? rs.map(p=>({v:String(p.ProID),t:p.Nombre})) : PRODUCTOS_FULL);
}
fetch(BASE+'/apipresupuestos/filtros').then(r=>r.json()).then(j=>{
  if(!j||!j.ok){ alert('No se pudieron cargar los filtros: '+(j&&j.error||'error desconocido')); return; }
  REPS = j.representantes||[];
  const centros=[...new Map(REPS.filter(r=>r.CedCodigo).map(r=>[r.CedCodigo,r.CentroNombre])).entries()].map(([v,t])=>({v,t}));
  const divis=[...new Set(REPS.map(r=>r.Division).filter(Boolean))].sort().map(v=>({v,t:'División '+v}));
  MS.centro = multiselect($('#ms-centro'),'Centro',centros,dependReps);
  const canalesOpts=(j.canales||[]).map(c=>({v:c.v,t:c.t}));
  CANALES_NOMBRE = new Map(canalesOpts.map(c=>[c.v,c.t]));
  MS.canal = multiselect($('#ms-canal'),'Canal',canalesOpts);
  MS.division = multiselect($('#ms-division'),'División',divis);
  MS.supervisor = multiselect($('#ms-supervisor'),'Supervisor',[],dependReps);
  MS.vendedor = multiselect($('#ms-vendedor'),'Vendedor',[]);
  SUPLIDORES_FULL=j.suplidores||[]; CATEGORIAS_FULL=j.categorias||[]; PRODUCTOS_FULL=j.productos||[];
  PRODUCTOS_CASCADA=j.productosCascada||[];
  SUPLIDORES_NOMBRE = new Map(SUPLIDORES_FULL.map(s=>[s.v,s.t]));
  CATEGORIAS_NOMBRE = new Map(CATEGORIAS_FULL.map(c=>[c.v,c.t]));
  PRODUCTOS_NOMBRE = new Map(PRODUCTOS_FULL.map(p=>[p.v,p.t]));
  // Suplidor/Categoría se fuerzan a selección única (marcar 1 desmarca los demás)
  // cuando la vista es "Organización" y el KPI es Activación/Facturas — pedido
  // explícito 2026-08-29: ahí solo tiene sentido acotar a UN suplidor o UNA
  // categoría a la vez (ver familiaParaOrg/familiaParaProd más abajo).
  const singleWhenOrgKpiDim = ()=> detalleVista()==='organizacion' && (detalleKpi()==='activaciones' || detalleKpi()==='facturas');
  MS.suplidor = multiselect($('#ms-suplidor'),'Suplidor',SUPLIDORES_FULL,dependProductos,singleWhenOrgKpiDim);
  MS.categoria = multiselect($('#ms-categoria'),'Categoría',CATEGORIAS_FULL,dependProductos,singleWhenOrgKpiDim);
  MS.producto = multiselect($('#ms-producto'),'Producto',PRODUCTOS_FULL);
  MS.semana = multiselect($('#ms-semana'),'Semana',[1,2,3,4,5].map(n=>({v:String(n),t:String(n)})),dependDias);
  MS.dia = multiselect($('#ms-dia'),'Día',[],()=>cargarDelDia());
  // Año y Mes ahora son multiselección (pedido 2026-08-28) — "Del Mes" muestra un bloque
  // por cada combinación Año×Mes elegida; "Del Día" y demás vistas de un solo período
  // usan siempre la PRIMERA combinación (ver anioEfectivo()/mesEfectivo()).
  MS.mes = multiselect($('#ms-mes'),'Mes',MESES_NOMBRE.slice(1).map((t,i)=>({v:String(i+1),t})), actualizarDiasDelMes);
  MS.anio = multiselect($('#ms-anio'),'Año',(j.anios||[]).map(a=>({v:String(a),t:String(a)})), actualizarDiasDelMes);
  dependReps();
  // Canal por defecto: todos MENOS Institucional (7000) — pedido explícito del usuario.
  MS.canal.select(canalesOpts.filter(c=>c.v!=='7000').map(c=>c.v));
  FAMILIAS = j.familias||[];
  deldiaPoblarSelectores();
  histPoblarSelectores();
  const hoy=new Date();
  MS.anio.select([String(j.anios&&j.anios.includes(hoy.getFullYear()) ? hoy.getFullYear() : (j.anios&&j.anios.length?j.anios[j.anios.length-1]:hoy.getFullYear()))]);
  MS.mes.select([String(hoy.getMonth()+1)]);
  actualizarDiasDelMes(false); // false = no disparar cargarDelDia todavía (nada se carga al abrir)
  $('#detalle-vista').addEventListener('change', enforceSingleFiltros);
  $('#detalle-vista').addEventListener('change', actualizarControlesDetalle);
  $('#detalle-kpi').addEventListener('change', enforceSingleFiltros);
  // "Desglosar por Canal" cambia un parámetro de la consulta (porCanal) — hace falta
  // volver a pedir los datos, no basta con re-renderizar del lado del cliente.
  $('#drill-porcanal').addEventListener('change', ()=>{ if(detalleVista()==='producto') cargarDrillProducto(); });
  // Nada se consulta al abrir la página (pedido explícito 2026-08-29) — todo espera a
  // que el usuario presione "Consultar" (ver btn-consultar más abajo).
  setInterval(refrescarDelDiaAuto, 2*60*1000); // refresco cada 2 min de "Del Día", solo tiene efecto una vez que ya se consultó; preserva drill/vista en pantalla
}).catch(err=>alert('Error cargando filtros: '+err));

// Semana N = días (N-1)*7+1 .. N*7 (Semana 5 = lo que sobre del mes, 29/30/31).
function semanaDeDia(d){ return Math.min(5, Math.ceil(d/7)); }

// Año/Mes son multiselección, pero "Del Día" y cualquier otra vista de un solo período
// (drill, Del Día, PDF, etc.) necesitan UNA sola combinación — se usa siempre la PRIMERA
// (más antigua) de las elegidas. "Del Mes" es la única vista que realmente itera sobre
// TODAS las combinaciones elegidas (ver periodosSeleccionados()).
function anioEfectivo(){ const v=MS.anio.values().map(Number).sort((a,b)=>a-b); return v.length?v[0]:new Date().getFullYear(); }
function mesEfectivo(){ const v=MS.mes.values().map(Number).sort((a,b)=>a-b); return v.length?v[0]:new Date().getMonth()+1; }
// Todas las combinaciones Año×Mes elegidas, ordenadas cronológicamente — usadas por
// "Del Mes" (un bloque por combinación) y "Del Año" (una fila por Año-Mes).
function periodosSeleccionados(){
  const anios=MS.anio.values().map(Number).sort((a,b)=>a-b);
  const meses=MS.mes.values().map(Number).sort((a,b)=>a-b);
  const a2=anios.length?anios:[anioEfectivo()], m2=meses.length?meses:[mesEfectivo()];
  return a2.flatMap(anio=>m2.map(mes=>({anio,mes})));
}

// Repuebla las opciones de Día (1..díasDelMes del Año/Mes elegidos), acotadas a las
// Semanas elegidas si hay alguna — cascada Semana→Día, pedida por el usuario
// 2026-08-25 (multi-selección de días/semanas, con comparación o suma).
let DIA_OPCIONES_ACTUALES=[];
function dependDias(){
  const anio=anioEfectivo(), mes=mesEfectivo();
  const diasEnMes=new Date(anio,mes,0).getDate();
  const semanas=new Set(MS.semana.values());
  const opts=[];
  for(let d=1;d<=diasEnMes;d++){
    if(semanas.size && !semanas.has(String(semanaDeDia(d)))) continue;
    opts.push({v:String(d),t:String(d)});
  }
  DIA_OPCIONES_ACTUALES=opts.map(o=>o.v);
  MS.dia.setOptions(opts);
  cargarDelDia();
}
// Reinicia Semana/Día al cambiar Año/Mes (evita mezclar números de semana/día que no
// existen o significan otra cosa en el mes nuevo) y preselecciona hoy si aplica.
// disparar=false (solo usado en la carga inicial de la página) evita el cargarDelDia()
// automático — pedido 2026-08-29: "no corramos nada al abrir".
function actualizarDiasDelMes(disparar){
  if(disparar===undefined) disparar=true;
  const anio=anioEfectivo(), mes=mesEfectivo();
  MS.semana.select([]);
  const diasEnMes=new Date(anio,mes,0).getDate();
  const opts=[]; for(let d=1;d<=diasEnMes;d++) opts.push({v:String(d),t:String(d)});
  DIA_OPCIONES_ACTUALES=opts.map(o=>o.v);
  MS.dia.setOptions(opts);
  const hoy=new Date();
  MS.dia.select(anio===hoy.getFullYear() && mes===hoy.getMonth()+1 ? [String(hoy.getDate())] : []);
  if(disparar) cargarDelDia();
}
// Días efectivos a consultar: los elegidos explícitamente en el multiselect de Día;
// si no hay ninguno pero sí Semana(s), todos los días de esas semanas; si tampoco,
// "" (Todos — se muestra la tabla del mes completo, no el drill diario).
function diasEfectivos(){
  const sel=MS.dia.values();
  if(sel.length) return sel.slice().sort((a,b)=>a-b).join(',');
  if(MS.semana.values().length) return DIA_OPCIONES_ACTUALES.join(',');
  return '';
}

/* ── Consultar /resumen y render de KPIs ── */
// "unidades" se muestra como "Cajas" — pedido explícito del usuario 2026-08-28: el
// presupuesto/ejecutado de unidades se revisa en Cajas, no en unidades sueltas (el
// backend ya convierte con Productos.ProUnidades antes de llegar aquí).
const kpiTexto = {dinero:'Dinero',unidades:'Cajas',facturas:'Facturas',activaciones:'Activaciones'};
const familiaTexto2 = {general:'General',categoria:'Categoría',suplidor:'Suplidor',producto:'Producto',grupoproducto:'Grupo de Producto'};
function fmtNum(x){ return x==null?'—':Number(x).toLocaleString('es-DO',{maximumFractionDigits:0}); }
function fmtPct(x){
  if(x==null) return '<span class="pct na">—</span>';
  const cls = x>=90?'good':(x>=75?'warn':'bad');
  return `<span class="pct ${cls}">${x.toFixed(1)}%</span>`;
}
// ── Detalle (Organización/Producto) + KPI: 1 solo par de controles compartido
// (panel de filtros de arriba), pedido explícito 2026-08-29 — reemplaza los que antes
// vivían por separado en "Detalle" (Del Mes) y en el lente de "Dashboard Gráficos".
// Reemplazan también a "Tipo de Presupuesto" (General/Categoría/Suplidor/Producto):
// la "familia" que el backend necesita ahora se infiere sola, sin pedírsela al usuario.
function detalleVista(){ return $('#detalle-vista').value; }
function detalleKpi(){ return $('#detalle-kpi').value; }
// Si el usuario deja 2+ Suplidores/Categorías marcados y luego cambia a una
// combinación que exige selección única, se recorta a la primera de inmediato.
function enforceSingleFiltros(){
  if(!(detalleVista()==='organizacion' && (detalleKpi()==='activaciones' || detalleKpi()==='facturas'))) return;
  const s=MS.suplidor.values(); if(s.length>1) MS.suplidor.select([s[0]]);
  const c=MS.categoria.values(); if(c.length>1) MS.categoria.select([c[0]]);
}
// Familia efectiva para drill/organizacion (Centro→Supervisor→Vendedor→Canal):
//  - Facturas solo existe a nivel de Categoría (backend) -> familia=categoria siempre.
//  - Activación: verificado en vivo contra la BD (ago-2026) que NO se puede escalar
//    desde Producto como las demás — UNDDACTPROD agregado por Categoría da 96,596
//    mientras que UNDDLINACT (nativo de Categoría) da 58,271 — son la MISMA métrica
//    contada de 2 formas distintas que NO reconcilian (a diferencia de Dinero/Cajas,
//    donde MNTDPROD/Unddprod escalados SÍ igualan exacto a MNTDCAT/MNTDCAT3VEN/UNDDLIN/
//    UNDDCAT3VEN). Además UNDDACTCAT3 (nativo de Suplidor) tiene Ejecutado=0 SIEMPRE en
//    2026 (presupuesto cargado, ejecución nunca poblada por TI) — inutilizable. Por eso:
//      - sin filtro, o filtrando solo por Categoría -> familia=categoria (UNDDLINACT,
//        nativo, el número "oficial" según el usuario: "el pretipo de activación del
//        mes es UnddlinACT"). "General" = compañía completa vía UNDDLINACT sin filtrar.
//      - filtrando por Suplidor o por Producto -> familia=producto (UNDDACTPROD), única
//        fuente con Ejecutado real a esa granularidad — el total ya NO va a coincidir
//        con el de "sin filtro" (son PreTipo distintos), caveat inherente a los datos,
//        no a este código — pendiente para TI: revisar por qué Producto y Categoría no
//        reconcilian en Activaciones, y por qué UNDDACTCAT3 no tiene ejecución cargada.
//  - Dinero/Cajas: "general" (nativo, más preciso) mientras no haya filtro de producto;
//    en cuanto se filtra por Suplidor/Categoría/Producto, familia=producto para que ese
//    filtro tenga efecto (ver ResolverFuenteProducto en el backend — Suplidor/Categoría/
//    Producto se filtran los 3 a la vez, cualquiera de las 3 familias da el mismo dato,
//    SÍ verificado reconciliando exacto contra MNTDCAT/MNTDCAT3VEN/UNDDLIN/UNDDCAT3VEN).
function familiaParaOrg(kpi){
  if(kpi==='facturas') return 'categoria';
  if(kpi==='activaciones'){
    const haySuplidorOProducto = MS.suplidor.values().length>0 || MS.producto.values().length>0;
    return haySuplidorOProducto ? 'producto' : 'categoria';
  }
  const hayFiltroProducto = MS.suplidor.values().length>0 || MS.categoria.values().length>0 || MS.producto.values().length>0;
  return hayFiltroProducto ? 'producto' : 'general';
}
// Misma familia que usan las tarjetas KPI (Resumen) — 1 sola combinación, la que esté
// filtrada, pedido explícito 2026-08-29 ("solo debe haber una sola consulta desplegada").
function familiaResumen(kpi){
  return detalleVista()==='producto' ? familiaParaProd(kpi) : familiaParaOrg(kpi);
}
// Familia efectiva para drill/producto (Suplidor→Categoría→Producto): esta vista SIEMPRE
// necesita el desglose a nivel de Producto para poder pivotar Suplidor/Categoría/Producto
// (UNDDLINACT, nativo de Categoría, no tiene esa granularidad) — así que Activación
// (y Dinero/Cajas) usan familia=producto aquí SIEMPRE, aunque su total ya no coincida
// con el de "Por Organización" (ver nota de familiaParaOrg — caveat de los datos, no de
// este código). Facturas solo existe a nivel Categoría (backend cae a 1 nivel ahí).
function familiaParaProd(kpi){
  return kpi==='facturas' ? 'categoria' : 'producto';
}
function qsFiltros(){
  const p=new URLSearchParams();
  p.set('anio',anioEfectivo()); p.set('mes',mesEfectivo());
  if(MS.centro.values().length) p.set('centros',MS.centro.values().join(','));
  if(MS.canal.values().length) p.set('canales',MS.canal.values().join(','));
  if(MS.division.values().length) p.set('divisiones',MS.division.values().join(','));
  if(MS.supervisor.values().length) p.set('supervisores',MS.supervisor.values().join(','));
  if(MS.vendedor.values().length) p.set('vendedores',MS.vendedor.values().join(','));
  if(MS.suplidor.values().length) p.set('suplidor',MS.suplidor.values().join(','));
  if(MS.categoria.values().length) p.set('categoria',MS.categoria.values().join(','));
  if(MS.producto.values().length) p.set('producto',MS.producto.values().join(','));
  return p;
}
// "ⓘ Patrón": muestra el patrón de 4 franjas del mes (1-7/8-16/17-22/23-cierre) que
// alimenta "Estimado" para el Suplidor/Categoría/Canal vigente en el filtro — pedido
// explícito del usuario 2026-09-05 ("quiero ver el patrón, no solo el número final").
// Reusa la clase .ms-pop (mismo popover que los multiselect) para heredar el cierre al
// hacer clic afuera, ya conectado a nivel de documento más abajo.
$('#btn-patron').addEventListener('click', e=>{
  e.stopPropagation();
  const pop=$('#patron-pop');
  const abrir=!pop.classList.contains('open');
  document.querySelectorAll('.ms-pop.open').forEach(p=>{ if(p!==pop) p.classList.remove('open'); });
  pop.classList.toggle('open', abrir);
  if(!abrir) return;
  pop.innerHTML='<div class="hint">Cargando…</div>';
  const p=new URLSearchParams();
  p.set('anio',anioEfectivo()); p.set('mes',mesEfectivo());
  if(MS.suplidor.values().length) p.set('suplidor',MS.suplidor.values().join(','));
  if(MS.categoria.values().length) p.set('categoria',MS.categoria.values().join(','));
  if(MS.canal.values().length) p.set('canales',MS.canal.values().join(','));
  fetch(BASE+'/apipresupuestos/patron-franjas?'+p.toString()).then(r=>r.json()).then(j=>{
    if(!j||!j.ok){ pop.innerHTML='<div class="hint">'+(j&&j.error||'Error')+'</div>'; return; }
    if(!j.mesesConDatos){ pop.innerHTML='<div class="hint">Sin historial suficiente (0 de los últimos 6 meses cerrados con datos) para esta combinación.</div>'; return; }
    let h='<div style="font-size:11px;color:var(--muted);margin-bottom:6px">Patrón histórico — promedio de '+j.mesesConDatos+' de los últimos 6 meses cerrados</div>';
    h+='<table style="width:100%;font-size:12px"><tbody>';
    j.franjas.forEach(f=>{ h+='<tr><td style="text-align:left">'+f.rango+'</td><td style="text-align:right;font-weight:600">'+f.pct.toFixed(1)+'%</td></tr>'; });
    h+='</tbody></table>';
    pop.innerHTML=h;
  }).catch(err=>{ pop.innerHTML='<div class="hint">Error: '+err+'</div>'; });
});
// Tarjetas "días del mes/transcurridos/restantes/incidencia" (pedido 2026-09-06) — se
// arman a partir de CUALQUIER KpiResultado ya traído (todos comparten el mismo Año/Mes
// de la consulta, así que DiasDelPeriodo/DiasTranscurridosAjustado son iguales entre
// ellos). primerKpiValido busca el primero no-nulo dentro de un "entorno" anidado
// {familia:{kpi:KpiResultado}}, tal como lo devuelve /apipresupuestos/resumen.
function primerKpiValido(entorno){
  for(const fam of Object.keys(entorno||{})){
    for(const k of Object.keys(entorno[fam]||{})){
      if(entorno[fam][k]) return entorno[fam][k];
    }
  }
  return null;
}
function diaCard(lbl,val){ return '<div class="dia-card"><div class="dia-card-lbl">'+lbl+'</div><div class="dia-card-val">'+val+'</div></div>'; }
// "asumirAyer" (pedido del usuario 2026-09-25): bajo operación normal, la fecha de última
// actualización de PresupuestosHistoricos (Ultima) SIEMPRE debería quedar "ayer" — el
// proceso de TI corre de noche reflejando la facturación de un día antes. Si ese proceso
// no corrió anoche y se corrió hoy (catch-up manual/tardío), Ultima queda "hoy" en vez de
// "ayer", e infla "Días transcurridos"/"Días restantes" en 1 día hábil de más — ver
// DiasTranscurridosAjustado en Services/PresupuestosCore.cs. No hay forma de que el
// backend distinga por sí solo "corrió normal" de "corrió tarde hoy mismo" (ambos casos
// dejan Ultima con una fecha válida) — así que se avisa cuando Ultima=hoy (el patrón
// atípico que describió el usuario) y se deja que la persona confirme si aplica el ajuste,
// en vez de adivinarlo automáticamente.
let ASUMIR_AYER=false;
document.addEventListener('change', e=>{
  if(e.target && e.target.classList && e.target.classList.contains('chk-asumir-ayer')){
    ASUMIR_AYER=e.target.checked;
    cargarResumen();
  }
});
function ultimaActualizacionHtml(ultimaIso){
  if(!ultimaIso) return '';
  const u=new Date(ultimaIso), hoy=new Date();
  const mismoDia = u.getFullYear()===hoy.getFullYear() && u.getMonth()===hoy.getMonth() && u.getDate()===hoy.getDate();
  const fechaTxt=u.toLocaleDateString('es-DO',{day:'2-digit',month:'2-digit',year:'numeric'});
  if(!mismoDia) return '<div class="hint" style="margin:2px 0 8px">Última actualización de datos: '+fechaTxt+'</div>';
  return '<div style="margin:4px 0 10px;padding:8px 10px;border-radius:8px;background:#fff3cd;border:1px solid #ffe08a;font-size:12.5px;color:#7a5b00">'
    +'⚠ Última actualización de datos: <b>hoy ('+fechaTxt+')</b> — esto es inusual (normalmente refleja el día anterior). '
    +'Si el proceso nocturno de anoche no corrió y se corrió hoy en su lugar, "Días transcurridos"/"Días restantes" pueden estar sobreestimados en 1 día. '
    +'<label style="margin-left:4px;cursor:pointer;font-weight:600;white-space:nowrap"><input type="checkbox" class="chk-asumir-ayer"'+(ASUMIR_AYER?' checked':'')+' style="vertical-align:middle;margin-right:4px">Recalcular asumiendo ayer</label>'
    +'</div>';
}
function cardsDiasHtml(r){
  if(!r || !r.DiasDelPeriodo) return '';
  const dm=r.DiasDelPeriodo, dt=r.DiasTranscurridosAjustado, dr=r.DiasRestantes;
  const inc = dm>0 ? (100*dt/dm) : 0;
  return '<div class="dias-cards">'
    + diaCard('Días del mes', dm)
    + diaCard('Días transcurridos', dt)
    + diaCard('Días restantes', dr)
    + diaCard('Incidencia', inc.toFixed(1)+'%')
    + '</div>'
    + ultimaActualizacionHtml(r.Ultima);
}
function renderKpisEn(host, entorno){
  const familias=Object.keys(entorno||{});
