    '<div class="card"><div class="cl">Oportunidad Perdida Valor</div><div class="cv" style="color:#f85149">RD$'+fmtMM(j.valorPerdido)+'</div><div class="ch">dropsize de RD$'+Math.round(j.dropSizeVal||0).toLocaleString('es-DO')+' · '+j.dropSizeUni+' u</div></div>'+
    '<div class="card wide"><div class="cl">Top 3 tamaños con más pérdida (RD$ · u · %)</div><div class="top3">'+tam+'</div></div>'+
    '<div class="card wide"><div class="cl">Top 3 Vendedores (clientes y monto perdido)</div><div class="top3">'+vend+'</div></div>';
  $('#legend').style.display='block';
  $('#legend').innerHTML='<div class="lt">Tamaño de cliente'+(useHouse?'':' (puntos)')+'</div>'+
    legendTamano(lost)+(j.clientes.some(c=>c.Compra)?lg('#3fb950','Sí le vendieron'):'');
}

/* ═══════════════════════════════════════════════════════════════════════════
   VISTA — VISITAS DEL DÍA (P4, 2026-10-17)
   Casitas = clientes programados ese día; puntos = visitas realizadas (verde = efectiva, amarillo = sin pedido). La casita
   cambia de color según la hora elegida en la línea de tiempo: roja = aún no visitada, verde = visitada en su lugar,
   azul = visitada fuera de su lugar. Play recorre las visitas en orden cronológico (Lento / Medio / Rápido).
   ═══════════════════════════════════════════════════════════════════════════ */
const VT = { data:null, seq:[], idx:-1, t:420, tmin:420, tmax:1140, playing:false, timer:null, speed:'lento', houses:new Map(), layerD:null };
const VT_VEL = { lento:500, medio:130, rapido:30 };   // ms por visita (el día completo de un supervisor ≈ 3 min en lento, ≈ 45 s en medio, ≈ 10 s en rápido)
const VT_COL = { rojo:'#dc2626', verde:'#1f8b4c', azul:'#2563eb' };
function vtEsc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function vtHM(min,conSeg){ const h=Math.floor(min/60), m=Math.floor(min%60), s=Math.floor(((min*60)%60)); const ap=h>=12?'PM':'AM'; const h12=((h+11)%12)+1;
  return h12+':'+String(m).padStart(2,'0')+(conSeg?':'+String(s).padStart(2,'0'):'')+' '+ap; }
function vtHouse(color){
  const svg='<svg width="26" height="26" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 3 L21 11 H18 V20 H14 V14 H10 V20 H6 V11 H3 Z" fill="'+color+'" stroke="#0d1117" stroke-width="1.2"/></svg>';
  return L.divIcon({className:'marker-lbl',html:svg,iconSize:[26,26],iconAnchor:[13,22],popupAnchor:[0,-18]});
}
function vtDot(color){ return L.divIcon({className:'marker-lbl',html:'<div class="vt-dot" style="background:'+color+'"></div>',iconSize:[14,14],iconAnchor:[7,7]}); }

function buildFiltersVisitas(){
  const f=$('#filters'); f.innerHTML='';
  f.append(lblEl('Fecha:')); V.vtFecha=dateInput(); f.append(V.vtFecha);
  buildRepFilters(f);
  f.append(lblEl('Fuera de lugar (m):')); const pdv=document.createElement('input'); pdv.type='number'; pdv.value='200'; pdv.min='20'; pdv.max='5000'; V.vtPdv=pdv; f.append(pdv);
  const btn=document.createElement('button'); btn.className='btn-ref'; btn.textContent='Generar'; btn.onclick=loadVisitas;
  const clr=document.createElement('button'); clr.className='btn-clear'; clr.textContent='Limpiar'; clr.onclick=()=>{ V.centro.clear();V.sup.clear();V.ven.clear(); refreshDependents(); };
  const fs=document.createElement('button'); fs.className='btn-clear'; fs.textContent='⛶ Ocultar filtros (mapa completo)'; fs.title='Oculta menú y filtros y deja el mapa a pantalla completa'; fs.onclick=()=>vtFS(true);
  f.append(btn,clr,fs);
  refreshDependents();
}
function vtFS(on){ document.body.classList.toggle('vt-fs',on); setTimeout(()=>map.invalidateSize(),220); }
function vtLeave(){ vtStop(); document.body.classList.remove('vt-fs'); $('#vt-bar').style.display='none'; if(VT.layerD){ map.removeLayer(VT.layerD); VT.layerD=null; } }

function loadVisitas(){
  vtStop(); hideSoon();
  if(!V.centro.values().length&&!V.sup.values().length&&!V.ven.values().length && !confirm('Sin filtros se cargará TODA la compañía (miles de puntos). ¿Continuar? Se recomienda elegir un supervisor o un vendedor.')) return;
  showOverlay(true);
  const p=new URLSearchParams(); p.set('fecha',V.vtFecha.value); p.set('pdvMetros',V.vtPdv.value||'200');
  if(V.centro.values().length) p.set('centros',V.centro.values().join(','));
  if(V.sup.values().length)    p.set('supervisores',V.sup.values().join(','));
  if(V.ven.values().length)    p.set('reps',V.ven.values().join(','));
  fetch(BASE+'/apigeo/visitas-dia?'+p.toString()).then(r=>r.json()).then(j=>{
    showOverlay(false);
    if(!j||!j.ok){ alert('Error: '+(j&&j.error||'desconocido')); return; }
    VT.data=j; renderVisitas(j);
  }).catch(e=>{ showOverlay(false); alert('Error de conexion: '+e); });
}

function renderVisitas(j){
  vtStop(); clearMap(); if(VT.layerD){ map.removeLayer(VT.layerD); }
  VT.layerD=L.layerGroup().addTo(map); VT.houses=new Map();
  const prog=j.programados||[], vis=j.visitas||[], pts=[];
  const progKeys=new Set(prog.map(p=>p.rep+'|'+p.cli));
  // casitas (todas arrancan en rojo = «aún no visitada»)
  prog.forEach(p=>{
    if(p.lat==null||p.lon==null) return;
    const m=L.marker([p.lat,p.lon],{icon:vtHouse(VT_COL.rojo)});
    m.bindTooltip('<b>'+vtEsc(p.nombre)+'</b><br><span style="color:#5c6b5f">'+vtEsc(p.repNombre)+' · cliente '+p.cli+'</span><br><span class="vt-st">No visitado</span>',{direction:'top',offset:[0,-14]});
    m.addTo(layer); VT.houses.set(p.rep+'|'+p.cli,{m,p,estado:'rojo'}); pts.push([p.lat,p.lon]);
  });
  // puntos de visitas (se muestran / ocultan según la hora)
  vis.forEach(v=>{
    v.key=v.rep+'|'+v.cli; v.enRuta=progKeys.has(v.key);
    const lat=v.lat!=null?v.lat:v.cliLat, lon=v.lon!=null?v.lon:v.cliLon; v._m=null; if(lat==null||lon==null) return;
    const m=L.marker([lat,lon],{icon:vtDot(v.efectiva?'#2e9e4a':'#e3b341'),zIndexOffset:1000});
    m.bindTooltip(vtTip(v),{direction:'top',offset:[0,-8]}); v._m=m; pts.push([lat,lon]);
  });
  // línea de tiempo: 7:00 AM – 7:00 PM (se amplía solo si hay visitas fuera de ese rango)
  const mins=vis.map(v=>v.minuto);
  VT.tmin=Math.min(420,mins.length?Math.floor(Math.min(...mins)/60)*60:420); VT.tmax=Math.max(1140,mins.length?Math.ceil(Math.max(...mins)/60)*60:1140);
  VT.seq=[...new Set(vis.map(v=>Math.floor(v.minuto)))].sort((a,b)=>a-b); VT.idx=-1;
  const rg=$('#vt-range'); rg.min=VT.tmin; rg.max=VT.tmax; rg.step=1;
  const ticks=[]; for(let m=VT.tmin;m<=VT.tmax;m+=60){ const h=m/60, ap=h>=12?'PM':'AM'; ticks.push('<span>'+(((h+11)%12)+1)+(ap==='AM'?'a':'p')+'</span>'); } $('#vt-ticks').innerHTML=ticks.join('');
  $('#vt-bar').style.display='block'; map.invalidateSize();
  // se encuadra por las CASITAS (clientes programados): las visitas virtuales pueden estar GPS-marcadas muy lejos y alejarían el mapa
  const ptsCasas=[...VT.houses.values()].map(h=>[h.p.lat,h.p.lon]); fitTo(ptsCasas.length?ptsCasas:pts);
  $('#legend').style.display='block';
  $('#legend').innerHTML='<div class="lt">Casitas (clientes programados)</div>'+lg(VT_COL.rojo,'No visitado (a la hora elegida)')+lg(VT_COL.verde,'Visitado en su lugar')+lg(VT_COL.azul,'Visitado fuera de su lugar (&gt; '+j.pdvMetros+' m)')
    +'<div class="lt" style="margin-top:6px">Puntos (visitas)</div>'+lg('#2e9e4a','Visita efectiva (con pedido)')+lg('#e3b341','Visita sin pedido');
  if(j.sinGps) $('#warns').innerHTML='<div class="warn blue">'+j.sinGps+' cliente(s) programado(s) sin GPS: cuentan en las tarjetas pero no aparecen en el mapa</div>'; else $('#warns').innerHTML='';
  // arranca en la primera visita, en velocidad lenta, para ver cómo van entrando las visitas
  VT.speed='lento'; vtPaintSpeed(); vtSet(VT.tmin);
  if(VT.seq.length) vtPlay(); else $('#vt-lbl').textContent='Sin visitas registradas ese día';
}
function vtTip(v){
  const h=v.hora.slice(11,19).split(':').map(Number), min=h[0]*60+h[1]+h[2]/60;
  return '<b>'+vtHM(min,true)+'</b> · '+(v.efectiva?'<span style="color:#1f8b4c">✔ Visita efectiva</span>':'<span style="color:#b8860b">● Visita sin pedido</span>')
    +'<br>'+vtEsc(v.nombre)+(v.efectiva?'<br>Prevendido: <b>RD$ '+Math.round(v.monto).toLocaleString('es-DO')+'</b>':'')
    +(v.tipo==='2'?'<br>Visita virtual':'')+(v.fueraLugar?'<br><span style="color:#2563eb">Fuera de su lugar ('+v.dist+' m)</span>':'')+(!v.enRuta?'<br><span style="color:#6c3fc4">Fuera de ruta (no programado)</span>':'')
    +'<br><span style="color:#5c6b5f">'+vtEsc(v.repNombre)+'</span>';
}
function vtSet(T){
  VT.t=Math.max(VT.tmin,Math.min(VT.tmax,T)); $('#vt-range').value=VT.t; vtAplicar(VT.t);
}
function vtAplicar(T){
  const d=VT.data; if(!d) return; const lim=T+0.9999;
  let n=0, efe=0, monto=0, fueraRuta=0, fueraLugar=0; const clientes=new Set(), ruta=new Set(), estado=new Map();
  d.visitas.forEach(v=>{
    const on=v.minuto<=lim;
    if(v._m){ const has=VT.layerD.hasLayer(v._m); if(on&&!has) VT.layerD.addLayer(v._m); else if(!on&&has) VT.layerD.removeLayer(v._m); }
    if(!on) return;
    n++; if(v.efectiva) efe++; monto+=v.monto; clientes.add(v.key); if(v.fueraLugar) fueraLugar++;
    if(v.enRuta){ ruta.add(v.key); if(!v.fueraLugar) estado.set(v.key,'verde'); else if(!estado.has(v.key)) estado.set(v.key,'azul'); } else fueraRuta++;
  });
  VT.houses.forEach((h,k)=>{ const e=estado.get(k)||'rojo'; if(h.estado!==e){ h.estado=e; h.m.setIcon(vtHouse(VT_COL[e]));
    const st=e==='verde'?'Visitado en su lugar':e==='azul'?'Visitado fuera de su lugar':'No visitado'; h.m.setTooltipContent('<b>'+vtEsc(h.p.nombre)+'</b><br><span style="color:#5c6b5f">'+vtEsc(h.p.repNombre)+' · cliente '+h.p.cli+'</span><br><span class="vt-st" style="color:'+VT_COL[e]+'">'+st+'</span>'); } });
  const aVis=d.programados.length, cump=aVis?100*ruta.size/aVis:null, efect=n?100*efe/n:null;
  const chips='<div class="ch vt-ch"><span>Cumplimiento ruta <b>'+(cump==null?'—':cump.toFixed(1)+'%')+'</b></span><span>Efectividad <b>'+(efect==null?'—':efect.toFixed(1)+'%')+'</b></span></div>';
  const fmt=x=>Math.round(x).toLocaleString('es-DO');
  $('#cards').innerHTML=
    '<div class="card c3 vt-card"><div class="cl">Clientes a visitar</div><div class="cv">'+fmt(aVis)+'</div>'+chips+'<div class="ch">programados para el '+d.fecha+'</div></div>'
    +'<div class="card c2 vt-card"><div class="cl">Clientes visitados</div><div class="cv">'+fmt(clientes.size)+'</div>'+chips+'<div class="ch">'+fmt(ruta.size)+' de ruta · '+fmt(fueraRuta)+' visita(s) fuera de ruta · '+fmt(fueraLugar)+' fuera de lugar</div></div>'
    +'<div class="card c1 vt-card"><div class="cl">Visitas efectivas</div><div class="cv">'+fmt(efe)+'</div>'+chips+'<div class="ch">de '+fmt(n)+' visita(s) realizada(s)</div></div>'
    +'<div class="card vt-card"><div class="cl">Monto prevendido</div><div class="cv" style="color:#1f8b4c;font-size:22px">RD$ '+fmt(monto)+'</div>'+chips+'<div class="ch">bruto sin ITBIS · pedidos de las visitas mostradas</div></div>';
  $('#vt-lbl').textContent='Filtro de visitas hasta las '+vtHM(T,false);
  $('#vt-cnt').textContent=fmt(n)+' de '+fmt(d.visitas.length)+' visitas';
}
function vtPaintSpeed(){ document.querySelectorAll('#vt-spd button').forEach(b=>b.classList.toggle('on',b.dataset.s===VT.speed)); $('#vt-play').textContent=VT.playing?'⏸':'▶'; $('#vt-play').title=VT.playing?'Pausar':'Reproducir'; }
function vtPlay(){
  if(!VT.data||!VT.seq.length) return;
  if(VT.idx>=VT.seq.length-1){ VT.idx=-1; vtSet(VT.tmin); }
  clearInterval(VT.timer); VT.playing=true; vtPaintSpeed();
  VT.timer=setInterval(()=>{ if(VT.idx>=VT.seq.length-1){ vtStop(); return; } VT.idx++; vtSet(VT.seq[VT.idx]); },VT_VEL[VT.speed]);
}
function vtStop(){ clearInterval(VT.timer); VT.timer=null; VT.playing=false; const b=$('#vt-play'); if(b) vtPaintSpeed(); }
(function(){
  $('#vt-play').onclick=()=>{ if(VT.playing) vtStop(); else vtPlay(); };
  document.querySelectorAll('#vt-spd button').forEach(b=>b.onclick=()=>{ VT.speed=b.dataset.s; const was=VT.playing; vtPaintSpeed(); if(was) vtPlay(); });
  $('#vt-range').oninput=e=>{ vtStop(); const T=+e.target.value; VT.idx=-1; VT.seq.forEach((m,i)=>{ if(m<=T) VT.idx=i; }); vtSet(T); };
  $('#fs-exit').onclick=()=>vtFS(false);
})();

/* ═══════════════════════════════════════════════════════════════════════════
   NAVEGACION
   ═══════════════════════════════════════════════════════════════════════════ */
const META = {
  ubicacion:{t:'Ubicaci&oacute;n de Vendedores', s:'&Uacute;ltima sincronizaci&oacute;n de cada representante'},
  clientes:{t:'Visitados Con / Sin Pedidos', s:''},
  oportunidad:{t:'Oportunidades por Suplidor / Categor&iacute;a', s:'Clientes sin ventas del suplidor filtrado'},
  promedio:{t:'Compr&oacute; menos que el promedio', s:'Pedido vs. promedio de las &uacute;ltimas 6 facturas'},
  fueraruta:{t:'Pedidos fuera de Ruta', s:'Pedidos hechos en d&iacute;a distinto al programado'},
  visitas:{t:'Visitas del d&iacute;a', s:'Clientes programados (casitas) y visitas realizadas (puntos) a lo largo del d&iacute;a'}
};
function setView(v){
  if(typeof vtLeave==='function') vtLeave();
  state.view=v;
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.toggle('active',n.dataset.view===v));
  $('#view-title').innerHTML=META[v].t; $('#view-sub').innerHTML=META[v].s;
  $('#cards').innerHTML=''; $('#legend').style.display='none'; $('#warns').innerHTML='';
  if(v==='ubicacion'){ buildFiltersUbicacion(); loadUbicacion(); }
  else if(v==='clientes'){ buildFiltersClientes(); loadClientes(); }
  else if(v==='fueraruta'){ buildFiltersFueraRuta(); loadFueraRuta(); }
  else if(v==='visitas'){ buildFiltersVisitas(); showSoon('Visitas del d\u00eda','Elige la fecha, el supervisor y/o el vendedor y presiona "Generar": las casitas son los clientes programados y los puntos las visitas realizadas.',true); }
  else if(v==='oportunidad'){ buildFiltersOportunidad(); (V.modoOp==='recuperados'?loadRecuperados:loadOportunidad)(); }
  else { $('#filters').innerHTML=''; showSoon('En construcci&oacute;n','Este sub-m&oacute;dulo ('+META[v].t.replace(/&[a-z]+;/g,'')+') se conectar&aacute; en la siguiente iteraci&oacute;n. La consulta ya fue validada contra la base de datos.'); }
  setTimeout(()=>map.invalidateSize(),150);
}
document.querySelectorAll('.nav-item').forEach(n=>n.onclick=()=>setView(n.dataset.view));

/* ── Arranque: cargar catalogos (reps + suplidor/categoria) y mostrar vista 1 ── */
showOverlay(true);
Promise.all([
  fetch(BASE+'/apigeo/filtros').then(r=>r.json()).catch(()=>null),
  fetch(BASE+'/apigeo/catalogo').then(r=>r.json()).catch(()=>null)
]).then(([jf,jc])=>{
  showOverlay(false);
  REPS=(jf&&jf.ok&&jf.representantes)||[];
  REPMAP={}; REPS.forEach(r=>{ REPMAP[r.RepCodigo]=r.RepNombre; });
  if(jc&&jc.ok){ CAT.suplidores=jc.suplidores||[]; CAT.categorias=jc.categorias||[]; CAT.divisiones=jc.divisiones||[]; }
  setView('ubicacion');
}).catch(e=>{ showOverlay(false); alert('No se pudo cargar el cat&aacute;logo: '+e); });
</script>
