const EST_REC={dejo:'#f85149',recuperado:'#3fb950',retenido:'#1f6feb',inactivo:'#8b949e'};
const EST_REC_TXT={dejo:'Dejó de comprar',recuperado:'Recuperado',retenido:'Retenido (sigue comprando)',inactivo:'Inactivo'};
/* Tamaño de cliente (Clientes.ClaID x UsosMultiples 'Clasifica') */
const TAM={0:['Sin clasif.','#8b949e'],1:['A Grande','#f85149'],2:['B Mediano','#f0883e'],3:['C Pequeño','#e3b341'],4:['D1 Muy Peq.','#58a6ff'],5:['D2 Muy Peq.','#1f6feb'],6:['D3 Muy Peq.','#a371f7'],7:['D4 Muy Peq.','#6e7681']};
function tamNom(id){ return (TAM[id]||TAM[0])[0]; }
function tamCol(id){ return (TAM[id]||TAM[0])[1]; }
/* Tarjeta: peso % de los top-3 tamaños por cantidad de clientes */
function cardTamano(list){
  const tot=list.length||1; const g={};
  list.forEach(r=>{ const k=(r.ClaID==null?0:r.ClaID); g[k]=(g[k]||0)+1; });
  const top=Object.entries(g).sort((a,b)=>b[1]-a[1]).slice(0,3)
    .map(([k,n])=>'<div class="t3"><span class="lg-dot" style="background:'+tamCol(k)+'"></span>'+tamNom(k)+'<span class="m">'+Math.round(n*100/tot)+'%</span></div>').join('')||'<div class="t3" style="color:#8b949e">Sin datos</div>';
  return '<div class="card wide"><div class="cl">Peso Top 3 tamaños (por # clientes)</div><div class="top3">'+top+'</div></div>';
}
/* Tarjeta: volumen (Valor) comprado de OTRAS marcas por estos clientes */
function cardOtrasMarcas(valor){
  return '<div class="card"><div class="cl">Volumen otras marcas (Valor)</div><div class="cv" style="color:#58a6ff">'+Math.round(valor).toLocaleString('es-DO')+'</div><div class="ch">RD$ que compran de otros suplidores</div></div>';
