    '<div class="card"><div class="cl">Inactivos</div><div class="cv" style="color:#8b949e">'+j.inactivos+'</div><div class="ch">'+(j.mesesSinCompra!=null?('~'+j.mesesSinCompra+' meses sin comprar'):(sel.length?(mostrados+' mostrados'):(j.sinGps+' sin GPS')))+'</div></div>';
