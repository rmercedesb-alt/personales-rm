/* ── Multiselect reutilizable ── */
function multiselect(host, label, opts, onChange){
  // opts: [{v, t}] ; devuelve API {values(), set(), setOptions()}
  const wrap=document.createElement('div'); wrap.className='ms';
  const btn=document.createElement('div'); btn.className='ms-btn';
  const txt=document.createElement('span'); txt.textContent=label;
  const cnt=document.createElement('span'); cnt.className='cnt'; cnt.style.display='none';
  btn.appendChild(txt); btn.appendChild(cnt);
  const pop=document.createElement('div'); pop.className='ms-pop';
  const search=document.createElement('input'); search.className='ms-search'; search.placeholder='Buscar...';
  const head=document.createElement('div'); head.className='ms-head';
  const allBtn=document.createElement('span'); allBtn.className='ms-link'; allBtn.textContent='✓ Todos';
  const noneBtn=document.createElement('span'); noneBtn.className='ms-link'; noneBtn.textContent='✕ Ninguno';
  head.append(allBtn,noneBtn);
  const list=document.createElement('div');
  pop.appendChild(search); pop.appendChild(head); pop.appendChild(list);
  wrap.appendChild(btn); wrap.appendChild(pop); host.appendChild(wrap);
  let options=opts.slice(), selected=new Set();
  function visibles(){ const q=(search.value||'').toLowerCase(); return options.filter(o=>o.t.toLowerCase().includes(q)); }
  allBtn.onclick=e=>{ e.stopPropagation(); visibles().forEach(o=>selected.add(o.v)); render(); sync(); onChange&&onChange(); };
  noneBtn.onclick=e=>{ e.stopPropagation(); visibles().forEach(o=>selected.delete(o.v)); render(); sync(); onChange&&onChange(); };
  function render(){
    const q=(search.value||'').toLowerCase();
    list.innerHTML='';
    const f=options.filter(o=>o.t.toLowerCase().includes(q));
    if(!f.length){ list.innerHTML='<div class="ms-empty">Sin opciones</div>'; }
    f.forEach(o=>{
      const row=document.createElement('label'); row.className='ms-opt';
      const cb=document.createElement('input'); cb.type='checkbox'; cb.checked=selected.has(o.v);
      cb.onchange=()=>{ cb.checked?selected.add(o.v):selected.delete(o.v); sync(); onChange&&onChange(); };
      const sp=document.createElement('span'); sp.textContent=o.t;
      row.appendChild(cb); row.appendChild(sp); list.appendChild(row);
    });
  }
  function sync(){ const n=selected.size; cnt.style.display=n?'inline-block':'none'; cnt.textContent=n; }
  btn.onclick=e=>{ e.stopPropagation(); document.querySelectorAll('.ms-pop.open').forEach(p=>{if(p!==pop)p.classList.remove('open');}); pop.classList.toggle('open'); if(pop.classList.contains('open')){search.value='';render();search.focus();} };
  search.oninput=render;
  pop.onclick=e=>e.stopPropagation();
  render(); sync();
  return {
    values:()=>Array.from(selected),
    setOptions:(newOpts,keep)=>{ options=newOpts.slice(); if(!keep) selected=new Set([...selected].filter(v=>options.some(o=>o.v===v))); render(); sync(); },
    selectAll:()=>{ options.forEach(o=>selected.add(o.v)); render(); sync(); },
    select:(vals)=>{ (vals||[]).forEach(v=>selected.add(v)); render(); sync(); },
    clear:()=>{ selected.clear(); render(); sync(); }
  };
}
document.addEventListener('click',()=>document.querySelectorAll('.ms-pop.open').forEach(p=>p.classList.remove('open')));

/* ── Utilidades ── */
function fmtAgo(iso, serverIso){
  const t=new Date(iso), now=serverIso?new Date(serverIso):new Date();
  const min=Math.max(0,Math.round((now-t)/60000));
  if(min<60) return min+' min';
  const h=Math.floor(min/60); return h+'h '+(min%60)+'m';
}
function freshColor(min){ return min<=30?'#3fb950':(min<=120?'#e3b341':'#8b949e'); }
function showOverlay(b){ $('#overlay').classList.toggle('show',b); }
function todayStr(){ const d=new Date(); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
function dateInput(val){ const i=document.createElement('input'); i.type='date'; i.value=val||todayStr(); return i; }
function lblEl(t){ const s=document.createElement('span'); s.className='f-lbl'; s.textContent=t; return s; }
// Icono de casita SVG coloreable (para conjuntos pequenos); circulos para miles.
function houseIcon(color){
  const svg='<svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">'+
    '<path d="M12 3 L21 11 H18 V20 H14 V14 H10 V20 H6 V11 H3 Z" fill="'+color+'" stroke="#0d1117" stroke-width="1.2"/></svg>';
  return L.divIcon({className:'marker-lbl',html:svg,iconSize:[20,20],iconAnchor:[10,18],popupAnchor:[0,-16]});
}
/* ── Fotos de representantes (RegistrosImagenes) ── se cargan una sola vez: qué representantes tienen foto + versión de caché */
let FOTOS=null;   // Map RepCodigo -> versión; null = aún no cargado
function ensureFotos(cb){
  if(FOTOS){ cb(); return; }
  fetch(BASE+'/apigeo/fotos-reps').then(r=>r.json()).then(j=>{
    FOTOS=new Map(((j&&j.ok&&j.fotos)||[]).map(x=>[String(x.cod),x.v]));
  }).catch(()=>{ FOTOS=new Map(); }).finally(cb);
}
function fotoUrl(cod,s){ return BASE+'/apigeo/foto-rep?cod='+encodeURIComponent(cod)+'&s='+s+'&v='+(FOTOS&&FOTOS.get(String(cod))||0); }
// Marcador con la foto del representante dentro de un aro del color de su estado (mismo color que usaba el punto). Sin foto → null.
function repPhotoIcon(r,color){
  if(!FOTOS||!FOTOS.has(String(r.RepCodigo))) return null;
  const html='<div class="rep-ph" style="border-color:'+color+'"><img src="'+fotoUrl(r.RepCodigo,80)+'" alt="" loading="lazy"></div>';
  return L.divIcon({className:'rep-pin',html:html,iconSize:[40,40],iconAnchor:[20,20],popupAnchor:[0,-20]});
}
function addClientMarker(r,color,useHouse){
  let m;
  if(useHouse) m=L.marker([r.Latitud,r.Longitud],{icon:houseIcon(color)});
  else m=L.circleMarker([r.Latitud,r.Longitud],{radius:6,color:'#0d1117',weight:1,fillColor:color,fillOpacity:.9});
  return m;
}
function showSoon(t,p,isHint){ $('#soon').style.display='flex'; $('#soon-t').textContent=t; $('#soon-p').textContent=p; $('#soon-badge').style.display=isHint?'none':'inline-block'; $('#soon-icon').innerHTML=isHint?'&#128269;':'&#128736;'; $('#legend').style.display='none'; $('#cards').innerHTML=''; $('#warns').innerHTML=''; clearMap(); }
function hideSoon(){ $('#soon').style.display='none'; }

/* ═══════════════════════════════════════════════════════════════════════════
   VISTA 1 — UBICACION DE VENDEDORES
   ═══════════════════════════════════════════════════════════════════════════ */
const V = {}; // controles por vista

function buildFiltersUbicacion(){
  const f=$('#filters'); f.innerHTML='';
  V.modo = V.modo || 'sync';

  // Toggle de modo: Tiempo de sincronizacion (actual) | Ubicacion de la Ruta
  const grp=document.createElement('div'); grp.className='modo-group';
  const bSync=document.createElement('button'); bSync.className='btn-modo'; bSync.textContent='Tiempo de sincronización';
  const bRuta=document.createElement('button'); bRuta.className='btn-modo'; bRuta.textContent='Ubicación de la Ruta';
  V.bSync=bSync; V.bRuta=bRuta;
  function paintModo(){ bSync.classList.toggle('on',V.modo==='sync'); bRuta.classList.toggle('on',V.modo==='ruta'); }
  bSync.onclick=()=>{ V.modo='sync'; paintModo(); loadUbicacion(); };
  bRuta.onclick=()=>{ V.modo='ruta'; paintModo(); loadUbicacion(); };
  grp.append(bSync,bRuta); f.append(grp); paintModo();

  const msCentro=document.createElement('span'), msSup=document.createElement('span'),
        msVen=document.createElement('span'), msCargo=document.createElement('span');
  f.append(msCentro,msSup,msVen,msCargo);

  const centros=[...new Map(REPS.filter(r=>r.CedCodigo).map(r=>[r.CedCodigo,r.CentroNombre])).entries()].map(([v,t])=>({v,t}));
  const cargos=[...new Set(REPS.map(r=>r.RepCargo).filter(Boolean))].sort().map(v=>({v,t:v}));

  V.centro = multiselect(msCentro,'Centro',centros,refreshDependents);
  V.sup    = multiselect(msSup,'Supervisor',[],refreshDependents);
  V.ven    = multiselect(msVen,'Vendedor',[]);
  V.cargo  = multiselect(msCargo,'Cargo',cargos);

  const lbl=document.createElement('span'); lbl.className='f-lbl'; lbl.textContent='Ventana (h):';
  const horas=document.createElement('input'); horas.type='number'; horas.value='48'; horas.min='1'; horas.max='720'; V.horas=horas;
  const btn=document.createElement('button'); btn.className='btn-ref'; btn.textContent='Actualizar'; btn.onclick=loadUbicacion;
  const clr=document.createElement('button'); clr.className='btn-clear'; clr.textContent='Limpiar';
  clr.onclick=()=>{ V.centro.clear();V.sup.clear();V.ven.clear();V.cargo.clear(); refreshDependents(); loadUbicacion(); };
  f.append(lbl,horas,btn,clr);
  refreshDependents();
}
function refreshDependents(){
  const cen=new Set(V.centro.values());
  const repsCen = cen.size?REPS.filter(r=>cen.has(r.CedCodigo)):REPS;
  const sups=[...new Map(repsCen.filter(r=>r.SupervisorCod).map(r=>[r.SupervisorCod,r.SupervisorNombre])).entries()].map(([v,t])=>({v,t}));
  V.sup.setOptions(sups);
  const sup=new Set(V.sup.values());
  const repsSup = sup.size?repsCen.filter(r=>sup.has(r.SupervisorCod)):repsCen;
  V.ven.setOptions(repsSup.map(r=>({v:r.RepCodigo,t:r.RepCodigo+' - '+r.RepNombre})));
}
function loadUbicacion(){
  hideSoon(); showOverlay(true);
  const p=new URLSearchParams();
  if(V.centro.values().length) p.set('centros',V.centro.values().join(','));
  if(V.sup.values().length)    p.set('supervisores',V.sup.values().join(','));
  if(V.ven.values().length)    p.set('reps',V.ven.values().join(','));
  if(V.cargo.values().length)  p.set('cargos',V.cargo.values().join(','));
  p.set('horas',V.horas.value||'48');
  p.set('modo',V.modo||'sync');
  fetch(BASE+'/apigeo/ubicaciones?'+p.toString()).then(r=>r.json()).then(j=>{
    showOverlay(false);
    if(!j||!j.ok){ alert('Error: '+(j&&j.error||'desconocido')); return; }
    renderUbicacion(j);
  }).catch(e=>{ showOverlay(false); alert('Error de conexion: '+e); });
}
function renderUbicacion(j){
  if(FOTOS===null){ ensureFotos(()=>renderUbicacion(j)); return; }
  V.lastUbic=j;
  clearMap();
  const now=j.servidor?new Date(j.servidor):new Date();
  const ruta=(j.modo==='ruta');
  const pts=[];
  j.reps.forEach(r=>r._min=Math.max(0,Math.round((now-new Date(r.Sync))/60000)));

  j.reps.forEach(r=>{
    const col = ruta ? colorRuta(r.MinDistM) : colorSync(r._min);
    const ico=repPhotoIcon(r,col);
    const m=ico?L.marker([r.Latitud,r.Longitud],{icon:ico}):L.circleMarker([r.Latitud,r.Longitud],{radius:8,color:'#fff',weight:2,fillColor:col,fillOpacity:.95});
    let extra='';
    if(ruta){
      extra = (r.MinDistM!=null)
        ? '<div class="pop-r">Cliente más cercano: <b>'+(r.NearCliID||'—')+' - '+(r.NearCliNombre||'—')+'</b></div>'+
          '<div class="pop-r">Distancia: <b style="color:'+col+'">'+r.MinDistM+' m</b></div>'
        : '<div class="pop-r" style="color:#8b949e">Sin clientes de ruta hoy</div>';
    }
    m.bindPopup((ico?'<img class="pop-foto" style="--pc:'+col+'" src="'+fotoUrl(r.RepCodigo,128)+'" alt="">':'')+'<div class="pop-t">'+r.RepNombre+' ('+r.RepCodigo+')</div>'+
      '<div class="pop-r">Cargo: '+(r.RepCargo||'—')+'</div>'+
      '<div class="pop-r">Supervisor: '+(r.SupervisorNombre||'—')+'</div>'+
      '<div class="pop-r">Centro: '+(r.CentroNombre||'—')+'</div>'+
      '<div class="pop-r">Sync: '+new Date(r.Sync).toLocaleString('es-DO')+' ('+fmtAgo(r.Sync,j.servidor)+')</div>'+
      extra);
    m.addTo(layer); pts.push([r.Latitud,r.Longitud]);
  });
  fitTo(pts);
  $('#legend').style.display='block';

  if(ruta){
    let verde=0,amar=0,rojo=0;
    j.reps.forEach(r=>{ const c=colorRuta(r.MinDistM); if(c==='#3fb950')verde++; else if(c==='#e3b341')amar++; else if(c==='#f85149')rojo++; });
    const top3 = j.reps.filter(r=>r.MinDistM!=null).sort((a,b)=>b.MinDistM-a.MinDistM).slice(0,3)
                 .map(r=>({n:r.RepNombre,v:r.MinDistM+' m'}));
    $('#cards').innerHTML =
      card('c1','En ruta',verde,'&lt; '+CFG.ruta.verde+' m')+
      '<div class="card"><div class="cl">Alejados</div><div class="cv" style="color:#e3b341">'+amar+'</div><div class="ch">'+CFG.ruta.verde+'–'+CFG.ruta.amarillo+' m</div></div>'+
      '<div class="card"><div class="cl">Fuera de ruta</div><div class="cv" style="color:#f85149">'+rojo+'</div><div class="ch">&gt; '+CFG.ruta.amarillo+' m</div></div>'+
      top3Card('','Top 3 más lejos',top3);
    $('#legend').innerHTML='<div class="lt">Cercanía a ruta (hoy)</div>'+
      lg('#3fb950','&lt; '+CFG.ruta.verde+' m')+lg('#e3b341',CFG.ruta.verde+' – '+CFG.ruta.amarillo+' m')+lg('#f85149','&gt; '+CFG.ruta.amarillo+' m');
  } else {
    let c1=0,c2=0,c3=0;
    j.reps.forEach(r=>{ if(r._min<CFG.sync.verde)c1++; else if(r._min<=CFG.sync.amarillo)c2++; else c3++; });
    const top3 = j.reps.slice().sort((a,b)=>b._min-a._min).slice(0,3)
                 .map(r=>({n:r.RepNombre,v:fmtAgo(r.Sync,j.servidor)}));
    $('#cards').innerHTML =
      card('c1','Menos de '+CFG.sync.verde+' min',c1,'sincronizados')+
      '<div class="card"><div class="cl">Entre '+CFG.sync.verde+' y '+CFG.sync.amarillo+' min</div><div class="cv" style="color:#e3b341">'+c2+'</div><div class="ch">&nbsp;</div></div>'+
      '<div class="card"><div class="cl">Más de '+CFG.sync.amarillo+' min</div><div class="cv" style="color:#f85149">'+c3+'</div><div class="ch">&nbsp;</div></div>'+
      top3Card('','Top 3 más tiempo sin sync',top3);
    $('#legend').innerHTML='<div class="lt">Tiempo de sincronización</div>'+
      lg('#3fb950','&lt; '+CFG.sync.verde+' min')+lg('#e3b341',CFG.sync.verde+' – '+CFG.sync.amarillo+' min')+lg('#f85149','&gt; '+CFG.sync.amarillo+' min');
  }
  if(FOTOS&&j.reps.some(r=>FOTOS.has(String(r.RepCodigo)))) $("#legend").innerHTML+='<div class="lg-row" style="color:#8b949e;font-size:11px;margin-top:3px">El aro de cada foto usa estos colores</div>';
}
function card(cls,l,v,h){ return '<div class="card '+cls+'"><div class="cl">'+l+'</div><div class="cv">'+v+'</div><div class="ch">'+h+'</div></div>'; }
function lg(c,t){ return '<div class="lg-row"><span class="lg-dot" style="background:'+c+'"></span>'+t+'</div>'; }

/* Reutilizable: crea los 3 multiselect dependientes Centro→Supervisor→Vendedor en V */
function buildRepFilters(f){
  const mc=document.createElement('span'), ms=document.createElement('span'), mv=document.createElement('span');
  f.append(mc,ms,mv);
  const centros=[...new Map(REPS.filter(r=>r.CedCodigo).map(r=>[r.CedCodigo,r.CentroNombre])).entries()].map(([v,t])=>({v,t}));
  V.centro=multiselect(mc,'Centro',centros,refreshDependents);
  V.sup   =multiselect(ms,'Supervisor',[],refreshDependents);
  V.ven   =multiselect(mv,'Vendedor',[]);
}
/* Tarjeta con lista Top-3 (nombre + valor a la derecha) */
function top3Card(cls,titulo,items){
  const lis=items.slice(0,3).map((it,i)=>'<div class="t3"><b>'+(i+1)+'</b>'+it.n+'<span class="m">'+it.v+'</span></div>').join('')
    || '<div class="t3" style="color:#8b949e">Sin datos</div>';
  return '<div class="card '+cls+' wide"><div class="cl">'+titulo+'</div><div class="top3">'+lis+'</div></div>';
}

/* ═══════════════════════════════════════════════════════════════════════════
   VISTA 2 — CLIENTES CON / SIN VENTAS
   ═══════════════════════════════════════════════════════════════════════════ */
/* División con default 10 y 11 (aplica a todos los análisis) */
function divMultiselect(host){ const ms=multiselect(host,'División',(CAT.divisiones||[])); ms.select(['10','11']); return ms; }
/* Cargo desde el catálogo de reps */
function cargoOpts(){ return [...new Set(REPS.map(r=>r.RepCargo).filter(Boolean))].sort().map(v=>({v,t:v})); }

function buildFiltersClientes(){
  const f=$('#filters'); f.innerHTML='';
  f.append(lblEl('Desde:')); V.desde=dateInput(); f.append(V.desde);
  f.append(lblEl('Hasta:')); V.hasta=dateInput(); f.append(V.hasta);
  buildRepFilters(f);
  const msCg=document.createElement('span'), msDv=document.createElement('span'); f.append(msCg,msDv);
  V.cargo=multiselect(msCg,'Cargo',cargoOpts());
  V.division=divMultiselect(msDv);
  const msSp=document.createElement('span'), msCt=document.createElement('span'), msPr=document.createElement('span');
  f.append(msSp,msCt,msPr);
  V.suplidor=multiselect(msSp,'Suplidor',(CAT.suplidores||[]),onSuplidorChange);
  V.categoria=multiselect(msCt,'Categoría',[],onCategoriaChange);
  V.producto=multiselect(msPr,'Producto',[]);
  const msEst=document.createElement('span'); f.append(msEst);
  const estadoOpts=[{v:'verde',t:'Con pedido'},{v:'azul',t:'Con pedido (virtual)'},{v:'otros',t:'Pedido (otro día)'},{v:'amar',t:'Sin pedido (comentario)'},{v:'rojo',t:'Sin pedido'},{v:'gris',t:'No visitado'}];
  V.estado=multiselect(msEst,'Estado',estadoOpts,()=>{ if(V.lastClientesData) renderClientes(V.lastClientesData); });
  const btn=document.createElement('button'); btn.className='btn-ref'; btn.textContent='Actualizar'; btn.onclick=loadClientes;
  const clr=document.createElement('button'); clr.className='btn-clear'; clr.textContent='Limpiar';
  clr.onclick=()=>{ V.centro.clear();V.sup.clear();V.ven.clear();V.cargo.clear();V.division.clear();V.suplidor.clear();V.categoria.clear();V.producto.clear();V.estado.clear(); refreshDependents(); onSuplidorChange(); loadClientes(); };
  f.append(btn,clr);
  refreshDependents();
  onSuplidorChange();
}
function onSuplidorChange(){
  const sel=new Set(V.suplidor.values());
  const cats = sel.size ? (CAT.categorias||[]).filter(c=>sel.has(c.sup)) : (CAT.categorias||[]);
  // dedup por nombre de categoria
  const uniq=[...new Map(cats.map(c=>[c.v,c])).values()];
  V.categoria.setOptions(uniq);
  onCategoriaChange();
}
function onCategoriaChange(){
  const p=new URLSearchParams();
  if(V.suplidor.values().length) p.set('suplidores',V.suplidor.values().join(','));
  if(V.categoria.values().length) p.set('categorias',V.categoria.values().join(','));
  fetch(BASE+'/apigeo/productos?'+p.toString()).then(r=>r.json()).then(j=>{
    V.producto.setOptions((j&&j.ok&&j.productos)||[]);
  }).catch(()=>V.producto.setOptions([]));
}
function loadClientes(){
  hideSoon(); showOverlay(true);
  const p=new URLSearchParams();
  p.set('fechaIni',V.desde.value); p.set('fechaFin',V.hasta.value);
  if(V.centro.values().length)   p.set('centros',V.centro.values().join(','));
  if(V.sup.values().length)      p.set('supervisores',V.sup.values().join(','));
  if(V.ven.values().length)      p.set('reps',V.ven.values().join(','));
  if(V.suplidor.values().length) p.set('suplidores',V.suplidor.values().join(','));
  if(V.categoria.values().length)p.set('categorias',V.categoria.values().join(','));
  if(V.producto.values().length) p.set('productos',V.producto.values().join(','));
  if(V.cargo&&V.cargo.values().length)      p.set('cargos',V.cargo.values().join(','));
  if(V.division&&V.division.values().length) p.set('divisiones',V.division.values().join(','));
  fetch(BASE+'/apigeo/clientes-ventas?'+p.toString()).then(r=>r.json()).then(j=>{
    showOverlay(false);
    if(!j||!j.ok){ alert('Error: '+(j&&j.error||'desconocido')); return; }
    renderClientes(j);
  }).catch(e=>{ showOverlay(false); alert('Error de conexion: '+e); });
}
function estadoCliente(r){
  // Prioridad al pedido. Fuera de ruta con pedido = azul claro "otro dia".
  if(r.ConPedido){
    if(!r.EnRuta) return {col:'#79c0ff', key:'otros', txt:'Pedido (Cte otro día)'};
    return r.Virtual ? {col:'#1f6feb', key:'azul', txt:'Con pedido (virtual)'} : {col:'#3fb950', key:'verde', txt:'Con pedido'};
  }
  if(!r.Visitado) return {col:'#8b949e', key:'gris', txt:'No visitado'};
  if(r.Comentario) return {col:'#e3b341', key:'amar', txt:(r.Virtual?'Visitado virtual':'Visitado')+' — sin pedido (con comentario)'};
  return {col:'#f85149', key:'rojo', txt:(r.Virtual?'Visitado virtual':'Visitado')+' — sin pedido'};
}
function renderClientes(j){
  V.lastClientesData=j;
  clearMap();
  const useHouse = j.clientes.length<=800;
  const sel = (V.estado?V.estado.values():[]);
  const pts=[]; let mostrados=0; const dupe={};
  j.clientes.forEach(r=>{
    const e=estadoCliente(r);
    if(sel.length && sel.indexOf(e.key)<0) return;   // filtro de estado (puntos)
    mostrados++;
    // Mismo cliente en 2 vendedores → desplazar el 2do marcador ~15m para que ambos se vean
    const n=(dupe[r.CliID]=(dupe[r.CliID]||0)+1)-1;
    const pos = n>0 ? {Latitud:r.Latitud+0.00013*Math.cos(n*2.4), Longitud:r.Longitud+0.00013*Math.sin(n*2.4)} : r;
    const m=addClientMarker(pos,e.col,useHouse);
    const comTxt = r.Comentario ? ('<div class="pop-r" style="margin-top:4px;color:#e3b341">Comentario: '+r.Comentario+'</div>') : '';
    const venNom = REPMAP[r.RepCodigo]?(' - '+REPMAP[r.RepCodigo]):'';
    m.bindPopup('<div class="pop-t">'+r.Nombre+'</div>'+
      '<div class="pop-r">Código: '+r.CliID+'</div>'+
      '<div class="pop-r">Vendedor: '+(r.RepCodigo||'—')+venNom+'</div>'+
      '<div class="pop-r" style="color:'+e.col+';font-weight:700">'+e.txt+'</div>'+comTxt);
    m.addTo(layer); pts.push([pos.Latitud,pos.Longitud]);
  });
  fitTo(pts);
  const P=j.pedidos||{delDia:0,virtuales:0,otrosDias:0,total:0};
  const S=j.sinPedido||{comentario:0,rojo:0,noVisitado:0};
  // Tarjeta "Pedidos a Ctes." (estilo imagen)
  const t3=(c,l,v)=>'<div class="t3" style="color:'+c+'">'+l+'<span class="m" style="color:'+c+'">'+v+'</span></div>';
  const pedCard =
    '<div class="card wide"><div class="cl">Pedidos a Ctes.</div><div class="top3">'+
      t3('#3fb950','del día',P.delDia)+
      t3('#1f6feb','del día Virtuales',P.virtuales)+
      t3('#79c0ff','de otros días',P.otrosDias)+
      '<div class="t3" style="font-weight:800;border-top:1px solid var(--border);padding-top:3px;margin-top:2px">Total Pedidos<span class="m" style="color:var(--text)">'+P.total+'</span></div>'+
    '</div></div>';
  const sinCard =
    '<div class="card wide"><div class="cl">Sin pedido</div><div class="top3">'+
      t3('#e3b341','Con comentario',S.comentario)+
      t3('#f85149','Sin comentario',S.rojo)+
      t3('#8b949e','No visitado',S.noVisitado)+
    '</div></div>';
  const uniCard = card('c3','Universo (ruta)', j.rutaTotal, (sel.length?(mostrados+' mostrados'):(j.sinGps?(j.sinGps+' sin GPS'):'clientes')));
  const alertCard = (j.virtualSinPedido>0)
    ? '<div class="card"><div class="cl">&#9888; Virtual sin pedido</div><div class="cv" style="color:#ff7b7b">'+j.virtualSinPedido+'</div><div class="ch">visitados virtual</div></div>'
    : '';
  $('#cards').innerHTML = pedCard + sinCard + uniCard + alertCard;
  $('#warns').innerHTML='';
  $('#legend').style.display='block';
  $('#legend').innerHTML='<div class="lt">Estado'+(useHouse?'':' (puntos)')+'</div>'+
    lg('#3fb950','Con pedido')+lg('#1f6feb','Con pedido (virtual)')+lg('#79c0ff','Pedido (otro día)')+
    lg('#e3b341','Sin pedido (comentario)')+lg('#f85149','Sin pedido')+lg('#8b949e','No visitado');
}

/* ═══════════════════════════════════════════════════════════════════════════
   VISTA 5 — PEDIDOS FUERA DE RUTA
   ═══════════════════════════════════════════════════════════════════════════ */
function buildFiltersFueraRuta(){
  const f=$('#filters'); f.innerHTML='';
  V.modoFR = V.modoFR || 'vendedor';
  const grp=document.createElement('div'); grp.className='modo-group';
  const bV=document.createElement('button'); bV.className='btn-modo'; bV.textContent='Por Vendedor';
  const bS=document.createElement('button'); bS.className='btn-modo'; bS.textContent='Por Supervisor';
  function paint(){ bV.classList.toggle('on',V.modoFR==='vendedor'); bS.classList.toggle('on',V.modoFR==='supervisor'); }
  bV.onclick=()=>{ V.modoFR='vendedor'; paint(); if(V.lastFR) renderFueraRuta(V.lastFR); };
  bS.onclick=()=>{ V.modoFR='supervisor'; paint(); if(V.lastFR) renderFueraRuta(V.lastFR); };
  grp.append(bV,bS); f.append(grp); paint();

  f.append(lblEl('Desde:')); V.desde=dateInput(); f.append(V.desde);
  f.append(lblEl('Hasta:')); V.hasta=dateInput(); f.append(V.hasta);
  buildRepFilters(f);
  const btn=document.createElement('button'); btn.className='btn-ref'; btn.textContent='Actualizar'; btn.onclick=loadFueraRuta;
  const clr=document.createElement('button'); clr.className='btn-clear'; clr.textContent='Limpiar';
  clr.onclick=()=>{ V.centro.clear();V.sup.clear();V.ven.clear(); refreshDependents(); loadFueraRuta(); };
  f.append(btn,clr);
  refreshDependents();
}
function loadFueraRuta(){
  hideSoon(); showOverlay(true);
  const p=new URLSearchParams();
  p.set('fechaIni',V.desde.value); p.set('fechaFin',V.hasta.value);
  if(V.centro.values().length) p.set('centros',V.centro.values().join(','));
  if(V.sup.values().length)    p.set('supervisores',V.sup.values().join(','));
  if(V.ven.values().length)    p.set('reps',V.ven.values().join(','));
  fetch(BASE+'/apigeo/fuera-ruta?'+p.toString()).then(r=>r.json()).then(j=>{
    showOverlay(false);
    if(!j||!j.ok){ alert('Error: '+(j&&j.error||'desconocido')); return; }
    renderFueraRuta(j);
  }).catch(e=>{ showOverlay(false); alert('Error de conexion: '+e); });
}
function renderFueraRuta(j){
  V.lastFR=j; clearMap();
  const pts=[];
  j.clientes.forEach(r=>{
    const m=L.circleMarker([r.Latitud,r.Longitud],{radius:8,color:'#fff',weight:2,fillColor:'#f0883e',fillOpacity:.95});
    m.bindPopup('<div class="pop-t">&#9888; '+r.Nombre+'</div>'+
      '<div class="pop-r">Código: '+r.CliID+'</div>'+
      '<div class="pop-r">Vendedor: '+r.RepCodigo+(r.RepNombre?(' - '+r.RepNombre):'')+'</div>'+
      '<div class="pop-r">Supervisor: '+(r.SupNombre||'—')+'</div>'+
      '<div class="pop-r">Pedidos fuera de ruta: <b style="color:#f0883e">'+r.Pedidos+'</b></div>'+
      '<div class="pop-r">Último pedido: '+(r.UltPedido||'—')+'</div>'+
      '<div class="pop-r" style="color:#58a6ff">Clic para ver los 10 vecinos &darr;</div>');
    m.on('click',()=>loadVecinos(r));
    m.addTo(layer); pts.push([r.Latitud,r.Longitud]);
  });
  fitTo(pts);
  // Tarjetas
  const t3=(c,l,v)=>'<div class="t3" style="color:'+c+'">'+l+'<span class="m" style="color:var(--text)">'+v+'</span></div>';
  if(V.modoFR==='supervisor'){
    const items=(j.topSups||[]).map(s=>'<div class="t3">'+s.Nombre+'<span class="m">'+s.pedidos+' ped</span></div>'+
      '<div class="t3" style="color:#8b949e;font-size:10px;padding-top:0">&nbsp;&nbsp;'+s.vendedores+' vend · '+s.clientes+' ctes</span></div>').join('')||'<div class="t3" style="color:#8b949e">Sin datos</div>';
    $('#cards').innerHTML =
      '<div class="card"><div class="cl">Pedidos fuera ruta</div><div class="cv" style="color:#f0883e">'+j.totalPedidos+'</div><div class="ch">'+j.totalClientes+' clientes</div></div>'+
      '<div class="card wide"><div class="cl">Top 3 supervisores</div><div class="top3">'+items+'</div></div>';
  } else {
    const items=(j.topReps||[]).map((r,i)=>'<div class="t3"><b>'+(i+1)+'</b>'+r.Nombre+'<span class="m">'+r.pedidos+' ped</span></div>'+
      '<div class="t3" style="color:#8b949e;font-size:10px;padding-top:0">&nbsp;&nbsp;'+r.clientes+' clientes</div>').join('')||'<div class="t3" style="color:#8b949e">Sin datos</div>';
    $('#cards').innerHTML =
      '<div class="card"><div class="cl">Pedidos fuera ruta</div><div class="cv" style="color:#f0883e">'+j.totalPedidos+'</div><div class="ch">'+j.totalClientes+' clientes · '+j.totalReps+' reps</div></div>'+
      '<div class="card wide"><div class="cl">Top 3 con más pedidos fuera de ruta</div><div class="top3">'+items+'</div></div>';
  }
  $('#legend').style.display='block';
  $('#legend').innerHTML='<div class="lt">Fuera de ruta</div>'+lg('#f0883e','Cliente con pedido fuera de ruta')+lg('#58a6ff','10 vecinos (clic)')+
    '<div class="lg-row" style="color:#8b949e;font-size:10px">Vecinos: &#9679; visitado presencial</div>';
}
function loadVecinos(sold){
  vecLayer.clearLayers();
  const p=new URLSearchParams();
  p.set('rep',sold.RepCodigo); p.set('cli',sold.CliID);
  p.set('fechaIni',V.desde.value); p.set('fechaFin',V.hasta.value);
  fetch(BASE+'/apigeo/fuera-ruta-vecinos?'+p.toString()).then(r=>r.json()).then(j=>{
    if(!j||!j.ok){ return; }
    (j.vecinos||[]).forEach(v=>{
      // linea sutil del vendido al vecino
      L.polyline([[sold.Latitud,sold.Longitud],[v.Latitud,v.Longitud]],{color:'#58a6ff',weight:1,opacity:.35}).addTo(vecLayer);
      const visto = v.VisitadoPresencial;
      const m=L.circleMarker([v.Latitud,v.Longitud],{radius:6,color:(visto?'#3fb950':'#58a6ff'),weight:2,fillColor:'#1c2f4a',fillOpacity:.95});
      m.bindPopup('<div class="pop-t">'+v.Nombre+'</div>'+
        '<div class="pop-r">Código: '+v.CliID+(v.CliCodigo?(' ('+v.CliCodigo+')'):'')+'</div>'+
        '<div class="pop-r">Distancia: <b>'+v.Metros+' m</b></div>'+
        '<div class="pop-r">Día que le toca visita: <b>'+(v.DiaVisita||'—')+'</b></div>'+
        '<div class="pop-r" style="color:'+(visto?'#3fb950':'#f85149')+';font-weight:700">'+(visto?'Visitado presencial':'No visitado presencial')+'</div>'+
        '<div class="pop-r" style="color:#8b949e">Vecino de: '+sold.Nombre+'</div>');
      m.addTo(vecLayer);
    });
  }).catch(()=>{});
}

/* ═══════════════════════════════════════════════════════════════════════════
   VISTA 3 — OPORTUNIDADES POR SUPLIDOR / CATEGORIA
   ═══════════════════════════════════════════════════════════════════════════ */
function onSupOportChange(){
  const selSup=new Set(V.suplidor.values());
  const cats = selSup.size ? (CAT.categorias||[]).filter(c=>selSup.has(c.sup)) : (CAT.categorias||[]);
  const uniq=[...new Map(cats.map(c=>[c.v,c])).values()];
  V.categoria.setOptions(uniq);
}
function buildFiltersOportunidad(){
  const f=$('#filters'); f.innerHTML='';
  V.modoOp = V.modoOp || 'perdidas';
  const grp=document.createElement('div'); grp.className='modo-group';
  const bP=document.createElement('button'); bP.className='btn-modo'; bP.textContent='Ventas Perdidas';
  const bR=document.createElement('button'); bR.className='btn-modo'; bR.textContent='Recuperados';
  grp.append(bP,bR); f.append(grp);
  // Rango principal (Ventas Perdidas) / Rango Activo (Recuperados)
  const l1a=lblEl('Desde:'), l1b=lblEl('Hasta:'); V.desde=dateInput(); V.hasta=dateInput();
  f.append(l1a,V.desde,l1b,V.hasta);
  // Rango Evaluacion (solo Recuperados)
  const l2a=lblEl('Eval desde:'), l2b=lblEl('Eval hasta:'); V.evalIni=dateInput(); V.evalFin=dateInput();
  f.append(l2a,V.evalIni,l2b,V.evalFin);
  const lblF=document.createElement('label'); lblF.className='f-lbl'; lblF.style.cssText='display:flex;align-items:center;gap:5px;cursor:pointer';
  const chkF=document.createElement('input'); chkF.type='checkbox'; chkF.style.accentColor='#8957e5'; V.fuentePed=chkF;
  lblF.append(chkF); lblF.append(document.createTextNode('Desde Pedidos (en línea)'));
  f.append(lblF);
  buildRepFilters(f);
  const msSp=document.createElement('span'), msCt=document.createElement('span'), msDv=document.createElement('span');
  f.append(msSp,msCt,msDv);
  V.suplidor=multiselect(msSp,'Suplidor',(CAT.suplidores||[]),onSupOportChange);
  V.categoria=multiselect(msCt,'Categoría',[]);
  V.division=divMultiselect(msDv);
  const msTm=document.createElement('span'); f.append(msTm);
  V.tamano=multiselect(msTm,'Tamaño',[{v:'1',t:'A Grande'},{v:'2',t:'B Mediano'},{v:'3',t:'C Pequeño'},{v:'4',t:'D1 Muy Peq.'},{v:'5',t:'D2 Muy Peq.'},{v:'6',t:'D3 Muy Peq.'},{v:'7',t:'D4 Muy Peq.'},{v:'0',t:'Sin clasif.'}]);
  const msEst=document.createElement('span'); f.append(msEst);
  V.estadoRec=multiselect(msEst,'Estado',[{v:'dejo',t:'Dejó de comprar'},{v:'recuperado',t:'Recuperado'},{v:'retenido',t:'Retenido'},{v:'inactivo',t:'Inactivo'}],()=>{ if(V.lastRecup) renderRecuperados(V.lastRecup); });
  const lblC=document.createElement('label'); lblC.className='f-lbl'; lblC.style.cssText='display:flex;align-items:center;gap:5px;cursor:pointer';
  const chk=document.createElement('input'); chk.type='checkbox'; chk.style.accentColor='#8957e5'; V.incluir=chk;
  lblC.append(chk); lblC.append(document.createTextNode('Incluir los que compran'));
  f.append(lblC);
  const btnA=document.createElement('button'); btnA.className='btn-ref'; btnA.textContent='Actualizar';
  const clr=document.createElement('button'); clr.className='btn-clear'; clr.textContent='Limpiar';
  clr.onclick=()=>{ V.centro.clear();V.sup.clear();V.ven.clear();V.suplidor.clear();V.categoria.clear();V.division.clear();V.tamano&&V.tamano.clear();V.incluir.checked=false; refreshDependents(); onSupOportChange(); (V.modoOp==='recuperados'?loadRecuperados:loadOportunidad)(); };
  f.append(btnA,clr);
  function applyMode(){
    const rec=V.modoOp==='recuperados';
    bP.classList.toggle('on',!rec); bR.classList.toggle('on',rec);
    [l2a,V.evalIni,l2b,V.evalFin,lblF,msEst].forEach(e=>e.style.display=rec?'':'none');
    lblC.style.display=rec?'none':'';
    l1a.textContent=rec?'Activo desde:':'Desde:'; l1b.textContent=rec?'Activo hasta:':'Hasta:';
    btnA.onclick=rec?loadRecuperados:loadOportunidad;
  }
  function recDefaults(){
    // Activo = 3 meses anteriores completos; Eval = 1ro del mes actual al día de hoy
    const now=new Date();
    const actDesde=new Date(now.getFullYear(), now.getMonth()-3, 1);
    const actHasta=new Date(now.getFullYear(), now.getMonth(), 0);
    const evDesde =new Date(now.getFullYear(), now.getMonth(), 1);
    const fmt=d=>d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
    V.desde.value=fmt(actDesde); V.hasta.value=fmt(actHasta);
    V.evalIni.value=fmt(evDesde); V.evalFin.value=fmt(now);
    if(!V.suplidor.values().length){ V.suplidor.selectAll(); onSupOportChange(); }  // todo el negocio
  }
  bP.onclick=()=>{ V.modoOp='perdidas'; applyMode(); loadOportunidad(); };
  bR.onclick=()=>{ V.modoOp='recuperados'; applyMode(); recDefaults(); loadRecuperados(); };
  applyMode();
  if(V.modoOp==='recuperados') recDefaults();
  refreshDependents(); onSupOportChange();
}
function loadRecuperados(){
  hideSoon(); showOverlay(true);
  const p=new URLSearchParams();
  p.set('activoIni',V.desde.value); p.set('activoFin',V.hasta.value);
