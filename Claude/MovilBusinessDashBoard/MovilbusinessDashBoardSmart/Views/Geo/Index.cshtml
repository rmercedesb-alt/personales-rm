@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Geolocalizaciones &mdash; AM COMERCIAL</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<style>
:root{
  --bg:#F7F9F7;--panel:#FFFFFF;--panel2:#F0F4F0;--border:#D9E2D9;--line:#E6ECE6;
  --text:#1F2A22;--muted:#5C6B5F;--accent:#283078;--accent2:#3357C4;
  --good:#2E9E4A;--warn:#D29922;--bad:#C0392B;--purple:#6C3FC4;
  --good-bg:#EAF7EE;--warn-bg:#FBF3DA;--bad-bg:#FBEAEA;--purple-bg:#F1EAFB;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{background:var(--bg);color:var(--text);font-family:'Segoe UI',Tahoma,sans-serif;font-size:13px;display:flex;overflow:hidden}

/* ─── Sidebar fija ───────────────────────────────────────────────────────── */
.side{width:224px;flex-shrink:0;background:var(--panel);border-right:1px solid var(--border);display:flex;flex-direction:column;height:100vh}
.side-brand{display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px solid var(--line)}
.side-brand img{height:36px;width:auto;border-radius:6px;object-fit:contain}
.side-brand .bn{font-size:14px;font-weight:800;line-height:1.1}
.side-brand .bs{font-size:10px;color:var(--purple);margin-top:2px}
.side-nav{flex:1;overflow-y:auto;padding:10px 8px}
.nav-item{display:flex;align-items:center;gap:11px;padding:11px 12px;border-radius:9px;cursor:pointer;color:var(--muted);transition:all .15s;margin-bottom:4px;border:1px solid transparent}
.nav-item:hover{background:var(--panel2);color:var(--text)}
.nav-item.active{background:var(--panel2);color:var(--text);border-color:var(--border)}
.nav-item.active .ni-bar{opacity:1}
.ni-ico{font-size:19px;line-height:1;width:22px;text-align:center;flex-shrink:0}
.ni-txt{font-size:12.5px;font-weight:600;line-height:1.25}
.ni-bar{position:absolute;left:0;width:3px;height:24px;border-radius:0 3px 3px 0;background:var(--purple);opacity:0;transition:opacity .15s}
.nav-item{position:relative}
.side-foot{padding:12px 14px;border-top:1px solid var(--line);font-size:11px;color:var(--muted);display:flex;flex-direction:column;gap:8px}
.side-foot .u{color:var(--text);font-weight:600;font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.foot-links{display:flex;gap:8px}
.btn-s{flex:1;text-align:center;background:var(--panel2);border:1px solid var(--border);color:var(--muted);border-radius:6px;padding:6px 8px;font-size:11px;text-decoration:none;transition:all .15s}
.btn-s:hover{border-color:var(--accent2);color:var(--accent2)}
.btn-s.out:hover{border-color:var(--bad);color:var(--bad)}

/* ─── Panel principal ────────────────────────────────────────────────────── */
.main{flex:1;display:flex;flex-direction:column;height:100vh;min-width:0}
.topbar{display:flex;align-items:center;gap:12px;padding:11px 18px;border-bottom:1px solid var(--line);flex-wrap:wrap;flex-shrink:0}
.topbar h1{font-size:15px;font-weight:800}
.topbar .sub{font-size:11px;color:var(--muted)}
.spacer{flex:1}
.clock{font-family:monospace;font-size:14px;color:var(--purple);font-weight:700}

/* ─── Barra de filtros ───────────────────────────────────────────────────── */
.filters{display:flex;align-items:center;gap:9px;padding:9px 18px;border-bottom:1px solid var(--line);flex-wrap:wrap;background:var(--panel);flex-shrink:0}
.f-lbl{font-size:11px;color:var(--muted);white-space:nowrap}
.filters input[type=date],.filters input[type=number],.filters select{background:var(--panel2);border:1px solid var(--border);color:var(--text);border-radius:6px;padding:5px 8px;font-size:12px;outline:none;height:30px;color-scheme:light}
.filters input:focus,.filters select:focus{border-color:var(--purple)}
.filters input[type=number]{width:70px}
.btn-ref{background:var(--purple);border:none;color:#fff;border-radius:6px;padding:6px 14px;cursor:pointer;font-size:12px;font-weight:700;height:30px}
.btn-ref:hover{background:#7d52d6}
.btn-clear{background:var(--panel2);border:1px solid var(--border);color:var(--muted);border-radius:6px;padding:6px 12px;cursor:pointer;font-size:12px;height:30px}
.btn-clear:hover{border-color:var(--bad);color:var(--bad)}
.modo-group{display:flex;gap:0;margin-right:4px}
.btn-modo{background:var(--panel2);border:1px solid var(--border);color:var(--muted);padding:6px 12px;cursor:pointer;font-size:12px;height:30px}
.btn-modo:first-child{border-radius:6px 0 0 6px}
.btn-modo:last-child{border-radius:0 6px 6px 0;border-left:none}
.btn-modo.on{background:var(--accent2);border-color:var(--accent2);color:#fff;font-weight:700}

/* Multiselect */
.ms{position:relative}
.ms-btn{background:var(--panel2);border:1px solid var(--border);color:var(--text);border-radius:6px;padding:5px 9px;font-size:12px;cursor:pointer;height:30px;display:flex;align-items:center;gap:6px;white-space:nowrap;min-width:110px}
.ms-btn:hover{border-color:var(--purple)}
.ms-btn .cnt{background:var(--purple);color:#fff;border-radius:10px;font-size:10px;padding:1px 7px;font-weight:700}
.ms-pop{display:none;position:absolute;top:34px;left:0;z-index:1200;background:var(--panel);border:1px solid var(--border);border-radius:8px;min-width:230px;max-height:320px;overflow-y:auto;box-shadow:0 10px 30px rgba(0,0,0,.15);padding:6px}
.ms-pop.open{display:block}
.ms-search{width:100%;background:var(--bg);border:1px solid var(--border);color:var(--text);border-radius:6px;padding:6px 8px;font-size:12px;margin-bottom:6px;outline:none}
.ms-opt{display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:6px;cursor:pointer;font-size:12px}
.ms-opt:hover{background:var(--panel2)}
.ms-opt input{accent-color:var(--purple)}
.ms-empty{color:var(--muted);font-size:11px;padding:8px;text-align:center}
.ms-head{display:flex;gap:12px;padding:4px 8px 6px;border-bottom:1px solid var(--line);margin-bottom:4px}
.ms-link{font-size:11px;color:var(--accent2);cursor:pointer;font-weight:600}
.ms-link:hover{text-decoration:underline}

/* ─── Contenido / mapa ───────────────────────────────────────────────────── */
.content{flex:1;position:relative;min-height:0}
#map{position:absolute;inset:0;background:var(--bg)}
.leaflet-popup-content-wrapper,.leaflet-popup-tip{background:var(--panel);color:var(--text);border:1px solid var(--border)}
.leaflet-popup-content{margin:10px 12px;font-size:12px;line-height:1.5}
.pop-t{font-weight:800;font-size:13px;margin-bottom:4px}
.pop-r{color:var(--muted)}
.leaflet-container{background:var(--bg)}

/* Cards flotantes */
.cards{position:absolute;top:12px;right:12px;z-index:800;display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end;max-width:calc(100% - 80px)}
.cards.chidden{display:none!important}
.warns{position:absolute;top:14px;left:50%;transform:translateX(-50%);z-index:810;display:flex;flex-direction:column;gap:6px;align-items:center;pointer-events:none}
.warn{padding:6px 16px;border-radius:20px;font-size:12px;font-weight:700;backdrop-filter:blur(4px);border:1px solid;white-space:nowrap}
.warn.blue{background:#EAF0FB;color:var(--accent2);border-color:var(--accent2)}
.warn.red{background:var(--bad-bg);color:var(--bad);border-color:var(--bad)}
.card{background:rgba(255,255,255,.94);border:1px solid var(--border);border-radius:11px;padding:11px 15px;min-width:150px;backdrop-filter:blur(4px)}
.card .cl{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.6px;font-weight:600;margin-bottom:5px}
.card .cv{font-size:26px;font-weight:800;line-height:1}
.card.c1 .cv{color:var(--good)}.card.c2 .cv{color:var(--warn)}.card.c3 .cv{color:var(--purple)}
.card .ch{font-size:10px;color:var(--muted);margin-top:3px}
.card .li{font-size:11px;padding:2px 0;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.card .li b{color:var(--purple);margin-right:4px}

/* Leyenda */
.legend{position:absolute;bottom:16px;left:12px;z-index:800;background:rgba(255,255,255,.94);border:1px solid var(--border);border-radius:10px;padding:9px 12px;font-size:11px;backdrop-filter:blur(4px)}
.legend .lt{font-weight:700;margin-bottom:5px;color:var(--muted);text-transform:uppercase;font-size:10px;letter-spacing:.5px}
.lg-row{display:flex;align-items:center;gap:7px;padding:2px 0}
.lg-dot{width:12px;height:12px;border-radius:50%;flex-shrink:0;border:2px solid #fff}

/* Estado carga / placeholder */
.overlay{position:absolute;inset:0;z-index:900;display:none;align-items:center;justify-content:center;background:rgba(247,249,247,.8);backdrop-filter:blur(2px)}
.overlay.show{display:flex}
.spin{width:34px;height:34px;border:3px solid var(--border);border-top-color:var(--purple);border-radius:50%;animation:sp 1s linear infinite}
@@keyframes sp{to{transform:rotate(360deg)}}
.soon{position:absolute;inset:0;z-index:850;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;color:var(--muted);text-align:center;padding:30px}
.soon .si{font-size:54px;opacity:.5}
.soon h2{font-size:18px;color:var(--text)}
.soon p{font-size:13px;max-width:440px;line-height:1.6}
.badge{background:var(--panel2);border:1px solid var(--border);color:var(--purple);font-size:11px;padding:3px 10px;border-radius:10px;font-weight:600}
.marker-lbl{background:none;border:none}
.rep-pin{background:none;border:none}
.rep-ph{width:40px;height:40px;border-radius:50%;border:3px solid #3fb950;background:#fff;box-shadow:0 1px 5px rgba(0,0,0,.55);overflow:hidden}
.rep-ph img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block}
.pop-foto{width:64px;height:64px;border-radius:50%;object-fit:cover;object-position:center top;border:3px solid var(--pc,#3fb950);float:right;margin:0 0 4px 8px;background:#fff}
/* Impresion / PDF: ocultar controles y mostrar solo el mapa + tarjetas */
@@page{margin:12mm 12.7mm}
@@media print {
  body{display:block !important}
  .side, .filters, .gear, #btn-print, #btn-excel, .leaflet-control-zoom, .overlay{display:none !important}
  .main{height:auto !important}
  .content{position:relative !important;height:640px !important}
  .topbar{border:none}
}
/* Engranaje + modal de configuracion */
.gear{background:var(--panel2);border:1px solid var(--border);color:var(--muted);border-radius:8px;width:32px;height:32px;cursor:pointer;font-size:15px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.gear:hover{border-color:var(--purple);color:var(--purple)}
.modal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:2000;align-items:center;justify-content:center}
.modal-bg.open{display:flex}
.modal{background:var(--panel);border:1px solid var(--border);border-radius:14px;padding:22px 24px;width:460px;max-width:92vw;box-shadow:0 20px 60px rgba(0,0,0,.25)}
.modal h2{font-size:16px;margin-bottom:4px}
.modal .msub{font-size:12px;color:var(--muted);margin-bottom:18px}
.cfg-sec{margin-bottom:18px}
.cfg-sec h3{font-size:12px;color:var(--purple);text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px}
.cfg-row{display:flex;align-items:center;gap:10px;margin-bottom:9px}
.cfg-row .dot{width:12px;height:12px;border-radius:50%;flex-shrink:0}
.cfg-row label{flex:1;font-size:12px;color:var(--text)}
.cfg-row input{width:84px;background:var(--panel2);border:1px solid var(--border);color:var(--text);border-radius:6px;padding:5px 8px;font-size:12px;outline:none}
.cfg-row input:focus{border-color:var(--purple)}
.cfg-row .u{font-size:11px;color:var(--muted);width:34px}
.modal-foot{display:flex;justify-content:flex-end;gap:8px;margin-top:14px}
.card.wide{min-width:200px}
.card .top3{margin-top:5px}
.card .t3{font-size:11px;padding:2px 0;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.card .t3 b{color:var(--purple);margin-right:5px}
.card .t3 .m{color:var(--muted);float:right;margin-left:6px}
/* ─── Vista «Visitas del día» (P4, 2026-10-17) ─── */
.vtbar{position:absolute;left:215px;right:112px;bottom:14px;z-index:1100;background:rgba(255,255,255,.96);border:1px solid var(--border);border-radius:12px;padding:9px 14px 6px;box-shadow:0 4px 18px rgba(0,0,0,.18);backdrop-filter:blur(4px)}
.vt-top{display:flex;justify-content:space-between;align-items:baseline;font-size:12px;margin-bottom:5px}.vt-top b{font-size:13px;color:var(--accent)}.vt-top span{color:var(--muted);font-size:11px}
.vt-row{display:flex;align-items:center;gap:12px}
#vt-play{width:38px;height:34px;border-radius:8px;border:1px solid var(--accent2);background:var(--accent2);color:#fff;font-size:16px;cursor:pointer;flex-shrink:0}
#vt-spd{display:flex;flex-shrink:0}#vt-spd button{border:1px solid var(--border);background:var(--panel2);color:var(--muted);font-size:11px;padding:6px 9px;cursor:pointer}
#vt-spd button:first-child{border-radius:6px 0 0 6px}#vt-spd button:last-child{border-radius:0 6px 6px 0}#vt-spd button+button{border-left:none}#vt-spd button.on{background:var(--accent2);border-color:var(--accent2);color:#fff;font-weight:700}
.vt-sl{flex:1;min-width:0}#vt-range{width:100%;accent-color:var(--accent2);cursor:pointer}
.vt-ticks{display:flex;justify-content:space-between;font-size:9.5px;color:var(--muted);margin-top:-2px}
.vt-dot{width:14px;height:14px;border-radius:50%;border:2px solid #fff;box-shadow:0 0 0 1px rgba(0,0,0,.4)}
.vt-card{min-width:190px}.vt-ch{display:flex;gap:6px;flex-wrap:wrap;margin:6px 0 2px}.vt-ch span{background:var(--panel2);border:1px solid var(--border);border-radius:999px;padding:1px 8px;font-size:10px;color:var(--muted)}.vt-ch b{color:var(--text)}
#fs-exit{display:none;position:absolute;top:12px;left:12px;z-index:1300;background:var(--accent2);color:#fff;border:none;border-radius:8px;padding:8px 14px;font-size:12px;font-weight:700;cursor:pointer;box-shadow:0 3px 12px rgba(0,0,0,.25)}
body.vt-fs .side,body.vt-fs .topbar,body.vt-fs .filters{display:none}
body.vt-fs #fs-exit{display:block}
@@media(max-width:900px){.vtbar{left:12px;right:12px;bottom:52px}}
</style>
</head>
<body>

<!-- ── Sidebar ── -->
<aside class="side">
  <div class="side-brand">
    <img src="@(Context.Request.PathBase)/apigeo/logo" alt="" onerror="this.style.display='none'">
    <div>
      <div class="bn" id="brand-name">AM COMERCIAL</div>
      <div class="bs">Geolocalizaciones</div>
    </div>
  </div>
  <nav class="side-nav" id="nav">
    <div class="nav-item active" data-view="ubicacion"><span class="ni-bar"></span><span class="ni-ico">&#128205;</span><span class="ni-txt">Ubicaci&oacute;n de Vendedores</span></div>
    <div class="nav-item" data-view="clientes"><span class="ni-bar"></span><span class="ni-ico">&#127968;</span><span class="ni-txt">Visitados Con / Sin Pedidos</span></div>
    <div class="nav-item" data-view="oportunidad"><span class="ni-bar"></span><span class="ni-ico">&#127919;</span><span class="ni-txt">Oportunidades por Suplidor</span></div>
    <div class="nav-item" data-view="promedio"><span class="ni-bar"></span><span class="ni-ico">&#128201;</span><span class="ni-txt">Compr&oacute; menos que el promedio</span></div>
    <div class="nav-item" data-view="fueraruta"><span class="ni-bar"></span><span class="ni-ico">&#128666;</span><span class="ni-txt">Pedidos fuera de Ruta</span></div>
    <div class="nav-item" data-view="visitas"><span class="ni-bar"></span><span class="ni-ico">&#127949;&#65039;</span><span class="ni-txt">Visitas del d&iacute;a</span></div>
  </nav>
  <div class="side-foot">
    <span class="u" id="user-nombre">&nbsp;</span>
    <div class="foot-links">
@if (ViewBag.ShowMenu as bool? != false)
{
      <a class="btn-s" href="@(Context.Request.PathBase)/menu">&#8592; Men&uacute;</a>
}
      <a class="btn-s out" href="@(Context.Request.PathBase)/account/logout">Salir</a>
    </div>
  </div>
</aside>

<!-- ── Main ── -->
<div class="main">
  <div class="topbar">
    <h1 id="view-title">Ubicaci&oacute;n de Vendedores</h1>
    <span class="sub" id="view-sub">&Uacute;ltima sincronizaci&oacute;n de cada representante</span>
    <div class="spacer"></div>
    <button class="gear" id="btn-excel" title="Exportar datos a Excel (CSV)">&#128229;</button>
    <button class="gear" id="btn-print" title="Imprimir / Guardar como PDF">&#128424;</button>
    <button class="gear" id="btn-cfg" title="Configuración de umbrales">&#9881;</button>
    <span class="clock" id="clock">--:--:--</span>
  </div>

  <div class="filters" id="filters"><!-- filtros dinamicos por vista --></div>

  <div class="content">
    <div id="map"></div>
    <div class="warns" id="warns"></div>
    <div class="cards" id="cards"></div>
    <button id="cards-toggle" onclick="document.getElementById('cards').classList.toggle('chidden');this.textContent=document.getElementById('cards').classList.contains('chidden')?'▦ Tarjetas':'▤ Ocultar';" title="Ocultar/mostrar tarjetas" style="position:absolute;bottom:16px;right:12px;z-index:1200;background:var(--panel);border:1px solid var(--border);color:var(--text);border-radius:7px;padding:5px 10px;font-size:11px;cursor:pointer;font-weight:600;box-shadow:0 2px 8px rgba(0,0,0,.12)">▤ Ocultar</button>
    <button id="fs-exit">&#9776; Mostrar filtros</button>
    <div class="vtbar" id="vt-bar" style="display:none">
      <div class="vt-top"><b id="vt-lbl">Filtro de visitas hasta las 7:00 AM</b><span id="vt-cnt"></span></div>
      <div class="vt-row">
        <button id="vt-play" title="Reproducir">&#9654;</button>
        <div id="vt-spd"><button data-s="lento" class="on">Lento</button><button data-s="medio">Medio</button><button data-s="rapido">R&aacute;pido</button></div>
        <div class="vt-sl"><input type="range" id="vt-range" min="420" max="1140" step="1" value="420"><div class="vt-ticks" id="vt-ticks"></div></div>
      </div>
    </div>
    <div class="legend" id="legend" style="display:none"></div>
    <div class="overlay" id="overlay"><div class="spin"></div></div>
    <div class="soon" id="soon" style="display:none">
      <div class="si" id="soon-icon">&#128736;</div>
      <h2 id="soon-t">En construcci&oacute;n</h2>
      <p id="soon-p">Este sub-m&oacute;dulo se conectar&aacute; en la siguiente iteraci&oacute;n.</p>
      <span class="badge" id="soon-badge">Pr&oacute;ximamente</span>
    </div>
  </div>
</div>

<!-- Modal de configuracion de umbrales -->
<div class="modal-bg" id="cfg-modal">
  <div class="modal">
    <h2>Configuración de umbrales</h2>
    <div class="msub">Define los rangos de color para cada pestaña. Se guardan en este navegador.</div>

    <div class="cfg-sec">
      <h3>Ubicación de Vendedores (tiempo de sincronización)</h3>
      <div class="cfg-row"><span class="dot" style="background:#3fb950"></span><label>En verde: menos de</label><input type="number" id="cfg-sv" min="1"><span class="u">min</span></div>
      <div class="cfg-row"><span class="dot" style="background:#e3b341"></span><label>En amarillo: hasta</label><input type="number" id="cfg-sa" min="1"><span class="u">min</span></div>
      <div class="cfg-row"><span class="dot" style="background:#f85149"></span><label>En rojo: más de (el amarillo)</label><span class="u">&nbsp;</span></div>
    </div>

    <div class="cfg-sec">
      <h3>Ubicación en la Ruta (metros)</h3>
      <div class="cfg-row"><span class="dot" style="background:#3fb950"></span><label>En verde: menos de</label><input type="number" id="cfg-rv" min="1"><span class="u">m</span></div>
      <div class="cfg-row"><span class="dot" style="background:#e3b341"></span><label>En amarillo: hasta</label><input type="number" id="cfg-ra" min="1"><span class="u">m</span></div>
      <div class="cfg-row"><span class="dot" style="background:#f85149"></span><label>En rojo: más de (el amarillo)</label><span class="u">&nbsp;</span></div>
    </div>

    <div class="modal-foot">
      <button class="btn-clear" id="cfg-cancel">Cancelar</button>
      <button class="btn-ref" id="cfg-save">Guardar</button>
    </div>
  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
const BASE = '@Context.Request.PathBase.Value';
const $ = s => document.querySelector(s);

/* ── Reloj ── */
setInterval(()=>{ $('#clock').textContent = new Date().toLocaleTimeString('es-DO'); },1000);

/* ── Empresa / usuario ── */
fetch(BASE+'/apigeo/me').then(r=>r.json()).then(j=>{ if(j&&j.ok) $('#user-nombre').textContent=j.nombre||j.login; }).catch(()=>{});
