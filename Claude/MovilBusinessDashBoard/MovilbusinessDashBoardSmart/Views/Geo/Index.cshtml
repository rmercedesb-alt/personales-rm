/* ── Configuracion de umbrales (persistida en localStorage) ── */
const CFG_DEF = { sync:{verde:30, amarillo:45}, ruta:{verde:400, amarillo:1000} };
let CFG = loadCfg();
function loadCfg(){
  try{ const s=JSON.parse(localStorage.getItem('geoCfg')); if(s&&s.sync&&s.ruta) return s; }catch(e){}
  return JSON.parse(JSON.stringify(CFG_DEF));
}
function saveCfg(){ localStorage.setItem('geoCfg', JSON.stringify(CFG)); }
function openCfg(){
  $('#cfg-sv').value=CFG.sync.verde; $('#cfg-sa').value=CFG.sync.amarillo;
  $('#cfg-rv').value=CFG.ruta.verde; $('#cfg-ra').value=CFG.ruta.amarillo;
  $('#cfg-modal').classList.add('open');
}
function closeCfg(){ $('#cfg-modal').classList.remove('open'); }
document.addEventListener('DOMContentLoaded',()=>{});
$('#btn-cfg').onclick=openCfg;
$('#cfg-cancel').onclick=closeCfg;
$('#cfg-modal').onclick=e=>{ if(e.target.id==='cfg-modal') closeCfg(); };
$('#cfg-save').onclick=()=>{
  const sv=+$('#cfg-sv').value||CFG_DEF.sync.verde, sa=+$('#cfg-sa').value||CFG_DEF.sync.amarillo;
  const rv=+$('#cfg-rv').value||CFG_DEF.ruta.verde, ra=+$('#cfg-ra').value||CFG_DEF.ruta.amarillo;
  CFG={ sync:{verde:sv, amarillo:Math.max(sa,sv)}, ruta:{verde:rv, amarillo:Math.max(ra,rv)} };
  saveCfg(); closeCfg();
  if(state.view==='ubicacion') loadUbicacion();
};
/* Color segun umbrales configurables */
function colorSync(min){ return min < CFG.sync.verde ? '#3fb950' : (min <= CFG.sync.amarillo ? '#e3b341' : '#f85149'); }
function colorRuta(d){ if(d==null) return '#8b949e'; return d < CFG.ruta.verde ? '#3fb950' : (d <= CFG.ruta.amarillo ? '#e3b341' : '#f85149'); }

/* ── Exportar a Excel (CSV con BOM) e Imprimir/PDF ── */
function downloadCSV(name, headers, rows){
  const esc=s=>'"'+String(s==null?'':s).replace(/"/g,'""')+'"';
  const lines=[headers.map(esc).join(',')].concat(rows.map(r=>r.map(esc).join(',')));
  const blob=new Blob(['﻿'+lines.join('\r\n')],{type:'text/csv;charset=utf-8;'});
  const a=document.createElement('a'); a.href=URL.createObjectURL(blob);
  // OJO: NUNCA usar Date.toISOString() para "hoy" — convierte a UTC antes de formatear,
  // y RD es UTC-4 sin horario de verano, así que después de las 8:00 PM ya "es mañana"
  // en UTC (bug real encontrado 2026-09-03).
  const hoyLocal=(()=>{const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');})();
  a.download=name+'_'+hoyLocal+'.csv';
  document.body.appendChild(a); a.click(); a.remove();
}
function exportExcel(){
  const v=state.view;
  if(v==='ubicacion' && V.lastUbic){
    downloadCSV('ubicacion_vendedores',['Rep','Nombre','Cargo','Supervisor','Centro','Latitud','Longitud','Sync','DistanciaRutaM','ClienteCercano'],
      V.lastUbic.reps.map(r=>[r.RepCodigo,r.RepNombre,r.RepCargo,r.SupervisorNombre,r.CentroNombre,r.Latitud,r.Longitud,r.Sync,(r.MinDistM!=null?r.MinDistM:''),(r.NearCliNombre||'')])); return;
  }
  if(v==='clientes' && V.lastClientesData){
    downloadCSV('visitados_con_sin_pedidos',['Codigo','Cliente','Rep','Vendedor','Estado','Comentario','Latitud','Longitud'],
      V.lastClientesData.clientes.map(r=>{const e=estadoCliente(r);return [r.CliID,r.Nombre,r.RepCodigo,(REPMAP[r.RepCodigo]||''),e.txt,(r.Comentario||''),r.Latitud,r.Longitud];})); return;
  }
  if(v==='oportunidad'){
    if(V.modoOp==='recuperados' && V.lastRecup && V.lastRecup.clientes){
      downloadCSV('clientes_retencion',['Codigo','Cliente','Rep','Vendedor','Estado','UnidadesActivo','ValorBrutoActivo','Latitud','Longitud'],
        V.lastRecup.clientes.map(r=>[r.CliID,r.Nombre,r.RepCodigo,(REPMAP[r.RepCodigo]||''),(EST_REC_TXT[r.Estado]||r.Estado),Math.round(r.Unidades),Math.round(r.ValorBruto),r.Latitud,r.Longitud])); return;
    }
    if(V.lastOport && V.lastOport.clientes){
      downloadCSV('oportunidades_suplidor',['Codigo','Cliente','Rep','Vendedor','Estado','Unidades','ValorBruto','Latitud','Longitud'],
        V.lastOport.clientes.map(r=>[r.CliID,r.Nombre,r.RepCodigo,(REPMAP[r.RepCodigo]||''),(r.Compra?'Si pidio':'Oportunidad perdida'),Math.round(r.Unidades||0),Math.round(r.ValorBruto||0),r.Latitud,r.Longitud])); return;
    }
  }
  if(v==='visitas' && VT.data){
    downloadCSV('visitas_del_dia',['Fecha','Hora','Rep','Vendedor','Cliente','Nombre','Tipo','Efectiva','Monto','DistanciaM','FueraLugar','FueraRuta'],
      VT.data.visitas.map(r=>[VT.data.fecha,r.hora.slice(11,19),r.rep,r.repNombre,r.cli,r.nombre,(r.tipo==='2'?'Virtual':'Presencial'),(r.efectiva?'Si':'No'),Math.round(r.monto),(r.dist==null?'':r.dist),(r.fueraLugar?'Si':'No'),(r.enRuta?'No':'Si')])); return;
  }
  if(v==='fueraruta' && V.lastFR){
    downloadCSV('pedidos_fuera_ruta',['Codigo','Cliente','Rep','Vendedor','Supervisor','PedidosFueraRuta','UltimoPedido','Latitud','Longitud'],
      V.lastFR.clientes.map(r=>[r.CliID,r.Nombre,r.RepCodigo,(r.RepNombre||''),(r.SupNombre||''),r.Pedidos,(r.UltPedido||''),r.Latitud,r.Longitud])); return;
  }
  alert('No hay datos cargados para exportar en esta vista.');
}
$('#btn-excel').onclick=exportExcel;
