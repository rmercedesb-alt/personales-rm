/* ── 4. Representantes: Centro › Supervisor › Vendedor, y debajo de cada uno TODAS las promociones que le aplican ── */
function ofRepNivel(){
  let lista=OFDATA.centros||[], nivel='centro'; const padres=[];
  for(const p of OF_REPPATH){
    const n=lista.find(z=>z.Clave===p.clave); if(!n) break; padres.push(n);
    if(nivel==='centro'){ lista=n.Hijos; nivel='supervisor'; } else if(nivel==='supervisor'){ lista=n.Hijos; nivel='vendedor'; } else { lista=[n]; nivel='hoja'; }
  }
  return {lista,nivel,padres};
}
function ofRepDrill(clave,nombre){ OF_REPPATH.push({clave,nombre}); OF_SORT=null; OF_COLAPSO=null; ofRenderActual(); }
function ofRepIr(i){ OF_REPPATH=OF_REPPATH.slice(0,i); OF_SORT=null; OF_COLAPSO=null; ofRenderActual(); }
function ofColapsar(si){ OF_COLAPSO=si?new Set(ofRepNivel().lista.map(e=>e.Clave)):new Set(); ofRenderActual(); }
function ofCeros(v){ OF_CEROS=v; ofRenderActual(); }
function ofToggleBloque(clave){ if(!OF_COLAPSO) OF_COLAPSO=new Set(); OF_COLAPSO.has(clave)?OF_COLAPSO.delete(clave):OF_COLAPSO.add(clave); ofRenderActual(); }
function ofRenderReps(){
  const x=OFT(); const {lista,nivel,padres}=ofRepNivel();
  const nombreNivel={centro:'Centro de distribución',supervisor:'Supervisor',vendedor:'Vendedor',hoja:'Vendedor'}[nivel];
  let c=OF_REPPATH.length?'<span class="crumb" onclick="ofRepIr(0)">‹ Todos los centros</span>':'<span class="crumb cur">Todos los centros</span>';
  padres.forEach((p,i)=>{ c+=' › '+(i===padres.length-1?'<span class="crumb cur">'+ofEsc(p.Nombre)+'</span>':'<span class="crumb" onclick="ofRepIr('+(i+1)+')">'+ofEsc(p.Nombre)+'</span>'); });
  $('#of-crumbs').innerHTML=c;
  $('#of-tarjetas').innerHTML='';
  const tot=lista.reduce((a,e)=>{ a.d+=e.Dadas; a.m+=e.Monto; a.u+=e.Unidades; a.md+=e.MontoPromo; a.v+=e.Vendedores; return a; },{d:0,m:0,u:0,md:0,v:0});
  const cli=lista.reduce((a,e)=>a+e.Clientes,0);   // referencia (suma por entidad; un cliente puede repetirse entre entidades)
  $('#of-cards').innerHTML=card(nombreNivel+(lista.length===1?'':'s'),fmtN(lista.length),OF_REPPATH.length?'dentro de '+ofEsc(padres[padres.length-1].Nombre):'en alcance')+
    card(x.dadas,fmtN(tot.d),'suma de lo listado')+card('Clientes impactados',fmtN(cli),'suma por '+nombreNivel.toLowerCase())+card(x.monto,fmtRD(tot.m),x.montoTip)+
    card(x.extra,x.extraRD?fmtRD(tot.md):fmtN(tot.u),'')+card(x.P+' en alcance',fmtN(OFDATA.promosEnAlcance),'según los filtros');
  if(!lista.length){ $('#of-tabla').innerHTML='<div class="hint">Sin datos con esos filtros.</div>'; return; }
  // por defecto: todo desplegado salvo que haya demasiadas filas (se arranca contraído y se expande lo que se quiera ver)
  if(OF_COLAPSO===null){ const filas=lista.reduce((a,e)=>a+e.Promos.length,0); OF_COLAPSO=filas>250?new Set(lista.map(e=>e.Clave)):new Set(); }
  const accE={nombre:e=>e.Nombre,vendedores:e=>e.Vendedores,aplican:e=>e.PromosAplican,dadas:e=>e.Dadas,clientes:e=>e.Clientes,monto:e=>e.Monto,extra:e=>x.extraRD?e.MontoPromo:e.Unidades};
  const accP={nombre:p=>p.Promo,dadas:p=>p.Dadas,clientes:p=>p.Clientes,monto:p=>p.Monto,extra:p=>x.extraRD?p.MontoPromo:p.Unidades};
  let h='<table><thead><tr>'+ofTh('nombre',nombreNivel+' / '+x.Sing,'l')+ofTh('vendedores','Vendedores')+ofTh('aplican',x.P+' que aplican')+ofTh('dadas',x.dadas)+ofTh('clientes','Clientes impactados')+ofTh('monto',x.monto,'',x.montoTip)+ofTh('extra',x.extra)+'</tr></thead><tbody>';
  ofOrdenar(lista,accE,{key:'dadas',dir:-1}).forEach(e=>{
    const col=OF_COLAPSO.has(e.Clave);
    const drill=nivel!=='hoja';
    h+='<tr class="of-ent"><td class="l"><span class="of-caret" onclick="ofToggleBloque(\''+ofEsc(e.Clave).replace(/\\/g,'\\\\')+'\')" title="Contraer/expandir">'+(col?'▸':'▾')+'</span>'+
       (drill?'<a onclick="ofRepDrill(\''+ofEsc(e.Clave).replace(/\\/g,'\\\\')+'\',\''+ofEsc(e.Nombre).replace(/\\/g,'\\\\')+'\')" title="Clic para bajar un nivel">'+ofEsc(e.Nombre)+' ›</a>':ofEsc(e.Nombre))+
       (e.Sub?'<span class="mini"> · '+ofEsc(e.Sub)+'</span>':'')+'</td><td>'+fmtN(e.Vendedores)+'</td><td>'+fmtN(e.PromosUsadas)+' usadas de '+fmtN(e.PromosAplican)+'</td><td>'+fmtN(e.Dadas)+'</td><td>'+fmtN(e.Clientes)+'</td><td>'+fmtRD(e.Monto)+'</td><td>'+(x.extraRD?fmtRD(e.MontoPromo):fmtN(e.Unidades))+'</td></tr>';
    if(col) return;
    let ps=e.Promos; const maxD=ps.length?Math.max(...ps.map(p=>p.Dadas)):0, minD=ps.length?Math.min(...ps.map(p=>p.Dadas)):0;
    if(!OF_CEROS) ps=ps.filter(p=>p.Dadas>0);
    ofOrdenar(ps,accP,{key:'dadas',dir:-1}).forEach(p=>{
      const mas=maxD>0&&p.Dadas===maxD&&minD<maxD, menos=minD<maxD&&p.Dadas===minD;
      h+='<tr class="of-pr'+(mas?' of-mas':menos?' of-menos':'')+(p.Dadas===0?' of-cero':'')+'"><td class="l">'+ofEsc(p.Promo)+(mas?'<span class="of-tag m">▲ más usada</span>':menos?'<span class="of-tag n">▼ menos usada</span>':'')+' <span class="of-badge '+ofEstadoCls(p.Estado)+'" style="font-size:9px">'+ofEsc(p.Estado)+'</span></td><td></td><td></td><td>'+fmtN(p.Dadas)+ofBar(maxD?p.Dadas*100/maxD:0)+'</td><td>'+fmtN(p.Clientes)+'</td><td>'+fmtRD(p.Monto)+'</td><td>'+(x.extraRD?fmtRD(p.MontoPromo):fmtN(p.Unidades))+'</td></tr>';
    });
  });
  $('#of-tabla').innerHTML=h+'</tbody></table><div class="hint" style="margin-top:8px">'+(nivel==='hoja'?'':'👆 Clic en el nombre para bajar de nivel ('+(nivel==='centro'?'supervisores':nivel==='supervisor'?'vendedores':'detalle del vendedor')+'). ')+'Bajo cada uno se listan <b>todas</b> las '+x.p+' que le aplican (ordenadas de la más a la menos usada; verde = la más usada, ámbar = la menos usada). ▾/▸ contrae o expande el bloque.</div>'+ofHintOrden;
}

/* ── Excel / PDF (exportan lo que se está viendo) ── */
function excelOF(){
  if(!OFDATA){ alert('Genera el informe primero.'); return; }
  const x=OFT(), j=OFDATA;
  ensureXLSX(()=>{
    const titulo=EMP+' — '+x.P+' · '+ofNomVista();
    const head=[[titulo],['Rango',$('#of-ini').value+' a '+$('#of-fin').value],['Generado',new Date().toLocaleString('es-DO')],[]];
    let H, rows, hoja='Detalle', extraHojas=[];
    if(OF_VISTA==='lista'){
      H=['ID','Nombre','Inicio','Fin','Estado','Suplidor','Categoría(s)','Canal','Centro de distribución','Vendedores que aplican'];
      rows=ofOrdenar(j.filas||[],{nombre:r=>r.Nombre,inicio:r=>r.Inicio,fin:r=>r.Fin||'9999',estado:r=>r.Estado,suplidor:r=>r.Suplidor,categoria:r=>r.Categoria,canal:r=>r.Canal,centro:r=>r.Centro,vendedores:r=>r.Vendedores},null)
        .map(r=>[r.Id,r.Nombre,r.Inicio,r.Fin,r.Estado,r.Suplidor,r.Categoria,r.Canal,r.Centro,r.Vendedores]);
    } else if(OF_VISTA==='dadas' && OF_DRILL && OF_DRILL.clientes){
      const d=OF_DRILL.clientes; hoja='Clientes del día';
      head.push(['Vendedor',OF_DRILL.nom],['Fecha',d.fecha],[]);
      H=['Código cliente','Cliente',x.Sing,x.dadas,x.monto,x.extra,'Pedido(s)'];
      rows=d.filas.map(r=>[r.CliCodigo,r.CliNombre,r.Promo,r.Dadas,r.Monto,x.extraRD?r.MontoPromo:r.Unidades,r.Pedidos]);
    } else if(OF_VISTA==='dadas' && OF_DRILL && OF_DRILL.dias){
      const d=OF_DRILL.dias; hoja='Por día';
      head.push(['Vendedor',OF_DRILL.nom],[]);
      H=['Fecha',x.dadas,x.P+' distintas','Clientes impactados',x.monto,x.extra];
      rows=d.filas.map(r=>[r.Fecha,r.Dadas,r.Promos,r.Clientes,r.Monto,x.extraRD?r.MontoPromo:r.Unidades]);
    } else if(OF_VISTA==='dadas'){
      H=['Nivel','Supervisor','Código vendedor','Vendedor','Centro',x.Sing,x.dadas,'Clientes impactados',x.monto,x.extra,'Clientes asignados','Incidencia %'];
      rows=(j.filas||[]).map(r=>[r.Nivel,r.Supervisor,r.RepCodigo,r.Vendedor,r.Centro,r.Promo,r.Dadas,r.Clientes,r.Monto,x.extraRD?r.MontoPromo:r.Unidades,r.Asignados,r.IncidenciaPct]);
    } else if(OF_VISTA==='productividad'){
      H=['#','ID',x.Sing,'Inicio','Fin','Estado','Suplidor','Días vigente en rango',x.dadas,'Clientes impactados',x.monto,x.extra,'Vendedores que la dieron','Vendedores a quienes aplica','Cobertura %'];
      rows=(j.promos||[]).map((p,i)=>[i+1,p.Id,p.Nombre,p.Inicio,p.Fin,p.Estado,p.Suplidor,p.DiasVigentes,p.Dadas,p.Clientes,p.Monto,x.extraRD?p.MontoPromo:p.Unidades,p.VendedoresQueDieron,p.Elegibles,p.CoberturaPct]);
      if(j.tarjetas){
        const T=j.tarjetas, vend=a=>[a.RepCodigo,a.Vendedor,a.Supervisor,a.Centro,a.Dadas,a.Clientes,a.Monto,a.Pedidos];
        extraHojas.push(['Top y Last',[['TOP 5 VENDEDORES'],['Código','Vendedor','Supervisor','Centro','Dadas','Clientes','Monto','Pedidos']].concat((T.topVendedores||[]).map(vend))
          .concat([[],['LAST 5 VENDEDORES (con pedidos en el rango)'],['Código','Vendedor','Supervisor','Centro','Dadas','Clientes','Monto','Pedidos']]).concat((T.lastVendedores||[]).map(vend))
          .concat([[],['TOP 3 '+x.P.toUpperCase()],['ID','Nombre','Dadas','Clientes','Monto']]).concat((T.topPromos||[]).map(p=>[p.Id,p.Nombre,p.Dadas,p.Clientes,p.Monto]))
          .concat([[],['LAST 3 '+x.P.toUpperCase()],['ID','Nombre','Dadas','Clientes','Monto']]).concat((T.lastPromos||[]).map(p=>[p.Id,p.Nombre,p.Dadas,p.Clientes,p.Monto]))]);
      }
    } else {
      const {lista,nivel}=ofRepNivel(); hoja='Representantes'; rows=[];
      head.push(['Ruta',['Todos'].concat(OF_REPPATH.map(p=>p.nombre)).join(' › ')],[]);
      H=[{centro:'Centro',supervisor:'Supervisor',vendedor:'Vendedor',hoja:'Vendedor'}[nivel],'Fila',x.Sing,'Estado',x.dadas,'Clientes impactados',x.monto,x.extra,'Vendedores',x.P+' que aplican'];
      lista.forEach(e=>{
        rows.push([e.Nombre,'TOTAL','','',e.Dadas,e.Clientes,e.Monto,x.extraRD?e.MontoPromo:e.Unidades,e.Vendedores,e.PromosAplican]);
        e.Promos.forEach(p=>rows.push([e.Nombre,x.Sing,p.Promo,p.Estado,p.Dadas,p.Clientes,p.Monto,x.extraRD?p.MontoPromo:p.Unidades,'','']));
      });
    }
    const wb=XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(head.concat([H]).concat(rows)),hoja);
    extraHojas.forEach(([n,aoa])=>XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(aoa),n));
    XLSX.writeFile(wb,x.p+'_'+OF_VISTA+'_'+$('#of-ini').value+'.xlsx');
  });
}
