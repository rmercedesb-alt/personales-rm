/* ── 2. Cantidad dadas: Supervisor › Vendedor › (clic) días › (clic) clientes y promociones del día ── */
function ofArbolDadas(filas){
  const sups=[]; let total=null, sup=null, ven=null;
  filas.forEach(r=>{
    if(r.Nivel==='supervisor'){ sup={r,vends:[]}; sups.push(sup); }
    else if(r.Nivel==='vendedor'){ ven={r,promos:[]}; sup.vends.push(ven); }
    else if(r.Nivel==='promo'){ ven.promos.push(r); }
    else if(r.Nivel==='total'){ total=r; }
  });
  return {sups,total};
}
