<!-- ═══════════ OFERTAS Y DESCUENTOS (pedido explícito 2026-10-04 / ampliado 2026-10-05) ═══════════
     Bloque autocontenido: HTML + estilos + JS. Reutiliza las utilidades globales de Index.cshtml
     ($, BASE, multiselect, multiselectCliente, prDepend, prFiltros, AOPT, CANAL_DEF, overlay, fmtN, fmtRD, card,
     ncFechaFmt, ensureXLSX, histExportarPDF, dateF, EMP). Se inicializa desde ofInit() (llamada en el init de Index).
     OJO: Index.cshtml comparte CSS global — todas las clases de este bloque llevan prefijo "of-" (una clase ".top"
     sin prefijo ya rompió el layout una vez). -->
<style>
.of-bar{display:inline-block;width:64px;height:7px;background:var(--panel2);border-radius:4px;vertical-align:middle;margin-left:6px;overflow:hidden}
.of-bar i{display:block;height:100%;background:var(--accent2);border-radius:4px}
.of-bar.bad i{background:var(--warn)}
.of-badge{display:inline-block;padding:1px 9px;border-radius:10px;font-size:11px;font-weight:700}
.of-b-Activa{background:var(--good-bg);color:#1c6b32}.of-b-Programada{background:var(--purple-bg);color:var(--purple)}
.of-b-Finalizada{background:var(--panel2);color:var(--muted)}.of-b-Fuera{background:var(--warn-bg);color:#8a5d00}
.of-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(330px,1fr));gap:12px;margin-bottom:14px}
.of-box{background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:10px 12px}
.of-box h4{font-size:12px;margin-bottom:6px;display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.of-box h4 small{font-weight:400;color:var(--muted);font-size:10px}
.of-box.of-top{border-top:3px solid var(--good)}.of-box.of-last{border-top:3px solid var(--warn)}
.of-li{display:flex;align-items:center;gap:8px;padding:5px 0;border-bottom:1px solid var(--line);font-size:12px}
.of-li:last-child{border-bottom:none}
.of-li .n{width:18px;height:18px;border-radius:50%;background:var(--panel2);color:var(--muted);font-size:10px;font-weight:800;display:flex;align-items:center;justify-content:center;flex:none}
.of-box.of-top .of-li .n{background:var(--good-bg);color:#1c6b32}.of-box.of-last .of-li .n{background:var(--warn-bg);color:#8a5d00}
.of-li .nm{flex:1;min-width:0}.of-li .nm b{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.of-li .nm span{font-size:10px;color:var(--muted)}
.of-li .v{font-weight:800;text-align:right;white-space:nowrap}.of-li .v small{display:block;font-weight:400;color:var(--muted);font-size:10px}
tr.of-sup td{background:var(--panel2);font-weight:800;border-top:1px solid var(--border)}
tr.of-promo td{color:var(--muted);font-size:11px;background:#FCFDFC}
tr.of-promo td.l{padding-left:46px}
td.l.of-v{padding-left:24px}
th.of-sortable{cursor:pointer;user-select:none}th.of-sortable:hover{color:var(--accent2);text-decoration:underline}
tr.of-click{cursor:pointer}tr.of-click:hover td{background:#EEF3FF}
/* Representantes: bloque por entidad (Centro/Supervisor/Vendedor) con sus promociones debajo */
tr.of-ent td{background:var(--panel2);font-weight:800;border-top:2px solid var(--border)}
tr.of-ent td.l a{color:var(--accent);font-weight:800}
tr.of-pr td{font-size:11.5px;background:#FCFDFC}
tr.of-pr td.l{padding-left:40px}
tr.of-pr.of-mas td{background:var(--good-bg)}tr.of-pr.of-menos td{background:var(--warn-bg)}
tr.of-pr.of-cero td.l{color:var(--muted)}
.of-caret{cursor:pointer;display:inline-block;width:16px;color:var(--muted);user-select:none}
.of-tag{display:inline-block;margin-left:6px;padding:0 7px;border-radius:9px;font-size:10px;font-weight:700}
.of-tag.m{background:var(--good);color:#fff}.of-tag.n{background:var(--warn);color:#fff}
.of-ctl{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:0 0 8px;font-size:12px}
.of-ctl label{display:flex;align-items:center;gap:5px;cursor:pointer;color:var(--muted)}
#of-crumbs:empty{display:none}
@@media print{#t-promos .filtros,#t-promos .hist-toolbar,#t-promos .of-ctl{display:none}}
</style>

<div class="wrap hide" id="t-promos">
  <div class="hist-toolbar" style="justify-content:space-between">
    <div class="nivelbar" style="margin:0">
      <button class="btn-modo on" id="of-tipo-ofertas" onclick="ofTipo('ofertas')">🎁 Ofertas</button>
      <button class="btn-modo" id="of-tipo-descuentos" onclick="ofTipo('descuentos')">🏷 Descuentos</button>
    </div>
    <div class="seg" id="of-vista-seg">
      <button class="on" id="of-v-lista" onclick="ofVista('lista')">Lista activas</button>
      <button id="of-v-dadas" onclick="ofVista('dadas')">Cantidad dadas</button>
      <button id="of-v-productividad" onclick="ofVista('productividad')">Productividad</button>
      <button id="of-v-representantes" onclick="ofVista('representantes')">Representantes</button>
    </div>
  </div>
  <div class="filtros">
    <div class="fld"><span class="lbl">Desde</span><input type="date" id="of-ini"></div>
    <div class="fld"><span class="lbl">Hasta</span><input type="date" id="of-fin"></div>
    <div><span class="lbl" id="of-promo-lbl">Oferta(s)</span><div id="ofms-promo"></div></div>
    <div><span class="lbl">Estado</span><div id="ofms-estado"></div></div>
    <div class="fld"><span class="lbl">&nbsp;</span><button class="btn" onclick="ofSeleccionarTodas()" title="Selecciona todas las del selector (según el rango y los filtros)">Seleccionar todas</button></div>
    <div><span class="lbl">Centro</span><div id="ofms-centro"></div></div>
    <div><span class="lbl">Supervisor</span><div id="ofms-sup"></div></div>
    <div><span class="lbl">Vendedor</span><div id="ofms-ven"></div></div>
    <div><span class="lbl">División</span><div id="ofms-div"></div></div>
    <div><span class="lbl">Canal</span><div id="ofms-canal"></div></div>
    <div><span class="lbl">Suplidor</span><div id="ofms-suplidor"></div></div>
    <div><span class="lbl">Categoría</span><div id="ofms-categoria"></div></div>
    <div><span class="lbl">Grupo Producto</span><div id="ofms-grupo"></div></div>
    <div><span class="lbl">Producto</span><div id="ofms-producto"></div></div>
    <div><span class="lbl">Grupo Clientes</span><div id="ofms-grupocli"></div></div>
    <div><span class="lbl">Tamaño</span><div id="ofms-tam"></div></div>
    <div><span class="lbl">Cliente</span><div id="ofms-cliente"></div></div>
    <div><span class="lbl">Estatus pedido</span><div id="ofms-estatus"></div></div>
    <div class="fld hide" id="of-det-wrap"><span class="lbl">Detalle</span>
      <select class="sel" id="of-detalle"><option value="">Supervisor › Vendedor</option><option value="promo">Supervisor › Vendedor › Oferta</option></select></div>
    <button class="btn btn-go" onclick="generarOF()">Generar</button>
    <button class="btn" onclick="window.print()">🖨 Imprimir</button>
    <button class="btn" onclick="excelOF()">📥 Excel</button>
    <button class="btn" id="of-btn-pdf" onclick="pdfOF()">⬇ PDF</button>
  </div>
  <div id="of-print-head"></div>
  <div class="cards" id="of-cards"></div>
  <div id="of-tarjetas"></div>
  <div class="crumbs" id="of-crumbs"></div>
  <div class="of-ctl hide" id="of-rep-ctl">
    <button class="btn" onclick="ofColapsar(true)">⊟ Contraer todo</button>
    <button class="btn" onclick="ofColapsar(false)">⊞ Expandir todo</button>
    <label><input type="checkbox" id="of-ceros" checked onchange="ofCeros(this.checked)"> Incluir las no utilizadas (para ver cuál usan menos)</label>
  </div>
  <div style="overflow:auto;max-height:62vh"><div id="of-tabla"><div class="hint">Elige el rango y presiona <b>Generar</b>.</div></div></div>
</div>

<script>
const ofEsc=s=>String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let OF_TIPO='ofertas', OF_VISTA='lista', OFMS={}, OFDATA=null, OF_OPT_T=null, OF_OPT_SIG='';
let OF_SORT=null, OF_QS='', OF_DRILL=null, OF_REPPATH=[], OF_CEROS=true, OF_COLAPSO=null;
// Textos según el modo (Ofertas / Descuentos)
const OFT=()=>OF_TIPO==='ofertas'
  ? {s:'oferta',p:'ofertas',P:'Ofertas',Sing:'Oferta',dadas:'Ofertas dadas',monto:'Monto generado',montoTip:'Dinero vendido de productos que tenían la oferta',extra:'Unidades regaladas',extraKey:'Unidades',extraRD:false,
     vLista:'Lista activas',vDadas:'Cantidad dadas',vProd:'Productividad',vRep:'Representantes',sel:'Oferta(s)',f:'a'}
  : {s:'descuento',p:'descuentos',P:'Descuentos',Sing:'Descuento',dadas:'Descuentos dados',monto:'Venta con descuento',montoTip:'Dinero vendido de las líneas que llevaban el descuento',extra:'Monto descontado',extraKey:'MontoPromo',extraRD:true,
     vLista:'Lista activos',vDadas:'Cantidad dados',vProd:'Productividad',vRep:'Representantes',sel:'Descuento(s)',f:'o'};
const ofPct=v=>(v==null?0:v).toLocaleString('es-DO',{minimumFractionDigits:1,maximumFractionDigits:1})+'%';
const ofBar=(pct,bad)=>'<span class="of-bar'+(bad?' bad':'')+'"><i style="width:'+Math.max(0,Math.min(100,pct))+'%"></i></span>';
const ofEstadoCls=e=>'of-b-'+String(e||'').split(' ')[0];
const ofNomVista=()=>({lista:OFT().vLista,dadas:OFT().vDadas,productividad:OFT().vProd,representantes:OFT().vRep}[OF_VISTA]);
const ofExtra=(r)=>OFT().extraRD?fmtRD(r[OFT().extraKey]):fmtN(r[OFT().extraKey]);

function ofInit(j,centros,divis){
  const mk=(id,label,opts,cb)=>{ const h=$('#'+id); return h?multiselect(h,label,opts,cb):null; };
  OFMS.centro=mk('ofms-centro','Centro',centros,()=>prDepend('ofms',OFMS));
  OFMS.sup=mk('ofms-sup','Supervisor',[],()=>prDepend('ofms',OFMS));
  OFMS.ven=mk('ofms-ven','Vendedor',[]);
  OFMS.div=mk('ofms-div','División',divis);
  OFMS.canal=mk('ofms-canal','Canal',AOPT.canal); OFMS.canal.select(CANAL_DEF);
  OFMS.suplidor=mk('ofms-suplidor','Suplidor',AOPT.suplidor);
  OFMS.categoria=mk('ofms-categoria','Categoría',AOPT.categoria);
  OFMS.grupo=mk('ofms-grupo','Grupo',AOPT.grupo);
  OFMS.producto=mk('ofms-producto','Producto',AOPT.producto);
  OFMS.grupoCliente=mk('ofms-grupocli','Grupo Clientes',AOPT.gruposCliente);
  OFMS.tam=mk('ofms-tam','Tamaño',AOPT.tam);
  OFMS.cliente=multiselectCliente($('#ofms-cliente'),'Cliente');
  OFMS.estatus=multiselect($('#ofms-estatus'),'Estatus',(j.estatusPedido||[]).map(x=>({v:String(x.id),t:x.id+' - '+x.nombre})));
  OFMS.estatus.select(['2','7','11']);
  OFMS.estado=mk('ofms-estado','Todos',[{v:'Activa',t:'Activas (vigentes hoy)'},{v:'Finalizada',t:'Finalizadas'},{v:'Programada',t:'Programadas (aún no empiezan)'}],ofCargarOpcionesDebounced);
  OFMS.promo=mk('ofms-promo','Oferta(s)',[]);
  prDepend('ofms',OFMS);
  const hoy=new Date(); $('#of-ini').value=dateF(new Date(hoy.getFullYear(),hoy.getMonth(),1)); $('#of-fin').value=dateF(hoy);
  ['of-ini','of-fin'].forEach(id=>$('#'+id).addEventListener('change',ofCargarOpcionesDebounced));
  ofCargarOpciones();
}

/* ── Modo y vista ── */
function ofTipo(t){
  OF_TIPO=t; OFDATA=null; OF_DRILL=null; OF_SORT=null; OF_REPPATH=[];
  $('#of-tipo-ofertas').classList.toggle('on',t==='ofertas'); $('#of-tipo-descuentos').classList.toggle('on',t==='descuentos');
  const x=OFT();
  $('#of-v-lista').textContent=x.vLista; $('#of-v-dadas').textContent=x.vDadas;
  $('#of-promo-lbl').textContent=x.sel;
  const bt=$('#ofms-promo .ms-btn span'); if(bt) bt.textContent=x.sel;
  $('#of-detalle').options[1].textContent='Supervisor › Vendedor › '+x.Sing;
  OFMS.promo.select([]);
  ofLimpiar(); ofCargarOpciones();
}
function ofSetVistaUI(){
  ['lista','dadas','productividad','representantes'].forEach(k=>$('#of-v-'+k).classList.toggle('on',k===OF_VISTA));
  $('#of-det-wrap').classList.toggle('hide',OF_VISTA!=='dadas');
  $('#of-rep-ctl').classList.toggle('hide',OF_VISTA!=='representantes');
}
function ofVista(v){
  OF_VISTA=v; OFDATA=null; OF_DRILL=null; OF_SORT=null; OF_REPPATH=[]; OF_COLAPSO=null;
  ofSetVistaUI(); ofLimpiar();
}
function ofLimpiar(){
  $('#of-cards').innerHTML=''; $('#of-tarjetas').innerHTML=''; $('#of-print-head').innerHTML=''; $('#of-crumbs').innerHTML='';
  const x=OFT();
  $('#of-tabla').innerHTML='<div class="hint">'+(OF_VISTA==='dadas'?'Elige el rango, selecciona '+(OF_TIPO==='ofertas'?'una o varias ofertas':'uno o varios descuentos')+' en «'+x.sel+'» y presiona <b>Generar</b>.':'Elige el rango y presiona <b>Generar</b>.')+'</div>';
}

/* ── Consulta ── */
function ofQs(vista){
  const p=new URLSearchParams();
  p.set('tipo',OF_TIPO); p.set('vista',vista||OF_VISTA);
  p.set('fechaIni',$('#of-ini').value); p.set('fechaFin',$('#of-fin').value);
  prFiltros(OFMS,p);
  if(OFMS.cliente&&OFMS.cliente.values().length) p.set('clientes',OFMS.cliente.values().join(','));
  if(OFMS.estatus&&OFMS.estatus.values().length) p.set('estatus',OFMS.estatus.values().join(','));
  if(OFMS.estado&&OFMS.estado.values().length) p.set('estados',OFMS.estado.values().join(','));
  return p;
}
// Opciones del selector de ofertas/descuentos: las del rango con los mismos filtros (SIN la selección actual)
function ofCargarOpciones(){
  const t=OF_TIPO, qs=ofQs('lista'), sig=qs.toString();
  return fetch(BASE+'/apihist/promos?'+sig).then(r=>r.json()).then(j=>{
    if(t!==OF_TIPO||!j||!j.ok) return;
    OF_OPT_SIG=sig;
    OFMS.promo.setOptions((j.filas||[]).map(f=>({v:String(f.Id),t:f.Id+' - '+f.Nombre+' ('+(f.Inicio||'').slice(5)+' → '+((f.Fin||'').slice(5)||'…')+')'})));
  }).catch(()=>{});
}
function ofCargarOpcionesDebounced(){ clearTimeout(OF_OPT_T); OF_OPT_T=setTimeout(ofCargarOpciones,400); }
function ofSeleccionarTodas(){ OFMS.promo.select(OFMS.promo.opts().map(o=>o.v)); }

async function generarOF(){
  const x=OFT();
  if(OF_VISTA==='dadas'&&!OFMS.promo.values().length){ alert('Selecciona al menos '+(OF_TIPO==='ofertas'?'una oferta':'un descuento')+' en el filtro «'+x.sel+'».'); return; }
  if(ofQs('lista').toString()!==OF_OPT_SIG) await ofCargarOpciones();   // filtros cambiaron: refresca el selector (conserva lo que siga existiendo)
  const p=ofQs(); const ids=OFMS.promo.values();
  if(ids.length) p.set('ids',ids.join(','));
  if(OF_VISTA==='dadas') p.set('detalle',$('#of-detalle').value);
  OF_QS=p.toString(); OF_DRILL=null; OF_SORT=null; OF_REPPATH=[]; OF_COLAPSO=null;
  overlay(true);
  fetch(BASE+'/apihist/promos?'+OF_QS).then(r=>r.json()).then(j=>{
    overlay(false);
    if(!j||!j.ok){ $('#of-tabla').innerHTML='<div class="hint">Error: '+ofEsc((j&&j.error)||'sin respuesta')+'</div>'; return; }
    OFDATA=j; ofPrintHead(); ofRenderActual();
  }).catch(e=>{ overlay(false); $('#of-tabla').innerHTML='<div class="hint">Error de conexión: '+ofEsc(e)+'</div>'; });
}
// Consulta de un drill con los MISMOS parámetros con que se generó el reporte
function ofDrillFetch(extra){
  const p=new URLSearchParams(OF_QS); Object.entries(extra).forEach(([k,v])=>p.set(k,v));
  overlay(true);
  return fetch(BASE+'/apihist/promos?'+p.toString()).then(r=>r.json()).then(j=>{ overlay(false); if(!j||!j.ok) throw new Error((j&&j.error)||'sin respuesta'); return j; })
    .catch(e=>{ overlay(false); alert('Error: '+e.message); throw e; });
}
function ofPrintHead(){
  const x=OFT(); let extra='';
  if(OF_VISTA==='dadas'&&OFDATA&&OFDATA.seleccion) extra='<div><b>'+x.sel+':</b> '+OFDATA.seleccion.map(s=>ofEsc(s.Nombre)).join(' · ')+'</div>';
  const est=OFMS.estado&&OFMS.estado.values().length?'<div><b>Estado:</b> '+OFMS.estado.values().join(', ')+'</div>':'';
  $('#of-print-head').innerHTML='<div id="of-print-in" style="display:block;margin-bottom:8px"><div><b>'+ofEsc(EMP)+' — '+x.P+' · '+ofNomVista()+'</b></div>'+
    '<div><b>Rango:</b> '+$('#of-ini').value+' al '+$('#of-fin').value+'</div>'+est+extra+
    '<div style="color:var(--muted)">Generado: '+new Date().toLocaleString('es-DO')+'</div></div>';
}

/* ── Orden por doble clic en el encabezado ── */
const OF_TXT=new Set(['nombre','centro','estado','suplidor','categoria','canal','promo','cliente','fecha','inicio','fin','pedidos']);
function ofSort(key){
  if(OF_SORT&&OF_SORT.key===key) OF_SORT={key,dir:-OF_SORT.dir}; else OF_SORT={key,dir:OF_TXT.has(key)?1:-1};
  ofRenderActual();
}
function ofTh(key,label,cls,title){
  const a=OF_SORT&&OF_SORT.key===key?(OF_SORT.dir>0?' ▲':' ▼'):'';
  return '<th class="'+(cls||'')+' of-sortable" ondblclick="ofSort(\''+key+'\')" title="'+ofEsc((title?title+' · ':'')+'Doble clic para ordenar')+'">'+label+a+'</th>';
}
// Ordena una copia de arr con el criterio activo (si aplica a esta tabla) o con el por defecto
function ofOrdenar(arr,get,def){
  const k=OF_SORT&&get[OF_SORT.key]?OF_SORT:def; if(!k) return arr.slice();
  const g=get[k.key], d=k.dir;
  return arr.slice().sort((a,b)=>{ const x=g(a), y=g(b);
    if(typeof x==='number'&&typeof y==='number') return (x-y)*d;
    return String(x==null?'':x).localeCompare(String(y==null?'':y),'es',{numeric:true,sensitivity:'base'})*d; });
}
const ofHintOrden='<div class="hint" style="margin-top:8px">💡 Doble clic en el encabezado de una columna para ordenar por ella (otro doble clic invierte el orden).</div>';
function ofRenderActual(){
  if(!OFDATA) return;
  if(OF_VISTA==='lista') ofRenderLista(OFDATA);
  else if(OF_VISTA==='dadas'){ if(OF_DRILL&&OF_DRILL.clientes) ofRenderClientes(); else if(OF_DRILL&&OF_DRILL.dias) ofRenderDias(); else ofRenderDadas(OFDATA); }
  else if(OF_VISTA==='productividad') ofRenderProd(OFDATA);
  else ofRenderReps();
}

/* ── 1. Lista (clic en una fila → Cantidad dadas de esa promoción) ── */
function ofRenderLista(j){
  const f=j.filas||[], x=OFT();
  $('#of-crumbs').innerHTML='';
  $('#of-cards').innerHTML=card(x.P+' en el rango',fmtN(f.length),'vigentes en alguna fecha del rango')+
    card('Activas hoy',fmtN(f.filter(r=>r.Estado==='Activa').length),'vigentes en este momento')+
    card('Finalizadas',fmtN(f.filter(r=>r.Estado==='Finalizada').length),'terminaron dentro del rango')+
    card('Programadas',fmtN(f.filter(r=>r.Estado==='Programada').length),'empiezan después de hoy');
  $('#of-tarjetas').innerHTML='';
  if(!f.length){ $('#of-tabla').innerHTML='<div class="hint">No hay '+x.p+' en ese rango con esos filtros.</div>'; return; }
  const rows=ofOrdenar(f,{nombre:r=>r.Nombre,inicio:r=>r.Inicio,fin:r=>r.Fin||'9999',estado:r=>r.Estado,suplidor:r=>r.Suplidor,categoria:r=>r.Categoria,canal:r=>r.Canal,centro:r=>r.Centro,vendedores:r=>r.Vendedores},null);
  let h='<table><thead><tr>'+ofTh('nombre','Nombre','l')+ofTh('inicio','Inicio','l')+ofTh('fin','Fin','l')+ofTh('estado','Estado','l')+ofTh('suplidor','Suplidor','l')+ofTh('categoria','Categoría(s)','l')+ofTh('canal','Canal','l')+ofTh('centro','Centro de distribución','l')+ofTh('vendedores','Vendedores','','Vendedores con cartera a los que aplica')+'</tr></thead><tbody>';
  rows.forEach(r=>{
    h+='<tr class="of-click" onclick="ofIrADadas(\''+ofEsc(r.Id)+'\')" title="Clic para ver «Cantidad dadas» de '+x.artS+'"><td class="l" style="white-space:normal;min-width:240px"><b>'+ofEsc(r.Nombre)+'</b><div class="mini">ID '+ofEsc(r.Id)+'</div></td><td class="l">'+(r.Inicio?ncFechaFmt(r.Inicio):'—')+'</td><td class="l">'+(r.Fin?ncFechaFmt(r.Fin):'Sin fecha fin')+'</td>'+
       '<td class="l"><span class="of-badge '+ofEstadoCls(r.Estado)+'">'+ofEsc(r.Estado)+'</span></td><td class="l" style="white-space:normal">'+ofEsc(r.Suplidor)+'</td><td class="l" style="white-space:normal">'+ofEsc(r.Categoria)+'</td>'+
       '<td class="l">'+ofEsc(r.Canal)+'</td><td class="l" style="white-space:normal">'+ofEsc(r.Centro)+'</td><td>'+fmtN(r.Vendedores)+'</td></tr>';
  });
