/* ══════════ PEDIDOS ══════════
   3 formas de render sobre el mismo arreglo plano PDDATA (forma distinta según modo,
   la decide el backend): árbol org (centro/supervisor, agregación 100% client-side,
   mismo patrón que ncNivelHtml/ncFilaHtml pero con las medidas de Pedidos), árbol de
   2 niveles con subtotales YA calculados por SQL (suplidor, mismo patrón que
   ncProductoTreeHtml) y tabla plana (estatus). Incidencia% SIEMPRE se calcula DESPUÉS
   de sumar Pedido/Facturado, nunca sumada/promediada directo. */
function pdAgg(items){
  const s=items.reduce((s,r)=>({Cantidad:s.Cantidad+(r.Cantidad||0), MontoPed:s.MontoPed+(r.MontoPed||0), MontoFact:s.MontoFact+(r.MontoFact||0)}),{Cantidad:0,MontoPed:0,MontoFact:0});
  return pdConDerivados(s);
}
function pdConDerivados(r){
  const sinFacturar=r.MontoPed-r.MontoFact;
  return {Cantidad:r.Cantidad, MontoPed:r.MontoPed, MontoFact:r.MontoFact, MontoSinFacturar:sinFacturar,
    Incidencia: r.MontoPed>0 ? (100*sinFacturar/r.MontoPed) : null};
}
// Filtro adicional (fragmento de querystring, p.ej. "centros=AZUA") que identifica
// exactamente 1 fila del árbol/tabla — usado por el drill-down Fecha→Cliente (pedido
// explícito 2026-09-27). Cada nivel de pdPath() sabe con qué parámetro de filtro (de
// los que /apihist/pedidos YA acepta) se aísla ese nivel — no hace falta un parámetro
// nuevo de "fila clickeada", el drill reusa los filtros existentes.
function pdPath(modo){
  if(modo==='centro') return [
    {k:r=>r.CedCodigo||'', lbl:r=>r.Centro||'(Sin centro)', filtro:r=>r.CedCodigo?('centros='+encodeURIComponent(r.CedCodigo)):null},
    {k:r=>r.CanID, lbl:r=>r.Canal||'(Sin canal)', filtro:r=>r.CanID?('canales='+r.CanID):null},
    {k:r=>r.SupCod||'', lbl:r=>r.Supervisor||r.SupCod||'(Sin supervisor)', filtro:r=>r.SupCod?('supervisores='+encodeURIComponent(r.SupCod)):null}
  ];
  if(modo==='supervisor') return [
    {k:r=>r.SupCod||'', lbl:r=>r.Supervisor||r.SupCod||'(Sin supervisor)', filtro:r=>r.SupCod?('supervisores='+encodeURIComponent(r.SupCod)):null},
    {k:r=>r.RepCodigo||'', lbl:r=>(r.RepCodigo||'')+' - '+(r.Nombre||r.RepCodigo||''), filtro:r=>r.RepCodigo?('vendedores='+encodeURIComponent(r.RepCodigo)):null}
  ];
  return [];
}
// onclickJs: string JS ya armado (o null/undefined = fila no clickeable) — lo arma el
// caller (pdAbrirDrillDia/pdAbrirDrillCliente), pdFilaHtml solo lo inserta.
function pdFilaHtml(nombre,agg,depth,esSubtotal,onclickJs){
  const clases=[]; if(esSubtotal) clases.push('totals'); if(onclickJs) clases.push('clickable');
  const clsAttr=clases.length?' class="'+clases.join(' ')+'"':'';
  return '<tr'+clsAttr+(onclickJs?' onclick="'+onclickJs+'"':'')+'><td class="l" style="padding-left:'+(9+depth*18)+'px">'+nombre+'</td>'+
    '<td>'+fmtN(agg.Cantidad)+'</td><td>'+fmtRD(agg.MontoPed)+'</td><td>'+fmtRD(agg.MontoFact)+'</td><td>'+fmtRD(agg.MontoSinFacturar)+'</td>'+
    '<td>'+(agg.Incidencia==null?'n/d':agg.Incidencia.toFixed(1)+'%')+'</td></tr>';
}
function pdOnclickDia(qsFila){ return "pdAbrirDrillDia('"+String(qsFila||'').replace(/'/g,'')+"')"; }
function pdOnclickClienteDirecto(qsFila){ return "pdAbrirDrillClienteDirecto('"+String(qsFila||'').replace(/'/g,'')+"')"; }
function pdNivelHtml(items,path,depth,qsAcum){
  const nivel=path[0];
  const mapa=new Map();
  items.forEach(r=>{ const key=nivel.k(r); if(!mapa.has(key)) mapa.set(key,{key,lbl:nivel.lbl(r),items:[],frag:nivel.filtro?nivel.filtro(r):null}); mapa.get(key).items.push(r); });
  const entradas=[...mapa.values()].sort((a,b)=>pdAgg(b.items).MontoPed-pdAgg(a.items).MontoPed);
  const esUltimoNivel=path.length===1;
  let h='';
  entradas.forEach(entry=>{
    const agg=pdAgg(entry.items);
    const qsFila = entry.frag ? (qsAcum?qsAcum+'&'+entry.frag:entry.frag) : qsAcum;
    if(esUltimoNivel) h+=pdFilaHtml(entry.lbl,agg,depth,false,pdOnclickDia(qsFila));
    else { h+=pdNivelHtml(entry.items,path.slice(1),depth+1,qsFila); h+=pdFilaHtml('Total '+entry.lbl,agg,depth,true,pdOnclickDia(qsFila)); }
  });
  return h;
}
const PD_THEAD='<th class="l">%NIVEL%</th><th>Cantidad Pedidos</th><th>Monto Bruto Pedidos</th><th>Monto Bruto Facturado</th><th>Monto Sin Facturar</th><th>Incidencia %</th>';
function pdRenderArbol(modo){
  if(!PDDATA.length){ $('#pd-tabla').innerHTML='<div class="hint">Sin datos para el rango y filtros.</div>'; return; }
  const path=pdPath(modo);
  const nombreNivel=modo==='centro'?'Centro / Canal / Supervisor':'Supervisor / Vendedor';
  let h='<table><thead><tr>'+PD_THEAD.replace('%NIVEL%',nombreNivel)+'</tr></thead><tbody>';
  h+=pdNivelHtml(PDDATA,path,0,'');
  h+=pdFilaHtml('TOTAL GENERAL',pdAgg(PDDATA),0,true,pdOnclickDia(''));
  h+='</tbody></table>';
  $('#pd-tabla').innerHTML=h;
}
function pdRenderSuplidor(){
  if(!PDDATA.length){ $('#pd-tabla').innerHTML='<div class="hint">Sin datos para el rango y filtros.</div>'; return; }
  const suplidores=new Map();
  PDDATA.filter(r=>r.Nivel==='suplidor').forEach(r=>suplidores.set(r.SupID,{row:r,cats:[]}));
  PDDATA.filter(r=>r.Nivel==='categoria').forEach(r=>{ const s=suplidores.get(r.SupID); if(s) s.cats.push(r); });
  const total=PDDATA.find(r=>r.Nivel==='total')||{Cantidad:0,MontoPed:0,MontoFact:0};
  let h='<table><thead><tr>'+PD_THEAD.replace('%NIVEL%','Suplidor / Categoría')+'</tr></thead><tbody>';
  [...suplidores.values()].sort((a,b)=>b.row.MontoPed-a.row.MontoPed).forEach(s=>{
    const qsSup='suplidores='+s.row.SupID;
    s.cats.sort((a,b)=>b.MontoPed-a.MontoPed).forEach(c=>{ h+=pdFilaHtml(c.CatID+' - '+(c.Categoria||''),pdConDerivados(c),1,false,pdOnclickDia(qsSup+'&categorias='+c.CatID)); });
    h+=pdFilaHtml('Total '+s.row.SupID+' - '+(s.row.Suplidor||''),pdConDerivados(s.row),0,true,pdOnclickDia(qsSup));
  });
  h+=pdFilaHtml('TOTAL GENERAL',pdConDerivados(total),0,true,pdOnclickDia(''));
  h+='</tbody></table>';
  $('#pd-tabla').innerHTML=h;
}
// Suplidor → Categoría → Producto (pedido explícito 2026-09-29: "incluye uno que diga
// suplidor - categoria - Producto... sub totalice por categoria, suplidor y total
// general por compañia"). Opción NUEVA y separada de "suplidor" (que se dejó
// deliberadamente sin Producto en una sesión anterior, sin tocar ese comportamiento).
// Suplidor/Categoría subtotalizan y drillean a DÍA — "el mismo proceso de Drill down"
// que ya tenían — pero el nivel Producto (hoja) drillea DIRECTO a Cliente ("luego del
// producto si hago un drill down entonces me lleva a los clientes"), sin pasar por día.
function pdRenderSuplidorProd(){
  if(!PDDATA.length){ $('#pd-tabla').innerHTML='<div class="hint">Sin datos para el rango y filtros.</div>'; return; }
  const suplidores=new Map();
  PDDATA.filter(r=>r.Nivel==='suplidor').forEach(r=>suplidores.set(r.SupID,{row:r,cats:new Map()}));
  PDDATA.filter(r=>r.Nivel==='categoria').forEach(r=>{ const s=suplidores.get(r.SupID); if(s) s.cats.set(r.CatID,{row:r,prods:[]}); });
  PDDATA.filter(r=>r.Nivel==='producto').forEach(r=>{ const s=suplidores.get(r.SupID); const c=s&&s.cats.get(r.CatID); if(c) c.prods.push(r); });
  const total=PDDATA.find(r=>r.Nivel==='total')||{Cantidad:0,MontoPed:0,MontoFact:0};
  let h='<table><thead><tr>'+PD_THEAD.replace('%NIVEL%','Suplidor / Categoría / Producto')+'</tr></thead><tbody>';
  [...suplidores.values()].sort((a,b)=>b.row.MontoPed-a.row.MontoPed).forEach(s=>{
    const qsSup='suplidores='+s.row.SupID;
    [...s.cats.values()].sort((a,b)=>b.row.MontoPed-a.row.MontoPed).forEach(c=>{
      const qsCat=qsSup+'&categorias='+c.row.CatID;
      c.prods.sort((a,b)=>b.MontoPed-a.MontoPed).forEach(p=>{
        const qsProd=qsCat+'&productos='+p.ProID;
        h+=pdFilaHtml(p.ProID+' - '+(p.Producto||''),pdConDerivados(p),2,false,pdOnclickClienteDirecto(qsProd));
      });
      h+=pdFilaHtml('Total '+c.row.CatID+' - '+(c.row.Categoria||''),pdConDerivados(c.row),1,true,pdOnclickDia(qsCat));
    });
    h+=pdFilaHtml('Total '+s.row.SupID+' - '+(s.row.Suplidor||''),pdConDerivados(s.row),0,true,pdOnclickDia(qsSup));
  });
  h+=pdFilaHtml('TOTAL GENERAL',pdConDerivados(total),0,true,pdOnclickDia(''));
  h+='</tbody></table>';
  $('#pd-tabla').innerHTML=h;
}
function pdRenderEstatus(){
  if(!PDDATA.length){ $('#pd-tabla').innerHTML='<div class="hint">Sin datos para el rango y filtros.</div>'; return; }
  let h='<table><thead><tr>'+PD_THEAD.replace('%NIVEL%','Estatus')+'</tr></thead><tbody>';
  const filas=PDDATA.slice().sort((a,b)=>b.MontoPed-a.MontoPed);
  const tot={Cantidad:0,MontoPed:0,MontoFact:0};
  filas.forEach(r=>{
    h+=pdFilaHtml(r.Estatus+' - '+(r.Descripcion||''),pdConDerivados(r),0,false,pdOnclickDia('estatus='+r.Estatus));
    tot.Cantidad+=r.Cantidad; tot.MontoPed+=r.MontoPed; tot.MontoFact+=r.MontoFact;
  });
  h+=pdFilaHtml('TOTAL GENERAL',pdConDerivados(tot),0,true,pdOnclickDia(''));
  h+='</tbody></table>';
  $('#pd-tabla').innerHTML=h;
}
function pdRender(){
  PD_DRILL=null;
  const modo=$('#pd-modo').value;
  if(modo==='suplidor'){ pdRenderSuplidor(); return; }
  if(modo==='suplidorprod'){ pdRenderSuplidorProd(); return; }
  if(modo==='estatus'){ pdRenderEstatus(); return; }
  pdRenderArbol(modo);
}
/* ── Drill-down Fecha → Cliente (pedido explícito 2026-09-27): clic en cualquier fila
   (hoja, subtotal, o TOTAL GENERAL) de las 3 vistas de arriba abre un desglose día por
   día (mismas columnas); clic en un día abre el desglose de ESE día por cliente (mismas
   columnas otra vez). Reusa /apihist/pedidos con modo=dia|cliente (nuevo en el backend)
   + los MISMOS filtros ya activos en pantalla + el fragmento qsFila que identifica la
   fila exacta que se clickeó — sin endpoint nuevo. */
let PD_DRILL=null; // {qs, nivel:'dia'|'cliente', fecha}
function pdAbrirDrillDia(qsFila){ PD_DRILL={qs:qsFila||'', nivel:'dia', fecha:null}; pdCargarDrill(); }
function pdAbrirDrillCliente(fecha){ PD_DRILL.nivel='cliente'; PD_DRILL.fecha=fecha; pdCargarDrill(); }
// Drill DIRECTO a Cliente sin pasar por día (pedido explícito 2026-09-29, desde el nivel
// Producto de "Suplidor → Categoría → Producto": "luego del producto si hago un drill
// down entonces me lleva a los clientes") — mismo mecanismo (PD_DRILL/pdCargarDrill),
// solo que 'fecha' queda null a propósito: pdCargarDrill() entonces NO acota
// fechaIni/fechaFin a un solo día, usa el rango completo que ya está elegido en
// pantalla — el desglose por cliente sale para TODO el rango, de ese Suplidor/
// Categoría/Producto exacto.
function pdAbrirDrillClienteDirecto(qsFila){ PD_DRILL={qs:qsFila||'', nivel:'cliente', fecha:null}; pdCargarDrill(); }
function pdVolverDia(){ PD_DRILL.nivel='dia'; PD_DRILL.fecha=null; pdCargarDrill(); }
function pdCerrarDrill(){ PD_DRILL=null; pdRender(); pdCargarTarjetas(); }
function pdCargarDrill(){
  const p=pdQs();
  // REEMPLAZA (no concatena) — la fila clickeada acota a UN valor exacto por parámetro;
  // si se concatenara con el filtro ya activo en pantalla (p.ej. estatus=2,7,11 por
  // defecto), un clic en "Estatus 11" seguiría trayendo 2 y 7 también, mostrando el día
  // a día de 3 estatus en vez de 1 solo. Los códigos vienen de campos de la propia BD
  // (CedCodigo/CanID/SupCod/RepCodigo/SupID/CatID/Estatus), no de texto libre del
  // usuario — nada que un atacante pudiera manipular vía este flujo.
  if(PD_DRILL.qs){ new URLSearchParams(PD_DRILL.qs).forEach((v,k)=>{ p.set(k,v); }); }
  p.set('modo',PD_DRILL.nivel);
  // Solo acota a 1 día si PD_DRILL.fecha viene informado (drill día→cliente). El drill
  // DIRECTO producto→cliente deja fecha=null a propósito, así este 'if' no la toca y
  // pdQs() ya trae el rango completo elegido en pantalla.
  if(PD_DRILL.nivel==='cliente' && PD_DRILL.fecha){ p.set('fechaIni',PD_DRILL.fecha); p.set('fechaFin',PD_DRILL.fecha); }
  overlay(true);
  fetch(BASE+'/apihist/pedidos?'+p.toString()).then(r=>r.json()).then(j=>{
    overlay(false);
    if(!j||!j.ok){ alert('Error: '+(j&&j.error||'?')); return; }
    pdRenderDrill(j.filas||[]);
  }).catch(e=>{overlay(false);alert('Error de conexión: '+e);});
  // Las tarjetas ("Pedidos del Día"/"Pendientes por Facturar"/"Pedidos Perdidos") y las
  // mini-tablas Por Canal/Por Centro también deben reflejar la fila que se está
  // drilleando — pedido explícito 2026-09-27. Se les pasa SOLO el filtro de la fila
  // (PD_DRILL.qs), no el fechaIni/fechaFin del día/cliente drilleado — cada tarjeta tiene
  // su propia ventana de fecha por diseño ("Pedidos del Día"=hoy siempre,
  // "Pendientes"=últimos 90 días siempre, "Perdidos"=el rango elegido en pantalla), eso
  // no cambia con el drill, solo el alcance de Centro/Canal/Suplidor/Categoría/Estatus sí.
  pdCargarTarjetas(PD_DRILL.qs);
}
function pdRenderDrill(filas){
  const esDia=PD_DRILL.nivel==='dia';
  const esClienteDirecto=PD_DRILL.nivel==='cliente' && !PD_DRILL.fecha;
  let crumb='<div class="crumbs"><span class="crumb" onclick="pdCerrarDrill()">‹ Volver</span>';
  if(esDia) crumb+=' <span class="mini">· Desglose por día</span>';
  else if(esClienteDirecto) crumb+=' <span class="mini">· Desglose por cliente</span>';
  else crumb+=' › <span class="crumb" onclick="pdVolverDia()">Por día</span> › <span class="crumb cur">'+ncFechaFmt(PD_DRILL.fecha)+'</span>';
  crumb+='</div>';
  let h=crumb+'<table><thead><tr>'+PD_THEAD.replace('%NIVEL%',esDia?'Fecha':'Cliente')+'</tr></thead><tbody>';
  const filasOrd=filas.slice().sort((a,b)=>esDia?(a.Fecha<b.Fecha?-1:a.Fecha>b.Fecha?1:0):(b.MontoPed-a.MontoPed));
  const tot={Cantidad:0,MontoPed:0,MontoFact:0};
  filasOrd.forEach(r=>{
    const nombre=esDia?ncFechaFmt(r.Fecha):((r.CliCodigo||'')+' — '+(r.CliNombre||'(sin nombre)'));
    const onclickJs=esDia?("pdAbrirDrillCliente('"+r.Fecha+"')"):null;
    h+=pdFilaHtml(nombre,pdConDerivados(r),0,false,onclickJs);
    tot.Cantidad+=r.Cantidad; tot.MontoPed+=r.MontoPed; tot.MontoFact+=r.MontoFact;
  });
  h+=pdFilaHtml('TOTAL GENERAL',pdConDerivados(tot),0,true,null);
  h+='</tbody></table>';
  $('#pd-tabla').innerHTML=h;
}
function pdQs(){
  const p=new URLSearchParams();
