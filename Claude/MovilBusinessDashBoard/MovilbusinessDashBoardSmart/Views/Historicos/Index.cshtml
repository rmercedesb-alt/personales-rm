// ── Vista "Suplidor/Categoría": Suplidor → Categoría → Producto, sin pivote de
// Año/Mes (1 solo total del rango), mismo patrón de nivelbar/crumbs que General
// pero con columnas fijas a la izquierda (vc-stick1/2) y fila TOTAL EXACTA (toma
// la fila pre-agregada del nivel padre en vez de sumar en JS, para que Clientes
// y Ped./Fact. — COUNT DISTINCT — no se inflen al sumar hijos).
function vcScopeSC(){
  const nivel=vcSCNav.nivel;
  let d=VCSCDATA.filter(v=>v.Nivel===nivel);
  if(nivel!=='suplidor' && vcSCNav.sup!=null) d=d.filter(v=>v.SupID===vcSCNav.sup);
  if(nivel==='producto' && vcSCNav.cat!=null) d=d.filter(v=>v.CatID===vcSCNav.cat);
  return d;
}
function vcFooterSC(){
  if(vcSCNav.cat!=null) return VCSCDATA.find(v=>v.Nivel==='categoria'&&v.SupID===vcSCNav.sup&&v.CatID===vcSCNav.cat);
  if(vcSCNav.sup!=null) return VCSCDATA.find(v=>v.Nivel==='suplidor'&&v.SupID===vcSCNav.sup);
  return VCSCDATA.find(v=>v.Nivel==='total');
}
window.vcSetNivelSC=(nivel,sup,cat)=>{
  vcSCNav.nivel=nivel;
  if(sup!==undefined) vcSCNav.sup=sup;
  if(cat!==undefined) vcSCNav.cat=cat;
  if(nivel==='suplidor'){ vcSCNav.sup=null; vcSCNav.cat=null; }
  if(nivel==='categoria'&&cat===undefined) vcSCNav.cat=null;
  vcRenderSC();
};
function vcRenderSC(){
  if(VC_MODO!=='supliercat') return;
  const nivel=vcSCNav.nivel;
  let cr='<span class="crumb '+(vcSCNav.sup==null?'cur':'')+'" onclick="vcSetNivelSC(\'suplidor\')">Compañía</span>';
  if(vcSCNav.sup!=null){
    const sn=(VCSCDATA.find(v=>v.Nivel==='suplidor'&&v.SupID===vcSCNav.sup)||{}).Suplidor||vcSCNav.sup;
    cr+=' › <span class="crumb '+(vcSCNav.cat==null?'cur':'')+'" onclick="vcSetNivelSC(\'categoria\','+vcSCNav.sup+',null)">'+sn+'</span>';
  }
  if(vcSCNav.cat!=null){
    const cn=(VCSCDATA.find(v=>v.Nivel==='categoria'&&v.SupID===vcSCNav.sup&&v.CatID===vcSCNav.cat)||{}).Categoria||vcSCNav.cat;
    cr+=' › <span class="crumb cur">'+cn+'</span>';
  }
  $('#vc-crumbs').innerHTML=cr;
  const nb=(id,t)=>'<button class="btn-modo'+(nivel===id?' on':'')+'" onclick="vcSetNivelSC(\''+id+'\')">'+t+'</button>';
  $('#vc-nivelbar').innerHTML=nb('suplidor','Por Suplidor')+nb('categoria','Por Categoría')+nb('producto','Por Producto');
  const list=vcScopeSC();
  if(!list.length){ $('#vc-tabla').innerHTML='<div class="hint">Sin datos para estos filtros.</div>'; return; }
  vcRenderTablaSC(list,nivel);
}
function vcRenderTablaSC(list,nivel){
  const rows=list.slice().sort((a,b)=>b.Total-a.Total);
  let cols, click;
  if(nivel==='suplidor'){ cols=[{h:'Suplidor',f:r=>r.Suplidor,cls:'vc-stick1'}]; click=r=>"vcSetNivelSC('categoria',"+r.SupID+",null)"; }
  else if(nivel==='categoria'){ cols=[{h:'Suplidor',f:r=>r.Suplidor,cls:'vc-stick1'},{h:'Categoría',f:r=>r.Categoria,cls:'vc-stick2'}]; click=r=>"vcSetNivelSC('producto',undefined,"+r.CatID+")"; }
  else { cols=[{h:'Categoría',f:r=>r.Categoria,cls:'vc-stick1'},{h:'Producto',f:r=>r.Producto,cls:'vc-stick2'}]; click=null; }
  let h='<table><thead><tr><th class="l">#</th>'+cols.map(c=>'<th class="l '+c.cls+'">'+c.h+'</th>').join('')+
    '<th>Unidades</th><th>Cajas</th><th>Ped./Fact.</th><th>Clientes</th><th>Total</th></tr></thead><tbody>';
  rows.forEach((r,i)=>{
    const oc=click?(' class="clickable" onclick="'+click(r)+'"'):'';
    h+='<tr'+oc+'><td class="l">'+(i+1)+'</td>'+cols.map(c=>'<td class="l '+c.cls+'">'+c.f(r)+'</td>').join('')+
      '<td>'+fmtN(r.Unidades)+'</td><td>'+fmtDec(r.Cajas)+'</td><td>'+fmtN(r.PedFact)+'</td><td>'+fmtN(r.Clientes)+'</td><td><b>'+fmtRD(r.Total)+'</b></td></tr>';
  });
  const tot=vcFooterSC()||{Unidades:0,Cajas:0,PedFact:0,Clientes:0,Total:0};
  h+='<tr class="totals"><td class="l" colspan="'+(1+cols.length)+'">TOTAL</td>'+
    '<td>'+fmtN(tot.Unidades)+'</td><td>'+fmtDec(tot.Cajas)+'</td><td>'+fmtN(tot.PedFact)+'</td><td>'+fmtN(tot.Clientes)+'</td><td><b>'+fmtRD(tot.Total)+'</b></td></tr>';
  h+='</tbody></table>'; $('#vc-tabla').innerHTML=h;
}

// Columnas dinámicas: 1 por mes del rango + 1 "Total {año}" al cerrar cada año —
// crecen hacia la derecha (año, sus meses, siguiente año...), pedido del usuario.
function vcColumnas(){
  const porAnio={};
  VCPERIODOS.forEach(pr=>{ (porAnio[pr.anio]=porAnio[pr.anio]||[]).push(pr); });
  const cols=[];
  Object.keys(porAnio).sort().forEach(a=>{
    porAnio[a].forEach(m=>cols.push({key:m.anio+'-'+m.mes, header:MESNOM[m.mes]+'-'+String(m.anio).slice(2), tipo:'mes', anio:m.anio}));
    cols.push({key:'ANIO-'+a, header:'Total '+a, tipo:'anio', anio:Number(a)});
  });
  return cols;
}
function vcTheadCols(){
  return vcColumnas().map(c=>'<th'+(c.tipo==='anio'?' style="background:var(--panel2)"':'')+'>'+c.header+'</th>').join('')+'<th>Promedio</th><th>Total</th>';
}
function vcPromTotalTxt(pt){ return vcCeldaTxt(pt.promCj,pt.prom); }
function vcTotalTxt(pt){ return '<b>'+vcCeldaTxt(pt.totalCj,pt.total)+'</b>'; }
function vcArrowHtml(curr,prev){
  if(prev===0) return curr>0?' <span class="pos">▲</span>':'';
  return curr>=prev?' <span class="pos">▲</span>':' <span class="neg">▼</span>';
}
const vcVal=v=>v||{Monto:0,Cajas:0};
// Valores por columna (mes = directo; año = suma de sus meses) para 1 fila. Cada
// valor trae Monto y Cajas (pedido del usuario: mostrar ambos campos por mes).
function vcFilaValores(porPeriodo){
  const cols=vcColumnas();
  return cols.map(c=>{
    if(c.tipo==='mes'){ const v=vcVal(porPeriodo&&porPeriodo[c.key]); return {...c, monto:v.Monto, cajas:v.Cajas}; }
    const meses=cols.filter(x=>x.tipo==='mes'&&x.anio===c.anio);
    const monto=meses.reduce((s,x)=>s+vcVal(porPeriodo&&porPeriodo[x.key]).Monto,0);
    const cajas=meses.reduce((s,x)=>s+vcVal(porPeriodo&&porPeriodo[x.key]).Cajas,0);
    return {...c, monto, cajas};
  });
}
function vcCeldaTxt(cajas,monto){ return fmtDec(cajas)+' CJ - '+fmtRD(monto); }
function vcCeldasHtml(porPeriodo){
  let prevMes=null, prevAnio=null;
  return vcFilaValores(porPeriodo).map(c=>{
    let arrow='';
    if(c.tipo==='mes'){ arrow=prevMes==null?'':vcArrowHtml(c.monto,prevMes); prevMes=c.monto; return '<td>'+vcCeldaTxt(c.cajas,c.monto)+arrow+'</td>'; }
    arrow=prevAnio==null?'':vcArrowHtml(c.monto,prevAnio); prevAnio=c.monto;
    return '<td style="background:var(--panel2);font-weight:700">'+vcCeldaTxt(c.cajas,c.monto)+arrow+'</td>';
  }).join('');
}
function vcPromTotal(porPeriodo){
  const meses=vcColumnas().filter(c=>c.tipo==='mes');
  const montos=meses.map(c=>vcVal(porPeriodo&&porPeriodo[c.key]).Monto);
  const cajas=meses.map(c=>vcVal(porPeriodo&&porPeriodo[c.key]).Cajas);
  const total=montos.reduce((a,b)=>a+b,0), totalCj=cajas.reduce((a,b)=>a+b,0);
  return { prom: meses.length?total/meses.length:0, promCj: meses.length?totalCj/meses.length:0, total, totalCj };
}

function vcScope(){
  let d=VCDATA;
  if(vcNav.ced) d=d.filter(v=>v.CedCodigo===vcNav.ced);
  if(vcNav.sup) d=d.filter(v=>v.SupCod===vcNav.sup);
  if(vcNav.ven) d=d.filter(v=>v.RepCodigo===vcNav.ven);
  return d;
}
// clientesSet/totalFac (2026-09-13, pedido explícito del usuario): solo tienen sentido
// cuando `list` viene de VCDATA (grano RepCodigo×CliID, con CliID/TotalFac reales) — los
// niveles General (Centro/Supervisor/Vendedor) los usan; el drill de Suplidor/Categoría/
// Producto de UN cliente (vcRenderDetalle) también llama vcAgg pero sobre VCDETDATA (sin
// CliID/TotalFac) — ahí clientesSet/totalFac quedan vacíos/0, inofensivo porque
// vcRenderAgg solo los muestra cuando showClienteFac=true (nunca en ese caso).
function vcAgg(list,keyFn,nameFn,parentFn){
  const g={};
  list.forEach(v=>{
    const k=keyFn(v);
    if(!g[k]) g[k]={k,nombre:nameFn(v),padre:parentFn?parentFn(v):'',porPeriodo:{},clientesSet:new Set(),totalFac:0};
    Object.keys(v.porPeriodo||{}).forEach(pk=>{
      const cur=g[k].porPeriodo[pk]||{Monto:0,Cajas:0}, add=vcVal(v.porPeriodo[pk]);
      g[k].porPeriodo[pk]={Monto:cur.Monto+add.Monto,Cajas:cur.Cajas+add.Cajas};
    });
    if(v.CliID!=null) g[k].clientesSet.add(v.CliID);
    g[k].totalFac+=(v.TotalFac||0);
  });
  return Object.values(g).map(o=>{ o.clientes=o.clientesSet.size; return o; }).sort((a,b)=>{ const ta=vcPromTotal(a.porPeriodo).total, tb=vcPromTotal(b.porPeriodo).total; return tb-ta; });
}
// Gráficos de Vend./Cte. (modo "General" únicamente — el sub-modo "Suplidor/Categoría"
// de esta pestaña usa VCSCDATA, con su propio drill, queda fuera de esta 1ª entrega de
// gráficos). Reusa vcAgg() TAL CUAL (mismo agregador que ya usa vcRender para el drill
// Centro→Supervisor→Vendedor) — sin fetch nuevo, la Línea sale de porPeriodo que cada
// fila de VCDATA ya trae.
function vcRenderGraficos(){
  if(VC_MODO!=='general'||!VCDATA||!VCDATA.length) return;
  const agg=vcAgg(VCDATA,v=>v.CedCodigo,v=>v.Centro);
  const totalFn=g=>Object.values(g.porPeriodo||{}).reduce((s,p)=>s+(p.Monto||0),0);
  const top=topNConOtros(agg,10,totalFn,g=>g.nombre);
  graficoPastel($('#vc-graf-pastel'),top.map(t=>t.lbl),top.map(t=>t.val),'Peso de Ventas por Centro');
  graficoBarra($('#vc-graf-barra'),top.map(t=>t.lbl),top.map(t=>t.val),'Monto','Monto por Centro');
  const topLinea=topNConOtros(agg,5,totalFn,g=>g.nombre).filter(t=>t.lbl!=='Otros');
  const series=topLinea.map(t=>{
    const g=agg.find(a=>a.nombre===t.lbl);
    return {label:t.lbl, data:VCPERIODOS.map(p=>(g.porPeriodo[p.k]||{}).Monto||0)};
  });
  graficoLinea($('#vc-graf-linea'),VCPERIODOS.map(p=>p.label||p.k),series,'Tendencia Mensual por Centro');
}

function vcRender(){
  if(VC_MODO!=='general') return;
  if(vcNav.nivel==='detalle'){ vcRenderDetalle(); return; }
  const list=vcScope();
  let cr='<span class="crumb '+(vcNav.ced?'':'cur')+'" onclick="vcSetNivel(\'centro\',null,null,null)">Compañía</span>';
  if(vcNav.ced){ const cn=(VCDATA.find(v=>v.CedCodigo===vcNav.ced)||{}).Centro||vcNav.ced;
    cr+=' › <span class="crumb '+(vcNav.sup?'':'cur')+'" onclick="vcSetNivel(\'supervisor\',\''+vcNav.ced+'\',null,null)">'+cn+'</span>'; }
  if(vcNav.sup){ const sn=(VCDATA.find(v=>v.SupCod===vcNav.sup)||{}).Supervisor||vcNav.sup;
    cr+=' › <span class="crumb '+(vcNav.ven?'':'cur')+'" onclick="vcSetNivel(\'vendedor\',undefined,\''+vcNav.sup+'\',null)">'+sn+'</span>'; }
  if(vcNav.ven){ const vn=(VCDATA.find(v=>v.RepCodigo===vcNav.ven)||{}).Nombre||vcNav.ven;
    cr+=' › <span class="crumb cur">'+vn+'</span>'; }
  $('#vc-crumbs').innerHTML=cr;
  const nb=(id,t)=>'<button class="btn-modo'+(vcNav.nivel===id?' on':'')+'" onclick="vcSetNivel(\''+id+'\')">'+t+'</button>';
  $('#vc-nivelbar').innerHTML=nb('centro','Por Centro')+nb('supervisor','Por Supervisor')+nb('vendedor','Por Vendedor')+nb('cliente','Por Cliente');
  if(!list.length){ $('#vc-tabla').innerHTML='<div class="hint">Sin datos para estos filtros.</div>'; return; }
  // showClienteFac=true (2026-09-13, pedido explícito del usuario): solo los 3 niveles de
  // organización de General traen Clientes/Facturas — el drill de Suplidor/Categoría/
  // Producto de UN cliente (vcRenderDetalle) sigue llamando vcRenderAgg sin este parámetro.
  if(vcNav.nivel==='centro') vcRenderAgg(vcAgg(list,v=>v.CedCodigo,v=>v.Centro),'Centro',[],null,true);
  else if(vcNav.nivel==='supervisor') vcRenderAgg(vcAgg(list,v=>v.SupCod,v=>v.Supervisor,v=>v.Centro),'Supervisor',['Centro'],null,true);
  else if(vcNav.nivel==='vendedor') vcRenderAgg(vcAgg(list,v=>v.RepCodigo,v=>v.Nombre,v=>v.Supervisor),'Vendedor',['Supervisor'],null,true);
  else vcRenderCliente(list);
}
function vcRenderAgg(rows,tipo,parents,drillFn,showClienteFac){
  drillFn = drillFn || (k=>"vcDrill('"+k+"','"+tipo+"')");
  const esVendedor=showClienteFac&&tipo==='Vendedor';
  const th=parents.map(p=>'<th class="l">'+p+'</th>').join('');
  const thCF=showClienteFac?'<th>Clientes</th><th>Facturas</th>':'';
  let h='<table><thead><tr><th class="l">#</th>'+(esVendedor?'<th></th>':'')+th+'<th class="l">'+tipo+'</th>'+thCF+vcTheadCols()+'</tr></thead><tbody>';
  let sumTotal=0,sumTotalCj=0,sumProm=0,sumPromCj=0,sumClientes=0,sumFac=0; const totG={};
  rows.forEach((r,i)=>{
    const pc=parents.length?('<td class="l">'+r.padre+'</td>'):'';
    const pt=vcPromTotal(r.porPeriodo);
    const click=drillFn(r.k);
    const cls=click?' class="clickable"':''; const oc=click?' onclick="'+click+'"':'';
    const cdCF=showClienteFac?'<td>'+fmtN(r.clientes)+'</td><td>'+fmtN(r.totalFac)+'</td>':'';
    const cdPlus=esVendedor?'<td class="l"><span class="clickable" onclick="event.stopPropagation();vcToggleClientesVen('+i+')" id="vcPlusVen'+i+'" title="Ver clientes de este vendedor">➕</span></td>':'';
    h+='<tr'+cls+oc+'><td class="l">'+(i+1)+'</td>'+cdPlus+pc+'<td class="l">'+r.nombre+'</td>'+cdCF+
      vcCeldasHtml(r.porPeriodo)+'<td>'+vcPromTotalTxt(pt)+'</td><td>'+vcTotalTxt(pt)+'</td></tr>';
    if(esVendedor){
      const colspan=2+parents.length+(showClienteFac?2:0)+vcColumnas().length+2;
      h+='<tr id="vcDetVen'+i+'" style="display:none"><td colspan="'+colspan+'">'+vcClientesVenHtml(r.k)+'</td></tr>';
    }
    sumTotal+=pt.total; sumTotalCj+=pt.totalCj; sumProm+=pt.prom; sumPromCj+=pt.promCj; sumClientes+=(r.clientes||0); sumFac+=(r.totalFac||0);
    Object.keys(r.porPeriodo||{}).forEach(pk=>{ const cur=totG[pk]||{Monto:0,Cajas:0}, add=vcVal(r.porPeriodo[pk]); totG[pk]={Monto:cur.Monto+add.Monto,Cajas:cur.Cajas+add.Cajas}; });
  });
  const totCF=showClienteFac?'<td>'+fmtN(sumClientes)+'</td><td>'+fmtN(sumFac)+'</td>':'';
  h+='<tr class="totals"><td class="l" colspan="'+(2+parents.length+(esVendedor?1:0))+'">TOTAL</td>'+totCF+vcCeldasHtml(totG)+'<td>'+vcCeldaTxt(sumPromCj,sumProm)+'</td><td><b>'+vcCeldaTxt(sumTotalCj,sumTotal)+'</b></td></tr>';
  h+='</tbody></table>'; $('#vc-tabla').innerHTML=h;
}
// "+" de "Por Vendedor" (2026-09-13, pedido explícito del usuario) — adaptado del patrón
// toggleRebalDetalle ya probado en Views/PresupuestoGestion/Index.cshtml:2011-2036 (fila
// hija oculta por defecto, alternada por clic), sin tocar ese archivo. Los datos ya están
// en VCDATA (mismo grano RepCodigo×CliID que usa vcRenderCliente) — no hace falta ningún
// endpoint nuevo. Sin pivote mensual (a propósito, para que la fila hija quede compacta) —
// el pivote completo de un cliente puntual sigue disponible con clic en su fila, que abre
// el mismo detalle de Suplidor/Categoría/Producto que ya existía (vcAbrirDetalle).
function vcClientesVenHtml(repCodigo){
  const clientes=VCDATA.filter(v=>v.RepCodigo===repCodigo).slice().sort((a,b)=>b.Total-a.Total);
  if(!clientes.length) return '<div class="hint">Sin clientes para este vendedor en el rango.</div>';
  let h='<table class="mtx" style="margin:4px 0"><thead><tr><th class="l">Código</th><th class="l">Nombre Cliente</th><th>Facturas</th><th>Cajas</th><th>Monto</th></tr></thead><tbody>';
  clientes.forEach(v=>{
    h+='<tr class="clickable" onclick="vcAbrirDetalle('+v.CliID+')" title="Ver detalle de este cliente"><td class="l">'+v.CliCodigo+'</td><td class="l">'+v.CliNombre+'</td>'+
      '<td>'+fmtN(v.TotalFac)+'</td><td>'+fmtDec(v.TotalCajas)+'</td><td>'+fmtRD(v.Total)+'</td></tr>';
  });
  const tFac=clientes.reduce((s,v)=>s+(v.TotalFac||0),0), tCj=clientes.reduce((s,v)=>s+(v.TotalCajas||0),0), tM=clientes.reduce((s,v)=>s+(v.Total||0),0);
  h+='<tr class="totals"><td class="l" colspan="2">TOTAL ('+clientes.length+' cli.)</td><td>'+fmtN(tFac)+'</td><td>'+fmtDec(tCj)+'</td><td><b>'+fmtRD(tM)+'</b></td></tr>';
  h+='</tbody></table>'; return h;
}
window.vcToggleClientesVen=function(i){
  const el=document.getElementById('vcDetVen'+i), ic=document.getElementById('vcPlusVen'+i);
  const abierto=el.style.display!=='none';
  el.style.display=abierto?'none':'table-row';
  if(ic) ic.textContent=abierto?'➕':'➖';
};
function vcRenderCliente(list){
  const rows=list.slice().sort((a,b)=>vcPromTotal(b.porPeriodo).total-vcPromTotal(a.porPeriodo).total);
  let h='<table><thead><tr><th class="l">#</th><th class="l">Vendedor</th><th class="l vc-stick1">Cod.Cte.</th><th class="l vc-stick2">Nombre Cliente</th><th class="l">Tamaño</th><th>Facturas</th>'+vcTheadCols()+'</tr></thead><tbody>';
  let sumTotal=0,sumTotalCj=0,sumProm=0,sumPromCj=0,sumFac=0; const totG={};
  rows.forEach((v,i)=>{
    const pt=vcPromTotal(v.porPeriodo);
    h+='<tr class="clickable" onclick="vcAbrirDetalle('+v.CliID+')" title="Ver detalle de este cliente"><td class="l">'+(i+1)+'</td><td class="l">'+v.Nombre+'</td><td class="l vc-stick1">'+v.CliCodigo+'</td><td class="l vc-stick2">'+v.CliNombre+'</td><td class="l">'+(v.TamNombre||'')+'</td><td>'+fmtN(v.TotalFac)+'</td>'+
      vcCeldasHtml(v.porPeriodo)+'<td>'+vcPromTotalTxt(pt)+'</td><td>'+vcTotalTxt(pt)+'</td></tr>';
    sumTotal+=pt.total; sumTotalCj+=pt.totalCj; sumProm+=pt.prom; sumPromCj+=pt.promCj; sumFac+=(v.TotalFac||0);
    Object.keys(v.porPeriodo||{}).forEach(pk=>{ const cur=totG[pk]||{Monto:0,Cajas:0}, add=vcVal(v.porPeriodo[pk]); totG[pk]={Monto:cur.Monto+add.Monto,Cajas:cur.Cajas+add.Cajas}; });
  });
  h+='<tr class="totals"><td class="l"></td><td class="l"></td><td class="l vc-stick1">TOTAL</td><td class="l vc-stick2">('+rows.length+' cli.)</td><td class="l"></td><td>'+fmtN(sumFac)+'</td>'+vcCeldasHtml(totG)+'<td>'+vcCeldaTxt(sumPromCj,sumProm)+'</td><td><b>'+vcCeldaTxt(sumTotalCj,sumTotal)+'</b></td></tr>';
  h+='</tbody></table>'; $('#vc-tabla').innerHTML=h;
}

// ── Detalle de un cliente: Suplidor → Categoría → Producto (mismo esquema de
// pivote Año/Mes, Cajas + Monto sin ITBIS) ──────────────────────────────────
function vcAbrirDetalle(cliId){
  const v=VCDATA.find(x=>x.CliID===cliId); if(!v) return;
  overlay(true);
  const p=new URLSearchParams();
  p.set('fechaIni',$('#vc-ini').value); p.set('fechaFin',$('#vc-fin').value);
  p.set('origen',$('#vc-origen').value); p.set('cliId',cliId);
  prFiltros(VCMS,p);
  fetch(BASE+'/apihist/vendcte-detalle?'+p.toString()).then(r=>r.json()).then(j=>{
    overlay(false);
    if(!j||!j.ok){ alert('Error: '+(j&&j.error||'?')); return; }
    VCDETDATA=j.filas||[];
    VCDETCLI={id:cliId,cod:v.CliCodigo,nom:v.CliNombre};
    vcNav.nivel='detalle'; vcNav.detNivel='suplidor'; vcNav.detSup=null; vcNav.detCat=null;
    vcRender();
  }).catch(e=>{overlay(false);alert('Error de conexión: '+e);});
}
window.vcAbrirDetalle=vcAbrirDetalle;
window.vcVolverClientes=()=>{ vcNav.nivel='cliente'; vcRender(); };
window.vcSetNivelDet=(nivel,sup,cat)=>{
  vcNav.detNivel=nivel;
  if(sup!==undefined) vcNav.detSup=sup;
  if(cat!==undefined) vcNav.detCat=cat;
  if(nivel==='suplidor'){ vcNav.detSup=null; vcNav.detCat=null; }
  if(nivel==='categoria'&&cat===undefined) vcNav.detCat=null;
  vcRender();
};
function vcScopeDet(){
  let d=VCDETDATA;
  if(vcNav.detSup!=null) d=d.filter(v=>String(v.SupID)===vcNav.detSup);
  if(vcNav.detCat!=null) d=d.filter(v=>String(v.CatID)===vcNav.detCat);
  return d;
}
function vcRenderDetalle(){
  const list=vcScopeDet(); const nivel=vcNav.detNivel;
  let cr='<span class="crumb" onclick="vcVolverClientes()">‹ Clientes</span> › <span class="crumb '+(vcNav.detSup==null?'cur':'')+'">'+VCDETCLI.cod+' - '+VCDETCLI.nom+'</span>';
  if(vcNav.detSup!=null){ const sn=(VCDETDATA.find(v=>String(v.SupID)===vcNav.detSup)||{}).Suplidor||vcNav.detSup;
    cr+=' › <span class="crumb '+(vcNav.detCat==null?'cur':'')+'" onclick="vcSetNivelDet(\'categoria\',\''+vcNav.detSup+'\',null)">'+sn+'</span>'; }
  if(vcNav.detCat!=null){ const cn=(VCDETDATA.find(v=>String(v.CatID)===vcNav.detCat)||{}).Categoria||vcNav.detCat;
    cr+=' › <span class="crumb cur">'+cn+'</span>'; }
  $('#vc-crumbs').innerHTML=cr;
  const nb=(id,t)=>'<button class="btn-modo'+(nivel===id?' on':'')+'" onclick="vcSetNivelDet(\''+id+'\')">'+t+'</button>';
  $('#vc-nivelbar').innerHTML=nb('suplidor','Por Suplidor')+nb('categoria','Por Categoría')+nb('producto','Por Producto');
  if(!list.length){ $('#vc-tabla').innerHTML='<div class="hint">Sin datos para este cliente en el rango.</div>'; return; }
  if(nivel==='suplidor') vcRenderAgg(vcAgg(list,v=>String(v.SupID),v=>v.Suplidor),'Suplidor',[],k=>"vcSetNivelDet('categoria','"+k+"')");
  else if(nivel==='categoria') vcRenderAgg(vcAgg(list,v=>String(v.CatID),v=>v.Categoria,v=>v.Suplidor),'Categoría',['Suplidor'],k=>"vcSetNivelDet('producto',undefined,'"+k+"')");
  else vcRenderAgg(vcAgg(list,v=>String(v.ProID),v=>v.Producto,v=>v.Categoria),'Producto',['Categoría'],null);
}
window.vcSetNivel=(nivel,ced,sup,ven)=>{
  vcNav={nivel, ced:(ced!==undefined?ced:vcNav.ced), sup:(sup!==undefined?sup:vcNav.sup), ven:(ven!==undefined?ven:vcNav.ven)};
  if(nivel==='centro'){ vcNav.ced=null; vcNav.sup=null; vcNav.ven=null; }
  if(nivel==='supervisor'&&sup===undefined) vcNav.sup=null;
  if((nivel==='supervisor'||nivel==='vendedor')&&ven===undefined) vcNav.ven=null;
  vcRender();
};
window.vcDrill=(k,tipo)=>{
  if(tipo==='Centro') vcSetNivel('supervisor',k,null,null);
  else if(tipo==='Supervisor'){ const v=VCDATA.find(x=>x.SupCod===k); vcSetNivel('vendedor',v?v.CedCodigo:vcNav.ced,k,null); }
  else if(tipo==='Vendedor'){ const v=VCDATA.find(x=>x.RepCodigo===k); vcSetNivel('cliente',v?v.CedCodigo:vcNav.ced,v?v.SupCod:vcNav.sup,k); }
};
function excelVC(){
  if(!VCDATA.length){ alert('Genera el informe primero.'); return; }
  ensureXLSX(()=>{
    const cols=vcColumnas();
    const head=[[EMP+' — Históricos de Ventas · Vendedor/Cliente'],['Rango',$('#vc-ini').value+' a '+$('#vc-fin').value],
      ['Origen',$('#vc-origen').value],['Clientes',$('#vc-alcance').value],['Generado',new Date().toLocaleString('es-DO')],[]];
    const H=['Centro','Supervisor','Vendedor','Cod.Cte.','Nombre Cliente']
      .concat(cols.flatMap(c=>[c.header+' CJ',c.header+' RD$']))
      .concat(['Promedio CJ','Promedio RD$','Total CJ','Total RD$']);
    const rows=VCDATA.slice().sort((a,b)=>vcPromTotal(b.porPeriodo).total-vcPromTotal(a.porPeriodo).total).map(v=>{
      const pt=vcPromTotal(v.porPeriodo);
      const vals=vcFilaValores(v.porPeriodo).flatMap(c=>[Math.round(c.cajas*10)/10,Math.round(c.monto)]);
      return [v.Centro,v.Supervisor,v.Nombre,v.CliCodigo,v.CliNombre].concat(vals)
        .concat([Math.round(pt.promCj*10)/10,Math.round(pt.prom),Math.round(pt.totalCj*10)/10,Math.round(pt.total)]);
    });
    const ws=XLSX.utils.aoa_to_sheet(head.concat([H]).concat(rows));
    ws['!cols']=H.map((h,i)=>({wch:i<5?20:12}));
    const wb=XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb,ws,'Vendedor-Cliente');
    XLSX.writeFile(wb,'vendedor_cliente_'+$('#vc-ini').value+'.xlsx');
  });
}

/* ══════════ PED-FACT-NC ══════════ */
let PFDATA=[], pfNav={nivel:'centro',ced:null,sup:null,ven:null};
let PFSCDATA=[], pfSCNav={nivel:'suplidor',sup:null,cat:null};
let PF_MODO='general', PFDET=null;
// Nivel Cliente (pedido 2026-09-04): grano (RepCodigo,CliID), se carga aparte (lazy,
// bajo demanda) porque puede tener muchas más filas que el resto de niveles — se
// cachea por "scope" (ced/sup/ven) para no repetir la consulta al volver atrás/adelante.
let PFCLIDATA=[], PFCLI_SCOPE_KEY=null, PFCLI_LOADING=false;

function pfCols(){
  // #Fact/#NC/#FactNETAS cuentan PEDIDOS (facturados/con devolución/netos), no
  // documentos — la fuente (VwPedidosVsFacutadosMenosDevolucionRM) no expone
  // facturas ni NC individuales, solo montos reconciliados por línea de pedido.
  return [
    {h:'#Ped',           f:r=>fmtN(r.NumPed)},
    {h:'Valor Pedidos',  f:r=>fmtRD(r.ValorPed)},
    {h:'#Ped Facturados',f:r=>fmtN(r.NumFact)},
    {h:'Valor Facturas', f:r=>fmtRD(r.ValorFact)},
    {h:'#Ped c/Devolución',f:r=>fmtN(r.NumNC)},
    {h:'Valor Devuelto',   f:r=>fmtRD(r.ValorNC)},
    {h:'#Ped Netos',     f:r=>fmtN(r.NumFactNetas)},
    {h:'Valor Neto',     f:r=>fmtRD(r.ValorNeto)}
  ];
}
function pfModo(m){
  PF_MODO=m; PFDET=null;
  $('#pf-btn-general').classList.toggle('on',m==='general');
  $('#pf-btn-supcat').classList.toggle('on',m==='supliercat');
  const hint='<div class="hint">Elige el rango y presiona <b>Generar</b>.</div>';
  if(m==='supliercat'){ if(PFSCDATA.length){ pfSCNav={nivel:'suplidor',sup:null,cat:null}; pfRenderSC(); } else { $('#pf-crumbs').innerHTML=''; $('#pf-nivelbar').innerHTML=''; $('#pf-tabla').innerHTML=hint; } }
  else { if(PFDATA.length) pfRender(); else { $('#pf-crumbs').innerHTML=''; $('#pf-nivelbar').innerHTML=''; $('#pf-tabla').innerHTML=hint; } }
}
// ── Filtro "Entrega Repartidor" en cascada: sus opciones se refrescan cada vez
// que cambia fecha/Centro/Supervisor/Vendedor/Suplidor/Categoría/Producto, para
// no ofrecer entregas que de todas formas quedarían vacías con el resto de filtros.
let pfEntregasTimer=null;
function pfDependEntregasDebounced(){ clearTimeout(pfEntregasTimer); pfEntregasTimer=setTimeout(pfDependEntregas,250); }
function pfDependEntregas(){
  const p=new URLSearchParams();
  p.set('fechaIni',$('#pf-ini').value); p.set('fechaFin',$('#pf-fin').value);
  prFiltros(PFMS,p);
  fetch(BASE+'/apihist/entregas-filtro?'+p.toString()).then(r=>r.json()).then(j=>{
    if(!j||!j.ok) return;
    if(PFMS.entrega) PFMS.entrega.setOptions(j.opciones||[]);
  }).catch(()=>{});
}
function generarPF(){
  overlay(true);
  const p=new URLSearchParams();
  p.set('fechaIni',$('#pf-ini').value); p.set('fechaFin',$('#pf-fin').value);
  prFiltros(PFMS,p);
  if(PFMS.entrega && PFMS.entrega.values().length) p.set('entregas',PFMS.entrega.values().join(','));
  const url = PF_MODO==='supliercat' ? '/apihist/pedfactnc-supcat' : '/apihist/pedfactnc';
  fetch(BASE+url+'?'+p.toString()).then(r=>r.json()).then(j=>{
    overlay(false);
    if(!j||!j.ok){ alert('Error: '+(j&&j.error||'?')); return; }
    if(PF_MODO==='supliercat'){
      PFSCDATA=j.filas||[]; pfSCNav={nivel:'suplidor',sup:null,cat:null}; PFDET=null;
      pfRenderSC();
    } else {
      PFDATA=j.filas||[]; pfNav={nivel:'centro',ced:null,sup:null,ven:null}; PFDET=null;
      PFCLIDATA=[]; PFCLI_SCOPE_KEY=null; // filtros nuevos invalidan la caché del nivel Cliente
      pfRender();
    }
    $('#pf-print-head').innerHTML='<div id="a-print-head" style="display:block"><div><b>'+EMP+' — Ped-Fact-NC'+(PF_MODO==='supliercat'?' (Suplidor/Categoría)':'')+'</b></div>'+
      '<div><b>Rango (fecha de entrega):</b> '+$('#pf-ini').value+' al '+$('#pf-fin').value+'</div>'+
      '<div style="color:var(--muted)">Generado: '+new Date().toLocaleString('es-DO')+'</div></div>';
  }).catch(e=>{overlay(false);alert('Error de conexión: '+e);});
}
function excelPF(){
  const data=PF_MODO==='supliercat'?PFSCDATA:PFDATA;
  if(!data.length){ alert('Genera el informe primero.'); return; }
  ensureXLSX(()=>{
    const cols=pfCols();
    const head=[[EMP+' — Ped-Fact-NC'+(PF_MODO==='supliercat'?' (Suplidor/Categoría)':'')],
      ['Rango (fecha de entrega)',$('#pf-ini').value+' al '+$('#pf-fin').value],['Generado',new Date().toLocaleString('es-DO')],[]];
    // Suplidor/Categoría: la API devuelve los 3 niveles (suplidor/categoria/producto) más
    // un total, todos aplanados con un discriminador `Nivel` (GROUPING-SETS-like) — se
    // exportan todos con esa columna en vez de mezclar sus montos en una sola fila.
    const idCols=PF_MODO==='supliercat'?['Nivel','Suplidor','Categoría','Producto']:['Centro','Supervisor','Vendedor','Código'];
    const H=idCols.concat(cols.map(c=>c.h));
    const rows=data.slice().sort((a,b)=>b.ValorNeto-a.ValorNeto).map(r=>
      (PF_MODO==='supliercat'?[r.Nivel,r.Suplidor||'',r.Categoria||'',r.Producto||'']:[r.Centro,r.Supervisor,r.Nombre,r.RepCodigo])
        .concat([r.NumPed,r.ValorPed,r.NumFact,r.ValorFact,r.NumNC,r.ValorNC,r.NumFactNetas,r.ValorNeto]));
    const ws=XLSX.utils.aoa_to_sheet(head.concat([H]).concat(rows));
    ws['!cols']=H.map((h,i)=>({wch:i<idCols.length?22:14}));
    const wb=XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb,ws,'PedFactNC');
    XLSX.writeFile(wb,'pedfactnc_'+$('#pf-ini').value+'.xlsx');
  });
}
function pdfPF(){
  const data=PF_MODO==='supliercat'?PFSCDATA:PFDATA;
  if(!data.length){ alert('Genera el informe primero.'); return; }
  histExportarPDF({
    bandNode:$('#pf-print-head'), blockNodes:[$('#pf-tabla')],
    filename:'pedfactnc_'+$('#pf-ini').value+'.pdf',
    footerTxt:EMP+' — Ped-Fact-NC', botonIds:['pf-btn-pdf'],
  });
}

/* ── Vista General: Centro → Supervisor → Vendedor (suma segura: cada Pedido/
   Factura/NC pertenece a exactamente 1 vendedor, no hay riesgo de doble conteo
   al sumar los conteos distintos hacia niveles superiores). ── */
function pfScope(){
  let d=PFDATA;
  if(pfNav.ced) d=d.filter(v=>v.CedCodigo===pfNav.ced);
  if(pfNav.sup) d=d.filter(v=>v.SupCod===pfNav.sup);
  return d;
}
function pfAgg(list,keyFn,nameFn,parentFn){
  const g={};
  list.forEach(v=>{
    const k=keyFn(v);
    if(!g[k]) g[k]={k,nombre:nameFn(v),padre:parentFn?parentFn(v):'',NumPed:0,ValorPed:0,NumFact:0,ValorFact:0,NumNC:0,ValorNC:0,NumFactNetas:0,ValorNeto:0};
    const r=g[k];
    r.NumPed+=v.NumPed; r.ValorPed+=v.ValorPed; r.NumFact+=v.NumFact; r.ValorFact+=v.ValorFact;
    r.NumNC+=v.NumNC; r.ValorNC+=v.ValorNC; r.NumFactNetas+=v.NumFactNetas; r.ValorNeto+=v.ValorNeto;
  });
  return Object.values(g).sort((a,b)=>b.ValorNeto-a.ValorNeto);
}
// Gráficos de Ped-Fact-NC — sin Línea (alcance acotado con el usuario: esta consulta no
// trae ninguna dimensión de fecha por transacción hoy). Reusa pfAgg() TAL CUAL (mismo
// agregador que ya usa pfRender para el drill Centro→Supervisor→Vendedor).
function pfRenderGraficos(){
  if(PF_MODO!=='general'||!PFDATA||!PFDATA.length) return;
  const agg=pfAgg(PFDATA,v=>v.CedCodigo,v=>v.Centro);
  const top=topNConOtros(agg,10,r=>r.ValorFact,r=>r.nombre);
  graficoPastel($('#pf-graf-pastel'),top.map(t=>t.lbl),top.map(t=>t.val),'Peso del Valor Facturado por Centro');
  graficoBarra($('#pf-graf-barra'),top.map(t=>t.lbl),top.map(t=>t.val),'Valor Facturado','Valor Facturado por Centro');
}
function pfRender(){
  if(PF_MODO!=='general') return;
  if(pfNav.nivel==='cliente'){ pfRenderCliente(); return; }
  const list=pfScope();
  let cr='<span class="crumb '+(pfNav.ced?'':'cur')+'" onclick="pfSetNivel(\'centro\',null,null,null)">Compañía</span>';
  if(pfNav.ced){ const cn=(PFDATA.find(v=>v.CedCodigo===pfNav.ced)||{}).Centro||pfNav.ced;
    cr+=' › <span class="crumb '+(pfNav.sup?'':'cur')+'" onclick="pfSetNivel(\'supervisor\',\''+pfNav.ced+'\',null,null)">'+cn+'</span>'; }
  if(pfNav.sup){ const sn=(PFDATA.find(v=>v.SupCod===pfNav.sup)||{}).Supervisor||pfNav.sup;
    cr+=' › <span class="crumb cur">'+sn+'</span>'; }
  $('#pf-crumbs').innerHTML=cr;
  const nb=(id,t)=>'<button class="btn-modo'+(pfNav.nivel===id?' on':'')+'" onclick="pfSetNivel(\''+id+'\')">'+t+'</button>';
  $('#pf-nivelbar').innerHTML=nb('centro','Por Centro')+nb('supervisor','Por Supervisor')+nb('vendedor','Por Vendedor')+nb('cliente','Por Cliente');
  if(!list.length){ $('#pf-tabla').innerHTML='<div class="hint">Sin datos para estos filtros.</div>'; return; }
  if(pfNav.nivel==='centro') pfRenderAgg(pfAgg(list,v=>v.CedCodigo,v=>v.Centro),'Centro',[],false);
  else if(pfNav.nivel==='supervisor') pfRenderAgg(pfAgg(list,v=>v.SupCod,v=>v.Supervisor,v=>v.Centro),'Supervisor',['Centro'],false);
  else pfRenderAgg(pfAgg(list,v=>v.RepCodigo,v=>v.Nombre,v=>v.Supervisor),'Vendedor',['Supervisor'],true);
}
window.pfSetNivel=(nivel,ced,sup,ven)=>{
  pfNav={nivel, ced:(ced!==undefined?ced:pfNav.ced), sup:(sup!==undefined?sup:pfNav.sup), ven:(ven!==undefined?ven:pfNav.ven)};
  if(nivel==='centro'){ pfNav.ced=null; pfNav.sup=null; pfNav.ven=null; }
  if(nivel==='supervisor'&&sup===undefined){ pfNav.sup=null; pfNav.ven=null; }
  if(nivel==='vendedor'&&ven===undefined) pfNav.ven=null;
  pfRender();
};
window.pfDrill=(k,tipo)=>{
  if(tipo==='Centro') pfSetNivel('supervisor',k,null,null);
  else if(tipo==='Supervisor') pfSetNivel('vendedor',pfNav.ced,k,null);
};
function pfRenderAgg(rows,tipo,parents,esVendedor){
  const cols=pfCols();
  const th=parents.map(p=>'<th class="l">'+p+'</th>').join('');
  let h='<table><thead><tr><th class="l">#</th>'+th+'<th class="l">'+tipo+'</th>'+cols.map(c=>'<th>'+c.h+'</th>').join('')+'</tr></thead><tbody>';
  const tot={NumPed:0,ValorPed:0,NumFact:0,ValorFact:0,NumNC:0,ValorNC:0,NumFactNetas:0,ValorNeto:0};
  rows.forEach((r,i)=>{
    const pc=parents.length?('<td class="l">'+r.padre+'</td>'):'';
    const rowOn = esVendedor ? '' : (' class="clickable" onclick="pfDrill(\''+r.k+'\',\''+tipo+'\')"');
    const nombreCell = esVendedor
      ? '<td class="l clickable" style="text-decoration:underline" onclick="pfSetNivel(\'cliente\',undefined,undefined,\''+r.k+'\')" title="Ver clientes de este vendedor">'+r.nombre+'</td>'
      : '<td class="l">'+r.nombre+'</td>';
    const cellsHtml=cols.map((c,ci)=>{
      if(esVendedor && ci===cols.length-1){
        return '<td class="clickable" style="text-decoration:underline" onclick="pfAbrirDetalleVendedor(\''+r.k+'\')" title="Ver detalle Suplidor/Categoría/Producto de este vendedor"><b>'+c.f(r)+'</b></td>';
      }
      return '<td>'+c.f(r)+'</td>';
    }).join('');
    h+='<tr'+rowOn+'><td class="l">'+(i+1)+'</td>'+pc+nombreCell+cellsHtml+'</tr>';
    tot.NumPed+=r.NumPed; tot.ValorPed+=r.ValorPed; tot.NumFact+=r.NumFact; tot.ValorFact+=r.ValorFact;
    tot.NumNC+=r.NumNC; tot.ValorNC+=r.ValorNC; tot.NumFactNetas+=r.NumFactNetas; tot.ValorNeto+=r.ValorNeto;
  });
  h+='<tr class="totals"><td class="l" colspan="'+(2+parents.length)+'">TOTAL</td>'+cols.map(c=>'<td><b>'+c.f(tot)+'</b></td>').join('')+'</tr>';
  h+='</tbody></table>'; $('#pf-tabla').innerHTML=h;
}
/* ── Nivel Cliente: lista cada cliente uno por uno (grano RepCodigo+CliID) —
   CliID SIEMPRE visible junto al nombre para no solapar clientes homónimos.
   Se puede entrar directo (Compañía o Centro/Supervisor en curso) o perforando
   desde un Vendedor específico (ver pfRenderAgg). Se cachea por "scope" (ced/
   sup/ven) para no repetir la consulta al ir y volver dentro del mismo scope. */
function pfCargarCliente(){
  const key=JSON.stringify({ced:pfNav.ced,sup:pfNav.sup,ven:pfNav.ven});
  if(PFCLI_SCOPE_KEY===key){ pfRenderTablaCliente(); return; }
  PFCLI_LOADING=true;
  $('#pf-tabla').innerHTML='<div class="hint">Cargando…</div>';
  const p=new URLSearchParams();
  p.set('fechaIni',$('#pf-ini').value); p.set('fechaFin',$('#pf-fin').value);
  prFiltros(PFMS,p);
  if(PFMS.entrega && PFMS.entrega.values().length) p.set('entregas',PFMS.entrega.values().join(','));
  if(pfNav.ced) p.set('centros',pfNav.ced);
  if(pfNav.sup) p.set('supervisores',pfNav.sup);
  if(pfNav.ven) p.set('vendedores',pfNav.ven);
  fetch(BASE+'/apihist/pedfactnc-cliente?'+p.toString()).then(r=>r.json()).then(j=>{
    PFCLI_LOADING=false;
    if(!j||!j.ok){ $('#pf-tabla').innerHTML='<div class="hint">'+(j&&j.error||'Error')+'</div>'; return; }
    PFCLIDATA=j.filas||[]; PFCLI_SCOPE_KEY=key;
    pfRenderTablaCliente();
  }).catch(err=>{ PFCLI_LOADING=false; $('#pf-tabla').innerHTML='<div class="hint">Error: '+err+'</div>'; });
}
function pfRenderCliente(){
  const nb=(id,t)=>'<button class="btn-modo'+(pfNav.nivel===id?' on':'')+'" onclick="pfSetNivel(\''+id+'\')">'+t+'</button>';
  $('#pf-nivelbar').innerHTML=nb('centro','Por Centro')+nb('supervisor','Por Supervisor')+nb('vendedor','Por Vendedor')+nb('cliente','Por Cliente');
  let cr='<span class="crumb '+(pfNav.ced?'':'cur')+'" onclick="pfSetNivel(\'centro\',null,null,null)">Compañía</span>';
  if(pfNav.ced){ const cn=(PFDATA.find(v=>v.CedCodigo===pfNav.ced)||{}).Centro||pfNav.ced;
    cr+=' › <span class="crumb '+(pfNav.sup||pfNav.ven?'':'')+'" onclick="pfSetNivel(\'supervisor\',\''+pfNav.ced+'\',null,null)">'+cn+'</span>'; }
  if(pfNav.sup){ const sn=(PFDATA.find(v=>v.SupCod===pfNav.sup)||{}).Supervisor||pfNav.sup;
    cr+=' › <span class="crumb" onclick="pfSetNivel(\'vendedor\',\''+pfNav.ced+'\',\''+pfNav.sup+'\',null)">'+sn+'</span>'; }
  if(pfNav.ven){ const vn=(PFDATA.find(v=>v.RepCodigo===pfNav.ven)||{}).Nombre||pfNav.ven;
    cr+=' › <span class="crumb cur">'+vn+'</span>'; }
  cr+=' › <span class="crumb cur">Clientes</span>';
  $('#pf-crumbs').innerHTML=cr;
  pfCargarCliente();
}
function pfRenderTablaCliente(){
  if(PFCLI_LOADING) return;
  const cols=pfCols();
  const rows=PFCLIDATA.slice().sort((a,b)=>b.ValorNeto-a.ValorNeto);
  if(!rows.length){ $('#pf-tabla').innerHTML='<div class="hint">Sin clientes con pedidos para estos filtros.</div>'; return; }
  let h='<table><thead><tr><th class="l">#</th><th class="l">Vendedor</th><th class="l">CliID</th><th class="l">Cliente</th>'+cols.map(c=>'<th>'+c.h+'</th>').join('')+'</tr></thead><tbody>';
  const tot={NumPed:0,ValorPed:0,NumFact:0,ValorFact:0,NumNC:0,ValorNC:0,NumFactNetas:0,ValorNeto:0};
  rows.forEach((r,i)=>{
    h+='<tr><td class="l">'+(i+1)+'</td><td class="l">'+r.Nombre+'</td><td class="l">'+r.CliID+'</td><td class="l">'+r.CliNombre+' <span class="mini">('+r.CliCodigo+')</span></td>'
      +cols.map(c=>'<td>'+c.f(r)+'</td>').join('')+'</tr>';
    tot.NumPed+=r.NumPed; tot.ValorPed+=r.ValorPed; tot.NumFact+=r.NumFact; tot.ValorFact+=r.ValorFact;
    tot.NumNC+=r.NumNC; tot.ValorNC+=r.ValorNC; tot.NumFactNetas+=r.NumFactNetas; tot.ValorNeto+=r.ValorNeto;
  });
  h+='<tr class="totals"><td class="l" colspan="4">TOTAL ('+rows.length+' clientes)</td>'+cols.map(c=>'<td><b>'+c.f(tot)+'</b></td>').join('')+'</tr>';
  h+='</tbody></table>'; $('#pf-tabla').innerHTML=h;
}
function pfAbrirDetalleVendedor(repCodigo){
  const rep=PFDATA.find(v=>v.RepCodigo===repCodigo); if(!rep) return;
  overlay(true);
  const p=new URLSearchParams();
  p.set('fechaIni',$('#pf-ini').value); p.set('fechaFin',$('#pf-fin').value);
  prFiltros(PFMS,p);
  if(PFMS.entrega && PFMS.entrega.values().length) p.set('entregas',PFMS.entrega.values().join(','));
  p.set('vendedores',repCodigo);
  fetch(BASE+'/apihist/pedfactnc-supcat?'+p.toString()).then(r=>r.json()).then(j=>{
    overlay(false);
    if(!j||!j.ok){ alert('Error: '+(j&&j.error||'?')); return; }
    PFSCDATA=j.filas||[]; pfSCNav={nivel:'suplidor',sup:null,cat:null};
    PFDET={rep:repCodigo, nombre:rep.Nombre};
    PF_MODO='supliercat';
    $('#pf-btn-general').classList.remove('on'); $('#pf-btn-supcat').classList.add('on');
    pfRenderSC();
  }).catch(e=>{overlay(false);alert('Error de conexión: '+e);});
}

/* ── Vista Suplidor/Categoría/Producto (propia o drill desde un vendedor) ── */
function pfScopeSC(){
  const nivel=pfSCNav.nivel;
  let d=PFSCDATA.filter(v=>v.Nivel===nivel);
  if(nivel!=='suplidor' && pfSCNav.sup!=null) d=d.filter(v=>v.SupID===pfSCNav.sup);
  if(nivel==='producto' && pfSCNav.cat!=null) d=d.filter(v=>v.CatID===pfSCNav.cat);
  return d;
}
function pfFooterSC(){
  if(pfSCNav.cat!=null) return PFSCDATA.find(v=>v.Nivel==='categoria'&&v.SupID===pfSCNav.sup&&v.CatID===pfSCNav.cat);
  if(pfSCNav.sup!=null) return PFSCDATA.find(v=>v.Nivel==='suplidor'&&v.SupID===pfSCNav.sup);
  return PFSCDATA.find(v=>v.Nivel==='total');
}
window.pfSetNivelSC=(nivel,sup,cat)=>{
  pfSCNav.nivel=nivel;
  if(sup!==undefined) pfSCNav.sup=sup;
  if(cat!==undefined) pfSCNav.cat=cat;
  if(nivel==='suplidor'){ pfSCNav.sup=null; pfSCNav.cat=null; }
  if(nivel==='categoria'&&cat===undefined) pfSCNav.cat=null;
  pfRenderSC();
};
window.pfVolverGeneral=()=>{
  PFDET=null; PF_MODO='general';
  $('#pf-btn-general').classList.add('on'); $('#pf-btn-supcat').classList.remove('on');
  pfRender();
};
function pfRenderSC(){
  const nivel=pfSCNav.nivel;
  let cr;
  if(PFDET) cr='<span class="crumb" onclick="pfVolverGeneral()">‹ General</span> › <span class="crumb '+(pfSCNav.sup==null?'cur':'')+'">'+PFDET.nombre+'</span>';
  else cr='<span class="crumb '+(pfSCNav.sup==null?'cur':'')+'" onclick="pfSetNivelSC(\'suplidor\')">Compañía</span>';
  if(pfSCNav.sup!=null){
    const sn=(PFSCDATA.find(v=>v.Nivel==='suplidor'&&v.SupID===pfSCNav.sup)||{}).Suplidor||pfSCNav.sup;
    cr+=' › <span class="crumb '+(pfSCNav.cat==null?'cur':'')+'" onclick="pfSetNivelSC(\'categoria\','+pfSCNav.sup+',null)">'+sn+'</span>';
  }
  if(pfSCNav.cat!=null){
    const cn=(PFSCDATA.find(v=>v.Nivel==='categoria'&&v.SupID===pfSCNav.sup&&v.CatID===pfSCNav.cat)||{}).Categoria||pfSCNav.cat;
    cr+=' › <span class="crumb cur">'+cn+'</span>';
  }
  $('#pf-crumbs').innerHTML=cr;
  const nb=(id,t)=>'<button class="btn-modo'+(nivel===id?' on':'')+'" onclick="pfSetNivelSC(\''+id+'\')">'+t+'</button>';
  $('#pf-nivelbar').innerHTML=nb('suplidor','Por Suplidor')+nb('categoria','Por Categoría')+nb('producto','Por Producto');
  const list=pfScopeSC();
  if(!list.length){ $('#pf-tabla').innerHTML='<div class="hint">Sin datos para estos filtros.</div>'; return; }
  pfRenderTablaSC(list,nivel);
}
function pfRenderTablaSC(list,nivel){
  const rows=list.slice().sort((a,b)=>b.ValorNeto-a.ValorNeto);
  const cols=pfCols();
  let hcol,click;
  if(nivel==='suplidor'){ hcol=[{h:'Suplidor',f:r=>r.Suplidor,cls:'vc-stick1'}]; click=r=>"pfSetNivelSC('categoria',"+r.SupID+",null)"; }
  else if(nivel==='categoria'){ hcol=[{h:'Suplidor',f:r=>r.Suplidor,cls:'vc-stick1'},{h:'Categoría',f:r=>r.Categoria,cls:'vc-stick2'}]; click=r=>"pfSetNivelSC('producto',undefined,"+r.CatID+")"; }
  else { hcol=[{h:'Categoría',f:r=>r.Categoria,cls:'vc-stick1'},{h:'Producto',f:r=>r.Producto,cls:'vc-stick2'}]; click=null; }
  let h='<table><thead><tr><th class="l">#</th>'+hcol.map(c=>'<th class="l '+c.cls+'">'+c.h+'</th>').join('')+cols.map(c=>'<th>'+c.h+'</th>').join('')+'</tr></thead><tbody>';
  rows.forEach((r,i)=>{
    const oc=click?(' class="clickable" onclick="'+click(r)+'"'):'';
    h+='<tr'+oc+'><td class="l">'+(i+1)+'</td>'+hcol.map(c=>'<td class="l '+c.cls+'">'+c.f(r)+'</td>').join('')+
      cols.map(c=>'<td>'+c.f(r)+'</td>').join('')+'</tr>';
  });
  const tot=pfFooterSC()||{NumPed:0,ValorPed:0,NumFact:0,ValorFact:0,NumNC:0,ValorNC:0,NumFactNetas:0,ValorNeto:0};
  h+='<tr class="totals"><td class="l" colspan="'+(1+hcol.length)+'">TOTAL</td>'+cols.map(c=>'<td><b>'+c.f(tot)+'</b></td>').join('')+'</tr>';
  h+='</tbody></table>'; $('#pf-tabla').innerHTML=h;
}

/* ══════════ FILL RATE ══════════ */
let FRDATA=[], frNav={nivel:'centro',ced:null,sup:null,canal:null};
let FRSCDATA=[], frSCNav={nivel:'suplidor',sup:null,cat:null}, FRDET=null;
let FR_MODO='general';
function nombreCanalFR(id){ return CANAL_NOMBRE.get(String(id))||('Canal '+id); }

function frCols(){
  return [
    {h:'#Ped',           f:r=>fmtN(r.NumPed)},
    {h:'Unid. Pedidas',  f:r=>fmtDec(r.UnidPed)},
    {h:'Unid. Facturadas', f:r=>fmtDec(r.UnidFact)},
    {h:'No Despachado',  f:r=>fmtDec(r.NoDespachado)},
    {h:'Fill Rate Unid.',  f:r=>fmtDec(r.FillRateUnid)+'%'},
    {h:'Valor Pedido',   f:r=>fmtRD(r.ValorPed)},
    {h:'Valor Facturado',f:r=>fmtRD(r.ValorFact)},
    {h:'Fill Rate Valor',f:r=>fmtDec(r.FillRateValor)+'%'}
  ];
}
let frEntregasTimer=null;
function frDependEntregasDebounced(){ clearTimeout(frEntregasTimer); frEntregasTimer=setTimeout(frDependEntregas,250); }
function frDependEntregas(){
  const p=new URLSearchParams();
  p.set('fechaIni',$('#fr-ini').value); p.set('fechaFin',$('#fr-fin').value);
  prFiltros(FRMS,p);
  fetch(BASE+'/apihist/entregas-filtro?'+p.toString()).then(r=>r.json()).then(j=>{
    if(!j||!j.ok) return;
    if(FRMS.entrega) FRMS.entrega.setOptions(j.opciones||[]);
  }).catch(()=>{});
}
function frModo(m){
  FR_MODO=m; FRDET=null;
  $('#fr-btn-general').classList.toggle('on',m==='general');
  $('#fr-btn-supcat').classList.toggle('on',m==='supliercat');
  const hint='<div class="hint">Elige el rango y presiona <b>Generar</b>.</div>';
  if(m==='supliercat'){ if(FRSCDATA.length){ frSCNav={nivel:'suplidor',sup:null,cat:null}; frRenderSC(); } else { $('#fr-crumbs').innerHTML=''; $('#fr-nivelbar').innerHTML=''; $('#fr-tabla').innerHTML=hint; } }
  else { if(FRDATA.length) frRender(); else { $('#fr-crumbs').innerHTML=''; $('#fr-nivelbar').innerHTML=''; $('#fr-tabla').innerHTML=hint; } }
}
function generarFR(){
  overlay(true);
  const p=new URLSearchParams();
  p.set('fechaIni',$('#fr-ini').value); p.set('fechaFin',$('#fr-fin').value);
  prFiltros(FRMS,p);
  if(FRMS.entrega && FRMS.entrega.values().length) p.set('entregas',FRMS.entrega.values().join(','));
  const url = FR_MODO==='supliercat' ? '/apihist/fillrate-supcat' : '/apihist/fillrate';
  fetch(BASE+url+'?'+p.toString()).then(r=>r.json()).then(j=>{
    overlay(false);
    if(!j||!j.ok){ alert('Error: '+(j&&j.error||'?')); return; }
    if(FR_MODO==='supliercat'){ FRSCDATA=j.filas||[]; frSCNav={nivel:'suplidor',sup:null,cat:null}; FRDET=null; frRenderSC(); }
    else { FRDATA=j.filas||[]; frNav={nivel:'centro',ced:null,sup:null,canal:null}; frRender(); }
    $('#fr-print-head').innerHTML='<div id="a-print-head" style="display:block"><div><b>'+EMP+' — Fill Rate'+(FR_MODO==='supliercat'?' (Suplidor/Categoría)':'')+'</b></div>'+
      '<div><b>Rango:</b> '+$('#fr-ini').value+' al '+$('#fr-fin').value+'</div>'+
      '<div style="color:var(--muted)">Generado: '+new Date().toLocaleString('es-DO')+'</div></div>';
  }).catch(e=>{overlay(false);alert('Error de conexión: '+e);});
}
function excelFR(){
  const data=FR_MODO==='supliercat'?FRSCDATA:FRDATA;
  if(!data.length){ alert('Genera el informe primero.'); return; }
  ensureXLSX(()=>{
    const cols=frCols();
    const head=[[EMP+' — Fill Rate'+(FR_MODO==='supliercat'?' (Suplidor/Categoría)':'')],
      ['Rango',$('#fr-ini').value+' al '+$('#fr-fin').value],['Generado',new Date().toLocaleString('es-DO')],[]];
    const idCols=FR_MODO==='supliercat'?['Nivel','Suplidor','Categoría','Producto']:['Centro','Supervisor','Vendedor','Código'];
    const H=idCols.concat(cols.map(c=>c.h));
    const rows=data.slice().sort((a,b)=>b.ValorFact-a.ValorFact).map(r=>
      (FR_MODO==='supliercat'?[r.Nivel,r.Suplidor||'',r.Categoria||'',r.Producto||'']:[r.Centro,r.Supervisor,r.Nombre,r.RepCodigo])
        .concat([r.NumPed,r.UnidPed,r.UnidFact,r.NoDespachado,r.FillRateUnid,r.ValorPed,r.ValorFact,r.FillRateValor]));
    const ws=XLSX.utils.aoa_to_sheet(head.concat([H]).concat(rows));
    ws['!cols']=H.map((h,i)=>({wch:i<idCols.length?22:14}));
    const wb=XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb,ws,'FillRate');
    XLSX.writeFile(wb,'fillrate_'+$('#fr-ini').value+'.xlsx');
  });
}
function pdfFR(){
  const data=FR_MODO==='supliercat'?FRSCDATA:FRDATA;
  if(!data.length){ alert('Genera el informe primero.'); return; }
  histExportarPDF({
    bandNode:$('#fr-print-head'), blockNodes:[$('#fr-tabla')],
    filename:'fillrate_'+$('#fr-ini').value+'.pdf',
    footerTxt:EMP+' — Fill Rate', botonIds:['fr-btn-pdf'],
  });
}

/* ── Vista General (Centro/Supervisor/Vendedor, y Canal→Supervisor→Vendedor en
   paralelo — mismo patrón que Presupuestos, pedido explícito del usuario 2026-08-29) ── */
function frScope(){
  let d=FRDATA;
  if(frNav.canal!=null) d=d.filter(v=>String(v.CanID)===String(frNav.canal));
  if(frNav.ced) d=d.filter(v=>v.CedCodigo===frNav.ced);
  if(frNav.sup) d=d.filter(v=>v.SupCod===frNav.sup);
  return d;
}
function frAgg(list,keyFn,nameFn,parentFn){
  const g={};
  list.forEach(v=>{
    const k=keyFn(v);
    if(!g[k]) g[k]={k,nombre:nameFn(v),padre:parentFn?parentFn(v):'',NumPed:0,UnidPed:0,UnidFact:0,ValorPed:0,ValorFact:0};
    const r=g[k];
    r.NumPed+=v.NumPed; r.UnidPed+=v.UnidPed; r.UnidFact+=v.UnidFact; r.ValorPed+=v.ValorPed; r.ValorFact+=v.ValorFact;
  });
  return Object.values(g).map(r=>({...r,
    NoDespachado: Math.round((r.UnidPed-r.UnidFact)*10)/10,
    FillRateUnid: r.UnidPed>0 ? Math.round(r.UnidFact/r.UnidPed*1000)/10 : 0,
    FillRateValor: r.ValorPed>0 ? Math.round(r.ValorFact/r.ValorPed*1000)/10 : 0
  })).sort((a,b)=>b.ValorPed-a.ValorPed);
}
// Gráficos de Fill Rate — sin Línea (mismo motivo que Ped-Fact-NC: sin fecha por
// transacción hoy). El Pastel/Barra usan ValorFact (Monto), NUNCA FillRateValor/
// FillRateUnid (son %, no algo que tenga sentido sumar en un Pastel). Reusa frAgg() TAL
// CUAL (mismo agregador que ya usa frRender para el drill).
function frRenderGraficos(){
  if(FR_MODO!=='general'||!FRDATA||!FRDATA.length) return;
  const agg=frAgg(FRDATA,v=>v.CedCodigo,v=>v.Centro);
  const top=topNConOtros(agg,10,r=>r.ValorFact,r=>r.nombre);
  graficoPastel($('#fr-graf-pastel'),top.map(t=>t.lbl),top.map(t=>t.val),'Peso del Valor Facturado por Centro');
  graficoBarra($('#fr-graf-barra'),top.map(t=>t.lbl),top.map(t=>t.val),'Valor Facturado','Valor Facturado por Centro');
}
function frRender(){
  if(FR_MODO!=='general') return;
  const list=frScope();
  const porCanal=frNav.canal!=null;
  let cr;
  if(porCanal){
    const cn=nombreCanalFR(frNav.canal);
    cr='<span class="crumb" onclick="frSetNivel(\'canal\',null,null,null)">Canales</span>'+
       ' › <span class="crumb '+(frNav.sup?'':'cur')+'" onclick="frSetNivel(\'supervisor\',null,null,'+JSON.stringify(frNav.canal)+')">'+cn+'</span>';
    if(frNav.sup){ const sn=(FRDATA.find(v=>v.SupCod===frNav.sup)||{}).Supervisor||frNav.sup; cr+=' › <span class="crumb cur">'+sn+'</span>'; }
  } else {
    cr='<span class="crumb '+(frNav.ced?'':'cur')+'" onclick="frSetNivel(\'centro\',null,null,null)">Compañía</span>';
    if(frNav.ced){ const cn=(FRDATA.find(v=>v.CedCodigo===frNav.ced)||{}).Centro||frNav.ced;
      cr+=' › <span class="crumb '+(frNav.sup?'':'cur')+'" onclick="frSetNivel(\'supervisor\',\''+frNav.ced+'\',null,null)">'+cn+'</span>'; }
    if(frNav.sup){ const sn=(FRDATA.find(v=>v.SupCod===frNav.sup)||{}).Supervisor||frNav.sup;
      cr+=' › <span class="crumb cur">'+sn+'</span>'; }
  }
  $('#fr-crumbs').innerHTML=cr;
  const nb=(id,t)=>'<button class="btn-modo'+(frNav.nivel===id?' on':'')+'" onclick="frSetNivel(\''+id+'\')">'+t+'</button>';
  $('#fr-nivelbar').innerHTML=nb('centro','Por Centro')+nb('supervisor','Por Supervisor')+nb('vendedor','Por Vendedor')+nb('canal','Por Canal');
  if(!list.length){ $('#fr-tabla').innerHTML='<div class="hint">Sin datos para estos filtros.</div>'; return; }
  if(frNav.nivel==='centro') frRenderAgg(frAgg(list,v=>v.CedCodigo,v=>v.Centro),'Centro',[]);
  else if(frNav.nivel==='canal') frRenderAgg(frAgg(FRDATA,v=>v.CanID,v=>nombreCanalFR(v.CanID)),'Canal',[]);
  else if(frNav.nivel==='supervisor'){
    const parentFn=porCanal?(v=>nombreCanalFR(v.CanID)):(v=>v.Centro);
    frRenderAgg(frAgg(list,v=>v.SupCod,v=>v.Supervisor,parentFn),'Supervisor',[porCanal?'Canal':'Centro']);
  }
  else frRenderAgg(frAgg(list,v=>v.RepCodigo,v=>v.Nombre,v=>v.Supervisor),'Vendedor',['Supervisor'],true);
}
window.frSetNivel=(nivel,ced,sup,canal)=>{
  frNav={nivel, ced:(ced!==undefined?ced:frNav.ced), sup:(sup!==undefined?sup:frNav.sup), canal:(canal!==undefined?canal:frNav.canal)};
  if(nivel==='centro'){ frNav.ced=null; frNav.sup=null; frNav.canal=null; }
  if(nivel==='canal'&&canal===undefined){ frNav.canal=null; frNav.sup=null; frNav.ced=null; }
  if(nivel==='supervisor'&&sup===undefined) frNav.sup=null;
  frRender();
};
window.frDrill=(k,tipo)=>{
  if(tipo==='Centro') frSetNivel('supervisor',k,null,null);
  else if(tipo==='Canal') frSetNivel('supervisor',null,null,k);
  else if(tipo==='Supervisor'){
    if(frNav.canal!=null) frSetNivel('vendedor',null,k,frNav.canal);
    else frSetNivel('vendedor',frNav.ced,k,null);
  }
};
// esVendedor=true (nivel hoja): la fila deja de llevar al drill genérico (no hay más
// nivel de organización debajo) y en su lugar la ÚLTIMA celda abre el detalle
// Suplidor/Categoría/Producto de ESE vendedor — mismo patrón ya usado en Ped-Fact-NC
// (pfAbrirDetalleVendedor), pedido explícito del usuario 2026-08-29.
function frRenderAgg(rows,tipo,parents,esVendedor){
  const cols=frCols();
  const th=parents.map(p=>'<th class="l">'+p+'</th>').join('');
  let h='<table><thead><tr><th class="l">#</th>'+th+'<th class="l">'+tipo+'</th>'+cols.map(c=>'<th>'+c.h+'</th>').join('')+'</tr></thead><tbody>';
  const tot={NumPed:0,UnidPed:0,UnidFact:0,ValorPed:0,ValorFact:0};
  rows.forEach((r,i)=>{
    const pc=parents.length?('<td class="l">'+r.padre+'</td>'):'';
    const rowOn=esVendedor?'':(' class="clickable" onclick="frDrill(\''+r.k+'\',\''+tipo+'\')"');
    const cellsHtml=cols.map((c,ci)=>{
      if(esVendedor && ci===cols.length-1){
        return '<td class="clickable" style="text-decoration:underline" onclick="frAbrirDetalleVendedor(\''+r.k+'\')" title="Ver detalle Suplidor/Categoría/Producto de este vendedor"><b>'+c.f(r)+'</b></td>';
      }
      return '<td>'+c.f(r)+'</td>';
    }).join('');
    h+='<tr'+rowOn+'><td class="l">'+(i+1)+'</td>'+pc+'<td class="l">'+r.nombre+'</td>'+cellsHtml+'</tr>';
    tot.NumPed+=r.NumPed; tot.UnidPed+=r.UnidPed; tot.UnidFact+=r.UnidFact; tot.ValorPed+=r.ValorPed; tot.ValorFact+=r.ValorFact;
  });
  tot.NoDespachado = Math.round((tot.UnidPed-tot.UnidFact)*10)/10;
  tot.FillRateUnid = tot.UnidPed>0 ? Math.round(tot.UnidFact/tot.UnidPed*1000)/10 : 0;
  tot.FillRateValor = tot.ValorPed>0 ? Math.round(tot.ValorFact/tot.ValorPed*1000)/10 : 0;
  h+='<tr class="totals"><td class="l" colspan="'+(2+parents.length)+'">TOTAL</td>'+cols.map(c=>'<td><b>'+c.f(tot)+'</b></td>').join('')+'</tr>';
  h+='</tbody></table>'; $('#fr-tabla').innerHTML=h;
}
function frAbrirDetalleVendedor(repCodigo){
  const rep=FRDATA.find(v=>v.RepCodigo===repCodigo); if(!rep) return;
  overlay(true);
  const p=new URLSearchParams();
  p.set('fechaIni',$('#fr-ini').value); p.set('fechaFin',$('#fr-fin').value);
  prFiltros(FRMS,p);
  if(FRMS.entrega && FRMS.entrega.values().length) p.set('entregas',FRMS.entrega.values().join(','));
  p.set('vendedores',repCodigo);
  fetch(BASE+'/apihist/fillrate-supcat?'+p.toString()).then(r=>r.json()).then(j=>{
    overlay(false);
    if(!j||!j.ok){ alert('Error: '+(j&&j.error||'?')); return; }
    FRSCDATA=j.filas||[]; frSCNav={nivel:'suplidor',sup:null,cat:null};
    FRDET={rep:repCodigo, nombre:rep.Nombre};
    FR_MODO='supliercat';
    $('#fr-btn-general').classList.remove('on'); $('#fr-btn-supcat').classList.add('on');
    frRenderSC();
  }).catch(e=>{overlay(false);alert('Error de conexión: '+e);});
}
window.frVolverGeneral=()=>{
  FRDET=null; FR_MODO='general';
  $('#fr-btn-general').classList.add('on'); $('#fr-btn-supcat').classList.remove('on');
  frRender();
};

/* ── Vista Suplidor/Categoría/Producto ── */
function frScopeSC(){
  const nivel=frSCNav.nivel;
  let d=FRSCDATA.filter(v=>v.Nivel===nivel);
  if(nivel!=='suplidor' && frSCNav.sup!=null) d=d.filter(v=>v.SupID===frSCNav.sup);
  if(nivel==='producto' && frSCNav.cat!=null) d=d.filter(v=>v.CatID===frSCNav.cat);
  return d;
}
function frFooterSC(){
  if(frSCNav.cat!=null) return FRSCDATA.find(v=>v.Nivel==='categoria'&&v.SupID===frSCNav.sup&&v.CatID===frSCNav.cat);
  if(frSCNav.sup!=null) return FRSCDATA.find(v=>v.Nivel==='suplidor'&&v.SupID===frSCNav.sup);
  return FRSCDATA.find(v=>v.Nivel==='total');
}
window.frSetNivelSC=(nivel,sup,cat)=>{
  frSCNav.nivel=nivel;
  if(sup!==undefined) frSCNav.sup=sup;
  if(cat!==undefined) frSCNav.cat=cat;
  if(nivel==='suplidor'){ frSCNav.sup=null; frSCNav.cat=null; }
  if(nivel==='categoria'&&cat===undefined) frSCNav.cat=null;
  frRenderSC();
};
function frRenderSC(){
  const nivel=frSCNav.nivel;
  let cr;
  if(FRDET) cr='<span class="crumb" onclick="frVolverGeneral()">‹ General</span> › <span class="crumb '+(frSCNav.sup==null?'cur':'')+'">'+FRDET.nombre+'</span>';
  else cr='<span class="crumb '+(frSCNav.sup==null?'cur':'')+'" onclick="frSetNivelSC(\'suplidor\')">Compañía</span>';
  if(frSCNav.sup!=null){
    const sn=(FRSCDATA.find(v=>v.Nivel==='suplidor'&&v.SupID===frSCNav.sup)||{}).Suplidor||frSCNav.sup;
    cr+=' › <span class="crumb '+(frSCNav.cat==null?'cur':'')+'" onclick="frSetNivelSC(\'categoria\','+frSCNav.sup+',null)">'+sn+'</span>';
  }
  if(frSCNav.cat!=null){
    const cn=(FRSCDATA.find(v=>v.Nivel==='categoria'&&v.SupID===frSCNav.sup&&v.CatID===frSCNav.cat)||{}).Categoria||frSCNav.cat;
    cr+=' › <span class="crumb cur">'+cn+'</span>';
  }
  $('#fr-crumbs').innerHTML=cr;
  const nb=(id,t)=>'<button class="btn-modo'+(nivel===id?' on':'')+'" onclick="frSetNivelSC(\''+id+'\')">'+t+'</button>';
  $('#fr-nivelbar').innerHTML=nb('suplidor','Por Suplidor')+nb('categoria','Por Categoría')+nb('producto','Por Producto');
  const list=frScopeSC();
  if(!list.length){ $('#fr-tabla').innerHTML='<div class="hint">Sin datos para estos filtros.</div>'; return; }
  frRenderTablaSC(list,nivel);
}
function frRenderTablaSC(list,nivel){
  const rows=list.slice().sort((a,b)=>b.ValorPed-a.ValorPed);
  const cols=frCols();
  let hcol,click;
  if(nivel==='suplidor'){ hcol=[{h:'Suplidor',f:r=>r.Suplidor,cls:'vc-stick1'}]; click=r=>"frSetNivelSC('categoria',"+r.SupID+",null)"; }
  else if(nivel==='categoria'){ hcol=[{h:'Suplidor',f:r=>r.Suplidor,cls:'vc-stick1'},{h:'Categoría',f:r=>r.Categoria,cls:'vc-stick2'}]; click=r=>"frSetNivelSC('producto',undefined,"+r.CatID+")"; }
  else { hcol=[{h:'Categoría',f:r=>r.Categoria,cls:'vc-stick1'},{h:'Producto',f:r=>r.Producto,cls:'vc-stick2'}]; click=null; }
  let h='<table><thead><tr><th class="l">#</th>'+hcol.map(c=>'<th class="l '+c.cls+'">'+c.h+'</th>').join('')+cols.map(c=>'<th>'+c.h+'</th>').join('')+'</tr></thead><tbody>';
  rows.forEach((r,i)=>{
    const oc=click?(' class="clickable" onclick="'+click(r)+'"'):'';
    h+='<tr'+oc+'><td class="l">'+(i+1)+'</td>'+hcol.map(c=>'<td class="l '+c.cls+'">'+c.f(r)+'</td>').join('')+
      cols.map(c=>'<td>'+c.f(r)+'</td>').join('')+'</tr>';
  });
  const tot=frFooterSC()||{NumPed:0,UnidPed:0,UnidFact:0,FillRateUnid:0,ValorPed:0,ValorFact:0,FillRateValor:0};
  h+='<tr class="totals"><td class="l" colspan="'+(1+hcol.length)+'">TOTAL</td>'+cols.map(c=>'<td><b>'+c.f(tot)+'</b></td>').join('')+'</tr>';
  h+='</tbody></table>'; $('#fr-tabla').innerHTML=h;
}
</script>
</body>
</html>
