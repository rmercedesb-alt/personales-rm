/* ══════════════════════════════════════════════════════════════════
   SUPLIDOR / CATEGORÍA — pivote mensual (Cajas/Ctes./Monto por mes)
   Pedido explícito del usuario 2026-09-24. Mismos filtros que
   Activaciones (AMS) + Cliente nuevo (SCMS), backend GET
   /apihist/supcat-mensual (GROUPING SETS extendido de VendCteSupCat).
   ══════════════════════════════════════════════════════════════════ */
function scqs(){
  const p=new URLSearchParams();
  p.set('fechaIni',$('#sc-ini').value); p.set('fechaFin',$('#sc-fin').value);
  p.set('fuente',$('#sc-fuente').value); p.set('grano',$('#sc-grano').value); p.set('reporte',$('#sc-reporte').value);
  const put=(k,ms)=>{ if(ms&&ms.values().length)p.set(k,ms.values().join(',')); };
  put('centros',SCMS.centro); put('supervisores',SCMS.sup); put('vendedores',SCMS.ven); put('divisiones',SCMS.div);
  put('clientes',SCMS.cliente);
  put('suplidores',SCMS.suplidor); put('categorias',SCMS.categoria); put('productos',SCMS.producto); put('grupos',SCMS.grupo);
  put('canales',SCMS.canal); put('gruposCliente',SCMS.grupoCliente);
  return p;
}
function generarSupCat(){
  SCNAV={supId:null,suplidor:''};
  overlay(true);
  fetch(BASE+'/apihist/supcat-mensual?'+scqs().toString()).then(r=>r.json()).then(j=>{
    overlay(false);
    if(!j||!j.ok){ alert('Error: '+(j&&j.error||'?')); return; }
    SCDATA=j; renderSupCat(j);
  }).catch(e=>{overlay(false);alert('Error de conexión: '+e);});
}
window.scDrill=(supId,nombre)=>{ if($('#sc-reporte').value!=='supcat') return; SCNAV={supId,suplidor:nombre}; if(SCDATA) renderSupCat(SCDATA); };
window.scDrillReset=()=>{ SCNAV={supId:null,suplidor:''}; if(SCDATA) renderSupCat(SCDATA); };

// Igual que flecha(), pero con el formateador que corresponda a cada métrica
// (Cajas con 1 decimal, Ctes. entero, Monto en RD$) — celda() ya existente
// siempre usa fmtN, por eso no se reusa tal cual acá.
function scCelda(n,prev,fmt){ return (fmt||fmtN)(n)+flecha(n,prev); }

function renderSupCat(j){
  const per=j.periodos||[], filas=j.filas||[], reporte=$('#sc-reporte').value;
  const drilled = reporte==='supcat' && SCNAV.supId!=null;
  const dimLbl = drilled ? 'Categoría' : (reporte==='categoria' ? 'Categoría' : 'Suplidor');

  // ── encabezado imprimible con la selección aplicada
  const fl=[];
  const addF=(lbl,ms,arr)=>{ const n=nomsDe(ms,arr); if(n.length) fl.push('<b>'+lbl+':</b> '+n.join(', ')); };
  addF('Centro',SCMS.centro,AOPT.centro); addF('Supervisor',SCMS.sup,AOPT.sup); addF('Vendedor',SCMS.ven,AOPT.ven);
  addF('División',SCMS.div,AOPT.div);
  addF('Suplidor',SCMS.suplidor,AOPT.suplidor); addF('Categoría',SCMS.categoria,AOPT.categoria);
  addF('Producto',SCMS.producto,AOPT.producto); addF('Grupo',SCMS.grupo,AOPT.grupo); addF('Canal',SCMS.canal,AOPT.canal);
  const reporteTxt={suplidor:'Suplidor',categoria:'Categoría',supcat:'Suplidor / Categoría'}[reporte];
  $('#sc-print-head').innerHTML='<div><b>'+EMP+' — Suplidor / Categoría</b> (Cajas / Ctes. / Monto por período)</div>'+
    '<div><b>Período:</b> '+($('#sc-ini').value)+' al '+($('#sc-fin').value)+' &nbsp;·&nbsp; <b>Fuente:</b> '+($('#sc-fuente').value==='pedidos'?'Pedidos':'Ventas')+
    ' &nbsp;·&nbsp; <b>Esquema:</b> '+({mes:'Mensual',semana:'Semanal',dia:'Diario'}[$('#sc-grano').value])+
    ' &nbsp;·&nbsp; <b>Reporte:</b> '+reporteTxt+(drilled?' — '+SCNAV.suplidor:'')+'</div>'+
    (fl.length?'<div>'+fl.join(' &nbsp;|&nbsp; ')+'</div>':'<div><i>Sin filtros (todo)</i></div>')+
    '<div style="color:var(--muted)">Generado: '+new Date().toLocaleString('es-DO')+'</div>';

  // ── breadcrumb (solo modo Suplidor/Categoría, con drill)
  $('#sc-crumbs').innerHTML = reporte==='supcat'
    ? '<span class="crumb'+(drilled?'':' cur')+'" onclick="scDrillReset()">Suplidores</span>'+(drilled?' › <span class="crumb cur">'+SCNAV.suplidor+'</span>':'')+
      (drilled?'':' <span class="mini">· clic en un suplidor para ver sus categorías ⤵</span>')
    : '';

  const filasVista = drilled
    ? filas.filter(f=>f.nivel==='categoria'&&f.supId===SCNAV.supId)
    : (reporte==='supcat' ? filas.filter(f=>f.nivel==='suplidor') : filas);
  if(!filasVista.length){ $('#sc-tabla').innerHTML='<div class="hint">Sin datos para el rango y filtros seleccionados.</div>'; return; }

  let h='<table class="mtx"><thead><tr><th class="l" rowspan="2">'+dimLbl+'</th>';
  per.forEach(p=>h+='<th class="per" colspan="3">'+p.label+'</th>');
  h+='<th class="per tot" colspan="3">Total</th></tr><tr>';
  per.forEach(()=>h+='<th class="per">Cajas</th><th class="per">Ctes.</th><th class="per">Monto</th>');
  h+='<th class="per tot">Cajas</th><th class="per tot">Ctes.</th><th class="per tot">Monto</th></tr></thead><tbody>';

  const filaHtml=(f,esTotalGeneral)=>{
    const label = esTotalGeneral ? 'TOTAL GENERAL'
      : (drilled ? (f.catId+' - '+f.categoria) : (f.supId+' - '+f.suplidor));
    const clickable = !esTotalGeneral && reporte==='supcat' && !drilled;
    const cls=[esTotalGeneral?'totals':'',clickable?'clickable':''].filter(Boolean).join(' ');
    const click = clickable ? " onclick=\"scDrill("+f.supId+",'"+String(f.suplidor).replace(/'/g,"\\'")+"')\"" : '';
    let r='<tr'+(cls?' class="'+cls+'"':'')+click+'>';
    r+='<td class="l">'+(esTotalGeneral?'<b>':'')+label+(esTotalGeneral?'</b>':'')+'</td>';
    let prevCajas=null, prevCli=null, prevMonto=null;
    per.forEach(p=>{
      const m=f.porPeriodo[p.k];
      if(!m){ r+='<td class="per">—</td><td class="per">—</td><td class="per">—</td>'; prevCajas=prevCli=prevMonto=null; return; }
      r+='<td class="per">'+scCelda(m.cajas,prevCajas,fmtDec)+'</td>';
      r+='<td class="per">'+scCelda(m.clientes,prevCli,fmtN)+'</td>';
      r+='<td class="per">'+scCelda(m.monto,prevMonto,fmtRD)+'</td>';
      prevCajas=m.cajas; prevCli=m.clientes; prevMonto=m.monto;
    });
    const t=f.total||{cajas:0,clientes:0,monto:0};
    r+='<td class="per tot">'+fmtDec(t.cajas)+'</td><td class="per tot">'+fmtN(t.clientes)+'</td><td class="per tot">'+fmtRD(t.monto)+'</td>';
    r+='</tr>';
    return r;
  };

  filasVista.forEach(f=>h+=filaHtml(f,false));
  if(j.totalGeneral) h+=filaHtml(j.totalGeneral,true);
  h+='</tbody></table>';
  $('#sc-tabla').innerHTML=h;
}
// Gráficos de Suplidor/Categoría — todo desde SCDATA ya en memoria (periodos+filas+
// totalGeneral), sin fetch nuevo: es el único de los 9 reportes que ya trae de fábrica
// una serie temporal por fila (porPeriodo), así que la Línea sale gratis también.
function scRenderGraficos(){
  if(!SCDATA||!(SCDATA.filas||[]).length) return;
  const per=SCDATA.periodos||[];
  const filasSup=SCDATA.filas.filter(f=>f.nivel==='suplidor');
  const top=topNConOtros(filasSup,10,f=>(f.total||{}).monto,f=>f.supId+' - '+f.suplidor);
  graficoPastel($('#sc-graf-pastel'),top.map(t=>t.lbl),top.map(t=>t.val),'Peso de Ventas por Suplidor');
  graficoBarra($('#sc-graf-barra'),top.map(t=>t.lbl),top.map(t=>t.val),'Monto','Monto por Suplidor');
  const topLinea=topNConOtros(filasSup,5,f=>(f.total||{}).monto,f=>f.supId+' - '+f.suplidor).filter(t=>t.lbl!=='Otros');
  const series=topLinea.map(t=>{
    const fila=filasSup.find(f=>(f.supId+' - '+f.suplidor)===t.lbl);
    return {label:t.lbl, data:per.map(p=>{ const m=fila&&fila.porPeriodo[p.k]; return m?m.monto:0; })};
  });
  graficoLinea($('#sc-graf-linea'),per.map(p=>p.label),series,'Tendencia por Suplidor');
}
