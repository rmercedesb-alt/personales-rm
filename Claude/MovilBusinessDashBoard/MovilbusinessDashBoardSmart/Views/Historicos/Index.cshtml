function prDepend(pref,ms){
  const cen=new Set(ms.centro.values()); const rc=cen.size?REPS.filter(r=>cen.has(r.CedCodigo)):REPS;
  ms.sup.setOptions([...new Map(rc.filter(r=>r.SupervisorCod).map(r=>[r.SupervisorCod,r.SupervisorNombre])).entries()].map(([v,t])=>({v,t})));
  const sup=new Set(ms.sup.values()); const rs=sup.size?rc.filter(r=>sup.has(r.SupervisorCod)):rc;
