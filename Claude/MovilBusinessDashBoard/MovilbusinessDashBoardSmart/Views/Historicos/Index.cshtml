/* ══════════ VENDEDOR / CLIENTE ══════════ */
let NCMS={}, NC_MODO='org', NCDATA=[], NCCAUSAS=[], NC_TARJETAS_CARGADAS=false;
let PDMS={}, PDDATA=[], PD_TARJETAS_CARGADAS=false;
let CTCMS={}, CTCDATA=[], CTCPERIODOS=[];
let SCMS={}, SCDATA=null, SCPERIODOS=[], SCNAV={supId:null,suplidor:''};
let VCMS={}, VC_MODO='general', VCDATA=[], VCPERIODOS=[], vcNav={nivel:'centro',ced:null,sup:null,ven:null,detNivel:'suplidor',detSup:null,detCat:null};
let VCDETDATA=[], VCDETCLI=null;
let VCSCDATA=[], vcSCNav={nivel:'suplidor',sup:null,cat:null};
const MESNOM=['','Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];

// Multiselect de Cliente: el catálogo completo (20,000+) es demasiado grande para
// precargar como los demás filtros — busca "as you type" contra /apihist/clientes-buscar
// y conserva lo ya elegido aunque no aparezca en la última búsqueda.
function multiselectCliente(host,label){
  const wrap=document.createElement('div');wrap.className='ms';const btn=document.createElement('div');btn.className='ms-btn';
  const txt=document.createElement('span');txt.textContent=label;const cnt=document.createElement('span');cnt.className='cnt';cnt.style.display='none';
  btn.append(txt,cnt);const pop=document.createElement('div');pop.className='ms-pop';
  const search=document.createElement('input');search.className='ms-search';search.placeholder='Código o nombre (mín. 2 letras)…';
  const list=document.createElement('div');pop.append(search,list);wrap.append(btn,pop);host.appendChild(wrap);
  let selected=new Map(), resultados=[], timer=null;
  function fila(v,t,checked){
    const row=document.createElement('label');row.className='ms-opt';
    const cb=document.createElement('input');cb.type='checkbox';cb.checked=checked;
    cb.onchange=()=>{ if(cb.checked) selected.set(v,t); else selected.delete(v); sync(); render(); };
    const sp=document.createElement('span');sp.textContent=t;row.append(cb,sp);return row;
  }
  function render(){
    list.innerHTML='';
    const vistos=new Set();
    selected.forEach((t,v)=>{ vistos.add(v); list.appendChild(fila(v,t,true)); });
    resultados.forEach(o=>{ if(!vistos.has(o.v)) list.appendChild(fila(o.v,o.t,false)); });
    if(!selected.size && !resultados.length) list.innerHTML='<div class="mini" style="padding:8px">Escribe para buscar…</div>';
  }
  function sync(){ const n=selected.size; cnt.style.display=n?'inline-block':'none'; cnt.textContent=n; }
  search.oninput=()=>{
    clearTimeout(timer);
    const q=search.value.trim();
    if(q.length<2){ resultados=[]; render(); return; }
    timer=setTimeout(()=>{
      fetch(BASE+'/apihist/clientes-buscar?q='+encodeURIComponent(q)).then(r=>r.json()).then(j=>{ resultados=(j&&j.opciones)||[]; render(); }).catch(()=>{});
    },300);
  };
  btn.onclick=e=>{e.stopPropagation();document.querySelectorAll('.ms-pop.open').forEach(p=>{if(p!==pop)p.classList.remove('open');});pop.classList.toggle('open');if(pop.classList.contains('open')){search.value='';resultados=[];render();search.focus();}};
  pop.onclick=e=>e.stopPropagation(); render(); sync();
  return { values:()=>[...selected.keys()] };
}

/* ══════════ NOTAS DE CRÉDITO ══════════
   Árbol org (Centro→Supervisor→Vendedor→Cliente, según "Analizar por") con subtotal
   AL FINAL de cada grupo (pedido explícito del usuario — distinto del patrón
   padre-primero de renderComp/filaC). En modo Detallado, cada nodo hoja del árbol
   org agrega debajo su propio árbol Suplidor→Categoría→Producto (con códigos),
   usando los subtotales YA CALCULADOS por el backend vía GROUPING SETS (mismo
   patrón de VendCteSupCat) — no se re-suman en el front. */
function ncFechaFmt(f){
  if(!f) return '(sin fecha)';
  const d=new Date(f+'T00:00:00');
  return d.toLocaleDateString('es-DO',{weekday:'short',day:'2-digit',month:'short',year:'numeric'});
}
function ncOrgLeafKey(r){ return (r.Fecha||'')+'|'+(r.CedCodigo||'')+'|'+(r.SupCod||'')+'|'+(r.RepCodigo||'')+'|'+(r.CliID??''); }
// Agrupa las filas crudas del backend por el grano hoja de organización: una entrada
// por (Fecha?,Centro,Supervisor,Vendedor,Cliente?), separando su fila "total" (org)
// de sus filas de detalle de producto (solo existen si vista=detallado).
function ncAgrupar(filas){
  const mapa=new Map();
  filas.forEach(r=>{
    const k=ncOrgLeafKey(r);
    if(!mapa.has(k)) mapa.set(k,{info:r,total:null,prod:[]});
    const g=mapa.get(k);
    if(r.Nivel==='total') g.total=r; else g.prod.push(r);
  });
  return [...mapa.values()];
}
function ncAggregar(items){
  return items.reduce((s,g)=>{
    const t=g.total||{Cantidad:0,Unidades:0,Cajas:0,Monto:0};
    return {Cantidad:s.Cantidad+t.Cantidad, Unidades:s.Unidades+t.Unidades, Cajas:s.Cajas+t.Cajas, Monto:s.Monto+t.Monto};
  },{Cantidad:0,Unidades:0,Cajas:0,Monto:0});
}
// 'filtro' por nivel (agregado 2026-09-27, pedido explícito: drill-down Fecha→Cliente):
// fragmento de querystring que /apihist/notascredito YA acepta (centros/supervisores/
// vendedores/clientes) para aislar exactamente ese nodo del árbol — mismo mecanismo que
// pdPath() en Pedidos. La Fecha NO lleva 'filtro' — ese nivel solo existe cuando el
// usuario ya activó "por Día" desde el selector; el drill-down nuevo es independiente de
// ese toggle (arranca siempre desde la vista sin Fecha).
function ncPath(nivelSel,porDia){
  const path=[];
  path.push({k:g=>g.info.CedCodigo||'', lbl:g=>g.info.Centro||'(Sin centro)', filtro:g=>g.info.CedCodigo?('centros='+encodeURIComponent(g.info.CedCodigo)):null});
  if(nivelSel!=='centro') path.push({k:g=>g.info.SupCod||'', lbl:g=>g.info.Supervisor||g.info.SupCod||'(Sin supervisor)', filtro:g=>g.info.SupCod?('supervisores='+encodeURIComponent(g.info.SupCod)):null});
  if(nivelSel==='vendedor'||nivelSel==='cliente') path.push({k:g=>g.info.RepCodigo||'', lbl:g=>(g.info.RepCodigo||'')+' - '+(g.info.Nombre||g.info.RepCodigo||''), filtro:g=>g.info.RepCodigo?('vendedores='+encodeURIComponent(g.info.RepCodigo)):null});
  if(nivelSel==='cliente') path.push({k:g=>g.info.CliID, lbl:g=>(g.info.CliCodigo||'')+' — '+(g.info.CliNombre||'(sin nombre)'), filtro:g=>g.info.CliID?('clientes='+g.info.CliID):null});
  // Fecha al FINAL del path (no al inicio): el usuario pidió ver el desglose día por
  // día DENTRO de cada Cliente/Vendedor/etc. ya elegido en "Analizar por" — con Fecha
  // primero se armaba un árbol Centro→Supervisor→Vendedor→Cliente completo REPETIDO
  // una vez por cada fecha del rango (la fecha nunca se veía en las filas, solo como
  // "Total <fecha>" al final de cada repetición). Puesta al final, la hoja elegida se
  // abre en una fila por fecha, con la fecha visible (ncFechaFmt) en cada una.
  if(porDia) path.push({k:g=>g.info.Fecha||'', lbl:g=>ncFechaFmt(g.info.Fecha), sortAsc:true});
  return path;
}
function ncFilaHtml(nombre,agg,depth,esSubtotal,onclickJs){
  const clases=[]; if(esSubtotal) clases.push('totals'); if(onclickJs) clases.push('clickable');
  const clsAttr=clases.length?' class="'+clases.join(' ')+'"':'';
  return '<tr'+clsAttr+(onclickJs?' onclick="'+onclickJs+'"':'')+'><td class="l" style="padding-left:'+(9+depth*18)+'px">'+nombre+'</td>'+
    '<td>'+fmtN(agg.Cantidad)+'</td><td>'+fmtN(agg.Unidades)+'</td><td>'+fmtDec(agg.Cajas)+'</td><td>'+fmtRD(agg.Monto)+'</td></tr>';
}
function ncOnclickDia(qsFila){ return "ncAbrirDrillDia('"+String(qsFila||'').replace(/'/g,'')+"')"; }
function ncProductoTreeHtml(prodRows,depth){
  const suplidores=new Map();
  prodRows.filter(r=>r.Nivel==='suplidor').forEach(r=>suplidores.set(r.SupID,{row:r,cats:new Map()}));
  prodRows.filter(r=>r.Nivel==='categoria').forEach(r=>{ const s=suplidores.get(r.SupID); if(s) s.cats.set(r.CatID,{row:r,prods:[]}); });
  prodRows.filter(r=>r.Nivel==='producto').forEach(r=>{ const s=suplidores.get(r.SupID); const c=s&&s.cats.get(r.CatID); if(c) c.prods.push(r); });
  let h='';
  [...suplidores.values()].sort((a,b)=>b.row.Monto-a.row.Monto).forEach(s=>{
    [...s.cats.values()].sort((a,b)=>b.row.Monto-a.row.Monto).forEach(c=>{
      c.prods.sort((a,b)=>b.Monto-a.Monto).forEach(p=>{
        h+='<tr><td class="l" style="padding-left:'+(9+(depth+2)*18)+'px">'+p.ProID+' - '+(p.Producto||'')+'</td>'+
           '<td>'+fmtN(p.Cantidad)+'</td><td>'+fmtN(p.Unidades)+'</td><td>'+fmtDec(p.Cajas)+'</td><td>'+fmtRD(p.Monto)+'</td></tr>';
      });
      h+=ncFilaHtml('Total '+c.row.CatID+' - '+(c.row.Categoria||''),c.row,depth+1,true);
    });
    h+=ncFilaHtml('Total '+s.row.SupID+' - '+(s.row.Suplidor||''),s.row,depth,true);
  });
  return h;
}
function ncNivelHtml(grupos,path,depth,detallado,qsAcum){
  const nivel=path[0];
  const mapa=new Map();
  grupos.forEach(g=>{ const key=nivel.k(g); if(!mapa.has(key)) mapa.set(key,{key,lbl:nivel.lbl(g),items:[],frag:nivel.filtro?nivel.filtro(g):null}); mapa.get(key).items.push(g); });
  const entradas=[...mapa.values()];
  if(nivel.sortAsc) entradas.sort((a,b)=>a.key<b.key?-1:a.key>b.key?1:0);
  else entradas.sort((a,b)=>ncAggregar(b.items).Monto-ncAggregar(a.items).Monto);
  const esUltimoNivel=path.length===1;
  let h='';
  entradas.forEach(entry=>{
    const agg=ncAggregar(entry.items);
    const qsFila = entry.frag ? (qsAcum?qsAcum+'&'+entry.frag:entry.frag) : qsAcum;
    if(esUltimoNivel){
      // Fila hoja "por Día" (nivel.sortAsc=true, ya es una fecha) NO se hace clickeable
      // otra vez — el drill-down nuevo parte de la vista SIN Fecha; con Fecha ya activa
      // desde el selector "por Día" no tiene sentido apilar el mismo desglose encima.
      h+=ncFilaHtml(entry.lbl,agg,depth,false,nivel.sortAsc?null:ncOnclickDia(qsFila));
      if(detallado){
        const prodRows=[].concat(...entry.items.map(g=>g.prod));
        h+=ncProductoTreeHtml(prodRows,depth+1);
      }
    } else {
      h+=ncNivelHtml(entry.items,path.slice(1),depth+1,detallado,qsFila);
      h+=ncFilaHtml('Total '+entry.lbl,agg,depth,true,ncOnclickDia(qsFila));
    }
  });
  return h;
}
function ncRenderArbol(){
  const nivelSel=$('#nc-nivel').value, detallado=$('#nc-vista').value==='detallado', porDia=$('#nc-periodo').value==='dia';
  if(!NCDATA.length){ $('#nc-tabla').innerHTML='<div class="hint">Sin datos para el rango y filtros.</div>'; return; }
  const grupos=ncAgrupar(NCDATA);
  const path=ncPath(nivelSel,porDia);
  const nombreNivel={centro:'Centro',supervisor:'Supervisor',vendedor:'Vendedor',cliente:'Cliente'}[nivelSel];
  let h='<table><thead><tr><th class="l">'+nombreNivel+(porDia?' (por día)':'')+'</th><th>Cantidad NC</th><th>Unidades</th><th>Cajas</th><th>Monto NC</th></tr></thead><tbody>';
  h+=ncNivelHtml(grupos,path,0,detallado,'');
  h+=ncFilaHtml('TOTAL GENERAL',ncAggregar(grupos),0,true,porDia?null:ncOnclickDia(''));
  h+='</tbody></table>';
  $('#nc-tabla').innerHTML=h;
}
/* ── Drill-down Fecha → Cliente (pedido explícito 2026-09-27): igual que en Pedidos,
   pero SIN cambios de backend — /apihist/notascredito ya soporta porDia (agrega Fecha
   al GROUP BY) y nivel=cliente (agrega CliID) desde antes (pedido 2026-08-28), solo que
   como una vista de árbol totalmente expandida, no como un drill por clic. La respuesta
   de NcConsultar SIEMPRE agrupa por RepCodigo además de lo pedido (ver comentario en
   NcConsultar, ApiHistoricosController.cs) — así que si la fila clickeada es un Centro
   (que engloba varios vendedores), la respuesta trae varias filas por día (una por
   vendedor) y hay que re-sumarlas client-side por Fecha (o por Cliente en el 2º nivel)
   antes de pintar — ncSumar() hace esa suma. */
let NC_DRILL=null; // {qs, nivel:'dia'|'cliente', fecha}
function ncSumar(filas){
  return filas.reduce((s,r)=>({Cantidad:s.Cantidad+(r.Cantidad||0), Unidades:s.Unidades+(r.Unidades||0), Cajas:s.Cajas+(r.Cajas||0), Monto:s.Monto+(r.Monto||0)}),{Cantidad:0,Unidades:0,Cajas:0,Monto:0});
}
function ncAbrirDrillDia(qsFila){ NC_DRILL={qs:qsFila||'', nivel:'dia', fecha:null}; ncCargarDrill(); }
function ncAbrirDrillCliente(fecha){ NC_DRILL.nivel='cliente'; NC_DRILL.fecha=fecha; ncCargarDrill(); }
function ncVolverDia(){ NC_DRILL.nivel='dia'; NC_DRILL.fecha=null; ncCargarDrill(); }
function ncCerrarDrill(){ NC_DRILL=null; ncRenderArbol(); }
function ncCargarDrill(){
  const p=ncQs();
  // REEMPLAZA (no concatena), mismo motivo que pdCargarDrill en Pedidos — los códigos
  // vienen de campos de la propia fila (CedCodigo/SupCod/RepCodigo/CliID), no de texto
  // libre del usuario.
  if(NC_DRILL.qs){ new URLSearchParams(NC_DRILL.qs).forEach((v,k)=>{ p.set(k,v); }); }
  if(NC_DRILL.nivel==='dia'){ p.set('porDia','true'); p.set('nivel','vendedor'); p.set('vista','resumido'); }
  else { p.set('porDia','false'); p.set('nivel','cliente'); p.set('vista','resumido'); p.set('fechaIni',NC_DRILL.fecha); p.set('fechaFin',NC_DRILL.fecha); }
  overlay(true);
  fetch(BASE+'/apihist/notascredito?'+p.toString()).then(r=>r.json()).then(j=>{
    overlay(false);
    if(!j||!j.ok){ alert('Error: '+(j&&j.error||'?')); return; }
    ncRenderDrill(j.filas||[]);
  }).catch(e=>{overlay(false);alert('Error de conexión: '+e);});
}
function ncRenderDrill(filasCrudas){
  const esDia=NC_DRILL.nivel==='dia';
  const clave = esDia ? (r=>r.Fecha||'') : (r=>r.CliID);
  const mapa=new Map();
  filasCrudas.forEach(r=>{ const k=clave(r); if(!mapa.has(k)) mapa.set(k,{key:k,items:[],first:r}); mapa.get(k).items.push(r); });
  let entradas=[...mapa.values()].map(e=>({key:e.key, first:e.first, agg:ncSumar(e.items)}));
  entradas.sort((a,b)=>esDia?(a.key<b.key?-1:a.key>b.key?1:0):(b.agg.Monto-a.agg.Monto));
  let crumb='<div class="crumbs"><span class="crumb" onclick="ncCerrarDrill()">‹ Volver</span>';
  if(esDia) crumb+=' <span class="mini">· Desglose por día</span>';
  else crumb+=' › <span class="crumb" onclick="ncVolverDia()">Por día</span> › <span class="crumb cur">'+ncFechaFmt(NC_DRILL.fecha)+'</span>';
  crumb+='</div>';
  let h=crumb+'<table><thead><tr><th class="l">'+(esDia?'Fecha':'Cliente')+'</th><th>Cantidad NC</th><th>Unidades</th><th>Cajas</th><th>Monto NC</th></tr></thead><tbody>';
  const tot={Cantidad:0,Unidades:0,Cajas:0,Monto:0};
  entradas.forEach(e=>{
    const nombre=esDia?ncFechaFmt(e.key):((e.first.CliCodigo||'')+' — '+(e.first.CliNombre||'(sin nombre)'));
    h+=ncFilaHtml(nombre,e.agg,0,false,esDia?ncFilaHtmlOnclickCliente(e.key):null);
    tot.Cantidad+=e.agg.Cantidad; tot.Unidades+=e.agg.Unidades; tot.Cajas+=e.agg.Cajas; tot.Monto+=e.agg.Monto;
  });
  h+=ncFilaHtml('TOTAL GENERAL',tot,0,true,null);
  h+='</tbody></table>';
  $('#nc-tabla').innerHTML=h;
}
function ncFilaHtmlOnclickCliente(fecha){ return "ncAbrirDrillCliente('"+fecha+"')"; }
function ncRenderCausas(){
  if(!NCCAUSAS.length){ $('#nc-tabla').innerHTML='<div class="hint">Sin datos para el rango y filtros.</div>'; return; }
  const porDia=$('#nc-periodo').value==='dia';
  let h='<table><thead><tr>'+(porDia?'<th class="l">Fecha</th>':'')+'<th class="l">Causa</th><th>Cantidad NC</th><th>Unidades</th><th>Cajas</th><th>Monto NC</th><th>% del Total</th></tr></thead><tbody>';
  const filas=NCCAUSAS.slice().sort((a,b)=> porDia ? ((a.Fecha||'')<(b.Fecha||'')?-1:(a.Fecha||'')>(b.Fecha||'')?1:b.Monto-a.Monto) : (b.Monto-a.Monto));
  filas.forEach(f=>{
    h+='<tr>'+(porDia?'<td class="l">'+ncFechaFmt(f.Fecha)+'</td>':'')+'<td class="l">'+f.Motivo+'</td>'+
      '<td>'+fmtN(f.Cantidad)+'</td><td>'+fmtN(f.Unidades)+'</td><td>'+fmtDec(f.Cajas)+'</td><td>'+fmtRD(f.Monto)+'</td>'+
      '<td>'+(f.Pct==null?'n/d':f.Pct.toFixed(1)+'%')+'</td></tr>';
  });
  h+='</tbody></table>';
  $('#nc-tabla').innerHTML=h;
}
function ncModo(m){
  NC_MODO=m;
  $('#nc-btn-org').classList.toggle('on',m==='org');
  $('#nc-btn-causa').classList.toggle('on',m==='causa');
  $('#nc-nivel-wrap').style.display=m==='org'?'':'none';
  $('#nc-vista-wrap').style.display=m==='org'?'':'none';
  const hint='<div class="hint">Elige el rango y presiona <b>Generar</b>.</div>';
  if(m==='causa'){ if(NCCAUSAS.length) ncRenderCausas(); else $('#nc-tabla').innerHTML=hint; }
  else { if(NCDATA.length) ncRenderArbol(); else $('#nc-tabla').innerHTML=hint; }
}
function ncQs(){
  const p=new URLSearchParams();
  p.set('fechaIni',$('#nc-ini').value); p.set('fechaFin',$('#nc-fin').value);
  prFiltros(NCMS,p);
  if(NCMS.cliente && NCMS.cliente.values().length) p.set('clientes',NCMS.cliente.values().join(','));
  return p;
}
function ncPrintHead(){
  $('#nc-print-head').innerHTML='<div id="a-print-head" style="display:block"><div><b>'+EMP+' — Notas de Crédito'+(NC_MODO==='causa'?' (Por Causa)':'')+'</b></div>'+
    '<div><b>Rango:</b> '+$('#nc-ini').value+' al '+$('#nc-fin').value+'</div>'+
    '<div style="color:var(--muted)">Generado: '+new Date().toLocaleString('es-DO')+'</div></div>';
}
function generarNC(){
  overlay(true);
  const p=ncQs();
  p.set('porDia', $('#nc-periodo').value==='dia' ? 'true' : 'false');
  if(NC_MODO==='causa'){
    fetch(BASE+'/apihist/notascredito-causas?'+p.toString()).then(r=>r.json()).then(j=>{
      overlay(false);
      if(!j||!j.ok){ alert('Error: '+(j&&j.error||'?')); return; }
      NCCAUSAS=j.filas||[];
      ncRenderCausas();
    }).catch(e=>{overlay(false);alert('Error de conexión: '+e);});
  } else {
    p.set('nivel',$('#nc-nivel').value); p.set('vista',$('#nc-vista').value);
    fetch(BASE+'/apihist/notascredito?'+p.toString()).then(r=>r.json()).then(j=>{
      overlay(false);
      if(!j||!j.ok){ alert('Error: '+(j&&j.error||'?')); return; }
      NCDATA=j.filas||[];
      ncRenderArbol();
    }).catch(e=>{overlay(false);alert('Error de conexión: '+e);});
  }
  ncCargarTarjetas();
  ncPrintHead();
}
