/* ══════════ COMPARATIVO CTES. ══════════
   Tabla de columnas fijas (Supervisor/Vendedor/Cliente/Tamaño, NO árbol indentado —
   la jerarquía es siempre esta, a diferencia de Notas de Crédito/Pedidos donde el
   usuario elige el nivel) + una columna por mes (CTCPERIODOS) + Promedio/Mes Actual/
   Diferencia. Subtotal AL FINAL de cada Vendedor y de cada Supervisor (mismo criterio
   ya usado en Notas de Crédito/Pedidos), ordenado por Promedio descendente. */
function ctcToggleFiltros(){
  const panel=$('#ctc-filtros'); const btn=$('#ctc-btn-toggle-filtros');
  const oculto=panel.style.display==='none';
  panel.style.display=oculto?'':'none';
  btn.textContent=oculto?'▲ Ocultar filtros':'▼ Mostrar filtros';
}
function ctcPeriodoKey(p){ return p.anio+'-'+p.mes; }
function ctcTheadCols(){ return CTCPERIODOS.map(p=>'<th>'+MESNOM[p.mes]+"'"+String(p.anio).slice(2)+'</th>').join(''); }
function ctcSumaGrupo(rows){
  const s={Total:0,Promedio:0,MesActual:0,Diferencia:0,PctVsPromedio:null,porPeriodo:{}};
  rows.forEach(r=>{
    s.Total+=r.Total||0; s.Promedio+=r.Promedio||0; s.MesActual+=r.MesActual||0; s.Diferencia+=r.Diferencia||0;
    CTCPERIODOS.forEach(p=>{ const k=ctcPeriodoKey(p); s.porPeriodo[k]=(s.porPeriodo[k]||0)+((r.porPeriodo&&r.porPeriodo[k])||0); });
  });
  s.PctVsPromedio = s.Promedio>0 ? (s.MesActual-s.Promedio)/s.Promedio*100 : null;
  return s;
}
function ctcAgg(){
  const sups=new Map();
  CTCDATA.forEach(r=>{
    const supKey=r.SupCod||'';
    if(!sups.has(supKey)) sups.set(supKey,{nombre:r.Supervisor||r.SupCod||'(Sin supervisor)',vendedores:new Map()});
    const sup=sups.get(supKey);
    const venKey=r.RepCodigo;
    if(!sup.vendedores.has(venKey)) sup.vendedores.set(venKey,{nombre:(r.RepCodigo||'')+' - '+(r.Nombre||r.RepCodigo||''),clientes:[]});
    sup.vendedores.get(venKey).clientes.push(r);
  });
  return sups;
}
function ctcFilaHtml(supTxt,venTxt,cliTxt,tamTxt,agg,esSubtotal,claseExtra){
  let h='<tr class="'+(esSubtotal?'totals':'')+(claseExtra?' '+claseExtra:'')+'"><td class="l ctc-stick1">'+supTxt+'</td><td class="l ctc-stick2">'+venTxt+'</td><td class="l ctc-stick3">'+cliTxt+'</td><td class="l ctc-stick4">'+tamTxt+'</td>';
  CTCPERIODOS.forEach(p=>{ const k=ctcPeriodoKey(p); h+='<td>'+fmtRD((agg.porPeriodo&&agg.porPeriodo[k])||0)+'</td>'; });
  h+='<td>'+fmtRD(agg.Promedio)+'</td><td>'+fmtRD(agg.MesActual)+' '+pctChip(agg.PctVsPromedio)+'</td><td>'+fmtRD(agg.Diferencia)+'</td></tr>';
  return h;
}
function ctcRender(){
  if(!CTCDATA.length){ $('#ctc-tabla').innerHTML='<div class="hint">Sin datos para el rango y filtros.</div>'; return; }
  const sups=ctcAgg();
  const supsOrdenados=[...sups.entries()].map(([k,s])=>({k,...s,agg:ctcSumaGrupo([...s.vendedores.values()].flatMap(v=>v.clientes))}))
    .sort((a,b)=>b.agg.Promedio-a.agg.Promedio);
  let h='<table><thead><tr><th class="l ctc-stick1">Supervisor</th><th class="l ctc-stick2">Vendedor</th><th class="l ctc-stick3">Cliente</th><th class="l ctc-stick4">Tamaño</th>'+ctcTheadCols()+'<th>Promedio Mes</th><th>Mes Actual</th><th>Diferencia</th></tr></thead><tbody>';
  supsOrdenados.forEach(sup=>{
    const vensOrdenados=[...sup.vendedores.values()].map(v=>({...v,agg:ctcSumaGrupo(v.clientes)})).sort((a,b)=>b.agg.Promedio-a.agg.Promedio);
    vensOrdenados.forEach(ven=>{
      ven.clientes.slice().sort((a,b)=>(b.Promedio||0)-(a.Promedio||0)).forEach(r=>{
        h+=ctcFilaHtml(sup.nombre,ven.nombre,(r.CliCodigo||'')+' - '+(r.CliNombre||''),r.TamNombre||'',r,false);
      });
      h+=ctcFilaHtml(sup.nombre,'TOTAL '+ven.nombre,'','',ven.agg,true);
    });
    h+=ctcFilaHtml('TOTAL '+sup.nombre,'','','',sup.agg,true,'ctc-sup-total');
  });
  const granTotal=ctcSumaGrupo(CTCDATA);
  h+=ctcFilaHtml('TOTAL GENERAL','','','',granTotal,true,'ctc-sup-total');
  h+='</tbody></table>';
  $('#ctc-tabla').innerHTML=h;
}
// Gráficos de Comparativo Ctes. — ya está a nivel mensual por cliente (porPeriodo), la
// Línea sale gratis reusando ctcSumaGrupo() TAL CUAL (mismo agregador que ya usa
// ctcRender para los subtotales de Supervisor/Vendedor) — sin fetch nuevo.
function ctcRenderGraficos(){
  if(!CTCDATA||!CTCDATA.length) return;
  const sups=ctcAgg();
  const filas=[...sups.entries()].map(([k,s])=>({lbl:s.nombre,agg:ctcSumaGrupo([...s.vendedores.values()].flatMap(v=>v.clientes))}));
  const top=topNConOtros(filas,10,f=>f.agg.MesActual,f=>f.lbl);
  graficoPastel($('#ctc-graf-pastel'),top.map(t=>t.lbl),top.map(t=>t.val),'Peso del Mes Actual por Supervisor');
  graficoBarra($('#ctc-graf-barra'),top.map(t=>t.lbl),top.map(t=>t.val),'Mes Actual','Mes Actual por Supervisor');
  const topLinea=topNConOtros(filas,5,f=>f.agg.MesActual,f=>f.lbl).filter(t=>t.lbl!=='Otros');
  const series=topLinea.map(t=>{
    const f=filas.find(x=>x.lbl===t.lbl);
    return {label:t.lbl, data:CTCPERIODOS.map(p=>{ const k=ctcPeriodoKey(p); return (f.agg.porPeriodo&&f.agg.porPeriodo[k])||0; })};
  });
  graficoLinea($('#ctc-graf-linea'),CTCPERIODOS.map(p=>ctcPeriodoKey(p)),series,'Tendencia Mensual por Supervisor');
}
function ctcQs(){
  const p=new URLSearchParams();
  p.set('fechaIni',$('#ctc-ini').value); p.set('fechaFin',$('#ctc-fin').value);
  p.set('fechaCompIni',$('#ctc-comp-ini').value); p.set('fechaCompFin',$('#ctc-comp-fin').value);
  p.set('modo',$('#ctc-modo').value); p.set('fuente',$('#ctc-fuente').value);
  prFiltros(CTCMS,p);
  if(CTCMS.diaVisita && CTCMS.diaVisita.values().length) p.set('diaVisita',CTCMS.diaVisita.values().join(','));
  return p;
}
