@await Html.PartialAsync("_InventariosFisicos")

<script>
const BASE='@Context.Request.PathBase.Value';
const $=s=>document.querySelector(s);
// OJO: NUNCA usar Date.toISOString() para "hoy" — convierte a UTC antes de
// formatear, y RD es UTC-4 sin horario de verano, así que después de las 8:00
// PM ya "es mañana" en UTC (bug real encontrado 2026-09-03: el sistema saltaba
// al día siguiente por la noche en varias pantallas). getFullYear/getMonth/
// getDate son locales, no UTC.
const dateF=d=>d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
let REPS=[], DATA=[], MS={}, nav={nivel:'centro',ced:null,sup:null}, RANGO=null, PREVIO=null, EMP='@ViewBag.EmpNombre';

function overlay(b){ $('#overlay').classList.toggle('show',b); }
function fmtN(x){ return (x==null?0:Math.round(x)).toLocaleString('es-DO'); }
function fmtDec(x){ return (x==null?0:x).toLocaleString('es-DO',{maximumFractionDigits:1}); }
function fmtRD(x){ return 'RD$'+fmtN(x); }

/* rango por defecto: mes en curso */
(function(){ const d=new Date(); const ini=new Date(d.getFullYear(),d.getMonth(),1); const f=dateF; $('#f-ini').value=f(ini); $('#f-fin').value=f(d); })();

/* ── Multiselect ── */
function multiselect(host,label,opts,onChange){
  const wrap=document.createElement('div');wrap.className='ms';const btn=document.createElement('div');btn.className='ms-btn';
  const txt=document.createElement('span');txt.textContent=label;const cnt=document.createElement('span');cnt.className='cnt';cnt.style.display='none';
  btn.append(txt,cnt);const pop=document.createElement('div');pop.className='ms-pop';
  const search=document.createElement('input');search.className='ms-search';search.placeholder='Buscar...';
  const head=document.createElement('div');head.className='ms-head';const all=document.createElement('span');all.className='ms-link';all.textContent='✓ Todos';const non=document.createElement('span');non.className='ms-link';non.textContent='✕ Ninguno';head.append(all,non);
  const list=document.createElement('div');pop.append(search,head,list);wrap.append(btn,pop);host.appendChild(wrap);
  let options=opts.slice(),selected=new Set();
  const vis=()=>{const q=(search.value||'').toLowerCase();return options.filter(o=>o.t.toLowerCase().includes(q));};
  all.onclick=e=>{e.stopPropagation();vis().forEach(o=>selected.add(o.v));render();sync();onChange&&onChange();};
  non.onclick=e=>{e.stopPropagation();vis().forEach(o=>selected.delete(o.v));render();sync();onChange&&onChange();};
  function render(){list.innerHTML='';vis().forEach(o=>{const row=document.createElement('label');row.className='ms-opt';const cb=document.createElement('input');cb.type='checkbox';cb.checked=selected.has(o.v);cb.onchange=()=>{cb.checked?selected.add(o.v):selected.delete(o.v);sync();onChange&&onChange();};const sp=document.createElement('span');sp.textContent=o.t;row.append(cb,sp);list.appendChild(row);});}
  function sync(){const n=selected.size;cnt.style.display=n?'inline-block':'none';cnt.textContent=n;}
  btn.onclick=e=>{e.stopPropagation();document.querySelectorAll('.ms-pop.open').forEach(p=>{if(p!==pop)p.classList.remove('open');});pop.classList.toggle('open');if(pop.classList.contains('open')){search.value='';render();search.focus();}};
  search.oninput=render;pop.onclick=e=>e.stopPropagation();render();sync();
  return {values:()=>[...selected],setOptions:(n)=>{options=n.slice();selected=new Set([...selected].filter(v=>options.some(o=>o.v===v)));render();sync();},
    select:(vals)=>{selected=new Set((vals||[]).filter(v=>options.some(o=>o.v===v)));render();sync();},
    opts:()=>options.slice()};
}
document.addEventListener('click',()=>document.querySelectorAll('.ms-pop.open').forEach(p=>p.classList.remove('open')));
let TAB='ventas';
function tab(t){
  if(t!=='ventas'&&t!=='notascredito'&&t!=='pedidos'&&t!=='activ'&&t!=='supcat'&&t!=='analisis'&&t!=='vendcte'&&t!=='pedfactnc'&&t!=='fillrate'&&t!=='promos'&&t!=='invfis') return;
  TAB=t;
  document.querySelectorAll('.tabs .tab[data-t]').forEach(x=>x.classList.toggle('on',x.dataset.t===t));
  $('#t-ventas').classList.toggle('hide',t!=='ventas');
  $('#t-notascredito').classList.toggle('hide',t!=='notascredito');
  $('#t-pedidos').classList.toggle('hide',t!=='pedidos');
  $('#t-activ').classList.toggle('hide',t!=='activ');
  $('#t-supcat').classList.toggle('hide',t!=='supcat');
  $('#t-analisis').classList.toggle('hide',t!=='analisis');
  $('#t-vendcte').classList.toggle('hide',t!=='vendcte');
  $('#t-pedfactnc').classList.toggle('hide',t!=='pedfactnc');
  $('#t-fillrate').classList.toggle('hide',t!=='fillrate');
  $('#t-promos').classList.toggle('hide',t!=='promos');
  $('#t-invfis').classList.toggle('hide',t!=='invfis');
  if(t==='notascredito'&&!NC_TARJETAS_CARGADAS){ NC_TARJETAS_CARGADAS=true; ncCargarTarjetas(); }
  if(t==='pedidos'&&!PD_TARJETAS_CARGADAS){ PD_TARJETAS_CARGADAS=true; pdCargarTarjetas(); }
}
let SUBANA='comp';
function subAna(s){
  SUBANA=s;
  ['comp','perd','recu','ctecomp'].forEach(x=>{ const t=$('#sub-'+x); if(t)t.classList.toggle('on',x===s); const pane=$('#sa-'+x); if(pane)pane.classList.toggle('hide',x!==s); });
}

/* ── Init ── */
const opt=items=>items.map(x=>({v:String(x.id),t:x.nombre}));
let CANAL_DEF=[];   // todos los canales excepto Institucional (default de los análisis)
let CANAL_NOMBRE=new Map();   // id (string) -> nombre, usado por el drill "Por Canal" de Fill Rate
fetch(BASE+'/apihist/filtros').then(r=>r.json()).then(j=>{
  REPS=(j&&j.representantes)||[];
  CANAL_DEF=(j.canales||[]).filter(c=>!/institu/i.test(c.nombre||'')).map(c=>String(c.id));
  CANAL_NOMBRE=new Map((j.canales||[]).map(c=>[String(c.id), c.nombre]));
  const centros=[...new Map(REPS.filter(r=>r.CedCodigo).map(r=>[r.CedCodigo,r.Centro])).entries()].map(([v,t])=>({v,t}));
  const divis=[...new Set(REPS.map(r=>r.Division).filter(Boolean))].sort().map(v=>({v,t:'División '+v}));
  MS.centro=multiselect($('#ms-centro'),'Centro',centros,depend);
  MS.sup=multiselect($('#ms-sup'),'Supervisor',[],depend);
  MS.ven=multiselect($('#ms-ven'),'Vendedor',[]);
  MS.div=multiselect($('#ms-div'),'División',divis);
  MS.canal=multiselect($('#ms-canal'),'Canal',opt(j.canales||[])); MS.canal.select(CANAL_DEF);
  MS.suplidor=multiselect($('#ms-suplidor'),'Suplidor',opt(j.suplidores||[]));
  MS.categoria=multiselect($('#ms-categoria'),'Categoría',opt(j.categorias||[]));
  MS.producto=multiselect($('#ms-producto'),'Producto',opt(j.productos||[]));
  MS.grupoCliente=multiselect($('#ms-grupocli'),'Grupo Clientes',(j.gruposCliente||[]).map(x=>({v:String(x.id),t:x.nombre||x.id})));
  depend();
  // ── Filtros propios de la pestaña Activaciones
  AOPT.centro=centros;
  AOPT.sup=[...new Map(REPS.filter(r=>r.SupervisorCod).map(r=>[r.SupervisorCod,r.SupervisorNombre])).entries()].map(([v,t])=>({v,t}));
  AOPT.ven=REPS.map(r=>({v:r.RepCodigo,t:r.RepCodigo+' - '+r.Nombre}));
  AOPT.suplidor=opt(j.suplidores||[]); AOPT.categoria=opt(j.categorias||[]); AOPT.producto=opt(j.productos||[]);
  AOPT.grupo=(j.grupos||[]).map(x=>({v:String(x.id),t:x.nombre||x.id}));
  AOPT.canal=opt(j.canales||[]);
  AOPT.gruposCliente=(j.gruposCliente||[]).map(x=>({v:String(x.id),t:x.nombre||x.id}));
  AMS.centro=multiselect($('#ams-centro'),'Centro',centros,adepend);
  AMS.sup=multiselect($('#ams-sup'),'Supervisor',[],adepend);
  AMS.ven=multiselect($('#ams-ven'),'Vendedor',[]);
  AOPT.div=divis;
  AMS.div=multiselect($('#ams-div'),'División',divis);
  AMS.suplidor=multiselect($('#ams-suplidor'),'Suplidor',AOPT.suplidor);
  AMS.categoria=multiselect($('#ams-categoria'),'Categoría',AOPT.categoria);
  AMS.producto=multiselect($('#ams-producto'),'Producto',AOPT.producto);
  AMS.grupo=multiselect($('#ams-grupo'),'Grupo',AOPT.grupo);
  AMS.canal=multiselect($('#ams-canal'),'Canal',AOPT.canal); AMS.canal.select(CANAL_DEF);
  AMS.grupoCliente=multiselect($('#ams-grupocli'),'Grupo Clientes',AOPT.gruposCliente);
  adepend();
  // ── Filtros de Comparativos
  CMS.centro=multiselect($('#cms-centro'),'Centro',centros,cdepend);
  CMS.sup=multiselect($('#cms-sup'),'Supervisor',[],cdepend);
  CMS.ven=multiselect($('#cms-ven'),'Vendedor',[]);
  CMS.div=multiselect($('#cms-div'),'División',divis);
  CMS.suplidor=multiselect($('#cms-suplidor'),'Suplidor',AOPT.suplidor);
  CMS.categoria=multiselect($('#cms-categoria'),'Categoría',AOPT.categoria);
  CMS.producto=multiselect($('#cms-producto'),'Producto',AOPT.producto);
  CMS.grupo=multiselect($('#cms-grupo'),'Grupo',AOPT.grupo);
  CMS.canal=multiselect($('#cms-canal'),'Canal',AOPT.canal); CMS.canal.select(CANAL_DEF);
  CMS.grupoCliente=multiselect($('#cms-grupocli'),'Grupo Clientes',AOPT.gruposCliente);
  cdepend(); cVista();
  // ── Tamaños (fijos) y filtros de Perdidos / Recuperados
  AOPT.tam=[{v:'1',t:'A Grande'},{v:'2',t:'B Mediano'},{v:'3',t:'C Pequeño'},{v:'4',t:'D1 Muy Peq.'},{v:'5',t:'D2 Muy Peq.'},{v:'6',t:'D3 Muy Peq.'},{v:'7',t:'D4 Muy Peq.'},{v:'0',t:'Sin clasif.'}];
  // Día de visita: mismo código de 7 posiciones Lun..Dom que resuelve el backend
  // (PrimerDiaActivo/DiaVisitaTexto) — acá solo se listan los 7 días como opciones.
  AOPT.diaVisita=['Lunes','Martes','Miércoles','Jueves','Viernes','Sábado','Domingo'].map(d=>({v:d,t:d}));
  const mkMs=(id,label,opts,cb)=>{ const h=$('#'+id); return h?multiselect(h,label,opts,cb):null; };
  const initPR=(pref,ms)=>{ ms.centro=mkMs(pref+'-centro','Centro',centros,()=>prDepend(pref,ms)); ms.sup=mkMs(pref+'-sup','Supervisor',[],()=>prDepend(pref,ms)); ms.ven=mkMs(pref+'-ven','Vendedor',[]); ms.div=mkMs(pref+'-div','División',divis); ms.suplidor=mkMs(pref+'-suplidor','Suplidor',AOPT.suplidor); ms.categoria=mkMs(pref+'-categoria','Categoría',AOPT.categoria); ms.producto=mkMs(pref+'-producto','Producto',AOPT.producto); ms.grupo=mkMs(pref+'-grupo','Grupo',AOPT.grupo); ms.tam=mkMs(pref+'-tam','Tamaño',AOPT.tam); ms.grupoCliente=mkMs(pref+'-grupocli','Grupo Clientes',AOPT.gruposCliente); prDepend(pref,ms); };
  initPR('pms',PMS); initPR('rms',RMS);
  // defaults de fechas
