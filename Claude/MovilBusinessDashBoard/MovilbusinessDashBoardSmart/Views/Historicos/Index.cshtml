@{ Layout = null; var showMenu = ViewBag.ShowMenu == null || (bool)ViewBag.ShowMenu; }
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Históricos &mdash; AM COMERCIAL</title>
<script src="@(Context.Request.PathBase)/lib/xlsx.full.min.js"></script>
<style>
:root{
  --bg:#F7F9F7;--panel:#FFFFFF;--panel2:#F0F4F0;--border:#D9E2D9;--line:#E6ECE6;
  --text:#1F2A22;--muted:#5C6B5F;--accent:#283078;--accent2:#3357C4;
  --good:#2E9E4A;--warn:#D29922;--bad:#C0392B;--purple:#6C3FC4;
  --good-bg:#EAF7EE;--warn-bg:#FBF3DA;--bad-bg:#FBEAEA;--purple-bg:#F1EAFB;
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:'Segoe UI',Tahoma,sans-serif;font-size:13px}
a{color:var(--accent2);text-decoration:none;cursor:pointer}
.top{display:flex;align-items:center;gap:14px;padding:12px 18px;background:var(--panel);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:20}
.top h1{font-size:17px;font-weight:800}.top .sub{font-size:11px;color:var(--muted)}
.spacer{flex:1}
.btn{background:var(--panel2);border:1px solid var(--border);color:var(--text);border-radius:7px;padding:7px 12px;font-size:12px;cursor:pointer;font-weight:600}
.btn:hover{border-color:var(--accent2)}
.btn-go{background:var(--accent);border-color:var(--accent);color:#fff}.btn-go:hover{background:var(--accent2)}
.tabs{display:flex;gap:4px;padding:10px 18px 0;background:var(--bg);border-bottom:1px solid var(--border);flex-wrap:wrap}
.tab{padding:8px 14px;border-radius:8px 8px 0 0;cursor:pointer;font-weight:600;color:var(--muted);font-size:12px}
.tab.on{background:var(--panel);color:var(--text);border:1px solid var(--border);border-bottom:none}
.tab.dis{opacity:.5;cursor:not-allowed}
.wrap{padding:16px 18px}
.filtros{display:flex;flex-wrap:wrap;gap:10px;align-items:end;margin-bottom:14px}
.fld input[type=date]{background:var(--panel);border:1px solid var(--border);color:var(--text);border-radius:7px;padding:7px}
.sel{background:var(--panel);border:1px solid var(--border);color:var(--text);border-radius:7px;padding:7px;font-size:12px;max-width:180px}
.ms{position:relative;min-width:140px}
.ms-btn{background:var(--panel);border:1px solid var(--border);border-radius:7px;padding:7px 10px;font-size:12px;cursor:pointer;display:flex;justify-content:space-between;gap:8px;align-items:center}
.ms-btn .cnt{background:var(--accent);color:#fff;border-radius:10px;padding:0 7px;font-size:11px}
.ms-pop{display:none;position:absolute;top:105%;left:0;z-index:30;background:var(--panel);border:1px solid var(--border);border-radius:8px;width:240px;max-height:280px;overflow:auto;box-shadow:0 8px 24px rgba(0,0,0,.15);padding:6px}
.ms-pop.open{display:block}
.ms-search{width:100%;background:var(--bg);border:1px solid var(--border);color:var(--text);border-radius:6px;padding:6px;font-size:12px;margin-bottom:5px}
.ms-head{display:flex;justify-content:space-between;padding:2px 4px 6px}
.ms-link{font-size:11px;color:var(--accent2);cursor:pointer}
.ms-opt{display:flex;align-items:center;gap:7px;padding:5px 6px;border-radius:5px;cursor:pointer}.ms-opt:hover{background:var(--panel2)}
.lbl{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px;display:block}
.cards{display:flex;gap:8px;flex-wrap:nowrap;margin-bottom:14px;overflow-x:auto}
.card{background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:10px 12px;flex:1 1 0;min-width:120px}
.card .cl{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.card .cv{font-size:17px;font-weight:800;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.card .ch{font-size:10px;color:var(--muted);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
/* Tarjetas de Notas de Crédito: más chicas y con acento de color (pedido del usuario) */
.nc-cards-mini.cards{gap:6px;margin-bottom:8px}
.nc-cards-mini .card{padding:6px 10px;border-radius:8px;min-width:0;flex:0 1 170px;border-color:var(--accent2);background:linear-gradient(135deg,var(--panel) 55%,var(--panel2))}
.nc-cards-mini .card .cl{font-size:9px}
.nc-cards-mini .card .cv{font-size:14px;color:var(--accent)}
.nc-cards-mini .card .ch{font-size:9px}
/* Tabla de Notas de Crédito: se ajusta a su contenido en vez de estirarse a todo el
   ancho del panel — evita el hueco enorme entre el nombre y las columnas numéricas. */
#nc-tabla table{width:auto;min-width:520px;max-width:100%}
.crumbs{margin:4px 0 10px;font-size:13px}
.crumb{color:var(--accent2);cursor:pointer}.crumb.cur{color:var(--text);font-weight:700;cursor:default}
.nivelbar{display:flex;gap:6px;margin-bottom:10px}
.btn-modo{background:var(--panel2);border:1px solid var(--border);color:var(--muted);border-radius:7px;padding:6px 12px;font-size:12px;cursor:pointer}
.btn-modo.on{background:var(--accent);border-color:var(--accent);color:#fff}
/* Control segmentado (2026-09-28, pedido explícito: "los botones están muy feos... a la
   derecha encima de los filtros" — antes usaban una clase .seg que no existía en este
   archivo, cayendo al estilo por defecto del navegador). 1 solo contenedor con padding,
   botones SIN borde propio (se diferencian por el fondo), la opción activa resaltada en
   --accent con una sombra sutil — mismo lenguaje visual que .btn-modo (mismos colores)
   pero en formato "pastilla única", más compacto para vivir junto a los filtros. */
.hist-toolbar{display:flex;justify-content:flex-end;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:10px}
/* Caja con alto fijo para cada canvas de Chart.js — sin esto, un canvas responsive
   dentro de un contenedor ancho y sin altura calcula su alto a partir del ancho
   (pedido explícito 2026-09-30: el gráfico de línea salía "fuera de la página"). */
.graf-box{position:relative;height:260px}
.graf-box-linea{position:relative;height:300px}
.seg{display:inline-flex;background:var(--panel2);border:1px solid var(--border);border-radius:9px;padding:3px;gap:2px}
.seg button{background:transparent;border:none;color:var(--muted);font-size:12.5px;font-weight:600;padding:6px 14px;border-radius:6px;cursor:pointer;transition:background .15s,color .15s}
.seg button.on{background:var(--accent);color:#fff;box-shadow:0 1px 3px rgba(0,0,0,.15)}
.seg button:hover:not(.on){background:rgba(0,0,0,.05)}
table{width:100%;border-collapse:collapse;font-size:12px}
th,td{padding:7px 9px;text-align:right;border-bottom:1px solid var(--line);white-space:nowrap}
th{position:sticky;top:0;background:var(--panel);color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.4px;z-index:5}
td.l,th.l{text-align:left}
tbody tr.clickable{cursor:pointer}tbody tr.clickable:hover{background:var(--panel2)}
tr.totals td{border-top:2px solid var(--border);font-weight:800;background:var(--panel2)}
.pos{color:var(--good);font-weight:700}.neg{color:var(--bad);font-weight:700}
/* columnas fijas (Cod.Cte./Nombre Cliente) al desplazar horizontalmente */
.vc-stick1{position:sticky;left:0;z-index:2;background:var(--bg);width:90px;max-width:90px}
.vc-stick2{position:sticky;left:90px;z-index:2;background:var(--bg);box-shadow:2px 0 4px -2px rgba(0,0,0,.15)}
thead .vc-stick1,thead .vc-stick2{z-index:6;background:var(--panel)}
tr.totals .vc-stick1,tr.totals .vc-stick2{background:var(--panel2)}
/* columnas fijas de "Comparativo Ctes." (Supervisor/Vendedor/Cliente/Tamaño) — 4
   columnas en vez de 2, mismo mecanismo que .vc-stick1/2 */
.ctc-stick1{position:sticky;left:0;z-index:2;background:var(--bg);width:150px;max-width:150px}
.ctc-stick2{position:sticky;left:150px;z-index:2;background:var(--bg);width:150px;max-width:150px}
.ctc-stick3{position:sticky;left:300px;z-index:2;background:var(--bg);width:190px;max-width:190px}
.ctc-stick4{position:sticky;left:490px;z-index:2;background:var(--bg);width:80px;max-width:80px;box-shadow:2px 0 4px -2px rgba(0,0,0,.15)}
thead .ctc-stick1,thead .ctc-stick2,thead .ctc-stick3,thead .ctc-stick4{z-index:6;background:var(--panel)}
tr.totals .ctc-stick1,tr.totals .ctc-stick2,tr.totals .ctc-stick3,tr.totals .ctc-stick4{background:var(--panel2)}
tr.ctc-sup-total td{border-top:2px solid var(--accent)!important}
.mini{font-size:11px;color:var(--muted)}
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.25);z-index:60;align-items:center;justify-content:center}
.overlay.show{display:flex}
.spin{width:34px;height:34px;border:3px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:sp 1s linear infinite}
@@keyframes sp{to{transform:rotate(360deg)}}
.hide{display:none}.hint{font-size:12px;color:var(--muted);padding:20px;text-align:center}
.phead{font-size:13px;color:var(--muted);margin:2px 0 10px;padding:6px 10px;background:var(--panel);border:1px solid var(--border);border-radius:8px}
/* matriz de activaciones */
.mtx th.per,.mtx td.per{text-align:right;min-width:78px}
.mtx td.tot,.mtx th.tot{background:var(--panel2);font-weight:800;border-left:2px solid var(--border)}
.mtx tr.row-sup td{background:var(--panel2);font-weight:700}
/* comparativos */
.cmp-inci{background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:10px 14px;margin-bottom:12px}
.cmp-inci .t{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px}
.cmp-inci ul{margin:0;padding-left:18px}.cmp-inci li{font-size:12.5px;margin:3px 0}
.chip{display:inline-block;font-size:11px;font-weight:700;padding:1px 7px;border-radius:9px;margin-left:6px}
.chip.up{background:var(--good-bg);color:var(--good)}.chip.dn{background:var(--bad-bg);color:var(--bad)}.chip.eq{background:var(--panel2);color:var(--muted)}
.mtx tbody tr:hover td{background:var(--panel2)}
.pct{font-size:10px;color:var(--muted);margin-left:3px}
.up{color:var(--good)}.dn{color:var(--bad)}.eq{color:var(--muted)}
#a-print-head{display:none}
/* impresión / PDF */
@@media print{
  .top .btn,.top a,.tabs,.filtros,.overlay,#btn-excel{display:none!important}
  *{-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important}
  body{background:#fff!important;color:#000!important;font-size:10pt}
  .top{border-bottom:2px solid #000;background:#fff!important}
  .top h1,.top .sub{color:#000!important}
  #a-print-head{display:block!important;margin:8px 0 10px;font-size:9pt;color:#333}
  #a-print-head b{color:#000}
  .wrap{padding:0!important}
  div[style*="overflow:auto"]{overflow:visible!important;max-height:none!important}
  .card{border:1px solid #999!important;background:#fff!important}
  .card .cl{color:#444!important}.card .cv{color:#000!important}
  table{font-size:8pt!important}
  th{background:#e8e8e8!important;color:#000!important;border:1px solid #999!important;position:static!important}
  td{border:1px solid #ccc!important;color:#000!important}
  .mtx td.tot,.mtx th.tot{background:#d6e4ff!important}
  tr.totals td{background:#d6e4ff!important;font-weight:800!important}
  .up{color:#1a7a1a!important}.dn{color:#c00000!important}
  thead{display:table-header-group!important}tr{page-break-inside:avoid}
  @@page{size:landscape;margin:1cm 1.27cm}
}
</style>
</head>
<body>
<div class="top">
  <div><h1>📊 Históricos</h1><div class="sub">@ViewBag.EmpNombre</div></div>
  <div class="spacer"></div>
  <button class="btn" id="btn-excel">⬇ Excel</button>
  @if (showMenu) { <a class="btn" href="@(Context.Request.PathBase)/menu">← Menú</a> }
</div>

<div class="tabs">
  <div class="tab on" data-t="ventas" onclick="tab('ventas')">Ventas (Sup./Vend.)</div>
  <div class="tab" data-t="notascredito" onclick="tab('notascredito')">Notas de Crédito</div>
  <div class="tab" data-t="pedidos" onclick="tab('pedidos')">Pedidos</div>
  <div class="tab" data-t="supcat" onclick="tab('supcat')">Suplidor / Categoría</div>
  <div class="tab" data-t="activ" onclick="tab('activ')">Activaciones</div>
  <div class="tab" data-t="promos" onclick="tab('promos')">Ofertas y Descuentos</div>
  <div class="tab" data-t="analisis" onclick="tab('analisis')">Análisis</div>
  <div class="tab" data-t="vendcte" onclick="tab('vendcte')">Vend./Cte.</div>
  <div class="tab" data-t="pedfactnc" onclick="tab('pedfactnc')">Ped-Fact-NC</div>
  <div class="tab" data-t="fillrate" onclick="tab('fillrate')">Fill Rate</div>
  <div class="tab" data-t="invfis" onclick="tab('invfis')">Inventarios Físicos</div>
</div>

<div class="wrap" id="t-ventas">
  <div class="hist-toolbar">
    <div id="v-esquema-wrap" style="display:none"><span class="lbl">Esquema</span>
      <select id="v-esquema" onchange="vmRender()">
        <option value="compania">Total Compañía</option>
        <option value="centro">Por Centro</option>
        <option value="supervisor">Por Supervisor</option>
        <option value="vendedor">Por Vendedor</option>
      </select>
    </div>
    <div class="seg" id="v-modo-seg">
      <button class="on" id="v-modo-rango" onclick="vSetModo('rango')">Rango</button>
      <button id="v-modo-mensual" onclick="vSetModo('mensual')">Mes a Mes</button>
    </div>
    <div class="seg" id="v-graf-seg">
      <button class="on" id="v-vista-tabla" onclick="histToggleVista('v','tabla')">Tabla</button>
      <button id="v-vista-graf" onclick="histToggleVista('v','graf',vRenderGraficos)">📊 Gráficos</button>
    </div>
  </div>
  <div class="filtros">
    <div class="fld"><span class="lbl">Desde</span><input type="date" id="f-ini"></div>
    <div class="fld"><span class="lbl">Hasta</span><input type="date" id="f-fin"></div>
    <div><span class="lbl">Centro</span><div id="ms-centro"></div></div>
    <div><span class="lbl">Supervisor</span><div id="ms-sup"></div></div>
    <div><span class="lbl">Vendedor</span><div id="ms-ven"></div></div>
    <div><span class="lbl">División</span><div id="ms-div"></div></div>
    <div><span class="lbl">Canal</span><div id="ms-canal"></div></div>
    <div><span class="lbl">Suplidor</span><div id="ms-suplidor"></div></div>
    <div><span class="lbl">Categoría</span><div id="ms-categoria"></div></div>
    <div><span class="lbl">Producto</span><div id="ms-producto"></div></div>
    <div><span class="lbl">Grupo Clientes</span><div id="ms-grupocli"></div></div>
    <button class="btn btn-go" id="btn-go">Generar</button>
    <button class="btn" onclick="window.print()">🖨 Imprimir</button>
    <button class="btn" id="v-btn-pdf" onclick="pdfVentas()">⬇ PDF</button>
  </div>
  <div id="v-print-head"></div>
  <div id="v-tabla-wrap">
    <div id="v-vista-rango">
      <div class="cards" id="cards"></div>
      <div class="crumbs" id="crumbs"></div>
      <div class="nivelbar" id="nivelbar"></div>
      <div style="overflow:auto;max-height:60vh"><div id="tabla"></div></div>
    </div>
    <div id="v-vista-mensual" class="hide">
      <div style="overflow:auto;max-height:70vh"><div id="tabla-mensual"></div></div>
    </div>
  </div>
  <div id="v-graficos-wrap" class="hide">
    <div style="display:flex;flex-wrap:wrap;gap:16px">
      <div class="graf-box" style="flex:1 1 320px;max-width:480px"><canvas id="v-graf-pastel"></canvas></div>
      <div class="graf-box" style="flex:1 1 320px;max-width:480px"><canvas id="v-graf-barra"></canvas></div>
      <div class="graf-box-linea" style="flex:1 1 100%"><canvas id="v-graf-linea"></canvas></div>
    </div>
  </div>
</div>

<!-- ═══════════ NOTAS DE CRÉDITO ═══════════ -->
<div class="wrap hide" id="t-notascredito">
  <div class="hist-toolbar" style="justify-content:space-between">
    <h2 style="font-size:15px;margin:0">Notas de Crédito — Resumida y Detallada</h2>
    <div class="seg" id="nc-graf-seg">
      <button class="on" id="nc-vista-tabla" onclick="histToggleVista('nc','tabla')">Tabla</button>
      <button id="nc-vista-graf" onclick="histToggleVista('nc','graf',ncRenderGraficos)">📊 Gráficos</button>
    </div>
  </div>
  <div class="nivelbar" style="margin-bottom:10px">
    <button class="btn-modo on" id="nc-btn-org" onclick="ncModo('org')">Por Organización</button>
    <button class="btn-modo" id="nc-btn-causa" onclick="ncModo('causa')">Por Causa</button>
  </div>
  <div class="filtros">
    <div class="fld"><span class="lbl">Desde</span><input type="date" id="nc-ini"></div>
    <div class="fld"><span class="lbl">Hasta</span><input type="date" id="nc-fin"></div>
    <div><span class="lbl">Centro</span><div id="ncms-centro"></div></div>
    <div><span class="lbl">Supervisor</span><div id="ncms-sup"></div></div>
    <div><span class="lbl">Vendedor</span><div id="ncms-ven"></div></div>
    <div><span class="lbl">División</span><div id="ncms-div"></div></div>
    <div><span class="lbl">Cliente</span><div id="ncms-cliente"></div></div>
    <div><span class="lbl">Suplidor</span><div id="ncms-suplidor"></div></div>
    <div><span class="lbl">Categoría</span><div id="ncms-categoria"></div></div>
    <div><span class="lbl">Grupo Producto</span><div id="ncms-grupo"></div></div>
    <div><span class="lbl">Grupo Clientes</span><div id="ncms-grupocli"></div></div>
    <div><span class="lbl">Tamaño</span><div id="ncms-tam"></div></div>
    <div><span class="lbl">Producto</span><div id="ncms-producto"></div></div>
    <div class="fld" id="nc-nivel-wrap"><span class="lbl">Analizar por</span>
      <select class="sel" id="nc-nivel">
        <option value="centro">Centro</option>
        <option value="supervisor">Centro → Supervisor</option>
        <option value="vendedor" selected>Centro → Supervisor → Vendedor</option>
        <option value="cliente">Centro → Supervisor → Vendedor → Cliente</option>
      </select></div>
    <div class="fld" id="nc-vista-wrap"><span class="lbl">Vista</span>
      <select class="sel" id="nc-vista"><option value="resumido">Resumido</option><option value="detallado">Detallado</option></select></div>
    <div class="fld"><span class="lbl">Periodo</span>
      <select class="sel" id="nc-periodo"><option value="acum">Acumulado</option><option value="dia">Por Día</option></select></div>
    <button class="btn btn-go" onclick="generarNC()">Generar</button>
    <button class="btn" onclick="window.print()">🖨 Imprimir</button>
    <button class="btn" onclick="excelNC()">📥 Excel</button>
    <button class="btn" id="nc-btn-pdf" onclick="pdfNC()">⬇ PDF</button>
    <button class="btn" id="nc-btn-cards" onclick="ncToggleCards()">Ocultar tarjetas</button>
  </div>
  <div id="nc-print-head"></div>
  <div class="cards nc-cards-mini" id="nc-cards"></div>
  <div id="nc-cards-centro" style="margin-bottom:14px"></div>
  <div id="nc-tabla-wrap">
    <div style="overflow:auto;max-height:56vh"><div id="nc-tabla"><div class="hint">Elige el rango y presiona <b>Generar</b>.</div></div></div>
  </div>
  <div id="nc-graficos-wrap" class="hide">
    <div style="display:flex;flex-wrap:wrap;gap:16px">
      <div class="graf-box" style="flex:1 1 320px;max-width:480px"><canvas id="nc-graf-pastel"></canvas></div>
      <div class="graf-box" style="flex:1 1 320px;max-width:480px"><canvas id="nc-graf-barra"></canvas></div>
      <div class="graf-box-linea" style="flex:1 1 100%"><canvas id="nc-graf-linea"></canvas></div>
    </div>
  </div>
</div>

<!-- ═══════════ PEDIDOS ═══════════ -->
<div class="wrap hide" id="t-pedidos">
  <div class="hist-toolbar" style="justify-content:space-between">
    <h2 style="font-size:15px;margin:0">Pedidos</h2>
    <div class="seg" id="pd-graf-seg">
      <button class="on" id="pd-vista-tabla" onclick="histToggleVista('pd','tabla')">Tabla</button>
      <button id="pd-vista-graf" onclick="histToggleVista('pd','graf',pdRenderGraficos)">📊 Gráficos</button>
    </div>
  </div>
  <div class="filtros">
    <div class="fld"><span class="lbl">Desde</span><input type="date" id="pd-ini"></div>
    <div class="fld"><span class="lbl">Hasta</span><input type="date" id="pd-fin"></div>
    <div><span class="lbl">Centro</span><div id="pdms-centro"></div></div>
    <div><span class="lbl">Supervisor</span><div id="pdms-sup"></div></div>
    <div><span class="lbl">Vendedor</span><div id="pdms-ven"></div></div>
    <div><span class="lbl">División</span><div id="pdms-div"></div></div>
    <div><span class="lbl">Canal</span><div id="pdms-canal"></div></div>
    <div><span class="lbl">Suplidor</span><div id="pdms-suplidor"></div></div>
    <div><span class="lbl">Categoría</span><div id="pdms-categoria"></div></div>
