    XLSX.writeFile(wb,'historico_ventas_'+(RANGO?RANGO.ini:'')+'.xlsx');
  });
};
/* Excel de Activaciones: cabecera con la selección + matriz */
function excelActiv(){
  if(!ADATA||!(ADATA.filas||[]).length){ alert('Genera el informe primero.'); return; }
  ensureXLSX(()=>{
    const j=ADATA, per=j.periodos||[], esRep=j.modo==='rep';
    const dimNom={suplidor:'Suplidor',categoria:'Categoría',grupo:'Grupo Producto',producto:'Producto',canal:'Canal'}[j.dimProd]||'Ítem';
    const fl=[]; const addF=(l,ms,arr)=>{const n=nomsDe(ms,arr); if(n.length)fl.push([l,n.join(', ')]);};
    addF('Centro',AMS.centro,AOPT.centro); addF('Supervisor',AMS.sup,AOPT.sup); addF('Vendedor',AMS.ven,AOPT.ven);
    addF('División',AMS.div,AOPT.div);
    addF('Suplidor',AMS.suplidor,AOPT.suplidor); addF('Categoría',AMS.categoria,AOPT.categoria);
    addF('Producto',AMS.producto,AOPT.producto); addF('Grupo',AMS.grupo,AOPT.grupo); addF('Canal',AMS.canal,AOPT.canal);
    if(ADRILL.sup) fl.push(['Drill',ADRILL.supNom+(ADRILL.cat?' › '+ADRILL.catNom:'')]);
    const baseTxt={ruta:'RutaVisitas (Totales)',rvfh_gen:'RutaVisitasFecha (General)',rvfh_acum:'RutaVisitasFecha (Acumulado)'}[j.baseCmp]||'—';
    const head=[[EMP+' — Activaciones (clientes distintos que compraron)'],
      ['Período',j.desde+' al '+j.hasta],['Fuente',j.fuente==='pedidos'?'Pedidos':'Ventas'],
      ['Esquema',{general:'General',mes:'Mensual',semana:'Semanal',dia:'Diario'}[j.grano]],
      ['Reporte',esRep?'Por Representante ('+AVISTA+')':'Por '+dimNom],['Comparado vs',baseTxt]]
      .concat(fl.length?fl:[['Filtros','(todo)']]).concat([['Generado',new Date().toLocaleString('es-DO')],[]]);
    const conBase=!!j.baseCmp;
    const H=(esRep?['Nivel','Centro','Supervisor','Código','Nombre']:[dimNom+' Cód',dimNom])
      .concat(conBase?[esRep?'Asignados':'Total clientes']:[]).concat(per.map(p=>p.label)).concat(['Total (distintos)','Total año ant.']);
    const nivLbl={centro:'Centro',sup:'Supervisor',rep:'Vendedor',item:'Ítem'};
    const orden=esRep?(AVISTA==='resumido'?['centro','sup']:['centro','sup','rep']):['item'];
    const rows=[];
    (j.filas||[]).filter(f=>orden.includes(f.nivel)).forEach(f=>{
      const base=esRep?[nivLbl[f.nivel],f.cedNombre,f.nivel==='centro'?'':f.supNombre,f.id,f.nombre]:[f.id,f.nombre];
      rows.push(base.concat(conBase?[f.asignados||0]:[])
        .concat(per.map(p=>f.valores[p.k]||0)).concat([f.total,f.totalPrev||0]));
    });
    const T=j.total||{valores:{}};
    rows.push((esRep?['TOTAL','','','','TOTAL GENERAL']:['','TOTAL GENERAL'])
      .concat(conBase?[T.asignados||0]:[])
      .concat(per.map(p=>T.valores[p.k]||0)).concat([T.total||0,T.totalPrev||0]));
    const ws=XLSX.utils.aoa_to_sheet(head.concat([H]).concat(rows));
    ws['!cols']=H.map((h,i)=>({wch:i<(esRep?5:2)?22:12}));
    const wb=XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb,ws,'Activaciones');
    XLSX.writeFile(wb,'activaciones_'+j.desde+'_'+j.hasta+'.xlsx');
  });
}
