    '<div><b>Fecha Base:</b> '+$('#ctc-ini').value+' al '+$('#ctc-fin').value+' &nbsp;·&nbsp; <b>Comparación:</b> '+$('#ctc-comp-ini').value+' al '+$('#ctc-comp-fin').value+' &nbsp;·&nbsp; <b>Modo:</b> '+($('#ctc-modo').value==='maestra'?'Vs Maestra Clientes':'Rango vs Rango')+'</div>'+
