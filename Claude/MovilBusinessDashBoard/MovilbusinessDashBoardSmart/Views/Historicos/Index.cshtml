// 'extraQs' (agregado 2026-09-27, pedido explícito: "la tarjeta que se genera de los
// pendientes, debe ser de los filtros que se realicen, si se hace un drill down tambien
// el filtro debe aplicar a esto") — fragmento de querystring del drill activo (mismo
// PD_DRILL.qs que ya usa pdCargarDrill para la tabla principal), fusionado con REEMPLAZO
// sobre los filtros de pantalla (mismo motivo que en pdCargarDrill: un drill a
// "Estatus 11" no debe seguir arrastrando el estatus=2,7,11 del filtro general). Antes
// las 3 tarjetas ("Pedidos del Día"/"Pendientes por Facturar"/"Pedidos Perdidos") y las
// mini-tablas Por Canal/Por Centro solo se recalculaban al presionar "Generar" — nunca
// al drillear, así que quedaban desactualizadas respecto a lo que se estaba mirando.
function pdCargarTarjetas(extraQs){
  const p=new URLSearchParams();
  prFiltros(PDMS,p);
  if(PDMS.estatus && PDMS.estatus.values().length) p.set('estatus',PDMS.estatus.values().join(','));
  p.set('fechaIni',$('#pd-ini').value); p.set('fechaFin',$('#pd-fin').value);
  if(extraQs){ new URLSearchParams(extraQs).forEach((v,k)=>{ p.set(k,v); }); }
  fetch(BASE+'/apihist/pedidos-tarjetas?'+p.toString()).then(r=>r.json()).then(j=>{
    if(!j||!j.ok) return;
    const cardC=(l,val,extra)=>'<div class="card"><div class="cl">'+l+'</div><div class="cv">'+val+'</div><div class="ch">'+(extra||'')+'</div></div>';
    let h='';
    h+=cardC('Pedidos del Día',fmtRD(j.hoy.monto), fmtN(j.hoy.cantidad)+' pedidos');
    h+=cardC('Pendientes por Facturar',fmtRD(j.pendientes.monto), fmtN(j.pendientes.cantidad)+' pedidos (estatus 2 y 7)');
    h+=cardC('Pedidos Perdidos (tipo Fill Rate)', j.perdidos.incidencia==null?'n/d':j.perdidos.incidencia.toFixed(1)+'%',
      'Sin facturar: '+fmtRD(j.perdidos.montoSinFacturar)+' · Pedido '+fmtRD(j.perdidos.montoPedido)+' · Facturado '+fmtRD(j.perdidos.montoFacturado));
    $('#pd-cards').innerHTML=h;
    const tabla=(titulo,filas,col)=>{
      let t='<div class="mini" style="margin:6px 0 4px">'+titulo+'</div><table><thead><tr><th class="l">'+col+'</th><th>Monto Hoy</th><th>Pedidos</th></tr></thead><tbody>';
      filas.slice().sort((a,b)=>b.monto-a.monto).forEach(c=>{ t+='<tr><td class="l">'+(c.canal||c.centro)+'</td><td>'+fmtRD(c.monto)+'</td><td>'+fmtN(c.cantidad)+'</td></tr>'; });
      t+='</tbody></table>'; return t;
    };
    $('#pd-cards-desglose').innerHTML='<div style="display:flex;gap:20px;flex-wrap:wrap">'+
      '<div>'+tabla('Por Canal (hoy)',j.hoy.porCanal||[],'Canal')+'</div>'+
      '<div>'+tabla('Por Centro (hoy)',j.hoy.porCentro||[],'Centro')+'</div></div>';
  }).catch(()=>{});
}
// Gráficos de Pedidos — Pastel/Barra según el 'modo' activo (estatus/suplidor ya vienen
// pre-agregados del backend; centro/supervisor son 1 fila por pedido, se agrupan aquí
// mismo por Centro/Supervisor). Línea: reusa la capacidad modo=dia ya construida para el
// drill-down (50ª parte) — un fetch nuevo pero SIN backend nuevo, misma consulta que ya
// existe, solo que aquí se pide siempre (no solo al drillear una fila).
function pdRenderGraficos(){
  if(!PDDATA || !PDDATA.length) return;
  const modo=$('#pd-modo').value;
  let filas,lblFn;
  if(modo==='estatus'){ filas=PDDATA; lblFn=r=>r.Estatus+' - '+(r.Descripcion||''); }
  else if(modo==='suplidor'||modo==='suplidorprod'){ filas=PDDATA.filter(r=>r.Nivel==='suplidor'); lblFn=r=>r.SupID+' - '+(r.Suplidor||''); }
  else {
    const keyFn = modo==='centro' ? (r=>r.CedCodigo||'') : (r=>r.SupCod||'');
    const lblFn2 = modo==='centro' ? (r=>r.Centro||'(Sin centro)') : (r=>r.Supervisor||r.SupCod||'(Sin supervisor)');
    const mapa=new Map();
    PDDATA.forEach(r=>{ const k=keyFn(r); if(!mapa.has(k)) mapa.set(k,{lbl:lblFn2(r),MontoPed:0}); mapa.get(k).MontoPed+=r.MontoPed; });
    filas=[...mapa.values()]; lblFn=r=>r.lbl;
  }
  const top=topNConOtros(filas,10,r=>r.MontoPed,lblFn);
  const etqModo={estatus:'por Estatus',suplidor:'por Suplidor',suplidorprod:'por Suplidor',centro:'por Centro',supervisor:'por Supervisor'}[modo]||'por Centro';
  graficoPastel($('#pd-graf-pastel'),top.map(t=>t.lbl),top.map(t=>t.val),'Peso de Pedidos '+etqModo);
  graficoBarra($('#pd-graf-barra'),top.map(t=>t.lbl),top.map(t=>t.val),'Monto Bruto Pedidos','Monto Bruto Pedidos '+etqModo);
  const p=pdQs(); p.set('modo','dia');
  fetch(BASE+'/apihist/pedidos?'+p.toString()).then(r=>r.json()).then(j=>{
    if(!j||!j.ok) return;
    const filasDia=(j.filas||[]).slice().sort((a,b)=>a.Fecha<b.Fecha?-1:a.Fecha>b.Fecha?1:0);
    graficoLinea($('#pd-graf-linea'),filasDia.map(f=>ncFechaFmt(f.Fecha)),[{label:'Monto Bruto Pedidos',data:filasDia.map(f=>f.MontoPed)}],'Tendencia Diaria de Pedidos');
  }).catch(()=>{});
}
function excelPD(){
  if(!PDDATA.length){ alert('Genera el informe primero.'); return; }
  const modo=$('#pd-modo').value;
  ensureXLSX(()=>{
    const head=[[EMP+' — Pedidos'],['Rango',$('#pd-ini').value+' a '+$('#pd-fin').value],['Analizar por',modo],['Generado',new Date().toLocaleString('es-DO')],[]];
    let H, rows;
    if(modo==='suplidor'){
      H=['Nivel','SupID','Suplidor','CatID','Categoría','Cantidad Pedidos','Monto Bruto Pedidos','Monto Bruto Facturado'];
      rows=PDDATA.map(r=>[r.Nivel,r.SupID,r.Suplidor,r.CatID,r.Categoria,r.Cantidad,r.MontoPed,r.MontoFact]);
    } else if(modo==='suplidorprod'){
      H=['Nivel','SupID','Suplidor','CatID','Categoría','ProID','Producto','Cantidad Pedidos','Monto Bruto Pedidos','Monto Bruto Facturado'];
      rows=PDDATA.map(r=>[r.Nivel,r.SupID,r.Suplidor,r.CatID,r.Categoria,r.ProID,r.Producto,r.Cantidad,r.MontoPed,r.MontoFact]);
    } else if(modo==='estatus'){
      H=['Estatus','Descripción','Cantidad Pedidos','Monto Bruto Pedidos','Monto Bruto Facturado'];
      rows=PDDATA.map(r=>[r.Estatus,r.Descripcion,r.Cantidad,r.MontoPed,r.MontoFact]);
    } else {
      H=['Centro','Canal','Supervisor','Vendedor','Cantidad Pedidos','Monto Bruto Pedidos','Monto Bruto Facturado'];
      rows=PDDATA.map(r=>[r.Centro||'',r.Canal||'',r.Supervisor||'',(r.RepCodigo||'')+' - '+(r.Nombre||''),r.Cantidad,r.MontoPed,r.MontoFact]);
    }
    const ws=XLSX.utils.aoa_to_sheet(head.concat([H]).concat(rows));
