function excelPR(kind){
  const j=kind==='perd'?PDATA:RDATA; if(!j){ alert('Genera el reporte primero.'); return; }
  ensureXLSX(()=>{
    const wb=XLSX.utils.book_new(); const ph=j.padHead||[];
    const head=ph.concat([GRPNOM[j.tipo]]);
    let resHead, filas;
    if(kind==='perd'){ resHead=head.concat(['Asignados','Perdidos','% Perd.','% Cobertura']);
      filas=(j.filas||[]).map(f=>{ const pads=(f.padres||[]).slice(); const row=[]; for(let i=0;i<ph.length;i++)row.push(pads[i]!=null?pads[i]:''); row.push(f.grupo); row.push(f.asignados,f.perdidos,f.pct,+(100-f.pct).toFixed(1)); return row; });
    } else { resHead=head.concat(['Asignados','Sin compra base','% Sin','Recuperados','% Recup.']);
      filas=(j.filas||[]).map(f=>{ const pads=(f.padres||[]).slice(); const row=[]; for(let i=0;i<ph.length;i++)row.push(pads[i]!=null?pads[i]:''); row.push(f.grupo); row.push(f.asignados,f.sinCompra,f.pctSin,f.recuperados,f.pctRec); return row; });
    }
    const ws=XLSX.utils.aoa_to_sheet([resHead].concat(filas));
    XLSX.utils.book_append_sheet(wb,ws,'Resumen');
    const dHead=['Centro','Supervisor','División','Vendedor','Tamaño','Código','Cliente'];
    const dRows=(j.detalle||[]).map(r=>[r.Centro,r.Supervisor,r.Division||'',r.Vendedor,r.Tam,r.CliCod,r.CliNom]);
    XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet([dHead].concat(dRows)),'Detalle');
    const nm=(kind==='perd'?'ClientesPerdidos_':'ClientesRecuperados_')+(dateF(new Date()))+'.xlsx';
    XLSX.writeFile(wb,nm);
  });
}
