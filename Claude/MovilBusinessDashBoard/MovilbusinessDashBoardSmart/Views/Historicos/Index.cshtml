    const rows=DATA.slice().sort((a,b)=>b.Monto-a.Monto).map(v=>[v.Centro,v.Supervisor,v.Nombre,v.Vendedor,v.Division,Math.round(v.Uni),+(v.Caj||0).toFixed(1),Math.round(v.Monto),(v.Delta==null?'':v.Delta),v.Cli,v.Fac,Math.round(v.Ticket)]);
    const ws=XLSX.utils.aoa_to_sheet(head.concat([H]).concat(rows));
    ws['!cols']=H.map((h,i)=>({wch:i<3?22:13}));
