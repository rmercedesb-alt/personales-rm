// Excel de "Vs Maestra Clientes" (2026-09-13) — forma de datos distinta a los otros 2
// modos (j.rango en vez de j.rangoA, sin j.comparacion, filas con
// clientesAsignados/clientesActivados/pctActivacion/montoTotal en vez de
// montoMain/montoComp/pctMonto/facMain/facComp/pctFac) — antes esto hacía que
// excelComp() tronara con un TypeError síncrono (j.rangoA.ini de undefined) sin
// ningún alert ni feedback, exactamente el "no hace nada" que reportó el usuario.
function excelCompMaestra(){
  ensureXLSX(()=>{
    const j=CDATA;
    const head=[[EMP+' — Comparativo de '+(j.fuente==='pedidos'?'Pedidos':'Ventas')+' vs Maestra Clientes'],
      ['Rango',j.rango.ini+' al '+j.rango.fin],['Base','Clientes asignados (RutaVisitas)'],
      ['Clientes Asignados',j.cards.asignados],['Clientes Activados',j.cards.activados],
      ['% Activación',j.cards.pct==null?'':j.cards.pct],['Monto Total',j.cards.monto],
      ['Generado',new Date().toLocaleString('es-DO')],[]];
    const H=['Nivel','Supervisor/Vendedor','Clientes Asignados','Clientes en el rango','Δ% Activación','Monto rango'];
    const rows=(j.filas||[]).filter(f=>f.nivel==='sup'||f.nivel==='rep')
      .map(f=>[f.nivel==='sup'?'Supervisor':'Vendedor',f.nombre,f.clientesAsignados,f.clientesActivados,f.pctActivacion,Math.round(f.montoTotal)]);
    const sheets=[{name:'Comparativo',aoa:head.concat([H]).concat(rows)}];
    if(j.vista==='clientes'){
      const cliDet=(j.filas||[]).filter(f=>f.nivel==='cliDetalle');
      if(cliDet.length){
        const repNom={}; (j.filas||[]).filter(f=>f.nivel==='rep').forEach(f=>repNom[f.id]=f.nombre);
        const Hc=['Vendedor','Código Cliente','Nombre Cliente','Compró','Monto','Día de visita'];
        const rowsC=cliDet.map(f=>[repNom[f.padreId]||f.padreId,f.cliCodigo,f.cliNombre,f.activado?'Sí':'No',Math.round(f.monto),f.diaVisita]);
        sheets.push({name:'Clientes',aoa:[Hc].concat(rowsC)});
      }
    }
    const wb=XLSX.utils.book_new();
    sheets.forEach(s=>{ const ws=XLSX.utils.aoa_to_sheet(s.aoa); ws['!cols']=s.aoa[0].map((h,i)=>({wch:i===1?24:16})); XLSX.utils.book_append_sheet(wb,ws,s.name); });
    XLSX.writeFile(wb,'comparativo_maestra_'+j.rango.ini+'.xlsx');
  });
}
// Sirve los 3 modos por igual — renderComp()/renderCompMaestra() llenan los MISMOS
