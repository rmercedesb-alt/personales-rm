  // el drill manda sobre los filtros de suplidor/categoría
  if(ADRILL.sup) p.set('suplidores',ADRILL.sup);
  if(ADRILL.cat) p.set('categorias',ADRILL.cat);
  return p;
}
window.drillA=(id,nom)=>{ const d=dimEfectiva();
  if(d==='suplidor'){ ADRILL.sup=id; ADRILL.supNom=nom; }
  else if(d==='categoria'){ ADRILL.cat=id; ADRILL.catNom=nom; }
  else return;
  generarActiv();
};
window.drillReset=(n)=>{ if(n===0){ADRILL={sup:null,supNom:'',cat:null,catNom:''};} else if(n===1){ADRILL.cat=null;ADRILL.catNom='';} generarActiv(); };
function nomsDe(ms,arr){ const v=ms?ms.values():[]; return v.map(x=>{const o=(arr||[]).find(z=>z.v===x); return o?o.t:x;}); }
function generarActiv(){
  overlay(true);
  fetch(BASE+'/apihist/activaciones?'+aqs().toString()).then(r=>r.json()).then(j=>{
    overlay(false);
    if(!j||!j.ok){ alert('Error: '+(j&&j.error||'?')); return; }
    ADATA=j; renderActiv(j);
  }).catch(e=>{overlay(false);alert('Error de conexión: '+e);});
}
function flecha(cur,prev){
  if(prev==null||prev===undefined) return '';
  if(cur>prev) return ' <span class="up">▲</span>';
  if(cur<prev) return ' <span class="dn">▼</span>';
  return ' <span class="eq">=</span>';
}
function celda(n,base,prev){
  const pct=(base&&base>0)?'<span class="pct">('+Math.round(100*n/base)+'%)</span>':'';
  return fmtN(n)+pct+flecha(n,prev);
}
function renderActiv(j){
  const per=j.periodos||[], filas=j.filas||[], T=j.total||{valores:{},total:0,totalPrev:0,baseRuta:0};
  const esRep=j.modo==='rep', conBase=!!j.baseCmp;
  const dimNom={suplidor:'Suplidor',categoria:'Categoría',grupo:'Grupo Producto',producto:'Producto',canal:'Canal'}[j.dimProd]||'Ítem';
  // ── encabezado imprimible con la selección aplicada
  const fl=[];
  const addF=(lbl,ms,arr)=>{ const n=nomsDe(ms,arr); if(n.length) fl.push('<b>'+lbl+':</b> '+n.join(', ')); };
  addF('Centro',AMS.centro,AOPT.centro); addF('Supervisor',AMS.sup,AOPT.sup); addF('Vendedor',AMS.ven,AOPT.ven);
  addF('División',AMS.div,AOPT.div);
  addF('Suplidor',AMS.suplidor,AOPT.suplidor); addF('Categoría',AMS.categoria,AOPT.categoria);
  addF('Producto',AMS.producto,AOPT.producto); addF('Grupo',AMS.grupo,AOPT.grupo); addF('Canal',AMS.canal,AOPT.canal);
  if(ADRILL.sup) fl.push('<b>Drill:</b> '+ADRILL.supNom+(ADRILL.cat?' › '+ADRILL.catNom:''));
  const baseTxt={ruta:'RutaVisitas (Totales)',rvfh_gen:'RutaVisitasFecha (General)',rvfh_acum:'RutaVisitasFecha (Acumulado)'}[j.baseCmp]||'';
  $('#a-print-head').innerHTML='<div><b>'+EMP+' — Activaciones</b> (clientes distintos que compraron)</div>'+
    '<div><b>Período:</b> '+j.desde+' al '+j.hasta+' &nbsp;·&nbsp; <b>Fuente:</b> '+(j.fuente==='pedidos'?'Pedidos':'Ventas')+
    ' &nbsp;·&nbsp; <b>Esquema:</b> '+({general:'General',mes:'Mensual',semana:'Semanal',dia:'Diario'}[j.grano])+
    ' &nbsp;·&nbsp; <b>Reporte:</b> '+(esRep?'Por Representante':'Por '+dimNom)+
    (baseTxt?' &nbsp;·&nbsp; <b>Comparado vs:</b> '+baseTxt:'')+'</div>'+
    (fl.length?'<div>'+fl.join(' &nbsp;|&nbsp; ')+'</div>':'<div><i>Sin filtros (todo)</i></div>')+
    '<div style="color:var(--muted)">Generado: '+new Date().toLocaleString('es-DO')+'</div>';
  // ── tarjetas
  const dYoY=T.totalPrev?100*(T.total-T.totalPrev)/T.totalPrev:null;
  const totPer=per.map(p=>T.valores[p.k]||0);
  const mejorIdx=totPer.length?totPer.indexOf(Math.max(...totPer)):-1;
  const prom=totPer.length?totPer.reduce((a,b)=>a+b,0)/totPer.length:0;
  const nVend=filas.filter(f=>f.nivel===(esRep?'rep':'item')).length;
  $('#a-cards').innerHTML=
    card('Activaciones del rango',fmtN(T.total),'var(--good)','clientes distintos'+(dYoY!=null?' · vs año ant. '+(dYoY>=0?'▲ ':'▼ ')+Math.abs(dYoY).toFixed(1)+'%':''))+
    card(esRep?'Vendedores':dimNom+'s',fmtN(nVend),'var(--accent2)','con activaciones')+
    (mejorIdx>=0?card('Mejor '+({mes:'mes',semana:'semana',dia:'día'}[j.grano]||'periodo'),fmtN(totPer[mejorIdx]),'var(--warn)',per[mejorIdx].label):'')+
    (per.length?card('Promedio por periodo',fmtN(prom),'var(--muted)',per.length+' periodos'):'')+
    (conBase&&T.asignados?card('Cobertura',Math.round(100*T.total/T.asignados)+'%',(100*T.total/T.asignados)>=70?'var(--good)':'var(--warn)',fmtN(T.total)+' / '+fmtN(T.asignados)+' asignados'):'');
  // ── barra de vista (solo modo representante) + breadcrumb del drill (modo producto)
  $('#a-vista').innerHTML = esRep
    ? '<button class="btn-modo'+(AVISTA==='resumido'?' on':'')+'" onclick="setVistaA(\'resumido\')">Resumido</button>'+
      '<button class="btn-modo'+(AVISTA==='detallado'?' on':'')+'" onclick="setVistaA(\'detallado\')">Detallado</button>'
    : '';
  if(!esRep){
    let cr='<span class="crumb'+(ADRILL.sup?'':' cur')+'" onclick="drillReset(0)">'+({suplidor:'Suplidores',categoria:'Categorías',grupo:'Grupos',producto:'Productos'}[$('#a-dim').value])+'</span>';
    if(ADRILL.sup) cr+=' › <span class="crumb'+(ADRILL.cat?'':' cur')+'" onclick="drillReset(1)">'+ADRILL.supNom+'</span>';
    if(ADRILL.cat) cr+=' › <span class="crumb cur">'+ADRILL.catNom+'</span>';
    if(j.dimProd!=='producto') cr+=' <span class="mini">· clic en una fila para bajar de nivel ⤵</span>';
    $('#a-crumbs').innerHTML=cr;
  } else $('#a-crumbs').innerHTML='';
  // ── matriz
  if(!filas.length){ $('#a-tabla').innerHTML='<div class="hint">Sin datos para el rango y filtros seleccionados.</div>'; return; }
  const colBase=conBase?'<th class="per" title="'+(esRep?'Clientes asignados en ruta de este nivel':'Total de clientes asignados: denominador del % de cobertura')+'">'+(esRep?'Asignados':'Total clientes')+'</th>':'';
  let h='<table class="mtx"><thead><tr><th class="l">'+(esRep?'Centro / Supervisor / Vendedor':dimNom)+'</th>'+colBase;
  per.forEach(p=>h+='<th class="per">'+p.label+'</th>');
  h+='<th class="per tot">Total</th></tr></thead><tbody>';

  const fila=(etiqueta,f,cls,indent,click)=>{
    const cl=[cls||'',click?'clickable':''].filter(Boolean).join(' ');
    let r='<tr'+(cl?' class="'+cl+'"':'')+(click?' onclick="'+click+'"':'')+'>';
    r+='<td class="l" style="padding-left:'+(9+indent*18)+'px">'+etiqueta+'</td>';
    if(conBase) r+='<td class="per">'+(f.asignados?fmtN(f.asignados):'—')+'</td>';
    let prev=null;
    per.forEach(p=>{ const n=f.valores[p.k]||0; r+='<td class="per">'+celda(n,conBase?f.asignados:0,prev)+'</td>'; prev=n; });
    r+='<td class="per tot">'+celda(f.total,conBase?f.asignados:0,null)+flecha(f.total,f.totalPrev||null)+'</td></tr>';
    return r;
  };

  if(esRep){
    const centros=filas.filter(f=>f.nivel==='centro');
    centros.forEach(c=>{
      h+=fila('🏢 <b>'+(c.id?c.id+' - ':'')+c.nombre+'</b>',c,'totals',0,null);
      filas.filter(f=>f.nivel==='sup'&&f.ced===c.ced).forEach(s=>{
        h+=fila('<b>'+(s.id?s.id+' - ':'')+(s.nombre||'—')+'</b>',s,'row-sup',1,null);
        if(AVISTA==='detallado')
          filas.filter(f=>f.nivel==='rep'&&f.ced===c.ced&&f.sup===s.sup).forEach(v=>{
            h+=fila(v.id+' - '+v.nombre,v,'',2,null);
          });
      });
    });
  } else {
    const puedeDrill=j.dimProd==='suplidor'||j.dimProd==='categoria';
    filas.filter(f=>f.nivel==='item').forEach(f=>{
      const et=(puedeDrill?'<span class="mini">⤵</span> ':'')+f.id+' - '+f.nombre;
      h+=fila(et,f,'',0,puedeDrill?('drillA(\''+f.id+'\',\''+String(f.nombre).replace(/'/g,"")+'\')'):null);
    });
  }
  // fila total general
  h+='<tr class="totals"><td class="l">TOTAL GENERAL <span class="mini">(clientes distintos, no la suma)</span></td>';
  if(conBase) h+='<td class="per">'+(T.asignados?fmtN(T.asignados):'—')+'</td>';
  let pv=null;
  per.forEach(p=>{ const n=T.valores[p.k]||0; h+='<td class="per">'+celda(n,conBase?T.asignados:0,pv)+'</td>'; pv=n; });
  h+='<td class="per tot">'+celda(T.total,conBase?T.asignados:0,null)+flecha(T.total,T.totalPrev||null)+'</td></tr>';
  h+='</tbody></table>';
  $('#a-tabla').innerHTML=h;
}
// Gráficos de Activaciones — métrica es COUNT(DISTINCT clientes), no Monto (correcto,
// así es este reporte). Top-level: Centro en modo=rep, Ítem (Suplidor/Categoría/etc. según
// #a-dim) en modo=prod. Todo desde ADATA ya en memoria (.total y .valores{periodo} ya
// vienen resueltos por el backend, sin sumar nada client-side).
function aRenderGraficos(){
  if(!ADATA||!(ADATA.filas||[]).length) return;
  const esRep=ADATA.modo==='rep';
  const filas=esRep?ADATA.filas.filter(f=>f.nivel==='centro'):ADATA.filas.filter(f=>f.nivel==='item');
  const lblFn=f=>(f.id?f.id+' - ':'')+(f.nombre||'');
  const top=topNConOtros(filas,10,f=>f.total,lblFn);
  const tituloA='Activaciones por '+(esRep?'Centro':'Ítem');
  graficoPastel($('#a-graf-pastel'),top.map(t=>t.lbl),top.map(t=>t.val),tituloA);
  graficoBarra($('#a-graf-barra'),top.map(t=>t.lbl),top.map(t=>t.val),'Activaciones (clientes distintos)',tituloA);
  const per=ADATA.periodos||[];
  const topLinea=topNConOtros(filas,5,f=>f.total,lblFn).filter(t=>t.lbl!=='Otros');
  const series=topLinea.map(t=>{
    const fila=filas.find(f=>lblFn(f)===t.lbl);
    return {label:t.lbl, data:per.map(p=>(fila&&fila.valores[p.k])||0)};
  });
  graficoLinea($('#a-graf-linea'),per.map(p=>p.label),series,'Tendencia de Activaciones');
}
/* ══════════ COMPARATIVOS ══════════ */
let CMS={}, CDATA=null;
(function(){ const d=new Date(); const f=dateF;
  const lun=new Date(d); lun.setDate(d.getDate()-((d.getDay()+6)%7)); // lunes de esta semana
  $('#c-ini').value=f(lun); $('#c-fin').value=f(d); })();
function cdepend(){
  const cen=new Set(CMS.centro.values());
  const rc=cen.size?REPS.filter(r=>cen.has(r.CedCodigo)):REPS;
  CMS.sup.setOptions([...new Map(rc.filter(r=>r.SupervisorCod).map(r=>[r.SupervisorCod,r.SupervisorNombre])).entries()].map(([v,t])=>({v,t})));
  const sup=new Set(CMS.sup.values());
  const rs=sup.size?rc.filter(r=>sup.has(r.SupervisorCod)):rc;
  CMS.ven.setOptions(rs.map(r=>({v:r.RepCodigo,t:r.RepCodigo+' - '+r.Nombre})));
}
function cModo(){ const modo=$('#c-modo').value, r=modo==='rangos', maestra=modo==='maestra';
  $('#c-nper-wrap').classList.toggle('hide',r||maestra);
  $('#c-b-wrap').style.display=r?'':'none'; $('#c-b2-wrap').style.display=r?'':'none';
  if(r&&!$('#c-ini2').value){ const a=new Date($('#c-ini').value),b=new Date($('#c-fin').value); a.setDate(a.getDate()-7); b.setDate(b.getDate()-7); const f=dateF; $('#c-ini2').value=f(a); $('#c-fin2').value=f(b); }
  // "Vs Maestra Clientes" (2026-09-12, pedido explícito del usuario): "clientes asignados"
  // es un concepto de RutaVisitas ligado al vendedor — sin análogo natural por
  // Suplidor/Canal/Cliente, así que este modo se restringe a Supervisor → Vendedor.
  const dimSel=$('#c-dim');
  if(maestra){ dimSel.value='supervisor'; dimSel.disabled=true; } else { dimSel.disabled=false; }
  const vistaSel=$('#c-vista');
  const tieneClientes=[...vistaSel.options].some(o=>o.value==='clientes');
  if(maestra&&!tieneClientes){ const op=document.createElement('option'); op.value='clientes'; op.textContent='Detallado/Clientes'; vistaSel.appendChild(op); }
  else if(!maestra&&tieneClientes){ if(vistaSel.value==='clientes')vistaSel.value='detallado'; [...vistaSel.options].find(o=>o.value==='clientes').remove(); }
  cVista();
}
function cqs(){ const p=new URLSearchParams();
  p.set('fechaIni',$('#c-ini').value); p.set('fechaFin',$('#c-fin').value);
  p.set('modo',$('#c-modo').value); p.set('nPeriodos',$('#c-nper').value);
  p.set('fuente',$('#c-fuente').value); p.set('dim',$('#c-dim').value); p.set('vista',$('#c-vista').value);
  if($('#c-modo').value==='rangos'){ p.set('fechaIni2',$('#c-ini2').value); p.set('fechaFin2',$('#c-fin2').value); }
  const put=(k,ms)=>{ if(ms&&ms.values().length)p.set(k,ms.values().join(',')); };
  put('centros',CMS.centro); put('supervisores',CMS.sup); put('vendedores',CMS.ven); put('divisiones',CMS.div);
  put('suplidores',CMS.suplidor); put('categorias',CMS.categoria); put('productos',CMS.producto); put('grupos',CMS.grupo); put('canales',CMS.canal);
  put('gruposCliente',CMS.grupoCliente);
  return p;
}
function cVista(){ const dr=($('#c-dim').value==='supervisor'||$('#c-dim').value==='suplidor'); $('#c-vista-wrap').style.display=dr?'':'none'; }
function generarComp(){
  overlay(true);
  const maestra=$('#c-modo').value==='maestra';
  const url=BASE+(maestra?'/apihist/comparativo-maestra?':'/apihist/comparativo?')+cqs().toString();
  fetch(url).then(r=>r.json()).then(j=>{
    overlay(false); if(!j||!j.ok){ alert('Error: '+(j&&j.error||'?')); return; }
    CDATA=j; if(maestra) renderCompMaestra(j); else renderComp(j);
  }).catch(e=>{overlay(false);alert('Error de conexión: '+e);});
}
function pctChip(p){ if(p==null)return '<span class="chip eq">n/d</span>';
  const c=p>0?'up':(p<0?'dn':'eq'); const s=p>0?'▲':(p<0?'▼':'='); return '<span class="chip '+c+'">'+s+' '+Math.abs(p).toFixed(1)+'%</span>'; }
function renderComp(j){
  const c=j.cards, esRep=j.dim==='supervisor', esSup=j.dim==='suplidor';
  const dimNom=esRep?'Supervisor / Vendedor':(esSup?'Suplidor / Categoría':(j.dim==='canal'?'Canal':'Cliente'));
  // cabecera imprimible
  const fl=[]; const addF=(l,ms,arr)=>{const n=nomsDe(ms,arr); if(n.length)fl.push('<b>'+l+':</b> '+n.join(', '));};
  addF('Centro',CMS.centro,AOPT.centro); addF('Supervisor',CMS.sup,AOPT.sup); addF('Vendedor',CMS.ven,AOPT.ven); addF('División',CMS.div,AOPT.div);
  addF('Suplidor',CMS.suplidor,AOPT.suplidor); addF('Categoría',CMS.categoria,AOPT.categoria); addF('Producto',CMS.producto,AOPT.producto); addF('Grupo',CMS.grupo,AOPT.grupo); addF('Canal',CMS.canal,AOPT.canal);
  $('#c-print-head').innerHTML='<div id="a-print-head" style="display:block"><div><b>'+EMP+' — Comparativo de '+(j.fuente==='pedidos'?'Pedidos':'Ventas')+'</b> (ValorBruto y facturas distintas)</div>'+
    '<div><b>Rango:</b> '+j.rangoA.ini+' al '+j.rangoA.fin+' &nbsp;·&nbsp; <b>vs:</b> '+(j.modo==='rangos'?j.comparacion[0]:('promedio de '+j.nComp+' periodos: '+j.comparacion.join(' · ')))+' &nbsp;·&nbsp; <b>Análisis por:</b> '+dimNom+'</div>'+
    (fl.length?'<div>'+fl.join(' &nbsp;|&nbsp; ')+'</div>':'<div><i>Sin filtros</i></div>')+'<div style="color:var(--muted)">Generado: '+new Date().toLocaleString('es-DO')+'</div></div>';
  // tarjetas (5+)
  const cardC=(l,val,pc,extra)=>'<div class="card"><div class="cl">'+l+'</div><div class="cv">'+val+' '+pctChip(pc)+'</div><div class="ch">'+(extra||'')+'</div></div>';
  let h='';
  h+=cardC('Monto Total (ValorBruto)',fmtRD(c.monto.main),c.monto.pct,'vs comparación '+fmtRD(c.monto.comp));
  h+=cardC((j.fuente==='pedidos'?'Pedidos':'Facturas')+' distintas',fmtN(c.facturas.main),c.facturas.pct,'vs comparación '+fmtN(c.facturas.comp));
  if(c.suplidorMayor) h+=cardC('Suplidor ▲ mayor',c.suplidorMayor.nombre,c.suplidorMayor.pct,fmtRD(c.suplidorMayor.main));
  if(c.suplidorMenor) h+=cardC('Suplidor ▼ menor',c.suplidorMenor.nombre,c.suplidorMenor.pct,fmtRD(c.suplidorMenor.main));
  if(c.supervisorMayor) h+=cardC('Supervisor ▲ mayor',c.supervisorMayor.nombre,c.supervisorMayor.pct,fmtRD(c.supervisorMayor.main));
  if(c.supervisorMenor) h+=cardC('Supervisor ▼ menor',c.supervisorMenor.nombre,c.supervisorMenor.pct,fmtRD(c.supervisorMenor.main));
  $('#c-cards').innerHTML=h;
  // incidencias
  const inci=j.incidencias||[];
  $('#c-incidencias').innerHTML = inci.length
    ? '<div class="cmp-inci"><div class="t">⚠ Incidencias que pudieron afectar</div><ul>'+inci.map(x=>'<li>'+x.txt+'</li>').join('')+'</ul></div>' : '';
  // tabla
  const filas=j.filas||[];
  if(!filas.length){ $('#c-tabla').innerHTML='<div class="hint">Sin datos para el rango y filtros.</div>'; return; }
  const uds=j.fuente==='pedidos'?'Pedidos':'Facturas';
  let t='<table class="mtx"><thead><tr><th class="l">'+dimNom+'</th>'+
    '<th class="per">Monto rango</th><th class="per">Monto comp.</th><th class="per">Δ%</th>'+
    '<th class="per">'+uds+' rango</th><th class="per">'+uds+' comp.</th><th class="per">Δ%</th></tr></thead><tbody>';
  const filaC=(f,indent,cls)=>{
    return '<tr'+(cls?' class="'+cls+'"':'')+'><td class="l" style="padding-left:'+(9+indent*18)+'px">'+
      (f.id?f.id+' - ':'')+f.nombre+'</td>'+
      '<td class="per">'+fmtRD(f.montoMain)+'</td><td class="per">'+fmtRD(f.montoComp)+'</td><td class="per">'+pctChip(f.pctMonto)+'</td>'+
      '<td class="per">'+fmtN(f.facMain)+'</td><td class="per">'+fmtN(f.facComp)+'</td><td class="per">'+pctChip(f.pctFac)+'</td></tr>';
  };
  if(esRep||esSup){
    const resumido=$('#c-vista').value==='resumido';
    const padres=filas.filter(f=>f.nivel==='sup').sort((a,b)=>b.montoMain-a.montoMain);
    const hijos=filas.filter(f=>f.nivel==='rep'||f.nivel==='cat');
    padres.forEach(p=>{ t+=filaC(p,0,'totals');
      if(!resumido) hijos.filter(x=>x.padreId===p.id).sort((a,b)=>b.montoMain-a.montoMain).forEach(x=>{ t+=filaC(x,1,''); });
    });
  } else {
    const leaf=j.dim==='canal'?'can':'cli';
    filas.filter(f=>f.nivel===leaf).slice(0,300).forEach(f=>{ t+=filaC(f,0,''); });
  }
  t+='</tbody></table>';
  $('#c-tabla').innerHTML=t;
}
// Gráficos de Comparativos — Pastel/Barra del período PRINCIPAL (montoMain) por
// dimensión, al nivel superior de la jerarquía actual (sup/can/cli según #c-dim). Sin
// Línea (este reporte compara 2 períodos puntuales, no trae una serie de tiempo).
function cRenderGraficos(){
  if(!CDATA||!(CDATA.filas||[]).length) return;
  const esRep=CDATA.dim==='supervisor', esSup=CDATA.dim==='suplidor';
  const nivelTop=(esRep||esSup)?'sup':(CDATA.dim==='canal'?'can':'cli');
  const filas=CDATA.filas.filter(f=>f.nivel===nivelTop);
  const top=topNConOtros(filas,10,f=>f.montoMain,f=>(f.id?f.id+' - ':'')+f.nombre);
  const dimLbl=esRep?'Supervisor':esSup?'Suplidor':CDATA.dim==='canal'?'Canal':'Cliente';
  graficoPastel($('#c-graf-pastel'),top.map(t=>t.lbl),top.map(t=>t.val),'Peso de Ventas por '+dimLbl);
  graficoBarra($('#c-graf-barra'),top.map(t=>t.lbl),top.map(t=>t.val),'Monto rango','Monto por '+dimLbl);
}
// "Vs Maestra Clientes" (2026-09-12) — no compara contra otro periodo, compara contra
// el universo de clientes ASIGNADOS (RutaVisitas); columnas: Clientes Asignados,
// Clientes en el rango (activados), Δ% (activación), Monto. Restringido a
// Supervisor→Vendedor (ver cModo()) — mismo padres/hijos que ya usa renderComp() para
// dim=supervisor, no se toca esa función para no arriesgar los 2 modos existentes.
function renderCompMaestra(j){
  const c=j.cards;
  $('#c-print-head').innerHTML='<div id="a-print-head" style="display:block"><div><b>'+EMP+' — Comparativo de '+(j.fuente==='pedidos'?'Pedidos':'Ventas')+' vs Maestra Clientes</b></div>'+
    '<div><b>Rango:</b> '+j.rango.ini+' al '+j.rango.fin+' &nbsp;·&nbsp; <b>Base:</b> clientes asignados (RutaVisitas)</div>'+
    '<div style="color:var(--muted)">Generado: '+new Date().toLocaleString('es-DO')+'</div></div>';
  const cardC=(l,val,pc,extra)=>'<div class="card"><div class="cl">'+l+'</div><div class="cv">'+val+(pc!=null?' '+pctChip(pc):'')+'</div><div class="ch">'+(extra||'')+'</div></div>';
  $('#c-cards').innerHTML=
    cardC('Clientes Asignados',fmtN(c.asignados),null,'') +
    cardC('Clientes activados en el rango',fmtN(c.activados),c.pct,c.pct!=null?c.pct.toFixed(1)+'% del total asignado':'') +
    cardC('Monto Total (ValorBruto)',fmtRD(c.monto),null,'');
  $('#c-incidencias').innerHTML='';
  const filas=j.filas||[];
  if(!filas.length){ $('#c-tabla').innerHTML='<div class="hint">Sin datos para el rango y filtros.</div>'; return; }
  const vista=$('#c-vista').value, resumido=vista==='resumido', clientes=vista==='clientes';
  let t='<table class="mtx"><thead><tr><th class="l">Supervisor / Vendedor</th>'+
    '<th class="per">Clientes Asignados</th><th class="per">Clientes en el rango</th><th class="per">Δ% Activación</th><th class="per">Monto rango</th>'+
    (clientes?'<th class="per">Día de visita</th>':'')+'</tr></thead><tbody>';
  const filaM=(f,indent,cls)=>'<tr'+(cls?' class="'+cls+'"':'')+'><td class="l" style="padding-left:'+(9+indent*18)+'px">'+f.nombre+'</td>'+
    '<td class="per">'+fmtN(f.clientesAsignados)+'</td><td class="per">'+fmtN(f.clientesActivados)+'</td>'+
    '<td class="per">'+pctChip(f.pctActivacion)+'</td><td class="per">'+fmtRD(f.montoTotal)+'</td>'+(clientes?'<td class="per"></td>':'')+'</tr>';
  const filaCli=(f)=>'<tr><td class="l" style="padding-left:'+(9+36)+'px">'+f.cliCodigo+' — '+f.cliNombre+'</td>'+
    '<td class="per">—</td><td class="per">'+(f.activado?'Sí':'No')+'</td>'+
    '<td class="per"></td><td class="per">'+fmtRD(f.monto)+'</td><td class="per">'+f.diaVisita+'</td></tr>';
  const padres=filas.filter(f=>f.nivel==='sup').sort((a,b)=>b.montoTotal-a.montoTotal);
  const hijos=filas.filter(f=>f.nivel==='rep');
  const cliDet=filas.filter(f=>f.nivel==='cliDetalle');
  padres.forEach(p=>{ t+=filaM(p,0,'totals');
    if(!resumido) hijos.filter(x=>x.padreId===p.id).sort((a,b)=>b.montoTotal-a.montoTotal).forEach(x=>{
      t+=filaM(x,1,'');
      if(clientes) cliDet.filter(cd=>cd.padreId===x.id).sort((a,b)=>b.monto-a.monto).forEach(cd=>{ t+=filaCli(cd); });
    });
  });
  t+='</tbody></table>';
  $('#c-tabla').innerHTML=t;
}
function qs(){ const p=new URLSearchParams();
  if(MS.centro.values().length)p.set('centros',MS.centro.values().join(','));
  if(MS.sup.values().length)p.set('supervisores',MS.sup.values().join(','));
  if(MS.ven.values().length)p.set('reps',MS.ven.values().join(','));
  if(MS.div.values().length)p.set('divisiones',MS.div.values().join(','));
  if(MS.canal&&MS.canal.values().length)p.set('canal',MS.canal.values().join(','));
  if(MS.suplidor&&MS.suplidor.values().length)p.set('suplidor',MS.suplidor.values().join(','));
  if(MS.categoria&&MS.categoria.values().length)p.set('categoria',MS.categoria.values().join(','));
  if(MS.producto&&MS.producto.values().length)p.set('producto',MS.producto.values().join(','));
  if(MS.grupoCliente&&MS.grupoCliente.values().length)p.set('gruposCliente',MS.grupoCliente.values().join(','));
  return p; }

/* ── Generar ── */
$('#btn-go').onclick=generar;
function generar(){
  if(V_MODO==='mensual'){ generarVentasMensual(); return; }
  overlay(true);
  const p=qs(); p.set('fechaIni',$('#f-ini').value); p.set('fechaFin',$('#f-fin').value);
  fetch(BASE+'/apihist/ventas?'+p.toString()).then(r=>r.json()).then(j=>{
    overlay(false);
    if(!j||!j.ok){ alert('Error: '+(j&&j.error||'?')); return; }
    DATA=j.filas||[]; RANGO=j.rango; PREVIO=j.previo; nav={nivel:'centro',ced:null,sup:null};
    render();
    cargarTarjetas();
    $('#v-print-head').innerHTML='<div id="a-print-head" style="display:block"><div><b>'+EMP+' — Históricos de Ventas (Sup./Vend.)</b></div>'+
      '<div><b>Rango:</b> '+RANGO.ini+' al '+RANGO.fin+(PREVIO?' &nbsp;·&nbsp; <b>vs previo:</b> '+PREVIO.ini+' al '+PREVIO.fin:'')+'</div>'+
      '<div style="color:var(--muted)">Generado: '+new Date().toLocaleString('es-DO')+'</div></div>';
  }).catch(e=>{overlay(false);alert('Error de conexión: '+e);});
}
/* ── Histórico Mes a Mes (pedido explícito 2026-09-28) — solo meses YA CERRADOS, sin
   límite de años hacia atrás. VMDATA es 1 fila plana por (Año,Mes,Vendedor) — el
   esquema elegido (Compañía/Centro/Supervisor/Vendedor) se agrega 100% client-side a
   partir de esa única respuesta, sin volver a pedirle nada al backend por cambiar el
   selector "Esquema". */
let V_MODO='rango', VMDATA=null, VMMESES=[];
function vSetModo(modo){
  V_MODO=modo;
  $('#v-modo-rango').classList.toggle('on',modo==='rango');
  $('#v-modo-mensual').classList.toggle('on',modo==='mensual');
  $('#v-esquema-wrap').style.display=modo==='mensual'?'':'none';
  $('#v-vista-rango').classList.toggle('hide',modo!=='rango');
  $('#v-vista-mensual').classList.toggle('hide',modo!=='mensual');
  // Cambiar de sub-modo NO consulta nada (2026-10-06, pedido del usuario): solo se genera al presionar «Generar».
  if(modo==='mensual') vmRender();
  if(!$('#v-vista-graf').classList.contains('on')) return;
  histToggleVista('v','graf',vRenderGraficos);
}
let VM_RANGO='';
function generarVentasMensual(){
  overlay(true);
  const p=qs(); p.set('fechaIni',$('#f-ini').value); p.set('fechaFin',$('#f-fin').value);
  const rango=$('#f-ini').value+' al '+$('#f-fin').value;
  fetch(BASE+'/apihist/ventas-mensual?'+p.toString()).then(r=>r.json()).then(j=>{
    overlay(false);
    if(!j||!j.ok){ alert('Error: '+(j&&j.error||'?')); return; }
    VMDATA=j.filas||[]; VMMESES=j.meses||[]; VM_RANGO=rango;
    vmRender();
  }).catch(e=>{overlay(false);alert('Error de conexión: '+e);});
}
// Agrupa VMDATA al esquema elegido: 'compania' = 1 sola fila con todo; 'centro'/
// 'supervisor'/'vendedor' usan Centro/CedCodigo/SupCod/Supervisor/Nombre que el backend
// YA resuelve por fila (mismo patrón que la vista Rango, /apihist/ventas) — no hace
// falta ningún catálogo de reps aparte en el frontend.
function vmAgrupar(esquema){
  const mapa=new Map();
  VMDATA.forEach(r=>{
    let key,lbl;
    if(esquema==='compania'){ key='TOTAL'; lbl='Total Compañía'; }
    else if(esquema==='centro'){ key=r.CedCodigo||''; lbl=r.Centro||'(Sin centro)'; }
    else if(esquema==='supervisor'){ key=r.SupCod||''; lbl=r.Supervisor||r.SupCod||'(Sin supervisor)'; }
    else { key=r.RepVendedor; lbl=(r.Nombre||r.RepVendedor)+' ('+r.RepVendedor+')'; }
    const mk=key+'|'+r.Anio+'-'+r.Mes;
    if(!mapa.has(mk)) mapa.set(mk,{key,lbl,anio:r.Anio,mes:r.Mes,Monto:0,Uni:0,Caj:0});
    const c=mapa.get(mk); c.Monto+=r.Monto; c.Uni+=r.Uni; c.Caj+=r.Caj;
  });
  const porFila=new Map();
  mapa.forEach(c=>{
    if(!porFila.has(c.key)) porFila.set(c.key,{key:c.key,lbl:c.lbl,porMes:new Map()});
    porFila.get(c.key).porMes.set(c.anio+'-'+c.mes,{Monto:c.Monto,Uni:c.Uni,Caj:c.Caj});
  });
  return [...porFila.values()].sort((a,b)=>a.lbl<b.lbl?-1:a.lbl>b.lbl?1:0);
}
function vmRender(){
  if(!VMDATA){ $('#tabla-mensual').innerHTML='<div class="hint">Elige el rango y presiona <b>Generar</b>.</div>'; return; }
  if(!VMDATA.length){ $('#tabla-mensual').innerHTML='<div class="hint">Sin meses cerrados para el rango ('+VM_RANGO+') y los filtros. Mes a Mes muestra solo meses completos ya cerrados (del mes de «Desde» al mes de «Hasta»); el mes en curso no se incluye.</div>'; return; }
  $('#tabla-mensual').dataset.rango=VM_RANGO;
  const esquema=$('#v-esquema').value;
  const filas=vmAgrupar(esquema);
  // Bandas de año: agrupa VMMESES (ya ordenado Año,Mes por el backend) consecutivos del
  // mismo año — cada banda es un <th colspan> arriba de sus meses individuales.
  const bandas=[]; VMMESES.forEach(m=>{ const last=bandas[bandas.length-1]; if(last&&last.anio===m.Anio) last.meses.push(m.Mes); else bandas.push({anio:m.Anio,meses:[m.Mes]}); });
  let h='<table><thead><tr><th class="l" rowspan="2">'+({compania:'Compañía',centro:'Centro',supervisor:'Supervisor',vendedor:'Vendedor'}[esquema])+'</th>';
  bandas.forEach(b=>{ h+='<th colspan="'+b.meses.length+'">'+b.anio+'</th>'; });
  h+='<th rowspan="2">Total</th></tr><tr>';
  bandas.forEach(b=>{ b.meses.forEach(m=>{ h+='<th>'+MESNOM[m]+'</th>'; }); });
  h+='</tr></thead><tbody>';
  const totAnio={}; // anio -> {Monto}
  const totGeneral={Monto:0};
  filas.forEach(f=>{
    h+='<tr><td class="l">'+f.lbl+'</td>';
    let prev=null, totFila=0;
    bandas.forEach(b=>{
      b.meses.forEach(m=>{
        const k=b.anio+'-'+m; const c=f.porMes.get(k);
        if(!c){ h+='<td class="per">—</td>'; prev=null; return; }
        h+='<td class="per">'+scCelda(c.Monto,prev,fmtRD)+'</td>';
        prev=c.Monto; totFila+=c.Monto;
        totAnio[b.anio]=(totAnio[b.anio]||0)+c.Monto;
      });
    });
    h+='<td><b>'+fmtRD(totFila)+'</b></td></tr>';
    totGeneral.Monto+=totFila;
  });
  // Subtotal por año (1 fila, suma de TODAS las filas del esquema para ese año — no solo
  // la última) + fila TOTAL GENERAL al final, mismo criterio que renderSupCat/pdRender*.
  h+='<tr class="totals"><td class="l">Subtotal por año</td>';
  bandas.forEach(b=>{ h+='<th colspan="'+b.meses.length+'" style="text-align:right;font-weight:700">'+fmtRD(totAnio[b.anio]||0)+'</th>'; });
  h+='<td></td></tr>';
  h+='<tr class="totals"><td class="l">TOTAL GENERAL</td><td colspan="'+(VMMESES.length)+'"></td><td>'+fmtRD(totGeneral.Monto)+'</td></tr>';
  h+='</tbody></table>';
  $('#tabla-mensual').innerHTML=h;
}
// Gráficos de "Ventas (Sup./Vend.)" — respeta el sub-modo activo (Rango o Mes a Mes).
// En Rango no hay serie temporal (1 sola vista, sin eje de tiempo) -> sin Línea. En Mes
// a Mes sí la hay -> Línea con las top 5 filas del esquema elegido a través de los meses.
function vRenderGraficos(){
  if(V_MODO==='mensual'){
    if(!VMDATA||!VMDATA.length) return;
    const esquema=$('#v-esquema').value;
    const filas=vmAgrupar(esquema);
    const totFila=f=>{ let s=0; f.porMes.forEach(v=>s+=v.Monto); return s; };
    const top=topNConOtros(filas,10,totFila,f=>f.lbl);
    const esqLbl=$('#v-esquema').options[$('#v-esquema').selectedIndex].text;
    graficoPastel($('#v-graf-pastel'),top.map(t=>t.lbl),top.map(t=>t.val),'Peso de Ventas por '+esqLbl);
    graficoBarra($('#v-graf-barra'),top.map(t=>t.lbl),top.map(t=>t.val),'Monto','Monto por '+esqLbl);
    const topLinea=topNConOtros(filas,5,totFila,f=>f.lbl).filter(t=>t.lbl!=='Otros');
    const labels=VMMESES.map(m=>MESNOM[m.Mes]+' '+m.Anio);
    const series=topLinea.map(t=>{
      const fila=filas.find(f=>f.lbl===t.lbl);
      return {label:t.lbl, data:VMMESES.map(m=>{ const c=fila&&fila.porMes.get(m.Anio+'-'+m.Mes); return c?c.Monto:0; })};
    });
    $('#v-graf-linea').closest('div').style.display='';
    graficoLinea($('#v-graf-linea'),labels,series,'Tendencia Mensual de Ventas');
  } else {
    if(!DATA||!DATA.length) return;
    const top=topNConOtros(DATA,10,d=>d.Monto,d=>d.Nombre||d.Vendedor);
    graficoPastel($('#v-graf-pastel'),top.map(t=>t.lbl),top.map(t=>t.val),'Peso de Ventas por Vendedor');
    graficoBarra($('#v-graf-barra'),top.map(t=>t.lbl),top.map(t=>t.val),'Monto','Monto por Vendedor');
    $('#v-graf-linea').closest('div').style.display='none'; // Rango = 1 sola vista, sin eje de tiempo
  }
}
function pdfVentas(){
  if(!DATA.length){ alert('Genera el informe primero.'); return; }
  histExportarPDF({
    bandNode:$('#v-print-head'), blockNodes:[$('#cards'),$('#tabla')],
    filename:'historico_ventas_'+(RANGO?RANGO.ini:'')+'.pdf',
    footerTxt:EMP+' — Históricos de Ventas (Sup./Vend.)', botonIds:['v-btn-pdf'],
  });
}
/* tarjetas async (YTD, mes actual/anterior, proyección) */
function cargarTarjetas(){
  $('#cards').innerHTML='<div class="card"><div class="cl">Analizando el año…</div><div class="cv"><span class="spin" style="width:18px;height:18px;border-width:2px"></span></div></div>';
  fetch(BASE+'/apihist/ventas-tarjetas?'+qs().toString()).then(r=>r.json()).then(j=>{
    if(!j||!j.ok){ $('#cards').innerHTML=''; return; }
    const s=j.serie||[]; const ma=j.mesActual;
    const ytd=s.reduce((a,b)=>a+b.monto,0);
    const mAct=j.mtd||((s[ma-1]||{}).monto||0), mAnt=(s[ma-2]||{}).monto||0;
    const dv=mAnt!=0?(100*(mAct-mAnt)/mAnt):null;
    const dvTxt=dv==null?'—':(dv>=0?'▲ ':'▼ ')+Math.abs(dv).toFixed(1)+'%';
    const ord=DATA.slice().sort((a,b)=>b.Monto-a.Monto);
    const top=ord[0], bot=ord[ord.length-1];
    $('#cards').innerHTML=
      card('Venta YTD '+j.anio,fmtRD(ytd),'var(--good)',fmtN(s.reduce((a,b)=>a+b.uni,0))+' und · '+fmtDec(s.reduce((a,b)=>a+b.caj,0))+' cajas')+
      card('Mes actual',fmtRD(mAct),dv>=0?'var(--good)':'var(--bad)','vs mes anterior '+dvTxt)+
      card('Proyección del mes',fmtRD(j.proyeccion||0),'var(--accent2)','avance '+j.avance+'% · día háb. '+j.diaHabil+'/'+j.diasHabilesMes+' (lun-sáb, curva 6m)')+
      (top?card('Top vendedor',fmtRD(top.Monto),'var(--good)',(top.Nombre||top.Vendedor)):'')+
      (bot&&ord.length>1?card('Menor vendedor',fmtRD(bot.Monto),'var(--warn)',(bot.Nombre||bot.Vendedor)):'');
  }).catch(()=>{ $('#cards').innerHTML=''; });
}
function card(l,v,col,h){ return '<div class="card"><div class="cl">'+l+'</div><div class="cv" style="color:'+(col||'var(--text)')+'">'+v+'</div><div class="ch">'+(h||'')+'</div></div>'; }

/* ── Drill Centro→Supervisor→Vendedor ── */
function scope(){ let d=DATA; if(nav.ced)d=d.filter(v=>v.CedCodigo===nav.ced); if(nav.sup)d=d.filter(v=>v.SupCod===nav.sup); return d; }
function agg(list,keyFn,nameFn,parentFn){
  const g={}; list.forEach(v=>{const k=keyFn(v);(g[k]=g[k]||{k,nombre:nameFn(v),padre:parentFn?parentFn(v):'',Uni:0,Caj:0,Monto:0,Cli:0,Fac:0,Prev:0}).__=1;
    g[k].Uni+=v.Uni;g[k].Caj+=v.Caj;g[k].Monto+=v.Monto;g[k].Cli+=v.Cli;g[k].Fac+=v.Fac;g[k].Prev+=v.MontoPrev;});
  return Object.values(g).map(o=>{o.Ticket=o.Fac?o.Monto/o.Fac:0;o.Delta=o.Prev!=0?100*(o.Monto-o.Prev)/o.Prev:null;return o;}).sort((a,b)=>b.Monto-a.Monto);
}
function render(){
  const list=scope();
  let cr='<span class="crumb '+(nav.ced?'':'cur')+'" onclick="setNivel(\'centro\',null,null)">Compañía</span>';
  if(nav.ced){ const cn=(DATA.find(v=>v.CedCodigo===nav.ced)||{}).Centro||nav.ced; cr+=' › <span class="crumb '+(nav.sup?'':'cur')+'" onclick="setNivel(\'supervisor\',\''+nav.ced+'\',null)">'+cn+'</span>'; }
  if(nav.sup){ const sn=(DATA.find(v=>v.SupCod===nav.sup)||{}).Supervisor||nav.sup; cr+=' › <span class="crumb cur">'+sn+'</span>'; }
  cr+=' <span class="mini">· '+(RANGO?RANGO.ini+' a '+RANGO.fin:'')+' (Δ% vs '+(PREVIO?PREVIO.ini+' a '+PREVIO.fin:'')+')</span>';
  $('#crumbs').innerHTML=cr;
  const nb=(id,t)=>'<button class="btn-modo'+(nav.nivel===id?' on':'')+'" onclick="setNivel(\''+id+'\')">'+t+'</button>';
  $('#nivelbar').innerHTML=nb('centro','Por Centro')+nb('supervisor','Por Supervisor')+nb('vendedor','Por Vendedor');
  if(nav.nivel==='centro') renderAgg(agg(list,v=>v.CedCodigo,v=>v.Centro),'Centro',[]);
  else if(nav.nivel==='supervisor') renderAgg(agg(list,v=>v.SupCod,v=>v.Supervisor,v=>v.Centro),'Supervisor',['Centro']);
  else renderVend(list);
}
function deltaCell(d){ if(d==null)return '<td class="mini">—</td>'; const c=d>=0?'pos':'neg'; return '<td class="'+c+'">'+(d>=0?'▲':'▼')+' '+Math.abs(d).toFixed(1)+'%</td>'; }
function renderAgg(rows,tipo,parents){
  let th=parents.map(p=>'<th class="l">'+p+'</th>').join('');
  let h='<table><thead><tr><th class="l">#</th>'+th+'<th class="l">'+tipo+'</th><th>Unidades</th><th>Cajas</th><th>Monto</th><th>Δ%</th><th>Clientes</th><th>Facturas</th><th>Ticket</th></tr></thead><tbody>';
  let tU=0,tC=0,tM=0,tP=0,tCl=0,tF=0;
  rows.forEach((r,i)=>{ const pc=parents.length?('<td class="l">'+r.padre+'</td>'):'';
    h+='<tr class="clickable" onclick="__drill(\''+r.k+'\',\''+tipo+'\')"><td class="l">'+(i+1)+'</td>'+pc+'<td class="l">'+r.nombre+'</td>'+
      '<td>'+fmtN(r.Uni)+'</td><td>'+fmtDec(r.Caj)+'</td><td>'+fmtRD(r.Monto)+'</td>'+deltaCell(r.Delta)+'<td>'+fmtN(r.Cli)+'</td><td>'+fmtN(r.Fac)+'</td><td>'+fmtRD(r.Ticket)+'</td></tr>';
    tU+=r.Uni;tC+=r.Caj;tM+=r.Monto;tP+=r.Prev;tCl+=r.Cli;tF+=r.Fac; });
  const dT=tP!=0?100*(tM-tP)/tP:null;
  h+='<tr class="totals"><td class="l" colspan="'+(2+parents.length)+'">TOTAL</td><td>'+fmtN(tU)+'</td><td>'+fmtDec(tC)+'</td><td>'+fmtRD(tM)+'</td>'+deltaCell(dT)+'<td>'+fmtN(tCl)+'</td><td>'+fmtN(tF)+'</td><td>'+fmtRD(tF?tM/tF:0)+'</td></tr>';
  h+='</tbody></table>'; $('#tabla').innerHTML=h;
}
function renderVend(list){
  const rows=list.slice().sort((a,b)=>b.Monto-a.Monto);
  let h='<table><thead><tr><th class="l">#</th><th class="l">Centro</th><th class="l">Supervisor</th><th class="l">Vendedor</th><th>Unidades</th><th>Cajas</th><th>Monto</th><th>Δ%</th><th>Clientes</th><th>Facturas</th><th>Ticket</th></tr></thead><tbody>';
  let tU=0,tC=0,tM=0,tP=0,tCl=0,tF=0;
  rows.forEach((v,i)=>{ h+='<tr class="clickable" onclick="vAbrirDrillDia(\''+String(v.Vendedor).replace(/'/g,'')+'\')"><td class="l">'+(i+1)+'</td><td class="l">'+v.Centro+'</td><td class="l">'+v.Supervisor+'</td><td class="l">'+v.Nombre+' <span class="mini">('+v.Vendedor+')</span></td>'+
    '<td>'+fmtN(v.Uni)+'</td><td>'+fmtDec(v.Caj)+'</td><td>'+fmtRD(v.Monto)+'</td>'+deltaCell(v.Delta)+'<td>'+fmtN(v.Cli)+'</td><td>'+fmtN(v.Fac)+'</td><td>'+fmtRD(v.Ticket)+'</td></tr>';
    tU+=v.Uni;tC+=v.Caj;tM+=v.Monto;tP+=v.MontoPrev;tCl+=v.Cli;tF+=v.Fac; });
  const dT=tP!=0?100*(tM-tP)/tP:null;
  h+='<tr class="totals"><td class="l" colspan="4">TOTAL ('+rows.length+' vend.)</td><td>'+fmtN(tU)+'</td><td>'+fmtDec(tC)+'</td><td>'+fmtRD(tM)+'</td>'+deltaCell(dT)+'<td>'+fmtN(tCl)+'</td><td>'+fmtN(tF)+'</td><td>'+fmtRD(tF?tM/tF:0)+'</td></tr>';
  h+='</tbody></table>'; $('#tabla').innerHTML=h;
}
window.__drill=(k,tipo)=>{ if(tipo==='Centro')setNivel('supervisor',k,null); else { const v=DATA.find(x=>x.SupCod===k); setNivel('vendedor',v?v.CedCodigo:nav.ced,k); } };
window.setNivel=(nivel,ced,sup)=>{ nav={nivel:nivel,ced:(ced!==undefined?ced:nav.ced),sup:(sup!==undefined?sup:nav.sup)}; if(nivel==='centro'){nav.ced=null;nav.sup=null;} if(nivel==='supervisor'&&sup===undefined)nav.sup=null; render(); };
/* ── Drill-down Fecha → Cliente en el nivel Vendedor (pedido explícito 2026-09-27):
   antes renderVend() era un callejón sin salida (sin onclick, el drill Centro→Supervisor→
   Vendedor ya establecido en __drill/setNivel no toca este nivel). Clic en un vendedor
   abre su desglose día por día; clic en un día abre el desglose de ESE día por cliente —
   mismas 6 columnas (Unidades/Cajas/Monto/Clientes/Facturas/Ticket), sin Δ% (no aplica a
   un solo día/cliente). Reusa /apihist/ventas con los 2 parámetros nuevos
   vendedorDrill+granularidad — sin endpoint nuevo. */
let V_DRILL=null; // {vendedor, nivel:'dia'|'cliente', fecha}
function vAbrirDrillDia(vendedorCod){ V_DRILL={vendedor:vendedorCod, nivel:'dia', fecha:null}; vCargarDrill(); }
function vAbrirDrillCliente(fecha){ V_DRILL.nivel='cliente'; V_DRILL.fecha=fecha; vCargarDrill(); }
function vVolverDia(){ V_DRILL.nivel='dia'; V_DRILL.fecha=null; vCargarDrill(); }
function vCerrarDrill(){ V_DRILL=null; render(); }
function vCargarDrill(){
  const p=qs();
  p.set('vendedorDrill',V_DRILL.vendedor); p.set('granularidad',V_DRILL.nivel);
  if(V_DRILL.nivel==='cliente'){ p.set('fechaIni',V_DRILL.fecha); p.set('fechaFin',V_DRILL.fecha); }
  else { p.set('fechaIni',$('#f-ini').value); p.set('fechaFin',$('#f-fin').value); }
  overlay(true);
  fetch(BASE+'/apihist/ventas?'+p.toString()).then(r=>r.json()).then(j=>{
    overlay(false);
    if(!j||!j.ok){ alert('Error: '+(j&&j.error||'?')); return; }
    vRenderDrill(j.filas||[]);
  }).catch(e=>{overlay(false);alert('Error de conexión: '+e);});
}
function vRenderDrill(filas){
  const esDia=V_DRILL.nivel==='dia';
  const vInfo=DATA.find(x=>x.Vendedor===V_DRILL.vendedor);
  const nombreVend=vInfo?(vInfo.Nombre+' ('+vInfo.Vendedor+')'):V_DRILL.vendedor;
  let cr='<div class="crumbs"><span class="crumb" onclick="vCerrarDrill()">‹ Volver</span> › <span class="'+(esDia?'crumb cur':'crumb')+'"'+(esDia?'':' onclick="vVolverDia()"')+'>'+nombreVend+'</span>';
  if(!esDia) cr+=' › <span class="crumb cur">'+ncFechaFmt(V_DRILL.fecha)+'</span>';
  cr+='</div>';
  let h=cr+'<table><thead><tr><th class="l">'+(esDia?'Fecha':'Cliente')+'</th><th>Unidades</th><th>Cajas</th><th>Monto</th><th>Clientes</th><th>Facturas</th><th>Ticket</th></tr></thead><tbody>';
  const filasOrd=filas.slice().sort((a,b)=>esDia?(a.Fecha<b.Fecha?-1:a.Fecha>b.Fecha?1:0):(b.Monto-a.Monto));
  let tU=0,tC=0,tM=0,tCl=0,tF=0;
  filasOrd.forEach(r=>{
    const nombre=esDia?ncFechaFmt(r.Fecha):((r.CliCodigo||'')+' — '+(r.CliNombre||'(sin nombre)'));
    const clkAttr=esDia?(' class="clickable" onclick="vAbrirDrillCliente(\''+r.Fecha+'\')"'):'';
    h+='<tr'+clkAttr+'><td class="l">'+nombre+'</td><td>'+fmtN(r.Uni)+'</td><td>'+fmtDec(r.Caj)+'</td><td>'+fmtRD(r.Monto)+'</td><td>'+fmtN(r.Cli)+'</td><td>'+fmtN(r.Fac)+'</td><td>'+fmtRD(r.Ticket)+'</td></tr>';
    tU+=r.Uni;tC+=r.Caj;tM+=r.Monto;tCl+=r.Cli;tF+=r.Fac;
  });
  h+='<tr class="totals"><td class="l">TOTAL</td><td>'+fmtN(tU)+'</td><td>'+fmtDec(tC)+'</td><td>'+fmtRD(tM)+'</td><td>'+fmtN(tCl)+'</td><td>'+fmtN(tF)+'</td><td>'+fmtRD(tF?tM/tF:0)+'</td></tr>';
  h+='</tbody></table>'; $('#tabla').innerHTML=h;
}

/* ── Excel ── */
function ensureXLSX(cb){
  if(typeof XLSX!=='undefined'){ cb(); return; }
  const s=document.createElement('script');
  s.src=BASE+'/lib/xlsx.full.min.js';
  s.onload=()=>cb(); s.onerror=()=>alert('No se pudo cargar el generador de Excel (falta wwwroot/lib/xlsx.full.min.js).');
  document.head.appendChild(s);
}

// ══════════════════════════════════════════════════════════════════════════
// Gráficos (pedido explícito 2026-09-28: "todos los reportes que están en
// históricos, tengan al momento de generarse una pestaña de gráficos... un
// Pastel para determinar el peso de las ventas y también... lineales, de
// barra y columnas"). Alcance acotado con el usuario: Pastel+Barra en los 9
// reportes; Línea solo donde el reporte YA trae una serie temporal en los
// datos que consulta hoy (Ped-Fact-NC y Fill Rate quedan sin Línea, no tienen
// ninguna dimensión de fecha en su consulta actual — agregarla es trabajo de
// backend nuevo, explícitamente diferido).
//
// ensureChart: MISMO lazy-loader que ya usa Presupuestos (Views/Presupuestos/
// Index.cshtml) para Chart.js v4.5.1 — ya vendorizado en wwwroot/lib/, cero
// descarga/CDN nueva.
function ensureChart(cb){
  if(typeof Chart!=='undefined'){ cb(); return; }
  const s=document.createElement('script'); s.src=BASE+'/lib/chart.umd.min.js';
  s.onload=()=>cb(); s.onerror=()=>alert('No se pudo cargar el generador de gráficos.');
  document.head.appendChild(s);
}
// Misma paleta hex ya usada en Presupuestos (no hay convención de leer variables
// CSS en los gráficos de este proyecto — se sigue el mismo patrón de constantes).
const HIST_PALETA=['#283078','#388848','#D29922','#C0392B','#7FA8D9','#8E44AD','#16A085','#E67E22','#34495E','#A9C4E8'];
let HIST_CHARTS=[]; // instancias vivas — se destruyen antes de cada re-render para no reventar canvases reusados
function histChartsLimpiar(){ HIST_CHARTS.forEach(c=>{ try{c.destroy();}catch(e){} }); HIST_CHARTS=[]; }
// Agrupa cualquier arreglo a los N valores más grandes + un balde "Otros" con el
// resto sumado — evita Pasteles/Barras ilegibles con 50+ filas (p.ej. vendedores).
function topNConOtros(filas,n,valFn,lblFn){
  const ordenado=filas.map(f=>({lbl:lblFn(f),val:valFn(f)||0})).sort((a,b)=>b.val-a.val);
  const top=ordenado.slice(0,n);
  const resto=ordenado.slice(n).reduce((s,f)=>s+f.val,0);
  if(resto>0) top.push({lbl:'Otros',val:resto});
  return top;
}
// Título en cada gráfico (plugins.title) + maintainAspectRatio:false (pedido explícito
// 2026-09-30: sin esto, un canvas responsive dentro de un contenedor ancho y sin altura
// fija calcula su alto a partir del ancho — en un reporte de línea con el contenedor a
// todo lo ancho de la página, eso disparaba un gráfico de cientos de px de alto,
// "fuera de la página"). Ahora cada canvas vive en un `.graf-box`/`.graf-box-linea` con
// altura fija (ver CSS) y el gráfico se ajusta a esa caja, no al revés.
function graficoPastel(canvas,labels,valores,titulo){
  if(!canvas) return;
  const total=valores.reduce((s,v)=>s+(v||0),0);
  const pct=v=>total>0?((v/total)*100).toFixed(1):'0.0';
  const ch=new Chart(canvas.getContext('2d'),{type:'pie',data:{labels,datasets:[{data:valores,backgroundColor:labels.map((_,i)=>HIST_PALETA[i%HIST_PALETA.length])}]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{
      title:{display:!!titulo,text:titulo||'',font:{size:13,weight:'600'},color:'#1F2A22',padding:{bottom:8}},
      legend:{position:'bottom',labels:{boxWidth:11,font:{size:10},
        generateLabels(chart){ const d=chart.data; return d.labels.map((lbl,i)=>({text:lbl+' ('+pct(d.datasets[0].data[i])+'%)',fillStyle:HIST_PALETA[i%HIST_PALETA.length],strokeStyle:HIST_PALETA[i%HIST_PALETA.length],index:i})); }}},
      tooltip:{callbacks:{label(ctx){ return ctx.label+': '+fmtN(ctx.parsed)+' ('+pct(ctx.parsed)+'%)'; }}}
    }}});
  HIST_CHARTS.push(ch); return ch;
}
function graficoBarra(canvas,labels,valores,etiqueta,titulo){
  if(!canvas) return;
  const ch=new Chart(canvas.getContext('2d'),{type:'bar',data:{labels,datasets:[{label:etiqueta||'Monto',data:valores,backgroundColor:labels.map((_,i)=>HIST_PALETA[i%HIST_PALETA.length])}]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},
      title:{display:!!titulo,text:titulo||etiqueta||'',font:{size:13,weight:'600'},color:'#1F2A22',padding:{bottom:8}}},
      scales:{y:{beginAtZero:true}}}});
  HIST_CHARTS.push(ch); return ch;
}
// series: [{label,data:[...]}, ...] — 1 o varias líneas sobre el mismo eje de 'labels'.
function graficoLinea(canvas,labels,series,titulo){
  if(!canvas) return;
  const ch=new Chart(canvas.getContext('2d'),{type:'line',data:{labels,datasets:series.map((s,i)=>({label:s.label,data:s.data,borderColor:HIST_PALETA[i%HIST_PALETA.length],backgroundColor:'transparent',tension:.2}))},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom'},
      title:{display:!!titulo,text:titulo||'',font:{size:13,weight:'600'},color:'#1F2A22',padding:{bottom:8}}},
      scales:{y:{beginAtZero:true}}}});
  HIST_CHARTS.push(ch); return ch;
}
// Toggle genérico "Tabla"/"Gráficos" reusado por cada pestaña — swap de 2 contenedores
// hermanos (#<prefijo>-tabla-wrap / #<prefijo>-graficos-wrap) + botones .seg .on, y
// dispara el render de gráficos de esa pestaña vía el callback 'renderFn' (perezoso,
// solo la primera vez que se entra a Gráficos por cada Generar, igual que el resto de
// los toggles de este archivo).
function histToggleVista(prefijo,vista,renderFn){
  $('#'+prefijo+'-vista-tabla').classList.toggle('on',vista==='tabla');
  $('#'+prefijo+'-vista-graf').classList.toggle('on',vista==='graf');
  $('#'+prefijo+'-tabla-wrap').classList.toggle('hide',vista!=='tabla');
  $('#'+prefijo+'-graficos-wrap').classList.toggle('hide',vista!=='graf');
  if(vista==='graf') ensureChart(()=>{ histChartsLimpiar(); renderFn(); });
}

// ══════════════════════════════════════════════════════════════════════════
// Exportar a PDF (2026-09-13, pedido explícito del usuario: "en todos los
// reportes de historicos de ventas debo tener el reporte en excel y en pdf",
// "que salga similar a la pantalla"). ADAPTADO de la función ya probada en
// producción `ppExportarPDF` (Views/Supervision/Index.cshtml) — mismo algoritmo
// de captura-por-bloque + empaquetado en páginas A4 + corte alineado al borde
// inferior de <tr> cuando un bloque no cabe entero en una hoja — pero recibe
// NODOS del DOM directamente (`bandNode`/`blockNodes`) en vez de selectores que
// exigían las clases `.pp-band`/`.pp-block`/`.bd` de ese otro módulo, así
// cualquier reporte de Históricos lo reusa con sus propios divs
// (`#X-print-head`, `#X-cards`, `#X-tabla`) sin HTML nuevo. No se tocó ni se
// reusó literal `ppExportarPDF` (evita cualquier riesgo de romper Supervisión).
// ══════════════════════════════════════════════════════════════════════════
function histEnsureHtml2Canvas(cb){ if(typeof html2canvas!=='undefined'){cb();return;} const s=document.createElement('script'); s.src=BASE+'/lib/html2canvas.min.js'; s.onload=()=>cb(); s.onerror=()=>alert('No se pudo cargar el generador de PDF.'); document.head.appendChild(s); }
function histEnsureJsPDF(cb){ if(window.jspdf&&window.jspdf.jsPDF){cb();return;} const s=document.createElement('script'); s.src=BASE+'/lib/jspdf.umd.min.js'; s.onload=()=>cb(); s.onerror=()=>alert('No se pudo cargar el generador de PDF.'); document.head.appendChild(s); }
function histSetBtns(ids,texto,disabled){
  return (ids||[]).map(id=>{ const b=$('#'+id); if(!b) return null; const t0=b.textContent; if(texto!=null) b.textContent=texto; b.disabled=disabled; return {b,t0}; });
}
function histRestoreBtns(estados){ estados.forEach(e=>{ if(e){ e.b.textContent=e.t0; e.b.disabled=false; } }); }

// cfg: {bandNode, blockNodes:[...], footerTxt, filename, botonIds}
function histExportarPDF(cfg){
  const estados=histSetBtns(cfg.botonIds,'Generando…',true);
  histEnsureHtml2Canvas(()=>histEnsureJsPDF(()=>{
    const bandNode=cfg.bandNode, blockNodes=(cfg.blockNodes||[]).filter(Boolean);
    if(!blockNodes.length){ histRestoreBtns(estados); alert('Nada que exportar todavía — genera el informe primero.'); return; }
    (async()=>{
      const canvases=[];
      for(const n of [bandNode, ...blockNodes]) canvases.push(n?await html2canvas(n,{scale:2, backgroundColor:'#ffffff', useCORS:true}):null);
      return canvases;
    })()
      .then(canvases=>{
        const {jsPDF}=window.jspdf;
        const pdf=new jsPDF({orientation:'l',unit:'mm',format:'a4'});
        const pageW=pdf.internal.pageSize.getWidth(), pageH=pdf.internal.pageSize.getHeight();
        // margen lateral de 1/2 pulgada (12.7 mm) a cada lado — pedido 2026-10-09: sin él se perdían datos en los bordes al imprimir a página completa.
        const mX=12.7, cw=pageW-2*mX;
        const mmH=c=>c.height*(cw/c.width);

        const bandCanvas=canvases[0];
        const blockCanvases=canvases.slice(1);
        const bandH=bandCanvas?mmH(bandCanvas):0;
        const topGap=bandCanvas?3:0, footReserve=10;
        const contentH=pageH-bandH-topGap-footReserve;

        function recortarCanvas(c, srcYpx, hPx){
          const out=document.createElement('canvas');
          out.width=c.width; out.height=Math.max(1, Math.round(hPx));
          out.getContext('2d').drawImage(c, 0, srcYpx, c.width, hPx, 0, 0, c.width, hPx);
          return out;
        }

        const pages=[[]];
        let cursorMm=0;
        blockCanvases.forEach((c,i)=>{
          if(!c) return;
          const total=mmH(c);
          if(total<=contentH){
            if(cursorMm>0 && total>contentH-cursorMm){ pages.push([]); cursorMm=0; }
            pages[pages.length-1].push({canvas:c, hMm:total, yMm:cursorMm});
            cursorMm+=total;
          } else {
            const pxPerMm=c.width/cw;
            const blockNode=blockNodes[i];
            const ratio=c.width/blockNode.offsetWidth;
            const blockTop=blockNode.getBoundingClientRect().top;
            const bordesFila=[...blockNode.querySelectorAll('tr')]
              .map(tr=>Math.round((tr.getBoundingClientRect().bottom-blockTop)*ratio))
              .filter(y=>y>0 && y<c.height).sort((a,b)=>a-b);
            let remaining=total, src=0;
            while(remaining>0){
              if(cursorMm>=contentH){ pages.push([]); cursorMm=0; }
              let take=Math.min(contentH-cursorMm, remaining);
              let ajustado=false;
              if(src+take<total){
                const idealPx=(src+take)*pxPerMm, srcPx=src*pxPerMm;
                const candidatos=bordesFila.filter(y=>y<=idealPx && y>srcPx);
                if(candidatos.length){ take=(candidatos[candidatos.length-1]/pxPerMm)-src; ajustado=true; }
              }
              if(take<=0) take=Math.min(contentH-cursorMm, remaining);
              const cropped=recortarCanvas(c, src*pxPerMm, take*pxPerMm);
              pages[pages.length-1].push({canvas:cropped, hMm:take, yMm:cursorMm});
              src+=take; remaining-=take;
              cursorMm = ajustado ? contentH : cursorMm+take;
            }
          }
        });

        const totalPages=pages.length;
        // JPEG comprimido sobre fondo blanco (2026-10-10): los PDF en PNG pesaban decenas de MB; esto los reduce ~10x sin perder legibilidad.
        const toImg=c=>{ const w=document.createElement('canvas'); w.width=c.width; w.height=c.height; const x=w.getContext('2d'); x.fillStyle='#fff'; x.fillRect(0,0,w.width,w.height); x.drawImage(c,0,0); return w.toDataURL('image/jpeg',0.85); };
        const bandData=bandCanvas?toImg(bandCanvas):null;
        const footerTxt=cfg.footerTxt||'';

        pages.forEach((items,p)=>{
          if(p>0) pdf.addPage();
          if(bandData) pdf.addImage(bandData,'JPEG',mX,0,cw,bandH);
          items.forEach(it=>{
            pdf.addImage(toImg(it.canvas),'JPEG',mX, bandH+topGap+it.yMm, cw, it.hMm);
          });
          pdf.setFontSize(7); pdf.setTextColor(120);
          pdf.text(footerTxt, mX, pageH-6, {maxWidth: cw-30});
          pdf.text('Página '+(p+1)+' / '+totalPages, pageW-mX, pageH-6, {align:'right'});
        });
        pdf.save(cfg.filename);
      }).catch(err=>alert('Error generando PDF: '+err)).finally(()=>{ histRestoreBtns(estados); });
  }));
}

