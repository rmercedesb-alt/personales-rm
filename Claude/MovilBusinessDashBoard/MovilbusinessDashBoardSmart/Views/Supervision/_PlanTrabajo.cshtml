function ptWNueva(fecha,o){const a=Object.assign({_k:PT.W._k++,actId:null,fecha,horaIni:'',horaFin:'',tipo:'otro',subtipo:null,titulo:'',detalle:null,repCodigo:'',repNombre:'',cliId:null,cliNombre:null,meta:'',prioridad:'M',peso:1,fijo:false,origen:'plan',modalidad:'',alcance:null,alcanceCod:null,alcanceNombre:null},o||{}); if(a.repCodigo&&!a.alcance)a.alcance='vendedor'; return a;}
function ptWFijos(d){
