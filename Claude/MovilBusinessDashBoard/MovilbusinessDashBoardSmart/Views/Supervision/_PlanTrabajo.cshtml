  if(d.dow>=1&&d.dow<=5)W.acts.push(ptWNueva(d.fecha,{horaIni:'17:30',horaFin:'18:00',tipo:'reunion',titulo:'Reunión de seguimiento (cierre del día)',meta:'Resultados del día y compromisos del siguiente',fijo:true}));
  if(d.dow===6)W.acts.push(ptWNueva(d.fecha,{horaIni:'08:30',horaFin:'10:00',tipo:'reunion',titulo:'Reunión con Gerencia (cierre de la semana)',meta:'Presentar resultados y plan de la próxima semana',fijo:true}));
  ((PT.ctx&&PT.ctx.recurrentes)||[]).filter(r=>r.dia===d.dow).forEach(r=>W.acts.push(ptWNueva(d.fecha,{horaIni:r.horaIni||'',horaFin:r.horaFin||'',tipo:'reunion',titulo:r.titulo,meta:r.meta||'',modalidad:r.modalidad||'',alcance:r.alcance,alcanceCod:r.alcanceCod,alcanceNombre:r.alcanceNombre,fijo:true})));
  if(d.dow===5)W.acts.push(ptWNueva(d.fecha,{horaIni:'18:15',horaFin:'18:45',tipo:'gestion',titulo:'Cierre del plan de trabajo: registrar ejecución y % de logro',meta:'Plan cerrado el viernes',fijo:true,peso:.5}));
}
/* AMCO-GT (IEGT) de la semana anterior al plan, por vendedor — misma fórmula y datos que la Priorización (iegtDe + /apiseg/semana). */
function ptAmcoAsegurar(cb){
  const W=PT.W,c=PT.ctx, key=W.sup+'|'+W.desde; if(PT.amcoKey===key){cb();return;}
  const d=ptD(W.desde), lun=new Date(d); lun.setDate(d.getDate()-((d.getDay()+6)%7)-7); const sab=new Date(lun); sab.setDate(lun.getDate()+5);
  const sp=new URLSearchParams({fechaIni:ptY(lun),fechaFin:ptY(sab)}); if(c.codigos&&c.codigos.length)sp.set('supervisores',c.codigos.join(','));
  fetch(BASE+'/apiseg/semana?'+sp.toString()).then(r=>r.json()).then(j=>{
    const vend=(j&&j.vendedores)||[], med=median(vend.map(v=>v.PromSeg)); PT.amco={}; vend.forEach(v=>{PT.amco[v.RepCodigo]=Math.round(iegtDe(v,med)*10)/10;});
    PT.amcoKey=key; PT.amcoRango=ptFmtC(ptY(lun))+' – '+ptFmtC(ptY(sab)); cb();
  }).catch(()=>{PT.amco={};PT.amcoKey=null;PT.amcoRango='';cb();});
}
function ptWGenerar(silencioso){
  const op=$('#pt-w-opc').value; if(op==='cobertura'||op==='blanco'||!PT.W||!PT.ctx){ptWGenerarCore(silencioso);return;}
  ptAmcoAsegurar(()=>ptWGenerarCore(silencioso));
}
function ptWGenerarCore(silencioso){
  const W=PT.W,c=PT.ctx; if(!c||!c.dias.length){toast('Elige supervisor y un rango de fechas válido (máx. 21 días).');return;}
  if(!silencioso&&W.acts.length&&!confirm('Esto reemplaza las actividades actuales por una propuesta nueva. ¿Continuar?'))return;
  const op=$('#pt-w-opc').value; W.opcion=op; W.acts=[]; W._k=1;
  const hoy=new Date();hoy.setHours(0,0,0,0);
  const amco=PT.amco||{};
  let vs=c.vendedores.map(v=>({v,dd:v.ultPresencial?Math.round((hoy-ptD(v.ultPresencial))/864e5):60,am:amco[v.rep]!=null?amco[v.rep]:null}))
    .sort((a,b)=>{ if(op==='cobertura')return b.dd-a.dd;                                  // cobertura: rota por quien lleva más tiempo sin acompañamiento
      if(a.v.prioritario!==b.v.prioritario)return a.v.prioritario?-1:1;                    // 1.º la prioridad
      if(a.am!==b.am){ if(a.am==null)return 1; if(b.am==null)return -1; return a.am-b.am; } // 2.º el AMCO-GT (el más bajo primero; sin dato al final)
      return b.dd-a.dd; });                                                               // 3.º más tiempo sin acompañamiento
  if(op==='riesgo'){ const r=vs.filter(x=>x.v.prioritario||(x.am!=null&&x.am<70)); if(r.length)vs=[...r,...r,...vs.filter(x=>!r.includes(x))]; }   // 2 visitas a cada vendedor en riesgo y luego el resto
  vs=vs.map(x=>x.v);
  let idx=0; const next=()=>vs.length?vs[idx++%vs.length]:null;
  if(op!=='blanco'){
    c.dias.forEach(d=>{
      if(d.tipo==='libre')return;
      if(d.calle){
        const sab=d.dow===6; const slots=sab?[['10:15','12:30'],['13:30','15:00']]:op==='cobertura'?[['08:00','10:30'],['10:45','12:45'],['13:30','15:00']]:[['08:00','11:30'],['12:30','15:00']];
        slots.forEach(s=>{const v=next(), aud=d.tipo==='auditoria';
          W.acts.push(ptWNueva(d.fecha,{horaIni:s[0],horaFin:s[1],tipo:'calle',subtipo:aud?'audit':'acomp',titulo:(aud?'Auditoría de ruta a ':'Acompañamiento a ')+(v?v.nombre:'(definir vendedor)'),repCodigo:v?v.rep:'',repNombre:v?v.nombre:'',
            meta:aud?'Auditar ruta, ejecución en PDV y cumplimiento de visitas':'Evaluar ejecución en PDV y acordar compromisos',prioridad:v&&v.prioritario?'A':'M',peso:2}));});
      } else {
        const sab=d.dow===6; W.acts.push(ptWNueva(d.fecha,{horaIni:sab?'10:15':'08:00',horaFin:sab?'11:00':'09:00',tipo:'virtual',titulo:'Revisión de indicadores del equipo (AMCO-GT, ventas vs presupuesto, visitas)',meta:'Detectar desvíos antes de salir a hablar con el equipo'}));
        for(let i=0;i<(sab?1:2);i++){const v=next(); W.acts.push(ptWNueva(d.fecha,{horaIni:sab?'11:00':(i?'11:00':'09:15'),horaFin:sab?'12:30':(i?'12:30':'10:45'),tipo:'virtual',titulo:'Seguimiento telemático a '+(v?v.nombre:'(definir vendedor)'),repCodigo:v?v.rep:'',repNombre:v?v.nombre:'',meta:'Revisar ruta, visitas y pedidos; acordar acciones',prioridad:v&&v.prioritario?'A':'M'}));}
        W.acts.push(ptWNueva(d.fecha,{horaIni:'13:30',horaFin:'15:00',tipo:'gestion',titulo:'Gestión de clientes sin compra / pedidos pendientes del día',meta:'Recuperar ventas del periodo'}));
      }
    });
  }
  W.acts.forEach(a=>{ if(a.repCodigo&&amco[a.repCodigo]!=null&&(a.tipo==='calle'||a.tipo==='virtual'))a.meta=(a.meta?a.meta+' ':'')+'(AMCO-GT '+amco[a.repCodigo]+')'; });
  c.dias.forEach(d=>{ if(d.tipo!=='libre'||d.dow!==0)ptWFijos(d); });
  $('#pt-w-opdesc').textContent=PT_OPC[op]+(op!=='cobertura'&&op!=='blanco'&&PT.amcoRango?' AMCO-GT de la semana '+PT.amcoRango+'.':'');
  ptWRender();
}
function ptWRender(){
  const W=PT.W,c=PT.ctx; const g=$('#pt-w-grid'); if(!c){return;}
  const vopts=c.vendedores.map(v=>[v.rep,v.nombre+' ('+v.rep+')']);
  const dias=c.dias.filter(d=>d.dow!==0||W.acts.some(a=>a.fecha===d.fecha));
  let h='';
  dias.forEach(d=>{
    const chip=d.calle?'<span class="pt-chip calle">🚗 Día de CALLE · '+(d.tipo==='auditoria'?'auditoría':'acompañamiento')+'</span>':d.tipo==='virtual'?'<span class="pt-chip virtual">🖥 Día de SUPERVISIÓN TELEMÁTICA</span>':'<span class="pt-chip libre">Libre</span>';
    const acts=W.acts.filter(a=>a.fecha===d.fecha).sort((a,b)=>(a.horaIni||'99:99').localeCompare(b.horaIni||'99:99'));
    h+='<div class="pt-day"><span class="nm">'+ptFmt(d.fecha)+'</span>'+chip+'<button class="rbtn" style="margin-left:auto;padding:5px 10px;font-size:12px" data-add="'+d.fecha+'">+ Actividad</button></div>';
    h+='<div class="scroller"><table class="pt-tb"><thead><tr><th style="width:96px">Inicio</th><th style="width:96px">Fin</th><th style="width:130px">Tipo</th><th>Actividad (escribe lo que quieras)</th><th style="width:190px">Con quién (todos / grupo / división / vendedor)</th><th style="width:118px">Modalidad</th><th style="width:150px">Cliente / lugar</th><th style="width:180px">Meta / qué se espera</th><th style="width:96px">Día</th><th style="width:62px">Prio.</th><th style="width:66px">Peso</th><th style="width:34px"></th></tr></thead><tbody>';
    if(!acts.length)h+='<tr><td colspan="12" class="hint" style="text-align:center">Sin actividades este día.</td></tr>';
    acts.forEach(a=>{
      h+='<tr data-k="'+a._k+'"'+(a.fijo?' class="fijo"':'')+'><td><input type="time" data-f="horaIni" value="'+escA(a.horaIni)+'"></td><td><input type="time" data-f="horaFin" value="'+escA(a.horaFin)+'"></td>'
        +'<td><select data-f="tipo">'+ptSel(PT_TIPOS,a.tipo)+'</select></td><td><input type="text" data-f="titulo" maxlength="200" value="'+escA(a.titulo)+'"></td>'
        +'<td><select data-f="quien">'+ptQuienHtml(ptQuienVal(a))+'</select></td><td><select data-f="modalidad">'+ptSel([['presencial','Presencial'],['virtual','Virtual'],['llamada','Llamada']],a.modalidad,'—')+'</select></td><td><input type="text" data-f="cliNombre" maxlength="150" value="'+escA(a.cliNombre||'')+'"></td><td><input type="text" data-f="meta" maxlength="300" value="'+escA(a.meta)+'"></td><td><select data-f="fecha">'+ptSel(c.dias.map(x=>[x.fecha,ptFmtC(x.fecha)]),a.fecha)+'</select></td>'
        +'<td><select data-f="prioridad">'+ptSel([['A','A'],['M','M'],['B','B']],a.prioridad)+'</select></td><td><input type="number" data-f="peso" min="0" max="10" step="0.5" value="'+a.peso+'"></td>'
        +'<td><button class="x" data-del="'+a._k+'" title="Quitar">🗑</button></td></tr>';
