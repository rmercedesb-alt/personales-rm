function ptAbrir(id){
  const box=$('#pt-d-box'); $('#pt-l-box').classList.add('hide'); box.classList.remove('hide'); box.innerHTML='<div class="hint">Cargando plan…</div>';
  api('/plan/detalle?id='+id).then(j=>{ if(!j||!j.ok){box.innerHTML='<div class="pt-warn w">'+escA(ptErr(j))+'</div>';return;}
    PT.D=j; const sup=j.plan.supCod;
    const pintar=c=>{ PT.ctxSup[sup]=c; ptDetPintar(); };
    if(PT.ctxSup[sup])pintar(PT.ctxSup[sup]); else ptCtx(sup,'','',pintar);
  }).catch(e=>{box.innerHTML='<div class="pt-warn w">Error: '+escA(e)+'</div>';});
}
function ptDetPintar(){
  const D=PT.D,p=D.plan,m=p.metricas||{},l=ptLogroPlan(p),box=$('#pt-d-box'),cerr=p.estatus==='Cerrado',ger=ptEsGer();
  let h='<button class="pp-back" id="pt-d-back">← Volver a la lista de planes</button>';
  h+='<div class="vhead"><div><div style="font-weight:800;font-size:16px">'+escA(p.numero)+' · '+escA(p.supNombre||p.supCod)+' '+ptEstChip(p)+'</div><div class="sub">'+escA(ptRango(p.desde,p.hasta))+' · Semana '+escA(p.semana||'')+(p.objetivo?' · Objetivo: '+escA(p.objetivo):'')+'</div></div>'
    +'<div style="display:flex;gap:8px;flex-wrap:wrap">';
  if(D.puedeEditar)h+='<button class="rbtn" id="pt-d-edit">'+(ger&&p.estatus!=='Borrador'?'✏️ Ajustar plan (Gerencia)':'✏️ Editar')+'</button>';
  if(D.puedeEnviar)h+='<button class="go" id="pt-d-send">📨 Enviar a aprobación</button>';
  if(D.puedeAprobar)h+='<button class="go" id="pt-d-apr">✅ Aprobar plan</button><button class="rbtn" id="pt-d-dev">↩ Devolver con comentarios</button>';
  else if(D.puedeRetirar)h+='<button class="rbtn" id="pt-d-ret">↩ Retirar a borrador</button>';
  if(D.puedeEliminar)h+='<button class="rbtn" id="pt-d-del">🗑 Eliminar</button>';
  if(D.puedeEjecutar)h+='<button class="rbtn" id="pt-d-extra">➕ Actividad adicional</button>';
  if(p.estatus==='Activo')h+=D.puedeCerrar?'<button class="go" id="pt-d-close">🔒 Cerrar plan</button>':'<button class="rbtn" disabled title="El cierre lo hace el supervisor el viernes">🔒 Cierre: viernes '+escA(ptFmtC(p.limiteCierre))+'</button>';
  if(D.puedeReabrir)h+='<button class="rbtn" id="pt-d-reopen">↩ Reabrir (Gerencia)</button>';
  h+='<button class="rbtn" id="pt-d-xls">📥 Excel</button><button class="rbtn" id="pt-d-rep">📊 Reportes del plan</button></div></div>';
  if(p.estatus==='Borrador')h+='<div class="pt-warn w">📝 Plan en <b>Borrador</b>'+(p.comentarioGerencia?' — 💬 <b>Gerencia pidió ajustes:</b> '+escA(p.comentarioGerencia):'')+'. Ajústalo y envíalo a aprobación de Gerencia para empezar a registrar su ejecución.</div>';
  if(p.estatus==='Por aprobar')h+='<div class="pt-warn w">⏳ <b>Pendiente de aprobación de Gerencia</b> (enviado por '+escA(p.enviadoPor||'')+' el '+escA(p.fechaEnvio||'')+'). '+(ger?'Puedes <b>ajustarlo</b> y luego <b>aprobarlo</b>, o devolverlo con comentarios.':'Aún no se puede registrar ejecución; Gerencia puede hacerle ajustes antes de aprobarlo.')+'</div>';
  if(p.aprobadoPor&&p.estatus!=='Borrador'&&p.estatus!=='Por aprobar')h+='<div class="sub" style="margin:6px 0">✅ Aprobado por <b>'+escA(p.aprobadoPor)+'</b> el '+escA(p.fechaAprobacion||'')+(p.comentarioGerencia?' · 💬 '+escA(p.comentarioGerencia):'')+'</div>';
  if(p.sinCerrar)h+='<div class="pt-fri">🔴 <b>Plan SIN CERRAR:</b> el cierre debía hacerse el viernes '+escA(ptFmtC(p.limiteCierre))+'. '+(D.puedeCerrar?'Registra lo pendiente y ciérralo ya.':'')+'</div>';
  else if(p.estatus==='Activo'&&D.puedeCerrar&&!ger)h+='<div class="pt-fri">📅 <b>Hoy toca cerrar el plan</b> (día de cierre: viernes). Registra lo pendiente y usa «Cerrar plan» para congelar el % de logro y generar el reporte de cierre.</div>';
  h+='<div class="kpis"><div class="panel kpi"><div class="k">% de logro '+(cerr?'(final)':'(vivo)')+'</div><div class="v" style="color:'+ptColLogro(l)+'">'+(l==null?'—':l+'%')+'</div><div class="s">'+escA(ptNivelCalc(p))+(cerr?'':' (a la fecha)')+'</div></div>'
    +'<div class="panel kpi"><div class="k">Logro a la fecha</div><div class="v">'+(m.logroAFechaPct==null?'—':m.logroAFechaPct+'%')+'</div><div class="s">solo lo programado hasta hoy</div></div>'
    +'<div class="panel kpi"><div class="k">Realizadas / Parciales</div><div class="v">'+(m.realizadas||0)+' / '+(m.parciales||0)+'</div><div class="s">de '+(m.total||0)+' actividades</div></div>'
    +'<div class="panel kpi"><div class="k">Pendientes / vencidas</div><div class="v">'+(m.pendientes||0)+' / '+(m.vencidas||0)+'</div><div class="s">vencida = fecha pasada sin registro</div></div>'
    +'<div class="panel kpi"><div class="k">No realiz. / Reprog.</div><div class="v">'+(m.noRealizadas||0)+' / '+(m.reprogramadas||0)+'</div><div class="s">+ '+(m.extras||0)+' extra(s)</div></div></div>';
  h+='<div style="display:flex;gap:8px;flex-wrap:wrap;margin:4px 0 10px">'+D.porDia.map(x=>'<div class="panel" style="padding:7px 11px;min-width:105px"><div style="font-size:11px;font-weight:700">'+ptFmtC(x.clave)+'</div>'+ptBar(x.metricas.logroPct)+'<div style="font-size:11px;color:var(--muted)">'+(x.metricas.logroPct==null?'—':x.metricas.logroPct+'%')+' · '+x.metricas.realizadas+'/'+x.metricas.total+'</div></div>').join('')+'</div>';
  if(cerr)h+='<div class="note" style="flex-direction:column;gap:4px"><div><b>Logros:</b> '+escA(p.cierreLogros||'—')+'</div><div><b>Aprendizajes:</b> '+escA(p.cierreAprendizajes||'—')+'</div><div><b>Compromisos:</b> '+escA(p.cierreCompromisos||'—')+'</div><div class="sub">Cerrado por '+escA(p.cerradoPor)+' el '+escA(p.fechaCierre||'')+'</div></div>';
  h+='<div class="hint" style="text-align:left;padding:0 0 6px">'+(D.puedeEjecutar?'💡 <b>Doble clic</b> sobre una actividad (o el botón ✍) para registrar el trabajo realizado; puedes ir registrando día a día.':'La ejecución se registra cuando el plan está aprobado (Activo).')+'</div>';
  const dias=[...new Set(D.actividades.map(a=>a.fecha))].sort();
  dias.forEach(f=>{
    h+='<div class="pt-day"><span class="nm">'+ptFmt(f)+'</span></div><div class="scroller"><table class="pt-tb pt-ex"><thead><tr><th style="width:92px">Hora</th><th style="width:110px">Tipo</th><th>Actividad</th><th>Objetivo</th><th style="width:44px">Prio.</th><th style="width:110px">Estado</th><th>Trabajo realizado / resultado</th><th style="width:34px"></th></tr></thead><tbody>';
    D.actividades.filter(a=>a.fecha===f).forEach(a=>{
      const ej=a.ejecuciones||[], u=ej[ej.length-1], venc=a.estado==='Pendiente'&&a.origen==='plan'&&f<ptY(new Date());
      h+='<tr class="row" data-act="'+a.actId+'"><td>'+escA((a.horaIni||'')+(a.horaFin?'–'+a.horaFin:'')||'—')+'</td><td><span class="pt-chip '+a.tipo+'">'+escA(PT_TNOM[a.tipo]||a.tipo)+'</span></td><td><b>'+escA(a.titulo)+'</b>'+(a.origen==='extra'?' <span class="pt-chip libre">extra</span>':'')+(a.meta?'<div class="sub">'+escA(a.meta)+'</div>':'')+'</td>'
        +'<td>'+escA(ptQuienTxt(a))+(a.modalidad?'<div class="sub">'+escA(ptModTxt(a))+'</div>':'')+(a.cliNombre?'<div class="sub">'+escA(a.cliNombre)+'</div>':'')+'</td><td>'+escA(a.prioridad)+'</td><td><span class="pt-chip '+ptEstCls(a.estado)+'">'+escA(a.estado)+'</span>'+(venc?'<div class="sub" style="color:var(--bad)">vencida</div>':'')+'</td>'
        +'<td>'+(u?'<div>'+escA(u.trabajo||'')+'</div>'+(u.resultado?'<div class="sub">➜ '+escA(u.resultado)+'</div>':'')+'<div class="sub">'+escA(ptFmtC(u.fechaRealizada))+(u.repAtendidoNombre?' · '+escA(u.repAtendidoNombre):'')+(u.cliNombre?' · '+escA(u.cliNombre):'')+(ej.length>1?' · '+ej.length+' registros':'')+'</div>':'<span class="sub">—</span>')+'</td><td><button class="x" data-eje="'+a.actId+'" title="Registrar ejecución">✍</button></td></tr>';
    });
    h+='</tbody></table></div>';
  });
  box.innerHTML=h;
  $('#pt-d-back').onclick=()=>ptLista();
  const on=(id,fn)=>{const e=$(id);if(e)e.onclick=fn;};
  on('#pt-d-edit',()=>ptNuevo(p.planId)); on('#pt-d-xls',()=>{window.location=BASE+'/apisuperv/plan/excel?id='+p.planId;});
  on('#pt-d-send',()=>{ if(confirm('¿Enviar el plan a aprobación de Gerencia? Después no podrás editarlo hasta que lo devuelva o lo retires.'))ptCambiarEstatus(p.planId,'Por aprobar'); });
  on('#pt-d-ret',()=>{ if(confirm('¿Retirar el plan a borrador para seguir editándolo?'))ptCambiarEstatus(p.planId,'Borrador'); });
  on('#pt-d-apr',()=>ptApr('aprobar')); on('#pt-d-dev',()=>ptApr('devolver'));
  on('#pt-d-reopen',()=>{ if(confirm('¿Reabrir el plan cerrado? El % de logro se recalculará al cerrarlo de nuevo.'))ptCambiarEstatus(p.planId,'Activo'); });
  on('#pt-d-del',()=>{ if(!confirm('¿Eliminar este plan en borrador?'))return; ptPost('/plan/eliminar',{id:p.planId}).then(j=>{ if(j&&j.ok){toast('Plan eliminado');ptLista();} else toast(ptErr(j)); }); });
  on('#pt-d-extra',()=>ptExtra()); on('#pt-d-close',()=>ptCierre()); on('#pt-d-rep',()=>ptVerReporte(p.planId,'avance'));
  $$('#pt-d-box tr.row').forEach(tr=>{ tr.ondblclick=()=>ptEje(+tr.dataset.act); });
  $$('#pt-d-box [data-eje]').forEach(b=>b.onclick=ev=>{ev.stopPropagation();ptEje(+b.dataset.eje);});
}
function ptCambiarEstatus(id,est,coment){ ptPost('/plan/estatus',{id,estatus:est,comentario:coment||null}).then(j=>{ if(j&&j.ok){ptAbrir(id);ptGlobales();ptBadge(); const num=(PT.D&&PT.D.plan&&PT.D.plan.planId===id)?PT.D.plan.numero:''; if(est==='Por aprobar')ptConfirma(num||('#'+id),'Por aprobar',id); else if(est==='Borrador')toast('Plan devuelto a borrador'); else toast('Plan actualizado');} else toast(ptErr(j)); }); }
/* Aprobar o devolver (solo Gerencia) */
function ptApr(modo){
  const ap=modo==='aprobar'; PT.aprModo=modo;
  $('#pt-apr-t').textContent=ap?'✅ Aprobar plan de trabajo':'↩ Devolver plan al supervisor';
  $('#pt-apr-d').textContent=ap?'Al aprobar, el plan queda Activo y el supervisor empieza a registrar su ejecución. Si hiciste ajustes con «Ajustar plan», quedan incluidos.':'El plan vuelve a Borrador para que el supervisor lo ajuste y lo reenvíe.';
  $('#pt-apr-l').textContent=ap?'Comentario (opcional)':'¿Qué debe ajustar? (obligatorio)'; $('#pt-apr-c').value=''; $('#pt-apr-ok').textContent=ap?'✅ Aprobar':'↩ Devolver'; $('#pt-apr').classList.add('on');
}
(function(){
  const cerrar=()=>$('#pt-apr').classList.remove('on'); $('#pt-apr-x').onclick=$('#pt-apr-cancel').onclick=cerrar;
  $('#pt-apr-ok').onclick=()=>{ const ap=PT.aprModo==='aprobar', c=$('#pt-apr-c').value.trim(); if(!ap&&!c){toast('Escribe qué debe ajustar el supervisor.');return;} cerrar(); ptCambiarEstatus(PT.D.plan.planId,ap?'Activo':'Borrador',c); };
})();

/* Registrar ejecución */
function ptEje(actId){
  const D=PT.D,p=D.plan; if(p.estatus==='Borrador'){toast('El plan es un borrador: envíalo a aprobación de Gerencia primero.');return;} if(p.estatus==='Por aprobar'){toast('El plan está pendiente de aprobación de Gerencia.');return;} if(p.estatus==='Cerrado'){toast('El plan está cerrado (Gerencia puede reabrirlo).');return;}
  const a=D.actividades.find(x=>x.actId===actId); if(!a)return; PT.ejeAct=a;
  const hoy=ptY(new Date()), c=PT.ctxSup[p.supCod]||{vendedores:[]};
  $('#pt-eje-info').innerHTML='<div><b>'+escA(ptFmt(a.fecha))+' '+escA((a.horaIni||'')+(a.horaFin?'–'+a.horaFin:''))+'</b> · '+escA(PT_TNOM[a.tipo]||a.tipo)+' · <b>'+escA(a.titulo)+'</b>'+(a.meta?'<div class="sub">Meta: '+escA(a.meta)+'</div>':'')+'</div>';
  $('#pt-e-estado').value='Realizada'; $('#pt-e-fecha').value=a.fecha<=hoy?a.fecha:hoy; $('#pt-e-hora').value=a.horaIni||''; $('#pt-e-cli').value=a.cliNombre||''; $('#pt-e-trab').value=''; $('#pt-e-res').value='';
  $('#pt-e-rep').innerHTML=ptSel(c.vendedores.map(v=>[v.rep,v.nombre+' ('+v.rep+')']),a.repCodigo||'','— ninguno / varios —');
  ptEjeHist(); $('#pt-eje').classList.add('on');
}
function ptEjeHist(){
  const a=PT.ejeAct, ej=a.ejecuciones||[];
  $('#pt-eje-hist').innerHTML=ej.length?'<b style="font-size:12px">Registros anteriores</b>'+ej.map(e=>'<div class="pt-hist"><span class="pt-chip '+ptEstCls(e.estado)+'">'+escA(e.estado)+'</span> '+escA(ptFmtC(e.fechaRealizada))+(e.horaRealizada?' '+escA(e.horaRealizada):'')+' · '+escA(e.registradoPor)+' <button class="x" data-delejec="'+e.ejeId+'" title="Eliminar registro">🗑</button><div>'+escA(e.trabajo||'')+'</div>'+(e.resultado?'<div class="sub">➜ '+escA(e.resultado)+'</div>':'')+((e.repAtendidoNombre||e.cliNombre)?'<div class="sub">'+escA([e.repAtendidoNombre,e.cliNombre].filter(Boolean).join(' · '))+'</div>':'')+'</div>').join(''):'';
  $$('#pt-eje-hist [data-delejec]').forEach(b=>b.onclick=()=>{ if(!confirm('¿Eliminar este registro de ejecución?'))return; ptPost('/plan/ejecucion-eliminar',{id:0,ejeId:+b.dataset.delejec}).then(j=>{ if(j&&j.ok){toast('Registro eliminado');$('#pt-eje').classList.remove('on');ptAbrir(PT.D.plan.planId);} else toast(ptErr(j)); }); });
}
(function(){
  const cerrar=()=>$('#pt-eje').classList.remove('on'); $('#pt-eje-x').onclick=$('#pt-e-cancel').onclick=cerrar;
  $('#pt-e-save').onclick=()=>{
    const a=PT.ejeAct, rep=$('#pt-e-rep').value, c=PT.ctxSup[PT.D.plan.supCod]||{vendedores:[]}, v=c.vendedores.find(x=>x.rep===rep);
    const b={actId:a.actId,fechaRealizada:$('#pt-e-fecha').value||null,horaRealizada:$('#pt-e-hora').value||null,trabajo:$('#pt-e-trab').value.trim(),repAtendido:rep||null,repAtendidoNombre:v?v.nombre:null,cliId:null,cliNombre:$('#pt-e-cli').value.trim()||null,resultado:$('#pt-e-res').value.trim(),estado:$('#pt-e-estado').value};
    $('#pt-e-save').disabled=true;
    ptPost('/plan/ejecucion',b).then(j=>{ $('#pt-e-save').disabled=false; if(!j||!j.ok){toast(ptErr(j));return;} toast('Ejecución guardada · logro '+(j.metricas&&j.metricas.logroPct!=null?j.metricas.logroPct+'%':'—')); cerrar(); ptAbrir(PT.D.plan.planId); }).catch(e=>{$('#pt-e-save').disabled=false;toast('Error: '+e);});
  };
})();

/* Actividad adicional */
function ptExtra(){
  const p=PT.D.plan, c=PT.ctxSup[p.supCod]||{vendedores:[]}; const hoy=ptY(new Date());
  $('#pt-a-fecha').value=hoy>=p.desde&&hoy<=p.hasta?hoy:p.desde; $('#pt-a-fecha').min=p.desde; $('#pt-a-fecha').max=p.hasta;
  $('#pt-a-tipo').innerHTML=ptSel(PT_TIPOS,'otro'); $('#pt-a-hi').value=''; $('#pt-a-hf').value=''; $('#pt-a-tit').value='';
  $('#pt-a-rep').innerHTML=ptSel(c.vendedores.map(v=>[v.rep,v.nombre+' ('+v.rep+')']),'','— ninguno —'); $('#pt-add').classList.add('on');
}
(function(){
  const cerrar=()=>$('#pt-add').classList.remove('on'); $('#pt-add-x').onclick=$('#pt-a-cancel').onclick=cerrar;
  $('#pt-a-save').onclick=()=>{
    const p=PT.D.plan, c=PT.ctxSup[p.supCod]||{vendedores:[]}, rep=$('#pt-a-rep').value, v=c.vendedores.find(x=>x.rep===rep);
    if(!$('#pt-a-tit').value.trim()){toast('Describe la actividad.');return;}
    const act={actId:null,fecha:$('#pt-a-fecha').value,horaIni:$('#pt-a-hi').value||null,horaFin:$('#pt-a-hf').value||null,tipo:$('#pt-a-tipo').value,titulo:$('#pt-a-tit').value.trim(),repCodigo:rep||null,repNombre:v?v.nombre:null,prioridad:'M',peso:0,fijo:false,origen:'extra'};
    ptPost('/plan/actividad',{planId:p.planId,act}).then(j=>{ if(!j||!j.ok){toast(ptErr(j));return;} toast('Actividad agregada (extra)'); cerrar(); ptAbrir(p.planId); });
  };
})();

/* Cierre semanal */
function ptCierre(){
  const D=PT.D,m=D.plan.metricas; const l=m.logroPct;
  $('#pt-cie-res').innerHTML='<div class="sub" style="margin-bottom:4px">El cierre lo hace el supervisor el viernes; si no se cierra, el plan queda «Sin cerrar».</div><div>Logro actual: <b style="color:'+ptColLogro(l)+'">'+(l==null?'—':l+'%')+'</b> ('+escA(m.nivel)+') · '+m.realizadas+' realizadas · '+m.parciales+' parciales · <b>'+m.pendientes+' pendientes</b> · '+m.noRealizadas+' no realizadas'+(m.pendientes?'<div class="sub" style="color:var(--bad)">Las actividades pendientes cuentan como 0%. Regístralas o márcalas como no realizadas/reprogramadas antes de cerrar.</div>':'')+'</div>';
  ['#pt-c-log','#pt-c-apr','#pt-c-com'].forEach(s=>$(s).value=''); $('#pt-cie').classList.add('on');
}
(function(){
  const cerrar=()=>$('#pt-cie').classList.remove('on'); $('#pt-cie-x').onclick=$('#pt-c-cancel').onclick=cerrar;
  $('#pt-c-save').onclick=()=>{ const id=PT.D.plan.planId; $('#pt-c-save').disabled=true;
    ptPost('/plan/cerrar',{id,logros:$('#pt-c-log').value.trim(),aprendizajes:$('#pt-c-apr').value.trim(),compromisos:$('#pt-c-com').value.trim()}).then(j=>{ $('#pt-c-save').disabled=false; if(!j||!j.ok){toast(ptErr(j));return;}
      toast('Plan cerrado · logro final '+(j.logroPct!=null?j.logroPct+'%':'—')); cerrar(); ptAbrir(id); setTimeout(()=>{ if(confirm('Plan cerrado. ¿Abrir el reporte de cierre?'))ptVerReporte(id,'cierre'); },300); }).catch(e=>{$('#pt-c-save').disabled=false;toast('Error: '+e);}); };
})();

/* ───────── Reportes: catálogo + informes del plan ───────── */
const PT_CAT=[
  {ic:'🗂',t:'Plan de trabajo',d:'Programación semanal del supervisor: agenda por día, por vendedor o ejecutivo.',f:'Agenda por día · Por vendedor · Ejecutivo (1 pág.)',acc:()=>ptRepAbrir('plan')},
  {ic:'📈',t:'Avance del plan',d:'Nivel de logro a la fecha, pendientes y vencidas, estado por día y por tipo de actividad.',f:'Ejecutivo · Detallado por día · Pendientes y vencidas',acc:()=>ptRepAbrir('avance')},
  {ic:'🔒',t:'Cierre del plan',d:'Resultado final de la semana con % de logro, logros, aprendizajes y compromisos.',f:'Cierre completo · Resumen para Gerencia · Mensaje corto (WhatsApp)',acc:()=>ptRepAbrir('cierre')},
  {ic:'📋',t:'Consolidado de planes',d:'Todos los planes del periodo con su % de logro, por supervisor.',f:'Tabla comparativa + promedio por supervisor',acc:()=>ptRepAbrir('consol')},
  {ic:'💰',t:'Cobros del día',d:'Estado y alertas de cobros por vendedor, con cortes 9:50 / 11:50 / 15:30.',f:'Ya disponible en Cobros del día → Reportes',acc:()=>{ptGoTab('cobros');setTimeout(()=>{const b=$('#view-cobros .subtabs button[data-cv=reportes]');if(b)b.click();},50);}},
  {ic:'📊',t:'Supervisión dinámica',d:'Historial por rango con IEGT, calle e Índice Global; resumen por supervisor/centro.',f:'Detallado · Resumido · PDF · Excel',acc:()=>ptRepSub('hist')},
  {ic:'🚗',t:'Supervisión de calle',d:'Resultado de las evaluaciones de calle por supervisor, vendedor y factor.',f:'Se obtiene en Análisis (agrupar por Tipo / Supervisor)',acc:()=>ptGoTab('analisis')},
  {ic:'🤝',t:'Acompañamientos',d:'Acompañamientos realizados y su calificación por vendedor.',f:'Análisis → agrupar por Tipo = Acompañamiento',acc:()=>ptGoTab('analisis')},
  {ic:'🔎',t:'Auditorías',d:'Auditorías de ruta realizadas y hallazgos.',f:'Análisis → agrupar por Tipo = Auditoría',acc:()=>ptGoTab('analisis')},
  {ic:'✅',t:'Compromisos realizados',d:'Compromisos acordados en las evaluaciones y su detalle.',f:'Detalle en Análisis (vista Detallada). Reporte dedicado: próximamente',acc:()=>ptGoTab('analisis')}
];
function ptGoTab(v){ const b=$('.seg button[data-v='+v+']'); if(b)b.click(); }
function ptRepSub(w){ $('#rg-cat').classList.toggle('hide',w!=='cat'); $('#rg-main').classList.toggle('hide',w!=='hist'); $('#rg-plan').classList.toggle('hide',w!=='plan'); $$('#rg-tabs button').forEach(b=>b.classList.toggle('on',b.dataset.rs===w)); }
function ptRepBootCat(){
  if(PT.R.booted)return; PT.R.booted=true;
  $('#rg-cat').innerHTML='<div class="note"><span>📚</span><div><b>Catálogo de reportes.</b> Elige el informe que necesitas; cada tarjeta indica los formatos disponibles. Los de <b>planes de trabajo</b> se generan aquí mismo (PDF/Excel); los demás te llevan a su pantalla.</div></div><div class="pt-cards">'
    +PT_CAT.map((c,i)=>'<div class="pt-card" data-i="'+i+'"><div style="font-size:22px">'+c.ic+'</div><div class="t">'+escA(c.t)+'</div><div class="d">'+escA(c.d)+'</div><div class="f">📄 '+escA(c.f)+'</div></div>').join('')+'</div>';
  $$('#rg-cat .pt-card').forEach(el=>el.onclick=()=>PT_CAT[+el.dataset.i].acc());
  $$('#rg-tabs button').forEach(b=>b.onclick=()=>ptRepSub(b.dataset.rs));
  $('#rg-plan').innerHTML='<button class="pp-back" id="pt-r-back">← Catálogo de reportes</button><div class="filtros">'
    +'<div class="fl"><label>Informe</label><select id="pt-r-tipo"><option value="plan">🗂 Plan de trabajo</option><option value="avance">📈 Avance del plan</option><option value="cierre">🔒 Cierre del plan</option><option value="consol">📋 Consolidado de planes</option></select></div>'
    +'<div class="fl"><label>Formato</label><select id="pt-r-fmt"></select></div>'
    +'<div class="fl"><label>Supervisor</label><select id="pt-r-sup" style="min-width:190px"></select></div><div class="fl"><label>Desde</label><input type="date" id="pt-r-desde"></div><div class="fl"><label>Hasta</label><input type="date" id="pt-r-hasta"></div>'
    +'<div class="fl" id="pt-r-planwrap"><label>Plan</label><select id="pt-r-plan" style="min-width:260px"></select></div>'
    +'<button class="go" id="pt-r-go">Generar</button><button class="rbtn" id="pt-r-pdf">🖨 PDF</button><button class="rbtn" id="pt-r-xls">📥 Excel</button><button class="rbtn hide" id="pt-r-copy">📋 Copiar mensaje</button></div>'
    +'<div id="pt-r-out"><div class="hint">Elige el plan y presiona <b>Generar</b>.</div></div>';
  const [d,h]=ptRangoDef(); const a=ptD(d);a.setDate(a.getDate()-35); $('#pt-r-desde').value=ptY(a); $('#pt-r-hasta').value=h;
  $('#pt-r-back').onclick=()=>ptRepSub('cat'); $('#pt-r-tipo').onchange=()=>{PT.R.tipo=$('#pt-r-tipo').value;ptRepFmt();ptRepPlanes();};
  $('#pt-r-sup').onchange=ptRepPlanes; $('#pt-r-desde').onchange=ptRepPlanes; $('#pt-r-hasta').onchange=ptRepPlanes; $('#pt-r-go').onclick=ptRepGenerar;
  $('#pt-r-xls').onclick=()=>{ const id=+$('#pt-r-plan').value; if(PT.R.tipo==='consol'||!id){toast('Elige un plan para bajar su Excel.');return;} window.location=BASE+'/apisuperv/plan/excel?id='+id; };
  $('#pt-r-copy').onclick=()=>{ navigator.clipboard.writeText(PT.R.txt).then(()=>toast('Mensaje copiado'),()=>toast('No se pudo copiar')); };
  ptCtx('','','',c=>{ PT.ctx=c; $('#pt-r-sup').innerHTML=ptSel(c.supervisores.map(s=>[s.supcod,s.nombre]),'','Todos'); ptRepFmt(); ptRepPlanes(); });
}
function ptRepAbrir(tipo){ ptRepSub('plan'); $('#pt-r-tipo').value=tipo; PT.R.tipo=tipo; ptRepFmt(); ptRepPlanes(); }
const PT_FMT={plan:[['agenda','Agenda por día'],['vendedor','Por vendedor'],['ejecutivo','Ejecutivo (1 página)']],avance:[['ejecutivo','Ejecutivo'],['dia','Detallado por día'],['pendientes','Pendientes y vencidas']],cierre:[['completo','Cierre completo'],['gerencia','Resumen para Gerencia'],['texto','Mensaje corto (WhatsApp)']],consol:[['tabla','Tabla comparativa']]};
function ptRepFmt(){ const t=$('#pt-r-tipo').value; $('#pt-r-fmt').innerHTML=ptSel(PT_FMT[t],''); $('#pt-r-planwrap').classList.toggle('hide',t==='consol'); }
function ptRepPlanes(){
  const q='?supcod='+encodeURIComponent($('#pt-r-sup').value||'')+'&desde='+$('#pt-r-desde').value+'&hasta='+$('#pt-r-hasta').value;
  api('/plan/lista'+q).then(j=>{ if(!j||!j.ok){$('#pt-r-out').innerHTML='<div class="pt-warn w">'+escA(ptErr(j))+'</div>';return;}
    PT.R.lista=j.planes; let pl=j.planes; if(PT.R.tipo==='avance')pl=pl.filter(p=>p.estatus==='Activo'||p.estatus==='Cerrado'); if(PT.R.tipo==='cierre')pl=pl.filter(p=>p.estatus==='Cerrado');
    const sel=PT.R.pre&&j.planes.some(p=>p.planId===PT.R.pre)?PT.R.pre:'';
    $('#pt-r-plan').innerHTML=ptSel(pl.map(p=>[p.planId,p.numero+' · '+(p.supNombre||p.supCod)+' · '+ptFmtC(p.desde)+'–'+ptFmtC(p.hasta)+' · '+ptEstLbl(p)]),sel,pl.length?'— elige —':'(sin planes para este informe)');
    if(PT.R.pre){ if(sel)$('#pt-r-plan').value=sel; PT.R.pre=null; if(sel&&PT.R.tipo!=='consol')ptRepGenerar(); }
  }).catch(e=>$('#pt-r-out').innerHTML='<div class="pt-warn w">Error: '+escA(e)+'</div>');
}
function ptVerReporte(id,tipo){ ptGoTab('repgen'); setTimeout(()=>{ ptRepBootCat(); PT.R.pre=id; ptRepAbrir(tipo); },30); }
function ptBlk(t,inner){return '<div class="pp-block"><div class="sec-title"><h3>'+t+'</h3></div>'+inner+'</div>';}
function ptKpi(k,v,c){return '<div class="pp-kpi"><div class="k">'+k+'</div><div class="v"'+(c?' style="color:'+c+'"':'')+'>'+v+'</div></div>';}
function ptKpis(p,fin){ const m=p.metricas||{}, l=fin&&p.logroCongelado!=null?p.logroCongelado:m.logroPct;
  return '<div class="pp-resumen">'+ptKpi('% de logro'+(fin?' (final)':''),l==null?'—':l+'%',ptColLogro(l))+ptKpi('Nivel',escA(ptNivelCalc(p)),ptColLogro(fin?l:m.logroAFechaPct))+ptKpi('Logro a la fecha',m.logroAFechaPct==null?'—':m.logroAFechaPct+'%')+ptKpi('Realizadas / Parciales',(m.realizadas||0)+' / '+(m.parciales||0))+ptKpi('Pendientes / Vencidas',(m.pendientes||0)+' / '+(m.vencidas||0))+ptKpi('No realiz. / Reprog.',(m.noRealizadas||0)+' / '+(m.reprogramadas||0))+'</div>'; }
function ptTbl(head,rows){return '<div class="scroller"><table class="pt-tb" style="font-size:12px"><thead><tr>'+head.map(h=>'<th>'+h+'</th>').join('')+'</tr></thead><tbody>'+rows.join('')+'</tbody></table></div>';}
function ptHoraT(a){return escA((a.horaIni||'')+(a.horaFin?'–'+a.horaFin:'')||'—');}
function ptUlt(a){const e=a.ejecuciones||[];return e[e.length-1];}
function ptTablaTipo(D){return ptTbl(['Tipo','Actividades','Realizadas','Parciales','Pendientes','% logro'],D.porTipo.map(x=>{const m=x.metricas;return '<tr><td>'+escA(PT_TNOM[x.clave]||x.clave)+'</td><td>'+m.total+'</td><td>'+m.realizadas+'</td><td>'+m.parciales+'</td><td>'+m.pendientes+'</td><td><b style="color:'+ptColLogro(m.logroPct)+'">'+(m.logroPct==null?'—':m.logroPct+'%')+'</b></td></tr>';}));}
function ptTablaDia(D){return ptTbl(['Día','Actividades','Realizadas','Parciales','Pendientes','% logro'],D.porDia.map(x=>{const m=x.metricas;return '<tr><td>'+escA(ptFmt(x.clave))+'</td><td>'+m.total+'</td><td>'+m.realizadas+'</td><td>'+m.parciales+'</td><td>'+m.pendientes+'</td><td><b style="color:'+ptColLogro(m.logroPct)+'">'+(m.logroPct==null?'—':m.logroPct+'%')+'</b></td></tr>';}));}
function ptRepTexto(D){ const p=D.plan,m=p.metricas,l=p.logroCongelado!=null?p.logroCongelado:m.logroPct;
  return '*CIERRE DEL PLAN DE TRABAJO '+p.numero+(p.cierreTardio?' (cierre tardío)':'')+'*\nSupervisor: '+(p.supNombre||p.supCod)+'\nSemana: '+ptRango(p.desde,p.hasta)+'\n% de logro: *'+(l==null?'—':l+'%')+'* ('+m.nivel+')\nRealizadas '+m.realizadas+' · Parciales '+m.parciales+' · No realizadas '+m.noRealizadas+' · Reprogramadas '+m.reprogramadas+' · Pendientes '+m.pendientes
    +'\n\n*Logros:* '+(p.cierreLogros||'—')+'\n*Aprendizajes:* '+(p.cierreAprendizajes||'—')+'\n*Compromisos próxima semana:* '+(p.cierreCompromisos||'—'); }
function ptRepConstruir(D,tipo,fmt){
  const p=D.plan,acts=D.actividades,dias=[...new Set(acts.map(a=>a.fecha))].sort(); const fin=p.estatus==='Cerrado';
  const titulo={plan:'Plan de Trabajo Semanal',avance:'Avance del Plan de Trabajo',cierre:'Cierre del Plan de Trabajo'}[tipo];
  let b=[];
  if(tipo==='plan'){
    if(fmt==='agenda')dias.forEach(f=>b.push(ptBlk(escA(ptFmt(f)),ptTbl(['Hora','Tipo','Actividad','Vendedor / cliente','Meta','Prio.'],acts.filter(a=>a.fecha===f&&a.estado!=='Cancelada').map(a=>'<tr><td>'+ptHoraT(a)+'</td><td>'+escA(PT_TNOM[a.tipo]||a.tipo)+'</td><td>'+escA(a.titulo)+'</td><td>'+escA(ptQuienTxt(a)||a.cliNombre||'')+(a.modalidad?' <span class="sub">('+escA(ptModTxt(a))+')</span>':'')+'</td><td>'+escA(a.meta||'')+'</td><td>'+escA(a.prioridad)+'</td></tr>')))));
    else if(fmt==='vendedor'){ const g={}; acts.filter(a=>a.estado!=='Cancelada').forEach(a=>{const k=a.repNombre||(a.alcance==='todos'?'👥 Todo el equipo (reuniones colectivas)':a.alcanceNombre)||'(Sin vendedor: cobros y gestión)';(g[k]=g[k]||[]).push(a);});
      Object.keys(g).sort().forEach(k=>b.push(ptBlk(escA(k),ptTbl(['Fecha','Hora','Actividad','Meta'],g[k].map(a=>'<tr><td>'+escA(ptFmtC(a.fecha))+'</td><td>'+ptHoraT(a)+'</td><td>'+escA(a.titulo)+'</td><td>'+escA(a.meta||'')+'</td></tr>'))))); }
    else { b.push(ptBlk('Resumen del plan',ptTablaTipo(D))); b.push(ptBlk('Distribución por día',ptTablaDia(D))); }
  } else if(tipo==='avance'){
    b.push(ptKpis(p,false).replace(/^/,'<div class="pp-block">')+'</div>');
    if(fmt==='ejecutivo'){ b.push(ptBlk('Avance por tipo de actividad',ptTablaTipo(D))); b.push(ptBlk('Avance por día',ptTablaDia(D))); }
    else if(fmt==='dia')dias.forEach(f=>b.push(ptBlk(escA(ptFmt(f)),ptTbl(['Hora','Actividad','Estado','Trabajo realizado','Resultado'],acts.filter(a=>a.fecha===f).map(a=>{const u=ptUlt(a);return '<tr><td>'+ptHoraT(a)+'</td><td>'+escA(a.titulo)+'</td><td>'+escA(a.estado)+'</td><td>'+escA(u?u.trabajo||'':'')+'</td><td>'+escA(u?u.resultado||'':'')+'</td></tr>';})))));
    else { const hoy=ptY(new Date()); const pend=acts.filter(a=>a.origen==='plan'&&['Pendiente','No realizada','Reprogramada'].includes(a.estado));
      b.push(ptBlk('Pendientes, no realizadas y reprogramadas ('+pend.length+')',pend.length?ptTbl(['Fecha','Hora','Actividad','Con quién','Estado','Situación'],pend.map(a=>'<tr><td>'+escA(ptFmtC(a.fecha))+'</td><td>'+ptHoraT(a)+'</td><td>'+escA(a.titulo)+'</td><td>'+escA(ptQuienTxt(a))+'</td><td>'+escA(a.estado)+'</td><td>'+(a.estado==='Pendiente'&&a.fecha<hoy?'<b style="color:#C0392B">Vencida</b>':a.fecha<hoy?'Revisar':'En fecha')+'</td></tr>')):'<div class="hint">✅ No hay actividades pendientes.</div>')); }
  } else {
    if(!fin)b.push('<div class="pp-block"><div class="hint" style="color:#C0392B">⚠️ Este plan aún no está cerrado: el % de logro mostrado es el actual (no definitivo).</div></div>');
    b.push('<div class="pp-block">'+ptKpis(p,fin)+'</div>');
    if(fmt==='texto')return {texto:ptRepTexto(D)};
    b.push(ptBlk('Cierre de la semana','<div style="font-size:13px;line-height:1.6"><p><b>Logros:</b> '+escA(p.cierreLogros||'—')+'</p><p><b>Aprendizajes:</b> '+escA(p.cierreAprendizajes||'—')+'</p><p><b>Compromisos próxima semana:</b> '+escA(p.cierreCompromisos||'—')+'</p></div>'));
    b.push(ptBlk('Resultado por tipo de actividad',ptTablaTipo(D)));
    if(fmt==='completo'){ b.push(ptBlk('Resultado por día',ptTablaDia(D)));
      b.push(ptBlk('Trabajo realizado y resultados',ptTbl(['Fecha','Actividad','Estado','Atendió a','Trabajo realizado','Resultado'],acts.flatMap(a=>(a.ejecuciones||[]).map(e=>'<tr><td>'+escA(ptFmtC(e.fechaRealizada))+'</td><td>'+escA(a.titulo)+'</td><td>'+escA(e.estado)+'</td><td>'+escA([e.repAtendidoNombre,e.cliNombre].filter(Boolean).join(' · '))+'</td><td>'+escA(e.trabajo||'')+'</td><td>'+escA(e.resultado||'')+'</td></tr>')))));
    }
  }
  const sub=escA((p.supNombre||p.supCod)+' · '+ptRango(p.desde,p.hasta)+' · '+p.numero+' · '+ptEstLbl(p)+(p.cierreTardio?' (cierre tardío)':'')+(p.aprobadoPor?' · aprobó '+p.aprobadoPor:'')+(p.objetivo?' · Objetivo: '+p.objetivo:''));
  return {html:'<div class="pp-report" id="pt-rep"><div class="pp-band"><div class="rt">'+titulo+'</div><div class="rs">'+sub+'</div></div><div class="bd">'+b.join('')+'</div><div class="pp-foot">Generado el '+new Date().toLocaleString('es-DO')+' · <b>Supervisión Dinámica</b></div></div>',titulo,numero:p.numero};
}
function ptRepGenerar(){
  const tipo=$('#pt-r-tipo').value, fmt=$('#pt-r-fmt').value, out=$('#pt-r-out'); $('#pt-r-copy').classList.add('hide');
  if(tipo==='consol'){
    const pl=PT.R.lista; if(!pl.length){out.innerHTML='<div class="hint">No hay planes en ese rango.</div>';return;}
    const por={}; pl.filter(p=>p.estatus==='Activo'||p.estatus==='Cerrado').forEach(p=>{const l=ptLogroPlan(p); if(l==null)return; (por[p.supNombre||p.supCod]=por[p.supNombre||p.supCod]||[]).push(l);});
    const prom=Object.keys(por).sort().map(k=>'<tr><td>'+escA(k)+'</td><td>'+por[k].length+'</td><td><b style="color:'+ptColLogro(por[k].reduce((s,x)=>s+x,0)/por[k].length)+'">'+(Math.round(por[k].reduce((s,x)=>s+x,0)/por[k].length*10)/10)+'%</b></td></tr>');
    const rows=pl.map(p=>{const m=p.metricas||{},l=ptLogroPlan(p);return '<tr><td>'+escA(p.numero)+'</td><td>'+escA(p.supNombre||p.supCod)+'</td><td>'+escA(ptFmtC(p.desde)+' – '+ptFmtC(p.hasta))+'</td><td>'+escA(ptEstLbl(p))+(p.cierreTardio?' (tardío)':'')+'</td><td>'+escA(p.aprobadoPor||'—')+'</td><td>'+(m.realizadas||0)+' / '+(m.total||0)+'</td><td><b style="color:'+ptColLogro(l)+'">'+(l==null?'—':l+'%')+'</b></td><td>'+escA(m.nivel||'')+'</td></tr>';});
    out.innerHTML='<div class="pp-report" id="pt-rep"><div class="pp-band"><div class="rt">Consolidado de Planes de Trabajo</div><div class="rs">'+escA(ptFmtC($('#pt-r-desde').value)+' – '+ptFmtC($('#pt-r-hasta').value))+'</div></div><div class="bd">'+ptBlk('Planes del periodo',ptTbl(['Plan','Supervisor','Semana','Estatus','Aprobó','Realizadas / total','% logro','Nivel'],rows))+ptBlk('Promedio de logro por supervisor (planes activos o cerrados)',ptTbl(['Supervisor','Planes','Logro promedio'],prom))+'</div><div class="pp-foot">Generado el '+new Date().toLocaleString('es-DO')+'</div></div>';
    PT.R.titulo='consolidado_planes'; return;
  }
  const id=+$('#pt-r-plan').value; if(!id){toast('Elige el plan.');return;}
  out.innerHTML='<div class="hint">Generando…</div>';
  api('/plan/detalle?id='+id).then(j=>{ if(!j||!j.ok){out.innerHTML='<div class="pt-warn w">'+escA(ptErr(j))+'</div>';return;}
    const r=ptRepConstruir(j,tipo,fmt);
    if(r.texto){ PT.R.txt=r.texto; out.innerHTML='<div class="pt-pre">'+escA(r.texto)+'</div>'; $('#pt-r-copy').classList.remove('hide'); return; }
    out.innerHTML=r.html; PT.R.titulo=(tipo+'_'+r.numero).toLowerCase();
  }).catch(e=>{out.innerHTML='<div class="pt-warn w">Error: '+escA(e)+'</div>';});
}
function ptRepPdf(){
  if(!$('#pt-rep')){toast('Primero genera el informe.');return;}
  ppExportarPDF({containerSel:'#pt-rep',botonIds:['pt-r-pdf'],footerTxt:'Plan de Trabajo · Supervisión Dinámica',filename:(PT.R.titulo||'plan_de_trabajo')+'.pdf',jpeg:true});
}
document.addEventListener('click',ev=>{ if(ev.target&&ev.target.id==='pt-r-pdf')ptRepPdf(); });
</script>
