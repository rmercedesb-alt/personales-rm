</div></div>

<script>
/* ═══ Plan de Trabajo semanal — front ═══ */
const PT={ctx:null, ctxSup:{}, W:null, L:{sup:'',desde:'',hasta:'',estatus:''}, D:null, lista:[], booted:false, R:{booted:false,tipo:'plan',lista:[],pre:null,txt:''}, impFile:null, ejeAct:null};
const PT_DIAS=['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'], PT_MES=['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
const PT_TIPOS=[['calle','🚗 Calle'],['virtual','🖥 Telemática'],['cobros','💰 Cobros'],['reunion','👥 Reunión'],['gestion','🗂 Gestión'],['capacitacion','🎓 Capacitación'],['otro','• Otro']];
const PT_TNOM=Object.fromEntries(PT_TIPOS.map(t=>[t[0],t[1]]));
const PT_OPC={equilibrado:'Primero los vendedores prioritarios y, después, los de menor AMCO-GT de la semana anterior; desempata quien lleva más tiempo sin acompañamiento (2 por día de calle).',
  riesgo:'Dedica la calle a los vendedores en riesgo: los prioritarios y los de AMCO-GT menor a 70 (2 visitas a cada uno en la semana); luego completa con los demás por prioridad y AMCO-GT.',
  cobertura:'Rota por TODO el equipo: 3 visitas más cortas por día de calle, empezando por quien lleva más tiempo sin acompañamiento.',
  blanco:'Solo las actividades fijas (cobros, reuniones); tú agregas el resto.'};
function ptD(s){const p=String(s).split('-');return new Date(+p[0],+p[1]-1,+p[2]);}
function ptY(d){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}
function ptFmt(s){const d=ptD(s);return PT_DIAS[d.getDay()]+' '+d.getDate()+' '+PT_MES[d.getMonth()];}
function ptFmtC(s){const d=ptD(s);return PT_DIAS[d.getDay()].slice(0,3)+' '+d.getDate()+'/'+(d.getMonth()+1);}
function ptRango(a,b){return ptFmt(a)+' al '+ptFmt(b);}
function ptPost(p,b){return api(p,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)});}
function ptSel(opts,val,vac){return (vac!=null?'<option value="">'+vac+'</option>':'')+opts.map(o=>'<option value="'+escA(o[0])+'"'+(String(o[0])===String(val)?' selected':'')+'>'+escA(o[1])+'</option>').join('');}
function ptRangoDef(){const h=new Date();h.setHours(0,0,0,0);let dow=h.getDay();let lun=new Date(h);
  if(dow===0)lun.setDate(h.getDate()+1);else if(dow>=5)lun.setDate(h.getDate()+(8-dow));else lun.setDate(h.getDate()-(dow-1));
  const sab=new Date(lun);sab.setDate(lun.getDate()+5);return [ptY(lun),ptY(sab)];}
function ptColLogro(n){return n==null?'#6b7280':n>=90?'#2E9E4A':n>=75?'#3357C4':n>=50?'#D29922':'#C0392B';}
function ptNivelCalc(p){ const m=p.metricas||{}; if(p.estatus==='Cerrado')return m.nivel||''; const a=m.logroAFechaPct; if(a==null)return 'En curso (aún sin actividades vencidas)'; return a>=90?'Excelente':a>=75?'En ruta':a>=50?'Atrasado':'Crítico'; }
function ptBar(p){const v=p==null?0:Math.max(0,Math.min(100,p));return '<div class="pt-bar"><i style="width:'+v+'%;background:'+ptColLogro(p)+'"></i></div>';}
function ptEstCls(e){return String(e).replace(/ /g,'');}
function ptEstLbl(p){return p.sinCerrar?'Sin cerrar':p.estatus;}
function ptEstChip(p){return '<span class="pt-chip '+ptEstCls(ptEstLbl(p))+'">'+escA(ptEstLbl(p))+'</span>'+(p.cierreTardio?' <span class="pt-chip Tardio">cierre tardío</span>':'');}
const PT_MOD={presencial:'🏢 Presencial',virtual:'💻 Virtual',llamada:'📞 Llamada colectiva'};
function ptQuienVal(a){return a.alcance==='todos'?'todos':a.alcance==='grupo'?'grupo:'+a.alcanceCod:a.alcance==='division'?'division:'+a.alcanceCod:(a.repCodigo?'vend:'+a.repCodigo:'');}
function ptQuienSet(a,v){
  const c=PT.ctx; a.alcance=null; a.alcanceCod=null; a.alcanceNombre=null; a.repCodigo=''; a.repNombre='';
  if(v==='todos'){a.alcance='todos';a.alcanceNombre='Todo el equipo';}
  else if(v.startsWith('grupo:')){const cod=v.slice(6),g=(c.grupos||[]).find(x=>x.cod===cod);a.alcance='grupo';a.alcanceCod=cod;a.alcanceNombre='Grupo '+(g?g.etiqueta:cod);}
  else if(v.startsWith('division:')){const cod=v.slice(9);a.alcance='division';a.alcanceCod=cod;a.alcanceNombre='División '+cod;}
  else if(v.startsWith('vend:')){const cod=v.slice(5),x=c.vendedores.find(y=>y.rep===cod);a.alcance='vendedor';a.repCodigo=cod;a.repNombre=x?x.nombre:'';}
}
function ptQuienHtml(sel){
  const c=PT.ctx, o=(v,t)=>'<option value="'+escA(v)+'"'+(v===sel?' selected':'')+'>'+escA(t)+'</option>';
  let h='<option value="">— sin vendedor —</option>'+o('todos','👥 Todo el equipo ('+c.vendedores.length+')');
  if(c.grupos&&c.grupos.length)h+='<optgroup label="Grupos">'+c.grupos.map(g=>o('grupo:'+g.cod,'Grupo '+g.etiqueta+' ('+g.vendedores+')')).join('')+'</optgroup>';
  if(c.divisiones&&c.divisiones.length)h+='<optgroup label="Divisiones">'+c.divisiones.map(d=>o('division:'+d.cod,'División '+d.cod+' ('+d.vendedores+')')).join('')+'</optgroup>';
  return h+'<optgroup label="Vendedores">'+c.vendedores.map(v=>o('vend:'+v.rep,v.nombre+' ('+v.rep+')')).join('')+'</optgroup>';
}
function ptQuienTxt(a){return a.repNombre||a.alcanceNombre||'';}
function ptModTxt(a){return a.modalidad?(PT_MOD[a.modalidad]||''):'';}
/* Confirmación visible (no solo un aviso que desaparece): número del plan + estado + qué sigue */
function ptConfirma(numero,estatus,planId,extra){
  const M={
    'Por aprobar':{i:'📨',t:'Plan enviado a Gerencia',c:'background:var(--warn-bg);color:var(--warn)',e:'POR APROBAR',d:'Tu plan quedó <b>guardado</b> y está <b>esperando la aprobación de Gerencia</b>. Mientras tanto no se puede registrar ejecución; si necesitas cambiarlo, ábrelo y usa «Retirar a borrador». Si Gerencia lo devuelve, verás su comentario en el plan. Búscalo siempre en <b>Plan → ✅ Ejecución del plan</b> con el número de arriba.'},
    'Borrador':{i:'📝',t:'Plan guardado como borrador',c:'background:var(--panel2);color:var(--muted)',e:'BORRADOR — NO ENVIADO',d:'Tu plan quedó guardado pero <b>todavía NO ha sido enviado a Gerencia</b>. Ábrelo y presiona <b>«📨 Enviar a aprobación»</b> cuando esté listo.'},
    'Activo':{i:'✅',t:'Plan aprobado y activo',c:'background:var(--good-bg);color:var(--good)',e:'ACTIVO',d:'El plan está <b>activo</b>: ya se puede registrar su ejecución día a día y cerrarlo el viernes.'}
  }[estatus]||{i:'✅',t:'Plan guardado',c:'',e:estatus,d:''};
  $('#pt-ok-i').textContent=M.i; $('#pt-ok-t').textContent=M.t; $('#pt-ok-n').textContent=numero; $('#pt-ok-e').textContent=M.e; $('#pt-ok-e').setAttribute('style',M.c);
  $('#pt-ok-d').innerHTML=M.d+(extra?'<div style="margin-top:6px">'+extra+'</div>':''); PT.okPlan=planId; $('#pt-ok').classList.add('on'); ptBadge();
}
/* Insignia roja en «Plan» y «Ejecución del plan»: Gerencia = planes por aprobar; supervisor = sus planes por aprobar, en borrador o sin cerrar */
function ptBadge(){
  api('/plan/lista?estatus='+encodeURIComponent('Borrador,Por aprobar,Activo')).then(j=>{
    if(!j||!j.ok)return; const ger=j.rol==='Gerencia', pa=j.planes.filter(p=>p.estatus==='Por aprobar').length, bo=j.planes.filter(p=>p.estatus==='Borrador').length, sc=j.planes.filter(p=>p.sinCerrar).length;
    const n=ger?pa:pa+bo+sc; const tip=ger?pa+' plan(es) esperan tu aprobación':[pa&&pa+' por aprobar (enviados a Gerencia)',bo&&bo+' en borrador sin enviar',sc&&sc+' sin cerrar'].filter(Boolean).join(' · ');
    ['#pt-badge-sub','#pt-badge-seg'].forEach(id=>{ const b=$(id); if(b){ b.textContent=n||''; b.title=tip; } });
  }).catch(()=>{});
}
(function(){
  const mk=(sel,id)=>{ const b=$(sel); if(b&&!$(id)){ const s=document.createElement('span'); s.className='pt-badge'; s.id=id.slice(1); b.appendChild(s); } };
  mk('#view-plan .subtabs button[data-pv=ejec]','#pt-badge-sub'); mk('.seg button[data-v=plan]','#pt-badge-seg');
  setTimeout(ptBadge,1500); setInterval(ptBadge,120000);
  $('#pt-ok-x').onclick=()=>$('#pt-ok').classList.remove('on');
  $('#pt-ok-ver').onclick=()=>{ $('#pt-ok').classList.remove('on'); if(PT.okPlan)ptIrEjec(PT.okPlan); };
})();
function ptEsGer(){return !!(PT.ctx&&PT.ctx.rol==='Gerencia');}
function ptLogroPlan(p){return p.estatus==='Cerrado'&&p.logroCongelado!=null?p.logroCongelado:(p.metricas?p.metricas.logroPct:null);}
function ptErr(j){return (j&&j.error)||'Error desconocido';}
function ptCtx(sup,desde,hasta,cb){
  const q='?supcod='+encodeURIComponent(sup||'')+(desde?'&desde='+desde:'')+(hasta?'&hasta='+hasta:'');
  api('/plan/contexto'+q).then(j=>{ if(!j||!j.ok){toast(ptErr(j));return;} cb(j); }).catch(e=>toast('Error: '+e));
}

