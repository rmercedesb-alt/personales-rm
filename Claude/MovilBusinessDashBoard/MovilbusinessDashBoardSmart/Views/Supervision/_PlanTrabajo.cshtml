    if(add){ PT.W.acts.push(ptWNueva(add.dataset.add,{tipo:(PT.ctx.dias.find(d=>d.fecha===add.dataset.add)||{}).calle?'calle':'virtual',horaIni:'',horaFin:''})); ptWRender(); }
    if(del){ const a=PT.W.acts.find(x=>String(x._k)===del.dataset.del); if(a&&a.fijo&&!confirm('Es una actividad fija del plan (cobros/reunión). ¿Quitarla de todos modos?'))return; PT.W.acts=PT.W.acts.filter(x=>String(x._k)!==del.dataset.del); ptWRender(); } });
  $('#pt-wiz-x').onclick=$('#pt-w-cancel').onclick=()=>{ if(PT.W&&PT.W.acts.length&&!confirm('¿Cerrar sin guardar los cambios?'))return; $('#pt-wiz').classList.remove('on'); };
  $('#pt-w-gen').onclick=()=>ptWGenerar(false);
  $('#pt-w-opc').onchange=()=>{ $('#pt-w-opdesc').textContent=PT_OPC[$('#pt-w-opc').value]; };
  const recargar=()=>{ const W=PT.W; W.sup=$('#pt-w-sup').value; W.desde=$('#pt-w-desde').value; W.hasta=$('#pt-w-hasta').value; if(!W.desde||!W.hasta||W.hasta<W.desde)return;
