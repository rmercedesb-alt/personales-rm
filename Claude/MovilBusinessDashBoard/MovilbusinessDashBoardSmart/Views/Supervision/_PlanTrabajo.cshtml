function ptNuevo(planId){
  const W=PT.W={planId:planId||null,sup:'',desde:'',hasta:'',objetivo:'',opcion:'equilibrado',estatus:'Borrador',acts:[],_k:1};
  $('#pt-wiz').classList.add('on'); $('#pt-wiz-aviso').innerHTML=''; $('#pt-w-grid').innerHTML='<div class="hint">Cargando…</div>'; $('#pt-w-warn').innerHTML='';
  $('#pt-wiz-t').textContent=planId?'✏️ Editar plan de trabajo':'🗂 Crear Plan de Trabajo semanal';
  ['#pt-w-sup','#pt-w-opc'].forEach(s=>$(s).disabled=!!planId); $('#pt-w-gen').classList.toggle('hide',!!planId); $('#pt-w-opc').parentNode.classList.toggle('hide',!!planId); $('#pt-w-opdesc').classList.toggle('hide',!!planId);
  $('#pt-w-up').classList.toggle('hide',!!planId);
  if(planId){
    api('/plan/detalle?id='+planId).then(j=>{ if(!j||!j.ok){toast(ptErr(j));$('#pt-wiz').classList.remove('on');return;}
      const p=j.plan; W.sup=p.supCod; W.desde=p.desde; W.hasta=p.hasta; W.objetivo=p.objetivo||''; W.opcion=p.opcion||'equilibrado'; W.estatus=p.estatus;
      W.acts=j.actividades.map(a=>({_k:W._k++,actId:a.actId,fecha:a.fecha,horaIni:a.horaIni||'',horaFin:a.horaFin||'',tipo:a.tipo,subtipo:a.subtipo,titulo:a.titulo,detalle:a.detalle,repCodigo:a.repCodigo||'',repNombre:a.repNombre||'',modalidad:a.modalidad||'',alcance:a.alcance||null,alcanceCod:a.alcanceCod||null,alcanceNombre:a.alcanceNombre||null,cliId:a.cliId,cliNombre:a.cliNombre,meta:a.meta||'',prioridad:a.prioridad,peso:a.peso,fijo:a.fijo,origen:a.origen,estado:a.estado}));
      $('#pt-w-desde').value=W.desde; $('#pt-w-hasta').value=W.hasta; $('#pt-w-obj').value=W.objetivo;
      ptCtx(W.sup,W.desde,W.hasta,c=>{PT.ctx=c; ptWSupSel(); ptWBotones(); ptWRender(); ptWComentario(p);});
    }).catch(e=>toast('Error: '+e));
    return;
  }
  const [d,h]=ptRangoDef(); W.desde=d; W.hasta=h; $('#pt-w-desde').value=d; $('#pt-w-hasta').value=h; $('#pt-w-obj').value=''; $('#pt-w-opc').value='equilibrado';
  $('#pt-w-opdesc').textContent=PT_OPC.equilibrado;
  ptCtx('',d,h,c=>{PT.ctx=c; W.sup=c.supcod; ptWSupSel(); ptWBotones(); ptWAvisos(); ptWGenerar(true);});
}
/* Botones según rol y estado: el supervisor arma y ENVÍA; Gerencia ajusta y APRUEBA. */
function ptWBotones(){
  const W=PT.W, ger=ptEsGer(), d=$('#pt-w-draft'), sv=$('#pt-w-save'); d.classList.remove('hide');
  if(ger){
    if(W.estatus==='Activo'){ d.classList.add('hide'); sv.textContent='💾 Guardar cambios'; W.tDraft='Activo'; W.tSave='Activo'; }
    else if(W.estatus==='Por aprobar'){ d.textContent='💾 Guardar cambios'; sv.textContent='✅ Guardar y aprobar'; W.tDraft='Por aprobar'; W.tSave='Activo'; }
    else { d.textContent='💾 Guardar borrador'; sv.textContent='✅ Guardar y aprobar'; W.tDraft='Borrador'; W.tSave='Activo'; }
  } else { d.textContent='💾 Guardar borrador'; sv.textContent='📨 Enviar a aprobación'; W.tDraft='Borrador'; W.tSave='Por aprobar'; }
}
function ptWComentario(p){
