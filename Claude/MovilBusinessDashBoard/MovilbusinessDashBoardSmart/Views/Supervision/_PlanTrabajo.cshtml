<!-- ═══════════════════════════════════════════════════════════════════════════
     PLAN DE TRABAJO SEMANAL DEL SUPERVISOR (2026-10-10)
     Supervisión Dinámica → Plan → «Crear Plan de Trabajo semanal» + «Ejecución del plan»
     y Reportes → catálogo + informes del plan (plan / avance / cierre / consolidado).
     Backend: Controllers/ApiSupervisionPlanController.cs (/apisuperv/plan/…) · Tablas: SQL/SupervisionPlanTrabajo_RM.sql
     Este parcial se incluye al final de Index.cshtml: usa $, $$, api, toast, escA, BASE, ppExportarPDF.
     ═══════════════════════════════════════════════════════════════════════════ -->
<style>
.pt-box{max-width:1180px}
.pt-hd{display:flex;gap:10px;align-items:center;justify-content:space-between;margin-bottom:8px}
.pt-hd h3{margin:0}
.pt-rec{border:1px solid var(--warn);background:var(--warn-bg);border-radius:11px;padding:10px 13px;font-size:12.5px;margin:6px 0 10px;line-height:1.6}
.pt-rec b{color:var(--text)}
.pt-day{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:14px 0 4px;padding:8px 12px;border-radius:10px;background:var(--panel2);border:1px solid var(--border)}
.pt-day .nm{font-weight:800;font-size:13.5px}
.pt-chip{display:inline-flex;font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;white-space:nowrap}
.pt-chip.calle{background:var(--calle-bg);color:var(--calle)}.pt-chip.virtual{background:var(--virt-bg);color:var(--virt)}.pt-chip.cobros{background:var(--good-bg);color:var(--good)}
.pt-chip.reunion{background:var(--audit-bg);color:var(--audit)}.pt-chip.gestion,.pt-chip.capacitacion,.pt-chip.otro,.pt-chip.libre{background:var(--panel2);color:var(--muted);border:1px solid var(--border)}
.pt-chip.Realizada{background:var(--good-bg);color:var(--good)}.pt-chip.Parcial{background:var(--warn-bg);color:var(--warn)}.pt-chip.Pendiente{background:var(--panel2);color:var(--muted);border:1px solid var(--border)}
.pt-chip.Norealizada{background:var(--bad-bg);color:var(--bad)}.pt-chip.Reprogramada{background:var(--virt-bg);color:var(--virt)}.pt-chip.Cancelada{background:var(--panel2);color:var(--muted);text-decoration:line-through}
.pt-chip.Borrador{background:var(--panel2);color:var(--muted);border:1px solid var(--border)}.pt-chip.Poraprobar{background:var(--warn-bg);color:var(--warn)}.pt-chip.Sincerrar{background:var(--bad-bg);color:var(--bad)}.pt-chip.Tardio{background:var(--warn-bg);color:var(--warn)}.pt-chip.Activo{background:var(--virt-bg);color:var(--virt)}.pt-chip.Cerrado{background:var(--good-bg);color:var(--good)}
.pt-tb{width:100%;font-size:12.5px}
.pt-tb td,.pt-tb th{padding:5px 6px;text-align:left;white-space:normal;vertical-align:middle}
.pt-tb input,.pt-tb select{width:100%;font-size:12.5px;padding:5px 6px;border-radius:6px;background:var(--panel);border:1px solid var(--border);color:var(--text);font-family:inherit}
.pt-tb input[type=time]{width:92px}.pt-tb input[type=number]{width:62px}
.pt-tb tr.fijo td{background:var(--panel2)}
.pt-tb .x{border:0;background:transparent;cursor:pointer;font-size:14px}
.pt-warn{margin-top:12px;border-radius:11px;padding:10px 13px;font-size:12.5px;line-height:1.55;border:1px solid var(--border);background:var(--panel2)}
.pt-warn.w{border-color:var(--warn);background:var(--warn-bg)}.pt-warn.ok{border-color:var(--good);background:var(--good-bg)}
.pt-foot{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:14px;padding-top:12px;border-top:1px solid var(--border)}
.pt-foot .sp{flex:1}
.pt-bar{height:8px;border-radius:6px;background:var(--panel2);border:1px solid var(--border);min-width:90px;overflow:hidden}
.pt-bar i{display:block;height:100%}
.pt-lt tr{cursor:pointer}.pt-lt tr:hover td{background:var(--panel2)}
.pt-ex tr.row{cursor:pointer}.pt-ex tr.row:hover td{background:var(--panel2)}
.pt-ex td,.pt-ex th{white-space:normal;text-align:left;vertical-align:top}
.pt-fri{border:1px solid var(--bad);background:var(--bad-bg);border-radius:11px;padding:10px 13px;font-size:13px;margin:10px 0}
.pt-f2{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}@@media(max-width:700px){.pt-f2{grid-template-columns:1fr}}
.pt-f2 .full{grid-column:1/-1}
.pt-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:12px;margin:10px 0 14px}
.pt-card{border:1px solid var(--border);background:var(--panel);border-radius:13px;padding:14px 15px;cursor:pointer;display:flex;flex-direction:column;gap:6px}
.pt-card:hover{border-color:var(--accent2)}
.pt-card .t{font-weight:800;font-size:14px}.pt-card .d{font-size:12px;color:var(--muted)}.pt-card .f{font-size:11px;color:var(--muted)}
.pt-card.soon{opacity:.6;cursor:default}
#view-plan.pt-ejec-on>.schemebar,#view-plan.pt-ejec-on>.note,#view-plan.pt-ejec-on>.filtros{display:none}
.pt-badge{display:inline-block;background:var(--bad);color:#fff;border-radius:999px;font-size:10px;font-weight:800;padding:1px 7px;margin-left:6px;vertical-align:middle}
.pt-badge:empty{display:none}
.pt-ok .big{font-size:44px;line-height:1}.pt-ok .num{font-size:30px;font-weight:800;color:var(--accent);margin:6px 0 2px;letter-spacing:.02em}
.pt-ok .est{display:inline-block;font-size:12px;font-weight:800;border-radius:999px;padding:4px 14px;margin:4px 0 10px}
.pt-hist{font-size:12px;border-left:3px solid var(--border);padding:2px 0 2px 9px;margin:6px 0}
.pt-pre{white-space:pre-wrap;font-family:Consolas,monospace;font-size:12.5px;background:var(--panel2);border:1px solid var(--border);border-radius:10px;padding:12px}
</style>

