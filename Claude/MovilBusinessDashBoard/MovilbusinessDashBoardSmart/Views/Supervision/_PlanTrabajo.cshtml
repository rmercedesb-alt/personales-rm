/* ───────── Carga desde Excel ───────── */
function ptImpEnviar(file,confirmar){
  const fd=new FormData(); fd.append('archivo',file);
  return fetch(BASE+'/apisuperv/plan/importar?confirmar='+confirmar,{method:'POST',body:fd}).then(r=>r.json());
}
function ptImpPreview(file){
  PT.impFile=file; $('#pt-imp').classList.add('on'); $('#pt-imp-ok').disabled=true; $('#pt-imp-body').innerHTML='<div class="hint">Validando «'+escA(file.name)+'»…</div>';
  ptImpEnviar(file,0).then(j=>{
    if(!j||(!j.errores&&!j.ok)){ $('#pt-imp-body').innerHTML='<div class="pt-warn w">'+escA(ptErr(j))+'</div>'; return; }
    const r=j.resumen||{}; let h='<div class="kpis" style="grid-template-columns:repeat(4,1fr)"><div class="panel kpi"><div class="k">Actividades</div><div class="v">'+(r.actividades||0)+'</div></div><div class="panel kpi"><div class="k">De calle</div><div class="v">'+(r.calle||0)+'</div></div><div class="panel kpi"><div class="k">Telemáticas</div><div class="v">'+(r.virtualesN||0)+'</div></div><div class="panel kpi"><div class="k">Ya ejecutadas</div><div class="v">'+(r.ejecutadas||0)+'</div></div></div>';
    h+='<div class="hint" style="text-align:left;padding:0 0 8px">Supervisor <b>'+escA(r.supervisor||'')+'</b> · '+escA(r.desde||'')+' al '+escA(r.hasta||'')+' · el plan se creará como <b>'+escA(r.estatus||'Activo')+'</b>.</div>';
    if(j.errores&&j.errores.length)h+='<div class="pt-warn w"><b>Corrige estos puntos en el Excel y vuelve a cargarlo:</b><ul style="margin:6px 0 0 18px">'+j.errores.slice(0,60).map(e=>'<li>'+escA(e)+'</li>').join('')+'</ul></div>';
    if(j.filas&&j.filas.length)h+='<div class="scroller" style="max-height:34vh;margin-top:10px"><table class="pt-tb"><thead><tr><th>Fila</th><th>Fecha</th><th>Hora</th><th>Tipo</th><th>Actividad</th><th>Vend.</th><th>Estado</th></tr></thead><tbody>'+j.filas.slice(0,80).map(f=>'<tr><td>'+f.fila+'</td><td>'+escA(f.fecha)+'</td><td>'+escA((f.horaIni||'')+(f.horaFin?'–'+f.horaFin:''))+'</td><td>'+escA(f.tipo)+'</td><td>'+escA(f.titulo)+'</td><td>'+escA(f.rep||'')+'</td><td>'+escA(f.estado)+'</td></tr>').join('')+'</tbody></table></div>';
    $('#pt-imp-body').innerHTML=h; $('#pt-imp-ok').disabled=!j.ok;
  }).catch(e=>{ $('#pt-imp-body').innerHTML='<div class="pt-warn w">Error: '+escA(e)+'</div>'; });
