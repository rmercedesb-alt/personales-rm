}
function ptWAvisosLista(){
  const W=PT.W,c=PT.ctx,av=[]; if(!c)return av;
  c.dias.forEach(d=>{
    const as=W.acts.filter(a=>a.fecha===d.fecha), nm=ptFmt(d.fecha);
    if(d.tipo==='libre'&&as.length)return;
    if(d.calle){
      if(!as.some(a=>a.tipo==='calle'))av.push('🚗 '+nm+' es día de <b>CALLE</b> y no tiene actividades de calle: protégelo.');
      if(as.some(a=>a.tipo==='virtual'&&!a.fijo))av.push('🚗 '+nm+' es día de calle y hay actividades telemáticas: ¿seguro? Protege el día de calle.');
    } else if(d.tipo==='virtual'){
      if(!as.some(a=>a.tipo==='virtual'))av.push('🖥 '+nm+' es día de <b>SUPERVISIÓN TELEMÁTICA</b> y no tiene actividades telemáticas: protégelo.');
      if(as.some(a=>a.tipo==='calle'))av.push('🖥 '+nm+' es día telemático y hay actividades de calle: ¿seguro? Protege el día telemático.');
    }
    if(d.dow>=1&&d.dow<=6){ const co=as.find(a=>a.tipo==='cobros'); if(!co)av.push('💰 '+nm+': falta «cobros dinámicos» (inician 3:30 pm).'); else if(co.horaIni&&co.horaIni<'15:30')av.push('💰 '+nm+': los cobros dinámicos inician a las 3:30 pm (hoy '+co.horaIni+').'); }
    if(d.dow>=1&&d.dow<=5&&!as.some(a=>a.tipo==='reunion'&&a.horaIni==='07:30'))av.push('🌅 '+nm+': falta la reunión matinal (7:30 – 7:55 am).');
    if(d.dow>=1&&d.dow<=5&&!as.some(a=>a.tipo==='reunion'&&a.horaIni>='17:00'))av.push('👥 '+nm+': falta la reunión de seguimiento de las 5:30 pm.');
    if(d.dow===6&&!as.some(a=>a.tipo==='reunion'&&a.horaIni>='08:00'))av.push('🏢 '+nm+': falta la reunión con Gerencia.');
    const ord=as.filter(a=>a.horaIni&&a.horaFin).sort((a,b)=>a.horaIni.localeCompare(b.horaIni));
    for(let i=1;i<ord.length;i++) if(ord[i].horaIni<ord[i-1].horaFin)av.push('⏱ '+nm+': se traslapan «'+escA(ord[i-1].titulo)+'» y «'+escA(ord[i].titulo)+'».');
  });
  W.acts.forEach(a=>{ if(a.horaIni&&a.horaFin&&a.horaFin<=a.horaIni)av.push('⏱ «'+escA(a.titulo)+'» ('+ptFmtC(a.fecha)+'): la hora fin no es posterior al inicio.'); if(!String(a.titulo).trim())av.push('📝 Hay una actividad ('+ptFmtC(a.fecha)+') sin descripción.'); });
  const asig=new Set(); W.acts.filter(a=>a.estado!=='Cancelada').forEach(a=>{ if(a.repCodigo)asig.add(a.repCodigo); else if(a.alcance==='grupo')c.vendedores.filter(v=>v.grupo===a.alcanceCod).forEach(v=>asig.add(v.rep)); else if(a.alcance==='division')c.vendedores.filter(v=>v.division===a.alcanceCod).forEach(v=>asig.add(v.rep)); }); const sin=c.vendedores.filter(v=>!asig.has(v.rep));
  if(sin.length&&sin.length<=12&&W.acts.length)av.push('👤 Vendedores sin ninguna actividad dirigida en el plan: '+sin.map(v=>escA(v.nombre)).join(', ')+'.');
  else if(sin.length>12&&W.acts.length)av.push('👤 '+sin.length+' de '+c.vendedores.length+' vendedores sin ninguna actividad dirigida en el plan.');
  return av;
}
function ptWWarn(){
  const av=ptWAvisosLista(), n=PT.W.acts.length;
  const peso=PT.W.acts.filter(a=>a.origen!=='extra').reduce((s,a)=>s+(+a.peso||0),0);
  $('#pt-w-warn').innerHTML='<div class="pt-warn '+(av.length?'w':'ok')+'"><b>'+n+' actividad(es) · peso total '+peso+'</b>'+(av.length?' — revisa estos puntos antes de guardar:<ul style="margin:6px 0 0 18px">'+av.map(x=>'<li>'+x+'</li>').join('')+'</ul>':' — ✅ el plan protege los días de calle y telemáticos y respeta cobros y reuniones.')+'</div>';
}
function ptWGuardar(estObj){
  const W=PT.W; W.desde=$('#pt-w-desde').value; W.hasta=$('#pt-w-hasta').value; W.objetivo=$('#pt-w-obj').value.trim(); W.sup=$('#pt-w-sup').value||W.sup;
  if(!W.sup){toast('Elige el supervisor.');return;} if(!W.desde||!W.hasta||W.hasta<W.desde){toast('Revisa el rango de fechas.');return;}
  if(!W.acts.length){toast('El plan no tiene actividades.');return;}
  const sinTit=W.acts.find(a=>!String(a.titulo).trim()); if(sinTit){toast('Toda actividad necesita una descripción.');return;}
  const av=ptWAvisosLista(); if(av.length&&!confirm('El plan tiene '+av.length+' aviso(s):\n\n'+av.map(x=>'• '+x.replace(/<[^>]+>/g,'')).join('\n')+'\n\n¿Guardar de todos modos?'))return;
  const body={planId:W.planId,supCod:W.sup,desde:W.desde,hasta:W.hasta,objetivo:W.objetivo,opcion:W.opcion,estatus:estObj,origen:'linea',
    actividades:W.acts.map((a,i)=>({actId:a.actId||null,fecha:a.fecha,horaIni:a.horaIni||null,horaFin:a.horaFin||null,tipo:a.tipo,subtipo:a.subtipo||null,titulo:String(a.titulo).trim(),detalle:a.detalle||null,repCodigo:a.repCodigo||null,repNombre:a.repNombre||null,modalidad:a.modalidad||null,alcance:a.alcance||(a.repCodigo?'vendedor':null),alcanceCod:a.alcanceCod||null,alcanceNombre:a.alcanceNombre||null,cliId:a.cliId||null,cliNombre:a.cliNombre||null,meta:a.meta||null,prioridad:a.prioridad||'M',peso:+a.peso||0,fijo:!!a.fijo,origen:a.origen||'plan',orden:i+1}))};
  ['#pt-w-save','#pt-w-draft'].forEach(s=>$(s).disabled=true);
  ptPost('/plan/guardar',body).then(j=>{ ['#pt-w-save','#pt-w-draft'].forEach(s=>$(s).disabled=false);
    if(!j||!j.ok){ const m='No se guardó el plan: '+ptErr(j); toast(m); $('#pt-w-warn').insertAdjacentHTML('afterbegin','<div class="pt-warn w" style="border-color:var(--bad);background:var(--bad-bg)">❌ <b>'+escA(m)+'</b></div>'); alert(m); return; }
    $('#pt-wiz').classList.remove('on'); ptIrEjec(j.planId); ptConfirma(j.numero,j.estatus,j.planId);
  }).catch(e=>{ ['#pt-w-save','#pt-w-draft'].forEach(s=>$(s).disabled=false); toast('Error: '+e); alert('No se guardó el plan (error de conexión o del servidor): '+e); });
}
(function(){
  const g=$('#pt-w-grid');
  g.addEventListener('input',ptWEdit); g.addEventListener('change',ptWEdit);
  function ptWEdit(ev){ const el=ev.target, f=el.dataset&&el.dataset.f; if(!f)return; const tr=el.closest('tr'); const a=PT.W.acts.find(x=>String(x._k)===tr.dataset.k); if(!a)return;
