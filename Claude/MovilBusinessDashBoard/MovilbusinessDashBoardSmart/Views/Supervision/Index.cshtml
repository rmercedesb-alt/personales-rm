function rcHtmlHallazgo(h,tipo){ // tipo: 'pos' | 'opp'
  const col=tipo==='pos'?'#1f8b4c':'#b8860b', ic=tipo==='pos'?'✅':'⚠️';
  return '<div style="padding:7px 10px;margin:4px 0;border-left:4px solid '+col+';background:'+(tipo==='pos'?'rgba(31,139,76,.07)':'rgba(184,134,11,.09)')+';font-size:13px">'+ic+' '+h.txt+'</div>';
}
function rcBloqueHallazgos(H){
  const seccion=(titulo,x)=>{
    let h='<div style="margin:10px 0 2px;font-weight:700;font-size:13px">'+titulo+'</div>';
    if(!x) return h+'<div style="font-size:12px;color:#57606a">Sin datos suficientes para este punto.</div>';
    x.pos.forEach(p=>h+=rcHtmlHallazgo(p,'pos'));
