@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Supervisión Dinámica &mdash; @ViewBag.EmpNombre</title>
<style>
/* ── Tema claro de marca (2026-09-03) — reemplaza el tema oscuro genérico que tenía
   esta vista. Mismos tokens/valores que Views/Presupuestos/Index.cshtml (ya aprobado por
   el usuario) para que todo el sistema comparta literalmente la misma paleta — Torre de
   Control queda como única excepción, a propósito, en su tema oscuro. Este cambio también
   resuelve el bug reportado de tablas ilegibles (negro sobre negro) en los reportes de
   PDF Presentaciones, que heredaban var(--panel2) del tema oscuro anterior. */
:root{
  --bg:#F7F9F7;--panel:#FFFFFF;--panel2:#F0F4F0;--border:#D9E2D9;--line:#E6ECE6;
  --text:#1F2A22;--muted:#5C6B5F;--accent:#283078;--accent2:#3357C4;
  --calle:#C9660D;--calle-bg:#FBEEE0;--virt:#3357C4;--virt-bg:#EAEFFB;--audit:#6C3FC4;--audit-bg:#F1EAFB;
  --good:#2E9E4A;--warn:#D29922;--bad:#C0392B;--good-bg:#EAF7EE;--warn-bg:#FBF3DA;--bad-bg:#FBEAEA;
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:'Segoe UI',Tahoma,sans-serif;font-variant-numeric:tabular-nums;line-height:1.5}
.wrap{max-width:1120px;margin:0 auto;padding:16px 16px 60px}
a{color:var(--accent2)}
.top{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;margin-bottom:14px}
.brand{display:flex;gap:12px;align-items:center}
.logo{width:42px;height:42px;border-radius:11px;display:grid;place-items:center;font-size:21px;background:linear-gradient(140deg,var(--calle-bg),var(--audit-bg),var(--virt-bg));border:1px solid var(--border)}
.title{font-size:22px;font-weight:800;letter-spacing:-.02em}
.sub{font-size:12px;color:var(--muted)}
.top .btn,.btn-out{background:var(--panel2);border:1px solid var(--border);color:var(--muted);border-radius:7px;padding:7px 13px;font-size:12px;text-decoration:none;cursor:pointer}
.btn-out:hover{border-color:var(--accent2);color:var(--accent2)}
.who{font-size:12px;color:var(--muted)}
.rolchip{font-size:11px;font-weight:700;border-radius:999px;padding:3px 10px;background:var(--virt-bg);color:var(--virt)}
.seg{display:inline-flex;background:var(--panel2);border:1px solid var(--border);border-radius:12px;padding:4px;gap:2px;flex-wrap:wrap;margin-bottom:14px}
.seg button{border:0;background:transparent;color:var(--muted);font:inherit;font-weight:600;font-size:13px;padding:8px 13px;border-radius:9px;cursor:pointer;display:flex;gap:6px;align-items:center}
.seg button.on{background:var(--panel);color:var(--text)}
.view{display:none}.view.on{display:block}
.panel{background:var(--panel);border:1px solid var(--border);border-radius:13px}
.hint{font-size:12px;color:var(--muted);padding:18px;text-align:center}
.hide{display:none}
.schemebar{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:6px 0 16px}
.scheme{padding:13px 15px;border-radius:12px;border:1px solid var(--border)}
.scheme .pct{font-size:24px;font-weight:800}.scheme .nm{font-weight:700;font-size:13px;margin-top:2px}.scheme .ds{font-size:11px;color:var(--muted)}
.scheme.iegt{background:var(--virt-bg)}.scheme.iegt .pct{color:var(--virt)}
.scheme.acomp{background:var(--calle-bg)}.scheme.acomp .pct{color:var(--calle)}
.scheme.audit{background:var(--audit-bg)}.scheme.audit .pct{color:var(--audit)}
@@media(max-width:640px){.schemebar{grid-template-columns:1fr}}
.scroller{overflow-x:auto;border:1px solid var(--border);border-radius:13px}
table{width:100%;border-collapse:collapse;font-size:13px}
th,td{padding:9px 11px;border-bottom:1px solid var(--line);text-align:right;white-space:nowrap}
th{background:var(--panel2);font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);position:sticky;top:0}
td.l,th.l{text-align:left}
tr.clk{cursor:pointer}tr.clk:hover td{background:var(--panel2)}
tr.totrow td{border-top:2px solid var(--border);font-weight:800;background:var(--panel2)}
.band{display:inline-flex;font-weight:700;font-size:11px;padding:3px 9px;border-radius:999px}
.band.Solida{color:var(--good);background:var(--good-bg)}
.band.Aceptable,.band.Irregular{color:var(--warn);background:var(--warn-bg)}
.band.Deficiente{color:var(--bad);background:var(--bad-bg)}
.trend.up{color:var(--good);font-weight:800}.trend.down{color:var(--bad);font-weight:800}.trend.eq{color:var(--muted)}
.filtros{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;margin:6px 0 14px}
.fl{display:flex;flex-direction:column;gap:4px}
.fl label{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}
select,input[type=date],input[type=text]{background:var(--panel);border:1px solid var(--border);border-radius:8px;color:var(--text);font:inherit;font-size:13px;padding:8px 10px}
.go{background:var(--accent);color:#fff;border:0;border-radius:8px;font-weight:700;padding:9px 15px;cursor:pointer}
.note{display:flex;gap:10px;padding:12px 14px;border-radius:11px;background:var(--panel2);border:1px solid var(--border);font-size:13px;color:var(--muted);margin-bottom:14px}
.note b{color:var(--text)}
.note.calle{border-color:var(--calle)}.note.virt{border-color:var(--virt)}
/* phone */
.phonewrap{display:flex;justify-content:center}
.phone{width:100%;max-width:410px;background:var(--panel);border:1px solid var(--border);border-radius:26px;padding:11px}
.screen{background:var(--bg);border:1px solid var(--border);border-radius:20px;overflow:hidden}
.phead{padding:12px 15px;border-bottom:1px solid var(--line)}
.r1{display:flex;gap:10px;align-items:center}
.repsel{font:inherit;font-weight:800;font-size:14px;background:var(--panel);border:1px solid var(--border);border-radius:9px;color:var(--text);padding:6px 8px;flex:1;min-width:0}
.timer{text-align:right}.timer .lbl{font-size:9px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);font-weight:700}.timer .tt{font-weight:800;font-size:15px}
.submode{display:flex;gap:6px;margin-top:11px}
.submode button{flex:1;border:1px solid var(--border);background:var(--panel);border-radius:10px;padding:9px 0;font-weight:700;font-size:12.5px;cursor:pointer;color:var(--muted)}
.submode button.on[data-m=acomp]{background:var(--calle-bg);color:var(--calle);border-color:transparent}
.submode button.on[data-m=audit]{background:var(--audit-bg);color:var(--audit);border-color:transparent}
.trow{display:flex;gap:8px;margin-top:10px}
.tbtn{flex:1;text-align:center;border:1px solid var(--border);background:var(--panel);border-radius:10px;padding:9px 0;font-weight:700;font-size:13px;cursor:pointer;color:var(--text)}
.tbtn.gob{background:var(--good-bg);color:var(--good);border-color:transparent}.tbtn.stop{background:var(--bad-bg);color:var(--bad);border-color:transparent}
.clockline{font-size:11px;color:var(--muted);margin-top:8px}
.suprow{display:flex;align-items:center;gap:8px;padding:11px 15px 0}
.suplbl{font-size:11px;font-weight:700;color:var(--muted)}
.supchip{border:1px solid var(--border);background:var(--panel);border-radius:999px;padding:5px 12px;font-size:12px;font-weight:700;color:var(--text);cursor:pointer}
.suppanel{display:none;padding:4px 15px 0}.suppanel.on{display:block}
.suppanel .opt{display:flex;gap:9px;align-items:center;padding:7px 10px;font-size:13px;border:1px solid var(--border);border-radius:8px;margin-top:6px;cursor:pointer;background:var(--panel)}
.cbar{display:flex;gap:6px;overflow-x:auto;padding:11px 15px 4px;align-items:center}
.cchip{flex:none;display:inline-flex;align-items:center;gap:6px;border:1px solid var(--border);background:var(--panel);border-radius:999px;padding:6px 8px 6px 12px;font-size:12px;font-weight:700;color:var(--muted);cursor:pointer;white-space:nowrap;max-width:170px}
.cchip .nm{overflow:hidden;text-overflow:ellipsis;max-width:120px}
.cchip.on{background:var(--calle-bg);color:var(--calle);border-color:transparent}
.cchip.cons.on{background:var(--virt-bg);color:var(--virt)}
.cchip .x{opacity:.6;width:16px;height:16px;display:grid;place-items:center;border-radius:50%}
.addc{flex:none;border:1px dashed var(--border);background:transparent;color:var(--accent2);border-radius:999px;padding:6px 12px;font-size:12px;font-weight:800;cursor:pointer}
.csearch{display:none;padding:6px 15px 4px}.csearch.on{display:block}
.csearch input{width:100%}
.cres{margin-top:6px;max-height:180px;overflow:auto;border:1px solid var(--border);border-radius:10px}
.cres .r{display:flex;gap:8px;align-items:center;padding:9px 12px;border-bottom:1px solid var(--line);cursor:pointer;font-size:13px}
.cres .r:hover{background:var(--panel2)}.cres .cod{font-size:11px;font-weight:800;color:var(--muted);background:var(--panel2);border-radius:6px;padding:2px 7px}
.consbadge{font-size:11px;color:var(--muted);margin:2px 15px}
.pbody{padding:4px 15px 6px;max-height:460px;overflow-y:auto}
.grouphd{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;margin:12px 0 2px;padding-top:8px;border-top:1px dashed var(--border)}
.grouphd.ac{color:var(--calle)}.grouphd.au{color:var(--audit)}
.step{padding:11px 0;border-bottom:1px solid var(--line)}
.step .st{display:flex;gap:8px;align-items:baseline}
.step .sn{font-weight:700;font-size:13px}
.step .w{font-size:10px;font-weight:800;color:var(--muted);background:var(--panel2);border-radius:999px;padding:2px 7px;margin-left:auto}
.step .kf{font-size:10px;font-weight:800;border-radius:999px;padding:2px 7px}
.kf.paso{color:var(--calle);background:var(--calle-bg)}.kf.gest{color:var(--virt);background:var(--virt-bg)}.kf.aud{color:var(--audit);background:var(--audit-bg)}
.step .desc{font-size:11px;color:var(--muted);margin:3px 0 8px}
.srow{display:flex;gap:12px;align-items:center}
input[type=range]{flex:1;-webkit-appearance:none;height:6px;border-radius:6px;background:var(--panel2)}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:20px;height:20px;border-radius:50%;background:var(--accent);border:3px solid var(--panel);cursor:pointer}
.sval{width:48px;text-align:right;font-weight:800;font-size:14px}
.sino{display:flex;gap:6px;flex:1}
.sino button{flex:1;border:1px solid var(--border);background:var(--panel);border-radius:8px;padding:8px 0;font-weight:700;font-size:13px;cursor:pointer;color:var(--muted)}
.sino button.on{background:var(--good-bg);color:var(--good);border-color:transparent}.sino button.on.no{background:var(--bad-bg);color:var(--bad)}
.stars{display:flex;gap:3px;align-items:center}
.star{font-size:23px;line-height:1;cursor:pointer;color:var(--border);transition:transform .08s}
.star.on{color:#E3B341}
.star:hover{transform:scale(1.15)}
.starlbl{font-size:12px;font-weight:800;margin-left:8px;white-space:nowrap}
.starsm{color:#E3B341;letter-spacing:1px;font-size:15px}
.barmini{height:6px;border-radius:4px;background:var(--panel2);overflow:hidden;flex:1}.barmini i{display:block;height:100%}
.photo{margin:11px 0 2px;padding:11px;border:1px dashed var(--border);border-radius:11px;background:var(--panel2);display:flex;gap:11px;align-items:center}
.cam{border:0;background:var(--calle);color:#fff;font-weight:700;font-size:13px;padding:9px 13px;border-radius:9px;cursor:pointer;white-space:nowrap}
.thumb{width:56px;height:56px;border-radius:9px;object-fit:cover;border:1px solid var(--border)}
.thumbgrid{display:flex;gap:8px;flex-wrap:wrap;margin-top:6px}
.field{margin:10px 15px 0}
.field label{display:block;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:5px}
textarea{width:100%;background:var(--panel);border:1px solid var(--border);border-radius:10px;color:var(--text);font:inherit;font-size:13px;padding:9px 11px;resize:vertical}
.scorebar{position:sticky;bottom:0;background:var(--panel);border-top:1px solid var(--border);padding:12px 15px;display:flex;gap:12px;align-items:center;margin-top:10px}
.scorebar .big{font-size:28px;font-weight:800}.scorebar .of{font-size:12px;color:var(--muted)}
.finbtn{margin-left:auto;border:0;background:var(--accent);color:#fff;font-weight:700;font-size:13px;padding:11px 15px;border-radius:10px;cursor:pointer}
.empty{padding:30px 18px;text-align:center;color:var(--muted);font-size:13px}
/* virtual */
.vhead{display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:space-between;margin:12px 0}
.progress{flex:1;min-width:200px;height:10px;border-radius:6px;background:var(--panel2);overflow:hidden;border:1px solid var(--border)}.progress i{display:block;height:100%;background:var(--virt)}
.vrow{display:flex;flex-wrap:wrap;gap:11px;align-items:center;padding:12px 14px;border-bottom:1px solid var(--line)}
.vn{font-weight:700;min-width:150px}.vn .m{font-size:11px;color:var(--muted);font-weight:400}
.done{color:var(--good);font-weight:700;font-size:13px}
.vbtn{border:1px solid var(--border);background:var(--panel);color:var(--text);font-weight:700;font-size:12px;padding:7px 12px;border-radius:9px;cursor:pointer}
.vbtn.pri{background:var(--virt);color:#fff;border-color:transparent}
.cform{width:100%;display:none;gap:10px;flex-wrap:wrap;margin-top:6px;padding:12px;background:var(--panel2);border:1px solid var(--border);border-radius:10px}.cform.on{display:flex}
.cform .fg{flex:1;min-width:150px}.cform .fg.full{flex:1 1 100%}
.cform label{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);display:block;margin-bottom:4px}
.cform select,.cform input,.cform textarea{width:100%}
.alertbox{width:100%;background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:10px 12px}
.alertbox .hd{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:8px}
.alerts{display:flex;flex-wrap:wrap;gap:7px}
.alert{font-size:11px;font-weight:700;padding:5px 10px;border-radius:8px;display:flex;flex-direction:column;gap:2px}
.alert.s3{color:var(--bad);background:var(--bad-bg)}.alert.s2{color:var(--warn);background:var(--warn-bg)}.alert.s1{color:var(--virt);background:var(--virt-bg)}.alert.clean{color:var(--good);background:var(--good-bg)}
.atime{font-weight:600;font-size:10px;opacity:.8}
/* report */
.report{padding:22px 24px}
.rhead{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;border-bottom:2px solid var(--border);padding-bottom:14px;margin-bottom:16px}
.rhead .co{font-weight:800;font-size:15px}.rhead .doc{font-size:12px;color:var(--muted)}
.rhead .rt{font-size:13px;font-weight:800;color:var(--accent2);text-align:right}
.meta{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:16px}
@@media(max-width:640px){.meta{grid-template-columns:repeat(2,1fr)}.report{padding:16px}}
.meta .k{font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);font-weight:700}.meta .v{font-weight:700;font-size:14px;margin-top:2px}
.globalbox{display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between;background:linear-gradient(120deg,var(--virt-bg),var(--calle-bg));border:1px solid var(--border);border-radius:12px;padding:15px 17px;margin-top:6px}
.globalbox .gi{font-size:32px;font-weight:800}.globalbox .brk{font-size:12px;color:var(--muted)}.globalbox .brk b{color:var(--text)}
.rbox{font-size:13px;color:var(--muted);background:var(--panel2);border:1px solid var(--border);border-radius:10px;padding:11px 13px;margin-top:4px}
.sigrow{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:20px}@@media(max-width:640px){.sigrow{grid-template-columns:1fr}}
.sigcap{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;font-weight:700;font-size:13px}
.clr{font-size:11px;color:var(--accent2);cursor:pointer;font-weight:700;background:none;border:0}
.pad{border:1px dashed var(--border);border-radius:11px;background:var(--panel2);touch-action:none;display:block;width:100%;height:120px;cursor:crosshair}
.sigline{border-top:1px solid var(--border);margin-top:8px;padding-top:6px;font-size:11px;color:var(--muted);text-align:center}
.ractions{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}
.rbtn{border:1px solid var(--border);background:var(--panel);color:var(--text);font-weight:700;font-size:13px;padding:10px 15px;border-radius:10px;cursor:pointer}
.rbtn.primary{background:var(--accent);color:#fff;border-color:transparent}
.sec-title{display:flex;gap:9px;align-items:center;margin:18px 0 8px;flex-wrap:wrap}.sec-title h3{font-size:14px;font-weight:800}.sec-title .n{font-size:11px;color:var(--muted)}
.kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin:14px 0}@@media(max-width:760px){.kpis{grid-template-columns:repeat(2,1fr)}}
.kpi{padding:12px 13px}.kpi .k{font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);font-weight:700}.kpi .v{font-size:22px;font-weight:800;margin-top:3px}.kpi .s{font-size:11px;color:var(--muted)}
.chiptipo{font-size:11px;font-weight:800;border-radius:999px;padding:3px 9px}
.chiptipo.acomp{color:var(--calle);background:var(--calle-bg)}.chiptipo.audit{color:var(--audit);background:var(--audit-bg)}.chiptipo.virt{color:var(--virt);background:var(--virt-bg)}
.tlrow{display:flex;gap:11px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}
.tlrow .dt{font-weight:700;font-size:13px;min-width:110px}
.verbtn{border:1px solid var(--border);background:var(--panel);color:var(--accent2);border-radius:8px;font-weight:700;font-size:12px;padding:6px 11px;cursor:pointer;margin-left:auto}
.wt input[type=number]{width:74px;text-align:right;font-weight:700;background:var(--panel);border:1px solid var(--border);border-radius:8px;color:var(--text);padding:7px 9px}
.wsum{display:flex;gap:10px;align-items:center;margin-top:12px;font-weight:700}
.badgeok{color:var(--good);background:var(--good-bg);padding:3px 10px;border-radius:999px;font-size:12px}
.badgebad{color:var(--bad);background:var(--bad-bg);padding:3px 10px;border-radius:999px;font-size:12px}
.badge{color:var(--warn);background:var(--warn-bg);padding:3px 10px;border-radius:999px;font-size:12px}
.n{font-size:11px;color:var(--muted)}
.stick{position:sticky;left:0;background:var(--panel);z-index:2}
tr:hover .stick{background:var(--panel2)}
thead th.stick{z-index:5;background:var(--panel2)}
.divchips{display:flex;gap:6px;flex-wrap:wrap}
.divchips label{display:inline-flex;gap:6px;align-items:center;font-size:12px;border:1px solid var(--border);border-radius:8px;padding:7px 10px;cursor:pointer;background:var(--panel);font-weight:600}
.divchips input{accent-color:var(--accent);width:15px;height:15px}
.prio{font-size:10px;font-weight:800;color:var(--bad);background:var(--bad-bg);border-radius:999px;padding:2px 7px;margin-left:6px}
.worked{font-size:11px;font-weight:700;color:var(--good)}
.ms{position:relative;display:inline-block}
.ms-chip{background:var(--panel);border:1px solid var(--border);border-radius:8px;color:var(--text);font:inherit;font-size:13px;padding:8px 10px;cursor:pointer;min-width:150px;text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:230px}
.ms-panel{display:none;position:absolute;z-index:40;top:calc(100% + 4px);left:0;min-width:220px;max-width:300px;background:var(--panel);border:1px solid var(--border);border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.5);padding:6px}
.ms-panel.on{display:block}
.ms-search{width:100%;background:var(--bg);border:1px solid var(--border);border-radius:7px;color:var(--text);font:inherit;font-size:13px;padding:7px 9px;margin-bottom:4px}
.ms-list{max-height:240px;overflow:auto}
.ms-opt{display:flex;gap:8px;align-items:center;padding:7px 8px;border-radius:7px;cursor:pointer;font-size:13px}
.ms-opt:hover{background:var(--panel2)}
.ms-all{border-bottom:1px solid var(--line);color:var(--muted);margin-bottom:2px;font-weight:700}
.ms-ck{width:16px;text-align:center}
#repSel{display:block;flex:1;min-width:0}#repSel .ms-chip{width:100%;max-width:none;font-weight:800}
@@page{margin:12mm 12.7mm}
@@media print{
  .top,.seg,.note,.filtros,.schemebar{display:none!important}
  body{background:#fff;color:#000}.wrap{max-width:none}
  .panel,.scroller{border:0!important;box-shadow:none}
  table{font-size:11px}th{background:#eee!important;color:#000!important}
  td,th{border-color:#ccc!important}.stick{position:static;background:#fff!important}
  .view{display:none!important}.view.on{display:block!important}
}
.subtabs{display:inline-flex;gap:2px;background:var(--panel2);border:1px solid var(--border);border-radius:10px;padding:3px}
.subtabs button{border:0;background:transparent;color:var(--muted);font:inherit;font-weight:600;font-size:12.5px;padding:6px 12px;border-radius:8px;cursor:pointer}
.subtabs button.on{background:var(--panel);color:var(--text)}

/* ── PDF Presentaciones (Supervisión Dinámica → Informes Gerenciales) ──────
   Colores de marca (--pp-azul/--pp-verde/--pp-verde2) muestreados en vivo del
   logo de la empresa (Empresa.EmpLogo) el 2026-08-30 — pedido explícito del
   usuario: "una línea de colores que sean las del logo de la empresa" como
   encabezado del informe. */
:root{--pp-azul:#1c2f6e;--pp-verde:#2f7d3f;--pp-verde2:#4f9a5c}
.pp-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin:16px 0}
@@media(max-width:900px){.pp-grid{grid-template-columns:repeat(2,1fr)}}
.pp-card{background:var(--panel2);border:1px solid var(--border);border-radius:13px;padding:20px 16px;display:flex;flex-direction:column;align-items:center;gap:10px;cursor:pointer;text-align:center;position:relative;overflow:hidden;transition:.15s}
.pp-card::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,var(--pp-azul),var(--pp-verde2))}
.pp-card:hover{border-color:var(--accent2);background:#1c2432;transform:translateY(-2px)}
.pp-card.soon{cursor:default;opacity:.55}
.pp-card.soon:hover{transform:none;border-color:var(--border);background:var(--panel2)}
.pp-card .ic{font-size:32px;line-height:1}
.pp-card .tt{font-weight:700;font-size:13.5px}
.pp-card .dd{font-size:11px;color:var(--muted);line-height:1.4}
.pp-soon-badge{font-size:9.5px;font-weight:700;letter-spacing:.4px;color:var(--muted);background:var(--panel);border:1px solid var(--border);border-radius:999px;padding:2px 9px}
.pp-back{font-size:12px;color:var(--accent2);cursor:pointer;display:inline-flex;gap:5px;align-items:center;margin-bottom:12px;background:none;border:0;font:inherit}
.pp-back:hover{text-decoration:underline}
.pp-list{display:flex;flex-direction:column;gap:10px;margin-top:14px}
.pp-item{display:flex;align-items:center;gap:12px;padding:14px 16px;background:var(--panel2);border:1px solid var(--border);border-radius:12px;cursor:pointer}
.pp-item:hover{border-color:var(--accent2)}
.pp-item.soon{cursor:default;opacity:.55}
.pp-item .ic{font-size:22px}
.pp-item .tt{font-weight:700;font-size:13.5px;flex:1}
.pp-band{border-radius:13px 13px 0 0;padding:22px 24px;background:linear-gradient(115deg,var(--pp-azul) 0%,var(--pp-verde) 55%,var(--pp-verde2) 100%);color:#fff}
.pp-band .rt{font-size:19px;font-weight:800}
.pp-band .rs{font-size:12px;opacity:.9;margin-top:3px}
.pp-report{background:var(--panel);border:1px solid var(--border);border-radius:13px;overflow:hidden}
.pp-report .bd{padding:20px 24px}
.pp-resumen{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:6px 0 20px}
@@media(max-width:640px){.pp-resumen{grid-template-columns:1fr}}
.pp-kpi{padding:16px;border-radius:11px;background:var(--panel2);border:1px solid var(--border);text-align:center}
.pp-kpi .k{font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);font-weight:700}
.pp-kpi .v{font-size:24px;font-weight:800;margin-top:5px}
.pp-foot{padding:16px 24px;border-top:1px solid var(--border);font-size:12px;color:var(--muted)}
.pp-foot b{color:var(--text)}
.pp-hist-row{display:flex;gap:12px;align-items:center;padding:11px 14px;border-bottom:1px solid var(--line);font-size:12.5px}
.pp-hist-row:last-child{border-bottom:0}
/* El informe se ve/imprime en claro (para enviar por correo/imprimir), aunque el
   resto de la app esté en tema oscuro — mismo criterio que @@media print del módulo. */
.pp-report{background:#fff;color:#1b1f24;border-color:#d8dde3}
.pp-report .sec-title h3{color:#1b1f24}
.pp-report .sec-title .n{color:#57606a}
.pp-report table{color:#1b1f24}
.pp-report th{background:#f3f5f7;color:#57606a;position:static}
.pp-report td{border-bottom:1px solid #e8ebef}
.pp-report tr.totrow td{background:#f3f5f7;border-top:2px solid #d8dde3}
.pp-report .scroller{border-color:#d8dde3}
.pp-report .pp-kpi{background:#f6f8fa;border-color:#e1e4e8}
.pp-report .pp-kpi .k{color:#57606a}
.pp-report .pp-kpi .v{color:#1b1f24}
.pp-report .pp-block{margin-bottom:18px}
.pp-report .pp-block:last-child{margin-bottom:0}
/* Reunión Gerencial (2026-10-05) — textos editables, gráficas y semáforos */
.rg-ed{border-radius:6px;padding:2px 4px;margin:0 -4px;outline:1px dashed transparent;transition:outline-color .15s}
.rg-ed:hover{outline-color:#b6c2d1;cursor:text}
.rg-ed:focus{outline:2px solid var(--pp-verde,#0C9444);background:#f6fbf7}
.rg-cap{font-size:12.5px;color:#3a3a3a;line-height:1.5;margin:8px 0 4px}
.rg-cap b.l{color:#0C9444}
.rg-intro{font-size:13px;color:#57606a;line-height:1.55;margin:0 0 12px}
.rg-g2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@@media(max-width:760px){.rg-g2{grid-template-columns:1fr}}
.rg-graf{position:relative;height:260px}
.rg-graf.alto{height:320px}
.rg-dot{display:inline-block;width:10px;height:10px;border-radius:50%;vertical-align:middle;margin-right:5px}
.rg-dot.G{background:#1E8449}.rg-dot.Y{background:#E1A100}.rg-dot.R{background:#C0392B}
.rg-dot.click{cursor:pointer;width:13px;height:13px}
.rg-h2{font-size:16px;font-weight:800;color:#1b1f24;margin:0 0 6px;padding-bottom:6px;border-bottom:3px solid #0C9444}
.rg-h2.azul{border-color:#203F99}
.rg-sub{font-size:13px;font-weight:800;margin:14px 0 8px}
.rg-warn{background:#fff7e0;border:1px solid #f0d58a;color:#7a5b00;border-radius:9px;padding:9px 12px;font-size:12.5px;margin-bottom:12px}
.rg-acc td{vertical-align:top;white-space:normal;line-height:1.4}
.rg-acc td:nth-child(2),.rg-acc td:nth-child(3){min-width:240px}
.rg-acc td[contenteditable]{min-width:60px}
.cd-cal-head{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;font-size:10px;font-weight:800;color:#57606a;text-align:center;margin-bottom:4px}
.cd-cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
.cd-cal-cell{border:1px solid #e1e4e8;border-radius:7px;padding:6px 4px;text-align:center;min-height:52px;background:#fff}
.cd-cal-empty{border:0;background:transparent}
.cd-cal-dia{font-size:10px;color:var(--muted);font-weight:700}
.cd-cal-val{font-size:11px;font-weight:800;color:#1b1f24;margin-top:2px}
.cd-cal-delta{font-size:9px;font-weight:700;margin-top:1px}
.rc-cals{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.cd3 .cd-cal-head{font-size:9px;gap:2px}.cd3 .cd-cal-grid{gap:2px}
.cd3 .cd-cal-cell{padding:3px 1px;min-height:42px;border-radius:5px;min-width:0}.cd3 .cd-cal-dia{font-size:8.5px}.cd3 .cd-cal-val{font-size:9.5px;letter-spacing:-.02em}.cd3 .cd-cal-delta{font-size:8px}
.cd3 .sec-title h4{font-size:12px}
.pp-report tr.rc-hijo td{font-size:11px;color:#46524a}.pp-report tr.rc-hijo td.l{padding-left:22px}
table.crono td,table.crono th{text-align:center}
table.crono td.l,table.crono th.l{text-align:left}
.ctag{display:inline-block;font-size:11px;font-weight:800;border-radius:7px;padding:5px 7px;min-width:72px}
.ctag.presencial{color:var(--calle);background:var(--calle-bg)}
.ctag.auditoria{color:var(--audit);background:var(--audit-bg)}
.ctag.virtual{color:var(--virt);background:var(--virt-bg)}
.prioflag{font-size:9px;font-weight:800;color:var(--bad);background:var(--bad-bg);border-radius:999px;padding:2px 6px;margin-left:6px}
.acomp-hl{outline:2px solid var(--calle);outline-offset:-2px;border-radius:8px}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:60;display:none;align-items:flex-start;justify-content:center;overflow:auto;padding:24px}
.modal.on{display:flex}
.modalbox{background:var(--panel);border:1px solid var(--border);border-radius:14px;max-width:1000px;width:100%;padding:18px 20px}
.modalbox h3{font-size:16px;font-weight:800;margin-bottom:6px}
.cfgsel{background:var(--bg);border:1px solid var(--border);border-radius:7px;color:var(--text);font:inherit;font-size:12px;padding:5px 6px;width:100%}
.cfgsel.presencial{color:var(--calle)}.cfgsel.auditoria{color:var(--audit)}.cfgsel.virtual{color:var(--virt)}
.cadbadge{font-size:11px;font-weight:700;border-radius:999px;padding:2px 8px;margin-left:4px}
.cadbadge.ok{color:var(--good);background:var(--good-bg)}.cadbadge.bad{color:var(--warn);background:var(--warn-bg)}
.toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%) translateY(18px);opacity:0;pointer-events:none;background:var(--text);color:var(--bg);font-weight:600;font-size:13px;padding:11px 17px;border-radius:10px;transition:.25s;z-index:90;max-width:88vw;text-align:center}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
td.stick,th.stick{position:sticky;left:0;background:var(--panel);z-index:1}
th.stick{z-index:3;background:var(--panel2)}
.mtrend{font-size:11px;color:var(--muted)}
.workchip{font-size:11px;font-weight:700;border-radius:999px;padding:2px 8px}
.workchip.si{color:var(--good);background:var(--good-bg)}.workchip.no{color:var(--muted);background:var(--panel2)}
.prcell{font-weight:800}
.printhead{display:none}
@@media print{
  body{background:#fff;color:#000}
  .top,.seg,.filtros,.note,.btn-out,.finbtn,.verbtn,.ractions{display:none!important}
  .view:not(.on){display:none}.panel,.scroller{border:0!important;box-shadow:none}
  th{background:#eee!important;color:#000!important}td,th{border-color:#ccc!important}
  .printhead{display:block;margin-bottom:10px}.printhead .t{font-size:16px;font-weight:800}.printhead .s{font-size:12px;color:#444}
  td.stick,th.stick{position:static}
}
</style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <div class="brand">
      <div class="logo">&#129517;</div>
      <div><div class="title">Supervisión Dinámica</div><div class="sub" id="sub">Acompañamiento · Auditoría · Virtual</div></div>
    </div>
    <div style="display:flex;gap:10px;align-items:center">
      <span class="rolchip" id="rolchip">…</span>
      <span class="who" id="who"></span>
      @if (ViewBag.ShowMenu == true) { <a class="btn-out" href="@(Context.Request.PathBase)/menu">&#8592; Menú</a> }
      <a class="btn-out" href="@(Context.Request.PathBase)/account/logout">Salir</a>
    </div>
  </div>

  <div class="seg">
    <button class="on" data-v="plan">🗓️ Plan</button>
    <button data-v="calle">📍 Calle</button>
    <button data-v="virtual">🖥️ Virtual</button>
    <button data-v="cobros">💰 Cobros del día</button>
    <button data-v="reporte">✍️ Reporte</button>
    <button data-v="repgen">📊 Reportes</button>
    <button data-v="analisis">📈 Análisis</button>
    <button data-v="pdfpres">📑 PDF Presentaciones</button>
    <button data-v="pesos">⚙️ Configuración</button>
  </div>

  <!-- PLAN (priorización dinámica) -->
  <section class="view on" id="view-plan">
    <div class="schemebar" id="schemebar"></div>
    <div class="note"><span>🎯</span><div>Prioriza a quién supervisar: el <b>IEGT del rango</b> (por defecto la <b>última semana completa Lun–Sáb</b>), el resultado de calle, el <b>Índice Global</b> y si ya se trabajó. Orden por <b>peor IEGT</b>; los ya trabajados bajan.</div></div>
    <div class="filtros">
      <div class="fl"><label>Supervisor</label><div id="pl-sup"></div></div>
      <div class="fl"><label>Vendedor</label><div id="pl-ven"></div></div>
      <div class="fl"><label>Desde</label><input type="date" id="pl-desde"></div>
      <div class="fl"><label>Hasta</label><input type="date" id="pl-hasta"></div>
      <div class="fl"><label>División</label><div id="pl-divs"></div></div>
      <div class="fl"><label>Vista</label><select id="pl-vista"><option value="det">Detallado</option><option value="res">Resumido</option></select></div>
      <button class="go" id="pl-go">Generar</button>
      <button class="rbtn" id="pl-pdf">🖨 PDF</button>
      <button class="rbtn" id="pl-xls">📥 Excel</button>
    </div>
    <div style="display:flex;gap:10px;align-items:center;margin-bottom:10px;flex-wrap:wrap">
      <div class="subtabs"><button class="on" data-pv="prio">📋 Priorización</button><button data-pv="crono">🗓️ Cronograma semanal</button><button data-pv="ejec">✅ Ejecución del plan</button></div>
      <button class="rbtn primary" id="pt-new" style="margin-left:auto">🗂 Crear Plan de Trabajo semanal</button>
      <button class="rbtn" id="pl-cfg">⚙ Configurar cronograma</button>
    </div>
    <div id="pl-prio">
      <div class="printhead" id="pl-phead"></div>
      <div class="kpis" id="pl-kpis"></div>
      <div class="scroller" style="max-height:60vh"><table><thead id="pl-thead"></thead><tbody id="pl-tbody"><tr><td class="l">Presiona <b>Generar</b>…</td></tr></tbody></table></div>
    </div>
    <div id="pl-crono" class="hide"></div>
    <div id="pl-ejec" class="hide"></div>
  </section>

  <!-- CALLE -->
  <section class="view" id="view-calle">
    <div class="note calle"><span>📍</span><div>Elige el <b>vendedor</b>, agrega los <b>clientes de su ruta</b> (busca por código o nombre), marca los <b>suplidores</b> y evalúa. Dos modos: <b>Acompañamiento</b> y <b>Auditoría</b>.</div></div>
    <div class="phonewrap"><div class="phone"><div class="screen">
      <div class="phead">
        <div class="r1">
          <div id="repSel" style="flex:1;min-width:0"></div>
          <div class="timer"><div class="lbl">Duración</div><div class="tt" id="tt">00:00</div></div>
        </div>
        <div class="submode" id="submode"><button class="on" data-m="acomp">👤 Acompañamiento</button><button data-m="audit">🔍 Auditoría</button></div>
        <div class="trow"><button class="tbtn gob" id="btnStart">▶ Iniciar</button><button class="tbtn stop" id="btnStop">■ Finalizar</button></div>
        <div class="clockline" id="clock">Acceso: — · Inicio: — · Fin: —</div>
      </div>
      <div class="suprow"><span class="suplbl">🏭 Suplidores</span><button class="supchip" id="calleSupChip">Todos ▾</button></div>
      <div class="suppanel" id="calleSupPanel"></div>
      <div class="cbar" id="cbar"></div>
      <div class="csearch" id="csearch"><input type="text" id="cq" placeholder="Buscar cliente por código o nombre…" autocomplete="off"><div class="cres" id="cres"></div></div>
      <div class="consbadge" id="ctabhint"></div>
      <div class="pbody" id="steps"></div>
      <div class="field"><label>Comentario del supervisor</label><textarea id="fComent" rows="2" placeholder="Lo que necesites anotar de la visita…"></textarea></div>
      <div class="field" id="fComprWrap" style="margin-bottom:6px"><label>Compromiso</label><textarea id="fCompr" rows="2" placeholder="Compromiso acordado…"></textarea></div>
      <div class="scorebar"><div><span class="big" id="totVal">0</span><span class="of"> / 100</span></div><span class="starsm" id="totStars"></span><div class="band" id="totBand">—</div><button class="finbtn" id="saveClient" style="background:var(--good-bg);color:var(--good);border-color:transparent">✔ Guardar cliente</button><button class="finbtn" id="toReport">Finalizar y firmar ›</button></div>
    </div></div></div>
    <input type="file" id="camInput" accept="image/*" capture="environment" style="display:none">
  </section>

  <!-- VIRTUAL -->
  <section class="view" id="view-virtual">
    <div class="note virt"><span>🖥️</span><div>Al <b>cargar un vendedor</b> trae sus <b>alertas del momento de Torre de Control</b> (con hora de generación). Marca suplidores, deja tu comentario y registra el contacto. Mínimo <b>1 por representante</b>.</div></div>
    <div class="vhead"><div style="font-weight:800;font-size:15px" id="vcount">…</div>
      <input type="text" id="v-search" placeholder="Buscar vendedor por nombre o código…" style="min-width:240px;flex:1">
      <div class="progress" style="flex:0 0 160px"><i id="vbar" style="width:0"></i></div></div>
    <div class="panel" id="vlist"></div>
  </section>

  <!-- COBROS DEL DIA -->
  <section class="view" id="view-cobros">
    <div class="note virt"><span>💰</span><div>Metas <b>diarias</b> por vendedor (hoy). En los cortes de <b>9:50</b> y <b>11:50</b> se compara la <b>proyección al cierre</b> (15:30); en el corte de <b>15:30</b> se compara el <b>logro real</b>. Semáforo: <b style="color:var(--good)">Verde ≥90%</b> · <b style="color:var(--warn)">Amarillo ≥80%</b> · <b style="color:var(--bad)">Rojo &lt;80%</b>. Primero se muestra el que va peor. Al <b>contactar</b> un recurso (vendedor o supervisor) se listan sus alarmas activas, se guarda comentario+compromiso, y queda en pausa 60 min.</div></div>

    <div class="kpis" id="cbCards" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin-bottom:14px"></div>

    <div class="subtabs" style="margin-bottom:10px">
      <button class="on" data-cv="estado">📋 Estado del día</button>
      <button data-cv="matriz">🚦 Todas las alertas</button>
      <button data-cv="contactos">📇 Contactos</button>
      <button data-cv="reportes">🖨️ Reportes</button>
    </div>

    <div id="cb-estado">
      <div class="vhead">
        <div style="font-weight:800;font-size:15px" id="cbTitle">…</div>
        <div id="cbCfgSel" style="min-width:220px"></div>
        <span class="n" id="cbCorte" style="color:var(--muted);font-size:12px"></span>
        <div style="margin-left:auto;display:flex;gap:8px;flex-wrap:wrap">
          <button class="rbtn" id="cbRefresh">🔄 Actualizar</button>
          <button class="rbtn" data-corte="09:50">💾 Guardar corte 9:50</button>
          <button class="rbtn" data-corte="11:50">💾 Guardar corte 11:50</button>
          <button class="rbtn" data-corte="15:30">💾 Guardar corte 15:30</button>
          <button class="rbtn hide" id="cbCfgBtn">⚙ Configurar alertas</button>
        </div>
      </div>
      <div id="cbAviso"></div>
      <div class="panel" id="cblist"></div>
    </div>

    <div id="cb-contactos" class="hide">
      <div class="filtros">
        <div class="fl"><label>Desde</label><input type="date" id="cbcoDesde"></div>
        <div class="fl"><label>Hasta</label><input type="date" id="cbcoHasta"></div>
        <button class="go" id="cbcoGo">Generar</button>
      </div>
      <div class="sec-title"><h3>Contactos por alerta</h3><span class="n" id="cbco-n"></span></div>
      <div class="scroller"><table><thead><tr><th class="l">Alerta</th><th>Contactos</th></tr></thead><tbody id="cbco-alerta"></tbody></table></div>
      <div class="sec-title"><h3>Contactos por supervisor / vendedor</h3></div>
      <div class="scroller" style="max-height:50vh"><table><thead><tr><th class="l">Fecha</th><th class="l">Recurso</th><th class="l">Supervisor</th><th class="l">Alertas</th><th class="l">Comentario</th><th class="l">Compromiso</th></tr></thead><tbody id="cbco-detalle"></tbody></table></div>
    </div>

    <div id="cb-matriz" class="hide">
      <div class="filtros">
        <div class="fl"><label>Supervisor</label><select id="cbmSup"><option value="">Todos</option></select></div>
        <div class="fl"><label>Vendedor</label><select id="cbmVen"><option value="">Todos</option></select></div>
        <div class="fl"><label>Alerta</label><select id="cbmAlerta"><option value="">Todas</option></select></div>
        <div class="fl"><label>Semáforo</label><select id="cbmSem"><option value="">Todos</option><option value="rojo">🔴 Rojo</option><option value="amarillo">🟡 Amarillo</option><option value="verde">🟢 Verde</option></select></div>
        <button class="go" id="cbmGo">🔄 Actualizar</button>
      </div>
      <div class="sec-title"><h3>Todas las alertas por representante</h3><span class="n" id="cbm-n"></span></div>
      <div class="panel" id="cbmList"></div>
    </div>

    <div id="cb-reportes" class="hide">
