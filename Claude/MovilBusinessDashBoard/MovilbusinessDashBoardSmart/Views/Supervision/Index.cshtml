/* ══════════════════════════════════════════════════════════════════════════
   REUNIÓN GERENCIAL — Informe Ejecutivo de Cierre de Ventas mensual
   Pedido explícito del usuario 2026-10-05: llevar a la app el "motor" Python del
   cierre (charts.py / build_xlsx*.py / build_pdf.py de Giancarlo) — el usuario solo
   elige Mes y Año. Backend: GET /apipdfpres/reunion-gerencial (datos, verificados al
   centavo contra sep-2026) y POST .../excel (Excel-cerebro con ClosedXML).
   La narrativa es un BORRADOR automático (rgNarrativa) que el usuario edita en
   pantalla (contenteditable) — lo editado viaja al PDF (captura html2canvas), al
   Excel (POST) y al historial. Reusa ppExportarPDF / historial genérico.
   ══════════════════════════════════════════════════════════════════════════ */
const RG={data:null, narr:null, acciones:null, charts:{}, _form:false};
const RG_MESES=['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
const RG_MA=['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'];
const RG_COL={verde:'#0C9444',azul:'#203F99',gris:'#6E6E6E',carbon:'#3A3A3A',G:'#1E8449',Y:'#E1A100',R:'#C0392B',claro:'#9DB4D8',claroV:'#8FCB9F'};

function rgM(x){ return 'RD$'+((x||0)/1e6).toLocaleString('es-DO',{minimumFractionDigits:1,maximumFractionDigits:1})+'M'; }
function rgRD(x){ return 'RD$'+Math.round(x||0).toLocaleString('es-DO'); }
function rgN(x){ return Math.round(x||0).toLocaleString('es-DO'); }
function rgP(x){ return x==null?'—':(x*100).toLocaleString('es-DO',{minimumFractionDigits:1,maximumFractionDigits:1})+'%'; }
function rgSP(x){ return x==null?'—':(x>=0?'+':'−')+Math.abs(x*100).toLocaleString('es-DO',{minimumFractionDigits:1,maximumFractionDigits:1})+'%'; }
function rgSem(p){ return p==null?null:(p>=1?'G':(p>=0.85?'Y':'R')); }
function rgSemTxt(s){ return s==='G'?'verde':(s==='Y'?'ámbar':'rojo'); }
function rgDot(s){ return s?'<span class="rg-dot '+s+'"></span>':''; }
function rgEsc(s){ return String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
function rgGrupo(g){ return g==='15'?'Mayorista':(g==='20'?'MiniMarket':'Minorista · grupo '+g); }
function rgCorto(c){ return c==='Santo Domingo'?'SDO':c; }

function rgInitForm(){
  if(RG._form) return; RG._form=true;
  const hoy=new Date(); const prev=new Date(hoy.getFullYear(), hoy.getMonth()-1, 1);
  $('#rg-mes').innerHTML=RG_MESES.map((m,i)=>'<option value="'+(i+1)+'">'+m+'</option>').join('');
  let anios=''; for(let a=hoy.getFullYear(); a>=2021; a--) anios+='<option value="'+a+'">'+a+'</option>';
  $('#rg-anio').innerHTML=anios;
  $('#rg-mes').value=String(prev.getMonth()+1); $('#rg-anio').value=String(prev.getFullYear());
  $('#rg-generar').onclick=()=>rgGenerar(false);
  ['rg-pdf','rg-pdf-top'].forEach(id=>$('#'+id).onclick=rgDescargarPDF);
  ['rg-xlsx','rg-xlsx-top'].forEach(id=>$('#'+id).onclick=rgDescargarExcel);
  ['rg-hist','rg-hist-top'].forEach(id=>$('#'+id).onclick=rgGuardarHistorial);
  $('#rg-refrescar-top').onclick=()=>{ if(confirm('¿Volver a consultar Movil Business? Tarda alrededor de 1 minuto. Tus textos editados se conservan.')) rgGenerar(true); };
  $('#rg-borrador-top').onclick=()=>{ if(!RG.data) return; if(confirm('¿Descartar tus cambios y volver a redactar los textos automáticamente?')){ RG.narr=null; RG.acciones=null; rgRender(); } };
}

function rgGenerar(forzar){
  const mes=+$('#rg-mes').value, anio=+$('#rg-anio').value;
  const hint=$('#rg-hint'); hint.style.display='none';
  const hoy=new Date();
  if(anio>hoy.getFullYear()||(anio===hoy.getFullYear()&&mes>hoy.getMonth()+1)){ hint.style.display='block'; hint.textContent='Ese mes todavía no ha empezado.'; return; }
  const btns=ppSetBtns(['rg-generar','rg-refrescar-top'],'Generando… (puede tardar ~1 min)',true);
  const t0=Date.now();
  fetch(BASE+'/apipdfpres/reunion-gerencial?'+new URLSearchParams({anio,mes,forzar:forzar?1:0}))
    .then(r=>r.json()).then(j=>{
      ppRestoreBtns(btns);
      if(!j||!j.ok){ hint.style.display='block'; hint.textContent=(j&&j.error)||'Error generando el informe'; if(forzar) toast((j&&j.error)||'Error'); return; }
      // "Actualizar datos" sobre el MISMO mes conserva lo que el usuario ya editó; otro mes → borrador nuevo.
      const mismo=RG.data&&RG.data.meta.anio===j.meta.anio&&RG.data.meta.mes===j.meta.mes;
      if(!(forzar&&mismo)){ RG.narr=null; RG.acciones=null; }
      RG.data=j; rgRender(); ppShow('pp-reunion-wrap');
      if(Date.now()-t0>3000) toast('Informe generado ✓');
    }).catch(e=>{ ppRestoreBtns(btns); hint.style.display='block'; hint.textContent='Error: '+e; });
}

/* ── Métricas derivadas (una sola fuente para narrativa, tablas y Excel) ── */
function rgCalc(d){
  const M=d.meta.mes, cs=d.centros;
  const esInst=f=>(f.canal||'').toLowerCase()==='institucional';
  const C={};
  cs.forEach(c=>{
    const fc=d.forecast.filter(f=>f.centro===c&&!esInst(f));
    const presu=fc.reduce((a,f)=>a+f.presupuesto,0), ejec=fc.reduce((a,f)=>a+f.ejecutado,0);
    const vs=d.vendedores.filter(v=>v.centro===c);
    const conCuota=vs.filter(v=>v.cuota>0);
    const sobre=conCuota.filter(v=>v.ejecutado>=v.cuota).length;
    const media=conCuota.length?conCuota.reduce((a,v)=>a+v.ejecutado/v.cuota,0)/conCuota.length:null;
    const prov=d.proveedores[c]||[]; const totProv=prov.reduce((a,p)=>a+p.neto,0);
    const ab=(d.abcd[c]||{})[String(M)]||{}; const totAb=['A','B','C','D','SC'].reduce((a,s)=>a+((ab[s]||{}).neto||0),0);
    const serie=d.serieActual[c]||[];
    const grupos={}; vs.forEach(v=>{ const g=grupos[v.grupo]||(grupos[v.grupo]={n:0,cuota:0,ejec:0,neto:0}); g.n++; g.cuota+=v.cuota; g.ejec+=v.ejecutado; g.neto+=v.neto; });
    C[c]={presu,ejec,pct:presu?ejec/presu:null,vs,conCuota,sobre,media,prov,totProv,ab,totAb,serie,grupos,
      lfl:d.lfl.porCentro[c]||{}, op:d.operacion[c]||{}, canales:d.forecast.filter(f=>f.centro===c&&!esInst(f))};
  });
  const presuT=cs.reduce((a,c)=>a+C[c].presu,0), ejecT=cs.reduce((a,c)=>a+C[c].ejec,0);
  const canales=d.forecast.filter(f=>!esInst(f)&&f.presupuesto>0).map(f=>({...f,pct:f.ejecutado/f.presupuesto})).sort((a,b)=>a.pct-b.pct);
  return {M,cs,C,presuT,ejecT,pctT:presuT?ejecT/presuT:null,canales,esInst};
}

/* ── Borrador automático de la narrativa (mismas claves que el NARR del motor Python) ── */
function rgNarrativa(d,K){
  const M=d.meta.mes, A=d.meta.anio, P=d.meta.anioAnterior, MN=d.meta.mesNombre, mn=MN.toLowerCase(), L=d.lfl, n={};
  const sigMes=RG_MA[M%12].toLowerCase();
  const unir=x=>x.length<=1?x.join(''):x.slice(0,-1).join(', ')+' y '+x[x.length-1];
  const listar=(arr,k,extra)=>unir(arr.slice(0,k).map(a=>a.suplidor).concat(extra||[]));
  const sT=rgSem(K.pctT);
  n.CAPA1_INTRO='Esta capa da el pulso del negocio total y de cada centro: cuánto se vendió, cómo cerró contra el forecast y contra el año pasado, y qué tan sano es ese resultado una vez aislados los cambios de portafolio (marcas que entran y salen). Léala de arriba hacia abajo: primero los KPIs, luego el puente que explica la variación interanual, y al final la tendencia y el cumplimiento por centro y canal.';
  let kpi='Total AM cerró en '+rgP(K.pctT)+' del forecast ('+rgSemTxt(sT)+').';
  if(L.hayAnterior){
    kpi+=' El '+rgSP(L.yoyReportado)+' interanual reportado mezcla cambios de portafolio'
      +(L.nuevas.length?': entran '+listar(L.nuevas,3):'')+(L.descontinuadas.length?(L.nuevas.length?' y salen ':': salen ')+listar(L.descontinuadas,3):'')+'.';
    const cen=K.cs.map(c=>({c,y:K.C[c].lfl.yoyComparable})).filter(x=>x.y!=null).sort((a,b)=>a.y-b.y);
    kpi+=' Comparando el MISMO portafolio (pera con pera), la base '+(L.yoyComparable>=0?'crece ':'cae ')+rgSP(L.yoyComparable)+' interanual'
      +(cen.length?' — '+cen.map(x=>x.c+' '+rgSP(x.y)).join(', ')+(cen.length>1&&cen[0].y<0?' ('+cen[0].c+' es el punto débil)':''):'')+'.';
  } else kpi+=' No hay datos de '+MN+' '+P+' para el comparativo interanual.';
  n.CAP_KPI=kpi;
  n.CAP_BRIDGE=L.hayAnterior
    ? 'De izquierda a derecha: de los '+rgM(L.reportadoAnterior)+' de '+mn+'-'+P+' se restan '+rgM(-L.salidas)+' de marcas que ya no existen'
      +((L.descontinuadas.length||L.galleteriaAnterior>0)?' ('+listar(L.descontinuadas,4,L.galleteriaAnterior>0?['galletería']:[])+')':'')
      +'; el negocio continuo '+(L.deltaBase>=0?'crece ':'cae ')+rgM(Math.abs(L.deltaBase))+' ('+rgSP(L.yoyComparable)+' pera con pera); entran '+rgM(L.entradas)+' de líneas nuevas'
      +(L.nuevas.length?' ('+listar(L.nuevas,3)+')':'')+' y se llega a los '+rgM(L.reportadoActual)+' reportados. '
      +(Math.abs(L.yoyComparable)<Math.abs(L.yoyReportado)?'El grueso del movimiento es cambio de portafolio, no tracción de la base.':'La variación de la base explica la mayor parte del movimiento.')
    : 'Sin datos del año anterior para construir el puente interanual.';
  const ser=K.cs.map(c=>{ const s=K.C[c].serie, v=s[M-1], ant=M>1?s[M-2]:null;
    return c+' '+rgM(v)+(ant?' ('+rgSP(v/ant-1)+' vs '+RG_MA[M-2].toLowerCase()+')':''); }).join('; ');
  const peor=K.canales[0];
  n.CAP_SERIES='Tendencia: '+ser+'. Contra presupuesto: '+K.cs.map(c=>c+' '+rgP(K.C[c].pct)+' ('+rgSemTxt(rgSem(K.C[c].pct))+')').join(', ')+'.'
    +(peor?' El canal más flojo del mes es '+peor.canal+' de '+peor.centro+' ('+rgP(peor.pct)+').':'');
  const acciones=[];
  K.cs.forEach((c,i)=>{
    const X=K.C[c], k='C'+(i+1)+'_', s=X.serie, op=X.op, sem=rgSem(X.pct);
    const tri=d.meta.trimestre.map(m=>rgM(s[m-1])).join(' → ');
    n[k+'intro']=c+' vendió '+rgM(op.venta)+' en '+mn+', '+rgP(X.pct)+' del forecast ('+rgSemTxt(sem)+'). En el trimestre: '+tri+'.'
      +(X.lfl.yoyReportado!=null?' Contra '+mn+' '+P+': '+rgSP(X.lfl.yoyReportado)+' reportado y '+rgSP(X.lfl.yoyComparable)+' pera con pera.':'');
    const otros=K.cs.filter(o=>o!==c);
    const efMejor=otros.every(o=>(K.C[o].op.efectividad||0)<=(op.efectividad||0));
    n[k+'op']=c+' mueve '+rgM(op.venta)+' ('+rgRD(op.porDia)+' por día hábil) con ticket promedio de '+rgRD(op.ticket)+'. Activación de cartera '+rgP(op.activacion)
      +' ('+rgN(op.activos)+' de '+rgN(op.cartera)+' clientes en ruta) y efectividad de visita '+rgP(op.efectividad)
      +(otros.length?(efMejor?' — la mejor entre los centros.':' — por debajo de '+otros.map(o=>o+' ('+rgP(K.C[o].op.efectividad)+')').join(', ')+': cierra menos pedidos por visita.'):'.');
    const p1=X.prov[0], sh1=p1&&X.totProv?p1.neto/X.totProv:0, sh4=X.totProv?X.prov.slice(0,4).reduce((a,p)=>a+p.neto,0)/X.totProv:0;
    n[k+'prov']=p1?(p1.nombre+' pesa '+rgP(sh1)+' del centro y los 4 principales proveedores suman '+rgP(sh4)+'.'
      +(sh1>=0.4?' Alta dependencia de un solo proveedor: es el riesgo estructural a vigilar.':' La venta está razonablemente repartida entre proveedores.')):'Sin ventas por proveedor.';
    const a=X.ab.A||{neto:0,clientes:0};
    n[k+'abcd']='El segmento A concentra '+rgP(X.totAb?a.neto/X.totAb:0)+' de la venta con '+rgN(a.clientes)+' clientes. En cuota: '+X.sobre+' de '+X.conCuota.length
      +' vendedores sobre cuota (media '+rgP(X.media)+'). '+(X.conCuota.length&&X.sobre/X.conCuota.length<0.5?'El cumplimiento es débil y transversal.':'La mayoría de la fuerza alcanza su cuota.');
    const gs=Object.entries(X.grupos).sort((a,b)=>b[1].neto-a[1].neto);
    n[k+'ffvv']='Por fuerza de venta: '+gs.map(([g,v])=>rgGrupo(g)+' '+rgM(v.neto)+' ('+v.n+' vend., '+rgP(v.cuota?v.ejec/v.cuota:null)+' de cuota)').join('; ')+'.';
    n[k+'senal']='Señal '+c+': '+rgSemTxt(sem)+' — '+rgP(X.pct)+' del forecast, '+X.sobre+'/'+X.conCuota.length+' sobre cuota'
      +(X.lfl.yoyComparable!=null?', base pera con pera '+rgSP(X.lfl.yoyComparable):'')+'.';
    acciones.push({sem, senal:c+(sem==='G'?' cumple':(sem==='Y'?' cerca del forecast':' bajo el forecast')),
      que:rgP(X.pct)+' del forecast; '+X.sobre+'/'+X.conCuota.length+' vendedores sobre cuota (media '+rgP(X.media)+').',
      hacer:sem==='G'?'Sostener el ritmo y replicar las prácticas de los vendedores sobre cuota.':'Revisar cumplimiento por vendedor (los de menor % de cuota) y la calibración de cuotas.',
      resp:'Sup. '+rgCorto(c), fecha:'10-'+sigMes});
  });
  K.canales.filter(f=>f.pct<0.85).slice(0,2).forEach(f=>acciones.push({sem:'R', senal:f.canal+' '+rgCorto(f.centro),
    que:'Canal '+f.canal+' de '+f.centro+' en '+rgP(f.pct)+' del forecast — el más flojo del mes.',
    hacer:'Revisar quiebres de inventario, cartera y clientes perdidos del canal.', resp:'Comercial / Compras', fecha:'10-'+sigMes}));
  if(L.hayAnterior){
    const sL=L.yoyComparable>=0?'G':(L.yoyComparable>=-0.08?'Y':'R');
    const debil=K.cs.filter(c=>K.C[c].lfl.yoyComparable!=null&&K.C[c].lfl.yoyComparable<0);
    acciones.push({sem:sL, senal:'Base pera con pera',
      que:'Mismo portafolio en ambos años: la base '+(L.yoyComparable>=0?'crece ':'cae ')+rgSP(L.yoyComparable)+' ('+K.cs.map(c=>rgCorto(c)+' '+rgSP(K.C[c].lfl.yoyComparable)).join(', ')+'). El '+rgSP(L.yoyReportado)+' reportado incluye cambios de portafolio.',
      hacer:debil.length?'Monitorear '+debil.join(' y ')+', con caída real de la base.':'Sostener: la base continua crece.', resp:'Gerencia', fecha:'15-'+sigMes});
  }
  const efs=K.cs.map(c=>({c,e:K.C[c].op.efectividad})).filter(x=>x.e!=null).sort((a,b)=>a.e-b.e);
  if(efs.length&&efs[0].e<0.45) acciones.push({sem:'Y', senal:'Efectividad '+rgCorto(efs[0].c),
    que:'Efectividad de visita de '+rgP(efs[0].e)+' en '+efs[0].c+': muchas visitas sin pedido.', hacer:'Acompañamiento en calle a los vendedores con menor efectividad.', resp:'Sup. '+rgCorto(efs[0].c), fecha:'Continuo'});
  // Colombina
  const col=K.cs.map(c=>{ const x=d.colombina[c]||{total:0,top:[]}; return {c,sh:x.total?x.top.reduce((a,t)=>a+t.neto,0)/x.total:0,top:x.top[0]}; });
  n.COLO_INTRO='Colombina es la marca de mayor exposición minorista y el proveedor con más SKU en ruta. Aquí se ve dónde se concentra su venta y qué tan dependiente es de unos pocos productos.';
  n.COLO_CAP='El Top 5 es '+col.map(x=>rgP(x.sh)+' de Colombina en '+x.c).join(' y ')+'.'
    +(col[0]&&col[0].top?' El SKU líder en '+col[0].c+' es '+col[0].top.sku+'.':'')+(col.some(x=>x.sh>0.4)?' Alta concentración en pocos SKU: vigilar sell-out y quiebres de esos productos.':'');
  // Caobo
  const cb=d.caobo||[], cbN=cb.reduce((a,x)=>a+x.neto,0), cbI=cb.reduce((a,x)=>a+x.conItbis,0), cbP=cb.reduce((a,x)=>a+x.netoAnterior,0);
  n.CAOBO_INTRO='Apéndice para Presidencia: ventas intercompañía a Inversiones Caobo (que el resto del informe EXCLUYE), abiertas por suplidor. Caobo revende estas líneas a supermercados y cadenas nacionales.';
  n.CAOBO_CAP='En '+mn+' AM facturó '+rgM(cbN)+' neto a Caobo ('+rgM(cbI)+' con ITBIS)'+(cbP?', '+rgSP(cbN/cbP-1)+' vs '+P:'')+'.'
    +(cb.length?' Se concentra en '+cb.slice(0,2).map(x=>x.suplidor+' ('+rgM(x.neto)+')').join(' y ')+'.':'');
  return {narr:n, acciones};
}

/* ── Render ── */
function rgTxt(k, cls){ return '<div class="'+(cls||'rg-cap')+' rg-ed" contenteditable="true" spellcheck="true" data-rgk="'+k+'">'+rgEsc(RG.narr[k]||'')+'</div>'; }
function rgLect(k){ return '<div class="rg-cap"><b class="l">Lectura: </b><span class="rg-ed" contenteditable="true" spellcheck="true" data-rgk="'+k+'">'+rgEsc(RG.narr[k]||'')+'</span></div>'; }
// nl = cuántas columnas (desde la izquierda) son texto y van alineadas a la izquierda.
function rgTabla(head, rows, tot, nl){
  nl=nl||1; const cl=i=>i<nl?' class="l"':'';
  return '<div class="scroller"><table><thead><tr>'+head.map((h,i)=>'<th'+cl(i)+'>'+h+'</th>').join('')+'</tr></thead><tbody>'
    +rows.map(r=>'<tr>'+r.map((v,i)=>'<td'+cl(i)+'>'+v+'</td>').join('')+'</tr>').join('')
    +(tot?'<tr class="totrow">'+tot.map((v,i)=>'<td'+cl(i)+'>'+v+'</td>').join('')+'</tr>':'')
    +'</tbody></table></div>';
}
function rgCanvas(id, alto){ return '<div class="rg-graf'+(alto?' alto':'')+'"><canvas id="'+id+'"></canvas></div>'; }

function rgRender(){
  const d=RG.data; if(!d) return;
  const K=rgCalc(d);
  if(!RG.narr||!RG.acciones){ const b=rgNarrativa(d,K); if(!RG.narr) RG.narr=b.narr; if(!RG.acciones) RG.acciones=b.acciones; }
  const M=d.meta.mes, A=d.meta.anio, P=d.meta.anioAnterior, MN=d.meta.mesNombre, MA=RG_MA[M-1], L=d.lfl;
  let h='<div class="pp-report"><div class="pp-band"><div class="rt">Informe Ejecutivo de Cierre de Ventas — '+MN+' '+A+'</div>'
