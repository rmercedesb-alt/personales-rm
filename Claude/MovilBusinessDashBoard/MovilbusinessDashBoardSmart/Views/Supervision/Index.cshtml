  const wi=cal.filter(r=>r.indice!=null); const idx=wi.length?Math.round(wi.reduce((a,r)=>a+r.indice,0)/wi.length):null;
  const dur=rows.reduce((a,r)=>a+(r.durMin||0),0);
  $('#an-kpis').innerHTML=anKpi('Supervisiones',rows.length)+anKpi('En calle',cal.length)+anKpi('Virtual',vir)+anKpi('Duración',fmtDur(dur))+anKpi('Índice prom',idx!=null?idx:'—');
  $('#an-thead').innerHTML='<tr><th class="l">Fecha</th><th>Hora</th><th class="l">Tipo</th><th class="l">Vendedor</th><th class="l">Supervisor</th><th>Clientes</th><th>Duración</th><th>Índice</th><th>Banda</th><th></th></tr>';
  $('#an-tbody').innerHTML=rows.length?rows.map(r=>{
    const idxc=r.indice!=null?'<b style="color:'+scoreColor(r.indice)+'">'+Math.round(r.indice)+'</b>':'—';
    const bn=r.banda?'<span class="band '+r.banda+'">'+r.banda+'</span>':'';
