function ppFilasSimple(rows){
  if(!rows||!rows.length) return '<tr><td class="l" colspan="4">Sin datos para este filtro.</td></tr>';
  const tot={facturas:0,cajas:0,monto:0};
  let body=rows.map(r=>{ tot.facturas+=r.facturas; tot.cajas+=r.cajas; tot.monto+=r.monto;
    return '<tr><td class="l">'+r.nombre+'</td><td>'+ppFmtNum(r.facturas)+'</td><td>'+ppFmtNum(r.cajas)+'</td><td>'+ppFmtNum(r.monto)+'</td></tr>'; }).join('');
  body+='<tr class="totrow"><td class="l">Total</td><td>'+ppFmtNum(tot.facturas)+'</td><td>'+ppFmtNum(tot.cajas)+'</td><td>'+ppFmtNum(tot.monto)+'</td></tr>';
  return body;
}

function ppAgruparPorSuplidor(detRows, centros){
  const grupos=new Map(); // cat3Id -> {suplidor, cats:[], totMonto, totCajas, totPorCentro}
  (detRows||[]).forEach(d=>{
    if(!grupos.has(d.cat3Id)) grupos.set(d.cat3Id, {suplidor:d.suplidor, cats:[], totMonto:0, totCajas:0, totPorCentro:{}});
    const g=grupos.get(d.cat3Id);
    g.cats.push(d); g.totMonto+=d.monto; g.totCajas+=d.cajas;
    centros.forEach(c=>{
      const v=(d.porCentro&&d.porCentro[c.cedCodigo])||{monto:0,cajas:0};
      if(!g.totPorCentro[c.cedCodigo]) g.totPorCentro[c.cedCodigo]={monto:0,cajas:0};
      g.totPorCentro[c.cedCodigo].monto+=v.monto; g.totPorCentro[c.cedCodigo].cajas+=v.cajas;
    });
  });
  return [...grupos.values()].sort((a,b)=>b.totMonto-a.totMonto).map(g=>{ g.cats.sort((a,b)=>b.monto-a.monto); return g; });
}

function ppFilasPorDia(rows){
  if(!rows||!rows.length) return '<tr><td class="l" colspan="4">Sin datos para este rango.</td></tr>';
  let totCajas=0, totMonto=0;
  let body=rows.map(r=>{ totCajas+=r.cajas; totMonto+=r.monto;
    const cap=(r.diaSemana||'').charAt(0).toUpperCase()+(r.diaSemana||'').slice(1);
    return '<tr><td class="l">'+cap+'</td><td class="l">'+r.fecha+'</td><td>'+ppFmtNum(r.cajas)+'</td><td>'+ppFmtNum(r.monto)+'</td></tr>'; }).join('');
  body+='<tr class="totrow"><td class="l" colspan="2">Total</td><td>'+ppFmtNum(totCajas)+'</td><td>'+ppFmtNum(totMonto)+'</td></tr>';
  return body;
}

