  });
  const pf=document.createElement('div');pf.className='photo';
  if(ro){const ft=evalClients.filter(c=>c.photo);pf.innerHTML='<div style="flex:1"><div style="font-weight:700;font-size:13px;color:var(--text)">Fotos</div><div style="font-size:11px;color:var(--muted)">'+ft.length+' de '+evalClients.length+' con foto</div><div class="thumbgrid">'+ft.map(c=>'<img class="thumb" src="'+c.photo+'">').join('')+'</div></div>';}
