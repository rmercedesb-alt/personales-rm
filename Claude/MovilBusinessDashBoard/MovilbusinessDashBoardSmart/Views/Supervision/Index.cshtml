  const btn=$('#cd-wa-enviar-go'); btn.disabled=true; const t0=btn.textContent; btn.textContent='Enviando…';
  fetch(BASE+'/apipdfpres/whatsapp/enviar-ahora',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)})
    .then(r=>r.json()).then(j=>{
