  (fotos.length?'<div class="sec-title"><h3>Evidencias</h3></div><div class="thumbgrid">'+fotos.map(c=>'<img class="thumb" style="width:80px;height:80px" src="'+c.photo+'">').join('')+'</div>':'')+
  '<div class="sigrow"><div><div class="sigcap"><span>Firma del vendedor</span><button class="clr" data-clr="sigV">Limpiar</button></div><canvas class="pad" id="sigV"></canvas><div class="sigline">'+payload.repNombre+' · recibí y estoy enterado</div></div>'+
  '<div><div class="sigcap"><span>Firma del supervisor</span><button class="clr" data-clr="sigS">Limpiar</button></div><canvas class="pad" id="sigS"></canvas><div class="sigline">'+(ID.nombre||'')+' · supervisor</div></div></div>'+
  '<div class="ractions"><button class="rbtn primary" id="saveEval">💾 Guardar y firmar</button><button class="rbtn" onclick="window.print()">🖨 Imprimir</button></div>';
  initPad('sigV');initPad('sigS');
  $$('#reportCard [data-clr]').forEach(b=>b.onclick=()=>{const c=$('#'+b.dataset.clr);if(c._clear)c._clear();});
  $('#saveEval').onclick=saveEval;
}
function saveEval(){
  if(!lastPayload)return; const p=Object.assign({},lastPayload);
  p.comentario=$('#genComent')?$('#genComent').value:'';
  p.compromiso=$('#genCompr')?$('#genCompr').value:(lastPayload.compromiso!==undefined?lastPayload.compromiso:null);
  p.firmaVendedor=$('#sigV')?$('#sigV').toDataURL('image/png'):null;
  p.firmaSupervisor=$('#sigS')?$('#sigS').toDataURL('image/png'):null;
  $('#saveEval').disabled=true;
  api('/evaluacion',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(p)}).then(j=>{
    if(j&&j.ok){toast('Evaluación guardada · índice '+(j.indice!=null?j.indice:'—'));}
    else{toast('Error: '+((j&&j.error)||'')); $('#saveEval').disabled=false;}
  }).catch(e=>{toast('Error: '+e);$('#saveEval').disabled=false;});
}
function initPad(id){const c=$('#'+id);if(!c)return;const ctx=c.getContext('2d'),dpr=devicePixelRatio||1;let dr=false,last=null;
  const rs=()=>{const r=c.getBoundingClientRect();c.width=r.width*dpr;c.height=r.height*dpr;ctx.scale(dpr,dpr);ctx.lineWidth=2.2;ctx.lineCap='round';ctx.lineJoin='round';};
  const pos=e=>{const r=c.getBoundingClientRect(),t=e.touches?e.touches[0]:e;return {x:t.clientX-r.left,y:t.clientY-r.top};};
  c.onmousedown=e=>{dr=true;last=pos(e);};c.onmousemove=e=>{if(!dr)return;const p=pos(e);ctx.strokeStyle=getComputedStyle(document.documentElement).getPropertyValue('--text');ctx.beginPath();ctx.moveTo(last.x,last.y);ctx.lineTo(p.x,p.y);ctx.stroke();last=p;};window.addEventListener('mouseup',()=>dr=false);
  c.addEventListener('touchstart',e=>{e.preventDefault();dr=true;last=pos(e);},{passive:false});c.addEventListener('touchmove',e=>{e.preventDefault();if(!dr)return;const p=pos(e);ctx.strokeStyle=getComputedStyle(document.documentElement).getPropertyValue('--text');ctx.beginPath();ctx.moveTo(last.x,last.y);ctx.lineTo(p.x,p.y);ctx.stroke();last=p;},{passive:false});c.addEventListener('touchend',()=>dr=false);
  setTimeout(rs,40);c._clear=()=>ctx.clearRect(0,0,c.width,c.height);}

/* ── REPORTES GUARDADOS (abrir/reimprimir por Supervisor→Vendedor→Fecha→Reporte) ── */
function factorPeso(code){const f=[...FACAcomp,...FACAudit].find(x=>x.codigo===code);return f?+f.peso:0;}
let REPLIST=[], REP_loaded=false;
function repLoadList(){
  const hoy=new Date(),desde=dateF(new Date(hoy.getFullYear(),hoy.getMonth()-6,hoy.getDate())),hasta=dateF(hoy);
  fetch(BASE+'/apisuperv/evaluaciones?tipos=acomp,audit,virtual&desde='+desde+'&hasta='+hasta).then(r=>r.json()).then(j=>{
    REPLIST=(j&&j.evaluaciones)||[];
    repFillSup();
  }).catch(()=>{});
}
function repSupKey(e){return e.supCod||e.supervisor||'';}
function repItems(){ const t=$('#rep-tipo').value;   // filtra la lista según el tipo elegido
  return REPLIST.filter(e=> t==='virtual' ? e.clase==='virtual' : e.tipo===t ); }
function repFillSup(){
  const items=repItems();
  const sups=[...new Map(items.map(e=>[repSupKey(e),e.supervisor||e.supCod||'—'])).entries()];
  $('#rep-sup').innerHTML='<option value="">— Todos —</option>'+sups.map(([c,n])=>'<option value="'+escA(c)+'">'+escA(n)+'</option>').join('');
  repFillVen();
}
function repFillVen(){
  const sc=$('#rep-sup').value;
  const reps=[...new Map(repItems().filter(e=>!sc||repSupKey(e)===sc).map(e=>[e.rep,(e.repNombre||e.rep)])).entries()];
  $('#rep-ven').innerHTML='<option value="">— Todos —</option>'+reps.map(([c,n])=>'<option value="'+escA(c)+'">'+escA(n)+'</option>').join('');
  repFillFec();
}
function repFillFec(){
  const sc=$('#rep-sup').value,rv=$('#rep-ven').value;
  const fechas=[...new Set(repItems().filter(e=>(!sc||repSupKey(e)===sc)&&(!rv||e.rep===rv)).map(e=>e.fecha))].sort().reverse();
  $('#rep-fec').innerHTML='<option value="">— Todas —</option>'+fechas.map(f=>'<option value="'+f+'">'+f+'</option>').join('');
  repFillRep();
}
function repFillRep(){
  const sc=$('#rep-sup').value,rv=$('#rep-ven').value,fc=$('#rep-fec').value,t=$('#rep-tipo').value;
  const list=repItems().filter(e=>(!sc||repSupKey(e)===sc)&&(!rv||e.rep===rv)&&(!fc||e.fecha===fc));
  if(t==='virtual'){
    // Virtual: agrupar por vendedor+fecha → 1 reporte por día (varios contactos)
    const grp=new Map();
    list.forEach(e=>{const k=e.rep+'|'+e.fecha;if(!grp.has(k))grp.set(k,{rep:e.rep,nom:e.repNombre||e.rep,fecha:e.fecha,n:0});grp.get(k).n++;});
    const arr=[...grp.values()].sort((a,b)=>a.fecha<b.fecha?1:-1);
    $('#rep-rep').innerHTML=arr.length?arr.map(g=>'<option value="V|'+escA(g.rep)+'|'+g.fecha+'">Virtual · '+escA(g.nom)+' · '+g.fecha+' · '+g.n+' contacto'+(g.n!==1?'s':'')+'</option>').join(''):'<option value="">— sin reportes —</option>';
  }else{
    $('#rep-rep').innerHTML=list.length?list.map(e=>'<option value="'+e.id+'">'+(TIPONM[e.tipo]||e.tipo)+' · '+escA(e.repNombre||e.rep)+' · '+e.fecha+(e.horaInicio?' · '+e.horaInicio:'')+'</option>').join(''):'<option value="">— sin reportes —</option>';
  }
}
