/* P1 (2026-10-17): Centro → Supervisor → Vendedor (y División, donde existe) dependientes en los filtros de PDF Presentaciones,
   Resumen Cierre del Día y Cierre Diario. M = {centro,supervisor,vendedor[,division]}; msel conserva la selección que siga siendo válida. */
function mselDependCSV(M,reps){
  return ()=>{
    let rc=reps; const cs=new Set(M.centro.values()); const dv=M.division?new Set(M.division.values()):null;
    if(dv&&dv.size) rc=rc.filter(r=>dv.has(String(r.Division))); if(cs.size) rc=rc.filter(r=>cs.has(r.CedCodigo));
    M.supervisor.setOptions([...new Map(rc.filter(r=>r.SupervisorCod).map(r=>[r.SupervisorCod,r.SupervisorNombre||r.SupervisorCod])).entries()].map(([v,t])=>({v,t})));
    const ss=new Set(M.supervisor.values()); const rs=ss.size?rc.filter(r=>ss.has(r.SupervisorCod)):rc;
    M.vendedor.setOptions(rs.map(r=>({v:r.RepCodigo,t:r.RepNombre+' · '+r.RepCodigo})));
  };
}
