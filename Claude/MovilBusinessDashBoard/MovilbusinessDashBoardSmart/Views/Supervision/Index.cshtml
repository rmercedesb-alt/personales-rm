function msel(mount,opts,cfg){
  cfg=cfg||{}; const multi=cfg.multi!==false; let OPTS=opts.slice(); const sel=new Set();
  (cfg.default||[]).forEach(d=>sel.add(String(d)));
  mount.classList.add('ms');
  mount.innerHTML='<button type="button" class="ms-chip"></button><div class="ms-panel"><input class="ms-search" placeholder="Buscar por nombre o código…"><div class="ms-list"></div></div>';
  const chip=mount.querySelector('.ms-chip'),panel=mount.querySelector('.ms-panel'),search=mount.querySelector('.ms-search'),list=mount.querySelector('.ms-list');
  function label(){ if(!multi){const o=OPTS.find(x=>sel.has(String(x.v)));chip.textContent=(o?o.t:(cfg.placeholder||'—'))+' ▾';return;}
    chip.textContent=(!sel.size?(cfg.placeholder||'Todos'):(sel.size===OPTS.length?'Todos':sel.size+' sel.'))+' ▾'; }
  function filterList(){const q=search.value.toLowerCase();list.querySelectorAll('.ms-opt').forEach(el=>{if(el.classList.contains('ms-all'))return;const t=(el.querySelector('.ms-t').textContent+' '+el.dataset.v).toLowerCase();el.style.display=(!q||t.includes(q))?'':'none';});}
  function buildList(){ list.innerHTML=(multi?'<div class="ms-opt ms-all">Todos / ninguno</div>':'')+OPTS.map(o=>'<div class="ms-opt" data-v="'+o.v+'">'+(multi?'<span class="ms-ck">'+(sel.has(String(o.v))?'☑':'☐')+'</span>':'')+'<span class="ms-t">'+o.t+'</span></div>').join('');
    list.querySelectorAll('.ms-opt').forEach(el=>el.onclick=e=>{e.stopPropagation();
      if(el.classList.contains('ms-all')){if(sel.size===OPTS.length)sel.clear();else OPTS.forEach(o=>sel.add(String(o.v)));}
      else{const v=el.dataset.v;if(multi){sel.has(v)?sel.delete(v):sel.add(v);}else{sel.clear();sel.add(v);panel.classList.remove('on');}}
      buildList();label();if(cfg.onChange)cfg.onChange();});
    filterList(); }
  search.oninput=filterList; search.onclick=e=>e.stopPropagation(); panel.onclick=e=>e.stopPropagation();
  chip.onclick=e=>{e.stopPropagation();const open=panel.classList.contains('on');$$('.ms-panel.on').forEach(p=>p.classList.remove('on'));if(!open){panel.classList.add('on');search.value='';filterList();search.focus();}};
  buildList();label();
  return { values:()=>[...sel], setOptions:o=>{OPTS=o.slice();[...sel].forEach(v=>{if(!OPTS.some(x=>String(x.v)===v))sel.delete(v);});buildList();label();}, set:vals=>{sel.clear();(vals||[]).forEach(v=>sel.add(String(v)));buildList();label();} };
}

