  }).join('')||'<tr><td class="l">Sin vendedores en tu alcance.</td></tr>';
  h+='</tbody></table></div>';
  box.innerHTML=h;
  $$('#crono-content .pcgsel').forEach(s=>s.onchange=()=>{ s.className='cfgsel pcgsel '+s.value; const sels=$$('#crono-content .pcgsel[data-rep="'+s.dataset.rep+'"]').map(x=>x.value); const b=$('#crono-content [data-pcad="'+s.dataset.rep+'"]'); if(b)b.textContent=cadOf(sels); });
  const q=$('#pcg-q'); if(q)q.oninput=function(){ const v=this.value.toLowerCase(); $$('#crono-content tbody tr[data-q]').forEach(r=>{ r.style.display=(!v||r.dataset.q.includes(v))?'':'none'; }); };
  const sv=$('#pcg-save'); if(sv)sv.onclick=()=>{
