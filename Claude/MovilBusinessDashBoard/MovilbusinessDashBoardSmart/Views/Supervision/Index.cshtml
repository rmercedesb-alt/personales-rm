    const acc=r.clase==='calle'?'<button class="rbtn" data-eva="'+r.id+'">Ver detalle</button>':'<button class="rbtn" data-vcon="'+r.id+'">Ver detalle</button>';
    return '<tr><td class="l">'+escA(r.fecha)+'</td><td>'+hora+'</td><td class="l">'+(TIPONM[r.tipo]||r.tipo)+'</td><td class="l"><b>'+escA(r.repNombre||r.rep)+'</b></td><td class="l">'+escA(r.supervisor||'')+'</td><td>'+(r.clientes||0)+'</td><td>'+fmtDur(r.durMin)+'</td><td>'+idxc+'</td><td>'+bn+'</td><td>'+acc+'</td></tr>';
  }).join(''):'<tr><td class="l" colspan="10">Sin evaluaciones en el rango.</td></tr>';
  $$('#an-tbody [data-eva]').forEach(b=>b.onclick=()=>openEval(+b.dataset.eva));
  $$('#an-tbody [data-vcon]').forEach(b=>b.onclick=()=>openVConDetalle(+b.dataset.vcon));
