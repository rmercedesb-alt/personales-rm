/* AMCO-GT diario de la compañía (30 días): una consulta a /apiseg/semana por día (4 a la vez); el informe se muestra de inmediato y este calendario se completa solo. */
function rcCalAmcoIniciar(fin,F){
  const token=RC.generadoEn; const C=rcAmcoCfg(), S=rcSubs(C);
  const dias=[]; const f=new Date(fin+'T00:00:00');
  for(let i=29;i>=0;i--){ const d=new Date(f); d.setDate(f.getDate()-i); dias.push({fecha:dateF(d),diaMes:d.getDate(),dow:d.getDay(),valor:null,delta:null}); }
  const activos=dias.filter(d=>d.dow!==0);
  RC.cal={token,dias,hechos:0,total:activos.length,listo:false};
  const canalOk=v=>!F.canales.length||F.canales.includes(String(v.CanID)); let idx=0, vivos=0;
  const terminar=()=>{ dias.forEach(d=>{ const prev=dias.find(x=>x.fecha===dateF(new Date(new Date(d.fecha+'T00:00:00').getTime()-7*864e5))); d.delta=(d.valor!=null&&prev&&prev.valor!=null)?d.valor-prev.valor:null; });
    RC.cal.listo=true; if(RC.generadoEn===token){ const el=$('#rc-cal-amco'); if(el) el.outerHTML=rcCalAmcoHtml(); } };
  const siguiente=()=>{
    if(idx>=activos.length){ if(--vivos===0) terminar(); return; }
    const d=activos[idx++];
    const p=new URLSearchParams({fechaIni:d.fecha,fechaFin:d.fecha,pdvMetros:String(C.pdvMetros||200),pdvModo:C.pdvModo||'distancia'});
    if(F.division.length) p.set('divisiones',F.division.join(',')); if(F.centros.length) p.set('centros',F.centros.join(','));
    if(F.supervisores.length) p.set('supervisores',F.supervisores.join(',')); if(F.vendedores.length) p.set('reps',F.vendedores.join(','));
    fetch(BASE+'/apiseg/semana?'+p.toString()).then(r=>r.json()).then(j=>{ const v=(j&&j.ok&&j.vendedores)?j.vendedores.filter(canalOk):[]; if(v.length){ const t=rcAmcoSemana(v,C,S).total; d.valor=t?t.iegt:null; } })
      .catch(()=>{}).finally(()=>{ RC.cal.hechos++; if(RC.generadoEn===token){ const el=$('#rc-cal-amco'); if(el&&!RC.cal.listo) el.outerHTML=rcCalAmcoHtml(); } siguiente(); });
  };
  for(let w=0;w<4;w++){ vivos++; siguiente(); }
}

/* ── Hallazgos: 2 positivos + 1 oportunidad por punto, contra el comportamiento HABITUAL y ponderado por incidencia ── */
// cand: [{grp,score,txt}] — selecciona 2 positivos (distinto grp si es posible) y 1 oportunidad (la más negativa)
function rcElegir(cand){
  const pos=cand.filter(c=>c.score>0).sort((a,b)=>b.score-a.score); const sel=[];
  const grupos=[...new Set(pos.map(c=>c.grp))];
  grupos.forEach(g=>{ if(sel.length<2){ const c=pos.find(x=>x.grp===g); if(c) sel.push(c); } });
  pos.forEach(c=>{ if(sel.length<2&&!sel.includes(c)) sel.push(c); });
  const neg=cand.filter(c=>c.score<0).sort((a,b)=>a.score-b.score);
  const ocupados=new Set(sel.map(c=>c.sup).filter(Boolean));
  const opp=neg.find(c=>!c.sup||!ocupados.has(c.sup))||neg[0]||null;
  return {pos:sel.slice(0,2),opp};
}
function rcHallazgos(R,A){
  const out={};
  // Punto 1 — Pedidos (Supervisor y Suplidor), RD$ por encima/debajo de su ritmo habitual
  const P=R.pedidos, totP=P.total.presupuesto||1, c1=[];
  [['Supervisor',P.porSupervisor],['Suplidor',P.porSuplidor]].forEach(([dim,rows])=>rows.forEach(r=>{
    if(dim==='Suplidor'&&r.clave==='0') return; if(r.histAlcancePct==null||!r.presupuesto) return;
    const score=r.ejecutado-r.histAlcancePct/100*r.presupuesto, sh=(100*r.presupuesto/totP).toFixed(1);
    const base=dim+' <b>'+r.nombre+'</b>: alcance '+rcPct(r.alcancePct)+' vs '+rcPct(r.histAlcancePct)+' de su ritmo habitual ('+R.histPedidosEtiqueta+')';
    c1.push({grp:dim,sup:dim==='Supervisor'?r.clave:null,score,
      txt:base+(score>=0?' — RD$ '+ppFmtNum(score)+' por encima de lo esperado':' — RD$ '+ppFmtNum(-score)+' por debajo de lo esperado')+' · pesa '+sh+'% del presupuesto del día.'}); }));
  out.pedidos=rcElegir(c1);
  // Punto 2 — Visitas: cumplimiento y efectividad de cada supervisor contra su promedio de 30 días
  const c2=[];
  R.visitas.porSupervisor.forEach(r=>{
    if(r.histCumplimientoPct!=null&&r.cumplimientoPct!=null&&r.aVisitar){
      const sc=r.visitados-r.histCumplimientoPct/100*r.aVisitar;
      c2.push({grp:r.clave,sup:r.clave,score:sc,txt:'<b>'+r.nombre+'</b> — Cumplimiento de visitas '+rcPct(r.cumplimientoPct)+' vs '+rcPct(r.histCumplimientoPct)+' habitual (30 días): '+ppFmtNum(Math.abs(sc))+' clientes '+(sc>=0?'más':'menos')+' visitados de lo esperado.'}); }
    if(r.histEfectividadPct!=null&&r.efectividadPct!=null&&r.visitados){
      const sc=r.pedidos-r.histEfectividadPct/100*r.visitados;
      c2.push({grp:r.clave,sup:r.clave,score:sc,txt:'<b>'+r.nombre+'</b> — Efectividad '+rcPct(r.efectividadPct)+' vs '+rcPct(r.histEfectividadPct)+' habitual (30 días): '+ppFmtNum(Math.abs(sc))+' pedidos '+(sc>=0?'más':'menos')+' de lo esperado.'}); }
  });
  out.visitas=rcElegir(c2);
  // Punto 3 — AMCO-GT: variación vs promedio de las semanas previas, ponderada por # de vendedores
  if(A){
    const c3=[]; A.ref.sups.forEach(s=>{ const b=A.base[s.k]; const ref=b!=null?b:A.ref.total.iegt; const d=s.iegt-ref;
      const peor=Object.values(s.sc).map(x=>({l:x.lbl,per:(100-x.nota)*x.peso/s.tot})).sort((a,b)=>b.per-a.per)[0];
      c3.push({grp:s.k,sup:s.k,score:d*s.n,txt:'<b>'+s.nombre+'</b> — AMCO-GT '+s.iegt.toFixed(1)+' ('+s.banda[0]+') vs '+ref.toFixed(1)+(b!=null?' promedio de los '+A.nHist+' '+A.unidad+' previos':' del nivel compañía')+' ('+rcSgn(d)+') con '+s.n+' vendedores'+(d<0&&peor?'; mayor pérdida de puntos: '+peor.l:'')+'.'}); });
    out.amco=rcElegir(c3);
  } else out.amco=null;
  return out;
}

/* ── Compromisos para el próximo día hábil ── */
function rcCompromisos(R,A){
  const sups={}; const get=(k,n)=>sups[k]||(sups[k]={k,nombre:n,items:[]});
  R.pedidos.porSupervisor.forEach(r=>{ if(r.alcancePct!=null&&r.histAlcancePct!=null) get(r.clave,r.nombre).items.push({t:'ped',dev:r.alcancePct-r.histAlcancePct,a:r.alcancePct,h:r.histAlcancePct}); });
  R.visitas.porSupervisor.forEach(r=>{ const s=get(r.clave,r.nombre);
    if(r.cumplimientoPct!=null&&r.histCumplimientoPct!=null) s.items.push({t:'cum',dev:r.cumplimientoPct-r.histCumplimientoPct,a:r.cumplimientoPct,h:r.histCumplimientoPct});
    if(r.efectividadPct!=null&&r.histEfectividadPct!=null) s.items.push({t:'efe',dev:r.efectividadPct-r.histEfectividadPct,a:r.efectividadPct,h:r.histEfectividadPct}); });
  if(A) A.ref.sups.forEach(x=>{ const b=A.base[x.k]; if(b==null) return; const s=get(x.k,x.nombre);
    const peor=Object.values(x.sc).map(y=>({l:y.lbl,per:(100-y.nota)*y.peso/x.tot})).sort((p,q)=>q.per-p.per)[0];
    s.items.push({t:'amco',dev:x.iegt-b,a:x.iegt,h:b,foco:peor?peor.l:''}); });
  const frase=it=>{
    if(it.t==='ped') return ['Pedidos vs presupuesto','Alcance de '+rcPct(it.a)+' vs '+rcPct(it.h)+' habitual. Compromiso: volver a su ritmo habitual (≥ '+rcPct(it.h)+') con foco en recuperar los clientes y suplidores de mayor peso.'];
    if(it.t==='cum') return ['Cumplimiento de visitas','Cumplió '+rcPct(it.a)+' de la ruta vs '+rcPct(it.h)+' habitual. Compromiso: visitar al menos '+rcPct(it.h)+' de los clientes programados.'];
    if(it.t==='efe') return ['Efectividad de la visita','Efectividad '+rcPct(it.a)+' vs '+rcPct(it.h)+' habitual. Compromiso: cerrar pedido en al menos '+rcPct(it.h)+' de los clientes visitados.'];
    return ['AMCO-GT','AMCO-GT '+it.a.toFixed(1)+' vs '+it.h.toFixed(1)+' promedio previo'+(it.foco?'. Compromiso: recuperar puntos en «'+it.foco+'»':'')+'.'];
  };
  const filas=Object.values(sups).map(s=>{ const w=s.items.slice().sort((a,b)=>a.dev-b.dev)[0]; return w&&w.dev<-2?{s,w}:null; }).filter(Boolean).sort((a,b)=>a.w.dev-b.w.dev)
    .map(({s,w})=>{ const [tema,txt]=frase(w); return {quien:s.nombre,tema,txt,dev:w.dev}; });
  // Lo más importante de la compañía: la métrica total más por debajo de su comportamiento habitual
  const comp=[]; const tp=R.pedidos.total, tv=R.visitas.total;
  if(tp.alcancePct!=null&&tp.histAlcancePct!=null) comp.push({t:'ped',dev:tp.alcancePct-tp.histAlcancePct,a:tp.alcancePct,h:tp.histAlcancePct});
  if(tv.cumplimientoPct!=null&&tv.histCumplimientoPct!=null) comp.push({t:'cum',dev:tv.cumplimientoPct-tv.histCumplimientoPct,a:tv.cumplimientoPct,h:tv.histCumplimientoPct});
  if(tv.efectividadPct!=null&&tv.histEfectividadPct!=null) comp.push({t:'efe',dev:tv.efectividadPct-tv.histEfectividadPct,a:tv.efectividadPct,h:tv.histEfectividadPct});
  if(A&&A.baseTotal!=null) comp.push({t:'amco',dev:A.ref.total.iegt-A.baseTotal,a:A.ref.total.iegt,h:A.baseTotal});
  const w=comp.slice().sort((a,b)=>a.dev-b.dev)[0]; let compania;
  if(w&&w.dev<-1){
    const [tema,txt]=frase(w); let drv='';
    const top=(rows,fn)=>rows.map(r=>({n:r.nombre,v:fn(r)})).filter(x=>x.v<0).sort((a,b)=>a.v-b.v).slice(0,2).map(x=>x.n+' ('+ppFmtNum(x.v)+')').join(', ');
    if(w.t==='ped') drv=top(R.pedidos.porSupervisor,r=>r.histAlcancePct==null?0:r.ejecutado-r.histAlcancePct/100*r.presupuesto);
    if(w.t==='cum') drv=top(R.visitas.porSupervisor,r=>r.histCumplimientoPct==null?0:r.visitados-r.histCumplimientoPct/100*r.aVisitar);
    if(w.t==='efe') drv=top(R.visitas.porSupervisor,r=>r.histEfectividadPct==null?0:r.pedidos-r.histEfectividadPct/100*r.visitados);
    if(w.t==='amco'&&A) drv=A.ref.sups.filter(s=>A.base[s.k]!=null).map(s=>({n:s.nombre,v:(s.iegt-A.base[s.k])*s.n})).filter(x=>x.v<0).sort((a,b)=>a.v-b.v).slice(0,2).map(x=>x.n).join(', ');
    compania={quien:'COMPAÑÍA',tema,txt:txt+(drv?' Mayor aporte a la brecha: '+drv+'.':''),dev:w.dev};
  } else compania={quien:'COMPAÑÍA',tema:'Sostener el ritmo',txt:'La compañía cerró en o por encima de su comportamiento habitual en pedidos, cumplimiento, efectividad y AMCO-GT. Compromiso: sostener el ritmo.',dev:0};
  return {compania,filas};
}

