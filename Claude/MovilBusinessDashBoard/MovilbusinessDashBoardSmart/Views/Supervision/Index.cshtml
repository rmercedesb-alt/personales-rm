// ── boot ──
// OJO: NUNCA usar x.toISOString() para fechas de calendario — convierte a UTC
// antes de formatear, y RD es UTC-4 sin horario de verano, así que después de
// las 8:00 PM ya "es mañana" en UTC (bug real encontrado 2026-09-03: Cierre
// Diario saltaba solo al día siguiente por la noche). getFullYear/getMonth/
// getDate son locales, no UTC — mismo criterio en TODAS las fechas "de hoy" de
// este archivo (dateF de aquí, la f() local de ppNextWeekRange, y los usos
// sueltos de cd-fecha/cbrDesde/cbrHasta/etc. más abajo).
const dateF=x=>x.getFullYear()+'-'+String(x.getMonth()+1).padStart(2,'0')+'-'+String(x.getDate()).padStart(2,'0');
function lastMonSat(){const d=new Date();const dow=d.getDay();let back=((dow-6+7)%7);if(back===0)back=7;const sat=new Date(d);sat.setDate(d.getDate()-back);const mon=new Date(sat);mon.setDate(sat.getDate()-5);return [dateF(mon),dateF(sat)];}
function venOpts(supcods){const list=(supcods&&supcods.length)?REPS.filter(r=>supcods.includes(r.SupCod)):REPS;return list.map(r=>({v:r.RepCodigo,t:r.RepNombre+' · '+r.RepCodigo}));}
function fillFilters(){
  const sups=[...new Map(REPS.filter(r=>r.SupCod).map(r=>[r.SupCod,r.Supervisor])).entries()].map(([c,n])=>({v:c,t:(n||c)+' · '+c}));
  const divs=[...new Set(REPS.map(r=>r.Division).filter(Boolean))].sort().map(d=>({v:d,t:'Div '+d}));
  const defDiv=divs.filter(d=>d.v==='10'||d.v==='11').map(d=>d.v);
  ['pl','rg'].forEach(pf=>{
    FILT[pf].sup=msel($('#'+pf+'-sup'),sups,{placeholder:'Todos',onChange:()=>{FILT[pf].ven.setOptions(venOpts(FILT[pf].sup.values()));buildMatrix(pf);}});
    FILT[pf].ven=msel($('#'+pf+'-ven'),venOpts([]),{placeholder:'Todos',onChange:()=>buildMatrix(pf)});
    FILT[pf].div=msel($('#'+pf+'-divs'),divs,{default:defDiv,onChange:()=>buildMatrix(pf)});
  });
  FILT.an={};
  FILT.an.sup=msel($('#an-sup'),sups,{placeholder:'Todos',onChange:()=>FILT.an.ven.setOptions(venOpts(FILT.an.sup.values()))});
  FILT.an.ven=msel($('#an-ven'),venOpts([]),{placeholder:'Todos'});
  FILT.an.tipo=msel($('#an-tipo'),[{v:'acomp',t:'Acompañamiento'},{v:'audit',t:'Auditoría'},{v:'virtual',t:'Virtual'}],{placeholder:'Todos'});
}
