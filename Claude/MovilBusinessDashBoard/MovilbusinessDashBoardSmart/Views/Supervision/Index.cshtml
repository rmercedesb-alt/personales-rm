      else { avisoEl.textContent=(j&&j.error)||'No se pudo enviar'; avisoEl.style.display='block'; }
    }).catch(e=>{ btn.disabled=false; btn.textContent=t0; avisoEl.textContent='Error: '+e; avisoEl.style.display='block'; });
}
