/* ── REPORTE + firma + guardar ── */
let lastPayload=null;
function buildReport(m,payload){
  lastPayload=payload; const fs=facFor(m),arr=consArr(m),tot=weighted(arr,fs);
  const iegt=null,ac=m==='acomp'?tot:weighted(consArr('acomp'),FACAcomp),au=m==='audit'?tot:weighted(consArr('audit'),FACAudit);
  const g=globalIdx(iegt,ac,au);
