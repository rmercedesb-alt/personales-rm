/* ── CRONOGRAMA semanal ── */
let CRONO={dias:['Lun','Mar','Mié','Jue','Vie','Sáb'],filas:[],supervisores:[]};
const CRTIPOS=[['presencial','Presencial'],['auditoria','Auditoría'],['virtual','Virtual']];
const CRNOM={presencial:'Presencial',auditoria:'Auditoría',virtual:'Virtual'};
function loadCrono(cb){ api('/cronograma').then(j=>{ if(j&&j.ok){CRONO={dias:j.dias,filas:j.filas,supervisores:j.supervisores||[]};} if(cb)cb(); }).catch(e=>toast('Error cronograma: '+e)); }
function iegtOf(rep){ const r=(MATRIX.pl.rows||[]).find(x=>x.rep===rep); return r?r.iegt:null; }
function diaHoyIdx(){ const gd=new Date().getDay(); return gd===0?-1:gd-1; }
function monthKey(iso){ return iso?iso.slice(0,7):''; }
function buildAgenda(dias,reps){
  reps.forEach(r=>r._iegt=iegtOf(r.rep));
  const mk=dateF(new Date()).slice(0,7);
  // Cola única: TODOS los vendedores del supervisor, ordenados por Prioritario primero y luego peor IEGT.
  // No se recorta por cantidad: se sugieren todos los días a todos, y el supervisor decide cuántos
  // atender según su capacidad real (la prioridad ya le indica por dónde empezar).
  const queue=reps.slice().sort((a,b)=>{
    const pa=a.prioritario?1:0, pb=b.prioritario?1:0;
    if(pa!==pb) return pb-pa;
    const ia=(a._iegt==null?999:a._iegt), ib=(b._iegt==null?999:b._iegt);
    if(ia!==ib) return ia-ib;
    return (a.nombre||'').localeCompare(b.nombre||'');
  });
  const plan={};
  for(let i=0;i<6;i++){
    const tipo=dias[i];
    plan[i]=queue.map(r=>{
      const sinMes=!(r.ultPresencial&&monthKey(r.ultPresencial)===mk);
      let razon=r.prioritario?'⭐ Prioritario':(r._iegt!=null?'IEGT '+r._iegt:'Sin IEGT');
      if(tipo==='presencial'&&sinMes) razon+=' · sin acompañar este mes';
      return {nom:r.nombre,prioritario:!!r.prioritario,razon:razon};
    });
  }
  return plan;
}
let cronoMode='auto';
function renderCronoView(){
  const box=$('#pl-crono');
  if(!CRONO.filas.length){ box.innerHTML='<div class="hint">Configura el cronograma en <b>⚙ Configurar cronograma</b> y genera la Priorización (para el IEGT).</div>'; return; }
  box.innerHTML='<div class="subtabs" style="margin-bottom:10px"><button class="'+(cronoMode==='auto'?'on':'')+'" data-cm="auto">💡 Sugerida (auto)</button><button class="'+(cronoMode==='grid'?'on':'')+'" data-cm="grid">✎ Por vendedor (editable)</button></div><div id="crono-content"></div>';
  $$('#pl-crono .subtabs button').forEach(b=>b.onclick=()=>{cronoMode=b.dataset.cm;renderCronoView();});
  if(cronoMode==='auto')renderCronoAuto(); else renderCronoGridPlan();
}
function renderCronoAuto(){
  const box=$('#crono-content'),di=diaHoyIdx();
  const bySup={}; CRONO.filas.forEach(f=>{ (bySup[f.supcod]=bySup[f.supcod]||[]).push(f); });
  let h='<div class="note"><span>🗓️</span><div>Agenda sugerida de la semana. <b>Todos los días se sugieren TODOS los vendedores del supervisor</b> (aunque en la práctica solo se pueda atender a algunos): el orden manda — primero los marcados <b>⭐ Prioritario</b>, luego el <b>peor IEGT</b>. Use ese orden para decidir a quién atender primero según su capacidad del día.</div></div>';
  (CRONO.supervisores||[]).forEach(S=>{ const reps=bySup[S.supcod]||[]; if(!reps.length)return;
    const plan=buildAgenda(S.dias,reps);
    h+='<div class="sec-title" style="margin:16px 0 6px"><h3>'+(S.nombre||S.supcod)+'</h3><span class="n">'+reps.length+' vendedores · patrón '+cadOf(S.dias)+'</span></div>';
    h+='<div class="scroller"><table class="crono"><thead><tr>';
    CRONO.dias.forEach((d,i)=>{ h+='<th style="'+(i===di?'color:var(--accent2);':'')+'min-width:170px">'+d+(i===di?' • hoy':'')+'<div style="font-weight:400;margin-top:3px"><span class="ctag '+S.dias[i]+'">'+CRNOM[S.dias[i]]+'</span></div></th>'; });
    h+='</tr></thead><tbody><tr>';
    for(let i=0;i<6;i++){ const it=plan[i],bg=i===di?'background:var(--panel2);':''; h+='<td style="'+bg+'vertical-align:top;padding:6px"><div style="max-height:280px;overflow-y:auto">'+(it.length?it.map(x=>'<div style="text-align:left;margin-bottom:7px;'+(x.prioritario?'border-left:3px solid var(--bad);padding-left:6px':'')+'"><div style="font-weight:700;font-size:12px">'+x.nom+'</div><div style="font-size:10px;color:'+(x.prioritario?'var(--bad)':'var(--muted)')+'">'+x.razon+'</div></div>').join(''):'<span style="color:var(--muted);font-size:11px">—</span>')+'</div></td>'; }
    h+='</tr></tbody></table></div>';
  });
  box.innerHTML=h;
}
