  // Aviso + KPIs
  h+='<div class="pp-block">'
    +(d.meta.mesCerrado?'':'<div class="rg-warn" data-html2canvas-ignore="true">⚠️ '+MN+' '+A+' todavía no está cerrado en el presupuesto (Ejecutado ≠ Proyectado): los números pueden cambiar. Usa "Actualizar datos" cuando cierre.</div>')
    +'<div class="rg-h2">Capa 1 · Plataforma general</div>'+rgTxt('CAPA1_INTRO','rg-intro')
    +'<div class="pp-resumen">'
      +'<div class="pp-kpi"><div class="k">Ejecutado '+MA+' (ex-Institucional)</div><div class="v">'+rgM(K.ejecT)+'</div><div style="font-size:11px;color:#57606a">Forecast '+rgM(K.presuT)+'</div></div>'
      +'<div class="pp-kpi"><div class="k">% Forecast</div><div class="v">'+rgDot(rgSem(K.pctT))+rgP(K.pctT)+'</div></div>'
      +'<div class="pp-kpi"><div class="k">Interanual · reportado / pera con pera</div><div class="v" style="font-size:20px">'+rgSP(L.yoyReportado)+' <span style="color:#57606a;font-weight:600">/</span> '+rgSP(L.yoyComparable)+'</div></div>'
    +'</div>'
    +rgTabla(['Vista','Ejecutado '+MA,'Forecast','% Forecast','Δ% interanual','Δ% pera con pera'],
      [['<b>Total AM</b>',rgRD(K.ejecT),rgRD(K.presuT),rgDot(rgSem(K.pctT))+rgP(K.pctT),rgSP(L.yoyReportado),rgSP(L.yoyComparable)]]
      .concat(K.cs.map(c=>{ const X=K.C[c]; return [c,rgRD(X.ejec),rgRD(X.presu),rgDot(rgSem(X.pct))+rgP(X.pct),rgSP(X.lfl.yoyReportado),rgSP(X.lfl.yoyComparable)]; })))
    +rgLect('CAP_KPI')+'</div>';
  // Puente
  h+='<div class="pp-block"><div class="rg-sub">Puente interanual pera con pera — '+MN+' '+P+' → '+MN+' '+A+' (RD$ millones)</div>'+rgCanvas('rg-c-bridge',true)+rgLect('CAP_BRIDGE')
    +'<div style="font-size:11px;color:#57606a;margin-top:6px">Excluidas del año '+P+' (descontinuadas): '+(L.descontinuadas.map(x=>rgEsc(x.suplidor)).join(', ')||'ninguna')+(L.galleteriaAnterior?' + categoría GALLETERIA':'')
    +'. Excluidas del año '+A+' (nuevas): '+(L.nuevas.map(x=>rgEsc(x.suplidor)).join(', ')||'ninguna')+'.</div></div>';
  // Serie + forecast
  h+='<div class="pp-block"><div class="rg-g2"><div><div class="rg-sub">Venta neta mensual '+A+' vs '+P+'</div>'+rgCanvas('rg-c-series')+'</div>'
    +'<div><div class="rg-sub">Cumplimiento vs forecast por canal — '+MN+'</div>'+rgCanvas('rg-c-forecast')+'</div></div>'+rgLect('CAP_SERIES')
    +rgTabla(['Centro','Canal','Presupuesto','Ejecutado','% Cumpl.'],
      d.forecast.map(f=>[rgEsc(f.centro),rgEsc(f.canal)+(K.esInst(f)?' (Caobo)*':''),rgRD(f.presupuesto),rgRD(f.ejecutado),rgDot(rgSem(f.presupuesto?f.ejecutado/f.presupuesto:null))+rgP(f.presupuesto?f.ejecutado/f.presupuesto:null)]),
      ['TOTAL (ex-Institucional)','',rgRD(K.presuT),rgRD(K.ejecT),rgDot(rgSem(K.pctT))+rgP(K.pctT)],2)
    +'<div style="font-size:11px;color:#57606a;margin-top:4px">* Institucional = Inversiones Caobo: se excluye del % Forecast.</div></div>';
  // Bloques por centro
  K.cs.forEach((c,i)=>{
    const X=K.C[c], k='C'+(i+1)+'_', op=X.op, letra=String.fromCharCode(65+i), azul=c==='Santo Domingo';
    h+='<div class="pp-block"><div class="rg-h2'+(azul?' azul':'')+'">Bloque '+letra+' · '+rgEsc(c)+'</div>'+rgTxt(k+'intro','rg-intro')
      +'<div class="rg-sub">1 · Indicadores de operación</div>'
      +rgTabla(['Indicador','Valor '+MA+' '+A],[
        ['Venta neta '+MN,rgRD(op.venta)],['Productividad por día hábil (÷'+d.meta.diasHabiles+')',rgRD(op.porDia)],['Ticket promedio (venta ÷ facturas)',rgRD(op.ticket)],
        ['Clientes activos (facturados)',rgN(op.activos)],['Cartera (clientes en ruta, distinta)',rgN(op.cartera)],['Activación de cartera',rgP(op.activacion)],
        ['Efectividad de visita (con pedido ÷ realizadas)',rgP(op.efectividad)]])+rgLect(k+'op')+'</div>';
    const top=X.prov.slice(0,4), otros=X.prov.slice(4);
    const filasP=top.map(p=>[rgEsc(p.nombre),rgRD(p.neto),rgP(X.totProv?p.neto/X.totProv:0),rgN(p.clientes),rgN(p.facturas)]);
    if(otros.length) filasP.push(['<span style="color:#6E6E6E">Otros ('+otros.length+')</span>',rgRD(otros.reduce((a,p)=>a+p.neto,0)),rgP(X.totProv?otros.reduce((a,p)=>a+p.neto,0)/X.totProv:0),'—','—']);
    h+='<div class="pp-block"><div class="rg-sub">2 · Proveedores (Top 4 + Otros) y categorías</div><div class="rg-g2"><div>'+rgCanvas('rg-c-prov-'+(i+1))+'</div><div>'+rgCanvas('rg-c-cat-'+(i+1))+'</div></div>'
      +rgTabla(['Proveedor','Neto '+MA,'% part.','Clientes','Facturas'],filasP,['TOTAL (sin devoluciones)',rgRD(X.totProv),'100,0%','',''])+rgLect(k+'prov')+'</div>';
    const segs=[['A Grande','A'],['B Mediano','B'],['C Pequeño','C'],['D Muy pequeño','D'],['Sin clasif.','SC']];
    h+='<div class="pp-block"><div class="rg-sub">3 · Clientes A·B·C·D y campana de cumplimiento de cuota</div><div class="rg-g2"><div>'+rgCanvas('rg-c-abcd-'+(i+1))+'</div><div>'+rgCanvas('rg-c-gauss-'+(i+1))+'</div></div>'
      +rgTabla(['Segmento','Neto '+MA,'% part.','Clientes','Prod/cliente'],segs.map(([lbl,s])=>{ const x=X.ab[s]||{neto:0,clientes:0}; return [lbl,rgRD(x.neto),rgP(X.totAb?x.neto/X.totAb:0),rgN(x.clientes),rgRD(x.clientes?x.neto/x.clientes:0)]; }),
        ['TOTAL',rgRD(X.totAb),'100,0%',rgN(segs.reduce((a,[l,s])=>a+((X.ab[s]||{}).clientes||0),0)),''])+rgLect(k+'abcd')+'</div>';
    const gs=Object.entries(X.grupos).sort((a,b)=>b[1].neto-a[1].neto), gTot=gs.reduce((a,[g,v])=>a+v.neto,0);
    h+='<div class="pp-block"><div class="rg-sub">4 · Fuerza de venta — cumplimiento de cuota y efectividad</div>'
      +rgTabla(['Fuerza de venta','Vendedores','Cuota','Ejecutado','% Cuota','Venta neta','% del centro'],
        gs.map(([g,v])=>[rgGrupo(g),v.n,rgRD(v.cuota),rgRD(v.ejec),rgDot(rgSem(v.cuota?v.ejec/v.cuota:null))+rgP(v.cuota?v.ejec/v.cuota:null),rgRD(v.neto),rgP(gTot?v.neto/gTot:0)]))
      +rgLect(k+'ffvv')+'</div>';
    h+='<div class="pp-block">'+rgTabla(['Vendedor','Grupo','Cuota','Ejecutado','% Cuota','Efectividad'],
        X.vs.map(v=>{ const pc=v.cuota>0?v.ejecutado/v.cuota:null; return [rgEsc(v.nombre)+' <span style="color:#6E6E6E">('+rgEsc(v.codigo)+')</span>',rgGrupo(v.grupo),v.cuota>0?rgRD(v.cuota):'s/cuota',rgRD(v.ejecutado),pc==null?'—':rgDot(rgSem(pc))+rgP(pc),v.visitas?rgP(v.conPedido/v.visitas):'—']; }),
        ['TOTAL centro','',rgRD(X.vs.reduce((a,v)=>a+v.cuota,0)),rgRD(X.vs.reduce((a,v)=>a+v.ejecutado,0)),rgP(X.vs.reduce((a,v)=>a+v.cuota,0)?X.vs.reduce((a,v)=>a+v.ejecutado,0)/X.vs.reduce((a,v)=>a+v.cuota,0):null),rgP(op.efectividad)],2)
      +'<div class="rg-cap" style="margin-top:10px">'+rgDot(rgSem(X.pct))+'<b>Señal: </b><span class="rg-ed" contenteditable="true" data-rgk="'+k+'senal">'+rgEsc(RG.narr[k+'senal']||'')+'</span></div></div>';
  });
  // Colombina
  h+='<div class="pp-block"><div class="rg-h2">Apéndice · Colombina — Top 5 SKU por centro</div>'+rgTxt('COLO_INTRO','rg-intro')
    +'<div class="rg-g2">'+K.cs.map((c,i)=>'<div><div class="rg-sub">'+rgEsc(c)+' — Colombina total '+rgRD((d.colombina[c]||{}).total)+'</div>'+rgCanvas('rg-c-colo-'+(i+1))+'</div>').join('')+'</div>'
    +K.cs.map(c=>{ const x=d.colombina[c]||{total:0,top:[]}; return rgTabla([rgEsc(c)+' · SKU','Neto','% de Colombina','Clientes'],x.top.map(t=>[rgEsc(t.sku),rgRD(t.neto),rgP(x.total?t.neto/x.total:0),rgN(t.clientes)]),
      ['Top 5 subtotal',rgRD(x.top.reduce((a,t)=>a+t.neto,0)),rgP(x.total?x.top.reduce((a,t)=>a+t.neto,0)/x.total:0),'']); }).join('<div style="height:10px"></div>')
    +rgLect('COLO_CAP')+'</div>';
  // Cierre - acciones
  h+='<div class="pp-block"><div class="rg-h2">Cierre · Conclusiones y recomendaciones accionables</div>'
    +'<div class="rg-intro">Las señales del informe traducidas a acción: qué pasó, dónde, qué hacer, con dueño y fecha. <span data-html2canvas-ignore="true" style="color:#0C9444">Haz clic en cualquier celda para editarla; en el punto de color para cambiar el semáforo.</span></div>'
    +'<div class="scroller"><table class="rg-acc"><thead><tr><th class="l">Señal</th><th class="l">Qué pasó / Dónde</th><th class="l">Qué hacer</th><th class="l">Responsable</th><th class="l">Fecha</th><th data-html2canvas-ignore="true"></th></tr></thead><tbody>'
    +RG.acciones.map((a,ix)=>'<tr><td class="l" style="min-width:150px"><span class="rg-dot click '+a.sem+'" data-rg-sem="'+ix+'" title="Cambiar semáforo"></span><b class="rg-ed" contenteditable="true" data-rg-acc="'+ix+'" data-rg-f="senal">'+rgEsc(a.senal)+'</b></td>'
      +['que','hacer','resp','fecha'].map(f=>'<td class="l rg-ed" contenteditable="true" data-rg-acc="'+ix+'" data-rg-f="'+f+'">'+rgEsc(a[f])+'</td>').join('')
      +'<td data-html2canvas-ignore="true"><button class="rbtn" data-rg-del="'+ix+'" title="Quitar fila">✕</button></td></tr>').join('')
    +'</tbody></table></div><button class="rbtn" id="rg-acc-add" data-html2canvas-ignore="true" style="margin-top:8px">＋ Agregar acción</button></div>';
  // Caobo
  if((d.caobo||[]).length){
    const cb=d.caobo, t=k=>cb.reduce((a,x)=>a+x[k],0);
    h+='<div class="pp-block"><div class="rg-h2">Apéndice · Ventas a Inversiones Caobo (intercompañía) por suplidor</div>'+rgTxt('CAOBO_INTRO','rg-intro')
      +'<div class="rg-g2"><div>'+rgTabla(['Suplidor','Neto '+A,'Con ITBIS '+A,'Neto '+P,'Δ%'],cb.map(x=>[rgEsc(x.suplidor),rgRD(x.neto),rgRD(x.conItbis),rgRD(x.netoAnterior),x.netoAnterior?rgSP(x.neto/x.netoAnterior-1):'—']),
        ['TOTAL',rgRD(t('neto')),rgRD(t('conItbis')),rgRD(t('netoAnterior')),t('netoAnterior')?rgSP(t('neto')/t('netoAnterior')-1):'—'])+'</div><div>'+rgCanvas('rg-c-caobo')+'</div></div>'+rgLect('CAOBO_CAP')+'</div>';
  }
  const rc=d.reconciliacion||{};
  h+='<div class="pp-block pp-foot"><div>Reconciliación: venta neta ex-Caobo '+rgRD(rc.ventas)+' vs Ejecutado oficial del presupuesto (ex-Institucional) '+rgRD(rc.ejecutadoOficial)+' — diferencia '+rgSP(rc.diferenciaPct)+' (productos fuera del presupuesto).</div>'
    +'<div style="margin-top:10px">Preparado por: <b>'+rgEsc(ID.nombre||'Gerencia Comercial')+'</b> · AM Comercial — Confidencial</div></div>';
  h+='</div></div>';
  $('#rg-reporte').innerHTML=h;
  rgWire(); rgEnsureChart(()=>rgGraficas(d,K));
}

function rgWire(){
  const host=$('#rg-reporte');
  $$('[data-rgk]',host).forEach(el=>el.addEventListener('input',()=>{ RG.narr[el.dataset.rgk]=el.innerText.trim(); }));
  $$('[data-rg-acc]',host).forEach(el=>el.addEventListener('input',()=>{ RG.acciones[+el.dataset.rgAcc][el.dataset.rgF]=el.innerText.trim(); }));
  $$('[data-rg-sem]',host).forEach(el=>el.onclick=()=>{ const a=RG.acciones[+el.dataset.rgSem]; a.sem=a.sem==='G'?'Y':(a.sem==='Y'?'R':'G'); el.className='rg-dot click '+a.sem; });
  $$('[data-rg-del]',host).forEach(b=>b.onclick=()=>{ RG.acciones.splice(+b.dataset.rgDel,1); rgRender(); });
  const add=$('#rg-acc-add',host); if(add) add.onclick=()=>{ RG.acciones.push({sem:'Y',senal:'Nueva señal',que:'',hacer:'',resp:'',fecha:''}); rgRender(); };
}

/* ── Gráficas (Chart.js, ya vendorizado en /lib) ── */
function rgEnsureChart(cb){ if(window.Chart){cb();return;} const s=document.createElement('script'); s.src=BASE+'/lib/chart.umd.min.js'; s.onload=()=>cb(); s.onerror=()=>toast('No se pudo cargar el generador de gráficas'); document.head.appendChild(s); }
// Etiqueta de valor sobre cada barra (sin plugins externos: chartjs-plugin-datalabels no está vendorizado).
const RG_LBL={id:'rgLbl',afterDatasetsDraw(ch,args,opt){ if(!opt||!opt.fmt) return; const ctx=ch.ctx; ctx.save(); ctx.font='600 10px Arial'; ctx.fillStyle='#3a3a3a';
  ch.data.datasets.forEach((ds,di)=>{ const meta=ch.getDatasetMeta(di); if(meta.hidden) return; meta.data.forEach((el,i)=>{ const v=ds.data[i]; if(v==null) return; const txt=opt.fmt(v,i,di); if(!txt) return;
    const p=el.tooltipPosition(); if(ch.options.indexAxis==='y'){ ctx.textAlign='left'; ctx.textBaseline='middle'; ctx.fillText(txt,Math.max(el.x,el.base)+4,p.y); }
    else { ctx.textAlign='center'; ctx.textBaseline='bottom'; ctx.fillText(txt,p.x,Math.min(el.y,el.base)-3); } }); }); ctx.restore(); }};
function rgChart(id, cfg){
  const cv=document.getElementById(id); if(!cv) return null;
  cfg.options=Object.assign({responsive:true,maintainAspectRatio:false,animation:false,devicePixelRatio:2},cfg.options||{});
  cfg.options.plugins=Object.assign({legend:{labels:{boxWidth:12,font:{size:11}}}},cfg.options.plugins||{});
  cfg.plugins=(cfg.plugins||[]).concat([RG_LBL,{id:'rgBg',beforeDraw(ch){ const c=ch.ctx; c.save(); c.fillStyle='#fff'; c.fillRect(0,0,ch.width,ch.height); c.restore(); }}]);
  return new Chart(cv, cfg);
}
function rgGraficas(d,K){
  Object.values(RG.charts).forEach(c=>{ try{c.destroy();}catch(e){} }); RG.charts={};
  const M=d.meta.mes, A=d.meta.anio, P=d.meta.anioAnterior, L=d.lfl, mm=v=>v/1e6, fm=v=>(Array.isArray(v)?(v[1]-v[0]):v).toLocaleString('es-DO',{maximumFractionDigits:1});
  const sem=p=>RG_COL[rgSem(p)||'Y'];
  if(L.hayAnterior){
    const r0=mm(L.reportadoAnterior), c0=mm(L.comparableAnterior), c1=mm(L.comparableActual), r1=mm(L.reportadoActual);
    RG.charts.bridge=rgChart('rg-c-bridge',{type:'bar',data:{labels:[RG_MA[M-1]+' '+P+' reportado','Marcas que salieron','Δ negocio continuo','Líneas nuevas',RG_MA[M-1]+' '+A+' reportado'],
      datasets:[{data:[[0,r0],[c0,r0],[c0,c1],[c1,r1],[0,r1]],backgroundColor:[RG_COL.gris,RG_COL.R,c1>=c0?RG_COL.G:RG_COL.R,RG_COL.G,RG_COL.carbon]}]},
      options:{plugins:{legend:{display:false},rgLbl:{fmt:(v,i)=>(i===1?'−':(i===2&&c1<c0?'−':(i===3||(i===2&&c1>=c0)?'+':'')))+Math.abs(v[1]-v[0]).toLocaleString('es-DO',{maximumFractionDigits:1})}},
        scales:{y:{beginAtZero:true,title:{display:true,text:'RD$ millones'}},x:{grid:{display:false}}}}});
  }
  const ds=[]; const pal=[RG_COL.azul,RG_COL.verde,'#7a4fb3','#c46a1b'];
  ds.push({label:'Total AM '+A,data:Array.from({length:M},(_,m)=>mm(K.cs.reduce((a,c)=>a+(d.serieActual[c][m]||0),0))),borderColor:RG_COL.carbon,backgroundColor:RG_COL.carbon,borderWidth:2.5,tension:.25});
  K.cs.forEach((c,i)=>ds.push({label:c+' '+A,data:Array.from({length:M},(_,m)=>mm(d.serieActual[c][m]||0)),borderColor:pal[i%4],backgroundColor:pal[i%4],tension:.25}));
  if(L.hayAnterior) ds.push({label:'Total AM '+P,data:Array.from({length:M},(_,m)=>mm(K.cs.reduce((a,c)=>a+((d.serieAnterior[c]||[])[m]||0),0))),borderColor:'#aab2bd',backgroundColor:'#aab2bd',borderDash:[5,4],tension:.25});
  RG.charts.series=rgChart('rg-c-series',{type:'line',data:{labels:RG_MA.slice(0,M),datasets:ds},options:{scales:{y:{title:{display:true,text:'RD$ millones'}}}}});
  const can=d.forecast.filter(f=>!K.esInst(f)&&f.presupuesto>0);
  RG.charts.forecast=rgChart('rg-c-forecast',{type:'bar',data:{labels:can.map(f=>rgCorto(f.centro)+' · '+f.canal),datasets:[{data:can.map(f=>f.ejecutado/f.presupuesto*100),backgroundColor:can.map(f=>sem(f.ejecutado/f.presupuesto))}]},
    options:{indexAxis:'y',plugins:{legend:{display:false},rgLbl:{fmt:v=>v.toFixed(1)+'%'}},scales:{x:{beginAtZero:true,suggestedMax:115,title:{display:true,text:'% del forecast'}}}}});
  K.cs.forEach((c,i)=>{
    const X=K.C[c], n=i+1, col=c==='Santo Domingo'?RG_COL.azul:RG_COL.verde;
    const top=X.prov.slice(0,4), ot=X.prov.slice(4).reduce((a,p)=>a+p.neto,0);
    const lb=top.map(p=>p.nombre).concat(ot?['Otros']:[]), vv=top.map(p=>mm(p.neto)).concat(ot?[mm(ot)]:[]);
    RG.charts['prov_'+n]=rgChart('rg-c-prov-'+n,{type:'bar',data:{labels:lb,datasets:[{data:vv,backgroundColor:lb.map(l=>l==='Otros'?'#c9ced6':col)}]},
      options:{indexAxis:'y',plugins:{legend:{display:false},title:{display:true,text:c+' — Proveedores (RD$ M)',align:'start',color:RG_COL.carbon},rgLbl:{fmt:fm}},scales:{x:{beginAtZero:true,grace:'12%'}}}});
    const cats=(d.categorias[c]||[]).filter(x=>x.nombre!=='Otros').slice(0,10);
    RG.charts['cat_'+n]=rgChart('rg-c-cat-'+n,{type:'bar',data:{labels:cats.map(x=>x.nombre),datasets:[{data:cats.map(x=>mm(x.neto)),backgroundColor:col}]},
      options:{indexAxis:'y',plugins:{legend:{display:false},title:{display:true,text:c+' — Top 10 categorías (RD$ M)',align:'start',color:RG_COL.carbon},rgLbl:{fmt:fm}},scales:{x:{beginAtZero:true,grace:'12%'},y:{ticks:{font:{size:10}}}}}});
    const tri=d.meta.trimestre, segs=['A','B','C','D','SC'], shades=['#c9ced6','#9DB4D8',col];
    RG.charts['abcd_'+n]=rgChart('rg-c-abcd-'+n,{type:'bar',data:{labels:segs.map(s=>s==='SC'?'Sin clasif.':s),
      datasets:tri.map((m,j)=>({label:RG_MA[m-1],data:segs.map(s=>mm((((d.abcd[c]||{})[String(m)]||{})[s]||{}).neto||0)),backgroundColor:shades[j+(3-tri.length)]}))},
      options:{plugins:{title:{display:true,text:c+' — Venta por segmento A·B·C·D (RD$ M)',align:'start',color:RG_COL.carbon}},scales:{y:{beginAtZero:true}}}});
    const bk=[[0,.7,'<70%'],[.7,.85,'70–85%'],[.85,1,'85–100%'],[1,1.15,'100–115%'],[1.15,99,'>115%']];
    const pcts=X.conCuota.map(v=>v.ejecutado/v.cuota);
    RG.charts['gauss_'+n]=rgChart('rg-c-gauss-'+n,{type:'bar',data:{labels:bk.map(b=>b[2]),datasets:[{data:bk.map(b=>pcts.filter(p=>p>=b[0]&&p<b[1]).length),backgroundColor:[RG_COL.R,RG_COL.R,RG_COL.Y,RG_COL.G,RG_COL.G]}]},
      options:{plugins:{legend:{display:false},title:{display:true,text:c+' — Vendedores por % de cuota · '+X.sobre+'/'+X.conCuota.length+' sobre cuota',align:'start',color:RG_COL.carbon},rgLbl:{fmt:v=>v?String(v):''}},
        scales:{y:{beginAtZero:true,ticks:{precision:0},grace:'10%',title:{display:true,text:'N° vendedores'}}}}});
    const co=(d.colombina[c]||{top:[]}).top;
    RG.charts['colombina_'+n]=rgChart('rg-c-colo-'+n,{type:'bar',data:{labels:co.map(t=>t.sku.replace(/\s*\(.*$/,'')),datasets:[{data:co.map(t=>mm(t.neto)),backgroundColor:col}]},
      options:{indexAxis:'y',plugins:{legend:{display:false},rgLbl:{fmt:v=>v.toLocaleString('es-DO',{maximumFractionDigits:2})}},scales:{x:{beginAtZero:true,grace:'15%',title:{display:true,text:'RD$ millones'}}}}});
  });
  if((d.caobo||[]).length){
    RG.charts.caobo=rgChart('rg-c-caobo',{type:'bar',data:{labels:d.caobo.map(x=>x.suplidor),datasets:[
      {label:String(A),data:d.caobo.map(x=>mm(x.neto)),backgroundColor:RG_COL.verde},{label:String(P),data:d.caobo.map(x=>mm(x.netoAnterior)),backgroundColor:'#c9ced6'}]},
      options:{indexAxis:'y',plugins:{rgLbl:{fmt:v=>v?v.toLocaleString('es-DO',{maximumFractionDigits:2}):''}},scales:{x:{beginAtZero:true,grace:'15%',title:{display:true,text:'RD$ millones'}}}}});
  }
}

/* ── Descargas / historial ── */
function rgDescargarPDF(){
  if(!RG.data){ toast('Genera el informe primero'); return; }
  const m=RG.data.meta;
  ppExportarPDF({containerSel:'#rg-reporte', botonIds:['rg-pdf','rg-pdf-top'],
    footerTxt:'Informe Ejecutivo de Cierre de Ventas · '+m.mesNombre+' '+m.anio+' · AM Comercial — Confidencial',
    filename:'AM_Cierre_'+m.mesNombre+m.anio+'.pdf', jpeg:true});
}
function rgDescargarExcel(){
  if(!RG.data){ toast('Genera el informe primero'); return; }
  const est=ppSetBtns(['rg-xlsx','rg-xlsx-top'],'Generando…',true);
  const graficas={}; Object.entries(RG.charts).forEach(([k,c])=>{ if(c) try{ graficas[k]=c.toBase64Image('image/png',1); }catch(e){} });
  const acciones=RG.acciones.map(a=>[(a.sem==='G'?'Verde':(a.sem==='Y'?'Ámbar':'Rojo'))+' · '+a.senal,a.que,a.hacer,a.resp,a.fecha]);
  fetch(BASE+'/apipdfpres/reunion-gerencial/excel',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({data:RG.data,narr:RG.narr,acciones,graficas})})
    .then(r=>{ if(!r.ok) return r.json().then(j=>{ throw new Error((j&&j.error)||('HTTP '+r.status)); }); return r.blob(); })
    .then(b=>{ const a=document.createElement('a'); a.href=URL.createObjectURL(b); a.download='AM_Cierre_'+RG.data.meta.mesNombre+RG.data.meta.anio+'.xlsx'; document.body.appendChild(a); a.click(); setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},1500); })
    .catch(e=>toast('Error generando Excel: '+e.message)).finally(()=>ppRestoreBtns(est));
}
function rgGuardarHistorial(){
  if(!RG.data){ toast('Genera el informe primero'); return; }
  const m=RG.data.meta, est=ppSetBtns(['rg-hist','rg-hist-top'],'Guardando…',true);
  fetch(BASE+'/apipdfpres/historial/guardar',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({reporte:'gerenciales_reunion_gerencial', filtros:{anio:m.anio,mes:m.mes,resumenTexto:'Cierre '+m.mesNombre+' '+m.anio}, resultado:{data:RG.data,narr:RG.narr,acciones:RG.acciones}})})
    .then(r=>r.json()).then(j=>{ ppRestoreBtns(est); toast(j&&j.ok?'Guardado en historial ✓ ('+j.fecha+')':((j&&j.error)||'No se pudo guardar')); })
    .catch(e=>{ ppRestoreBtns(est); toast('Error: '+e); });
}

/* ══════════════════════════════════════════════════════════════════════════
   CIERRE DIARIO (Supervisión Dinámica → PDF Presentaciones → Cierres)
   Pedido explícito del usuario 2026-09-03. Reusa msel()/ppExportarPDF()/
   ppSetBtns()/ppRestoreBtns()/historial genérico — mismo motor que "Ventas
   Proyectadas", filtros propios (Suplidor/Categoría/Centro/Canal/Supervisor/
   División/Vendedor + Fecha), backend GET /apipdfpres/cierre-diario.
   ══════════════════════════════════════════════════════════════════════════ */
const CD={_booted:false, msFilters:{}, resultado:null, generadoEn:null, detallado:false};

function cdCtx(){ return {reporte:'cierres_cierre_diario', nombreDefault:'Cierre Diario — '+(CD.filtrosUsados||cdResumenFiltrosTexto()), filtrosGetter:cdFiltrosJSON}; }

// Aplica la visibilidad/handlers de los botones "solo Gerencia" (Destinatarios/
// Programados/WhatsApp/Programar envío). Función GLOBAL (hoisted, no local a cdBoot) a
// propósito — pedido explícito 2026-09-23: el usuario reportó que esos botones se
// quedaban escondidos aunque su rol SÍ era Gerencia (el chip de arriba lo confirmaba).
// Causa real: condición de carrera — si el usuario entraba a "Cierres" (cdBoot) ANTES de
// que /apisuperv/identidad terminara de resolver, ID.veTodo todavía estaba en su default
// (false) en ese momento exacto, y como cdBoot solo corre UNA vez (CD._booted), esos
// botones quedaban escondidos por el resto de esa carga de página aunque ID.veTodo se
// pusiera en true un instante después. Fix: esta función se llama DESDE LOS 2 LADOS de la
// carrera (al terminar /identidad, y dentro de cdBoot) — así, gane quien gane la carrera,
// el último en terminar deja los botones en el estado correcto. Idempotente: llamarla de
// más no hace daño (solo vuelve a fijar los mismos estilos/handlers).
function cdAplicarVeTodo(){
  if(!ID.veTodo) return;
  $('#cd-destinatarios-btn-wrap').style.display='';
  $('#cd-destinatarios-btn').onclick=cdAbrirDestinatarios;
  $('#cd-programados-btn').onclick=()=>{ ppShow('pp-programados'); pgBoot(); };
  $('#cd-whatsapp-btn').onclick=cdWaAbrir;
  $('#cd-wa-refrescar').onclick=cdWaCargarStatus;
  $('#cd-wa-desvincular').onclick=cdWaDesvincular;
  $('#cd-programar-envio').classList.remove('hide'); $('#cd-programar-envio-top').classList.remove('hide');
  $('#cd-programar-envio').onclick=()=>abrirModalProgramar(cdCtx());
  $('#cd-programar-envio-top').onclick=()=>abrirModalProgramar(cdCtx());
}

function cdBoot(){
  if(CD._booted) return; CD._booted=true;
  $$('#pp-cierres .subtabs button[data-cierre]').forEach(b=>b.onclick=()=>{
    $$('#pp-cierres .subtabs button[data-cierre]').forEach(x=>x.classList.remove('on')); b.classList.add('on');
    const c=b.dataset.cierre;
    ['diario','semanal','mensual','ondemand'].forEach(k=>$('#cd-'+k).classList.toggle('hide', k!==c));
  });
  $('#cd-fecha').value=dateF(new Date());
  $('#cd-resumido').onclick=()=>{ CD.detallado=false; $('#cd-resumido').classList.add('on'); $('#cd-detallado').classList.remove('on'); if(CD.resultado)cdRenderReporte(CD.resultado); };
  $('#cd-detallado').onclick=()=>{ CD.detallado=true; $('#cd-detallado').classList.add('on'); $('#cd-resumido').classList.remove('on'); if(CD.resultado)cdRenderReporte(CD.resultado); };
  $('#cd-generar').onclick=cdGenerar;
  $('#cd-descargar-pdf').onclick=cdDescargarPDF;
  $('#cd-descargar-pdf-top').onclick=cdDescargarPDF;
  $('#cd-guardar-historial').onclick=cdGuardarHistorial;
  $('#cd-guardar-historial-top').onclick=cdGuardarHistorial;
  const cdCtxCorreo=()=>({containerSel:'#cd-reporte', asunto:'Cierre Diario '+(CD.resultado?CD.resultado.fecha:'')+' — MovilBusiness Dashboard'});
  $('#cd-enviar-correo').onclick=()=>abrirModalEnviarCorreo(cdCtxCorreo());
  $('#cd-enviar-correo-top').onclick=()=>abrirModalEnviarCorreo(cdCtxCorreo());
  $('#cd-enviar-wa').onclick=cdWaEnviarAbrir;
  $('#cd-enviar-wa-top').onclick=cdWaEnviarAbrir;
  $('#cd-wa-destino-persona').onclick=()=>cdWaDestino('persona');
  $('#cd-wa-destino-grupo').onclick=()=>cdWaDestino('grupo');
  $('#cd-wa-enviar-go').onclick=cdWaEnviarGo;
  $('#cd-wa-abrir-programar').onclick=()=>{ document.getElementById('modal-cd-wa-enviar').classList.remove('on'); abrirModalProgramar(cdCtx()); };
  cdAplicarVeTodo();
  $('#cd-dest-agregar').onclick=cdGuardarDestinatario;

  fetch(BASE+'/apipresupuestos/filtros').then(r=>r.json()).then(j=>{
    if(!j||!j.ok){ toast('No se pudieron cargar los filtros'); return; }
    CD.filtros=j;
    const centros=[...new Map(j.representantes.filter(r=>r.CedCodigo).map(r=>[r.CedCodigo,r.CentroNombre])).entries()].map(([v,t])=>({v,t}));
    const supervisores=[...new Map(j.representantes.filter(r=>r.SupervisorCod).map(r=>[r.SupervisorCod,r.SupervisorNombre||r.SupervisorCod])).entries()].map(([v,t])=>({v,t}));
    const divisiones=[...new Set(j.representantes.map(r=>r.Division).filter(Boolean))].sort().map(d=>({v:d,t:'División '+d}));
    const vendedores=j.representantes.map(r=>({v:r.RepCodigo,t:r.RepNombre+' · '+r.RepCodigo}));
    CD.msFilters.suplidor=msel($('#cd-f-suplidor'), j.suplidores, {placeholder:'Todos'});
    CD.msFilters.categoria=msel($('#cd-f-categoria'), j.categorias, {placeholder:'Todas'});
    CD.msFilters.centro=msel($('#cd-f-centro'), centros, {placeholder:'Todos',onChange:()=>CD_dep()});
    CD.msFilters.canal=msel($('#cd-f-canal'), j.canales, {placeholder:'Todos (excluye Institucional)'});
    CD.msFilters.supervisor=msel($('#cd-f-supervisor'), supervisores, {placeholder:'Todos',onChange:()=>CD_dep()});
    CD.msFilters.division=msel($('#cd-f-division'), divisiones, {placeholder:'Todas',onChange:()=>CD_dep()});
    CD.msFilters.vendedor=msel($('#cd-f-vendedor'), vendedores, {placeholder:'Todos'});
    CD_dep=mselDependCSV(CD.msFilters,j.representantes);
  }).catch(()=>toast('Error cargando filtros'));
}

function cdFiltrosJSON(){
  return {
    suplidor:CD.msFilters.suplidor?CD.msFilters.suplidor.values():[],
    categoria:CD.msFilters.categoria?CD.msFilters.categoria.values():[],
    centros:CD.msFilters.centro?CD.msFilters.centro.values():[],
    canales:CD.msFilters.canal?CD.msFilters.canal.values():[],
    supervisores:CD.msFilters.supervisor?CD.msFilters.supervisor.values():[],
    divisiones:CD.msFilters.division?CD.msFilters.division.values():[],
    vendedores:CD.msFilters.vendedor?CD.msFilters.vendedor.values():[],
  };
}

function cdResumenFiltrosTexto(){
  const partes=[['suplidor','Suplidores'],['categoria','Categorías'],['centro','Centros'],['canal','Canales'],['supervisor','Supervisores'],['division','Divisiones'],['vendedor','Vendedores']];
  return partes.map(([k,lbl])=>{ const ms=CD.msFilters[k]; const n=ms?ms.values().length:0; return lbl+': '+(n?n+' sel.':'Todos'); }).join(' · ');
}

function cdGenerar(){
  const fecha=$('#cd-fecha').value; const hint=$('#cd-form-hint');
  if(!fecha){ hint.style.display='block'; hint.textContent='Elige la fecha del informe.'; return; }
  hint.style.display='none';
  const qs=new URLSearchParams({fecha,
    suplidor:(CD.msFilters.suplidor?CD.msFilters.suplidor.values():[]).join(','),
    categoria:(CD.msFilters.categoria?CD.msFilters.categoria.values():[]).join(','),
    centros:(CD.msFilters.centro?CD.msFilters.centro.values():[]).join(','),
    canales:(CD.msFilters.canal?CD.msFilters.canal.values():[]).join(','),
    supervisores:(CD.msFilters.supervisor?CD.msFilters.supervisor.values():[]).join(','),
    divisiones:(CD.msFilters.division?CD.msFilters.division.values():[]).join(','),
    vendedores:(CD.msFilters.vendedor?CD.msFilters.vendedor.values():[]).join(','),
  });
  const btn=$('#cd-generar'); btn.disabled=true; const t0=btn.textContent; btn.textContent='Generando…';
  fetch(BASE+'/apipdfpres/cierre-diario?'+qs.toString()).then(r=>r.json()).then(j=>{
    btn.disabled=false; btn.textContent=t0;
    if(!j||!j.ok){ hint.style.display='block'; hint.textContent=(j&&j.error)||'Error generando el informe'; return; }
    CD.resultado=j; CD.filtrosUsados=cdResumenFiltrosTexto(); CD.generadoEn=new Date();
    cdRenderReporte(j);
    $('#cd-reporte-wrap').classList.remove('hide');
    $('#cd-reporte-wrap').scrollIntoView({behavior:'smooth'});
  }).catch(e=>{ btn.disabled=false; btn.textContent=t0; hint.style.display='block'; hint.textContent='Error: '+e; });
}

function cdFmt(x){ return x==null?'—':Number(x).toLocaleString('es-DO',{maximumFractionDigits:0}); }
function cdAlcanceColor(pct){ if(pct==null)return 'var(--muted)'; if(pct>=90)return '#1f8b4c'; if(pct>=80)return '#b8860b'; return '#c0392b'; }

// Columnas "Meta Ajustada / Logro Ajustado % / Diferencia Ajustada" (MNTDCAT1DIA, "Meta
// ajustada por déficit") — columna de REFERENCIA desde 2026-09-24 (antes era la primaria;
// ahora Presupuesto/Ejecutado/Logro del día %/Diferencia usan "Meta lineal"/MNTDCAT2DIA,
// pedido explícito del usuario: "los presupuestos, tómalos de la meta lineal, no el
// acumulado... para todos los niveles del informe"). Solo se agregan cuando conAjustada=true
// (hoy, únicamente Ventas del día). "—" cuando la fila no tiene fila ajustada ese día
// (presupuestoAjustada null) — pedido explícito 2026-09-19.
function cdAjustadaCols(f, bold){
  if(f.presupuestoAjustada==null) return '<td>—</td><td>—</td><td>—</td>';
  const b0=bold?'<b>':''; const b1=bold?'</b>':'';
  return '<td>'+b0+cdFmt(f.presupuestoAjustada)+b1+'</td>'
    +'<td style="color:'+cdAlcanceColor(f.logroAjustadaPct)+';font-weight:700">'+b0+(f.logroAjustadaPct!=null?f.logroAjustadaPct.toFixed(1)+'%':'—')+b1+'</td>'
    +'<td style="color:'+(f.diferenciaAjustada>=0?'#1f8b4c':'#c0392b')+'">'+b0+(f.diferenciaAjustada>=0?'+':'')+cdFmt(f.diferenciaAjustada)+b1+'</td>';
}
// Total de las 3 columnas de Meta Ajustada — suma solo sobre filas que sí tienen dato.
function cdAjustadaTotalCols(filas){
  const conDato=filas.filter(f=>f.presupuestoAjustada!=null);
  if(!conDato.length) return '<td>—</td><td>—</td><td>—</td>';
  const tpL=conDato.reduce((s,f)=>s+f.presupuestoAjustada,0);
  const teL=conDato.reduce((s,f)=>s+(f.presupuestoAjustada+f.diferenciaAjustada),0);
  const tpctL=tpL!=0?100*teL/tpL:null;
  return '<td>'+cdFmt(tpL)+'</td><td style="color:'+cdAlcanceColor(tpctL)+'">'+(tpctL!=null?tpctL.toFixed(1)+'%':'—')+'</td>'
    +'<td>'+(teL-tpL>=0?'+':'')+cdFmt(teL-tpL)+'</td>';
}

// Columnas "Presupuesto al Día / Logro al Día %" (modo='mes' únicamente) — Presupuesto al
// Día = presupuesto del mes prorrateado "a ritmo" hasta hoy (diasTranscurridos/diasDelMes,
// calculado en el backend); Logro al Día % = Ejecutado acumulado ÷ ese prorrateo. Pedido
// explícito 2026-09-20: "el logro al día debes hacerlo vs el presupuesto al día".
function cdAlDiaCols(f, bold){
  const b0=bold?'<b>':''; const b1=bold?'</b>':'';
  return '<td>'+b0+cdFmt(f.presupuestoAlDia)+b1+'</td>'
    +'<td style="color:'+cdAlcanceColor(f.logroAlDiaPct)+';font-weight:700">'+b0+(f.logroAlDiaPct!=null?f.logroAlDiaPct.toFixed(1)+'%':'—')+b1+'</td>';
}
function cdAlDiaTotalCols(filas){
  const tpAlDia=filas.reduce((s,f)=>s+(f.presupuestoAlDia||0),0);
  const te=filas.reduce((s,f)=>s+f.ejecutado,0);
  const pct=tpAlDia!=0?100*te/tpAlDia:null;
  return '<td>'+cdFmt(tpAlDia)+'</td><td style="color:'+cdAlcanceColor(pct)+'">'+(pct!=null?pct.toFixed(1)+'%':'—')+'</td>';
}

// Tabla de Alcance (Nombre/Presupuesto[/Presupuesto al Día]/Ejecutado/Logro[/Logro
// Acumulado]/Diferencia [+Meta Ajustada, solo modo='dia']) para un nivel simple (Centro/Canal/
// Suplidor/Categoría) — misma fórmula/estructura que el resto del sistema. modo='mes'
// (punto 1, "Resultados acumulados del Mes") agrega Presupuesto al Día + separa "Logro al
// Día %" (vs Presupuesto al Día) de "Logro Acumulado %" (=alcancePct, vs el presupuesto
// TOTAL del mes) — pedido explícito 2026-09-20. Orden ya viene del backend (por Logro al
// Día % en modo='mes', por Logro del día %/alcancePct en modo='dia' — 2026-09-19).
function cdTablaAlcance(filas, conAjustada, modo){
  const esMes=modo==='mes';
  const cols=esMes?7:(conAjustada?8:5);
  if(!filas||!filas.length) return '<tr><td class="l" colspan="'+cols+'">Sin datos para este filtro.</td></tr>';
  let tp=0,te=0;
  const body=filas.map(f=>{ tp+=f.presupuesto; te+=f.ejecutado;
    if(esMes) return '<tr><td class="l">'+f.nombre+'</td><td>'+cdFmt(f.presupuesto)+'</td>'+cdAlDiaCols(f,false)+'<td>'+cdFmt(f.ejecutado)+'</td>'
      +'<td style="color:'+cdAlcanceColor(f.alcancePct)+';font-weight:700">'+(f.alcancePct!=null?f.alcancePct.toFixed(1)+'%':'—')+'</td>'
      +'<td style="color:'+(f.diferencia>=0?'#1f8b4c':'#c0392b')+'">'+(f.diferencia>=0?'+':'')+cdFmt(f.diferencia)+'</td></tr>';
    const pct=f.alcancePct;
    return '<tr><td class="l">'+f.nombre+'</td><td>'+cdFmt(f.presupuesto)+'</td><td>'+cdFmt(f.ejecutado)+'</td>'
      +'<td style="color:'+cdAlcanceColor(pct)+';font-weight:700">'+(pct!=null?pct.toFixed(1)+'%':'—')+'</td>'
      +'<td style="color:'+(f.diferencia>=0?'#1f8b4c':'#c0392b')+'">'+(f.diferencia>=0?'+':'')+cdFmt(f.diferencia)+'</td>'
      +(conAjustada?cdAjustadaCols(f,false):'')+'</tr>';
  }).join('');
  const tpct=tp!=0?100*te/tp:null;
  if(esMes) return body+'<tr class="totrow"><td class="l">Total</td><td>'+cdFmt(tp)+'</td>'+cdAlDiaTotalCols(filas)+'<td>'+cdFmt(te)+'</td>'
    +'<td style="color:'+cdAlcanceColor(tpct)+'">'+(tpct!=null?tpct.toFixed(1)+'%':'—')+'</td><td>'+(te-tp>=0?'+':'')+cdFmt(te-tp)+'</td></tr>';
  return body+'<tr class="totrow"><td class="l">Total</td><td>'+cdFmt(tp)+'</td><td>'+cdFmt(te)+'</td>'
    +'<td style="color:'+cdAlcanceColor(tpct)+'">'+(tpct!=null?tpct.toFixed(1)+'%':'—')+'</td><td>'+(te-tp>=0?'+':'')+cdFmt(te-tp)+'</td>'
    +(conAjustada?cdAjustadaTotalCols(filas):'')+'</tr>';
}

// Tabla "Por Supervisor" — con Vendedores anidados debajo (solo si CD.detallado; el
// backend siempre trae el detalle completo, el toggle solo decide si se muestra).
function cdTablaSupervisor(filas, conAjustada, modo){
  const esMes=modo==='mes';
  const cols=esMes?7:(conAjustada?8:5);
  if(!filas||!filas.length) return '<tr><td class="l" colspan="'+cols+'">Sin datos para este filtro.</td></tr>';
  let tp=0,te=0;
  let body=filas.map(f=>{ tp+=f.presupuesto; te+=f.ejecutado;
    let h;
    if(esMes) h='<tr style="background:var(--panel2,#f5f7fa)"><td class="l"><b>'+f.nombre+'</b></td><td><b>'+cdFmt(f.presupuesto)+'</b></td>'+cdAlDiaCols(f,true)+'<td><b>'+cdFmt(f.ejecutado)+'</b></td>'
      +'<td style="color:'+cdAlcanceColor(f.alcancePct)+';font-weight:700">'+(f.alcancePct!=null?f.alcancePct.toFixed(1)+'%':'—')+'</td>'
      +'<td style="color:'+(f.diferencia>=0?'#1f8b4c':'#c0392b')+'"><b>'+(f.diferencia>=0?'+':'')+cdFmt(f.diferencia)+'</b></td></tr>';
    else { const pct=f.alcancePct; h='<tr style="background:var(--panel2,#f5f7fa)"><td class="l"><b>'+f.nombre+'</b></td><td><b>'+cdFmt(f.presupuesto)+'</b></td><td><b>'+cdFmt(f.ejecutado)+'</b></td>'
      +'<td style="color:'+cdAlcanceColor(pct)+';font-weight:700">'+(pct!=null?pct.toFixed(1)+'%':'—')+'</td>'
      +'<td style="color:'+(f.diferencia>=0?'#1f8b4c':'#c0392b')+'"><b>'+(f.diferencia>=0?'+':'')+cdFmt(f.diferencia)+'</b></td>'
      +(conAjustada?cdAjustadaCols(f,true):'')+'</tr>'; }
    if(CD.detallado&&f.vendedores&&f.vendedores.length) h+=f.vendedores.map(v=>{
      if(esMes) return '<tr><td class="l" style="padding-left:22px;color:#57606a">'+v.nombre+'</td><td>'+cdFmt(v.presupuesto)+'</td>'+cdAlDiaCols(v,false)+'<td>'+cdFmt(v.ejecutado)+'</td>'
        +'<td style="color:'+cdAlcanceColor(v.alcancePct)+'">'+(v.alcancePct!=null?v.alcancePct.toFixed(1)+'%':'—')+'</td>'
        +'<td style="color:'+(v.diferencia>=0?'#1f8b4c':'#c0392b')+'">'+(v.diferencia>=0?'+':'')+cdFmt(v.diferencia)+'</td></tr>';
      const vpct=v.alcancePct;
      return '<tr><td class="l" style="padding-left:22px;color:#57606a">'+v.nombre+'</td><td>'+cdFmt(v.presupuesto)+'</td><td>'+cdFmt(v.ejecutado)+'</td>'
        +'<td style="color:'+cdAlcanceColor(vpct)+'">'+(vpct!=null?vpct.toFixed(1)+'%':'—')+'</td>'
        +'<td style="color:'+(v.diferencia>=0?'#1f8b4c':'#c0392b')+'">'+(v.diferencia>=0?'+':'')+cdFmt(v.diferencia)+'</td>'
        +(conAjustada?cdAjustadaCols(v,false):'')+'</tr>';
    }).join('');
    return h;
  }).join('');
  const tpct=tp!=0?100*te/tp:null;
  if(esMes) return body+'<tr class="totrow"><td class="l">Total</td><td>'+cdFmt(tp)+'</td>'+cdAlDiaTotalCols(filas)+'<td>'+cdFmt(te)+'</td>'
    +'<td style="color:'+cdAlcanceColor(tpct)+'">'+(tpct!=null?tpct.toFixed(1)+'%':'—')+'</td><td>'+(te-tp>=0?'+':'')+cdFmt(te-tp)+'</td></tr>';
  return body+'<tr class="totrow"><td class="l">Total</td><td>'+cdFmt(tp)+'</td><td>'+cdFmt(te)+'</td>'
    +'<td style="color:'+cdAlcanceColor(tpct)+'">'+(tpct!=null?tpct.toFixed(1)+'%':'—')+'</td><td>'+(te-tp>=0?'+':'')+cdFmt(te-tp)+'</td>'
    +(conAjustada?cdAjustadaTotalCols(filas):'')+'</tr>';
}

