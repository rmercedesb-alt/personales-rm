function ppVsBloque(titulo, etiqueta, rows, tot){
  const head='<th class="l">'+etiqueta+'</th><th>Presupuesto mes</th><th>Presupuesto al día</th><th>Ejecutado</th><th>Logro al día %</th><th>Dif. vs. al día</th><th>Proyectado cierre</th><th>Dif. proy. vs. mes</th>';
  const body=(rows&&rows.length)?rows.map(r=>ppVsFila(r,false)).join('')+ppVsFila(tot,true):'<tr><td class="l" colspan="8">Sin datos para este filtro.</td></tr>';
  return '<div class="pp-block"><div class="sec-title"><h3>'+titulo+'</h3></div><div class="scroller"><table><thead><tr>'+head+'</tr></thead><tbody>'+body+'</tbody></table></div></div>';
}
/* Formato 2 (2026-10-12): mismas columnas que Presupuestos → Detalle (#, nombre, Presupuesto, Pres. al día, Ejecutado, Alcance%, Déficit al Momento,
   Proyectado, Proy.%, Estimado, Est.%, Déficit Estimado, Necesidad Diaria). Informes guardados antes (sin v.formato) usan ppVsCapituloV1. */
function ppVsFila2(f, i, esTotal){
  const n=v=>v==null?'—':ppFmtNum(v), p=v=>v==null?'—':v.toFixed(1)+'%';
  const rojoSiPos=v=>v==null?'':(v>0?'color:#c0392b':'color:#1f8b4c');
  return '<tr'+(esTotal?' class="totrow"':'')+'><td class="l">'+(esTotal?'':i)+'</td><td class="l">'+(esTotal?'TOTAL':f.nombre)+'</td>'
    +'<td>'+n(f.presupuesto)+'</td><td>'+n(f.presupuestoAlDia)+'</td><td>'+n(f.ejecutado)+'</td><td>'+p(f.alcancePct)+'</td>'
    +'<td style="color:'+cdAlcanceColor(f.logroAlDiaPct)+';font-weight:700">'+p(f.logroAlDiaPct)+'</td>'
    +'<td style="'+rojoSiPos(f.deficitMomento)+'">'+n(f.deficitMomento)+'</td>'
    +'<td>'+n(f.proyectado)+'</td><td style="color:'+cdAlcanceColor(f.proyectadoPct)+';font-weight:700">'+p(f.proyectadoPct)+'</td>'
    +'<td>'+n(f.estimado)+'</td><td style="color:'+cdAlcanceColor(f.estimadoPct)+';font-weight:700">'+p(f.estimadoPct)+'</td>'
    +'<td style="'+rojoSiPos(f.deficitEstimado)+'">'+n(f.deficitEstimado)+'</td><td>'+n(f.necesidadDiaria)+'</td></tr>';
}
function ppVsBloque2(titulo, etiqueta, rows, tot){
  const head='<th class="l">#</th><th class="l">'+etiqueta+'</th><th>Presupuesto</th><th>Pres. al día</th><th>Ejecutado</th><th>Alcance%</th><th>Logro al día%</th><th>Déficit al Momento</th><th>Proyectado</th><th>Proy.%</th><th>Estimado</th><th>Logro Est.%</th><th>Déficit Estimado</th><th>Necesidad Diaria</th>';
  const body=(rows&&rows.length)?rows.map((r,i)=>ppVsFila2(r,i+1,false)).join('')+ppVsFila2(tot,0,true):'<tr><td class="l" colspan="14">Sin datos para este filtro.</td></tr>';
  return '<div class="pp-block"><div class="sec-title"><h3>'+titulo+'</h3></div><div class="scroller"><table style="font-size:10.5px"><thead><tr>'+head+'</tr></thead><tbody>'+body+'</tbody></table></div></div>';
}
function ppVsCapitulo2(v){
  const MESES=['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
  const t=v.total, n=x=>x==null?'—':ppFmtNum(x), p=x=>x==null?'—':x.toFixed(1)+'%';
  const kpi=(k,val,sub,col)=>'<div class="pp-kpi"><div class="k">'+k+'</div><div class="v" style="font-size:19px'+(col?';color:'+col:'')+'">'+val+'</div>'+(sub?'<div style="font-size:11px;color:var(--muted)">'+sub+'</div>':'')+'</div>';
  return '<div class="pp-block"><div class="sec-title"><h3>Ventas vs. Presupuesto al día y proyectado</h3><span class="n">'+MESES[v.mes-1]+' '+v.anio+' · '+v.diasRestantes+' días hábiles restantes de '+v.diasDelMes+'</span></div>'
    +'<p style="font-size:12px;color:#57606a;margin-bottom:10px">Mismas cifras y fórmulas que Presupuestos. <b>Pres. al día</b> = presupuesto prorrateado por días hábiles transcurridos. <b>Alcance%</b> = ejecutado / presupuesto del mes. <b>Déficit al Momento</b> = Pres. al día − Ejecutado. <b>Proyectado</b> = ritmo lineal hasta el cierre. <b>Estimado</b> = proyección con la curva de estacionalidad de cada canal. <b>Logro al día%</b> = Ejecutado / Pres. al día. <b>Logro Est.%</b> = Estimado / Presupuesto. <b>Déficit Estimado</b> = Presupuesto − Estimado. <b>Necesidad Diaria</b> = (Presupuesto − Ejecutado) / días hábiles restantes. Excluye el canal Institucional salvo que se filtre.</p>'
    +'<div class="pp-resumen" style="grid-template-columns:repeat(5,1fr)">'
      +kpi('Presupuesto del mes',n(t.presupuesto),'total a lograr en el mes')
      +kpi('Presupuesto al día',n(t.presupuestoAlDia),'lo que debía llevar a hoy')
      +kpi('Ejecutado',n(t.ejecutado),'a la fecha')
      +kpi('Logro al día',p(t.logroAlDiaPct),'Ejecutado / Pres. al día',cdAlcanceColor(t.logroAlDiaPct))
      +kpi('Alcance del mes',p(t.alcancePct),'Ejecutado / Presupuesto')
      +kpi('Proyectado',n(t.proyectado),p(t.proyectadoPct)+' del presupuesto',cdAlcanceColor(t.proyectadoPct))
      +kpi('Estimado',n(t.estimado),'con curva de estacionalidad')
      +kpi('Logro estimado',p(t.estimadoPct),'Estimado / Presupuesto',cdAlcanceColor(t.estimadoPct))
      +kpi('Déficit Estimado',n(t.deficitEstimado),'Presupuesto − Estimado')
      +kpi('Necesidad Diaria',n(t.necesidadDiaria),'por día hábil restante')
    +'</div></div>'
    +ppVsBloque2('Por Centro','Centro',v.porCentro,t)
    +ppVsBloque2('Por Canal','Canal',v.porCanal,t)
    +ppVsBloque2('Por Supervisor','Supervisor',v.porSupervisor,t)
    +ppVsBloque2('Por Suplidor','Suplidor',v.porSuplidor,t)
    +'<div class="pp-block" style="padding-top:2px"><div class="sec-title"><h3>Ventas Proyectadas próxima semana</h3></div></div>';
}
function ppVsCapitulo(v){
  if(v && v.formato===2) return ppVsCapitulo2(v);
  return ppVsCapituloV1(v);
}
function ppVsCapituloV1(v){
  if(!v) return '';
  const MESES=['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
  const t=v.total;
  return '<div class="pp-block"><div class="sec-title"><h3>Ventas vs. Presupuesto al día y proyectado</h3><span class="n">'+MESES[v.mes-1]+' '+v.anio+' · día hábil '+v.diasTranscurridos+' de '+v.diasDelMes+' ('+v.diasRestantes+' restantes)</span></div>'
    +'<p style="font-size:13px;color:#57606a;margin-bottom:10px"><b>Presupuesto al día</b> = presupuesto del mes prorrateado por días hábiles transcurridos. <b>Proyectado cierre</b> = lo ejecutado a la fecha llevado al ritmo diario promedio hasta el último día hábil del mes. Excluye el canal Institucional salvo que se filtre explícitamente.</p>'
    +'<div class="pp-resumen">'
      +'<div class="pp-kpi"><div class="k">Ejecutado</div><div class="v">'+ppFmtNum(t.ejecutado)+'</div></div>'
      +'<div class="pp-kpi"><div class="k">Logro al día</div><div class="v" style="color:'+cdAlcanceColor(t.logroAlDiaPct)+'">'+(t.logroAlDiaPct!=null?t.logroAlDiaPct.toFixed(1)+'%':'—')+'</div></div>'
      +'<div class="pp-kpi"><div class="k">Proyectado cierre</div><div class="v">'+ppFmtNum(t.proyectado)+'</div><div style="font-size:11px;color:var(--muted)">'+(t.proyectadoPct!=null?t.proyectadoPct.toFixed(1)+'% del presupuesto ('+ppFmtNum(t.presupuesto)+')':'')+'</div></div>'
    +'</div></div>'
    +ppVsBloque('Por Centro','Centro',v.porCentro,t)
    +ppVsBloque('Por Canal','Canal',v.porCanal,t)
    +ppVsBloque('Por Supervisor','Supervisor',v.porSupervisor,t)
    +ppVsBloque('Por Suplidor','Suplidor',v.porSuplidor,t)
    +'<div class="pp-block" style="padding-top:2px"><div class="sec-title"><h3>Ventas Proyectadas próxima semana</h3></div></div>';
}

function ppRenderReporte(j){
  const centros=j.centros||[];
  const desde=j.meta.desde, hasta=j.meta.hasta;
  const filtrosTxt=PP.filtrosUsados||ppResumenFiltrosTexto();
  const genStr=(PP.generadoEn||new Date()).toLocaleString('es-DO');

  const detalleHead=centros.map(c=>'<th>'+c.nombre+'</th>').join('');
  const detRows=j.detalle||[];
  const grupos=ppAgruparPorSuplidor(detRows, centros);
  const totPorCentro={}; centros.forEach(c=>totPorCentro[c.cedCodigo]={monto:0,cajas:0});
  let totMontoGen=0, totCajasGen=0;
  const detalleBody=grupos.length ? grupos.map(g=>{
    const filasCat=g.cats.map(d=>{
      const celdas=centros.map(c=>{
        const v=(d.porCentro&&d.porCentro[c.cedCodigo])||{monto:0,cajas:0};
        return '<td>'+ppFmtNum(v.monto)+'<div style="font-size:10px;color:var(--muted)">'+ppFmtNum(v.cajas)+' cj</div></td>';
      }).join('');
      return '<tr><td class="l" style="padding-left:24px;color:#57606a">'+d.categoria+'</td>'+celdas
        +'<td>'+ppFmtNum(d.monto)+'<div style="font-size:10px;color:var(--muted)">'+ppFmtNum(d.cajas)+' cj</div></td></tr>';
    }).join('');
    centros.forEach(c=>{ totPorCentro[c.cedCodigo].monto+=g.totPorCentro[c.cedCodigo].monto; totPorCentro[c.cedCodigo].cajas+=g.totPorCentro[c.cedCodigo].cajas; });
    totMontoGen+=g.totMonto; totCajasGen+=g.totCajas;
    const celdasSub=centros.map(c=>'<td><b>'+ppFmtNum(g.totPorCentro[c.cedCodigo].monto)+'</b><div style="font-size:10px;color:var(--muted)">'+ppFmtNum(g.totPorCentro[c.cedCodigo].cajas)+' cj</div></td>').join('');
    return '<tr style="background:#eef1f4"><td class="l" colspan="'+(centros.length+2)+'"><b>'+g.suplidor+'</b></td></tr>'
      +filasCat
      +'<tr style="background:#f6f8fa"><td class="l">Subtotal '+g.suplidor+'</td>'+celdasSub+'<td><b>'+ppFmtNum(g.totMonto)+'</b><div style="font-size:10px;color:var(--muted)">'+ppFmtNum(g.totCajas)+' cj</div></td></tr>';
  }).join('') : ('<tr><td class="l" colspan="'+(centros.length+2)+'">Sin datos para este filtro.</td></tr>');
  const detalleTotRow=grupos.length ? ('<tr class="totrow"><td class="l">Total</td>'
    +centros.map(c=>'<td>'+ppFmtNum(totPorCentro[c.cedCodigo].monto)+'<div style="font-size:10px;color:var(--muted)">'+ppFmtNum(totPorCentro[c.cedCodigo].cajas)+' cj</div></td>').join('')
    +'<td><b>'+ppFmtNum(totMontoGen)+'</b><div style="font-size:10px;color:var(--muted)">'+ppFmtNum(totCajasGen)+' cj</div></td></tr>') : '';

  $('#pp-reporte').innerHTML=
    '<div class="pp-report">'
    +'<div class="pp-band"><div class="rt">Ventas Proyectadas próxima semana</div><div class="rs">Gobierno Comercial (Semanal) · '+desde+' a '+hasta+' · Generado '+genStr+'</div></div>'
    +'<div class="bd">'
    +ppVsCapitulo(j.vsPresupuesto)
    +'<div class="pp-block">'
      +'<div class="sec-title"><h3>Resumen ejecutivo</h3></div>'
      +'<p style="font-size:13px;color:#57606a;margin-bottom:10px">Con base en el presupuesto ya cargado para el período y la curva de estacionalidad histórica del negocio, se proyecta lo siguiente para el rango <b>'+desde+'</b> a <b>'+hasta+'</b>:</p>'
      +'<div class="pp-resumen">'
        +'<div class="pp-kpi"><div class="k">Facturas</div><div class="v">'+ppFmtNum(j.resumen.facturas)+'</div></div>'
        +'<div class="pp-kpi"><div class="k">Cajas</div><div class="v">'+ppFmtNum(j.resumen.cajas)+'</div></div>'
        +'<div class="pp-kpi"><div class="k">Monto Total</div><div class="v">'+ppFmtNum(j.resumen.monto)+'</div></div>'
      +'</div>'
    +'</div>'
    +'<div class="pp-block">'
      +'<div class="sec-title"><h3>Por Centro</h3></div>'
      +'<div class="scroller"><table><thead><tr><th class="l">Centro</th><th>Facturas</th><th>Cajas</th><th>Monto</th></tr></thead><tbody>'+ppFilasSimple(j.porCentro)+'</tbody></table></div>'
    +'</div>'
    +'<div class="pp-block">'
      +'<div class="sec-title"><h3>Por Canal</h3></div>'
      +'<div class="scroller"><table><thead><tr><th class="l">Canal</th><th>Facturas</th><th>Cajas</th><th>Monto</th></tr></thead><tbody>'+ppFilasSimple(j.porCanal)+'</tbody></table></div>'
    +'</div>'
    +'<div class="pp-block">'
      +'<div class="sec-title"><h3>Por Supervisor</h3></div>'
      +'<div class="scroller"><table><thead><tr><th class="l">Supervisor</th><th>Facturas</th><th>Cajas</th><th>Monto</th></tr></thead><tbody>'+ppFilasSimple(j.porSupervisor)+'</tbody></table></div>'
    +'</div>'
    +'<div class="pp-block">'
      +'<div class="sec-title"><h3>Detalle por Suplidor / Categoría — Monto y Cajas por Centro</h3><span class="n">Facturas no aplica a este nivel de detalle (no existe esa dimensión en la data de presupuesto por producto)</span></div>'
      +'<div class="scroller"><table><thead><tr><th class="l">Suplidor / Categoría</th>'+detalleHead+'<th>Total</th></tr></thead><tbody>'+detalleBody+detalleTotRow+'</tbody></table></div>'
    +'</div>'
    +'<div class="pp-block">'
      +'<div class="sec-title"><h3>Ventas por Día</h3><span class="n">Cajas y Monto a vender cada día del rango</span></div>'
      +'<div class="scroller"><table><thead><tr><th class="l">Día</th><th class="l">Fecha</th><th>Cajas</th><th>Monto</th></tr></thead><tbody>'+ppFilasPorDia(j.porDia)+'</tbody></table></div>'
    +'</div>'
    +'<div class="pp-block pp-foot"><div><b>Filtros aplicados:</b> '+filtrosTxt+'</div><div style="margin-top:10px">Preparado por: <b>Rudy Mercedes</b><br>Gerente</div></div>'
    +'</div>'
    +'</div>';
}

function ppEnsureHtml2Canvas(cb){ if(typeof html2canvas!=='undefined'){cb();return;} const s=document.createElement('script'); s.src=BASE+'/lib/html2canvas.min.js'; s.onload=()=>cb(); s.onerror=()=>alert('No se pudo cargar el generador de PDF.'); document.head.appendChild(s); }
function ppEnsureJsPDF(cb){ if(window.jspdf&&window.jspdf.jsPDF){cb();return;} const s=document.createElement('script'); s.src=BASE+'/lib/jspdf.umd.min.js'; s.onload=()=>cb(); s.onerror=()=>alert('No se pudo cargar el generador de PDF.'); document.head.appendChild(s); }

function ppSetBtns(ids, texto, disabled){
  return ids.map(id=>{ const b=$('#'+id); if(!b) return null; const t0=b.textContent; if(texto!=null) b.textContent=texto; b.disabled=disabled; return {b,t0}; });
}
function ppRestoreBtns(estados){ estados.forEach(e=>{ if(e){ e.b.textContent=e.t0; e.b.disabled=false; } }); }

// Exportación a PDF GENÉRICA (bloque-por-bloque, corte alineado a fila) — factorizada
// desde el "Ventas Proyectadas" original (2026-08-30, con varios bugs de paginación ya
// corregidos y documentados abajo) para que CUALQUIER informe de PDF Presentaciones
// (Cierre Diario incluido, 2026-09-03) la reuse tal cual en vez de reimplementar esta
// lógica — cero cambio de comportamiento para "Ventas Proyectadas" (ppDescargarPDF
// sigue siendo un wrapper delgado, ver más abajo).
function ppExportarPDF(cfg){
  // cfg: {containerSel, botonIds, footerTxt, filename}
  const estados=ppSetBtns(cfg.botonIds,'Generando…',true);
  ppEnsureHtml2Canvas(()=>ppEnsureJsPDF(()=>{
    const bandNode=$(cfg.containerSel+' .pp-band');
    const blockNodes=[...$(cfg.containerSel+' .bd').children]; // cada .pp-block se captura por separado

    // Un canvas POR BLOQUE (en vez de 1 solo canvas gigante + 2 fórmulas de escala distintas
    // para calcular los cortes) — así cada bloque tiene una sola fuente de verdad para su
    // altura real en mm, y no puede haber desfase entre "dónde creo que corté" y "qué hay
    // realmente ahí": el corte se decide con la altura de SU PROPIA captura, nunca con una
    // medida del DOM en vivo comparada contra una captura distinta. Corrige el reporte del
    // usuario 2026-08-30 de contenido repetido/fuera de orden y pie de página superpuesto.
    //
    // Las capturas van UNA POR UNA (no Promise.all en paralelo): html2canvas clona el
    // documento temporalmente durante cada captura, y correr varias a la vez interfiere
    // entre sí — verificado en vivo (Puppeteer + captura sintética) que esto era lo que
    // producía contenido repetido/fuera de orden en la hoja donde caía el corte.
    (async()=>{
      const canvases=[];
      for(const n of [bandNode, ...blockNodes]) canvases.push(await html2canvas(n,{scale:2, backgroundColor:n===bandNode?null:'#ffffff', useCORS:true}));
      return canvases;
    })()
      .then(canvases=>{
        const {jsPDF}=window.jspdf;
        const pdf=new jsPDF({orientation:'p',unit:'mm',format:'a4'});
        const pageW=pdf.internal.pageSize.getWidth(), pageH=pdf.internal.pageSize.getHeight();
        // margen lateral de 1/2 pulgada (12.7 mm) a cada lado — pedido 2026-10-09: sin él se perdían datos en los bordes al imprimir a página completa.
        const mX=12.7, cw=pageW-2*mX;
        const mmH=c=>c.height*(cw/c.width);

        const bandCanvas=canvases[0];
        const blockCanvases=canvases.slice(1);
        const bandH=mmH(bandCanvas);
        const topGap=3, footReserve=10;
        const contentH=pageH-bandH-topGap-footReserve;

        // Recorta un canvas alto en el tramo [srcYpx, srcYpx+hPx) a un canvas NUEVO de ese
        // tamaño exacto — así cada tramo es una imagen propia y completa (sin desplazamientos
        // negativos que dibujen "por encima" de la hoja y tapen el encabezado). Se probó antes
        // con recorte vía jsPDF (saveGraphicsState/rect/clip) pero dejaba un borde visible y no
        // resolvía el problema — esto es más simple y no depende de esa API.
        function recortarCanvas(c, srcYpx, hPx){
          const out=document.createElement('canvas');
          out.width=c.width; out.height=Math.max(1, Math.round(hPx));
          out.getContext('2d').drawImage(c, 0, srcYpx, c.width, hPx, 0, 0, c.width, hPx);
          return out;
        }

        // Empaqueta los bloques en páginas: si un bloque completo no cabe en lo que queda
        // de la hoja actual, se pasa ENTERO a una hoja nueva (nunca se corta a mitad).
        // Solo si un bloque es más alto que una hoja completa y vacía se corta en tramos de
        // 1 hoja — único caso posible de corte "a mitad", inevitable sin más.
        const pages=[[]];
        let cursorMm=0;
        blockCanvases.forEach((c,i)=>{
          const total=mmH(c);
          if(total<=contentH){
            if(cursorMm>0 && total>contentH-cursorMm){ pages.push([]); cursorMm=0; }
            pages[pages.length-1].push({canvas:c, hMm:total, yMm:cursorMm});
            cursorMm+=total;
          } else {
            const pxPerMm=c.width/cw;
            // Bordes de fila (borde inferior de cada <tr>), en el mismo espacio de píxeles
            // que el canvas de ESTE bloque — para que un corte forzoso caiga entre filas y
            // no a mitad de los números, cuando sea posible.
            const blockNode=blockNodes[i];
            const ratio=c.width/blockNode.offsetWidth;
            const blockTop=blockNode.getBoundingClientRect().top;
            const bordesFila=[...blockNode.querySelectorAll('tr')]
              .map(tr=>Math.round((tr.getBoundingClientRect().bottom-blockTop)*ratio))
              .filter(y=>y>0 && y<c.height).sort((a,b)=>a-b);
            let remaining=total, src=0;
            while(remaining>0){
              if(cursorMm>=contentH){ pages.push([]); cursorMm=0; }
              let take=Math.min(contentH-cursorMm, remaining);
              let ajustado=false;
              if(src+take<total){
                const idealPx=(src+take)*pxPerMm, srcPx=src*pxPerMm;
                const candidatos=bordesFila.filter(y=>y<=idealPx && y>srcPx);
                if(candidatos.length){ take=(candidatos[candidatos.length-1]/pxPerMm)-src; ajustado=true; }
              }
              if(take<=0) take=Math.min(contentH-cursorMm, remaining);
              const cropped=recortarCanvas(c, src*pxPerMm, take*pxPerMm);
              pages[pages.length-1].push({canvas:cropped, hMm:take, yMm:cursorMm});
              src+=take; remaining-=take;
              // Si el corte se ajustó a un borde de fila (queda antes del límite real de la
              // hoja), el sobrante ya no alcanza para otra fila completa — se da la hoja por
              // llena en vez de intentar rellenarlo con un corte sin alinear (verificado en
              // vivo con Puppeteer: sin esto, ese sobrante terminaba partiendo la fila
              // siguiente a la mitad, exactamente el bug reportado por el usuario).
              cursorMm = ajustado ? contentH : cursorMm+take;
            }
          }
        });

        const totalPages=pages.length;
        // cfg.jpeg (opt-in, 2026-10-05 — Reunión Gerencial): JPEG comprimido sobre fondo blanco en vez
        // de PNG. Un informe largo con gráficas pesaba ~150 MB en PNG; los demás informes no cambian.
        // JPEG por defecto (2026-10-10, compresión de PDF): cfg.jpeg===false fuerza PNG sin pérdida.
        const useJpg=cfg.jpeg!==false; const imgFmt=useJpg?'JPEG':'PNG';
        const imgData=c=>{ if(!useJpg) return c.toDataURL('image/png');
          const w=document.createElement('canvas'); w.width=c.width; w.height=c.height; const x=w.getContext('2d');
          x.fillStyle='#fff'; x.fillRect(0,0,w.width,w.height); x.drawImage(c,0,0); return w.toDataURL('image/jpeg',0.85); };
        const bandData=imgData(bandCanvas);
        const footerTxt=cfg.footerTxt||'';

        pages.forEach((items,p)=>{
          if(p>0) pdf.addPage();
          pdf.addImage(bandData,imgFmt,mX,0,cw,bandH); // encabezado con los colores de marca, en CADA hoja
          items.forEach(it=>{
            pdf.addImage(imgData(it.canvas),imgFmt,mX, bandH+topGap+it.yMm, cw, it.hMm);
          });
          pdf.setFontSize(7); pdf.setTextColor(120);
          pdf.text(footerTxt, mX, pageH-6, {maxWidth: cw-30});
          pdf.text('Página '+(p+1)+' / '+totalPages, pageW-mX, pageH-6, {align:'right'});
        });
        pdf.save(cfg.filename);
      }).catch(err=>alert('Error generando PDF: '+err)).finally(()=>{ ppRestoreBtns(estados); });
  }));
}

/* ── RESUMEN CIERRE DEL DÍA (2026-10-06) ─────────────────────────────────
   Gobierno Comercial → "Resumen Cierre del Día". Datos de Pedidos y Visitas desde
   /apipdfpres/resumen-cierre-dia (cada fila trae su HISTÓRICO); el AMCO-GT se puntúa
   aquí con la MISMA fórmula de Seguimientos (/apiseg/semana) para el MISMO período del informe
   (por defecto el día de hoy, divisiones 10/11/12). Los hallazgos se miden contra el comportamiento
   habitual de cada quien (no contra el resultado del día) y ponderados por su
   incidencia (RD$, clientes o pedidos), no solo por el % de logro. */
let RC={res:null, amco:null, generadoEn:null, filtrosTxt:''};
let RC_MS={}, RC_FILTROS=null;
const RC_COL={
  azul:['#1e3a8a','#ffffff','rgba(30,58,138,.10)'],
  vOsc:['#166534','#ffffff','rgba(22,101,52,.10)'],
  vCl: ['#86efac','#14532d','rgba(134,239,172,.28)'],
  amar:['#facc15','#422006','rgba(250,204,21,.24)'],
  rojo:['#dc2626','#ffffff','rgba(220,38,38,.12)'],
  vrd: ['#16a34a','#ffffff','rgba(22,163,74,.12)']
};
// Escala de Pedidos vs Presupuesto: <75 rojo · 75–85 amarillo · 85–95 verde claro · 95–105 verde oscuro · >105 azul oscuro
function rcColorAlcance(p){ if(p==null) return null; if(p>105) return RC_COL.azul; if(p>=95) return RC_COL.vOsc; if(p>=85) return RC_COL.vCl; if(p>=75) return RC_COL.amar; return RC_COL.rojo; }
// Escala de Visitas (según la EFECTIVIDAD lograda): verde si supera 60% o está ≥5% sobre el mes anterior;
// rojo si queda por debajo de su promedio del último mes (30 días); amarillo en el resto.
function rcColorEfect(f){
  const ef=f.efectividadPct; if(ef==null) return null;
  if(ef>60 || (f.mesAntEfectividadPct!=null && ef>=f.mesAntEfectividadPct*1.05)) return RC_COL.vrd;
  if(f.histEfectividadPct!=null && ef<f.histEfectividadPct) return RC_COL.rojo;
  return RC_COL.amar;
}
function rcPct(x){ return x==null?'—':x.toFixed(1)+'%'; }
function rcSgn(x,d){ return (x>0?'+':'')+x.toFixed(d==null?1:d); }
function rcDiaCap(s){ return (s||'').charAt(0).toUpperCase()+(s||'').slice(1); }
function rcChip(txt,c){ return '<span style="display:inline-block;padding:2px 8px;border-radius:6px;font-weight:700;background:'+c[0]+';color:'+c[1]+'">'+txt+'</span>'; }

function rcFiltrosVals(){
  const g=k=>RC_MS[k]?RC_MS[k].values():[];
  return {division:g('division'),suplidor:g('suplidor'),categoria:g('categoria'),canales:g('canal'),centros:g('centro'),supervisores:g('supervisor'),vendedores:g('vendedor')};
}
function rcFiltrosTexto(F){
