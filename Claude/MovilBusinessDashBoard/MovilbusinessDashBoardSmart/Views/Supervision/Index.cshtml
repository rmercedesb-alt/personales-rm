/* ══════════════════════════════════════════════════════════════════════════
   REPORTES PROGRAMADOS — genérico, reusado por Cierre Diario y Ventas
   Proyectadas (y cualquier reporte futuro de PDF Presentaciones). Pedido
   explícito del usuario 2026-09-03, tras probar la 1ª versión de envío
   (que solo mandaba "Cierre Diario" a las 6pm con filtros por defecto):
   "cuál reporte se envía, cómo me entero si salió, decidir a quién le envío
   cada combinación de filtros, y poder enviar ad-hoc lo que tengo en pantalla".
   ══════════════════════════════════════════════════════════════════════════ */
const PROG={ctx:null, destCache:null, editId:0, duplicando:null};
const PG_REPORTE_NOMBRE={ gobierno_comercial_ventas_proyectadas:'Ventas Proyectadas', cierres_cierre_diario:'Cierre Diario' };

function progCargarDestinatarios(cb){
  if(PROG.destCache){ cb(PROG.destCache); return; }
  fetch(BASE+'/apipdfpres/cierres/destinatarios').then(r=>r.json()).then(j=>{
    PROG.destCache=(j&&j.ok)?j.items:[]; cb(PROG.destCache);
  }).catch(()=>cb([]));
}

// ── Modal "Programar envío" — reusado también para EDITAR una programación ya
// guardada (pgAbrirEditar le pasa un ctx con _editId y _preseleccion) ──
function abrirModalProgramar(ctx){
  // Si venimos de "🗐 Duplicar" (pgDuplicar dejó esto pendiente antes de traer al
  // usuario a esta pantalla a ajustar el filtro que cambia, ej. Supervisor — no se
  // pudo abrir el modal directo desde ahí porque tapa la pantalla y no dejaría
  // tocar los filtros), se sobreescriben nombre/hora/destinatarios con los de la
  // programación original, UNA sola vez.
  if(PROG.duplicando){ ctx=Object.assign({}, ctx, {nombreDefault:PROG.duplicando.nombreDefault, horaDefault:PROG.duplicando.horaDefault, _preseleccion:PROG.duplicando.preseleccion, _volverAProgramados:true}); PROG.duplicando=null; }
  PROG.ctx=ctx; PROG.editId=ctx._editId||0;
  $('#prog-nombre').value=ctx.nombreDefault||'';
  $('#prog-hora').value=ctx.horaDefault||'18:00';
  const pre=ctx._preseleccion||[];
  progCargarDestinatarios(items=>{
    const activos=items.filter(d=>d.activo);
    const host=$('#prog-dest-list');
    host.innerHTML=activos.length ? activos.map(d=>
      '<label style="display:flex;align-items:center;gap:8px;padding:4px 2px;cursor:pointer"><input type="checkbox" data-pd="'+d.desId+'" '+(pre.includes(d.desId)?'checked':'')+'> <span>'+d.nombre+' <span class="n">('+d.email+(d.telefono?(' · 📱 '+d.telefono):'')+')</span></span></label>'
    ).join('') : '<div class="hint">Agrega destinatarios primero (✉️ Destinatarios).</div>';
  });
  $('#modal-programar').classList.add('on');
}
// Valida "18:00" o "10:00,12:00,15:00,17:15" antes de mandarlo al backend (que
// vuelve a validar igual, esto es solo para no hacer el viaje si ya se ve mal).
function progHorasValidas(txt){
  const partes=(txt||'').split(',').map(s=>s.trim()).filter(Boolean);
  if(!partes.length) return false;
  return partes.every(p=>/^\d{1,2}:\d{2}$/.test(p));
}
function guardarProgramacion(){
  const nombre=$('#prog-nombre').value.trim(), hora=$('#prog-hora').value.trim();
  if(!nombre||!hora){ toast('Falta nombre u hora'); return; }
  if(!progHorasValidas(hora)){ toast('Hora inválida — usa HH:mm, ej. 18:00 o 10:00,12:00,15:00,17:15'); return; }
  const desSel=$$('#prog-dest-list [data-pd]').filter(c=>c.checked).map(c=>+c.dataset.pd);
  if(!desSel.length){ toast('Selecciona al menos un destinatario'); return; }
  const btn=$('#prog-guardar'); btn.disabled=true; const t0=btn.textContent; btn.textContent='Guardando…';
  fetch(BASE+'/apipdfpres/programados',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({ProgId:PROG.editId||0, Reporte:PROG.ctx.reporte, Nombre:nombre, Filtros:PROG.ctx.filtrosGetter(), HoraEnvio:hora, Activo:true, Destinatarios:desSel})})
    .then(r=>r.json()).then(j=>{
      btn.disabled=false; btn.textContent=t0;
      if(j&&j.ok){
        toast('Programación guardada ✓'); $('#modal-programar').classList.remove('on');
        if(PROG.ctx._volverAProgramados){ ppShow('pp-programados'); pgCargar(); }
        else if(!$('#pp-programados').classList.contains('hide')) pgCargar();
      }
      else toast((j&&j.error)||'No se pudo guardar');
    }).catch(e=>{ btn.disabled=false; btn.textContent=t0; toast('Error: '+e); });
}

