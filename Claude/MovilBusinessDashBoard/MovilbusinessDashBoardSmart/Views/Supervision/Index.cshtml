// ── ANÁLISIS ──────────────────────────────────────────────────────────────
const TIPONM={acomp:'Acompañamiento',audit:'Auditoría',virtual:'Virtual'};
function factorNm(code){const f=[...FACAcomp,...FACAudit].find(x=>x.codigo===code);return f?f.nombre:code;}
function fmtDur(m){ if(m==null||m<=0)return'—'; if(m<60)return m+' min'; const h=Math.floor(m/60),mm=m%60; return h+'h'+(mm?' '+mm+'m':''); }
function anKpi(l,v){return '<div style="background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:8px 12px;min-width:96px"><div style="font-size:18px;font-weight:800;line-height:1.1">'+v+'</div><div class="n">'+l+'</div></div>';}
let AN={group:'vendedor',vista:'res',filas:[],evals:[]};

function anParams(extra){
  const p=new URLSearchParams();
  p.set('desde',$('#an-desde').value); p.set('hasta',$('#an-hasta').value);
  const s=FILT.an.sup.values(); if(s.length)p.set('supervisores',s.join(','));
  const v=FILT.an.ven.values(); if(v.length)p.set('reps',v.join(','));
  const t=FILT.an.tipo.values(); if(t.length)p.set('tipos',t.join(','));
  if(extra)Object.keys(extra).forEach(k=>p.set(k,extra[k]));
  return p.toString();
}
function anPrintHead(){ const g=$('#an-group').selectedOptions[0].text, v=$('#an-vista').selectedOptions[0].text;
  $('#an-phead').innerHTML='<b>Análisis de Supervisión</b> &middot; '+$('#an-desde').value+' a '+$('#an-hasta').value+' &middot; Agrupado por '+g+' &middot; '+v; }
function anGenerar(){
  AN.group=$('#an-group').value; AN.vista=$('#an-vista').value;
  $('#an-exp').classList.add('hide'); anPrintHead();
  $('#an-tbody').innerHTML='<tr><td class="l">Cargando…</td></tr>'; $('#an-kpis').innerHTML='';
  if(AN.vista==='det'){
    fetch(BASE+'/apisuperv/evaluaciones?'+anParams()).then(r=>r.json()).then(j=>{
      if(!j||!j.ok){$('#an-tbody').innerHTML='<tr><td class="l" colspan="10">⚠ '+escA((j&&j.error)||'Error')+'</td></tr>';return;}
      AN.evals=j.evaluaciones||[]; renderAnDetallada();
    }).catch(e=>{$('#an-tbody').innerHTML='<tr><td class="l" colspan="10">⚠ '+escA(e.message||e)+'</td></tr>';});
  }else{
    fetch(BASE+'/apisuperv/analisis?'+anParams({group:AN.group})).then(r=>r.json()).then(j=>{
      if(!j||!j.ok){$('#an-tbody').innerHTML='<tr><td class="l" colspan="11">⚠ '+escA((j&&j.error)||'Error')+'</td></tr>';return;}
      AN.filas=j.filas||[]; renderAnResumida();
    }).catch(e=>{$('#an-tbody').innerHTML='<tr><td class="l" colspan="11">⚠ '+escA(e.message||e)+'</td></tr>';});
  }
}
function renderAnResumida(){
  const g=AN.group; let rows=AN.filas.slice();
  if(g==='dia')rows.sort((a,b)=>a.key<b.key?1:-1);
  if(g==='factor'){
    $('#an-kpis').innerHTML=anKpi('Factores',rows.length)+anKpi('Evaluaciones',rows.reduce((a,r)=>a+(r.nTotal||0),0));
    $('#an-thead').innerHTML='<tr><th class="l">Factor / Pregunta</th><th class="l">Tipo</th><th>Estrellas</th><th>Prom /100</th><th>Evaluaciones</th></tr>';
    $('#an-tbody').innerHTML=rows.length?rows.map(r=>'<tr><td class="l">'+escA(factorNm(r.key))+'</td><td class="l">'+(TIPONM[r.tipo]||r.tipo||'')+'</td><td style="font-size:15px;color:'+scoreColor(r.indiceProm)+'">'+starDisp(r.indiceProm)+'</td><td><b style="color:'+scoreColor(r.indiceProm)+'">'+(r.indiceProm!=null?Math.round(r.indiceProm):'—')+'</b></td><td>'+r.nTotal+'</td></tr>').join(''):'<tr><td class="l" colspan="5">Sin datos en el rango.</td></tr>';
    return;
  }
  // KPIs
  let sup=0,ac=0,au=0,vi=0,cli=0,dur=0,isum=0,icnt=0;
  rows.forEach(r=>{sup+=r.nTotal||0;ac+=r.nAcomp||0;au+=r.nAudit||0;vi+=r.nVirtual||0;cli+=r.clientes||0;dur+=r.durTotal||0;const nc=(r.nAcomp||0)+(r.nAudit||0);if(r.indiceProm!=null&&nc>0){isum+=r.indiceProm*nc;icnt+=nc;}});
  const idxG=icnt>0?Math.round(isum/icnt):null;
  $('#an-kpis').innerHTML=anKpi('Supervisiones',sup)+anKpi('Acomp',ac)+anKpi('Audit',au)+anKpi('Virtual',vi)+anKpi('Clientes',cli)+anKpi('Duración',fmtDur(dur))+anKpi('Índice prom',idxG!=null?idxG:'—');
  const lblCol=g==='compania'?'Compañía':g==='supervisor'?'Supervisor':g==='vendedor'?'Vendedor':g==='tipo'?'Tipo':'Día';
  $('#an-thead').innerHTML='<tr><th class="l">'+lblCol+'</th><th>Superv.</th><th>Acomp</th><th>Audit</th><th>Virtual</th><th>Clientes</th><th>Dur. total</th><th>Dur. prom</th><th>Índice</th><th>Banda</th><th></th></tr>';
  $('#an-tbody').innerHTML=rows.length?rows.map(r=>{
    const et=g==='tipo'?(TIPONM[r.key]||r.etiqueta):(g==='compania'?'Compañía':(r.etiqueta||r.key));
    const idx=r.indiceProm!=null?'<b style="color:'+scoreColor(r.indiceProm)+'">'+Math.round(r.indiceProm)+'</b>':'—';
    const bn=r.banda?'<span class="band '+r.banda+'">'+r.banda+'</span>':'';
    const ver=(g==='vendedor'||g==='supervisor'||g==='dia')?'<button class="rbtn" data-drill="'+escA(r.key)+'">Ver</button>':'';
    return '<tr><td class="l"><b>'+escA(et)+'</b></td><td>'+r.nTotal+'</td><td>'+r.nAcomp+'</td><td>'+r.nAudit+'</td><td>'+r.nVirtual+'</td><td>'+r.clientes+'</td><td>'+fmtDur(r.durTotal)+'</td><td>'+fmtDur(r.durProm)+'</td><td>'+idx+'</td><td>'+bn+'</td><td>'+ver+'</td></tr>';
  }).join(''):'<tr><td class="l" colspan="11">Sin datos en el rango.</td></tr>';
  $$('#an-tbody [data-drill]').forEach(b=>b.onclick=()=>anDrill(b.dataset.drill));
}
function anDrill(key){
  const g=AN.group; const extra={};
  if(g==='vendedor')extra.reps=key; else if(g==='supervisor')extra.supervisores=key; else if(g==='dia')extra.dia=key;
  $('#an-vista').value='det'; AN.vista='det';
  $('#an-tbody').innerHTML='<tr><td class="l">Cargando…</td></tr>';
  fetch(BASE+'/apisuperv/evaluaciones?'+anParams(extra)).then(r=>r.json()).then(j=>{
    if(!j||!j.ok){toast((j&&j.error)||'Error');return;}
    AN.evals=j.evaluaciones||[]; renderAnDetallada();
  });
}
