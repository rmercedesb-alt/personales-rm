let selRep=null, calleMode='acomp', evalClients=[], activeIdx=-1, repClientes=[];
let repSelMs=null;
function buildRepSel(){const opts=REPS.map(r=>({v:r.RepCodigo,t:r.RepNombre+' · '+r.RepCodigo}));
  repSelMs=msel($('#repSel'),opts,{multi:false,placeholder:'Elige vendedor',onChange:()=>{const v=repSelMs.values()[0];selRep=repObj(v);loadClientes();toast('Vendedor: '+(selRep?selRep.RepNombre:''));}});
  if(REPS.length){selRep=REPS[0];repSelMs.set([REPS[0].RepCodigo]);loadClientes();}}
function repObj(cod){return REPS.find(r=>r.RepCodigo===cod);}
function newSc(){return {acomp:FACAcomp.map(()=>20),audit:FACAudit.map(()=>20)};}  // cliente nuevo = 1 estrella (20)
function loadClientes(){ if(!selRep)return; evalClients=[];activeIdx=-1;repClientes=[];renderCbar();renderSteps();
  api('/clientes?rep='+encodeURIComponent(selRep.RepCodigo)).then(j=>{repClientes=(j&&j.clientes)||[];$('#csearch').classList.add('on');renderRes('');}); }
$$('#submode button').forEach(b=>b.onclick=()=>{$$('#submode button').forEach(x=>x.classList.remove('on'));b.classList.add('on');calleMode=b.dataset.m;renderSteps();});
function consArr(m){const fs=facFor(m),a=[];for(let i=0;i<fs.length;i++){if(!evalClients.length){a.push(0);continue;}let s=0;evalClients.forEach(c=>s+=c.sc[m][i]);a.push(Math.round(s/evalClients.length));}return a;}
function curArr(){if(activeIdx==='cons')return consArr(calleMode);if(typeof activeIdx==='number'&&evalClients[activeIdx])return evalClients[activeIdx].sc[calleMode];return null;}
function renderCbar(){const bar=$('#cbar');bar.innerHTML='';
  evalClients.forEach((c,i)=>{const chip=document.createElement('div');chip.className='cchip'+(activeIdx===i?' on':'');chip.title=c.cod+' · '+c.nom;chip.innerHTML='<span class="nm">'+c.nom+'</span><span class="x" data-x="'+i+'">✕</span>';chip.onclick=e=>{if(e.target.dataset.x!==undefined)return;activeIdx=i;renderCbar();renderSteps();};bar.appendChild(chip);});
