/* ── IEGT (fórmula idéntica a Seguimientos) ── */
const CFG={pesos:{visitas:30,inicio:20,cierre:10,ventas:10,ruta:10,pdv:10,ritmo:10},visitas:{v100:98,v75:95,v50:88},inicio:{min100:495,min50:525},cierre:{min100:930,min50:870},ventas:{bandLo:55,bandHi:65,tol:5}};
function subVisitas(ef){return ef>=CFG.visitas.v100?100:ef>=CFG.visitas.v75?75:ef>=CFG.visitas.v50?50:25;}
function subInicio(m){if(m==null)return 0;return m<=CFG.inicio.min100?100:m<=CFG.inicio.min50?50:0;}
function subCierre(m){if(m==null)return 0;return m>=CFG.cierre.min100?100:m>=CFG.cierre.min50?50:0;}
function subVentas(ef){const c=CFG.ventas;return (ef>=c.bandLo&&ef<=c.bandHi)?100:(ef>=c.bandLo-c.tol&&ef<=c.bandHi+c.tol)?60:25;}
function subRuta(n){return n===0?100:n===1?80:n===2?50:20;}
function subPDV(n){return n<=2?100:n<=5?70:n<=10?40:15;}
function subRitmo(seg,med){if(!seg||!med)return 100;const d=Math.abs(seg-med)/med;return d<=0.25?100:d<=0.5?60:30;}
function efVis(v){return v.TotVis?100*v.Visitados/v.TotVis:0;}
function efVen(v){return v.Visitados?100*v.Pedidos/v.Visitados:0;}
function iegtDe(v,med){const p=CFG.pesos,tot=p.visitas+p.inicio+p.cierre+p.ventas+p.ruta+p.pdv+p.ritmo;return (p.visitas*subVisitas(efVis(v))+p.inicio*subInicio(v.PrimerMin)+p.cierre*subCierre(v.UltimoMin)+p.ventas*subVentas(efVen(v))+p.ruta*subRuta(v.FueraRuta)+p.pdv*subPDV(v.FueraPDV)+p.ritmo*subRitmo(v.PromSeg,med))/tot;}
function median(a){const x=a.filter(n=>n!=null).sort((p,q)=>p-q);if(!x.length)return null;const m=Math.floor(x.length/2);return x.length%2?x[m]:(x[m-1]+x[m])/2;}

/* ── Matriz de priorización / reportes (Plan = pl, Reportes = rg) ── */
let MATRIX={pl:{rows:[],meta:{}},rg:{rows:[],meta:{}}};
function buildMatrix(pf){
  const desde=$('#'+pf+'-desde').value,hasta=$('#'+pf+'-hasta').value;
  const fSups=(FILT[pf].sup?FILT[pf].sup.values():[]),fVens=(FILT[pf].ven?FILT[pf].ven.values():[]),fDivs=(FILT[pf].div?FILT[pf].div.values():[]);
  $('#'+pf+'-tbody').innerHTML='<tr><td class="l">Calculando…</td></tr>';
  const sp=new URLSearchParams();sp.set('fechaIni',desde);sp.set('fechaFin',hasta);
  if(fDivs.length)sp.set('divisiones',fDivs.join(','));
  if(fSups.length)sp.set('supervisores',fSups.join(','));
  else if(!ID.veTodo&&ID.supcods&&ID.supcods.length)sp.set('supervisores',ID.supcods.join(','));
  Promise.all([fetch(BASE+'/apiseg/semana?'+sp.toString()).then(r=>r.json()),api('/reportes?desde='+desde+'&hasta='+hasta)]).then(([sg,rp])=>{
    const vend=(sg&&sg.vendedores)||[]; const med=median(vend.map(v=>v.PromSeg));
    const map={};
    vend.forEach(v=>{map[v.RepCodigo]={rep:v.RepCodigo,nom:v.RepNombre,sup:v.Supervisor,supcod:v.SupCod,centro:v.Centro,div:v.Division,iegt:Math.round(iegtDe(v,med)*10)/10,acomp:null,audit:null,nAc:0,nAu:0,nVi:0};});
    ((rp&&rp.filas)||[]).forEach(f=>{let m=map[f.RepCodigo];if(!m){const ro=REPS.find(r=>r.RepCodigo===f.RepCodigo)||{};m=map[f.RepCodigo]={rep:f.RepCodigo,nom:f.RepNombre||ro.RepNombre||f.RepCodigo,sup:ro.Supervisor||'',supcod:f.SupCod||ro.SupCod||'',centro:ro.Centro||'',div:ro.Division||'',iegt:null,acomp:null,audit:null,nAc:0,nAu:0,nVi:0};}m.acomp=f.promAcomp;m.audit=f.promAudit;m.nAc=f.NAcomp;m.nAu=f.NAudit;m.nVi=f.NVirt;});
    let rows=Object.values(map);
    if(fSups.length)rows=rows.filter(r=>fSups.includes(r.supcod));
    if(fVens.length)rows=rows.filter(r=>fVens.includes(r.rep));
    if(fDivs.length)rows=rows.filter(r=>fDivs.includes(r.div));
    rows.forEach(r=>{r.global=globalIdx(r.iegt,r.acomp,r.audit);r.trabajado=(r.nAc+r.nAu+r.nVi)>0;});
    rows.sort((a,b)=>{const s=(a.sup||'').localeCompare(b.sup||'');if(s)return s;const ta=a.trabajado?1:0,tb=b.trabajado?1:0;if(ta!==tb)return ta-tb;const ia=a.iegt==null?999:a.iegt,ib=b.iegt==null?999:b.iegt;return ia-ib;});
    MATRIX[pf]={rows,meta:{desde,hasta,vista:$('#'+pf+'-vista').value}};
    renderMatrix(pf);
  }).catch(e=>{$('#'+pf+'-tbody').innerHTML='<tr><td class="l">Error: '+e+'</td></tr>';});
}
