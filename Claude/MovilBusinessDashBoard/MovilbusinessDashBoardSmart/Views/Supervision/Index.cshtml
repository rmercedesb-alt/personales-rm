function cdSeccionHtml(titulo, sec, conAjustada, modo){
  const esMes=modo==='mes';
  const cab=esMes
    ? '<tr><th class="l">Nivel</th><th>Presupuesto</th><th>Presupuesto al Día</th><th>Logro al Día %</th><th>Ejecutado</th><th>Logro Acumulado %</th><th>Diferencia</th></tr>'
    : '<tr><th class="l">Nivel</th><th>Presupuesto</th><th>Ejecutado</th><th>Logro del día %</th><th>Diferencia</th>'
      +(conAjustada?'<th>Meta Ajustada</th><th>Logro Ajustado %</th><th>Diferencia Ajustada</th>':'')+'</tr>';
  return '<div class="pp-block">'
    +'<div class="sec-title"><h3>'+titulo+'</h3>'+(sec.aviso?'<span class="n" style="color:#b8860b">⚠ '+sec.aviso+'</span>':'')+'</div>'
    +'<div class="scroller"><table><thead>'+cab.replace('Nivel','Centro')+'</thead><tbody>'+cdTablaAlcance(sec.porCentro,conAjustada,modo)+'</tbody></table></div>'
    +'<div class="scroller" style="margin-top:8px"><table><thead>'+cab.replace('Nivel','Canal')+'</thead><tbody>'+cdTablaAlcance(sec.porCanal,conAjustada,modo)+'</tbody></table></div>'
    +'<div class="scroller" style="margin-top:8px"><table><thead>'+cab.replace('Nivel','Supervisor'+(CD.detallado?' / Vendedor':''))+'</thead><tbody>'+cdTablaSupervisor(sec.porSupervisor,conAjustada,modo)+'</tbody></table></div>'
    +'<div class="scroller" style="margin-top:8px"><table><thead>'+cab.replace('Nivel','Suplidor'+(CD.detallado?' / Categoría':''))+'</thead><tbody>'+cdTablaSuplidorConCategorias(sec.porSuplidor,conAjustada,modo)+'</tbody></table></div>'
    +'</div>';
}

// Calendario de 30 días (Dom-Lun-...-Sáb), terminando en la fecha del informe — cada
// celda es el valor del día + indicador ▲/▼ vs. el mismo día de la semana anterior.
function cdCalendarioHtml(titulo, dias, esMoneda){
  if(!dias||!dias.length) return '<div class="hint">Sin datos.</div>';
  // Alinear el primer día mostrado a su Domingo correspondiente (relleno vacío antes).
  const primerDow=new Date(dias[0].fecha+'T00:00:00').getDay(); // 0=Dom
  let celdas='';
  for(let i=0;i<primerDow;i++) celdas+='<div class="cd-cal-cell cd-cal-empty"></div>';
  dias.forEach(d=>{
    const v=esMoneda?('RD$ '+cdFmt(d.valor)):cdFmt(d.valor);
    const delta=d.deltaPct;
    const flecha=delta==null?'':(delta>=0?'▲':'▼');
    const color=delta==null?'var(--muted)':(delta>=0?'#1f8b4c':'#c0392b');
    celdas+='<div class="cd-cal-cell"><div class="cd-cal-dia">'+d.diaMes+'</div><div class="cd-cal-val">'+v+'</div>'
      +(delta!=null?'<div class="cd-cal-delta" style="color:'+color+'">'+flecha+' '+Math.abs(delta).toFixed(1)+'%</div>':'')+'</div>';
  });
  return '<div class="sec-title"><h4 style="margin:0">'+titulo+'</h4></div>'
    +'<div class="cd-cal-head"><div>Dom</div><div>Lun</div><div>Mar</div><div>Mié</div><div>Jue</div><div>Vie</div><div>Sáb</div></div>'
    +'<div class="cd-cal-grid">'+celdas+'</div>';
}

function cdRenderReporte(j){
  const genStr=(CD.generadoEn||new Date()).toLocaleString('es-DO');
  const filtrosTxt=CD.filtrosUsados||cdResumenFiltrosTexto();
  const fFiltros=j.filtros||{};
  const detalleFiltro=['suplidor','categoria','centros','canales','divisiones','supervisores','vendedores']
    .map(k=>(fFiltros[k]&&fFiltros[k].length)?(k+': '+fFiltros[k].join(', ')):null).filter(Boolean).join(' · ');

  $('#cd-reporte').innerHTML=
    '<div class="pp-report">'
    +'<div class="pp-band"><div class="rt">Cierre del día '+j.fecha+'</div><div class="rs">Supervisión Dinámica · Cierres · Generado '+genStr+(detalleFiltro?(' · '+detalleFiltro):'')+'</div></div>'
    +'<div class="bd">'
    +'<div class="pp-block">'
      +'<p style="font-size:13px;color:#57606a">En este reporte podrás visualizar los siguientes reportes:</p>'
      +'<ol style="font-size:13px;color:#57606a;padding-left:20px;margin:0">'
        +'<li>Resultados acumulados del Mes (Por Centro, Canal, Supervisor/Vendedor y Suplidor/Categoría)</li>'
        +'<li>Ventas Vs. Presupuestos del día (Por Centro, Canal, Supervisor/Vendedor y Suplidor/Categoría)</li>'
        +'<li>Histórico de Ventas</li><li>Histórico de Activaciones</li><li>Resumen ejecutivo del día</li>'
      +'</ol>'
    +'</div>'
    +'<div class="pp-block">'
      +'<div class="sec-title"><h3>1. Resultados acumulados del Mes</h3>'
        +'<span class="n">Día hábil '+j.diasTranscurridos+' de '+j.diasDelMes+' · faltan '+j.diasRestantes+' día'+(j.diasRestantes===1?'':'s')+' hábil'+(j.diasRestantes===1?'':'es')+'</span></div>'
