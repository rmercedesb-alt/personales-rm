    let h='<div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:6px">';
    h+='<div><b style="font-size:15px">'+escA(c.repNombre||c.rep)+'</b> &middot; Virtual &middot; '+c.fecha+' '+c.hora+'</div><button class="rbtn" data-close="1">✕ Cerrar</button></div>';
    h+='<div class="kpis" style="margin:10px 0">'+anKpi('Supervisor',escA(c.supervisor||'—'))+anKpi('Centro',escA(c.centro||'—'))+anKpi('Canal',escA(c.canal||'—'))+anKpi('Contacto con',escA(c.contactoCon||'—'))+anKpi('Suplidores',escA(c.suplidores||'Todos'))+'</div>';
    h+='<div class="sec-title"><h3>Alertas de Torre atendidas</h3></div><div class="rbox">'+(c.alertas?escA(c.alertas):'—')+'</div>';
    if(c.resumen)h+='<div class="sec-title"><h3>Comentario</h3></div><div class="rbox">'+escA(c.resumen)+'</div>';
    if(c.compromiso)h+='<div class="sec-title"><h3>Compromiso</h3></div><div class="rbox">'+escA(c.compromiso)+'</div>';
    ex.innerHTML=h;
    const cb=ex.querySelector('[data-close]');if(cb)cb.onclick=()=>ex.classList.add('hide');
    ex.scrollIntoView({behavior:'smooth',block:'start'});
  }).catch(e=>{ex.innerHTML='<div class="hint">⚠ '+escA(e.message||e)+'</div>';});
}

/* ── VIRTUAL ── */
let vContact={}; // RepCodigo -> {n, ultima}  ·  se permiten TANTOS contactos como sea necesario en el día
function renderVirtual(){
  const box=$('#vlist');
  if(!REPS.length){box.innerHTML='<div class="hint">Sin representantes en tu alcance.</div>';$('#vcount').textContent='';return;}
  box.innerHTML=REPS.map((r,i)=>{const vc=vContact[r.RepCodigo];
    return '<div class="vrow" data-q="'+(r.RepNombre+' '+r.RepCodigo).toLowerCase()+'"><div class="vn">'+r.RepNombre+' · '+r.RepCodigo+'<div class="m">'+r.Supervisor+' · '+r.Centro+'</div></div>'+
      '<span class="alsum" id="alsum'+i+'" style="font-size:11px;color:var(--muted)">…</span>'+
      '<span class="vdone" id="vdone'+i+'" style="margin-left:8px;font-size:11px;color:var(--good);font-weight:700">'+(vc?'✓ '+vc.n+' contacto'+(vc.n>1?'s':'')+' hoy · últ. '+vc.ultima:'')+'</span>'+
      '<div style="margin-left:auto"><button class="vbtn pri" data-i="'+i+'">'+(vc?'+ Nuevo contacto':'Cargar vendedor')+'</button></div>'+
      '<div class="cform" id="cf'+i+'"><div class="alertbox"><div class="hd">🛰️ Alertas del momento · Torre de Control</div><div class="alerts" id="al'+i+'">Cargando…</div></div>'+
      '<div class="fg"><label>Suplidores</label><button type="button" class="supchip" data-sup="'+i+'" style="width:100%">Todos ▾</button><div class="suppanel" id="vsup'+i+'" style="padding:0"></div></div>'+
      '<div class="fg"><label>Canal</label><select id="vcanal'+i+'"><option>Llamada</option><option>WhatsApp</option><option>Videollamada</option></select></div>'+
      '<div class="fg"><label>Contacto con</label><select id="vcon'+i+'"><option>Vendedor</option><option>Vendedor + supervisor</option></select></div>'+
      '<div class="fg full"><label>Comentario</label><textarea id="vcom'+i+'" rows="2" placeholder="Alerta trabajada / observación…"></textarea></div>'+
      '<div class="fg full"><label>Compromiso</label><textarea id="vcompr'+i+'" rows="2" placeholder="Compromiso acordado…"></textarea></div>'+
      '<div class="fg" style="flex:none;display:flex;align-items:flex-end"><button class="vbtn pri" data-save="'+i+'">Guardar contacto</button></div></div></div>';
  }).join('');
  $$('#vlist [data-sup]').forEach(b=>{const i=b.dataset.sup;b._sup=makeSup(b,$('#vsup'+i));});
  $$('#vlist [data-i]').forEach(b=>b.onclick=()=>{const i=+b.dataset.i;const cf=$('#cf'+i);cf.classList.toggle('on');if(cf.classList.contains('on'))loadAlertas(i);});
  $$('#vlist [data-save]').forEach(b=>b.onclick=()=>saveContacto(+b.dataset.save));
  updVcount(); REPS.forEach((r,i)=>loadAlertasSummary(i));
}
function loadAlertasSummary(i){const r=REPS[i];api('/alertas?rep='+encodeURIComponent(r.RepCodigo)).then(j=>{const el=$('#alsum'+i);if(!el)return;
  if(j&&j.enMute){el.innerHTML='<span style="color:var(--warn);font-weight:700">⏸ en pausa hasta '+(j.pausadoHasta||'')+'</span>';el._alertas=[];return;}
  const n=(j&&j.alertas)?j.alertas.length:0;
  el.innerHTML=n?'<span style="color:var(--bad);font-weight:800">🔔 '+n+' alerta'+(n!==1?'s':'')+'</span>':'<span style="color:var(--good);font-weight:700">✓ Sin alertas</span>';el._alertas=(j&&j.alertas)||[];});}
function loadAlertas(i){const r=REPS[i];const box=$('#al'+i);api('/alertas?rep='+encodeURIComponent(r.RepCodigo)).then(j=>{
  if(j&&j.enMute){r._alertas=[];box.innerHTML='<span class="alert clean">⏸ Vendedor en pausa de seguimiento (comentario reciente) · se reactiva a las '+(j.pausadoHasta||'')+'</span>';return;}
  const al=(j&&j.alertas)||[];r._alertas=al;
  box.innerHTML=al.length?al.map(a=>'<span class="alert s'+(a.severidad||1)+'"><span>'+(a.detalle||a.nombre)+'</span>'+(a.desde?'<span class="atime">🕐 desde '+a.desde+(a.minutos!=null?' · hace '+Math.floor(a.minutos/60)+'h '+(a.minutos%60)+'m':'')+'</span>':'')+'</span>').join(''):'<span class="alert clean">✓ Sin alertas activas</span>';});}
function saveContacto(i){const r=REPS[i];
  const payload={repCodigo:r.RepCodigo,repNombre:r.RepNombre,supCod:r.SupCod,supervisor:r.Supervisor,centro:r.Centro,
    canal:$('#vcanal'+i).value,contactoCon:$('#vcon'+i).value,suplidores:($$('#vlist [data-sup]')[i]&&$$('#vlist [data-sup]')[i]._sup)?$$('#vlist [data-sup]')[i]._sup.text():'Todos',
    comentario:$('#vcom'+i).value,compromiso:$('#vcompr'+i).value,alertas:(r._alertas||[]).map(a=>a.codigo)};
  api('/contacto',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)}).then(j=>{
    if(j&&j.ok){
      const prev=vContact[r.RepCodigo]||{n:0};
      vContact[r.RepCodigo]={n:prev.n+1,ultima:j.hora};
      $('#vcom'+i).value=''; $('#vcompr'+i).value='';
      const vd=$('#vdone'+i); if(vd)vd.textContent='✓ '+vContact[r.RepCodigo].n+' contacto'+(vContact[r.RepCodigo].n>1?'s':'')+' hoy · últ. '+j.hora;
      const btn=$$('#vlist [data-i]')[i]; if(btn)btn.textContent='+ Nuevo contacto';
      updVcount(); loadAlertasSummary(i); loadAlertas(i);
      toast('Contacto registrado · '+r.RepNombre+' (sus alertas se pausan '+(j.muteMin||60)+' min)');
    } else toast('Error: '+((j&&j.error)||''));
  }).catch(e=>toast('Error: '+e));}
function updVcount(){const n=Object.keys(vContact).length,t=REPS.length;$('#vcount').textContent=n+' de '+t+' representantes contactados';$('#vbar').style.width=(t?Math.round(n/t*100):0)+'%';}

/* ── COBROS DEL DÍA ── */
const COBROS={_loaded:false,_contLoaded:false,_matrizLoaded:false,_repLoaded:false,cfgId:0,cfgs:[],filas:[],expandSup:{},editId:0,matriz:null,matrizExp:{}};
function cobrosBoot(){
  $$('#view-cobros .subtabs button[data-cv]').forEach(b=>b.onclick=()=>{
    $$('#view-cobros .subtabs button[data-cv]').forEach(x=>x.classList.remove('on')); b.classList.add('on');
    const cv=b.dataset.cv;
    $('#cb-estado').classList.toggle('hide', cv!=='estado');
    $('#cb-matriz').classList.toggle('hide', cv!=='matriz');
    $('#cb-contactos').classList.toggle('hide', cv!=='contactos');
    $('#cb-reportes').classList.toggle('hide', cv!=='reportes');
    if(cv==='contactos'&&!COBROS._contLoaded){COBROS._contLoaded=true;cobrosContactosGenerar();}
    if(cv==='matriz'&&!COBROS._matrizLoaded){COBROS._matrizLoaded=true;cobrosMatrizCargar();}
    if(cv==='reportes'&&!COBROS._repLoaded){COBROS._repLoaded=true;cobrosReporteGenerar();}
  });
  $('#cbmGo').onclick=cobrosMatrizCargar;
  $('#cbmSup').onchange=()=>{cobrosMatrizPobVend();renderCobrosMatriz();};
  ['#cbmVen','#cbmAlerta','#cbmSem'].forEach(s=>$(s).onchange=renderCobrosMatriz);
  $('#cbrSup').onchange=cobrosReporteGenerar;
  $('#cbrGo').onclick=cobrosReporteGenerar;
  $('#cbrPrint').onclick=cobrosReporteImprimir;
  $('#cbrDesde').value=dateF(new Date()); $('#cbrHasta').value=dateF(new Date());
  $('#cbRefresh').onclick=()=>{cobrosLoad();cobrosCargarResumen();};
  $$('#view-cobros [data-corte]').forEach(b=>b.onclick=()=>cobrosGuardarCorte(b.dataset.corte));
  $('#cbCfgBtn').onclick=()=>{ $('#cbCfgBox').classList.toggle('hide'); if(!$('#cbCfgBox').classList.contains('hide'))renderCbCfgBody(); };
  $('#cbcTipo').onchange=cobrosAjustarCamposCfg;
  $('#cbcMedicion').onchange=cobrosAjustarCamposCfg;
  $('#cbcAdd').onclick=cobrosAgregarCfg;
  $('#cbcCancel').onclick=cobrosCancelarEdicion;
  if(ID.veTodo)$('#cbCfgBtn').classList.remove('hide'); else $('#cbCfgBtn').classList.add('hide');
  const hoy=dateF(new Date());
  $('#cbcoDesde').value=hoy; $('#cbcoHasta').value=hoy;
  $('#cbcoGo').onclick=cobrosContactosGenerar;
  cobrosAjustarCamposCfg();
  cobrosPobSuplidores();
  cobrosCargarConfig();
  cobrosCargarResumen();
}
function cobrosAjustarCamposCfg(){
  const t=$('#cbcTipo').value, med=$('#cbcMedicion').value;
  $('#cbcPreTipo').closest('.fl').style.display = t==='presupuesto' ? '' : 'none';
  $('#cbcMedicion').closest('.fl').style.display = t==='activaciones' ? '' : 'none';
  $('#cbcProId').closest('.fl').style.display = (t==='producto'||(t==='activaciones'&&med==='producto')) ? '' : 'none';
  $('#cbcLinId').closest('.fl').style.display = (t==='activaciones'&&med==='categoria') ? '' : 'none';
  $('#cbcCat3Id').closest('.fl').style.display = (t==='activaciones'&&med==='suplidor') ? '' : 'none';
  $('#cbcMeta').closest('.fl').style.display = (t==='pedidos'||t==='producto'||t==='activaciones') ? '' : 'none';
}
function cobrosPobSuplidores(){
  const sel=$('#cbcCat3Id'); if(!sel||sel.options.length>1)return;
  SUPPLIERS_RAW.forEach(s=>sel.add(new Option(s.nombre,s.id)));
}
function cobrosCargarConfig(){
  api('/cobros/config').then(j=>{
    COBROS.cfgs=(j&&j.items)||[];
    $('#cbAviso').innerHTML=(j&&j.aviso)?'<div class="hint" style="text-align:left">⚠ '+j.aviso+'</div>':'';
    if(!COBROS.cfgId){const act=COBROS.cfgs.filter(c=>c.activo);COBROS.cfgId=act.length?act[0].cfgId:0;}
    renderCbCfgSel();
    renderCbCfgBody();
    cobrosLoad();
  }).catch(e=>toast('Error config Cobros: '+e));
}
function renderCbCfgSel(){
  const box=$('#cbCfgSel');
  const act=COBROS.cfgs.filter(c=>c.activo);
  if(!act.length){box.innerHTML='';return;}
  box.innerHTML='<select id="cbCfgPick">'+act.map(c=>'<option value="'+c.cfgId+'"'+(c.cfgId===COBROS.cfgId?' selected':'')+'>'+c.nombre+'</option>').join('')+'</select>';
  $('#cbCfgPick').onchange=e=>{COBROS.cfgId=+e.target.value;cobrosLoad();};
}
function cobrosLoad(){
  $('#cblist').innerHTML='<div class="hint">Cargando…</div>';
  api('/cobros?cfgId='+COBROS.cfgId).then(j=>{
    if(!j||!j.ok){toast('Error: '+((j&&j.error)||''));return;}
    COBROS.filas=j.filas||[];
    $('#cbTitle').textContent=j.nombre||'Cobros del día';
    $('#cbCorte').textContent='Corte '+j.corte+(j.esFinal?' · final (sin proyección)':' · proyectado al cierre');
    if(j.aviso)$('#cbAviso').innerHTML='<div class="hint" style="text-align:left">⚠ '+j.aviso+'</div>';
    renderCobrosList();
  }).catch(e=>toast('Error: '+e));
}
function semColor(s){return s==='verde'?'var(--good)':(s==='amarillo'?'var(--warn)':'var(--bad)');}
function semBg(s){return s==='verde'?'var(--good-bg)':(s==='amarillo'?'var(--warn-bg)':'var(--bad-bg)');}
function renderCobrosList(){
  const box=$('#cblist');
  if(!COBROS.filas.length){box.innerHTML='<div class="hint">Sin datos para hoy en tu alcance.</div>';return;}
  const bySup={},orden=[];
  COBROS.filas.forEach(f=>{const k=f.supcod||'—';if(!bySup[k]){bySup[k]={nombre:f.supervisor||'—',filas:[]};orden.push(k);}bySup[k].filas.push(f);});
  let h='';
  orden.forEach(sc=>{
    const g=bySup[sc], open=!!COBROS.expandSup[sc];
    const peor=g.filas[0];
    h+='<div class="vrow cb-suphead" data-sup="'+escA(sc)+'" style="cursor:pointer;background:var(--panel2)">'+
       '<div class="vn">'+(open?'▾':'▸')+' '+escA(g.nombre)+'<div class="m">'+g.filas.length+' vendedores · peor '+(peor?(peor.proyPct!=null?peor.proyPct:peor.logroPct).toFixed(1)+'%':'—')+'</div></div>'+
       '<div style="margin-left:auto"><button class="rbtn" data-contact-sup="'+escA(sc)+'" data-supnom="'+escA(g.nombre)+'" onclick="event.stopPropagation()">📞 Contactar supervisor</button></div></div>'+
       '<div class="cform" id="cbcf-sup-'+escA(sc)+'"></div>'+
       '<div class="cb-supbody" id="cbsup-'+escA(sc)+'" style="'+(open?'':'display:none')+'">';
    g.filas.forEach(f=>{
      const pct=(f.proyPct!=null?f.proyPct:f.logroPct);
      h+='<div class="vrow" style="padding-left:28px"><div class="vn">'+f.nombre+' · '+f.rep+'<div class="m">Meta '+f.meta.toLocaleString()+' · Logro '+f.logro.toLocaleString()+'</div></div>'+
         '<div style="margin-left:auto;text-align:right"><span style="font-weight:800;color:'+semColor(f.semaforo)+'">'+pct.toFixed(1)+'%</span>'+
         (f.proyPct!=null?'<div class="m" style="font-size:10px">real '+f.logroPct.toFixed(1)+'%</div>':'')+'</div>'+
         '<span class="band" style="color:'+semColor(f.semaforo)+';background:'+semBg(f.semaforo)+';margin-left:10px">'+f.semaforo.toUpperCase()+'</span>'+
         '<button class="rbtn" data-contact-rep="'+escA(f.rep)+'" data-repnom="'+escA(f.nombre)+'" data-supcod="'+escA(sc)+'" data-supnom="'+escA(g.nombre)+'" style="margin-left:10px">📞 Contactar</button>'+
         '</div><div class="cform" id="cbcf-'+escA(f.rep)+'"></div>';
    });
    h+='</div>';
  });
  box.innerHTML=h;
  $$('#cblist .cb-suphead').forEach(el=>el.onclick=()=>{ const sc=el.dataset.sup; COBROS.expandSup[sc]=!COBROS.expandSup[sc]; renderCobrosList(); });
  $$('#cblist [data-contact-rep]').forEach(b=>b.onclick=()=>cobrosAbrirContacto('vendedor',b.dataset.contactRep,b.dataset.repnom,b.dataset.supcod,b.dataset.supnom));
  $$('#cblist [data-contact-sup]').forEach(b=>b.onclick=()=>cobrosAbrirContacto('supervisor',null,null,b.dataset.contactSup,b.dataset.supnom));
}
function cobrosAbrirContacto(tipo,rep,repNom,supCod,supNom){
  const elId=tipo==='vendedor'?('cbcf-'+rep):('cbcf-sup-'+supCod);
  const el=document.getElementById(elId); if(!el)return;
  const willOpen=!el.classList.contains('on');
  $$('#cblist .cform.on').forEach(f=>{ if(f.id!==elId)f.classList.remove('on'); });
  el.classList.toggle('on',willOpen);
  if(!willOpen)return;
  el.innerHTML='<div class="alertbox" style="width:100%"><div class="hd">🛰️ Alarmas activas</div><div class="alerts">Cargando…</div></div>';
  const qs=tipo==='vendedor'?('rep='+encodeURIComponent(rep)):('sup='+encodeURIComponent(supCod));
  api('/cobros/alertas?'+qs).then(j=>{
    if(j&&j.enMute){
      el.innerHTML='<span class="alert clean" style="width:100%">⏸ En pausa (contactado hace poco) · se reactiva a las '+(j.pausadoHasta||'')+'</span>';
      return;
    }
    const al=(j&&j.alertas)||[]; el._alertas=al;
    const alHtml=al.length?al.map(a=>'<span class="alert s'+(a.semaforo==='rojo'?3:2)+'"><span>'+escA(a.nombre)+': '+a.pct.toFixed(1)+'% ('+a.semaforo.toUpperCase()+')</span></span>').join(''):'<span class="alert clean">✓ Sin alarmas activas</span>';
    el.innerHTML='<div class="alertbox" style="width:100%"><div class="hd">🛰️ Alarmas activas</div><div class="alerts">'+alHtml+'</div></div>'+
      '<div class="fg"><label>Canal</label><select class="cbCanal"><option>Llamada</option><option>WhatsApp</option><option>Videollamada</option><option>Presencial</option></select></div>'+
      '<div class="fg"><label>Contacto con</label><select class="cbCon"><option>Vendedor</option><option>Vendedor + supervisor</option><option>Supervisor</option></select></div>'+
      '<div class="fg full"><label>Comentario</label><textarea class="cbCom" rows="2" placeholder="Qué se conversó…"></textarea></div>'+
      '<div class="fg full"><label>Compromiso</label><textarea class="cbCompr" rows="2" placeholder="Compromiso acordado…"></textarea></div>'+
      '<div class="fg" style="flex:none;display:flex;align-items:flex-end"><button class="vbtn pri cbGuardar">Guardar contacto</button></div>';
    el._alertas=al;
    el.querySelector('.cbGuardar').onclick=()=>cobrosGuardarContacto(tipo,rep,repNom,supCod,supNom,el);
  }).catch(e=>toast('Error: '+e));
}
function cobrosGuardarContacto(tipo,rep,repNom,supCod,supNom,el){
  const alertas=el._alertas||[];
  const payload={
    tipoRecurso:tipo, repCodigo: tipo==='vendedor'?rep:null, repNombre: tipo==='vendedor'?repNom:null,
    supCod:supCod, supervisor:supNom,
    canal: el.querySelector('.cbCanal').value, contactoCon: el.querySelector('.cbCon').value,
    comentario: el.querySelector('.cbCom').value, compromiso: el.querySelector('.cbCompr').value,
    cfgIds: alertas.map(a=>a.cfgId), nombresAlertas: alertas.map(a=>a.nombre)
  };
  api('/cobros/contacto',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)}).then(j=>{
    if(j&&j.ok){
      toast('Contacto registrado · '+(tipo==='vendedor'?repNom:supNom)+' (pausa '+(j.muteMin||60)+' min)');
      el.classList.remove('on'); el.innerHTML='';
      cobrosCargarResumen();
    } else toast('Error: '+((j&&j.error)||''));
  }).catch(e=>toast('Error: '+e));
}
function cobrosCard(label,value,sub,color){
  return '<div class="panel" style="padding:14px 16px"><div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;font-weight:800">'+label+'</div>'+
    '<div style="font-size:18px;font-weight:800;margin-top:4px;'+(color?'color:'+color+';':'')+'">'+escA(value)+'</div>'+
    (sub?'<div class="m" style="margin-top:2px">'+sub+'</div>':'')+'</div>';
}
function cobrosCargarResumen(){
  api('/cobros/resumen').then(j=>{
    if(!j||!j.ok){$('#cbCards').innerHTML='';return;}
    let h='';
    if(j.mejorAlerta)h+=cobrosCard('✅ Mejor alerta hoy',j.mejorAlerta.nombre,j.mejorAlerta.promedioPct.toFixed(1)+'% promedio','var(--good)');
    if(j.peorAlerta)h+=cobrosCard('⚠️ Peor alerta hoy',j.peorAlerta.nombre,j.peorAlerta.promedioPct.toFixed(1)+'% promedio','var(--bad)');
    if(j.masContactos&&j.masContactos.length)h+=cobrosCard('📞 Más contactos hoy (super.)',j.masContactos[0].nombre||j.masContactos[0].supcod,j.masContactos[0].contactos+' contactos','var(--good)');
    if(j.menosContactos&&j.menosContactos.length)h+=cobrosCard('🔕 Menos contactos hoy (super.)',j.menosContactos[0].nombre||j.menosContactos[0].supcod,j.menosContactos[0].contactos+' contactos','var(--bad)');
    $('#cbCards').innerHTML=h;
  }).catch(()=>{});
}
function cobrosGuardarCorte(corte){
  api('/cobros/bitacora',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({cfgId:COBROS.cfgId,corte:corte})}).then(j=>{
    if(j&&j.ok)toast('Corte '+corte+' guardado ('+(j.guardados||0)+' vendedores)'+(j.aviso?' — '+j.aviso:''));
    else toast('Error: '+((j&&j.error)||''));
  }).catch(e=>toast('Error: '+e));
}
function cobrosContactosGenerar(){
  const d0=$('#cbcoDesde').value, d1=$('#cbcoHasta').value;
  api('/cobros/contactos?desde='+d0+'&hasta='+d1).then(j=>{
    if(!j||!j.ok){toast('Error: '+((j&&j.error)||''));return;}
    const items=j.items||[];
    $('#cbco-n').textContent=items.length+' contacto(s)';
    const porAlerta={};
    items.forEach(it=>{ (it.alertas||'Sin alerta').split(' · ').forEach(a=>{ porAlerta[a]=(porAlerta[a]||0)+1; }); });
    const filasA=Object.keys(porAlerta).sort((a,b)=>porAlerta[b]-porAlerta[a]);
    $('#cbco-alerta').innerHTML=filasA.length?filasA.map(a=>'<tr><td class="l">'+escA(a)+'</td><td>'+porAlerta[a]+'</td></tr>').join(''):'<tr><td colspan="2" class="l" style="color:var(--muted)">Sin contactos en el rango.</td></tr>';
    $('#cbco-detalle').innerHTML=items.length?items.map(it=>'<tr><td class="l">'+it.fecha+'</td><td class="l">'+(it.tipoRecurso==='vendedor'?escA(it.repNombre||it.rep):'Supervisor')+'</td><td class="l">'+escA(it.supervisor||it.supCod||'')+'</td><td class="l">'+escA(it.alertas||'')+'</td><td class="l">'+escA(it.comentario||'')+'</td><td class="l">'+escA(it.compromiso||'')+'</td></tr>').join(''):'<tr><td colspan="6" class="l" style="color:var(--muted)">Sin contactos en el rango.</td></tr>';
  }).catch(e=>toast('Error: '+e));
}
function renderCbCfgBody(){
  const tb=$('#cbCfgBody');
  const detalle=c=>{
    if(c.tipo==='presupuesto')return 'PreTipo '+(c.preTipo||'—');
    if(c.tipo==='pedidos')return 'Meta '+(c.metaFija!=null?c.metaFija:'—')+(c.excluirSupCods?' · excluye '+escA(c.excluirSupCods):'');
    if(c.tipo==='producto')return 'ProID '+(c.proId!=null?c.proId:'—')+' · Meta '+(c.metaFija!=null?c.metaFija:'—')+(c.division?' · Div '+escA(c.division):'')+(c.vigenciaDesde?' · '+c.vigenciaDesde+'→'+(c.vigenciaHasta||'∞'):'');
    if(c.tipo==='activaciones'){
      const med=c.medicion==='categoria'?'LinID '+(c.linId!=null?c.linId:'—'):(c.medicion==='suplidor'?'Suplidor Cat3ID '+(c.cat3Id!=null?c.cat3Id:'—'):'ProID '+(c.proId!=null?c.proId:'—'));
      return med+' · Meta '+(c.metaFija!=null?c.metaFija:'—')+(c.division?' · Div '+escA(c.division):'')+(c.vigenciaDesde?' · '+c.vigenciaDesde+'→'+(c.vigenciaHasta||'∞'):'');
    }
    return '—';
  };
  const vig=c=>{ if(!c.vigenciaDesde&&!c.vigenciaHasta)return '<span style="color:var(--muted)">sin límite</span>'; return (c.vigenciaDesde||'∞')+'→'+(c.vigenciaHasta||'∞'); };
  tb.innerHTML=COBROS.cfgs.length?COBROS.cfgs.map(c=>'<tr'+(c.activo?'':' style="opacity:.5"')+'>'+
    '<td class="l">'+escA(c.nombre)+'</td><td class="l">'+c.tipo+'</td><td class="l">'+detalle(c)+'</td>'+
    '<td>'+(c.metaFija!=null?c.metaFija:'—')+'</td>'+
    '<td style="color:var(--good);font-weight:700">≥'+c.umbralVerde+'</td>'+
    '<td style="color:var(--warn);font-weight:700">≥'+c.umbralAmarillo+'</td>'+
    '<td style="color:var(--bad);font-weight:700">&lt;'+c.umbralAmarillo+'</td>'+
    '<td class="l" style="font-size:11px">'+vig(c)+'</td>'+
    '<td>'+(c.activo?'<span class="band" style="color:var(--good);background:var(--good-bg)">ACTIVA</span>':'<span class="band" style="color:var(--muted);background:var(--panel2)">VENCIDA</span>')+'</td>'+
    '<td class="l" style="white-space:nowrap">'+
      '<button class="rbtn" data-cfg-edit="'+c.cfgId+'" title="Editar">✏️</button> '+
      '<button class="rbtn" data-cfg-toggle="'+c.cfgId+'" title="'+(c.activo?'Vencer / desactivar':'Reactivar')+'">'+(c.activo?'⏸':'▶️')+'</button> '+
      '<button class="rbtn" data-cfg-asig="'+c.cfgId+'" title="Asignar vendedores (cotejar/descotejar)">👥</button>'+
    '</td></tr>').join(''):'<tr><td colspan="10" class="l" style="color:var(--muted)">Sin alertas configuradas — se usa el default de presupuesto diario.</td></tr>';
  $$('#cbCfgBody [data-cfg-edit]').forEach(b=>b.onclick=()=>cobrosEditarCfg(+b.dataset.cfgEdit));
  $$('#cbCfgBody [data-cfg-toggle]').forEach(b=>b.onclick=()=>cobrosToggleActivo(+b.dataset.cfgToggle));
  $$('#cbCfgBody [data-cfg-asig]').forEach(b=>b.onclick=()=>cobrosAbrirAsignacion(+b.dataset.cfgAsig));
}
function cobrosLimpiarFormCfg(){
  $('#cbcNombre').value='';$('#cbcPreTipo').value='';$('#cbcMeta').value='';$('#cbcProId').value='';$('#cbcLinId').value='';$('#cbcCat3Id').value='';$('#cbcDivision').value='';$('#cbcExcluir').value='';$('#cbcVigDesde').value='';$('#cbcVigHasta').value='';
  $('#cbcUV').value='90';$('#cbcUA').value='80';$('#cbcTipo').value='presupuesto';$('#cbcMedicion').value='producto';
}
function cobrosCancelarEdicion(){
  COBROS.editId=0; cobrosLimpiarFormCfg(); cobrosAjustarCamposCfg();
  $('#cbcAdd').textContent='+ Agregar alerta'; $('#cbcCancel').style.display='none';
}
function cobrosEditarCfg(cfgId){
  const c=COBROS.cfgs.find(x=>x.cfgId===cfgId); if(!c)return;
  COBROS.editId=cfgId;
  $('#cbcNombre').value=c.nombre||''; $('#cbcTipo').value=c.tipo||'presupuesto';
  $('#cbcPreTipo').value=c.preTipo||''; $('#cbcMeta').value=c.metaFija!=null?c.metaFija:'';
  $('#cbcMedicion').value=c.medicion||'producto'; $('#cbcLinId').value=c.linId!=null?c.linId:'';
  cobrosPobSuplidores(); $('#cbcCat3Id').value=c.cat3Id!=null?c.cat3Id:'';
  $('#cbcProId').value=c.proId!=null?c.proId:''; $('#cbcDivision').value=c.division||'';
  $('#cbcExcluir').value=c.excluirSupCods||''; $('#cbcVigDesde').value=c.vigenciaDesde||''; $('#cbcVigHasta').value=c.vigenciaHasta||'';
  $('#cbcUV').value=c.umbralVerde; $('#cbcUA').value=c.umbralAmarillo;
  cobrosAjustarCamposCfg();
  $('#cbcAdd').textContent='💾 Guardar cambios'; $('#cbcCancel').style.display='';
  $('#cbcNombre').scrollIntoView({behavior:'smooth',block:'center'}); $('#cbcNombre').focus();
}
function cobrosToggleActivo(cfgId){
  const c=COBROS.cfgs.find(x=>x.cfgId===cfgId); if(!c)return;
  if(c.activo && !confirm('¿Vencer / desactivar la alerta "'+c.nombre+'"? Dejará de generar semáforo. Puedes reactivarla luego.'))return;
  const payload=Object.assign({},c,{activo:!c.activo});
  api('/cobros/config',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)}).then(j=>{
    if(j&&j.ok){toast(c.activo?'Alerta vencida ✓':'Alerta reactivada ✓');cobrosCargarConfig();}
    else toast('Error: '+((j&&j.error)||''));
  }).catch(e=>toast('Error: '+e));
}
function cobrosAgregarCfg(){
  const nombre=$('#cbcNombre').value.trim(); if(!nombre){toast('Falta el nombre');return;}
  const editing=COBROS.editId>0, cur=editing?COBROS.cfgs.find(x=>x.cfgId===COBROS.editId):null;
  const payload={
    cfgId:COBROS.editId||0, nombre:nombre, tipo:$('#cbcTipo').value,
    preTipo:$('#cbcPreTipo').value.trim()||null,
    metaFija: $('#cbcMeta').value.trim()!==''?+$('#cbcMeta').value:null,
    proId: $('#cbcProId').value.trim()!==''?+$('#cbcProId').value:null,
    linId: $('#cbcLinId').value.trim()!==''?+$('#cbcLinId').value:null,
    cat3Id: $('#cbcCat3Id').value.trim()!==''?+$('#cbcCat3Id').value:null,
    medicion: $('#cbcTipo').value==='activaciones'?$('#cbcMedicion').value:null,
    division: $('#cbcDivision').value.trim()||null,
    excluirSupCods: $('#cbcExcluir').value.trim()||null,
    vigenciaDesde: $('#cbcVigDesde').value||null,
    vigenciaHasta: $('#cbcVigHasta').value||null,
    activo: cur?cur.activo:true, orden: cur?cur.orden:(COBROS.cfgs.length+1),
    umbralVerde:+$('#cbcUV').value||90, umbralAmarillo:+$('#cbcUA').value||80
  };
  api('/cobros/config',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)}).then(j=>{
    if(j&&j.ok){
      toast(editing?'Cambios guardados ✓':'Alerta agregada ✓');
      cobrosCancelarEdicion();
      cobrosCargarConfig();
    } else toast('Error: '+((j&&j.error)||''));
  }).catch(e=>toast('Error: '+e));
}
/* ── Asignación cotejar/descotejar (SupervisionCobrosAsignacion_RM) ── */
function cobrosAbrirAsignacion(cfgId){
  let m=$('#cbAsigModal');
  if(!m){ m=document.createElement('div'); m.id='cbAsigModal'; m.className='modal'; document.body.appendChild(m); }
  m.innerHTML='<div class="modalbox"><div class="hint">Cargando vendedores…</div></div>';
  m.classList.add('on');
  api('/cobros/asignacion?cfgId='+cfgId).then(j=>{
    if(!j||!j.ok){ m.querySelector('.modalbox').innerHTML='<div class="hint" style="text-align:left">⚠ '+((j&&j.error)||'Error')+'</div><div style="text-align:right;margin-top:10px"><button class="go" onclick="document.getElementById(\'cbAsigModal\').classList.remove(\'on\')">Cerrar</button></div>'; return; }
    COBROS._asig={cfgId:cfgId,items:j.items||[]};
    const bySup={},orden=[];
    (j.items||[]).forEach(it=>{const k=it.supcod||'—';if(!bySup[k]){bySup[k]={nombre:it.supervisor||'—',items:[]};orden.push(k);}bySup[k].items.push(it);});
    const total=(j.items||[]).length, chk=(j.items||[]).filter(x=>x.asignado).length;
    let h='<h3>👥 Asignar alerta: '+escA(j.nombre)+'</h3>'+
      '<div class="hint" style="text-align:left;padding:2px 0 10px">Cotejar/descotejar vendedores (divisiones 10 y 11). '+(j.tieneMantenimiento?'Esta alerta ya usa asignación manual.':'Aún usa el filtro por División/Excluir; al guardar, la asignación manual pasa a mandar.')+'</div>'+
      '<div class="filtros" style="margin:0 0 10px"><button class="go" id="cbAsigAll" style="background:var(--panel2)">Cotejar todos</button><button class="go" id="cbAsigNone" style="background:var(--panel2)">Descotejar todos</button><span class="n" id="cbAsigN" style="align-self:center">'+chk+' / '+total+' cotejados</span></div>'+
      '<div class="scroller" style="max-height:56vh">';
    orden.forEach(sc=>{ const g=bySup[sc];
      h+='<div class="vrow" style="background:var(--panel2);font-weight:700"><label style="display:flex;align-items:center;gap:8px;cursor:pointer;width:100%"><input type="checkbox" class="cbAsigSup" data-sup="'+escA(sc)+'"> '+escA(g.nombre)+' <span class="m" style="font-weight:400">('+g.items.length+')</span></label></div>';
      g.items.forEach(it=>{ h+='<div class="vrow" style="padding-left:26px"><label style="display:flex;align-items:center;gap:8px;cursor:pointer;width:100%"><input type="checkbox" class="cbAsigRep" data-rep="'+escA(it.rep)+'" data-sup="'+escA(sc)+'" '+(it.asignado?'checked':'')+'> '+escA(it.nombre)+' · '+escA(it.rep)+' <span class="m">Div '+escA(it.division||'—')+'</span></label></div>'; });
    });
    h+='</div><div style="display:flex;gap:8px;justify-content:flex-end;margin-top:14px"><button class="go" id="cbAsigCancel" style="background:var(--panel2)">Cancelar</button><button class="go" id="cbAsigSave">💾 Guardar asignación</button></div>';
    m.querySelector('.modalbox').innerHTML=h;
    const upd=()=>{ const n=$$('#cbAsigModal .cbAsigRep').filter(x=>x.checked).length; $('#cbAsigN').textContent=n+' / '+total+' cotejados'; };
    const setSup=sc=>{ const any=$$('#cbAsigModal .cbAsigRep[data-sup="'+sc+'"]'); const sup=$('#cbAsigModal .cbAsigSup[data-sup="'+sc+'"]'); if(sup){const all=any.every(x=>x.checked);sup.checked=all;sup.indeterminate=!all&&any.some(x=>x.checked);} };
    $$('#cbAsigModal .cbAsigRep').forEach(x=>x.onchange=()=>{setSup(x.dataset.sup);upd();});
    $$('#cbAsigModal .cbAsigSup').forEach(s=>s.onchange=()=>{$$('#cbAsigModal .cbAsigRep[data-sup="'+s.dataset.sup+'"]').forEach(x=>x.checked=s.checked);upd();});
    orden.forEach(setSup);
    $('#cbAsigAll').onclick=()=>{$$('#cbAsigModal .cbAsigRep').forEach(x=>x.checked=true);orden.forEach(setSup);upd();};
    $('#cbAsigNone').onclick=()=>{$$('#cbAsigModal .cbAsigRep').forEach(x=>x.checked=false);orden.forEach(setSup);upd();};
    $('#cbAsigCancel').onclick=()=>m.classList.remove('on');
    $('#cbAsigSave').onclick=()=>cobrosGuardarAsignacion(cfgId);
  }).catch(e=>{ m.querySelector('.modalbox').innerHTML='<div class="hint">Error: '+e+'</div>'; });
}
function cobrosGuardarAsignacion(cfgId){
  const reps=$$('#cbAsigModal .cbAsigRep').map(x=>({rep:x.dataset.rep,asignado:x.checked}));
  api('/cobros/asignacion',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({cfgId:cfgId,reps:reps})}).then(j=>{
    if(j&&j.ok){toast('Asignación guardada ✓ ('+(j.guardados||0)+' vendedores)');$('#cbAsigModal').classList.remove('on');cobrosLoad();}
    else toast('Error: '+((j&&j.error)||''));
  }).catch(e=>toast('Error: '+e));
}

/* ── COBROS · Item 4: drill Supervisor→Rep con TODAS las alertas ── */
function cobrosMatrizCargar(){
  $('#cbmList').innerHTML='<div class="hint">Cargando…</div>';
  api('/cobros/matriz').then(j=>{
    if(!j||!j.ok){toast('Error: '+((j&&j.error)||''));return;}
    COBROS.matriz=j;
    // poblar filtros (una sola vez con el universo devuelto)
    const sups={}, alertas=j.alertas||[];
    (j.filas||[]).forEach(f=>{ if(f.supcod)sups[f.supcod]=f.supervisor||f.supcod; });
    const selSup=$('#cbmSup'); if(selSup.options.length<=1) Object.keys(sups).sort((a,b)=>sups[a].localeCompare(sups[b])).forEach(sc=>selSup.add(new Option(sups[sc],sc)));
    const selAl=$('#cbmAlerta'); if(selAl.options.length<=1) alertas.forEach(a=>selAl.add(new Option(a.nombre,a.cfgId)));
    cobrosMatrizPobVend();
    renderCobrosMatriz();
  }).catch(e=>toast('Error: '+e));
}
function cobrosMatrizPobVend(){
  const j=COBROS.matriz; if(!j)return; const sc=$('#cbmSup').value;
  const selV=$('#cbmVen'); const prev=selV.value; selV.innerHTML='<option value="">Todos</option>';
  (j.filas||[]).filter(f=>!sc||f.supcod===sc).forEach(f=>selV.add(new Option(f.nombre+' · '+f.rep,f.rep)));
  if([...selV.options].some(o=>o.value===prev))selV.value=prev;
}
function renderCobrosMatriz(){
  const j=COBROS.matriz, box=$('#cbmList'); if(!j){box.innerHTML='';return;}
  const fSup=$('#cbmSup').value, fVen=$('#cbmVen').value, fAl=$('#cbmAlerta').value, fSem=$('#cbmSem').value;
  let filas=(j.filas||[]).filter(f=>(!fSup||f.supcod===fSup)&&(!fVen||f.rep===fVen));
  // aplicar filtros de alerta/semáforo a las celdas visibles
  const visCeldas=f=>(f.alertas||[]).filter(a=>(!fAl||String(a.cfgId)===String(fAl))&&(!fSem||a.semaforo===fSem));
  filas=filas.filter(f=>visCeldas(f).length>0);
  $('#cbm-n').textContent=filas.length+' vendedor(es) · corte '+(j.corte||'')+(j.esFinal?' · final':' · proyectado');
  if(!filas.length){box.innerHTML='<div class="hint">Sin resultados para el filtro.</div>';return;}
  const bySup={},orden=[];
  filas.forEach(f=>{const k=f.supcod||'—';if(!bySup[k]){bySup[k]={nombre:f.supervisor||'—',filas:[]};orden.push(k);}bySup[k].filas.push(f);});
  let h='';
  orden.forEach(sc=>{
    const g=bySup[sc], open=COBROS.matrizExp[sc]!==false; // por defecto abierto
    h+='<div class="vrow cb-suphead" data-msup="'+escA(sc)+'" style="cursor:pointer;background:var(--panel2)">'+
       '<div class="vn">'+(open?'▾':'▸')+' '+escA(g.nombre)+'<div class="m">'+g.filas.length+' vendedores</div></div></div>'+
       '<div id="cbm-sup-'+escA(sc)+'" style="'+(open?'':'display:none')+'">';
    g.filas.forEach(f=>{
      const cs=visCeldas(f);
      const chips=cs.map(a=>'<span class="band" title="'+escA(a.nombre)+' · alcance '+a.pct.toFixed(1)+'%" style="color:'+semColor(a.semaforo)+';background:'+semBg(a.semaforo)+';margin:2px">'+escA(a.nombre)+' '+a.pct.toFixed(1)+'%</span>').join('');
      h+='<div class="vrow" style="padding-left:26px;align-items:flex-start"><div class="vn" style="min-width:180px">'+escA(f.nombre)+'<div class="m">'+f.rep+'</div></div>'+
         '<div style="display:flex;flex-wrap:wrap;gap:2px;flex:1">'+(chips||'<span class="m">—</span>')+'</div></div>';
    });
    h+='</div>';
  });
  box.innerHTML=h;
  $$('#cbmList .cb-suphead').forEach(el=>el.onclick=()=>{const sc=el.dataset.msup;COBROS.matrizExp[sc]=(COBROS.matrizExp[sc]===false);renderCobrosMatriz();});
}

/* ── COBROS · Item 5: reporte de generadas + atendidas (imprimible) ── */
function cobrosReporteGenerar(){
  // poblar filtros supervisor/alerta desde la config/matriz si están disponibles
  const selSup=$('#cbrSup'); if(selSup.options.length<=1 && COBROS.matriz){const sups={};(COBROS.matriz.filas||[]).forEach(f=>{if(f.supcod)sups[f.supcod]=f.supervisor||f.supcod;});Object.keys(sups).sort((a,b)=>sups[a].localeCompare(sups[b])).forEach(sc=>selSup.add(new Option(sups[sc],sc)));}
  const selAl=$('#cbrAlerta'); if(selAl.options.length<=1)COBROS.cfgs.forEach(c=>selAl.add(new Option(c.nombre,c.cfgId)));
  const selV=$('#cbrVen'); const sc=$('#cbrSup').value; const prev=selV.value; selV.innerHTML='<option value="">Todos</option>';
  if(COBROS.matriz)(COBROS.matriz.filas||[]).filter(f=>!sc||f.supcod===sc).forEach(f=>selV.add(new Option(f.nombre+' · '+f.rep,f.rep)));
  if([...selV.options].some(o=>o.value===prev))selV.value=prev;
  const d0=$('#cbrDesde').value,d1=$('#cbrHasta').value,su=$('#cbrSup').value,ve=$('#cbrVen').value,al=$('#cbrAlerta').value,se=$('#cbrSem').value;
  const qs='desde='+d0+'&hasta='+d1+(su?'&sup='+encodeURIComponent(su):'')+(ve?'&rep='+encodeURIComponent(ve):'')+(al?'&cfgId='+al:'')+(se?'&sem='+se:'');
  $('#cbrOut').innerHTML='<div class="hint">Generando…</div>';
  Promise.all([api('/cobros/reporte?'+qs),api('/cobros/contactos?desde='+d0+'&hasta='+d1)]).then(([g,c])=>{
    if(!g||!g.ok){$('#cbrOut').innerHTML='<div class="hint">Error: '+((g&&g.error)||'')+'</div>';return;}
    let at=(c&&c.items)||[];
    // filtrar atendidas por los mismos filtros (cliente)
    if(su)at=at.filter(x=>x.supCod===su); if(ve)at=at.filter(x=>x.rep===ve);
    if(al)at=at.filter(x=>(x.cfgIds||'').split(',').map(s=>s.trim()).includes(String(al)));
    COBROS._rep={g:g,at:at,desde:d0,hasta:d1};
    renderCobrosReporte();
  }).catch(e=>{$('#cbrOut').innerHTML='<div class="hint">Error: '+e+'</div>';});
}
function renderCobrosReporte(){
  const R=COBROS._rep; if(!R)return; const g=R.g;
  const card=(lbl,val,col)=>'<div class="panel" style="padding:12px 16px"><div style="font-size:11px;color:var(--muted);text-transform:uppercase;font-weight:800">'+lbl+'</div><div style="font-size:22px;font-weight:800;'+(col?'color:'+col:'')+'">'+val+'</div></div>';
  let h='<div id="cbrReport"><div class="rep-head" style="display:none"><h2>Reporte de alertas — Cobros del día</h2><div>'+R.desde+' a '+R.hasta+'</div></div>';
  h+='<div class="kpis" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin:8px 0 14px">'+
     card('Alertas generadas',g.generadas,'')+card('🔴 Rojas',g.rojas,'var(--bad)')+card('🟡 Amarillas',g.amarillas,'var(--warn)')+card('📞 Atendidas',R.at.length,'var(--good)')+'</div>';
  h+='<div class="sec-title"><h3>Generadas por representante</h3></div><div class="scroller"><table><thead><tr><th class="l">Vendedor</th><th class="l">Supervisor</th><th>Generadas</th><th>🔴</th><th>🟡</th></tr></thead><tbody>'+
     ((g.porRep||[]).length?g.porRep.map(r=>'<tr><td class="l">'+escA(r.nombre)+' · '+r.rep+'</td><td class="l">'+escA(r.supervisor||'')+'</td><td>'+r.generadas+'</td><td style="color:var(--bad)">'+r.rojas+'</td><td style="color:var(--warn)">'+r.amarillas+'</td></tr>').join(''):'<tr><td colspan="5" class="l" style="color:var(--muted)">Sin generadas en el rango.</td></tr>')+'</tbody></table></div>';
  h+='<div class="sec-title"><h3>Generadas por alerta</h3></div><div class="scroller"><table><thead><tr><th class="l">Alerta</th><th>Generadas</th><th>🔴</th><th>🟡</th></tr></thead><tbody>'+
