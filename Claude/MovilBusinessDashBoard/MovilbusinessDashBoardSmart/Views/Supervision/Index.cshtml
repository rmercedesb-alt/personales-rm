  box.appendChild(pf);
  const cb=$('#camBtn');if(cb)cb.onclick=()=>$('#camInput').click();const rm=$('#rmPhoto');if(rm)rm.onclick=()=>{evalClients[activeIdx].photo=null;renderSteps();};
  if(!ro){$$('#steps .stars .star[data-k]').forEach(st=>st.onclick=()=>{const par=st.closest('.stars');evalClients[activeIdx].sc[m][+par.dataset.i]=(+st.dataset.k)*20;renderSteps();});}
  updTotal();
}
function updTotal(){const fs=facFor(calleMode),arr=curArr(),v=arr?weighted(arr,fs):0;$('#totVal').textContent=v;const el=$('#totBand');el.textContent=arr?band(v):'—';el.className='band '+(arr?band(v):'');const ts=$('#totStars');if(ts)ts.textContent=arr?starDisp(v):'';}
$('#camInput').onchange=function(e){const f=e.target.files&&e.target.files[0];if(!f)return;const rd=new FileReader();rd.onload=ev=>{if(typeof activeIdx==='number'&&evalClients[activeIdx]){evalClients[activeIdx].photo=ev.target.result;renderSteps();toast('Foto guardada');}};rd.readAsDataURL(f);e.target.value='';};

