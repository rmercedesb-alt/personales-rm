  const add=document.createElement('button');add.className='addc';add.textContent='＋ Cliente';add.onclick=()=>{const s=$('#csearch');s.classList.toggle('on');if(s.classList.contains('on')){$('#cq').value='';renderRes('');$('#cq').focus();}};bar.appendChild(add);
  $$('#cbar .x').forEach(x=>x.onclick=e=>{e.stopPropagation();evalClients.splice(+x.dataset.x,1);if(activeIdx!=='cons'&&activeIdx>=evalClients.length)activeIdx=evalClients.length?0:-1;renderCbar();renderSteps();});}
function renderRes(q){const res=$('#cres');q=(q||'').toLowerCase().trim();
  const list=repClientes.filter(c=>!evalClients.some(e=>e.cod===c.Cod)&&(!q||(c.Cod+' '+c.Nombre).toLowerCase().includes(q)));
  if(!list.length){res.innerHTML='<div class="r" style="color:var(--muted);cursor:default">Sin clientes'+(q?' con “'+q+'”':'')+'.</div>';return;}
  res.innerHTML='';list.slice(0,40).forEach(c=>{const r=document.createElement('div');r.className='r';r.innerHTML='<span class="cod">'+c.Cod+'</span><span>'+c.Nombre+'</span>';r.onclick=()=>{evalClients.push({cliId:c.CliID,cod:c.Cod,nom:c.Nombre,sc:newSc(),photo:null,comentario:'',compromiso:''});activeIdx=evalClients.length-1;$('#csearch').classList.remove('on');renderCbar();renderSteps();toast('Cliente agregado');};res.appendChild(r);});}
$('#cq').oninput=function(){renderRes(this.value);};
let _lastActive=undefined;
function renderSteps(){const m=calleMode,fs=facFor(m),arr=curArr(),box=$('#steps');
  $('#fComprWrap').style.display=m==='audit'?'none':'';
