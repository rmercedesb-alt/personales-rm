// ── Screen "📅 Reportes Programados" — todas las programaciones, de cualquier
// reporte, con si el último envío salió bien o no (pedido #2 del usuario:
// "cómo me entero si el reporte se envió") ──
let PG_BOOTED=false;
function pgBoot(){ if(!PG_BOOTED){ PG_BOOTED=true; } pgCargar(); }
function pgCargar(){
  const host=$('#pg-list'); host.innerHTML='<div class="hint">Cargando…</div>';
  fetch(BASE+'/apipdfpres/programados').then(r=>r.json()).then(j=>{
    if(!j||!j.ok){ host.innerHTML='<div class="hint">Error cargando programaciones</div>'; return; }
    if(j.aviso){ host.innerHTML='<div class="hint" style="text-align:left">⚠ '+j.aviso+'</div>'; return; }
    if(!j.items.length){ host.innerHTML='<div class="hint">Aún no hay ninguna programación guardada — desde cualquier reporte, usa "📅 Programar envío".</div>'; return; }
    host.innerHTML=j.items.map(it=>{
      const nombreRep=PG_REPORTE_NOMBRE[it.reporte]||it.reporte;
      let estado;
      if(it.ultimoError) estado='<span style="color:#c0392b">✗ '+it.ultimoError+'</span>';
      else if(it.ultimoEnvio) estado='<span style="color:#1f8b4c">✓ '+it.ultimoEnvio+'</span>';
      else estado='<span class="n">Nunca se ha enviado</span>';
      return '<div class="vrow"><div class="vn" style="flex:1"><b>'+it.nombre+'</b> <span class="n">('+nombreRep+' · '+it.horaEnvio+' · '+it.numDestinatarios+' destinatario(s))</span>'
        +'<div style="margin-top:2px">'+estado+'</div></div>'
        +'<label style="display:flex;align-items:center;gap:5px;font-size:12px;font-weight:400"><input type="checkbox" data-pg-activo="'+it.progId+'" '+(it.activo?'checked':'')+'> Activo</label>'
        +'<button class="rbtn" data-pg-editar="'+it.progId+'" style="margin-left:8px">✏️</button>'
        +'<button class="rbtn" data-pg-duplicar="'+it.progId+'">🗐 Duplicar</button>'
        +'<button class="rbtn primary" data-pg-enviar="'+it.progId+'">🚀 Enviar ahora</button>'
        +'<button class="rbtn" data-pg-eliminar="'+it.progId+'">🗑️</button></div>';
    }).join('');
    $$('[data-pg-activo]',host).forEach(c=>c.onchange=()=>{
      const it=j.items.find(x=>x.progId===+c.dataset.pgActivo); if(!it)return;
      fetch(BASE+'/apipdfpres/programados',{method:'POST',headers:{'Content-Type':'application/json'},
        body:JSON.stringify({ProgId:it.progId, Reporte:it.reporte, Nombre:it.nombre, Filtros:it.filtros||{}, HoraEnvio:it.horaEnvio, Activo:c.checked, Destinatarios:it.desIds||[]})})
        .then(r=>r.json()).then(k=>{ if(k&&k.ok) toast(c.checked?'Activada ✓':'Pausada ✓'); else { toast((k&&k.error)||'Error'); c.checked=!c.checked; } });
    });
    $$('[data-pg-editar]',host).forEach(b=>b.onclick=()=>{
      const it=j.items.find(x=>x.progId===+b.dataset.pgEditar); if(!it)return;
      abrirModalProgramar({reporte:it.reporte, nombreDefault:it.nombre, horaDefault:it.horaEnvio, filtrosGetter:()=>it.filtros||{}, _editId:it.progId, _preseleccion:it.desIds||[]});
    });
    $$('[data-pg-duplicar]',host).forEach(b=>b.onclick=()=>{
      const it=j.items.find(x=>x.progId===+b.dataset.pgDuplicar); if(!it)return;
      pgDuplicar(it);
    });
    $$('[data-pg-enviar]',host).forEach(b=>b.onclick=()=>{
      if(!confirm('Esto envía el correo REAL de esta programación ahora mismo a sus destinatarios activos. ¿Continuar?'))return;
      b.disabled=true; const t0=b.textContent; b.textContent='Enviando…';
      fetch(BASE+'/apipdfpres/programados/enviar-ahora?id='+b.dataset.pgEnviar,{method:'POST'}).then(r=>r.json()).then(k=>{
        b.disabled=false; b.textContent=t0;
        if(k&&k.ok) toast('Enviado ✓ a '+k.destinatarios+' destinatario(s)');
        else toast('No se envió: '+((k&&k.error)||'Error desconocido'));
        pgCargar();
      }).catch(e=>{ b.disabled=false; b.textContent=t0; toast('Error: '+e); });
    });
    $$('[data-pg-eliminar]',host).forEach(b=>b.onclick=()=>{
      if(!confirm('¿Eliminar esta programación? Ya no se enviará más.'))return;
      fetch(BASE+'/apipdfpres/programados/eliminar?id='+b.dataset.pgEliminar,{method:'POST'}).then(r=>r.json()).then(k=>{
        if(k&&k.ok){ toast('Eliminada'); pgCargar(); } else toast((k&&k.error)||'Error');
      });
    });
  }).catch(()=>{ host.innerHTML='<div class="hint">Error cargando programaciones</div>'; });
}

// Espera hasta que "check()" sea verdadero (los filtros del reporte ya cargaron)
// antes de seguir — hasta 5s (50×100ms), luego avisa y desiste.
function esperarFiltrosListos(check, cb, intentos){
  intentos=intentos||0;
  if(check()){ cb(); return; }
  if(intentos>50){ toast('No se pudieron cargar los filtros del reporte'); return; }
  setTimeout(()=>esperarFiltrosListos(check,cb,intentos+1), 100);
}
// Aplica un FiltrosJSON ya guardado (claves plural: suplidor/categoria/centros/
// canales/supervisores/divisiones/vendedores) sobre los multiselect EN VIVO de
// un reporte (CD.msFilters o PP.msFilters) — limpia cada uno antes de reaplicar.
function aplicarFiltrosGuardados(msFilters, filtros){
  if(!filtros) return;
  const map={suplidor:'suplidor', categoria:'categoria', centros:'centro', canales:'canal', supervisores:'supervisor', divisiones:'division', vendedores:'vendedor'};
  Object.keys(map).forEach(k=>{
    const ms=msFilters[map[k]]; if(!ms) return;
    ms.set(filtros[k]||[]);
  });
}
// "🗐 Duplicar" — pedido explícito 2026-09-03: un mismo reporte con 5-6 variantes
// de filtro (ej. un Supervisor distinto cada vez) sin repetir el flujo completo
// de "Programar envío" desde cero cada vez. Lleva al usuario a la pantalla del
// reporte correspondiente con los MISMOS filtros ya aplicados (para que solo
// ajuste lo que cambia) y deja el próximo "📅 Programar envío" que presione
// precargado con Nombre/Hora(s)/Destinatarios de la original — ver
// abrirModalProgramar/PROG.duplicando.
function pgDuplicar(it){
  PROG.duplicando={ nombreDefault: it.nombre+' (copia)', horaDefault: it.horaEnvio, preseleccion: it.desIds||[] };
  if(it.reporte==='cierres_cierre_diario'){
    ppShow('pp-cierres'); cdBoot();
    esperarFiltrosListos(()=>!!CD.filtros, ()=>{
      aplicarFiltrosGuardados(CD.msFilters, it.filtros);
      toast('Ajusta el filtro que corresponda (ej. Supervisor) y presiona "📅 Programar envío".');
    });
  } else if(it.reporte==='gobierno_comercial_ventas_proyectadas'){
    ppShow('pp-form-ventasproy'); ppInitForm();
    esperarFiltrosListos(()=>!!PP.filtros, ()=>{
      aplicarFiltrosGuardados(PP.msFilters, it.filtros);
      toast('Ajusta el filtro que corresponda y presiona "📅 Programar envío".');
    });
  } else {
    PROG.duplicando=null;
    toast('No se puede duplicar este tipo de reporte todavía.');
  }
}
</script>
@await Html.PartialAsync("_PlanTrabajo")
</body>
