/* ── suplidores multiselección ── */
function makeSup(chip,panel){
  const st={all:true,set:[]};
  const label=()=>chip.textContent=(st.all?'Todos':(st.set.length?st.set.length+' suplidor'+(st.set.length>1?'es':''):'Todos'))+' ▾';
  function render(){panel.innerHTML='';const t=document.createElement('label');t.className='opt';t.innerHTML='<input type="checkbox" '+(st.all?'checked':'')+' data-all="1"><b>Todos los suplidores</b>';panel.appendChild(t);
    SUPPLIERS.forEach(s=>{const o=document.createElement('label');o.className='opt';o.innerHTML='<input type="checkbox" '+((!st.all&&st.set.includes(s))?'checked':'')+' data-s="'+s+'"><span>'+s+'</span>';panel.appendChild(o);});
    $$('input[data-all]',panel).forEach(i=>i.onchange=()=>{st.all=true;st.set=[];render();label();});
    $$('input[data-s]',panel).forEach(i=>i.onchange=()=>{st.all=false;const s=i.dataset.s,k=st.set.indexOf(s);k>=0?st.set.splice(k,1):st.set.push(s);if(!st.set.length)st.all=true;render();label();});}
  chip.onclick=()=>panel.classList.toggle('on'); render(); label();
  return {text:()=>st.all?'Todos':st.set.join(', ')};
}
