/* ── AMCO-GT (misma fórmula que Seguimientos; usa la configuración guardada allí si existe) ── */
function rcAmcoCfg(){
  const d={pesos:{visitas:30,inicio:20,cierre:10,ventas:10,ruta:10,pdv:10,ritmo:10},
    visitas:{v100:98,v75:95,v50:88}, inicio:{min100:495,min50:525}, cierre:{min100:930,min50:870},
    ventas:{bandLo:55,bandHi:65,tol:5}, bandas:{solida:85,aceptable:70,irregular:55}, pdvMetros:200, pdvModo:'distancia'};
  try{ const s=JSON.parse(localStorage.getItem('segCfg')); if(s&&s.pesos) return Object.assign(d,s); }catch(e){}
  return d;
}
function rcMediana(arr){ const a=arr.filter(x=>x!=null).slice().sort((x,y)=>x-y); if(!a.length) return null; const n=a.length; return n%2?a[(n-1)/2]:(a[n/2-1]+a[n/2])/2; }
function rcSubs(C){
  return {
    visitas:ef=>{ const c=C.visitas; if(ef>=c.v100) return 100; if(ef>=c.v75) return 75+(ef-c.v75)*25/(c.v100-c.v75); if(ef>=c.v50) return 50+(ef-c.v50)*25/(c.v75-c.v50); return Math.max(0,50-(c.v50-ef)*25/(c.v75-c.v50)); },
    inicio:m=>{ if(m==null) return 0; const c=C.inicio; if(m<=c.min100) return 100; if(m>=c.min50) return 0; return 100*(c.min50-m)/(c.min50-c.min100); },
    cierre:m=>{ if(m==null) return 0; const c=C.cierre; if(m>=c.min100) return 100; if(m<=c.min50) return 0; return 100*(m-c.min50)/(c.min100-c.min50); },
    ventas:ef=>{ const c=C.ventas; if(ef>=c.bandLo&&ef<=c.bandHi) return 100;
      if(ef>c.bandHi){ if(ef<=c.bandHi+c.tol) return 100-(ef-c.bandHi)*40/c.tol; return Math.max(0,60-(ef-(c.bandHi+c.tol))*40/c.tol); }
      if(ef>=c.bandLo-c.tol) return 60+(ef-(c.bandLo-c.tol))*40/c.tol; return Math.max(0,60-((c.bandLo-c.tol)-ef)*40/c.tol); },
    ruta:n=>{ if(n<=0) return 100; if(n<=1) return 100-20*n; if(n<=2) return 80-30*(n-1); return Math.max(0,50-30*(n-2)); },
    pdv:n=>{ if(n<=2) return 100; if(n<=5) return 100-(n-2)*10; if(n<=10) return 70-(n-5)*6; return Math.max(0,40-(n-10)*6); },
    ritmo:(seg,med)=>{ if(!seg||!med) return 100; const d=Math.abs(seg-med)/med; if(d<=0.25) return 100; if(d<=0.5) return 100-(d-0.25)*160; return Math.max(0,60-(d-0.5)*160); }
  };
}
function rcScores(v,med,C,S){
  const p=C.pesos, tot=p.visitas+p.inicio+p.cierre+p.ventas+p.ruta+p.pdv+p.ritmo;
  const efv=v.TotVis?100*v.Visitados/v.TotVis:0, efn=v.Visitados?100*v.Pedidos/v.Visitados:0;
  const sc={
    visitas:{lbl:'Cumpl. de ruta',nota:S.visitas(efv),peso:p.visitas}, inicio:{lbl:'Inicio temprano (Primer Pedido)',nota:S.inicio(v.PrimerMin),peso:p.inicio},
    cierre:{lbl:'Cierre no prematuro (Último Pedido)',nota:S.cierre(v.UltimoMin),peso:p.cierre}, ventas:{lbl:'Ef. ventas',nota:S.ventas(efn),peso:p.ventas},
    ruta:{lbl:'Disciplina de ruta',nota:S.ruta(v.FueraRuta),peso:p.ruta}, pdv:{lbl:'Consistencia PDV',nota:S.pdv(v.FueraPDV),peso:p.pdv},
    ritmo:{lbl:'Ritmo de visita',nota:S.ritmo(v.PromSeg,med),peso:p.ritmo}
  };
  const iegt=Object.values(sc).reduce((a,x)=>a+x.nota*x.peso,0)/tot;
  return {sc,tot,iegt};
}
function rcAggMetrics(reps){
  const g={TotVis:0,Visitados:0,Pedidos:0,FueraRuta:0,FueraPDV:0}; let wp=0,sp=0,wu=0,su=0,wr=0,sr=0;
  reps.forEach(v=>{ ['TotVis','Visitados','Pedidos','FueraRuta','FueraPDV'].forEach(k=>g[k]+=(v[k]||0));
    const w=(v.Visitados||0)||1;
    if(v.PrimerMin!=null){wp+=w;sp+=v.PrimerMin*w;} if(v.UltimoMin!=null){wu+=w;su+=v.UltimoMin*w;} if(v.PromSeg!=null){wr+=w;sr+=v.PromSeg*w;} });
  g.PrimerMin=wp?sp/wp:null; g.UltimoMin=wu?su/wu:null; g.PromSeg=wr?sr/wr:null;
  // Igual que Seguimientos (aggMetrics): Fuera de ruta / Fuera de PDV del grupo se puntúan con la SUMA de sus vendedores, no con el promedio.
  return g;
}
function rcBanda(s,C){ const b=C.bandas; return s>=b.solida?['Sólida','#1f8b4c']:s>=b.aceptable?['Aceptable','#2563eb']:s>=b.irregular?['Irregular','#b8860b']:['Deficiente','#c0392b']; }
// AMCO-GT de una semana: por supervisor (recalculado desde las métricas sumadas) + total de la compañía
function rcAmcoSemana(vend,C,S){
  const med=rcMediana(vend.map(v=>v.PromSeg));
  const lista=vend.map(v=>{ const s=rcScores(v,med,C,S).iegt; return Object.assign({},v,{_iegt:s,_banda:rcBanda(s,C)}); });
  const nivel=reps=>{ const r=rcScores(rcAggMetrics(reps),med,C,S); return {iegt:r.iegt,sc:r.sc,tot:r.tot,banda:rcBanda(r.iegt,C)}; };
  const g={}; lista.forEach(v=>{ (g[v.SupCod]=g[v.SupCod]||{k:v.SupCod,nombre:v.Supervisor,centro:v.Centro,reps:[]}).reps.push(v); });
  const sups=Object.values(g).map(x=>{ const st=nivel(x.reps); const cnt={Sólida:0,Aceptable:0,Irregular:0,Deficiente:0}; x.reps.forEach(r=>cnt[r._banda[0]]++);
    return {k:x.k,nombre:x.nombre,centro:x.centro,n:x.reps.length,iegt:st.iegt,banda:st.banda,sc:st.sc,tot:st.tot,cnt}; }).sort((a,b)=>b.iegt-a.iegt);
  const cntT={Sólida:0,Aceptable:0,Irregular:0,Deficiente:0}; lista.forEach(r=>cntT[r._banda[0]]++);
  const tot=lista.length?nivel(lista):null;
  return {n:lista.length,sups,total:tot?{iegt:tot.iegt,banda:tot.banda,cnt:cntT}:null,lista,nivel};
}
// Período evaluado = el rango del informe (por defecto el día de hoy). Histórico para comparar:
//  - 1 día: los 5 días hábiles (lun–sáb) anteriores, cada uno por separado (misma calibración diaria).
//  - varios días: los 2 períodos anteriores de la misma duración.
function rcPeriodos(ini,fin){
  const a=new Date(ini+'T00:00:00'), b=new Date(fin+'T00:00:00'); const n=Math.round((b-a)/864e5)+1; const out=[{ini,fin}];
  if(n===1){ const d=new Date(a); while(out.length<6){ d.setDate(d.getDate()-1); if(d.getDay()===0) continue; out.push({ini:dateF(d),fin:dateF(d)}); } }
  else { let e=new Date(a); for(let i=0;i<2;i++){ e.setDate(e.getDate()-1); const st=new Date(e); st.setDate(e.getDate()-(n-1)); out.push({ini:dateF(st),fin:dateF(e)}); e=new Date(st); } }
  return {periodos:out,unidad:n===1?'días hábiles':'períodos'};
}
function rcCargarAmco(ini,fin,F){
  const C=rcAmcoCfg(), S=rcSubs(C), P=rcPeriodos(ini,fin);
  const canalOk=v=>!F.canales.length||F.canales.includes(String(v.CanID));
  return Promise.all(P.periodos.map(w=>{
    const p=new URLSearchParams({fechaIni:w.ini,fechaFin:w.fin,pdvMetros:String(C.pdvMetros||200),pdvModo:C.pdvModo||'distancia'});
    if(F.division.length) p.set('divisiones',F.division.join(','));
    if(F.centros.length) p.set('centros',F.centros.join(','));
    if(F.supervisores.length) p.set('supervisores',F.supervisores.join(','));
    if(F.vendedores.length) p.set('reps',F.vendedores.join(','));
    return fetch(BASE+'/apiseg/semana?'+p.toString()).then(r=>r.json()).then(j=>({w,vend:(j&&j.ok&&j.vendedores)?j.vendedores.filter(canalOk):null})).catch(()=>({w,vend:null}));
  })).then(res=>{
    if(!res[0].vend||!res[0].vend.length) return null;
    const ref=rcAmcoSemana(res[0].vend,C,S);
    const hist=res.slice(1).filter(x=>x.vend&&x.vend.length).map(x=>rcAmcoSemana(x.vend,C,S));
    const base={}; ref.sups.forEach(s=>{ const v=hist.map(h=>(h.sups.find(x=>x.k===s.k)||{}).iegt).filter(x=>x!=null); base[s.k]=v.length?v.reduce((a,b)=>a+b,0)/v.length:null; });
    const bt=hist.map(h=>h.total&&h.total.iegt).filter(x=>x!=null);
    return {ini,fin,ref,base,baseTotal:bt.length?bt.reduce((a,b)=>a+b,0)/bt.length:null,nHist:hist.length,unidad:P.unidad,divTxt:F.division.length?F.division.join('/'):'todas',C,tree:rcArbolAmco(ref,hist)};
  }).catch(()=>null);
}

/* ── Generar ── */
function rcGenerar(){
  const ini=$('#rc-desde').value, fin=$('#rc-hasta').value, hint=$('#rc-hint');
  if(!ini||!fin||ini>fin){ hint.style.display='block'; hint.textContent='Elige un rango de fechas válido (Desde ≤ Hasta).'; return; }
  hint.style.display='none';
  const F=rcFiltrosVals();
  const qs=new URLSearchParams({fechaIni:ini,fechaFin:fin,divisiones:F.division.join(','),suplidor:F.suplidor.join(','),categoria:F.categoria.join(','),
    canales:F.canales.join(','),centros:F.centros.join(','),supervisores:F.supervisores.join(','),vendedores:F.vendedores.join(',')});
  const btn=$('#rc-generar'); btn.disabled=true; const t0=btn.textContent; btn.textContent='Generando…';
  Promise.all([
    fetch(BASE+'/apipdfpres/resumen-cierre-dia?'+qs.toString()).then(r=>r.json()),
    rcCargarAmco(ini,fin,F)
  ]).then(([j,amco])=>{
    btn.disabled=false; btn.textContent=t0;
    if(!j||!j.ok){ hint.style.display='block'; hint.textContent=(j&&j.error)||'Error generando el informe'; return; }
    RC.res=j; RC.amco=amco; RC.generadoEn=new Date(); RC.filtrosTxt=rcFiltrosTexto(F);
    rcCalAmcoIniciar(fin,F);
    rcRender();
    ppShow('pp-rescierre-wrap');
  }).catch(e=>{ btn.disabled=false; btn.textContent=t0; hint.style.display='block'; hint.textContent='Error: '+e; });
}
function rcPeriodoTxt(R){ return R.fecha===R.fechaFin?rcDiaCap(R.diaSemana)+' '+R.fecha:R.fecha+' al '+R.fechaFin; }

/* ── Agrupación por PERSONA (2026-10-14): los supervisores con varios códigos (grupos: Ramón S1+S4+S7, Eliezer S2+S5, Cristiano S12+S13) se
   muestran como UNA fila con su nombre y debajo el detalle de sus grupos; los que tienen un solo código pero 2+ divisiones (Narciso, Rafael)
   se detallan por división. Las sumas se hacen con los montos/conteos (nunca promediando porcentajes). ── */
function rcBase(nombre){ return String(nombre==null?'':nombre).replace(/\s*\(.*$/,'').replace(/\s+/g,' ').trim(); }
function rcEtq(nombre){ const m=String(nombre==null?'':nombre).match(/\((.*)$/); return m?m[1].replace(/\)\s*$/,'').trim():''; }
function rcSumPed(list,nombre,clave){
  const sm=k=>{ let t=0,a=false; list.forEach(r=>{ if(r[k]!=null){ t+=r[k]; a=true; } }); return a?t:null; };
  const presu=sm('presupuesto')||0, ejec=sm('ejecutado')||0, pAj=sm('presupuestoAjustado'), hP=sm('histPresupuesto'), hE=sm('histEjecutado');
  let ejAj=null; list.forEach(r=>{ if(r.presupuestoAjustado!=null&&r.alcanceAjustadoPct!=null) ejAj=(ejAj||0)+r.alcanceAjustadoPct*r.presupuestoAjustado/100; });
  return {clave,nombre,presupuesto:presu,presupuestoAjustado:pAj,ejecutado:ejec,alcancePct:presu?100*ejec/presu:null,
    alcanceAjustadoPct:(pAj&&ejAj!=null)?100*ejAj/pAj:null,diferencia:ejec-presu,histPresupuesto:hP,histEjecutado:hE,histAlcancePct:hP?100*(hE||0)/hP:null};
}
function rcSumVis(list,nombre,clave){
  const s=k=>list.reduce((a,r)=>a+(r[k]||0),0);
  const av=s('aVisitar'), v=s('visitados'), p=s('pedidos'), hav=s('histAVisitar'), hv=s('histVisitados'), hp=s('histPedidos'), mav=s('mesAntAVisitar'), mv=s('mesAntVisitados'), mp=s('mesAntPedidos');
  return {clave,nombre,centro:(list[0]||{}).centro||'',vendedores:s('vendedores'),aVisitar:av,visitados:v,pedidos:p,
    cumplimientoPct:av>0?100*v/av:null,efectividadPct:v>0?100*p/v:null,histCumplimientoPct:hav>0?100*hv/hav:null,histEfectividadPct:hv>0?100*hp/hv:null,
    mesAntCumplimientoPct:mav>0?100*mv/mav:null,mesAntEfectividadPct:mv>0?100*mp/mv:null,histAVisitar:hav,histVisitados:hv,histPedidos:hp,mesAntAVisitar:mav,mesAntVisitados:mv,mesAntPedidos:mp};
}
function rcArbol(rows,rowsDiv,sumFn,ordenFn){
  const per={}; (rows||[]).forEach(r=>{ const k=rcBase(r.nombre)||r.clave; (per[k]=per[k]||[]).push(r); });
  const res=Object.entries(per).map(([k,rs])=>{
    const tot=sumFn(rs,k,k); let hijos=[];
    if(rs.length>1) hijos=rs.map(r=>Object.assign({},r,{nombre:r.clave+(rcEtq(r.nombre)?' · '+rcEtq(r.nombre):'')}));
    else { const dv=(rowsDiv||[]).filter(d=>String(d.clave).split('|')[0]===String(rs[0].clave)); if(dv.length>1) hijos=dv.map(d=>Object.assign({},d,{nombre:'División '+(String(d.clave).split('|')[1]||'—')})); }
    hijos.sort(ordenFn); tot.hijos=hijos; return tot; });
  return res.sort(ordenFn);
}
function rcArbolAmco(ref,hist){
  const stat=(w,f)=>{ const reps=w.lista.filter(f); return reps.length?w.nivel(reps):null; };
  const baseDe=f=>{ const v=hist.map(h=>{ const n=stat(h,f); return n?n.iegt:null; }).filter(x=>x!=null); return v.length?v.reduce((a,b)=>a+b,0)/v.length:null; };
  const cuenta=reps=>{ const c={Sólida:0,Aceptable:0,Irregular:0,Deficiente:0}; reps.forEach(r=>c[r._banda[0]]++); return c; };
  const nodo=(k,nombre,reps,f)=>{ const n=ref.nivel(reps); return {k,nombre,centro:(reps[0]||{}).Centro||'',n:reps.length,iegt:n.iegt,banda:n.banda,sc:n.sc,tot:n.tot,cnt:cuenta(reps),base:baseDe(f),hijos:[]}; };
  const per={}; ref.lista.forEach(v=>{ const k=rcBase(v.Supervisor)||v.SupCod; (per[k]=per[k]||[]).push(v); });
  return Object.entries(per).map(([k,reps])=>{
    const fP=v=>(rcBase(v.Supervisor)||v.SupCod)===k; const o=nodo(k,k,reps,fP);
    const cods=[...new Set(reps.map(v=>v.SupCod))];
    if(cods.length>1) o.hijos=cods.map(c=>{ const rs=reps.filter(v=>v.SupCod===c); return nodo(c,c+(rcEtq(rs[0].Supervisor)?' · '+rcEtq(rs[0].Supervisor):''),rs,v=>v.SupCod===c); });
    else { const divs=[...new Set(reps.map(v=>v.Division))].filter(Boolean); if(divs.length>1) o.hijos=divs.map(d=>nodo(d,'División '+d,reps.filter(v=>v.Division===d),v=>fP(v)&&v.Division===d)); }
    o.hijos.sort((a,b)=>b.iegt-a.iegt); return o; }).sort((a,b)=>b.iegt-a.iegt);
