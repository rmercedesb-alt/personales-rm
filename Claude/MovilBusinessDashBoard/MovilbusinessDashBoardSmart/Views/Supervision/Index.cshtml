    h+='<div class="sec-title"><h3>Factores</h3></div><div class="scroller" style="max-height:34vh"><table class="wt"><thead><tr><th class="l">Factor</th><th>Estrellas</th><th>Prom /100</th></tr></thead><tbody>'
