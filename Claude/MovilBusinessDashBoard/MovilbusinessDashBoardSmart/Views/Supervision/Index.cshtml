<script src="@(Context.Request.PathBase)/lib/xlsx.full.min.js"></script>
<script>
const BASE='@Context.Request.PathBase.Value';
const $=(s,r)=>(r||document).querySelector(s), $$=(s,r)=>[...(r||document).querySelectorAll(s)];
const api=(p,o)=>fetch(BASE+'/apisuperv'+p,o).then(r=>r.json());
function toast(m){const t=$('#toast');t.textContent=m;t.classList.add('show');clearTimeout(t._h);t._h=setTimeout(()=>t.classList.remove('show'),2600);}
// ── Apodo del término IEGT (marca configurable por empresa; reemplazo automático de texto) ──
let IEGT_APODO='';
function _iegtApply(root){ if(!IEGT_APODO)return;
  const w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT,{acceptNode:function(n){const p=n.parentNode;if(!p)return NodeFilter.FILTER_REJECT;const t=p.nodeName;if(t==='SCRIPT'||t==='STYLE'||t==='TEXTAREA'||t==='INPUT')return NodeFilter.FILTER_REJECT;return n.nodeValue.indexOf('IEGT')>=0?NodeFilter.FILTER_ACCEPT:NodeFilter.FILTER_SKIP;}});
  const nodes=[];let n;while(n=w.nextNode())nodes.push(n);
  nodes.forEach(t=>{t.nodeValue=t.nodeValue.replace(/\bIEGT\b/g,IEGT_APODO);});
}
function setIegtApodo(a){ IEGT_APODO=(a||'').trim(); if(!IEGT_APODO)return; _iegtApply(document.body);
  try{ const mo=new MutationObserver(muts=>{muts.forEach(m=>{ if(!m.addedNodes)return; m.addedNodes.forEach(nd=>{ if(nd.nodeType===1)_iegtApply(nd); else if(nd.nodeType===3&&nd.nodeValue.indexOf('IEGT')>=0)nd.nodeValue=nd.nodeValue.replace(/\bIEGT\b/g,IEGT_APODO); }); });});
  mo.observe(document.body,{childList:true,subtree:true}); }catch(e){}
}
(function(){ const b=document.getElementById('cfg-apodo-save'); if(!b)return; b.onclick=()=>{
  const v=(document.getElementById('cfg-apodo').value||'').trim();
  b.disabled=true;
  fetch(BASE+'/apisuperv/branding',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({iegtApodo:v})}).then(r=>r.json()).then(j=>{
    if(j&&j.ok){ toast('Apodo guardado ✓ — recarga la página para aplicarlo en todo'); }
    else toast((j&&j.error)||'Error');
    b.disabled=false;
  }).catch(e=>{toast('Error: '+e);b.disabled=false;});
}; })();
function band(v){return v>=85?'Solida':v>=70?'Aceptable':v>=55?'Irregular':'Deficiente';}
function scoreColor(v){return v>=85?'var(--good)':v>=55?'var(--warn)':'var(--bad)';}
const DESC={PREPARACION:'Historial del cliente; catálogo, precios y POP listos; revisó Nombre/Tel. y últimos pedidos.',SALUDO:'Saluda por su nombre; se identifica; pregunta por el pedido anterior.',INVENTARIO:'Góndola, mostrador y almacén; faltantes y bajo inventario; competencia.',AFICHES:'Coloca afiches y material POP en puntos visibles.',FOTO_EXITO:'Toma la foto de éxito de la exhibición.',PRESENTACION:'Argumenta beneficios, ganancias, empaque y precio; maneja objeciones.',CIERRE:'Cierre efectivo; cantidades según tamaño; anuncia próxima visita.',HERRAMIENTA:'Registra la visita y el pedido, y sincroniza.',DATOS_CLI:'Nombre, teléfono y datos del cliente actualizados.',CONOCE_VEND:'El cliente reconoce a su vendedor asignado.',PUNTOS_VEND:'Calificación que el cliente da al vendedor.',ENTREGAS:'Satisfacción del cliente con las entregas.',MANEJA_PROD:'El cliente maneja el portafolio completo.',PRECIOS:'Precios al cliente aceptables/competitivos.',POP:'El cliente tiene material POP colocado.',EXHIBIDOR:'El cliente tiene exhibidor de la marca.'};
let SUPPLIERS=[]; let SUPPLIERS_RAW=[]; // se puebla desde /apisuperv/suplidores (Categoria3) al boot
function loadSuppliers(){ api('/suplidores').then(j=>{ if(j&&j.ok&&j.items){ SUPPLIERS=j.items.map(x=>x.nombre); SUPPLIERS_RAW=j.items; if(typeof cobrosPobSuplidores==='function')cobrosPobSuplidores(); } }).catch(()=>{}); }
// Escala por estrellas (cada estrella = 20 puntos)
const STARLBL={20:'No Ejecuta',40:'Deficiente',60:'Aceptable',80:'Buena',100:'Excelente'};
function starN(v){return Math.max(1,Math.min(5,Math.round((v||0)/20)));}
function starDisp(v){const f=starN(v);return '★'.repeat(f)+'☆'.repeat(5-f);}
function starsHtml(val,editable,i){let h='<div class="stars" data-i="'+i+'">';const f=starN(val);
  for(let k=1;k<=5;k++)h+='<span class="star'+(k<=f?' on':'')+'"'+(editable?' data-k="'+k+'"':'')+'>'+(k<=f?'★':'☆')+'</span>';
  h+='</div><span class="starlbl" style="color:'+scoreColor(val)+'">'+(STARLBL[f*20]||'')+(editable?'':' · '+Math.round(val))+'</span>';return h;}

let ID={rol:'',veTodo:false,nombre:''}, SCHEMES=[], FACAcomp=[], FACAudit=[], REPS=[];
function facFor(m){return m==='audit'?FACAudit:FACAcomp;}
function schW(id){const s=SCHEMES.find(x=>x.codigo===id);return s?+s.peso:0;}
function sumW(fs){return fs.reduce((a,f)=>a+(+f.peso||0),0);}
function weighted(arr,fs){let s=0,t=sumW(fs);if(!t)return 0;fs.forEach((f,i)=>s+=arr[i]*(+f.peso||0));return Math.round(s/t);}
function globalIdx(iegt,ac,au){let n=0,d=0;const wi=schW('iegt'),wa=schW('acomp'),wu=schW('audit');if(iegt!=null){n+=iegt*wi;d+=wi;}if(ac!=null){n+=ac*wa;d+=wa;}if(au!=null){n+=au*wu;d+=wu;}return d>0?Math.round(n/d):null;}

