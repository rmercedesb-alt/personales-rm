  '<div class="sec-title"><h3>Comentario general de la evaluación</h3><span class="n">los comentarios por cliente están en “Ver detalle” de cada uno</span></div><textarea id="genComent" rows="3" style="width:100%;background:var(--panel);border:1px solid var(--border);border-radius:8px;color:var(--text);padding:9px;font:inherit;box-sizing:border-box" placeholder="Comentario general de la supervisión…">'+escA(payload.comentario||'')+'</textarea>'+
