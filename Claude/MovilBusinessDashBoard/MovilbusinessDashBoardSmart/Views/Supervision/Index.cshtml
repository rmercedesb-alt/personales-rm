  return 'Divisiones: '+(F.division.length?F.division.join(', '):'Todas')+' · Suplidores: '+t(F.suplidor,'Todos')+' · Categorías: '+t(F.categoria,'Todas')
    +' · Canales: '+t(F.canales,'Todos')+' · Centros: '+t(F.centros,'Todos')+' · Supervisores: '+t(F.supervisores,'Todos')+' · Vendedores: '+t(F.vendedores,'Todos');
}
