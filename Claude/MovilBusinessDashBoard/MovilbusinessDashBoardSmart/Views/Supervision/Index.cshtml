function cdWaEnviarGo(){
  if(!CD.resultado){ toast('Genera el informe primero'); return; }
  const avisoEl=$('#cd-wa-enviar-aviso'); avisoEl.style.display='none';
  let payload={ Fecha:CD.resultado.fecha };
  const f=cdFiltrosJSON();
  payload.Suplidor=f.suplidor.join(','); payload.Categoria=f.categoria.join(',');
  payload.Centros=f.centros.join(','); payload.Canales=f.canales.join(',');
  payload.Divisiones=f.divisiones.join(','); payload.Supervisores=f.supervisores.join(',');
  payload.Vendedores=f.vendedores.join(',');
  payload.Mensaje=$('#cd-wa-mensaje').value.trim()||CD_WA_MENSAJE_DEFAULT;
  const puntosKeys=['ventasDia','activacionesDia','ventasMes','activacionesMes','resumenEjecutivo','pensamiento'];
  payload.Puntos=puntosKeys.filter(k=>$('#cd-wa-pt-'+k).checked).join(',');
  if(!payload.Puntos){ avisoEl.textContent='Marca al menos un punto para incluir en la imagen.'; avisoEl.style.display='block'; return; }
  if(CDWA.destino==='persona'){
