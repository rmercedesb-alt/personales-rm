    +'<td>'+ppFmtNum(f.presupuesto)+'</td><td>'+ppFmtNum(f.presupuestoAlDia)+'</td><td>'+ppFmtNum(f.ejecutado)+'</td>'
    +'<td style="color:'+cdAlcanceColor(f.logroAlDiaPct)+';font-weight:700">'+(f.logroAlDiaPct!=null?f.logroAlDiaPct.toFixed(1)+'%':'—')+'</td>'
    +'<td style="color:'+col(dif)+'">'+(dif>0?'+':'')+ppFmtNum(dif)+'</td>'
    +'<td>'+ppFmtNum(f.proyectado)+'</td>'
    +'<td style="color:'+col(difP)+'">'+(difP>0?'+':'')+ppFmtNum(difP)+'</td></tr>';
