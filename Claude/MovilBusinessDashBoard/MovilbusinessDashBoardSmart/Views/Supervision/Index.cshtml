// Estado del sidecar WhatsApp (Baileys) — GET /apipdfpres/whatsapp/status, proxy hacia
// WhatsAppSender (localhost:5099). Muestra el QR mientras no esté vinculado.
// Baileys ROTA el QR cada ~20-30 seg. si no se escanea a tiempo — escanear uno viejo da
// exactamente "no se puede vincular en este momento" en el teléfono (el QR es válido,
// pero ya no es el vigente). Por eso, mientras el modal está abierto, se vuelve a
// consultar /status cada 5 seg. SIEMPRE (incl. ya "conectado" — 2026-09-20: el usuario
// reportó que el teléfono decía "no pudo conectar" mientras la pantalla seguía en
// "Vinculado" porque antes el polling se detenía al conectar — ahora sigue chequeando
// para detectar una desconexión real).
function cdWaAbrir(){
  document.getElementById('modal-cd-whatsapp').classList.add('on');
  cdWaCargarStatus();
  if(CD._waPoll) clearInterval(CD._waPoll);
  CD._waPoll=setInterval(cdWaCargarStatus, 5000);
}
function cdWaCerrar(){
  document.getElementById('modal-cd-whatsapp').classList.remove('on');
  if(CD._waPoll){ clearInterval(CD._waPoll); CD._waPoll=null; }
}
function cdWaCargarStatus(){
  const host=$('#cd-wa-status'); if(!host.innerHTML) host.innerHTML='<div class="hint">Consultando…</div>';
  fetch(BASE+'/apipdfpres/whatsapp/status').then(r=>r.json()).then(j=>{
    if(!j||!j.ok){ host.innerHTML='<div class="hint">Error'+((j&&j.error)?(': '+j.error):'')+'</div>'; return; }
    if(!j.activo){ CD._waConectado=false; host.innerHTML='<div class="hint">WhatsApp está desactivado (Smtp:WhatsApp:Activo=false en appsettings.json).</div>'; return; }
    if(j.conectado){ CD._waConectado=true; host.innerHTML='<div class="hint" style="color:#1f8b4c;font-weight:700">✅ Vinculado — listo para enviar</div>'; return; }
    CD._waConectado=false;
    if(j.qr){ host.innerHTML='<img src="'+j.qr+'" style="width:220px;height:220px;border:1px solid var(--border);border-radius:8px"><div class="hint" style="margin-top:8px">Escanea AHORA — este QR se refresca solo cada 5 seg.</div>'; return; }
    host.innerHTML='<div class="hint">'+(j.aviso||'Esperando el QR del sidecar…')+'</div>';
  }).catch(e=>{ host.innerHTML='<div class="hint">Error de conexión: '+e+'</div>'; });
}
// Desvincula la sesión actual (borra la auth/ del sidecar) para poder escanear un número
// distinto — pedido explícito 2026-09-20 ("si quiero cambiarlo o configurar otro").
function cdWaDesvincular(){
  if(!confirm('¿Desvincular el número actual de WhatsApp? Vas a tener que escanear un QR nuevo (del mismo número u otro distinto) antes de poder volver a enviar.')) return;
  fetch(BASE+'/apipdfpres/whatsapp/desvincular',{method:'POST'}).then(r=>r.json()).then(j=>{
    if(j&&j.ok){ toast('Desvinculado — espera el QR nuevo'); CD._waConectado=false; setTimeout(cdWaCargarStatus,1500); }
    else toast((j&&j.error)||'No se pudo desvincular');
  }).catch(e=>toast('Error: '+e));
}

