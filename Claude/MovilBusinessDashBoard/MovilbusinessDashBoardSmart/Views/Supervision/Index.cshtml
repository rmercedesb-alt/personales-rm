        +j.clientes.map(cl=>'<tr><td class="l">'+escA(cl.nombre||cl.cod)+'</td><td style="color:'+scoreColor(cl.prom)+'">'+starDisp(cl.prom)+'</td><td>'+Math.round(cl.prom)+'</td></tr>').join('')
        +'</tbody></table></div>';
    if(c.comentario)h+='<div class="sec-title"><h3>Comentario del supervisor</h3></div><div class="hint">'+escA(c.comentario)+'</div>';
