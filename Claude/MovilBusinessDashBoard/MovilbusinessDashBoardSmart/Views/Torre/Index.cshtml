  });
}

/* ── Monitores ── */
const UNIDAD={PRIMERA_VISITA_PEDIDO:'min desde 00:00 · 500 = 8:20',EFECTIVIDAD_VISITA:'% (alarma si es menor)',MUCHO_SIN_SYNC:'minutos',FUERA_ENTORNO:'kilómetros',PEDIDO_FUERA_DIA:'pedidos (≥)',ULTIMO_PEDIDO_TEMPRANO:'min desde 00:00 · 780 = 1:00 PM (alarma si menor)',CUMPLIMIENTO:'% (alarma si es menor)'};
const inp='background:#0d1117;border:1px solid #30363d;color:#e6edf3;border-radius:5px;padding:4px';
function cargarMonitores(){
  fetch(BASE+'/apitorre/monitores').then(r=>r.json()).then(j=>{
    const m=(j&&j.monitores)||[];
    const ven=m.find(x=>x.Codigo==='_VENTANA_');
    if(ven&&ven.Parametros){ try{ const p=JSON.parse(ven.Parametros); if(p.desde)$('#v-desde').value=p.desde; if(p.hasta)$('#v-hasta').value=p.hasta; if(p.muteMin)$('#v-mute').value=p.muteMin; }catch(e){} }
    const ro=m.find(x=>x.Codigo==='_REPS_OFF_'); REPSOFF=new Set(); if(ro&&ro.Parametros){ try{ (JSON.parse(ro.Parametros).reps||[]).forEach(x=>REPSOFF.add(x)); }catch(e){} } renderRepsOff();
    let h='<table><thead><tr><th class="l">Orden</th><th class="l">Monitor</th><th class="l">Umbral / Rango</th><th>Severidad</th><th>Activo</th><th></th></tr></thead><tbody>';
    m.filter(x=>x.Codigo!=='_VENTANA_').forEach(x=>{
      let umbCell;
      if(x.Codigo==='TIEMPO_VISITA'){
        let mn=3,mx=40; try{ if(x.Parametros){const p=JSON.parse(x.Parametros); if(p.minMin!=null)mn=p.minMin; if(p.maxMin!=null)mx=p.maxMin;} }catch(e){}
        umbCell='<div style="display:flex;gap:5px;align-items:center;justify-content:center"><input type="number" value="'+mn+'" id="min'+x.MonID+'" style="width:56px;'+inp+'"><span class="mini">a</span><input type="number" value="'+mx+'" id="max'+x.MonID+'" style="width:56px;'+inp+'"><span class="mini">min</span></div>';
      } else {
        umbCell='<input type="number" step="0.1" value="'+(x.Umbral==null?'':x.Umbral)+'" id="u'+x.MonID+'" style="width:80px;'+inp+'"> <span class="mini">'+(UNIDAD[x.Codigo]||'')+'</span>';
      }
      h+='<tr><td class="l">'+x.Orden+'</td><td class="l"><b>'+x.Nombre+'</b></td><td>'+umbCell+'</td>'+
        '<td><input type="number" value="'+x.Severidad+'" id="s'+x.MonID+'" style="width:52px;'+inp+'"></td>'+
        '<td><input type="checkbox" id="a'+x.MonID+'" '+(x.Activo?'checked':'')+'></td>'+
        '<td><button class="btn" onclick="guardarMon('+x.MonID+',\''+x.Codigo+'\')">Guardar</button></td></tr>';
    });
    h+='</tbody></table>'; $('#monitores').innerHTML=h;
  });
}
function guardarMon(id,cod){
  const body={ MonID:id, Severidad:parseInt($('#s'+id).value)||1, Activo:$('#a'+id).checked };
  if(cod==='TIEMPO_VISITA'){ body.ParametrosJSON=JSON.stringify({minMin:parseFloat($('#min'+id).value)||0,maxMin:parseFloat($('#max'+id).value)||0}); }
  else { body.Umbral=parseFloat($('#u'+id).value); }
  fetch(BASE+'/apitorre/monitores',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
    .then(r=>r.json()).then(j=>{ if(j&&j.ok){ const b=event&&event.target; if(b){b.textContent='✓';setTimeout(()=>b.textContent='Guardar',900);} } else alert('Error: '+(j&&j.error||'?')); });
}
let REPSOFF=new Set();
function renderRepsOff(){
  const q=($('#ro-search').value||'').toLowerCase();
  const list=REPS.filter(r=>(r.RepCodigo+' '+r.RepNombre).toLowerCase().includes(q));
  $('#ro-list').innerHTML=list.map(r=>'<label style="display:flex;gap:7px;padding:3px 4px;cursor:pointer;border-radius:5px" onmouseover="this.style.background=\'#21262d\'" onmouseout="this.style.background=\'\'"><input type="checkbox" data-rep="'+r.RepCodigo+'" '+(REPSOFF.has(r.RepCodigo)?'checked':'')+' onchange="toggleRepOff(this)"><span>'+r.RepCodigo+' - '+r.RepNombre+'</span></label>').join('');
  $('#ro-count').textContent=REPSOFF.size+' sin alerta';
}
function toggleRepOff(cb){ const r=cb.getAttribute('data-rep'); if(cb.checked)REPSOFF.add(r);else REPSOFF.delete(r); $('#ro-count').textContent=REPSOFF.size+' sin alerta'; }
function guardarRepsOff(){
  fetch(BASE+'/apitorre/monitores').then(r=>r.json()).then(j=>{
    const ex=((j&&j.monitores)||[]).find(x=>x.Codigo==='_REPS_OFF_');
    const body={ MonID:ex?ex.MonID:null, Codigo:'_REPS_OFF_', Tipo:'config', Nombre:'Representantes sin alerta', Activo:false, ParametrosJSON:JSON.stringify({reps:[...REPSOFF]}) };
    fetch(BASE+'/apitorre/monitores',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}).then(r=>r.json()).then(k=>{ alert(k&&k.ok?('Guardado. '+REPSOFF.size+' sin alerta.'):'Error: '+(k&&k.error||'?')); });
  });
}
function guardarVentana(){
  const body={ MonID:null, Codigo:'_VENTANA_', Tipo:'config', Nombre:'Ventana de vigilancia', Activo:false,
    ParametrosJSON:JSON.stringify({desde:$('#v-desde').value,hasta:$('#v-hasta').value,intervaloMin:30,muteMin:parseInt($('#v-mute').value)||60}) };
  // si ya existe, actualizar por MonID
  fetch(BASE+'/apitorre/monitores').then(r=>r.json()).then(j=>{
    const ex=((j&&j.monitores)||[]).find(x=>x.Codigo==='_VENTANA_');
    if(ex) body.MonID=ex.MonID;
    fetch(BASE+'/apitorre/monitores',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      .then(r=>r.json()).then(k=>{ alert(k&&k.ok?'Ventana guardada.':'Error: '+(k&&k.error||'?')); });
  });
}

/* ── Monitores personalizados ── */
let PERS=[], persItems=[], persGrupo=[], persEditId=null, persBusTimer=null, psMonId=null, psMonNom='';
const PMET={clientes:'Clientes distintos',unidades:'Unidades',monto:'Monto RD$',impactos:'Impactos'};
const PDIM={linea:'Línea/Categoría',producto:'Producto',suplidor:'Suplidor'};
const PGRP={reptipe:'RepTipe',supervisor:'Supervisor',reps:'Reps'};
function cargarPersonalizados(){
  fetch(BASE+'/apitorre/monitores').then(r=>r.json()).then(j=>{
    PERS=((j&&j.monitores)||[]).filter(x=>x.Tipo==='personalizado');
    if(!PERS.length){ $('#pers-list').innerHTML='<div class="mini">Aún no hay monitores personalizados. Crea uno con “+ Nuevo”.</div>'; return; }
    let h='<table><thead><tr><th class="l">Monitor</th><th class="l">Mide</th><th class="l">Grupo</th><th>Objetivo/día</th><th>Vigencia</th><th>Activo</th><th></th></tr></thead><tbody>';
    PERS.forEach(x=>{ let p={}; try{p=JSON.parse(x.Parametros||'{}')}catch(e){}
      const dim=PDIM[p.dimension]||p.dimension||''; const met=PMET[p.metrica]||p.metrica||'';
      const g=(p.grupo&&(PGRP[p.grupo.tipo]||p.grupo.tipo)+' '+((p.grupo.valores||[]).join(', ')))||'todos';
      const cmp=p.comparador==='menor'?'<':(p.comparador==='ritmo'?'≥ (ritmo)':'≥');
      const cmpExtra=p.comparador==='ritmo'?(' <span class="mini">hasta '+(p.horaLimiteRitmo||'15:00')+'</span>'):'';
      const vig=((x.VigenciaDesde||'—')+' → '+(x.VigenciaHasta||'—'));
      h+='<tr><td class="l"><b>'+x.Nombre+'</b></td><td class="l">'+met+' · '+dim+' ['+((p.ids||[]).join(','))+']</td><td class="l">'+g+'</td><td>'+cmp+' '+(p.objetivo!=null?p.objetivo:'')+cmpExtra+'</td><td class="mini">'+vig+'</td>'+
        '<td><input type="checkbox" '+(x.Activo?'checked':'')+' onchange="persToggle('+x.MonID+',this.checked)"></td>'+
        '<td style="white-space:nowrap"><button class="btn" onclick="verStatsPersOpen('+x.MonID+',\''+(x.Nombre||'').replace(/\x27/g,"")+'\')">📊</button> <button class="btn" onclick="editarPers('+x.MonID+')">✎</button></td></tr>';
    });
    h+='</tbody></table>'; $('#pers-list').innerHTML=h;
  });
}
function persToggle(id,act){
  fetch(BASE+'/apitorre/monitores',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({MonID:id,Activo:act})}).then(r=>r.json()).then(k=>{ if(!(k&&k.ok))alert('Error: '+(k&&k.error||'?')); });
}
function persMetChange(){ $('#p-minu-row').style.display=$('#p-met').value==='clientes'?'':'none'; }
function persCompChange(){ $('#p-ritmo-row').style.display=$('#p-comp').value==='ritmo'?'':'none'; }
function nuevoPers(){
  persEditId=null; persItems=[]; persGrupo=[];
  $('#pers-title').textContent='Nuevo monitor personalizado';
  $('#p-nom').value=''; $('#p-dim').value='linea'; $('#p-met').value='clientes'; $('#p-minu').value='1';
  $('#p-comp').value='mayorIgual'; $('#p-obj').value='5'; $('#p-sev').value='2'; $('#p-gtipo').value='reptipe'; $('#p-hh').value='';
  $('#p-ri').value='08:20'; $('#p-rl').value='15:00';
  $('#p-vd').value=dateF(new Date()); $('#p-vh').value='';
  $('#p-buscar').value=''; $('#p-busres').innerHTML='';
  persMetChange(); persCompChange(); persRenderItems(); persGrupoTipo();
  $('#modal-pers').classList.add('open');
}
function editarPers(id){
  const x=PERS.find(m=>m.MonID===id); if(!x)return; let p={}; try{p=JSON.parse(x.Parametros||'{}')}catch(e){}
  persEditId=id; persItems=(p.ids||[]).map(i=>({id:i,nombre:''})); persGrupo=((p.grupo&&p.grupo.valores)||[]).map(v=>({id:v,nombre:v}));
  $('#pers-title').textContent='Editar: '+x.Nombre;
  $('#p-nom').value=x.Nombre||''; $('#p-dim').value=p.dimension||'linea'; $('#p-met').value=p.metrica||'clientes';
  $('#p-minu').value=p.minUnid!=null?p.minUnid:1; $('#p-comp').value=p.comparador||'mayorIgual'; $('#p-obj').value=p.objetivo!=null?p.objetivo:5;
  $('#p-sev').value=x.Severidad||2; $('#p-gtipo').value=(p.grupo&&p.grupo.tipo)||'reptipe'; $('#p-hh').value=p.horaHasta||'';
  $('#p-ri').value=p.horaInicioRitmo||'08:20'; $('#p-rl').value=p.horaLimiteRitmo||'15:00';
  $('#p-vd').value=x.VigenciaDesde||''; $('#p-vh').value=x.VigenciaHasta||'';
  $('#p-buscar').value=''; $('#p-busres').innerHTML='';
  persMetChange(); persCompChange(); persRenderItems(); persGrupoTipo();
  // recuperar nombres de los ítems seleccionados
  if(persItems.length){ fetch(BASE+'/apitorre/catalogo?tipo='+encodeURIComponent(p.dimension||'linea')).then(r=>r.json()).then(j=>{ const map={}; (j.items||[]).forEach(i=>map[i.id]=i.nombre); persItems.forEach(it=>{ if(map[it.id])it.nombre=map[it.id]; }); persRenderItems(); }); }
  $('#modal-pers').classList.add('open');
}
function cerrarPers(){ $('#modal-pers').classList.remove('open'); }
$('#modal-pers').onclick=e=>{ if(e.target.id==='modal-pers')cerrarPers(); };
function persBuscarDeb(){ clearTimeout(persBusTimer); persBusTimer=setTimeout(persBuscar,350); }
function persBuscar(){
  const tipo=$('#p-dim').value, q=$('#p-buscar').value.trim();
  fetch(BASE+'/apitorre/catalogo?tipo='+encodeURIComponent(tipo)+'&q='+encodeURIComponent(q)).then(r=>r.json()).then(j=>{
    const it=(j&&j.items)||[];
    $('#p-busres').innerHTML=it.length?it.map(i=>'<div class="mini" style="padding:3px 4px;cursor:pointer;border-radius:5px" onmouseover="this.style.background=\'#21262d\'" onmouseout="this.style.background=\'\'" onclick="persAddItem(\''+i.id+'\',\''+(i.nombre||'').replace(/\x27/g,"").replace(/"/g,"")+'\')">+ '+i.id+' · '+i.nombre+'</div>').join(''):'<div class="mini">Sin resultados.</div>';
  });
}
function persAddItem(id,nom){ if(!persItems.some(x=>String(x.id)===String(id)))persItems.push({id:parseInt(id)||id,nombre:nom}); persRenderItems(); }
function persDelItem(id){ persItems=persItems.filter(x=>String(x.id)!==String(id)); persRenderItems(); }
function persRenderItems(){ $('#p-items').innerHTML=persItems.length?persItems.map(x=>'<span class="pill">'+x.id+(x.nombre?' · '+x.nombre:'')+' <b style="cursor:pointer" onclick="persDelItem(\''+x.id+'\')">✕</b></span>').join(''):'<span class="mini">Sin ítems seleccionados.</span>'; }
function persGrupoTipo(){
  const t=$('#p-gtipo').value, sel=$('#p-gsel');
  const fill=arr=>{ sel.innerHTML='<option value="">— agregar —</option>'+arr.map(o=>'<option value="'+o.v+'">'+o.t+'</option>').join(''); };
  if(t==='reps'){ fill(REPS.map(r=>({v:r.RepCodigo,t:r.RepCodigo+' - '+r.RepNombre}))); }
  else { fetch(BASE+'/apitorre/catalogo?tipo='+t).then(r=>r.json()).then(j=>fill(((j&&j.items)||[]).map(i=>({v:i.id,t:i.nombre})))); }
  persRenderGrupo();
}
function persAddGrupo(){ const s=$('#p-gsel'); const v=s.value; if(!v)return; const t=s.options[s.selectedIndex].text; if(!persGrupo.some(x=>String(x.id)===String(v)))persGrupo.push({id:v,nombre:t}); s.value=''; persRenderGrupo(); }
function persDelGrupo(v){ persGrupo=persGrupo.filter(x=>String(x.id)!==String(v)); persRenderGrupo(); }
function persRenderGrupo(){ $('#p-grupo').innerHTML=persGrupo.length?persGrupo.map(x=>'<span class="pill">'+(x.nombre||x.id)+' <b style="cursor:pointer" onclick="persDelGrupo(\''+x.id+'\')">✕</b></span>').join(''):'<span class="mini">Sin grupo = aplica a todos.</span>'; }
function guardarPers(){
  const nom=$('#p-nom').value.trim(); if(!nom){alert('Ponle un nombre al monitor.');return;}
  if(!persItems.length){alert('Agrega al menos un ítem (línea, producto o suplidor).');return;}
  const par={ dimension:$('#p-dim').value, ids:persItems.map(x=>parseInt(x.id)||x.id),
    metrica:$('#p-met').value, objetivo:parseFloat($('#p-obj').value)||0, comparador:$('#p-comp').value,
    minUnid:parseFloat($('#p-minu').value)||0,
    grupo:{ tipo:$('#p-gtipo').value, valores:persGrupo.map(x=>String(x.id)) } };
  if($('#p-hh').value) par.horaHasta=$('#p-hh').value;
  if($('#p-comp').value==='ritmo'){ par.horaInicioRitmo=$('#p-ri').value||'08:20'; par.horaLimiteRitmo=$('#p-rl').value||'15:00'; }
  const body={ MonID:persEditId, Codigo:persEditId?undefined:('PERS_'+Date.now()), Tipo:'personalizado', Nombre:nom,
    Severidad:parseInt($('#p-sev').value)||2, Orden:20, ParametrosJSON:JSON.stringify(par),
    VigenciaDesde:$('#p-vd').value||null, VigenciaHasta:$('#p-vh').value||null, Activo:true };
  overlay(true);
  fetch(BASE+'/apitorre/monitores',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
    .then(r=>r.json()).then(j=>{ overlay(false); if(j&&j.ok){ cerrarPers(); cargarPersonalizados(); } else alert('Error: '+(j&&j.error||'?')); })
    .catch(e=>{overlay(false);alert('Error: '+e);});
}
function verStatsPersOpen(id,nom){ psMonId=id; psMonNom=nom||''; $('#ps-title').textContent='📊 '+(nom||'Estadística');
  const hoy=dateF(new Date()); const d=new Date();d.setDate(d.getDate()-6);
  $('#ps-d0').value=dateF(d); $('#ps-d1').value=hoy; $('#ps-modo').value='dia';
  $('#modal-pstats').classList.add('open'); verStatsPers();
}
function cerrarPStats(){ $('#modal-pstats').classList.remove('open'); }
$('#modal-pstats').onclick=e=>{ if(e.target.id==='modal-pstats')cerrarPStats(); };
function verStatsPers(){
  if(!psMonId)return; overlay(true);
  fetch(BASE+'/apitorre/personalizado?monId='+psMonId+'&desde='+$('#ps-d0').value+'&hasta='+$('#ps-d1').value).then(r=>r.json()).then(j=>{
    overlay(false); if(!j||!j.ok){alert('Error: '+(j&&j.error||'?'));return;}
    const modo=$('#ps-modo').value, m=j.monitor, dias=j.dias||[], filas=j.filas||[];
    const unid=m.Metrica==='monto'?'RD$':(m.Metrica==='unidades'?'und':(m.Metrica==='impactos'?'imp':'cli'));
    const cmp=m.Comparador==='menor'?'<':'≥';
    $('#ps-cards').innerHTML=card('Objetivo/día',cmp+' '+m.Objetivo+' '+unid,'#58a6ff')+card('Vendedores',j.resumen.reps,'#e6edf3')+card('Días evaluados',j.resumen.diasEval,'#e6edf3')+card('Total grupo',(m.Metrica==='monto'?'RD$':'')+Math.round(j.resumen.totalGrupo).toLocaleString('es-DO'),'#3fb950');
    let h='<table><thead><tr><th class="l">Vendedor</th><th class="l">Supervisor</th>';
    if(modo==='dia') dias.forEach(d=>h+='<th title="'+d+'">'+d.slice(5)+'</th>');
    h+='<th>Total</th><th>Días ✔</th></tr></thead><tbody>';
    filas.forEach(f=>{ h+='<tr><td class="l">'+f.nombre+' <span class="mini">('+f.rep+')</span></td><td class="l">'+f.supervisor+'</td>';
      if(modo==='dia') (f.valores||[]).forEach(v=>{ const ok=m.Comparador==='menor'?(v<m.Objetivo):(v>=m.Objetivo); h+='<td style="background:'+(ok?'rgba(63,185,80,.15)':'rgba(248,81,73,.12)')+'">'+(m.Metrica==='monto'?Math.round(v).toLocaleString('es-DO'):v)+'</td>'; });
      const okd=f.diasCumplidos, tot=(j.dias||[]).length; const pc=tot?Math.round(okd*100/tot):0;
      h+='<td><b>'+(m.Metrica==='monto'?'RD$'+Math.round(f.total).toLocaleString('es-DO'):f.total)+'</b></td><td style="color:'+(pc>=70?'#3fb950':(pc>0?'#e3b341':'#f85149'))+'">'+okd+'/'+tot+'</td></tr>';
    });
    h+='</tbody></table>'; if(!filas.length)h='<div class="hint">Sin datos en el rango.</div>';
    $('#ps-body').innerHTML=h;
  }).catch(e=>{overlay(false);alert('Error: '+e);});
}

/* ── Histórico ── */
function cargarHistorico(){
  const f=$('#h-fecha').value||dateF(new Date());
  fetch(BASE+'/apitorre/snapshots?fecha='+f).then(r=>r.json()).then(j=>{
    const s=(j&&j.snapshots)||[];
    let h='<table><thead><tr><th class="l">Corte</th><th class="l">Vendedor</th><th class="l">Supervisor</th><th class="l">Monitor</th><th class="l">Detalle</th><th>Sev.</th></tr></thead><tbody>';
    s.forEach(x=>h+='<tr><td class="l">'+x.Corte+'</td><td class="l">'+x.RepNombre+' <span class="mini">('+x.RepCodigo+')</span></td><td class="l">'+x.Supervisor+'</td><td class="l">'+x.Codigo+'</td><td class="l" style="white-space:normal">'+x.Detalle+'</td><td>'+x.Severidad+'</td></tr>');
    h+='</tbody></table>'; if(!s.length)h='<div class="hint">Sin snapshots para esa fecha (se generan cada 30 min entre 8:20 y 16:00).</div>';
    $('#historico').innerHTML=h;
  });
}
</script>
</body>
</html>
