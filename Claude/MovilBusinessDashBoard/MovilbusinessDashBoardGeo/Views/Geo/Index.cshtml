@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Geolocalizaciones &mdash; AM COMERCIAL</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{background:#0d1117;color:#e6edf3;font-family:'Segoe UI',Tahoma,sans-serif;font-size:13px;display:flex;overflow:hidden}

/* ─── Sidebar fija ───────────────────────────────────────────────────────── */
.side{width:224px;flex-shrink:0;background:#0b0f14;border-right:1px solid #21262d;display:flex;flex-direction:column;height:100vh}
.side-brand{display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px solid #21262d}
.side-brand img{height:36px;width:auto;border-radius:6px;object-fit:contain}
.side-brand .bn{font-size:14px;font-weight:800;line-height:1.1}
.side-brand .bs{font-size:10px;color:#bc8cff;margin-top:2px}
.side-nav{flex:1;overflow-y:auto;padding:10px 8px}
.nav-item{display:flex;align-items:center;gap:11px;padding:11px 12px;border-radius:9px;cursor:pointer;color:#8b949e;transition:all .15s;margin-bottom:4px;border:1px solid transparent}
.nav-item:hover{background:#161b22;color:#e6edf3}
.nav-item.active{background:#161b22;color:#e6edf3;border-color:#30363d}
.nav-item.active .ni-bar{opacity:1}
.ni-ico{font-size:19px;line-height:1;width:22px;text-align:center;flex-shrink:0}
.ni-txt{font-size:12.5px;font-weight:600;line-height:1.25}
.ni-bar{position:absolute;left:0;width:3px;height:24px;border-radius:0 3px 3px 0;background:#bc8cff;opacity:0;transition:opacity .15s}
.nav-item{position:relative}
.side-foot{padding:12px 14px;border-top:1px solid #21262d;font-size:11px;color:#8b949e;display:flex;flex-direction:column;gap:8px}
.side-foot .u{color:#e6edf3;font-weight:600;font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.foot-links{display:flex;gap:8px}
.btn-s{flex:1;text-align:center;background:#161b22;border:1px solid #30363d;color:#8b949e;border-radius:6px;padding:6px 8px;font-size:11px;text-decoration:none;transition:all .15s}
.btn-s:hover{border-color:#58a6ff;color:#58a6ff}
.btn-s.out:hover{border-color:#f85149;color:#f85149}

/* ─── Panel principal ────────────────────────────────────────────────────── */
.main{flex:1;display:flex;flex-direction:column;height:100vh;min-width:0}
.topbar{display:flex;align-items:center;gap:12px;padding:11px 18px;border-bottom:1px solid #21262d;flex-wrap:wrap;flex-shrink:0}
.topbar h1{font-size:15px;font-weight:800}
.topbar .sub{font-size:11px;color:#8b949e}
.spacer{flex:1}
.clock{font-family:monospace;font-size:14px;color:#bc8cff;font-weight:700}

/* ─── Barra de filtros ───────────────────────────────────────────────────── */
.filters{display:flex;align-items:center;gap:9px;padding:9px 18px;border-bottom:1px solid #21262d;flex-wrap:wrap;background:#0b0f14;flex-shrink:0}
.f-lbl{font-size:11px;color:#8b949e;white-space:nowrap}
.filters input[type=date],.filters input[type=number],.filters select{background:#21262d;border:1px solid #30363d;color:#e6edf3;border-radius:6px;padding:5px 8px;font-size:12px;outline:none;height:30px;color-scheme:dark}
.filters input:focus,.filters select:focus{border-color:#bc8cff}
.filters input[type=number]{width:70px}
.btn-ref{background:#8957e5;border:none;color:#fff;border-radius:6px;padding:6px 14px;cursor:pointer;font-size:12px;font-weight:700;height:30px}
.btn-ref:hover{background:#9d6ef0}
.btn-clear{background:#21262d;border:1px solid #30363d;color:#8b949e;border-radius:6px;padding:6px 12px;cursor:pointer;font-size:12px;height:30px}
.btn-clear:hover{border-color:#f85149;color:#f85149}
.modo-group{display:flex;gap:0;margin-right:4px}
.btn-modo{background:#21262d;border:1px solid #30363d;color:#8b949e;padding:6px 12px;cursor:pointer;font-size:12px;height:30px}
.btn-modo:first-child{border-radius:6px 0 0 6px}
.btn-modo:last-child{border-radius:0 6px 6px 0;border-left:none}
.btn-modo.on{background:#1f6feb;border-color:#1f6feb;color:#fff;font-weight:700}

/* Multiselect */
.ms{position:relative}
.ms-btn{background:#21262d;border:1px solid #30363d;color:#e6edf3;border-radius:6px;padding:5px 9px;font-size:12px;cursor:pointer;height:30px;display:flex;align-items:center;gap:6px;white-space:nowrap;min-width:110px}
.ms-btn:hover{border-color:#bc8cff}
.ms-btn .cnt{background:#8957e5;color:#fff;border-radius:10px;font-size:10px;padding:1px 7px;font-weight:700}
.ms-pop{display:none;position:absolute;top:34px;left:0;z-index:1200;background:#161b22;border:1px solid #30363d;border-radius:8px;min-width:230px;max-height:320px;overflow-y:auto;box-shadow:0 10px 30px rgba(0,0,0,.5);padding:6px}
.ms-pop.open{display:block}
.ms-search{width:100%;background:#0d1117;border:1px solid #30363d;color:#e6edf3;border-radius:6px;padding:6px 8px;font-size:12px;margin-bottom:6px;outline:none}
.ms-opt{display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:6px;cursor:pointer;font-size:12px}
.ms-opt:hover{background:#21262d}
.ms-opt input{accent-color:#8957e5}
.ms-empty{color:#8b949e;font-size:11px;padding:8px;text-align:center}
.ms-head{display:flex;gap:12px;padding:4px 8px 6px;border-bottom:1px solid #21262d;margin-bottom:4px}
.ms-link{font-size:11px;color:#58a6ff;cursor:pointer;font-weight:600}
.ms-link:hover{text-decoration:underline}

/* ─── Contenido / mapa ───────────────────────────────────────────────────── */
.content{flex:1;position:relative;min-height:0}
#map{position:absolute;inset:0;background:#0d1117}
.leaflet-popup-content-wrapper,.leaflet-popup-tip{background:#161b22;color:#e6edf3;border:1px solid #30363d}
.leaflet-popup-content{margin:10px 12px;font-size:12px;line-height:1.5}
.pop-t{font-weight:800;font-size:13px;margin-bottom:4px}
.pop-r{color:#8b949e}
.leaflet-container{background:#0d1117}

/* Cards flotantes */
.cards{position:absolute;top:12px;right:12px;z-index:800;display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end;max-width:calc(100% - 80px)}
.warns{position:absolute;top:14px;left:50%;transform:translateX(-50%);z-index:810;display:flex;flex-direction:column;gap:6px;align-items:center;pointer-events:none}
.warn{padding:6px 16px;border-radius:20px;font-size:12px;font-weight:700;backdrop-filter:blur(4px);border:1px solid;white-space:nowrap}
.warn.blue{background:rgba(31,111,235,.18);color:#79c0ff;border-color:#1f6feb}
.warn.red{background:rgba(248,81,73,.18);color:#ff7b7b;border-color:#f85149}
.card{background:rgba(22,27,34,.94);border:1px solid #30363d;border-radius:11px;padding:11px 15px;min-width:150px;backdrop-filter:blur(4px)}
.card .cl{font-size:10px;color:#8b949e;text-transform:uppercase;letter-spacing:.6px;font-weight:600;margin-bottom:5px}
.card .cv{font-size:26px;font-weight:800;line-height:1}
.card.c1 .cv{color:#3fb950}.card.c2 .cv{color:#e3b341}.card.c3 .cv{color:#bc8cff}
.card .ch{font-size:10px;color:#8b949e;margin-top:3px}
.card .li{font-size:11px;padding:2px 0;color:#e6edf3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.card .li b{color:#bc8cff;margin-right:4px}

/* Leyenda */
.legend{position:absolute;bottom:16px;left:12px;z-index:800;background:rgba(22,27,34,.94);border:1px solid #30363d;border-radius:10px;padding:9px 12px;font-size:11px;backdrop-filter:blur(4px)}
.legend .lt{font-weight:700;margin-bottom:5px;color:#8b949e;text-transform:uppercase;font-size:10px;letter-spacing:.5px}
.lg-row{display:flex;align-items:center;gap:7px;padding:2px 0}
.lg-dot{width:12px;height:12px;border-radius:50%;flex-shrink:0;border:2px solid #fff}

/* Estado carga / placeholder */
.overlay{position:absolute;inset:0;z-index:900;display:none;align-items:center;justify-content:center;background:rgba(13,17,23,.6);backdrop-filter:blur(2px)}
.overlay.show{display:flex}
.spin{width:34px;height:34px;border:3px solid #30363d;border-top-color:#bc8cff;border-radius:50%;animation:sp 1s linear infinite}
@@keyframes sp{to{transform:rotate(360deg)}}
.soon{position:absolute;inset:0;z-index:850;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;color:#8b949e;text-align:center;padding:30px}
.soon .si{font-size:54px;opacity:.5}
.soon h2{font-size:18px;color:#e6edf3}
.soon p{font-size:13px;max-width:440px;line-height:1.6}
.badge{background:#21262d;border:1px solid #30363d;color:#bc8cff;font-size:11px;padding:3px 10px;border-radius:10px;font-weight:600}
.marker-lbl{background:none;border:none}
/* Impresion / PDF: ocultar controles y mostrar solo el mapa + tarjetas */
@@media print {
  body{display:block !important}
  .side, .filters, .gear, #btn-print, #btn-excel, .leaflet-control-zoom, .overlay{display:none !important}
  .main{height:auto !important}
  .content{position:relative !important;height:640px !important}
  .topbar{border:none}
}
/* Engranaje + modal de configuracion */
.gear{background:#21262d;border:1px solid #30363d;color:#8b949e;border-radius:8px;width:32px;height:32px;cursor:pointer;font-size:15px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.gear:hover{border-color:#bc8cff;color:#bc8cff}
.modal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:2000;align-items:center;justify-content:center}
.modal-bg.open{display:flex}
.modal{background:#161b22;border:1px solid #30363d;border-radius:14px;padding:22px 24px;width:460px;max-width:92vw;box-shadow:0 20px 60px rgba(0,0,0,.6)}
.modal h2{font-size:16px;margin-bottom:4px}
.modal .msub{font-size:12px;color:#8b949e;margin-bottom:18px}
.cfg-sec{margin-bottom:18px}
.cfg-sec h3{font-size:12px;color:#bc8cff;text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px}
.cfg-row{display:flex;align-items:center;gap:10px;margin-bottom:9px}
.cfg-row .dot{width:12px;height:12px;border-radius:50%;flex-shrink:0}
.cfg-row label{flex:1;font-size:12px;color:#e6edf3}
.cfg-row input{width:84px;background:#21262d;border:1px solid #30363d;color:#e6edf3;border-radius:6px;padding:5px 8px;font-size:12px;outline:none}
.cfg-row input:focus{border-color:#bc8cff}
.cfg-row .u{font-size:11px;color:#8b949e;width:34px}
.modal-foot{display:flex;justify-content:flex-end;gap:8px;margin-top:14px}
.card.wide{min-width:200px}
.card .top3{margin-top:5px}
.card .t3{font-size:11px;padding:2px 0;color:#e6edf3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.card .t3 b{color:#bc8cff;margin-right:5px}
.card .t3 .m{color:#8b949e;float:right;margin-left:6px}
</style>
</head>
<body>

<!-- ── Sidebar ── -->
<aside class="side">
  <div class="side-brand">
    <img src="@(Context.Request.PathBase)/apigeo/logo" alt="" onerror="this.style.display='none'">
    <div>
      <div class="bn" id="brand-name">AM COMERCIAL</div>
      <div class="bs">Geolocalizaciones</div>
    </div>
  </div>
  <nav class="side-nav" id="nav">
    <div class="nav-item active" data-view="ubicacion"><span class="ni-bar"></span><span class="ni-ico">&#128205;</span><span class="ni-txt">Ubicaci&oacute;n de Vendedores</span></div>
    <div class="nav-item" data-view="clientes"><span class="ni-bar"></span><span class="ni-ico">&#127968;</span><span class="ni-txt">Visitados Con / Sin Pedidos</span></div>
    <div class="nav-item" data-view="oportunidad"><span class="ni-bar"></span><span class="ni-ico">&#127919;</span><span class="ni-txt">Oportunidades por Suplidor</span></div>
    <div class="nav-item" data-view="promedio"><span class="ni-bar"></span><span class="ni-ico">&#128201;</span><span class="ni-txt">Compr&oacute; menos que el promedio</span></div>
    <div class="nav-item" data-view="fueraruta"><span class="ni-bar"></span><span class="ni-ico">&#128666;</span><span class="ni-txt">Pedidos fuera de Ruta</span></div>
  </nav>
  <div class="side-foot">
    <span class="u" id="user-nombre">&nbsp;</span>
    <div class="foot-links">
@if (ViewBag.ShowMenu as bool? != false)
{
      <a class="btn-s" href="@(Context.Request.PathBase)/menu">&#8592; Men&uacute;</a>
}
      <a class="btn-s out" href="@(Context.Request.PathBase)/account/logout">Salir</a>
    </div>
  </div>
</aside>

<!-- ── Main ── -->
<div class="main">
  <div class="topbar">
    <h1 id="view-title">Ubicaci&oacute;n de Vendedores</h1>
    <span class="sub" id="view-sub">&Uacute;ltima sincronizaci&oacute;n de cada representante</span>
    <div class="spacer"></div>
    <button class="gear" id="btn-excel" title="Exportar datos a Excel (CSV)">&#128229;</button>
    <button class="gear" id="btn-print" title="Imprimir / Guardar como PDF">&#128424;</button>
    <button class="gear" id="btn-cfg" title="Configuración de umbrales">&#9881;</button>
    <span class="clock" id="clock">--:--:--</span>
  </div>

  <div class="filters" id="filters"><!-- filtros dinamicos por vista --></div>

  <div class="content">
    <div id="map"></div>
    <div class="warns" id="warns"></div>
    <div class="cards" id="cards"></div>
    <div class="legend" id="legend" style="display:none"></div>
    <div class="overlay" id="overlay"><div class="spin"></div></div>
    <div class="soon" id="soon" style="display:none">
      <div class="si" id="soon-icon">&#128736;</div>
      <h2 id="soon-t">En construcci&oacute;n</h2>
      <p id="soon-p">Este sub-m&oacute;dulo se conectar&aacute; en la siguiente iteraci&oacute;n.</p>
      <span class="badge" id="soon-badge">Pr&oacute;ximamente</span>
    </div>
  </div>
</div>

<!-- Modal de configuracion de umbrales -->
<div class="modal-bg" id="cfg-modal">
  <div class="modal">
    <h2>Configuración de umbrales</h2>
    <div class="msub">Define los rangos de color para cada pestaña. Se guardan en este navegador.</div>

    <div class="cfg-sec">
      <h3>Ubicación de Vendedores (tiempo de sincronización)</h3>
      <div class="cfg-row"><span class="dot" style="background:#3fb950"></span><label>En verde: menos de</label><input type="number" id="cfg-sv" min="1"><span class="u">min</span></div>
      <div class="cfg-row"><span class="dot" style="background:#e3b341"></span><label>En amarillo: hasta</label><input type="number" id="cfg-sa" min="1"><span class="u">min</span></div>
      <div class="cfg-row"><span class="dot" style="background:#f85149"></span><label>En rojo: más de (el amarillo)</label><span class="u">&nbsp;</span></div>
    </div>

    <div class="cfg-sec">
      <h3>Ubicación en la Ruta (metros)</h3>
      <div class="cfg-row"><span class="dot" style="background:#3fb950"></span><label>En verde: menos de</label><input type="number" id="cfg-rv" min="1"><span class="u">m</span></div>
      <div class="cfg-row"><span class="dot" style="background:#e3b341"></span><label>En amarillo: hasta</label><input type="number" id="cfg-ra" min="1"><span class="u">m</span></div>
      <div class="cfg-row"><span class="dot" style="background:#f85149"></span><label>En rojo: más de (el amarillo)</label><span class="u">&nbsp;</span></div>
    </div>

    <div class="modal-foot">
      <button class="btn-clear" id="cfg-cancel">Cancelar</button>
      <button class="btn-ref" id="cfg-save">Guardar</button>
    </div>
  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
const BASE = '@Context.Request.PathBase.Value';
const $ = s => document.querySelector(s);

/* ── Reloj ── */
setInterval(()=>{ $('#clock').textContent = new Date().toLocaleTimeString('es-DO'); },1000);

/* ── Empresa / usuario ── */
fetch(BASE+'/apigeo/me').then(r=>r.json()).then(j=>{ if(j&&j.ok) $('#user-nombre').textContent=j.nombre||j.login; }).catch(()=>{});
fetch(BASE+'/apigeo/empresa').then(r=>r.json()).then(j=>{
  if(j&&j.ok&&j.nombre){ $('#brand-name').textContent=j.nombre; document.title='Geolocalizaciones — '+j.nombre; }
}).catch(()=>{});

/* ── Mapa Leaflet ── */
const map = L.map('map',{zoomControl:true,attributionControl:false,preferCanvas:true}).setView([18.75,-70.16],8); // Rep. Dominicana
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19}).addTo(map);
let layer = L.layerGroup().addTo(map);
let vecLayer = L.layerGroup().addTo(map);   // capa de vecinos (fuera de ruta)
function clearMap(){ layer.clearLayers(); vecLayer.clearLayers(); }
function fitTo(pts){ if(pts.length){ map.fitBounds(L.latLngBounds(pts).pad(0.15)); } }
setTimeout(()=>map.invalidateSize(),200);

/* ── Estado global de filtros / catalogo de reps ── */
let REPS = [];               // catalogo de representantes (jerarquia)
let REPMAP = {};             // RepCodigo -> RepNombre (para etiquetas)
let CAT  = { suplidores:[], categorias:[], divisiones:[] }; // catalogo suplidor/categoria/division
const state = { view:'ubicacion' };

/* ── Configuracion de umbrales (persistida en localStorage) ── */
const CFG_DEF = { sync:{verde:30, amarillo:45}, ruta:{verde:400, amarillo:1000} };
let CFG = loadCfg();
function loadCfg(){
  try{ const s=JSON.parse(localStorage.getItem('geoCfg')); if(s&&s.sync&&s.ruta) return s; }catch(e){}
  return JSON.parse(JSON.stringify(CFG_DEF));
}
function saveCfg(){ localStorage.setItem('geoCfg', JSON.stringify(CFG)); }
function openCfg(){
  $('#cfg-sv').value=CFG.sync.verde; $('#cfg-sa').value=CFG.sync.amarillo;
  $('#cfg-rv').value=CFG.ruta.verde; $('#cfg-ra').value=CFG.ruta.amarillo;
  $('#cfg-modal').classList.add('open');
}
function closeCfg(){ $('#cfg-modal').classList.remove('open'); }
document.addEventListener('DOMContentLoaded',()=>{});
$('#btn-cfg').onclick=openCfg;
$('#cfg-cancel').onclick=closeCfg;
$('#cfg-modal').onclick=e=>{ if(e.target.id==='cfg-modal') closeCfg(); };
$('#cfg-save').onclick=()=>{
  const sv=+$('#cfg-sv').value||CFG_DEF.sync.verde, sa=+$('#cfg-sa').value||CFG_DEF.sync.amarillo;
  const rv=+$('#cfg-rv').value||CFG_DEF.ruta.verde, ra=+$('#cfg-ra').value||CFG_DEF.ruta.amarillo;
  CFG={ sync:{verde:sv, amarillo:Math.max(sa,sv)}, ruta:{verde:rv, amarillo:Math.max(ra,rv)} };
  saveCfg(); closeCfg();
  if(state.view==='ubicacion') loadUbicacion();
};
/* Color segun umbrales configurables */
function colorSync(min){ return min < CFG.sync.verde ? '#3fb950' : (min <= CFG.sync.amarillo ? '#e3b341' : '#f85149'); }
function colorRuta(d){ if(d==null) return '#8b949e'; return d < CFG.ruta.verde ? '#3fb950' : (d <= CFG.ruta.amarillo ? '#e3b341' : '#f85149'); }

/* ── Exportar a Excel (CSV con BOM) e Imprimir/PDF ── */
function downloadCSV(name, headers, rows){
  const esc=s=>'"'+String(s==null?'':s).replace(/"/g,'""')+'"';
  const lines=[headers.map(esc).join(',')].concat(rows.map(r=>r.map(esc).join(',')));
  const blob=new Blob(['﻿'+lines.join('\r\n')],{type:'text/csv;charset=utf-8;'});
  const a=document.createElement('a'); a.href=URL.createObjectURL(blob);
  a.download=name+'_'+new Date().toISOString().slice(0,10)+'.csv';
  document.body.appendChild(a); a.click(); a.remove();
}
function exportExcel(){
  const v=state.view;
  if(v==='ubicacion' && V.lastUbic){
    downloadCSV('ubicacion_vendedores',['Rep','Nombre','Cargo','Supervisor','Centro','Latitud','Longitud','Sync','DistanciaRutaM','ClienteCercano'],
      V.lastUbic.reps.map(r=>[r.RepCodigo,r.RepNombre,r.RepCargo,r.SupervisorNombre,r.CentroNombre,r.Latitud,r.Longitud,r.Sync,(r.MinDistM!=null?r.MinDistM:''),(r.NearCliNombre||'')])); return;
  }
  if(v==='clientes' && V.lastClientesData){
    downloadCSV('visitados_con_sin_pedidos',['Codigo','Cliente','Rep','Vendedor','Estado','Comentario','Latitud','Longitud'],
      V.lastClientesData.clientes.map(r=>{const e=estadoCliente(r);return [r.CliID,r.Nombre,r.RepCodigo,(REPMAP[r.RepCodigo]||''),e.txt,(r.Comentario||''),r.Latitud,r.Longitud];})); return;
  }
  if(v==='oportunidad'){
    if(V.modoOp==='recuperados' && V.lastRecup && V.lastRecup.clientes){
      downloadCSV('clientes_retencion',['Codigo','Cliente','Rep','Vendedor','Estado','UnidadesActivo','ValorBrutoActivo','Latitud','Longitud'],
        V.lastRecup.clientes.map(r=>[r.CliID,r.Nombre,r.RepCodigo,(REPMAP[r.RepCodigo]||''),(EST_REC_TXT[r.Estado]||r.Estado),Math.round(r.Unidades),Math.round(r.ValorBruto),r.Latitud,r.Longitud])); return;
    }
    if(V.lastOport && V.lastOport.clientes){
      downloadCSV('oportunidades_suplidor',['Codigo','Cliente','Rep','Vendedor','Estado','Unidades','ValorBruto','Latitud','Longitud'],
        V.lastOport.clientes.map(r=>[r.CliID,r.Nombre,r.RepCodigo,(REPMAP[r.RepCodigo]||''),(r.Compra?'Si pidio':'Oportunidad perdida'),Math.round(r.Unidades||0),Math.round(r.ValorBruto||0),r.Latitud,r.Longitud])); return;
    }
  }
  if(v==='fueraruta' && V.lastFR){
    downloadCSV('pedidos_fuera_ruta',['Codigo','Cliente','Rep','Vendedor','Supervisor','PedidosFueraRuta','UltimoPedido','Latitud','Longitud'],
      V.lastFR.clientes.map(r=>[r.CliID,r.Nombre,r.RepCodigo,(r.RepNombre||''),(r.SupNombre||''),r.Pedidos,(r.UltPedido||''),r.Latitud,r.Longitud])); return;
  }
  alert('No hay datos cargados para exportar en esta vista.');
}
