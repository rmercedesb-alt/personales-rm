function filtrosURL(p){
  p.set('fechaIni',$('#f-ini').value); p.set('fechaFin',$('#f-fin').value);
  if(MS.centro.values().length) p.set('centros',MS.centro.values().join(','));
  if(MS.sup.values().length)    p.set('supervisores',MS.sup.values().join(','));
  if(MS.ven.values().length)    p.set('reps',MS.ven.values().join(','));
  if(MS.div.values().length)    p.set('divisiones',MS.div.values().join(','));
  return p;
}
let PARAMS=null;
function ensureParams(cb){
  if(PARAMS){ cb(); return; }
  fetch(BASE+'/apiseg/parametros').then(r=>r.json()).then(j=>{
    PARAMS=(j&&j.ok)?{suplidor:j.suplidor||{},categoria:j.categoria||{},producto:j.producto||{}}:{suplidor:{},categoria:{},producto:{}};
    cb();
  }).catch(()=>{ PARAMS={suplidor:{},categoria:{},producto:{}}; cb(); });
}
function loadSuplidor(){
  overlay(true); capturarFiltros();
  ensureParams(()=>{
    const p=filtrosURL(new URLSearchParams());
