function cardB(l,v,col,h){ return '<div class="card" style="min-width:150px"><div class="cl">'+l+'</div><div class="cv" style="color:'+col+'">'+v+'</div><div class="ch">'+h+'</div></div>'; }
function cardN(l,v,col){ return '<div class="card"><div class="cl" style="color:'+col+'">'+l+'</div><div class="cv" style="color:'+col+'">'+v+'</div><div class="ch">vendedores</div></div>'; }
function renderAgg(rows,tipo,parents){
