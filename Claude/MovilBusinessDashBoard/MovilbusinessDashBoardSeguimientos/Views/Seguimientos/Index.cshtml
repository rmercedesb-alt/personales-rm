@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Seguimientos Semanales &mdash; AM COMERCIAL</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{background:#0d1117;color:#e6edf3;font-family:'Segoe UI',Tahoma,sans-serif;font-size:13px;min-height:100vh}
header{display:flex;align-items:center;gap:12px;padding:10px 18px;border-bottom:1px solid #21262d;flex-wrap:wrap}
.brand{display:flex;align-items:center;gap:10px}
.brand img{height:38px;border-radius:6px;object-fit:contain}
.brand-name{font-size:16px;font-weight:800}
.brand-sub{font-size:11px;color:#bc8cff;margin-top:2px}
.spacer{flex:1}
.hbtn{background:#21262d;border:1px solid #30363d;color:#8b949e;border-radius:8px;width:32px;height:32px;cursor:pointer;font-size:15px;display:flex;align-items:center;justify-content:center}
.hbtn:hover{border-color:#bc8cff;color:#bc8cff}
.btn-menu,.btn-out{background:#21262d;border:1px solid #30363d;color:#e6edf3;border-radius:6px;padding:5px 11px;text-decoration:none;font-size:12px;font-weight:600}
.btn-menu:hover{border-color:#58a6ff;color:#58a6ff}.btn-out:hover{border-color:#f85149;color:#f85149}
.user-badge{font-size:11px;color:#8b949e;background:#21262d;padding:3px 10px;border-radius:20px}
.filters{display:flex;align-items:center;gap:9px;padding:9px 18px;border-bottom:1px solid #21262d;flex-wrap:wrap;background:#0b0f14}
.f-lbl{font-size:11px;color:#8b949e;white-space:nowrap}
.filters input[type=date],.filters input[type=number]{background:#21262d;border:1px solid #30363d;color:#e6edf3;border-radius:6px;padding:5px 8px;font-size:12px;outline:none;height:30px;color-scheme:dark}
.filters input[type=number]{width:74px}
.btn-ref{background:#8957e5;border:none;color:#fff;border-radius:6px;padding:6px 14px;cursor:pointer;font-size:12px;font-weight:700;height:30px}
.btn-ref:hover{background:#9d6ef0}
/* Multiselect */
.ms{position:relative}.ms-btn{background:#21262d;border:1px solid #30363d;color:#e6edf3;border-radius:6px;padding:5px 9px;font-size:12px;cursor:pointer;height:30px;display:flex;align-items:center;gap:6px;white-space:nowrap;min-width:104px}
.ms-btn:hover{border-color:#bc8cff}.ms-btn .cnt{background:#8957e5;color:#fff;border-radius:10px;font-size:10px;padding:1px 7px;font-weight:700}
.ms-pop{display:none;position:absolute;top:34px;left:0;z-index:1200;background:#161b22;border:1px solid #30363d;border-radius:8px;min-width:220px;max-height:320px;overflow-y:auto;box-shadow:0 10px 30px rgba(0,0,0,.5);padding:6px}
.ms-pop.open{display:block}.ms-search{width:100%;background:#0d1117;border:1px solid #30363d;color:#e6edf3;border-radius:6px;padding:6px 8px;font-size:12px;margin-bottom:6px;outline:none}
.ms-head{display:flex;gap:12px;padding:4px 8px 6px;border-bottom:1px solid #21262d;margin-bottom:4px}.ms-link{font-size:11px;color:#58a6ff;cursor:pointer;font-weight:600}
.ms-opt{display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:6px;cursor:pointer;font-size:12px}.ms-opt:hover{background:#21262d}.ms-opt input{accent-color:#8957e5}
/* Contenido */
.wrap{padding:14px 18px}
.crumbs{display:flex;align-items:center;gap:6px;font-size:12px;color:#8b949e;margin-bottom:12px;flex-wrap:wrap}
.crumb{color:#58a6ff;cursor:pointer}.crumb:hover{text-decoration:underline}.crumb.cur{color:#e6edf3;cursor:default}
.cards{display:flex;gap:11px;flex-wrap:wrap;margin-bottom:14px}
.card{background:#161b22;border:1px solid #30363d;border-radius:11px;padding:11px 15px;min-width:130px;position:relative;overflow:hidden}
.card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px}
.card .cl{font-size:10px;color:#8b949e;text-transform:uppercase;letter-spacing:.6px;font-weight:600;margin-bottom:5px}
.card .cv{font-size:26px;font-weight:800;line-height:1}.card .ch{font-size:10px;color:#8b949e;margin-top:3px}
table{width:100%;border-collapse:collapse;background:#161b22;border:1px solid #30363d;border-radius:10px;overflow:hidden}
th,td{padding:8px 10px;font-size:12px;text-align:center;border-bottom:1px solid #21262d;white-space:nowrap}
th{background:#0b0f14;color:#8b949e;text-transform:uppercase;font-size:10px;letter-spacing:.5px;position:sticky;top:0;z-index:5;box-shadow:0 1px 0 #30363d}
td.l,th.l{text-align:left}
tr.clickable{cursor:pointer}tr.clickable:hover td{background:#1c2128}
.badge{display:inline-block;padding:2px 9px;border-radius:10px;font-size:11px;font-weight:700;color:#0d1117}
.iegt{font-weight:800;font-size:14px}
.mini{font-size:10px;color:#8b949e}
.modo-group{display:flex;gap:0}
.btn-modo{background:#21262d;border:1px solid #30363d;color:#8b949e;padding:6px 13px;cursor:pointer;font-size:12px}
.btn-modo:first-child{border-radius:6px 0 0 6px}.btn-modo:last-child{border-radius:0 6px 6px 0;border-left:none}
.btn-modo.on{background:#8957e5;border-color:#8957e5;color:#fff;font-weight:700}
tr.totals td{background:#0b0f14;font-weight:800;border-top:2px solid #30363d}
#report-head{display:none;margin-bottom:12px}   /* solo en impresión/Excel, no en pantalla */
.rh-title{font-size:18px;font-weight:800}
.rh-sub{font-size:12px;color:#8b949e;margin-top:2px}
.rh-filtros{font-size:11px;color:#8b949e;margin-top:8px;background:#0b0f14;border:1px solid #21262d;border-radius:6px;padding:8px 11px}
.rh-filtros b{color:#e6edf3}
#iegt-legend{border-top:1px solid #21262d;margin-top:22px;padding:8px 2px 4px;font-size:10px;color:#6e7681;line-height:1.6}
.lg-b{display:inline-block;padding:0 6px;border-radius:7px;color:#0d1117;font-weight:700;margin:0 1px;font-size:9px}
#iegt-legend b{color:#8b949e}
/* Detalle vendedor */
.detail{background:#161b22;border:1px solid #30363d;border-radius:12px;padding:16px 18px;margin-top:14px}
.detail h3{font-size:15px;margin-bottom:4px}
.detail .sub{font-size:12px;color:#8b949e;margin-bottom:12px}
.subgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;margin-bottom:14px}
.subcard{background:#0d1117;border:1px solid #30363d;border-radius:8px;padding:8px 10px}
.subcard .k{font-size:10px;color:#8b949e}.subcard .v{font-size:15px;font-weight:700;margin-top:2px}
.concl{background:#0d1117;border-left:3px solid #bc8cff;border-radius:6px;padding:12px 14px;font-size:13px;line-height:1.6;margin-bottom:12px}
.concl b{color:#e6edf3}
.plan{background:#0d1117;border:1px solid #30363d;border-radius:8px;padding:0;overflow:hidden}
.plan .ph{background:#21262d;padding:8px 12px;font-size:12px;font-weight:700;color:#f0883e}
.plan .pi{padding:8px 12px;font-size:12px;border-top:1px solid #21262d;display:flex;gap:8px}
.plan .pi .tag{color:#f85149;font-weight:700;white-space:nowrap}
/* Modal config */
.modal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:2000;align-items:center;justify-content:center}
.modal-bg.open{display:flex}
.modal{background:#161b22;border:1px solid #30363d;border-radius:14px;padding:22px 24px;width:560px;max-width:94vw;max-height:90vh;overflow-y:auto}
.modal h2{font-size:16px;margin-bottom:14px}
.cfg-sec h3{font-size:12px;color:#bc8cff;text-transform:uppercase;letter-spacing:.5px;margin:14px 0 8px}
.cfg-row{display:flex;align-items:center;gap:8px;margin-bottom:7px;font-size:12px}
.cfg-row label{flex:1;color:#e6edf3}
.cfg-row input{width:70px;background:#21262d;border:1px solid #30363d;color:#e6edf3;border-radius:6px;padding:4px 7px;font-size:12px;outline:none}
.modal-foot{display:flex;justify-content:flex-end;gap:8px;margin-top:16px}
.btn-clear{background:#21262d;border:1px solid #30363d;color:#8b949e;border-radius:6px;padding:6px 12px;cursor:pointer;font-size:12px}
.overlay{position:fixed;inset:0;z-index:1500;display:none;align-items:center;justify-content:center;background:rgba(13,17,23,.6)}
.overlay.show{display:flex}.spin{width:34px;height:34px;border:3px solid #30363d;border-top-color:#bc8cff;border-radius:50%;animation:sp 1s linear infinite}
@@keyframes sp{to{transform:rotate(360deg)}}
@@media print{header .hbtn,header .btn-menu,header .btn-out,.filters,#modobar,#nivelbar{display:none!important}#report-head{display:block!important}.wrap{padding:0}tr.clickable{cursor:default}th{position:static}}
</style>
</head>
<body>
<header>
  <div class="brand">
    <img src="@(Context.Request.PathBase)/apiseg/logo" alt="" onerror="this.style.display='none'">
    <div><div class="brand-name" id="brand-name">AM COMERCIAL</div><div class="brand-sub">Seguimientos Semanales &middot; Torre de Control (IEGT)</div></div>
  </div>
  <div class="spacer"></div>
  <span class="user-badge" id="user-nombre"></span>
  <button class="hbtn" id="btn-excel" title="Exportar a Excel">&#128229;</button>
  <button class="hbtn" id="btn-print" title="Imprimir / PDF ejecutivo">&#128424;</button>
  <button class="hbtn" id="btn-cfg" title="Configurar parámetros (IEGT)">&#9881;</button>
@if (ViewBag.ShowMenu as bool? != false)
{
  <a class="btn-menu" href="@(Context.Request.PathBase)/menu">&#8592; Menú</a>
}
  <a class="btn-out" href="@(Context.Request.PathBase)/account/logout">Salir</a>
</header>

<div class="filters" id="filters">
  <span class="f-lbl">Semana:</span>
  <input type="date" id="f-ini"><span class="f-lbl">a</span><input type="date" id="f-fin">
  <span id="ms-centro"></span><span id="ms-sup"></span><span id="ms-ven"></span><span id="ms-div"></span>
  <span class="f-lbl">Fuera PDV (m):</span><input type="number" id="f-pdv" value="200" min="20" max="5000">
  <button class="btn-ref" id="btn-go">Generar informe</button>
</div>

<div class="wrap">
  <div id="report-head"></div>
  <div class="modo-group" id="modobar" style="display:inline-flex;margin-bottom:12px"></div>
  <div class="crumbs" id="crumbs"></div>
  <div class="cards" id="cards"></div>
  <div class="modo-group" id="nivelbar" style="display:inline-flex;margin:6px 0 12px"></div>
  <div id="tabla"></div>
  <div id="detalle"></div>
  <div id="iegt-legend"></div>
</div>

<div class="overlay" id="overlay"><div class="spin"></div></div>

<!-- Modal configuracion -->
<div class="modal-bg" id="cfg-modal"><div class="modal">
  <h2>Configuración de parámetros — IEGT</h2>
  <div id="cfg-body"></div>
  <div class="modal-foot"><button class="btn-clear" id="cfg-reset">Restaurar por defecto</button><button class="btn-clear" id="cfg-cancel">Cancelar</button><button class="btn-ref" id="cfg-save">Guardar</button></div>
</div></div>

<script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
<script>
const BASE='@Context.Request.PathBase.Value';
const $=s=>document.querySelector(s);
fetch(BASE+'/apiseg/me').then(r=>r.json()).then(j=>{ if(j&&j.ok) $('#user-nombre').textContent=j.nombre||j.login; }).catch(()=>{});
fetch(BASE+'/apiseg/empresa').then(r=>r.json()).then(j=>{ if(j&&j.ok&&j.nombre){ EMP=j.nombre; $('#brand-name').textContent=j.nombre; document.title='Seguimientos — '+j.nombre; } }).catch(()=>{});

/* ── Config editable (IEGT) ── */
const CFG_DEF={
  pesos:{visitas:30,inicio:20,cierre:10,ventas:10,ruta:10,pdv:10,ritmo:10},
  visitas:{v100:98,v75:95,v50:88},
  inicio:{min100:495,min50:525},   // 08:15 / 08:45 (minutos desde medianoche)
  cierre:{min100:930,min50:870},   // 15:30 / 14:30
  ventas:{bandLo:55,bandHi:65,tol:5},
  bandas:{solida:85,aceptable:70,irregular:55},
  pdvMetros:200,
  pdvModo:'distancia'   // 'distancia' (GPS>umbral) | 'ruta' (cliente no programado ese día)
};
let CFG=loadCfg();
function loadCfg(){ try{const s=JSON.parse(localStorage.getItem('segCfg')); if(s&&s.pesos) return Object.assign(JSON.parse(JSON.stringify(CFG_DEF)),s);}catch(e){} return JSON.parse(JSON.stringify(CFG_DEF)); }
function saveCfg(){ localStorage.setItem('segCfg',JSON.stringify(CFG)); }

/* ── Sub-scores IEGT ── */
function subVisitas(ef){ return ef>=CFG.visitas.v100?100:ef>=CFG.visitas.v75?75:ef>=CFG.visitas.v50?50:25; }
function subInicio(m){ if(m==null)return 0; return m<=CFG.inicio.min100?100:m<=CFG.inicio.min50?50:0; }
function subCierre(m){ if(m==null)return 0; return m>=CFG.cierre.min100?100:m>=CFG.cierre.min50?50:0; }
function subVentas(ef){ const c=CFG.ventas; return (ef>=c.bandLo&&ef<=c.bandHi)?100:(ef>=c.bandLo-c.tol&&ef<=c.bandHi+c.tol)?60:25; }
function subRuta(n){ return n===0?100:n===1?80:n===2?50:20; }
function subPDV(n){ return n<=2?100:n<=5?70:n<=10?40:15; }
function subRitmo(seg,med){ if(!seg||!med)return 100; const d=Math.abs(seg-med)/med; return d<=0.25?100:d<=0.5?60:30; }
function efVis(v){ return v.TotVis?100*v.Visitados/v.TotVis:0; }
function efVen(v){ return v.Visitados?100*v.Pedidos/v.Visitados:0; }
function iegtDe(v,med){ const p=CFG.pesos; const tot=p.visitas+p.inicio+p.cierre+p.ventas+p.ruta+p.pdv+p.ritmo;
  return (p.visitas*subVisitas(efVis(v))+p.inicio*subInicio(v.PrimerMin)+p.cierre*subCierre(v.UltimoMin)+p.ventas*subVentas(efVen(v))+p.ruta*subRuta(v.FueraRuta)+p.pdv*subPDV(v.FueraPDV)+p.ritmo*subRitmo(v.PromSeg,med))/tot; }
function banda(s){ const b=CFG.bandas; return s>=b.solida?['Sólida','#3fb950']:s>=b.aceptable?['Aceptable','#58a6ff']:s>=b.irregular?['Irregular','#e3b341']:['Deficiente','#f85149']; }
function inconsist(ef){ return ef>=98?['Sin','#3fb950']:ef>=95?['Baja','#e3b341']:ef>=88?['Media','#f0883e']:['Alta','#f85149']; }
function hhmm(m){ if(m==null)return '—'; m=Math.round(m); return String(Math.floor(m/60)).padStart(2,'0')+':'+String(m%60).padStart(2,'0'); }
function median(arr){ const a=arr.filter(x=>x!=null).slice().sort((x,y)=>x-y); if(!a.length)return null; const n=a.length; return n%2?a[(n-1)/2]:(a[Math.floor(n/2)-1]+a[Math.floor(n/2)])/2; }

/* ── Multiselect ── */
function multiselect(host,label,opts,onChange){
  const wrap=document.createElement('div');wrap.className='ms';const btn=document.createElement('div');btn.className='ms-btn';
  const txt=document.createElement('span');txt.textContent=label;const cnt=document.createElement('span');cnt.className='cnt';cnt.style.display='none';
  btn.append(txt,cnt);const pop=document.createElement('div');pop.className='ms-pop';
  const search=document.createElement('input');search.className='ms-search';search.placeholder='Buscar...';
  const head=document.createElement('div');head.className='ms-head';const all=document.createElement('span');all.className='ms-link';all.textContent='✓ Todos';const non=document.createElement('span');non.className='ms-link';non.textContent='✕ Ninguno';head.append(all,non);
  const list=document.createElement('div');pop.append(search,head,list);wrap.append(btn,pop);host.appendChild(wrap);
  let options=opts.slice(),selected=new Set();
  const vis=()=>{const q=(search.value||'').toLowerCase();return options.filter(o=>o.t.toLowerCase().includes(q));};
  all.onclick=e=>{e.stopPropagation();vis().forEach(o=>selected.add(o.v));render();sync();onChange&&onChange();};
  non.onclick=e=>{e.stopPropagation();vis().forEach(o=>selected.delete(o.v));render();sync();onChange&&onChange();};
  function render(){list.innerHTML='';const f=vis();if(!f.length){list.innerHTML='<div class="mini" style="padding:8px;text-align:center">Sin opciones</div>';}
    f.forEach(o=>{const row=document.createElement('label');row.className='ms-opt';const cb=document.createElement('input');cb.type='checkbox';cb.checked=selected.has(o.v);cb.onchange=()=>{cb.checked?selected.add(o.v):selected.delete(o.v);sync();onChange&&onChange();};const sp=document.createElement('span');sp.textContent=o.t;row.append(cb,sp);list.appendChild(row);});}
  function sync(){const n=selected.size;cnt.style.display=n?'inline-block':'none';cnt.textContent=n;}
  btn.onclick=e=>{e.stopPropagation();document.querySelectorAll('.ms-pop.open').forEach(p=>{if(p!==pop)p.classList.remove('open');});pop.classList.toggle('open');if(pop.classList.contains('open')){search.value='';render();search.focus();}};
  search.oninput=render;pop.onclick=e=>e.stopPropagation();render();sync();
  return {values:()=>[...selected],setOptions:(n,keep)=>{options=n.slice();if(!keep)selected=new Set([...selected].filter(v=>options.some(o=>o.v===v)));render();sync();},select:(vs)=>{(vs||[]).forEach(v=>selected.add(v));render();sync();},clear:()=>{selected.clear();render();sync();}};
}
document.addEventListener('click',()=>document.querySelectorAll('.ms-pop.open').forEach(p=>p.classList.remove('open')));

/* ── Estado ── */
let REPS=[], DATA=[], MS={}, nav={nivel:'centro', ced:null, sup:null}, EMP='AM COMERCIAL', APPLIED=null;
let modoAnalisis='general', SUP=[], SUPITEMS=[], supNav={agrupar:'suplidor',sup:null,cat:null}, promOv={};
/* Semana anterior (lunes a sábado) por defecto */
function diaSemana(s){ if(!s)return ''; const p=s.split('-'); const d=new Date(+p[0],+p[1]-1,+p[2]); return ['domingo','lunes','martes','miércoles','jueves','viernes','sábado'][d.getDay()]; }
(function(){ const d=new Date(); const day=d.getDay(); const thisMon=new Date(d); thisMon.setDate(d.getDate()-((day+6)%7)); const mon=new Date(thisMon); mon.setDate(thisMon.getDate()-7); const sat=new Date(mon); sat.setDate(mon.getDate()+5); const f=x=>x.getFullYear()+'-'+String(x.getMonth()+1).padStart(2,'0')+'-'+String(x.getDate()).padStart(2,'0'); $('#f-ini').value=f(mon); $('#f-fin').value=f(sat); })();

function buildFiltros(){
  const centros=[...new Map(REPS.filter(r=>r.CedCodigo).map(r=>[r.CedCodigo,r.CentroNombre])).entries()].map(([v,t])=>({v,t}));
  const divis=[...new Set(REPS.map(r=>r.Division).filter(Boolean))].sort().map(v=>({v,t:'División '+v}));
  MS.centro=multiselect($('#ms-centro'),'Centro',centros,depend);
  MS.sup=multiselect($('#ms-sup'),'Supervisor',[],depend);
  MS.ven=multiselect($('#ms-ven'),'Vendedor',[]);
  MS.div=multiselect($('#ms-div'),'División',divis);
  MS.div.select(['10','11']);
  depend();
}
function depend(){
  const cen=new Set(MS.centro.values());
  const rc=cen.size?REPS.filter(r=>cen.has(r.CedCodigo)):REPS;
  MS.sup.setOptions([...new Map(rc.filter(r=>r.SupervisorCod).map(r=>[r.SupervisorCod,r.SupervisorNombre])).entries()].map(([v,t])=>({v,t})));
  const sup=new Set(MS.sup.values());
  const rs=sup.size?rc.filter(r=>sup.has(r.SupervisorCod)):rc;
  MS.ven.setOptions(rs.map(r=>({v:r.RepCodigo,t:r.RepCodigo+' - '+r.RepNombre})));
}
function overlay(b){ $('#overlay').classList.toggle('show',b); }
function lblList(ms,fn){ return ms.values().map(fn); }
function capturarFiltros(){
  const cName=v=>{const r=REPS.find(x=>x.CedCodigo===v);return r?r.CentroNombre:v;};
  const sName=v=>{const r=REPS.find(x=>x.SupervisorCod===v);return r?r.SupervisorNombre:v;};
  const vName=v=>{const r=REPS.find(x=>x.RepCodigo===v);return r?(v+' - '+r.RepNombre):v;};
  APPLIED={ ini:$('#f-ini').value, fin:$('#f-fin').value,
    centros:lblList(MS.centro,cName), sups:lblList(MS.sup,sName), vens:lblList(MS.ven,vName),
    div:MS.div.values(), pdvModo:CFG.pdvModo, pdvMetros:CFG.pdvMetros };
}
function generar(){
  overlay(true); capturarFiltros();
  const p=new URLSearchParams();
  p.set('fechaIni',$('#f-ini').value); p.set('fechaFin',$('#f-fin').value); p.set('pdvMetros',$('#f-pdv').value||'200');
  p.set('pdvModo',CFG.pdvModo||'distancia');
  if(MS.centro.values().length) p.set('centros',MS.centro.values().join(','));
  if(MS.sup.values().length)    p.set('supervisores',MS.sup.values().join(','));
  if(MS.ven.values().length)    p.set('reps',MS.ven.values().join(','));
  if(MS.div.values().length)    p.set('divisiones',MS.div.values().join(','));
  fetch(BASE+'/apiseg/semana?'+p.toString()).then(r=>r.json()).then(j=>{
    overlay(false);
    if(!j||!j.ok){ alert('Error: '+(j&&j.error||'?')); return; }
    DATA=j.vendedores||[]; nav={nivel:'centro',ced:null,sup:null};
    if(modoAnalisis==='suplidor'){ supNav={agrupar:'suplidor',sup:null,cat:null}; loadSuplidor(); } else render();
  }).catch(e=>{ overlay(false); alert('Error de conexión: '+e); });
}

/* ── Render con drill-down + salto directo de nivel ── */
function scope(){ let d=DATA; if(nav.ced) d=d.filter(v=>v.CedCodigo===nav.ced); if(nav.sup) d=d.filter(v=>v.SupCod===nav.sup); return d; }
function withIegt(list){ const med=median(list.map(v=>v.PromSeg)); return list.map(v=>{const s=iegtDe(v,med);return Object.assign({},v,{_iegt:s,_banda:banda(s),_efv:efVis(v),_efn:efVen(v),_inc:inconsist(efVis(v))});}); }
function agg(list,keyFn,nameFn,parentFn){
  const g={}; list.forEach(v=>{const k=keyFn(v); (g[k]=g[k]||{k,nombre:nameFn(v),padre:parentFn?parentFn(v):'',reps:[]}).reps.push(v);});
  return Object.values(g).map(x=>{ const avg=x.reps.reduce((a,b)=>a+b._iegt,0)/x.reps.length;
    const cnt={Sólida:0,Aceptable:0,Irregular:0,Deficiente:0}; x.reps.forEach(r=>cnt[r._banda[0]]++);
    return {k:x.k,nombre:x.nombre,padre:x.padre,n:x.reps.length,iegt:avg,banda:banda(avg),cnt}; }).sort((a,b)=>b.iegt-a.iegt);
}
/* ── Modo General / Por Suplidor ── */
function renderModoBar(){
  const b=(id,t)=>'<button class="btn-modo'+(modoAnalisis===id?' on':'')+'" onclick="switchModo(\''+id+'\')">'+t+'</button>';
