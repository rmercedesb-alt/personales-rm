/* ── IEGT por suplidor: jornada (de /semana) + cumplimiento de meta del suplidor ── */
function curParLevel(){ return supNav.cat?'producto':(supNav.sup?'categoria':'suplidor'); }
function parOf(itemId){ if(!PARAMS)return null; return (PARAMS[curParLevel()]||{})[itemId]||null; }
function subCumpl(pct){ return pct>=100?100:pct>=70?75:pct>=40?50:pct>0?25:0; }
/* combina una fila (item,vendedor) con su jornada de la semana y calcula el IEGT del suplidor */
function supIegt(f, med){
  const j=DATA.find(x=>x.RepCodigo===f.RepCodigo)||{};
  const efv=j.TotVis?100*j.Visitados/j.TotVis:0;
  const par=parOf(f.ItemId); const target=par?par.valSem:0;
  const cumpl=target>0?100*f.Valor/target:(f.Valor>0?100:0);
  const sc={visitas:subVisitas(efv),inicio:subInicio(j.PrimerMin),cierre:subCierre(j.UltimoMin),
            ventas:subCumpl(cumpl),ruta:subRuta(j.FueraRuta||0),pdv:subPDV(j.FueraPDV||0),ritmo:subRitmo(j.PromSeg,med)};
  const p=CFG.pesos, tot=p.visitas+p.inicio+p.cierre+p.ventas+p.ruta+p.pdv+p.ritmo;
  const iegt=(p.visitas*sc.visitas+p.inicio*sc.inicio+p.cierre*sc.cierre+p.ventas*sc.ventas+p.ruta*sc.ruta+p.pdv*sc.pdv+p.ritmo*sc.ritmo)/tot;
  return Object.assign({},f,{_j:j,_efv:efv,_cumpl:cumpl,_target:target,_sc:sc,_iegt:iegt,_banda:banda(iegt)});
}
function aggItems(){
  const med=median(DATA.map(x=>x.PromSeg));
  const g={};
  SUP.forEach(f=>{ const o=g[f.ItemId]=g[f.ItemId]||{item:f.Item,itemId:f.ItemId,reps:[],V:0,U:0,C:0};
    o.reps.push(supIegt(f,med)); o.V+=f.Valor;o.U+=f.Unidades;o.C+=f.Cajas; });
  return Object.values(g).map(o=>{
    o.nAsig=o.reps.length; o.nVend=o.reps.filter(r=>r.Valor>0).length;
    o.pen=o.nAsig?100*o.nVend/o.nAsig:0;
    o.iegt=o.reps.reduce((a,b)=>a+b._iegt,0)/(o.reps.length||1);
    o.cnt={Sólida:0,Aceptable:0,Irregular:0,Deficiente:0}; o.reps.forEach(r=>o.cnt[r._banda[0]]++);
    o.par=parOf(o.itemId); o.meta=o.par?o.par.valSem:0;
    return o; }).sort((a,b)=>b.V-a.V);
}
function cardN2(l,v){ return '<div class="card"><div class="cl">'+l+'</div><div class="cv" style="color:#e6edf3">'+v+'</div><div class="ch">total</div></div>'; }
