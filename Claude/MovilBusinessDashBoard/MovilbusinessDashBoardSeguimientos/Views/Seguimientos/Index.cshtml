function fmtN(x){ return (x==null?0:Math.round(x)).toLocaleString('es-DO'); }
function fmtDec(x){ return (x==null?0:x).toLocaleString('es-DO',{maximumFractionDigits:1}); }
function renderVendedores(list){
  list.sort((a,b)=>b._iegt-a._iegt);
  let h='<table><thead><tr><th class="l">#</th><th class="l">Centro</th><th class="l">Supervisor</th><th class="l">Vendedor</th><th>Ef.Vis</th><th>Ef.Ven</th><th>1er ped</th><th>Últ ped</th><th>F.Ruta</th><th>F.PDV</th><th>Ritmo(s)</th><th>Unidades</th><th>Cajas</th><th>Valor</th><th>IEGT</th><th>Banda</th></tr></thead><tbody>';
  let n=0,sIeg=0,sFr=0,sFp=0,sU=0,sC=0,sV=0;
  list.forEach((v,i)=>{ h+='<tr class="clickable" onclick="__ver('+"'"+v.RepCodigo+"'"+')"><td class="l">'+(i+1)+'</td><td class="l">'+v.Centro+'</td><td class="l">'+v.Supervisor+'</td><td class="l">'+v.RepNombre+' <span class="mini">('+v.RepCodigo+')</span></td>'+
    '<td style="color:'+v._inc[1]+'">'+v._efv.toFixed(0)+'%</td><td>'+v._efn.toFixed(0)+'%</td><td>'+hhmm(v.PrimerMin)+'</td><td>'+hhmm(v.UltimoMin)+'</td>'+
    '<td '+(v.FueraRuta>=2?'style="color:#f85149;font-weight:700"':'')+'>'+v.FueraRuta+'</td><td '+(v.FueraPDV>10?'style="color:#f85149;font-weight:700"':'')+'>'+v.FueraPDV+'</td>'+
    '<td>'+(v.PromSeg||'—')+'</td><td>'+fmtN(v.Unidades)+'</td><td>'+fmtDec(v.Cajas)+'</td><td>'+fmtN(v.Valor)+'</td>'+
    '<td class="iegt" style="color:'+v._banda[1]+'">'+v._iegt.toFixed(1)+'</td><td><span class="badge" style="background:'+v._banda[1]+'">'+v._banda[0]+'</span></td></tr>';
    n++;sIeg+=v._iegt;sFr+=v.FueraRuta;sFp+=v.FueraPDV;sU+=(v.Unidades||0);sC+=(v.Cajas||0);sV+=(v.Valor||0); });
  const iegtT=n?sIeg/n:0;
  h+='<tr class="totals"><td class="l" colspan="4">TOTAL ('+n+' vendedores)</td><td></td><td></td><td></td><td></td><td>'+sFr+'</td><td>'+sFp+'</td><td></td><td>'+fmtN(sU)+'</td><td>'+fmtDec(sC)+'</td><td>'+fmtN(sV)+'</td><td class="iegt" style="color:'+banda(iegtT)[1]+'">'+iegtT.toFixed(1)+'</td><td></td></tr>';
  h+='</tbody></table>'; $('#tabla').innerHTML=h;
}
window.__drill=(k,tipo)=>{ if(tipo==='Centro')setNivel('supervisor',k,null); else { const v=DATA.find(x=>x.SupCod===k); setNivel('vendedor',v?v.CedCodigo:nav.ced,k); } };
window.setNivel=(nivel,ced,sup)=>{ nav={nivel:nivel, ced:(ced!==undefined?ced:nav.ced), sup:(sup!==undefined?sup:nav.sup)}; if(nivel==='centro'){nav.ced=null;nav.sup=null;} if(nivel==='supervisor'&&sup===undefined)nav.sup=null; render(); };
window.__ver=(rep)=>{ verVendedor(rep); };

/* ── Detalle + conclusión + plan de acción ── */
function verVendedor(rep){
  const list=withIegt(scope()); const v=list.find(x=>x.RepCodigo===rep); if(!v)return;
  const med=median(scope().map(x=>x.PromSeg));
  const sc={visitas:subVisitas(v._efv),inicio:subInicio(v.PrimerMin),cierre:subCierre(v.UltimoMin),ventas:subVentas(v._efn),ruta:subRuta(v.FueraRuta),pdv:subPDV(v.FueraPDV),ritmo:subRitmo(v.PromSeg,med)};
  let h='<div class="detail"><h3>'+v.RepNombre+' <span class="mini">('+v.RepCodigo+') · '+v.Supervisor+' · '+v.Centro+'</span></h3>'+
    '<div class="sub">IEGT <b style="color:'+v._banda[1]+'">'+v._iegt.toFixed(1)+'</b> — banda <span class="badge" style="background:'+v._banda[1]+'">'+v._banda[0]+'</span> · Inconsistencia (visitas): <b style="color:'+v._inc[1]+'">'+v._inc[0]+'</b></div>'+
    '<div class="subgrid">'+
      sub('Ef. visitas',v._efv.toFixed(0)+'%',sc.visitas)+sub('Ef. ventas',v._efn.toFixed(0)+'%',sc.ventas)+
      sub('1er pedido',hhmm(v.PrimerMin),sc.inicio)+sub('Últ. pedido',hhmm(v.UltimoMin),sc.cierre)+
      sub('Fuera de ruta',v.FueraRuta,sc.ruta)+sub('Fuera de PDV',v.FueraPDV,sc.pdv)+
      sub('Ritmo (s/visita)',(v.PromSeg||'—'),sc.ritmo)+sub('Clientes sin venta',v.SinVenta,'')+
      sub('Unidades',fmtN(v.Unidades),'')+sub('Cajas',fmtDec(v.Cajas),'')+sub('Valor',fmtN(v.Valor),'')+
    '</div>'+
    '<div class="concl">'+conclusion(v,med)+'</div>'+
    planAccion(v)+
  '</div>';
  $('#detalle').innerHTML=h; $('#detalle').scrollIntoView({behavior:'smooth'});
}
function sub(k,val,score){ const col=score===''?'#e6edf3':score>=100?'#3fb950':score>=50?'#e3b341':'#f85149'; return '<div class="subcard"><div class="k">'+k+'</div><div class="v" style="color:'+col+'">'+val+(score!==''?' <span class="mini">('+score+')</span>':'')+'</div></div>'; }
function conclusion(v,med){
  const pat=[];
  if(v._efv<98) pat.push('efectividad de visitas '+v._efv.toFixed(0)+'% ('+v._inc[0].toLowerCase()+')');
  if(v._efn<CFG.ventas.bandLo) pat.push('conversión baja ('+v._efn.toFixed(0)+'%)');
  if(v.PrimerMin!=null&&v.PrimerMin>CFG.inicio.min100) pat.push('arranque tardío ('+hhmm(v.PrimerMin)+')');
  if(v.UltimoMin!=null&&v.UltimoMin<CFG.cierre.min100) pat.push('cierre prematuro ('+hhmm(v.UltimoMin)+')');
  if(v.FueraRuta>=2) pat.push(v.FueraRuta+' pedidos fuera de ruta');
  if(v.FueraPDV>10) pat.push(v.FueraPDV+' capturas fuera de PDV');
  if(med&&v.PromSeg){ const d=(v.PromSeg-med)/med; if(d>0.5)pat.push('ritmo muy lento vs pares'); else if(d<-0.5)pat.push('ritmo muy corto vs pares'); }
  const focos=pat.slice(0,3).join(', ')||'sin desviaciones relevantes';
  return '<b>'+v.RepNombre+'</b> — Ruta '+(v.RepCodigo)+', IEGT '+v._iegt.toFixed(1)+' ('+v._banda[0]+'). '+
    'El plan de visitas quedó en '+v._efv.toFixed(0)+'% ('+v._inc[0].toLowerCase()+'). '+
    'Patrones que más pesaron: '+focos+'. '+
    '<b>Foco de la semana:</b> '+focoTrabajo(v)+'.';
}
function focoTrabajo(v){
  if(v._iegt<CFG.bandas.irregular) return 'vendedor prioritario — acompañamiento de al menos 2 días en ruta y seguimiento diario';
  if(v._efv<88) return 'recuperar cobertura del plan de visitas (comprometer clientes no visitados)';
  if(v.PrimerMin!=null&&v.PrimerMin>CFG.inicio.min100) return 'comprometer primer pedido ≤ '+hhmm(CFG.inicio.min100)+' y verificarlo al día siguiente';
  if(v.FueraRuta>=2) return 'auditar el ruteo y reforzar la disciplina de secuencia';
  if(v._efn<CFG.ventas.bandLo) return 'acompañamiento en ruta enfocado en detección de necesidades y cierre';
  if(v.UltimoMin!=null&&v.UltimoMin<CFG.cierre.min100) return 'asignar clientes de cola de ruta y validar cobertura hasta el cierre';
  return 'mantener el estándar y usar como referencia del grupo';
}
function planAccion(v){
  const t=[];
  if(v._efv<98) t.push(['Efectividad de visitas '+v._efv.toFixed(0)+'%','Revisar itinerario planificado vs. ejecutado; identificar clientes no visitados y comprometer cobertura al día siguiente.']);
  if(v._efn<CFG.ventas.bandLo||v._efn>CFG.ventas.bandHi) t.push(['Efectividad de ventas fuera de banda','Acompañamiento en ruta de medio día enfocado en detección de necesidades y cierre.']);
  if(v.FueraRuta>=2) t.push(['≥2 pedidos fuera de ruta','Auditar el ruteo; reforzar disciplina de secuencia y validar por qué se vende fuera de ruta.']);
  if(v.PrimerMin!=null&&v.PrimerMin>CFG.inicio.min100) t.push(['Arranque tardío (1er pedido '+hhmm(v.PrimerMin)+')','Comprometer primer pedido ≤ '+hhmm(CFG.inicio.min100)+' y verificarlo en el tablero al día siguiente.']);
  if(v.UltimoMin!=null&&v.UltimoMin<CFG.cierre.min100) t.push(['Cierre prematuro (último pedido '+hhmm(v.UltimoMin)+')','Revisar por qué se abandona la zona temprano; asignar clientes de cola de ruta.']);
  if(v.FueraPDV>10) t.push(['Capturas fuera de PDV ('+v.FueraPDV+')','Verificar registro dentro del punto de venta; revisar disciplina de captura GPS.']);
  if(v._iegt<CFG.bandas.irregular) t.push(['IEGT en banda Deficiente','Vendedor prioritario de la semana: acompañamiento de al menos 2 días en ruta y seguimiento diario.']);
  if(!t.length) return '<div class="plan"><div class="ph">Plan de acción — sin inconsistencias relevantes</div><div class="pi">Se reconoce el desempeño. Mantener el estándar.</div></div>';
  return '<div class="plan"><div class="ph">&#128203; Plan de acción del supervisor</div>'+t.map(x=>'<div class="pi"><span class="tag">'+x[0]+'</span><span>'+x[1]+'</span></div>').join('')+'</div>';
}

/* ── Config modal ── */
function cfgBody(){
  const r=(id,lbl,val)=>'<div class="cfg-row"><label>'+lbl+'</label><input type="number" id="'+id+'" value="'+val+'"></div>';
  $('#cfg-body').innerHTML=
    '<div class="cfg-sec"><h3>Pesos (%)</h3>'+r('p-vis','Efectividad de visitas',CFG.pesos.visitas)+r('p-ini','Inicio temprano (Primer Pedido)',CFG.pesos.inicio)+r('p-cie','Cierre no prematuro (Último Pedido)',CFG.pesos.cierre)+r('p-ven','Efectividad de ventas',CFG.pesos.ventas)+r('p-rut','Disciplina de ruta',CFG.pesos.ruta)+r('p-pdv','Consistencia PDV',CFG.pesos.pdv)+r('p-rit','Ritmo de visita',CFG.pesos.ritmo)+'</div>'+
    '<div class="cfg-sec"><h3>Umbrales</h3>'+r('v-100','Ef. visitas: ≥ para 100 (%)',CFG.visitas.v100)+r('v-75','Ef. visitas: ≥ para 75 (%)',CFG.visitas.v75)+r('v-50','Ef. visitas: ≥ para 50 (%)',CFG.visitas.v50)+
      r('i-100','Inicio ≤ para 100 (min)',CFG.inicio.min100)+r('i-50','Inicio ≤ para 50 (min)',CFG.inicio.min50)+
      r('c-100','Cierre ≥ para 100 (min)',CFG.cierre.min100)+r('c-50','Cierre ≥ para 50 (min)',CFG.cierre.min50)+
      r('vt-lo','Ventas banda mín (%)',CFG.ventas.bandLo)+r('vt-hi','Ventas banda máx (%)',CFG.ventas.bandHi)+r('vt-tol','Ventas tolerancia (±%)',CFG.ventas.tol)+'</div>'+
    '<div class="cfg-sec"><h3>Bandas IEGT</h3>'+r('b-sol','Sólida ≥',CFG.bandas.solida)+r('b-ace','Aceptable ≥',CFG.bandas.aceptable)+r('b-irr','Irregular ≥',CFG.bandas.irregular)+'</div>'+
    '<div class="cfg-sec"><h3>Fuera de PDV</h3><div class="cfg-row"><label>Cómo se mide</label>'+
      '<select id="pdv-modo" style="background:#21262d;border:1px solid #30363d;color:#e6edf3;border-radius:6px;padding:4px 7px;font-size:12px">'+
      '<option value="distancia"'+(CFG.pdvModo==='distancia'?' selected':'')+'>Por distancia GPS</option>'+
      '<option value="ruta"'+(CFG.pdvModo==='ruta'?' selected':'')+'>Cliente no programado ese día</option></select></div>'+
      r('pdv-met','Distancia umbral (m)',CFG.pdvMetros)+'</div>'+
    '<div class="mini">Inicio/cierre en minutos desde medianoche: 08:15=495 · 08:45=525 · 14:30=870 · 15:30=930.</div>';
}
$('#btn-cfg').onclick=()=>{ cfgBody(); $('#cfg-modal').classList.add('open'); };
$('#cfg-cancel').onclick=()=>$('#cfg-modal').classList.remove('open');
$('#cfg-modal').onclick=e=>{ if(e.target.id==='cfg-modal')$('#cfg-modal').classList.remove('open'); };
$('#cfg-reset').onclick=()=>{ CFG=JSON.parse(JSON.stringify(CFG_DEF)); cfgBody(); };
$('#cfg-save').onclick=()=>{ const g=id=>+$('#'+id).value;
  CFG.pesos={visitas:g('p-vis'),inicio:g('p-ini'),cierre:g('p-cie'),ventas:g('p-ven'),ruta:g('p-rut'),pdv:g('p-pdv'),ritmo:g('p-rit')};
  CFG.visitas={v100:g('v-100'),v75:g('v-75'),v50:g('v-50')};
  CFG.inicio={min100:g('i-100'),min50:g('i-50')}; CFG.cierre={min100:g('c-100'),min50:g('c-50')};
  CFG.ventas={bandLo:g('vt-lo'),bandHi:g('vt-hi'),tol:g('vt-tol')};
  CFG.bandas={solida:g('b-sol'),aceptable:g('b-ace'),irregular:g('b-irr')};
  CFG.pdvModo=$('#pdv-modo').value; CFG.pdvMetros=g('pdv-met'); $('#f-pdv').value=CFG.pdvMetros;
  saveCfg(); $('#cfg-modal').classList.remove('open');
  if(DATA.length) generar();   // cambia el modo de fuera-de-PDV → re-consulta

};

/* ── Exportar / Imprimir ── */
$('#btn-print').onclick=()=>window.print();
$('#btn-excel').onclick=()=>{
  if(typeof XLSX==='undefined'){ alert('No se pudo cargar el generador de Excel (revisa la conexión).'); return; }
  const a=APPLIED||{}; const some=(arr,t)=>(arr&&arr.length)?arr.join('; '):t;
  const pdv=a.pdvModo==='ruta'?'Cliente no programado ese día':('Distancia GPS > '+a.pdvMetros+' m');
  const headBase=[
    [EMP+' — Informe Semanal · Torre de Control'],
    ['Semana', (a.ini||'')+' ('+diaSemana(a.ini)+') al '+(a.fin||'')+' ('+diaSemana(a.fin)+')'],
    ['Centro', some(a.centros,'Todos')], ['Supervisor', some(a.sups,'Todos')],
    ['Vendedor', some(a.vens,'Todos')], ['División', some(a.div,'Todas')],
    ['Generado', new Date().toLocaleString('es-DO')], []
  ];
  if(modoAnalisis==='suplidor'){
    if(!SUP.length){ alert('Genera el informe primero.'); return; }
    const nivel=supNav.cat?'Producto':(supNav.sup?'Categoria':'Suplidor');
    const ctx=[['Análisis','Por '+nivel+(supNav.sup?(' · Suplidor: '+supNav.sup.name):'')+(supNav.cat?(' · Categoría: '+supNav.cat.name):'')]];
    const H2=[nivel,'Centro','Supervisor','Vendedor','Código','Unidades','Cajas','Valor'];
    const rows2=SUP.map(f=>[f.Item,f.Centro,f.Supervisor,f.RepNombre,f.RepCodigo,Math.round(f.Unidades),+(f.Cajas||0).toFixed(1),Math.round(f.Valor)]);
    const ws2=XLSX.utils.aoa_to_sheet(headBase.concat(ctx).concat([[]]).concat([H2]).concat(rows2));
    ws2['!cols']=H2.map((h,i)=>({wch:i===0?26:(i===3?24:14)}));
    const wb2=XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb2,ws2,'Por '+nivel);
    XLSX.writeFile(wb2,'seguimiento_'+nivel.toLowerCase()+'_'+(a.ini||'')+'.xlsx'); return;
  }
  const list=withIegt(DATA);
  if(!list.length){ alert('Genera el informe primero.'); return; }
  // Cabecera con los filtros medidos
  const head=[
    [EMP+' — Informe Semanal · Torre de Control (IEGT)'],
    ['Semana', (a.ini||'')+' ('+diaSemana(a.ini)+') al '+(a.fin||'')+' ('+diaSemana(a.fin)+')'],
    ['Centro', some(a.centros,'Todos')],
    ['Supervisor', some(a.sups,'Todos')],
    ['Vendedor', some(a.vens,'Todos')],
    ['División', some(a.div,'Todas')],
    ['Fuera de PDV', pdv],
    ['Generado', new Date().toLocaleString('es-DO')],
    []
  ];
  const H=['Centro','Supervisor','Vendedor','Código','División','Ef.Visitas %','Ef.Ventas %','1er Pedido','Últ Pedido','Fuera Ruta','Fuera PDV','Clientes sin venta','Ritmo (s)','Unidades','Cajas','Valor','IEGT','Banda'];
  const rows=list.map(v=>[v.Centro,v.Supervisor,v.RepNombre,v.RepCodigo,v.Division,+v._efv.toFixed(1),+v._efn.toFixed(1),hhmm(v.PrimerMin),hhmm(v.UltimoMin),v.FueraRuta,v.FueraPDV,v.SinVenta,(v.PromSeg||0),Math.round(v.Unidades||0),+(v.Cajas||0).toFixed(1),Math.round(v.Valor||0),+v._iegt.toFixed(1),v._banda[0]]);
  const aoa=head.concat([H]).concat(rows);
  const ws=XLSX.utils.aoa_to_sheet(aoa);
  ws['!cols']=H.map((h,i)=>({wch:i<3?22:(i===2?26:12)}));
  const wb=XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb,ws,'Seguimiento');
  XLSX.writeFile(wb,'seguimiento_semanal_'+(a.ini||$('#f-ini').value)+'.xlsx');
};

$('#btn-go').onclick=generar;
/* Arranque */
overlay(true);
fetch(BASE+'/apiseg/filtros').then(r=>r.json()).then(j=>{ overlay(false); REPS=(j&&j.ok&&j.representantes)||[]; buildFiltros(); renderModoBar(); }).catch(e=>{ overlay(false); alert('No se pudo cargar el catálogo: '+e); });
</script>
